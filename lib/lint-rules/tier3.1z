\ lib/lint-rules/tier3.1z - Tier 3: advanced lint rules
\
\ Rules that build on the semantic analysis layer with deeper
\ naming convention and code pattern checks.
\ Registered automatically when loaded.

use "lint" ;
use "lint-rules/tier2" ;
use "char" ;

\ --- Helpers for doc-example-format ---

\ Strip the leading doc-comment marker and a single following space.
(doc-comment-body): ( token -- str ) [
  value>> 2 #drop
  dup #len 0 > [
    dup 0 #nth " " = [ 1 #drop ] when
  ] when
] ;

\ Trim leading spaces and tabs from a doc-comment body.
(ltrim-doc-body): stack-recursive ( str -- str' ) [
  dup #len 0 = [
  ] [
    dup 0 #nth dup " " = swap 9 >char = or [
      1 #drop (ltrim-doc-body)
    ] when
  ] if
] ;

\ Does a doc-comment body start with the given prefix after leading indent?
(doc-body-prefix?): ( str prefix -- ? ) [
  swap (ltrim-doc-body) swap #starts-with?
] ;

\ Is this doc comment an Example:/Examples: heading?
(doc-example-heading?): ( token -- ? ) [
  (doc-comment-body) (ltrim-doc-body)
  dup "Example:" = swap "Examples:" = or
] ;

\ Is this doc comment blank after removing the marker?
(blank-doc-comment?): ( token -- ? ) [
  (doc-comment-body) (ltrim-doc-body) #len 0 =
] ;

\ Does this doc comment look like an output line using the wrong marker?
(doc-example-arrow-line?): ( token -- ? ) [
  (doc-comment-body) "->" (doc-body-prefix?)
] ;

\ Does this doc comment look like a valid output line?
(doc-example-equals-line?): ( token -- ? ) [
  (doc-comment-body) "=>" (doc-body-prefix?)
] ;

\ Can this doc comment serve as the input line before an output line?
(doc-example-input-line?): ( token -- ? ) [
  dup (blank-doc-comment?) [
    drop f
  ] [
    dup (doc-example-heading?) [
      drop f
    ] [
      dup (doc-example-arrow-line?) [
        drop f
      ] [
        (doc-example-equals-line?) not
      ] if
    ] if
  ] if
] ;

\ Can a doc-comment line establish example context for the next doc line?
(doc-example-predecessor?): ( token -- ? ) [
  dup (doc-example-heading?) [
    drop t
  ] [
    (doc-example-input-line?)
  ] if
] ;

\ --- Rule: doc-example-format ---

(check-doc-example-format): ( path source tokens line-index semantic-context -- diagnostics ) [
  drop
  V{ } f
  \ stack: path(5) source(4) tokens(3) line-index(2) positions(1) prev-example?(0)
  3 pick-n [
    \ stack: path(6) source(5) tokens(4) line-index(3) positions(2) prev-example?(1) token(0)
    dup kind>> doc-comment: = [
      dup (doc-example-predecessor?)
      1 pick-n (doc-example-arrow-line?)
      3 pick-n and [
        1 pick-n dup pos>> swap drop
        4 pick-n swap #push! drop
      ] when
      nip nip
    ] [
      dup significant-token? [
        dup kind>> comment: = [
          drop
        ] [
          drop drop f
        ] if
      ] [
        drop
      ] if
    ] if
  ] #each
  drop
  V{ }
  \ stack: path(5) source(4) tokens(3) line-index(2) positions(1) results(0)
  1 pick-n [
    \ stack: path(6) source(5) tokens(4) line-index(3) positions(2) results(1) pos(0)
    "doc-example-format" warning: 8 pick-n 6 pick-n 4 pick-n
    "doc comment example output should use =>, not ->"
    (make-diag)
    swap drop 1 pick-n swap #push! drop
  ] #each
  swap drop
  [ drop drop drop drop ] dip
] ;

"doc-example-format" warning: [ (check-doc-example-format) ] f
make-lint-rule register-lint-rule

\ --- Helpers for complex-word-undocumented ---

\ Skip leading spaces and tabs at the start of a doc line.
(skip-doc-line-indent): stack-recursive ( str -- str' ) [
  dup #len 0 = [
  ] [
    dup 0 #nth dup " " = swap 9 >char = or [
      1 #drop (skip-doc-line-indent)
    ] when
  ] if
] ;

\ Drop characters until the next line, then return the remainder.
(skip-to-next-doc-line): stack-recursive ( str -- str' ) [
  dup #len 0 = [
  ] [
    dup 0 #nth 10 >char = [
      1 #drop
    ] [
      1 #drop (skip-to-next-doc-line)
    ] if
  ] if
] ;

\ Does a doc string line look like an example output line?
(doc-string-example-line?): ( str -- ? ) [
  (skip-doc-line-indent) "=>" #starts-with?
] ;

\ Does a doc string contain any example output line?
(doc-string-has-example?): stack-recursive ( doc -- ? ) [
  dup #len 0 = [
    drop f
  ] [
    dup (doc-string-example-line?) [
      drop t
    ] [
      (skip-to-next-doc-line) (doc-string-has-example?)
    ] if
  ] if
] ;

\ Count all declared stack-effect parameters (inputs + outputs).
(stack-effect-param-count): ( stack-effect -- n ) [
  dup inputs>> #len swap outputs>> #len +
] ;

\ Is this word complex enough to require an example?
(complex-word?): ( word-info -- ? ) [
  stack-effect>> dup f = [
    drop f
  ] [
    (stack-effect-param-count) 3 >=
  ] if
] ;

\ --- Rule: complex-word-undocumented ---

(check-complex-word-undocumented): ( path source tokens line-index semantic-context -- diagnostics ) [
  nip nip nip
  [
    dup (complex-word?) [
      dup doc>> dup f = [
        drop
        source-loc>> dup f = [ 2drop f ] [
          "complex-word-undocumented" info: 3 pick-n 3 pick-n dup line>> swap column>>
          "complex word should include a doc comment example"
          make-lint-diagnostic nip nip
        ] if
      ] [
        (doc-string-has-example?) [
          2drop f
        ] [
          source-loc>> dup f = [ 2drop f ] [
            "complex-word-undocumented" info: 3 pick-n 3 pick-n dup line>> swap column>>
            "complex word should include a doc comment example"
            make-lint-diagnostic nip nip
          ] if
        ] if
      ] if
    ] [ 2drop f ] if
  ] (check-semantic-words)
] ;

"complex-word-undocumented" info: [ (check-complex-word-undocumented) ] f
make-lint-rule register-lint-rule

(check-dead-definition): ( path source tokens line-index semantic-context -- diagnostics ) [
  drop drop drop drop
  lint-dead-definitions dup f = [
    drop { }
  ] [
    V{ } -rot>
    [
      \ record = [ name file line column ]
      dup 1 #nth 2 pick-n = [
        "dead-definition" info:
        2 pick-n 1 #nth
        3 pick-n 2 #nth
        4 pick-n 3 #nth
        "definition is not referenced by any other checked-file word"
        make-lint-diagnostic
        swap drop
        2 pick-n swap #push! drop
      ] [
        drop
      ] if
    ] #each
    drop
  ] if
] ;

"dead-definition" info: [ (check-dead-definition) ] f
make-lint-rule register-lint-rule

\ --- Helpers for duplicate-definition ---

\ Compute an opcode fingerprint for a word body, or f if not applicable.
(body-fingerprint): ( word-info -- string-or-f ) [
  body>> dup f = [
  ] [
    dup quotation? [
      native.quotation>opcodes inspect
    ] [ drop f ] if
  ] if
] ;

\ --- Rule: duplicate-definition ---

(check-duplicate-definition): ( path source tokens line-index semantic-context -- diagnostics ) [
  nip nip nip
  \ stack: path(1) sem-ctx(0)
  dup f = [ 2drop { } ] [
    \ Collect { fingerprint word-info } pairs for eligible words
    V{ }
    \ stack: path(2) sem-ctx(1) pairs(0)
    1 pick-n semantic-word-names [
      \ stack: path(3) sem-ctx(2) pairs(1) word-name(0)
      2 pick-n swap semantic-word-info
      dup f = [ drop ] [
        dup (skip-word?) [ drop ] [
          dup (body-fingerprint) dup f = [ 2drop ] [
            \ stack: ... pairs(2) word-info(1) fingerprint(0)
            swap 2 array-n
            \ stack: ... pairs(1) { fingerprint word-info }(0)
            1 pick-n swap #push! drop
          ] if
        ] if
      ] if
    ] #each
    nip
    \ stack: path(1) pairs(0)

    \ Sort by fingerprint + left-padded line number for source-order grouping
    [
      dup 0 #nth swap 1 #nth source-loc>>
      dup f = [ drop "99999999" ] [
        line>> >string "00000000" swap #append
        dup #len 8 - #drop
      ] if
      #append
    ] #sort-by

    \ Compare adjacent pairs for matching fingerprints
    dup #len 2 < [ 2drop { } ] [
      V{ }
      \ stack: path(2) sorted(1) results(0)
      1 pick-n #len 1 swap <range> >iterator [
        \ stack: path(3) sorted(2) results(1) i(0)
        2 pick-n over #nth 0 #nth
        3 pick-n 2 pick-n 1 - #nth 0 #nth
        = [
          \ Duplicate: get current word-info and emit diagnostic
          2 pick-n over #nth 1 #nth
          source-loc>> dup f = [ drop ] [
            "duplicate-definition" warning:
            6 pick-n
            3 pick-n dup line>> swap column>>
            "definition body is identical to "
            9 pick-n 8 pick-n 1 - #nth 1 #nth name>> >string #append
            make-lint-diagnostic
            3 pick-n swap #push! drop
            drop
          ] if
        ] when
        drop
      ] #each
      [ drop drop ] dip
    ] if
  ] if
] ;

"duplicate-definition" warning: [ (check-duplicate-definition) ] f
make-lint-rule register-lint-rule

\ --- Helpers for sequence-prefix-misuse ---

\ Known sequence type annotations (inspected form).
(sequence-type-annotation?): ( param -- ? ) [
  type-annotation>> dup f = [
    drop f
  ] [
    inspect
    { "<type:array>" "<type:string>" "<type:byte-array>"
      "<type:iterator>" "<type:linked-list>" "<type:range>"
      "<type:typed-array>" "<type:ndarray>" "<type:mutable-array>"
    }
    swap [ = ] curry #any
  ] if
] ;

\ Known sequence parameter names.
(sequence-param-name?): ( param -- ? ) [
  name>> >string
  { "seq" "arr" "array" "list" "iter" "iterator"
    "string" "str" "vec" "bytes" "elts" "items"
    "elements" "seqs" "collections"
  }
  swap [ = ] curry #any
] ;

\ Does a stack-effect-param indicate a sequence?
(sequence-param?): ( param -- ? ) [
  dup (sequence-type-annotation?) [ drop t ] [
    (sequence-param-name?)
  ] if
] ;

\ Does any input parameter indicate a sequence?
(has-sequence-input?): ( word-info -- ? ) [
  stack-effect>> dup f = [
    \ No stack effect: skip (missing-stack-effect catches this)
    drop t
  ] [
    inputs>> [ (sequence-param?) ] #any
  ] if
] ;

\ --- Rule: sequence-prefix-misuse ---

(check-sequence-prefix-misuse): ( path source tokens line-index semantic-context -- diagnostics ) [
  nip nip nip
  [
    dup name>> >string "#" #starts-with? [
      dup (has-sequence-input?) [
        2drop f
      ] [
        source-loc>> dup f = [ 2drop f ] [
          "sequence-prefix-misuse" warning: 3 pick-n 3 pick-n dup line>> swap column>>
          "word with # prefix does not appear to operate on sequences"
          make-lint-diagnostic nip nip
        ] if
      ] if
    ] [ 2drop f ] if
  ] (check-semantic-words)
] ;

"sequence-prefix-misuse" warning: [ (check-sequence-prefix-misuse) ] f
make-lint-rule register-lint-rule

\ --- Helpers for associative-prefix-misuse ---

\ Known associative type annotations (inspected form).
(associative-type-annotation?): ( param -- ? ) [
  type-annotation>> dup f = [
    drop f
  ] [
    inspect
    { "<type:hash>" "<type:mutable-map>" "<type:set>" "<type:mutable-set>" }
    swap [ = ] curry #any
  ] if
] ;

\ Known associative parameter names.
(associative-param-name?): ( param -- ? ) [
  name>> >string
  { "assoc" "hash" "map" "mmap" "dict" "table" "set"
    "set1" "set2"
  }
  swap [ = ] curry #any
] ;

\ Does a stack-effect-param indicate an associative structure?
(associative-param?): ( param -- ? ) [
  dup (associative-type-annotation?) [ drop t ] [
    (associative-param-name?)
  ] if
] ;

\ Does any input parameter indicate an associative structure?
(has-associative-input?): ( word-info -- ? ) [
  stack-effect>> dup f = [
    \ No stack effect: skip (missing-stack-effect catches this)
    drop t
  ] [
    inputs>> [ (associative-param?) ] #any
  ] if
] ;

\ --- Rule: associative-prefix-misuse ---

(check-associative-prefix-misuse): ( path source tokens line-index semantic-context -- diagnostics ) [
  nip nip nip
  [
    dup name>> >string "@" #starts-with? [
      dup (has-associative-input?) [
        2drop f
      ] [
        source-loc>> dup f = [ 2drop f ] [
          "associative-prefix-misuse" warning: 3 pick-n 3 pick-n dup line>> swap column>>
          "word with @ prefix does not appear to operate on associative structures"
          make-lint-diagnostic nip nip
        ] if
      ] if
    ] [ 2drop f ] if
  ] (check-semantic-words)
] ;

"associative-prefix-misuse" warning: [ (check-associative-prefix-misuse) ] f
make-lint-rule register-lint-rule

\ --- Helpers for mutation-suffix-misuse ---

\ Known mutable type annotations (inspected form).
(mutable-type-annotation?): ( param -- ? ) [
  type-annotation>> dup f = [
    drop f
  ] [
    inspect
    { "<type:mutable-array>" "<type:mutable-map>" "<type:mutable-set>"
      "<type:byte-array>"
    }
    swap [ = ] curry #any
  ] if
] ;

\ Known mutable parameter names.
(mutable-param-name?): ( param -- ? ) [
  name>> >string
  { "vec" "mmap" "buf" "buffer" "byte-array" "mutable" "mut" }
  swap [ = ] curry #any
] ;

\ Does a stack-effect-param indicate a mutable container?
(mutable-param?): ( param -- ? ) [
  dup (mutable-type-annotation?) [ drop t ] [
    (mutable-param-name?)
  ] if
] ;

\ Does any input parameter indicate a mutable container?
(has-mutable-input?): ( word-info -- ? ) [
  stack-effect>> dup f = [
    \ No stack effect: skip (missing-stack-effect catches this)
    drop t
  ] [
    inputs>> [ (mutable-param?) ] #any
  ] if
] ;

\ --- Rule: mutation-suffix-misuse ---

(check-mutation-suffix-misuse): ( path source tokens line-index semantic-context -- diagnostics ) [
  nip nip nip
  [
    dup name>> >string "!" #ends-with? [
      dup (has-mutable-input?) [
        2drop f
      ] [
        source-loc>> dup f = [ 2drop f ] [
          "mutation-suffix-misuse" warning: 3 pick-n 3 pick-n dup line>> swap column>>
          "word with ! suffix does not appear to perform mutation"
          make-lint-diagnostic nip nip
        ] if
      ] if
    ] [ 2drop f ] if
  ] (check-semantic-words)
] ;

"mutation-suffix-misuse" warning: [ (check-mutation-suffix-misuse) ] f
make-lint-rule register-lint-rule

\ --- Helpers for error-type-naming ---

\ Does a word name follow the Ename convention (E followed by uppercase)?
(ename-pattern?): ( name -- ? ) [
  dup #len 2 < [ drop f ] [
    dup 0 #nth "E" = [
      1 #nth upper?
    ] [ drop f ] if
  ] if
] ;

\ --- Rule: error-type-naming ---

(check-error-type-naming): ( path source tokens line-index semantic-context -- diagnostics ) [
  drop
  V{ } f
  \ stack: path(5) source(4) tokens(3) line-index(2) results(1) prev(0)
  3 pick-n [
    \ stack: path(6) source(5) tokens(4) line-index(3) results(2) prev(1) token(0)
    dup kind>> word: = [
      dup value>> "make-error" = [
        \ Found make-error: check prev token
        drop
        \ stack: path(5) source(4) tokens(3) line-index(2) results(1) prev(0)
        dup f = not [
          dup kind>> word: = [
            dup value>> (ename-pattern?) not [
              pos>>
              "error-type-naming" warning:
              7 pick-n 5 pick-n 4 pick-n
              "error type constant does not follow Ename convention (e.g., EUserThrown)"
              (make-diag)
              2 pick-n swap #push! drop
              drop
            ] [ drop ] if
          ] [ drop ] if
        ] [ drop ] if
        f
      ] [
        \ Regular word: update prev
        nip
      ] if
    ] [
      dup significant-token? [
        nip
      ] [
        drop
      ] if
    ] if
  ] #each
  drop
  [ drop drop drop drop ] dip
] ;

"error-type-naming" warning: [ (check-error-type-naming) ] f
make-lint-rule register-lint-rule

\ --- Helpers for with-combinator-naming ---

\ Does a stack-effect-param indicate a quotation?
(quotation-param?): ( param -- ? ) [
  dup nested-effect>> f = not [ drop t ] [
    name>> >string
    { "quot" "quotation" "body" "pred" "fn" "callback" "action" "thunk" }
    swap [ = ] curry #any
  ] if
] ;

\ Does any input parameter indicate a quotation?
(has-quotation-input?): ( word-info -- ? ) [
  stack-effect>> dup f = [
    \ No stack effect: skip (missing-stack-effect catches this)
    drop t
  ] [
    inputs>> [ (quotation-param?) ] #any
  ] if
] ;

\ --- Rule: with-combinator-naming ---

(check-with-combinator-naming): ( path source tokens line-index semantic-context -- diagnostics ) [
  nip nip nip
  [
    dup name>> >string "with-" #starts-with? [
      dup (has-quotation-input?) [
        2drop f
      ] [
        source-loc>> dup f = [ 2drop f ] [
          "with-combinator-naming" warning: 3 pick-n 3 pick-n dup line>> swap column>>
          "word with with- prefix does not appear to accept a quotation argument"
          make-lint-diagnostic nip nip
        ] if
      ] if
    ] [ 2drop f ] if
  ] (check-semantic-words)
] ;

"with-combinator-naming" warning: [ (check-with-combinator-naming) ] f
make-lint-rule register-lint-rule
