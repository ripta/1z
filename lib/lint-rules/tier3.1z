\ lib/lint-rules/tier3.1z - Tier 3: advanced lint rules
\
\ Rules that build on the semantic analysis layer with deeper
\ naming convention and code pattern checks.
\ Registered automatically when loaded.

use "lint" ;
use "lint-rules/tier2" ;
use "char" ;

\ --- Helpers for sequence-prefix-misuse ---

\ Known sequence type annotations (inspected form).
(sequence-type-annotation?): ( param -- ? ) [
  type-annotation>> dup f = [
    drop f
  ] [
    inspect
    { "<type:array>" "<type:string>" "<type:byte-array>"
      "<type:iterator>" "<type:linked-list>" "<type:range>"
      "<type:typed-array>" "<type:ndarray>" "<type:mutable-array>"
    }
    swap [ = ] curry #any
  ] if
] ;

\ Known sequence parameter names.
(sequence-param-name?): ( param -- ? ) [
  name>> >string
  { "seq" "arr" "array" "list" "iter" "iterator"
    "string" "str" "vec" "bytes" "elts" "items"
    "elements" "seqs" "collections"
  }
  swap [ = ] curry #any
] ;

\ Does a stack-effect-param indicate a sequence?
(sequence-param?): ( param -- ? ) [
  dup (sequence-type-annotation?) [ drop t ] [
    (sequence-param-name?)
  ] if
] ;

\ Does any input parameter indicate a sequence?
(has-sequence-input?): ( word-info -- ? ) [
  stack-effect>> dup f = [
    \ No stack effect: skip (missing-stack-effect catches this)
    drop t
  ] [
    inputs>> [ (sequence-param?) ] #any
  ] if
] ;

\ --- Rule: sequence-prefix-misuse ---

(check-sequence-prefix-misuse): ( path source tokens line-index semantic-context -- diagnostics ) [
  nip nip nip
  [
    dup name>> >string "#" #starts-with? [
      dup (has-sequence-input?) [
        2drop f
      ] [
        source-loc>> dup f = [ 2drop f ] [
          "sequence-prefix-misuse" warning: 3 pick-n 3 pick-n dup line>> swap column>>
          "word with # prefix does not appear to operate on sequences"
          make-lint-diagnostic nip nip
        ] if
      ] if
    ] [ 2drop f ] if
  ] (check-semantic-words)
] ;

"sequence-prefix-misuse" warning: [ (check-sequence-prefix-misuse) ] f
make-lint-rule register-lint-rule

\ --- Helpers for associative-prefix-misuse ---

\ Known associative type annotations (inspected form).
(associative-type-annotation?): ( param -- ? ) [
  type-annotation>> dup f = [
    drop f
  ] [
    inspect
    { "<type:hash>" "<type:mutable-map>" "<type:set>" "<type:mutable-set>" }
    swap [ = ] curry #any
  ] if
] ;

\ Known associative parameter names.
(associative-param-name?): ( param -- ? ) [
  name>> >string
  { "assoc" "hash" "map" "mmap" "dict" "table" "set"
    "set1" "set2"
  }
  swap [ = ] curry #any
] ;

\ Does a stack-effect-param indicate an associative structure?
(associative-param?): ( param -- ? ) [
  dup (associative-type-annotation?) [ drop t ] [
    (associative-param-name?)
  ] if
] ;

\ Does any input parameter indicate an associative structure?
(has-associative-input?): ( word-info -- ? ) [
  stack-effect>> dup f = [
    \ No stack effect: skip (missing-stack-effect catches this)
    drop t
  ] [
    inputs>> [ (associative-param?) ] #any
  ] if
] ;

\ --- Rule: associative-prefix-misuse ---

(check-associative-prefix-misuse): ( path source tokens line-index semantic-context -- diagnostics ) [
  nip nip nip
  [
    dup name>> >string "@" #starts-with? [
      dup (has-associative-input?) [
        2drop f
      ] [
        source-loc>> dup f = [ 2drop f ] [
          "associative-prefix-misuse" warning: 3 pick-n 3 pick-n dup line>> swap column>>
          "word with @ prefix does not appear to operate on associative structures"
          make-lint-diagnostic nip nip
        ] if
      ] if
    ] [ 2drop f ] if
  ] (check-semantic-words)
] ;

"associative-prefix-misuse" warning: [ (check-associative-prefix-misuse) ] f
make-lint-rule register-lint-rule

\ --- Helpers for mutation-suffix-misuse ---

\ Known mutable type annotations (inspected form).
(mutable-type-annotation?): ( param -- ? ) [
  type-annotation>> dup f = [
    drop f
  ] [
    inspect
    { "<type:mutable-array>" "<type:mutable-map>" "<type:mutable-set>"
      "<type:byte-array>"
    }
    swap [ = ] curry #any
  ] if
] ;

\ Known mutable parameter names.
(mutable-param-name?): ( param -- ? ) [
  name>> >string
  { "vec" "mmap" "buf" "buffer" "byte-array" "mutable" "mut" }
  swap [ = ] curry #any
] ;

\ Does a stack-effect-param indicate a mutable container?
(mutable-param?): ( param -- ? ) [
  dup (mutable-type-annotation?) [ drop t ] [
    (mutable-param-name?)
  ] if
] ;

\ Does any input parameter indicate a mutable container?
(has-mutable-input?): ( word-info -- ? ) [
  stack-effect>> dup f = [
    \ No stack effect: skip (missing-stack-effect catches this)
    drop t
  ] [
    inputs>> [ (mutable-param?) ] #any
  ] if
] ;

\ --- Rule: mutation-suffix-misuse ---

(check-mutation-suffix-misuse): ( path source tokens line-index semantic-context -- diagnostics ) [
  nip nip nip
  [
    dup name>> >string "!" #ends-with? [
      dup (has-mutable-input?) [
        2drop f
      ] [
        source-loc>> dup f = [ 2drop f ] [
          "mutation-suffix-misuse" warning: 3 pick-n 3 pick-n dup line>> swap column>>
          "word with ! suffix does not appear to perform mutation"
          make-lint-diagnostic nip nip
        ] if
      ] if
    ] [ 2drop f ] if
  ] (check-semantic-words)
] ;

"mutation-suffix-misuse" warning: [ (check-mutation-suffix-misuse) ] f
make-lint-rule register-lint-rule

\ --- Helpers for error-type-naming ---

\ Does a word name follow the Ename convention (E followed by uppercase)?
(ename-pattern?): ( name -- ? ) [
  dup #len 2 < [ drop f ] [
    dup 0 #nth "E" = [
      1 #nth upper?
    ] [ drop f ] if
  ] if
] ;

\ --- Rule: error-type-naming ---

(check-error-type-naming): ( path source tokens line-index semantic-context -- diagnostics ) [
  drop
  V{ } f
  \ stack: path(5) source(4) tokens(3) line-index(2) results(1) prev(0)
  3 pick-n [
    \ stack: path(6) source(5) tokens(4) line-index(3) results(2) prev(1) token(0)
    dup kind>> word: = [
      dup value>> "make-error" = [
        \ Found make-error: check prev token
        drop
        \ stack: path(5) source(4) tokens(3) line-index(2) results(1) prev(0)
        dup f = not [
          dup kind>> word: = [
            dup value>> (ename-pattern?) not [
              pos>>
              "error-type-naming" warning:
              7 pick-n 5 pick-n 4 pick-n
              "error type constant does not follow Ename convention (e.g., EUserThrown)"
              (make-diag)
              2 pick-n swap #push! drop
              drop
            ] [ drop ] if
          ] [ drop ] if
        ] [ drop ] if
        f
      ] [
        \ Regular word: update prev
        nip
      ] if
    ] [
      dup significant-token? [
        nip
      ] [
        drop
      ] if
    ] if
  ] #each
  drop
  [ drop drop drop drop ] dip
] ;

"error-type-naming" warning: [ (check-error-type-naming) ] f
make-lint-rule register-lint-rule
