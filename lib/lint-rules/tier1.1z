\ lib/lint-rules/tier1.1z - Tier 1: core lint rules
\
\ Token-level rules for comment hygiene, naming conventions,
\ and whitespace discipline. Registered automatically when loaded.

use "lint" ;
use "char" ;
use "conversions" ;

\ --- Shared helpers ---

(skip-doc-lookahead-token?): ( token -- ? ) [
  kind>> dup whitespace: = [
    drop t
  ] [
    dup newline: = [
      drop t
    ] [
      dup comment: = [
        drop t
      ] [
        doc-comment: =
      ] if
    ] if
  ] if
] ;

(preserve-statement-start?): ( token -- ? ) [
  kind>> dup whitespace: = [
    drop t
  ] [
    dup newline: = [
      drop t
    ] [
      dup comment: = [
        drop t
      ] [
        dup doc-comment: = [
          drop t
        ] [
          stack-effect: =
        ] if
      ] if
    ] if
  ] if
] ;

(next-doc-target-index): stack-recursive ( tokens idx -- idx ) [
  over #len >= [
    nip
  ] [
    2dup #nth (skip-doc-lookahead-token?) [
      drop ++ (next-doc-target-index)
    ] [
      drop
    ] if
  ] if
] ;

(index-is-symbol?): ( tokens idx -- ? ) [
  over #len < [
    2dup #nth kind>> symbol: =
    nip nip
  ] [
    2drop f
  ] if
] ;

(trim-standard-prefixes): stack-recursive ( name -- core ) [
  dup #len 0 = [
  ] [
    dup 0 #nth
    dup "#" = over "@" = or over ">" = or swap "<" = or [
      1 #drop
      (trim-standard-prefixes)
    ] when
  ] if
] ;

(trim-standard-suffixes): stack-recursive ( name -- core ) [
  dup #len 0 = [
  ] [
    dup dup #len 1 - #nth
    dup "?" = swap "!" = or [
      dup #len 1 - #take
      (trim-standard-suffixes)
    ] when
  ] if
] ;

(trim-standard-affixes): ( name -- core ) [
  (trim-standard-prefixes)
  (trim-standard-suffixes)
] ;

(kebab-eligible-char?): ( ch -- ? ) [
  dup lower? [
    drop t
  ] [
    dup upper? [
      drop t
    ] [
      dup digit? [
        drop t
      ] [
        dup "-" = [
          drop t
        ] [
          "_" =
        ] if
      ] if
    ] if
  ] if
] ;

(kebab-valid-char?): ( ch -- ? ) [
  dup lower? [
    drop t
  ] [
    dup digit? [
      drop t
    ] [
      "-" =
    ] if
  ] if
] ;

(non-kebab-core?): ( name -- ? ) [
  (trim-standard-affixes)
  dup #len 0 = [
    drop f
  ] [
    dup [ alpha? ] #any not [
      drop f
    ] [
      dup [ (kebab-eligible-char?) ] #all not [
        drop f
      ] [
        dup 0 #nth "-" = over dup #len 1 - #nth "-" = or [
          drop t
        ] [
          dup "--" #index-of f = not [
            drop t
          ] [
            [ (kebab-valid-char?) ] #all not
          ] if
        ] if
      ] if
    ] if
  ] if
] ;

\ Diagnostic helpers keep the (make-diag) call sites shallow.

(push-orphaned-doc!): ( path tokens line-index state pos -- path tokens line-index state ) [
  "orphaned-doc-comment" warning:
  6 pick-n 5 pick-n 4 pick-n
  "doc comment not followed by a definition"
  (make-diag)
  2 pick-n 0 #nth swap #push! drop
  drop
] ;

(push-doc-misuse!): ( path source tokens line-index results depth line-has-code token -- path source tokens line-index results depth line-has-code ) [
  "doc-comment-misuse" warning:
  9 pick-n 7 pick-n 4 pick-n
  "doc comment used where regular comment would suffice"
  diag-at-token
  4 pick-n swap #push! drop
  drop
] ;

(push-non-kebab!): ( path source tokens line-index results stmt-start token -- path source tokens line-index results stmt-start ) [
  "non-kebab-case" warning:
  8 pick-n 6 pick-n 4 pick-n
  "definition name is not kebab-case"
  diag-at-token
  3 pick-n swap #push! drop
  drop
] ;

(push-comment-space!): ( path tokens line-index state pos -- path tokens line-index state ) [
  "comment-missing-space" warning:
  6 pick-n 5 pick-n 4 pick-n
  "comment marker not followed by a space"
  (make-diag)
  2 pick-n 0 #nth swap #push! drop
  drop
] ;

(push-blank-lines!): ( path tokens line-index state pos -- path tokens line-index state ) [
  "excessive-blank-lines" warning:
  6 pick-n 5 pick-n 4 pick-n
  "3 or more consecutive blank lines"
  (make-diag)
  2 pick-n 0 #nth swap #push! drop
  drop
] ;

\ --- Rule 1: orphaned-doc-comment ---

(check-orphaned-doc-comment): ( path source tokens line-index semantic-context -- diagnostics ) [
  drop V{ } f
  \ stack: path(5) source(4) tokens(3) line-index(2) results(1) pending-pos(0)
  3 pick-n [
    \ stack: path(6) source(5) tokens(4) line-index(3) results(2) pending-pos(1) token(0)
    dup kind>> doc-comment: = [
      pos>>
      1 pick-n f = [
        nip
      ] [
        drop
      ] if
    ] [
      dup kind>> whitespace: = over kind>> newline: = or over kind>> comment: = or [
        drop
      ] [
        1 pick-n dup f = not [
          \ A private-word definition (name): tokenizes as a stack-effect:
          \ token (the (name) parens), not a symbol:, so accept either as a
          \ definition the doc comment attaches to.
          1 pick-n kind>> dup symbol: = swap stack-effect: = or [
            drop
          ] [
            "orphaned-doc-comment" warning:
            9 pick-n 7 pick-n 4 pick-n
            "doc comment not followed by a definition" (make-diag)
            4 pick-n swap #push! drop drop
          ] if
        ] [
          drop
        ] if
        2drop f
      ] if
    ] if
  ] #each
  dup f = not [
    "orphaned-doc-comment" warning:
    7 pick-n 5 pick-n 4 pick-n
    "doc comment not followed by a definition" (make-diag)
    2 pick-n swap #push! drop drop
  ] when
  drop
  [ drop drop drop drop ] dip
] ;

"orphaned-doc-comment" warning: [ (check-orphaned-doc-comment) ] f
make-lint-rule register-lint-rule

\ --- Rule 2: doc-comment-misuse ---

(check-doc-comment-misuse): ( path source tokens line-index semantic-context -- diagnostics ) [
  drop V{ } 0 f
  \ stack: path(6) source(5) tokens(4) line-index(3) results(2) depth(1) line-has-code?(0)
  4 pick-n [
    \ stack: path(7) source(6) tokens(5) line-index(4) results(3) depth(2) line-has-code?(1) token(0)
    dup kind>> doc-comment: = [
      2 pick-n 0 > 2 pick-n or [
        (push-doc-misuse!)
      ] [
        drop
      ] if
    ] [
      dup kind>> newline: = [
        drop
        drop f
      ] [
        dup kind>> whitespace: = over kind>> comment: = or [
          drop
        ] [
          dup kind>> open-bracket: = [
            drop
            swap ++ swap
          ] [
            dup kind>> close-bracket: = [
              drop
              swap dup 0 > [ -- ] when swap
            ] [
              drop
            ] if
          ] if
          drop t
        ] if
      ] if
    ] if
  ] #each
  drop drop
  [ drop drop drop drop ] dip
] ;

"doc-comment-misuse" warning: [ (check-doc-comment-misuse) ] f
make-lint-rule register-lint-rule

\ --- Rule 3: non-kebab-case ---

(check-non-kebab-case): ( path source tokens line-index semantic-context -- diagnostics ) [
  drop V{ } t
  \ stack: path(5) source(4) tokens(3) line-index(2) results(1) stmt-start?(0)
  3 pick-n [
    \ stack: path(6) source(5) tokens(4) line-index(3) results(2) stmt-start?(1) token(0)
    dup definition-symbol? 2 pick-n and [
      dup value>> dup #len 1 - #take (non-kebab-core?) [
        (push-non-kebab!)
      ] [
        drop
      ] if
      drop f
    ] [
      dup (preserve-statement-start?) [
        drop
      ] [
        dup kind>> open-bracket: = over kind>> semicolon: = or [
          drop drop t
        ] [
          drop drop f
        ] if
      ] if
    ] if
  ] #each
  drop
  [ drop drop drop drop ] dip
] ;

"non-kebab-case" warning: [ (check-non-kebab-case) ] f
make-lint-rule register-lint-rule

\ --- Rule 4: comment-missing-space ---
\ A backslash not followed by a space. The tokenizer only recognizes
\ comments when \ is followed by whitespace, so failed comments appear
\ as word tokens starting with \.

(check-comment-space): ( path source tokens line-index semantic-context -- diagnostics ) [
  drop V{ }
  \ stack: path(4) source(3) tokens(2) line-index(1) results(0)
  2 pick-n [
    \ stack: path(5) source(4) tokens(3) line-index(2) results(1) token(0)
    dup kind>> word: = [
      dup value>> "\\" #starts-with? [
        dup pos>>
        \ stack: ... line-index(3) results(2) token(1) pos(0)
        "comment-missing-space" warning:
        \ stack: ... line-index(5) results(4) token(3) pos(2) rid(1) sev(0)
        8 pick-n 6 pick-n 4 pick-n
        "comment marker not followed by a space" (make-diag)
        \ stack: ... results(3) token(2) pos(1) diagnostic(0)
        3 pick-n swap #push! drop drop
      ] when
    ] when
    drop
  ] #each
  [ drop drop drop drop ] dip
] ;

"comment-missing-space" warning: [ (check-comment-space) ] f
make-lint-rule register-lint-rule

\ --- Rule 5: excessive-blank-lines ---
\ Three or more consecutive blank lines. Tracks consecutive newline
\ tokens (whitespace between newlines does not break the run).
\ Flags when count reaches 4 (content-line newline + 3 blank lines).

(check-blank-lines): ( path source tokens line-index semantic-context -- diagnostics ) [
  drop V{ } 0 f
  \ stack: path(6) source(5) tokens(4) line-index(3) results(2) nl-count(1) flag-pos(0)
  4 pick-n [
    \ stack: path(7) source(6) tokens(5) line-index(4) results(3) nl-count(2) flag-pos(1) token(0)
    dup kind>> newline: = [
      pos>>
      [ [ ++ ] dip ] dip
      2 pick-n 4 = [
        [ drop ] dip
      ] [
        drop
      ] if
    ] [
      dup kind>> whitespace: = [
        drop
      ] [
        drop
        dup f = not [
          dup
          "excessive-blank-lines" warning:
          9 pick-n 7 pick-n 4 pick-n
          "3 or more consecutive blank lines" (make-diag)
          4 pick-n swap #push! drop
          drop
        ] when
        nip 0 swap drop f
      ] if
    ] if
  ] #each
  dup f = not [
    dup
    "excessive-blank-lines" warning:
    8 pick-n 6 pick-n 4 pick-n
    "3 or more consecutive blank lines" (make-diag)
    3 pick-n swap #push! drop
    drop
  ] [
  ] if
  drop drop
  [ drop drop drop drop ] dip
] ;

"excessive-blank-lines" warning: [ (check-blank-lines) ] f
make-lint-rule register-lint-rule
