\ lib/pratt/arith.1z - Pre-wired arithmetic Pratt parser

"pratt" load reexport
use "lexer" ;

ARITHMETIC-OPS: const [
  H{
    "+" H{ left-bp: 10 right-bp: 11 }
    "-" H{ left-bp: 10 right-bp: 11 }
    "*" H{ left-bp: 20 right-bp: 21 }
    "/" H{ left-bp: 20 right-bp: 21 }
  }
] ;

UNARY-MINUS-BP: const [ 30 ] ;

private{
  (unexpected-expression): never-returns ( token -- * ) [
    "expected expression, got '" throw-token-error
  ] ;

  (expected-close-paren): never-returns ( token/f -- * ) [
    dup f = [
      drop f "expected ')' at end of input" EParseError make-error throw
    ] [
      "expected ')', got '" throw-token-error
    ] if
  ] ;

  (parse-number-token): ( token -- value ) [
    dup value>> resolve-literal [ nip ] [
      drop pos>> [ H{ } offset: ] dip @set "invalid numeric literal" throw-parse-error
    ] if
  ] ;

  (parse-group): ( parser tokens -- value ) [
    2dup swap 0 parse-pratt
    1 pick-n next-token
    dup f = [ (expected-close-paren) ] when
    dup value>> ")" = not [ (expected-close-paren) ] when
    drop nip nip
  ] ;
}

arith-prefix: ( token parser tokens -- value ) [
  <rot-
  \ parser tokens token
  dup kind>> number: = [
    (parse-number-token)
    nip nip
  ] [
    dup value>> "(" = [
      drop (parse-group)
    ] [
      dup value>> "-" = [
        drop
        swap UNARY-MINUS-BP parse-pratt
        -1 *
      ] [
        (unexpected-expression)
      ] if
    ] if
  ] if
] ;

arith-infix: ( left token parser tokens -- value ) [
  parse-right
  \ left token right
  swap dup value>>
  \ left right token op
  dup "+" = [ 2drop + ] [
    dup "-" = [ 2drop - ] [
      dup "*" = [ 2drop * ] [
        dup "/" = [ 2drop / ] [
          drop "unknown operator '" throw-token-error
        ] if
      ] if
    ] if
  ] if
] ;

\\ Construct a Pratt parser pre-wired for arithmetic expressions.
\\ Supports `+`, `-`, `*`, `/`, parentheses, and unary minus.
<arithmetic-pratt>: ( -- parser ) [
  H{
    operators: ARITHMETIC-OPS
    prefix:    [ arith-prefix ]
    infix:     [ arith-infix ]
  } <pratt>
] ;
