\ lib/rate-limit.1z - Token bucket rate limiter

use "time" ;

rate-limiter: mutable struct{ tokens burst interval last-refill } ;

\\ A token-bucket rate limiter that starts full. One token is added per `interval`, a duration, up
\\ to `burst` tokens.
\\
\\   10 per-second 5 <rate-limiter> tokens>>
\\   => 5
<rate-limiter>: ( interval burst -- limiter ) [
  dup                    \ interval burst burst
  <rot- unmake-duration  \ burst burst interval-nanos
  monotonic-nanos        \ burst burst interval-nanos last-refill
  make-rate-limiter      \ tokens=burst burst=burst interval last-refill
] ;

\\ The interval that adds n tokens per second.
per-second: ( n -- duration ) [ 1 seconds swap / ] ;

\\ The interval that adds n tokens per minute.
per-minute: ( n -- duration ) [ 1 minutes swap / ] ;

\\ Add one token for each whole interval since the last refill, capped at the burst size. Mutates
\\ the limiter in place. The time left over from a partial interval is dropped when tokens are
\\ added.
refill: ( limiter -- limiter ) [
  dup last-refill>>       \ limiter last-refill
  monotonic-nanos swap -  \ limiter elapsed
  over interval>>         \ limiter elapsed interval
  dup 0 = [ 2drop ] [
    div  \ limiter new-tokens
    dup 0 > [
      over tokens>> +                \ limiter raw-tokens
      over burst>> min               \ limiter capped-tokens
      >>tokens                       \ limiter
      monotonic-nanos >>last-refill  \ limiter
    ] [
      drop
    ] if
  ] if
] ;

acquire: method{ rate-limiter } [
  refill
  dup tokens>> 0 > [
    dup tokens>> 1 - >>tokens drop
  ] [
    dup interval>> >duration sleep
    acquire
  ] if
] ;

try-acquire: method{ rate-limiter } [
  refill
  dup tokens>> 0 > [
    dup tokens>> 1 - >>tokens drop
    t >option:some
  ] [
    drop option:none
  ] if
] ;

pragma{ lint-suppress: { dead-definition: missing-type-annotation: } }
