\ lib/task.1z - Concurrency combinators for use within task-scope

\\ Spawn n tasks that each run the quotation, and return their handles in spawn order. Must be
\\ called inside a `task-scope`.
\\
\\   [ [ 7 ] 3 spawn-n await-all . ] task-scope
\\   => { 7 7 7 }
spawn-n: ( quot n -- array ) [
  { } -rot>                            \ { } quot n
  [ dup [ spawn ] dip [ #push ] dip ]  \ { } quot n [body]
  times                                \ times pops [body] then n; body runs with { } quot on stack
  drop                                 \ drop leftover quot
] ;

\\ Run an array of quotations as concurrent tasks and wait for all of them. The results come back
\\ in the order of the quotations. Must be called inside a `task-scope`.
\\
\\   [ { [ 1 ] [ 2 ] } concurrent . ] task-scope
\\   => { 1 2 }
concurrent: ( array -- array ) [
  [ spawn ] #map #collect
  await-all
] ;

pragma{ lint-suppress: { dead-definition: missing-type-annotation: } }
