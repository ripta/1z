\ lib/cons-list.1z - Immutable cons-cell linked lists

use "sequences" ;

cons-cell: struct{ head tail } ;
cons-list: enum{
  cons: cons-cell
  nil: unit
} ;

\\ A list with `head` in front of the list `tail`. O(1), and `tail` is shared, not copied.
\\
\\   1 2 nil cons cons cons-list>array
\\   => { 1 2 }
cons: ( head tail -- cons-list ) [ make-cons-list:cons ] ;

\\ The empty list.
nil: ( -- cons-list ) [ cons-list:nil ] ;

\\ True when the value is a non-empty list.
cons?: ( value -- bool ) [ cons-list:cons? ] ;

\\ True when the value is the empty list.
nil?: ( value -- bool ) [ cons-list:nil? ] ;

\\ The first element. Throws `index-out-of-bounds` on the empty list.
head: ( cons-list -- value ) [
  {
    cons-list:cons: [ drop ]
    cons-list:nil: [ f "head of empty list" EIndexOutOfBounds make-error throw ]
  } unchecked-match
] ;

\\ The list after the first element. Throws `index-out-of-bounds` on the empty list.
tail: ( cons-list -- cons-list ) [
  {
    cons-list:cons: [ swap drop ]
    cons-list:nil: [ f "tail of empty list" EIndexOutOfBounds make-error throw ]
  } unchecked-match
] ;

\\ The elements as an array, head first. O(n), and not tail-recursive.
cons-list>array: ( cons-list -- array ) [
  {
    cons-list:cons: [ cons-list>array #prefix ]
    cons-list:nil: [ { } ]
  } unchecked-match
] ;

\\ A list of the array's elements in the same order. O(n).
\\
\\   { 1 2 3 } >cons-list head
\\   => 1
>cons-list: stack-recursive ( array -- cons-list ) [
  dup #len 0 = [ drop nil ] [
    dup #first swap
    1 over #len #slice
    >cons-list cons
  ] if
] ;

\\ The number of elements. O(n).
list-len: ( cons-list -- n ) [
  0 swap
  [ dup cons? ] [ tail swap 1 + swap ] while
  drop
] ;

private{
  list-reverse-acc: ( acc list -- cons-list ) [
    {
      cons-list:cons: [ [ swap cons ] dip list-reverse-acc ]
      cons-list:nil: [ ]
    } unchecked-match
  ] ;
}

\\ The elements in reverse order. O(n).
list-reverse: ( cons-list -- cons-list ) [
  nil swap list-reverse-acc
] ;

\\ The element at 0-based index n. O(n). Throws `index-out-of-bounds` when n is negative or past
\\ the end.
\\
\\   { 10 20 30 } >cons-list 1 list-nth
\\   => 20
list-nth: ( cons-list n -- value ) [
  over nil? [ 2drop f "list index out of bounds" EIndexOutOfBounds make-error throw ] [
    dup 0 = [ drop head ] [ 1 - swap tail swap list-nth ] if
  ] if
] ;

\\ The elements of the first list followed by those of the second. O(n) in the first list, which
\\ is copied. The second list is shared.
\\
\\   { 1 2 } >cons-list { 3 } >cons-list list-append cons-list>array
\\   => { 1 2 3 }
list-append: ( cons-list-a cons-list-b -- cons-list' ) [
  swap {
    cons-list:cons: [ <rot- list-append cons ]
    cons-list:nil: [ ]
  } unchecked-match
] ;

\\ Call `quot ( elem -- )` on each element, head to tail.
list-each: ( cons-list quot -- ) [
  swap {
    cons-list:cons: [
      [ swap dup [ call ] dip ] dip swap list-each
    ]
    cons-list:nil: [ drop ]
  } unchecked-match
] ;

\\ Fold from the head to the tail.
\\
\\   { 1 2 3 } >cons-list nil [ swap cons ] list-foldl cons-list>array
\\   => { 3 2 1 }
list-foldl: ( cons-list acc quot: ( acc elem -- acc' ) -- acc' ) [
  <rot-
  {
    cons-list:cons: [
      [ swap dup [ call ] dip ] dip -rot> list-foldl
    ]
    cons-list:nil: [ drop ]
  } unchecked-match
] ;

\\ Alias of `list-foldl`.
\\
\\   { 1 2 3 } >cons-list 0 [ + ] list-fold
\\   => 6
list-fold: ( cons-list acc quot: ( acc elem -- acc' ) -- acc' ) [ list-foldl ] ;

\\ Fold from the tail to the head. Not tail-recursive, so it takes O(n) stack frames.
\\
\\   { 1 2 3 } >cons-list nil [ cons ] list-foldr cons-list>array
\\   => { 1 2 3 }
list-foldr: ( cons-list init quot: ( elem acc -- acc' ) -- result ) [
  <rot-
  {
    cons-list:cons: [
      3 pick-n 3 pick-n list-foldr
      <rot- call swap drop
    ]
    cons-list:nil: [ drop ]
  } unchecked-match
] ;

\\ A new list of `quot ( elem -- elem' )` applied to each element, in order. Not tail-recursive.
\\
\\   { 1 2 3 } >cons-list [ 10 * ] list-map cons-list>array
\\   => { 10 20 30 }
list-map: ( cons-list quot -- cons-list' ) [
  swap {
    cons-list:cons: [
      over 3 pick-n call
      -rot> swap drop
      swap [ swap list-map ] dip swap cons
    ]
    cons-list:nil: [ drop nil ]
  } unchecked-match
] ;

\\ A new list of the elements for which `quot ( elem -- ? )` is true, in order. Not tail-recursive.
\\
\\   { 1 2 3 4 } >cons-list [ even? ] list-filter cons-list>array
\\   => { 2 4 }
list-filter: ( cons-list quot -- cons-list' ) [
  swap {
    cons-list:cons: [
      over 3 pick-n call
      [ swap [ swap list-filter ] dip swap cons ]
      [ swap drop swap list-filter ] if
    ]
    cons-list:nil: [ drop nil ]
  } unchecked-match
] ;

private{
  \ Iterator step: state is a one-element vector holding the remaining list.
  list-iter-step: ( state -- option ) [
    dup 0 #nth
    dup cons? [
      dup head swap tail
      2 pick-n 0 <rot- #nth! drop
      nip >option:some
    ] [
      2drop option:none
    ] if
  ] ;
}

\ Iterator protocol integration: lazy spine walk, O(1) per step.
>iterator: method{ cons-list } [
  [ ] make-vector swap #push!
  [ list-iter-step ] curry
  >iterator
] ;

\ O(1) protocol conformance: #first is the head, #empty? is nil?.
\
\ #len, #last, and #nth are left unimplemented. Each is an O(n) spine walk, so iteration
\ through >iterator stays the visible path for them.
#first: method{ cons-list } [ head ] ;
#empty?: method{ cons-list } [ nil? ] ;

>array: method{ cons-list } [ cons-list>array ] ;

pragma{ lint-suppress: { broad-import: dead-definition: missing-type-annotation: } }
