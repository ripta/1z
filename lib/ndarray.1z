\ lib/ndarray.1z - N-dimensional arrays

ndarray: virtual{ struct{ data shape strides element-type } } ;

shape-product: ( shape -- n ) [ 1 [ * ] #reduce ] ;

row-major-strides: ( shape -- strides ) [
  dup shape-product
  [ ] make-vector swap
  <rot- >iterator [
    div dup <rot- swap #push! swap
  ] #each
  drop
] ;

contiguous?: ( shape strides -- bool ) [
  swap row-major-strides =
] ;

ndarray: ( data shape -- ndarray ) [
  dup #len 0 = [ f "shape must be non-empty" EInvalidArgument make-error throw ] when
  dup [ dup fixnum? [ 0 > ] [ drop f ] if ] #filter #collect #len over #len =
  not [ f "shape elements must be positive fixnums" EInvalidArgument make-error throw ] when

  over #len over shape-product =
  not [ f "data length does not match shape product" EInvalidArgument make-error throw ] when

  swap [ ] make-vector swap #append! swap

  over 0 #nth type-of
  \ stack: data-vec shape elem-type

  2 pick-n >iterator [
    type-of
    over = not
    [ f "all elements must have the same type" EInvalidArgument make-error throw ] when
  ] #each
  \ stack: data-vec shape elem-type

  over row-major-strides swap
  make-ndarray
] ;

shape: ( ndarray -- array ) [ unmake-ndarray drop drop nip ] ;
rank: ( ndarray -- n ) [ shape #len ] ;
element-type: ( ndarray -- sym )     [ unmake-ndarray nip nip nip ] ;
data>>:       ( ndarray -- vec )     [ unmake-ndarray drop drop drop ] ;
strides>>:    ( ndarray -- strides ) [ unmake-ndarray drop nip nip ] ;

reshape: ( ndarray new-shape -- ndarray ) [
  over shape shape-product over shape-product =
  not [ f "reshape: total element count must match" EInvalidArgument make-error throw ] when

  swap dup shape over strides>> contiguous?
  not [ f "reshape: non-contiguous ndarray not yet supported" EInvalidArgument make-error throw ] when

  dup data>> swap element-type
  \ stack: new-shape data-vec elem-type
  <rot-
  \ stack: data-vec elem-type new-shape
  dup row-major-strides
  \ stack: data-vec elem-type new-shape new-strides
  <rot-
  \ stack: data-vec new-shape new-strides elem-type
  make-ndarray
] ;

#len: method{ ndarray } [
  shape shape-product
] ;

#nth: method{ ndarray fixnum } [
  dup 0 < [ f "index out of bounds" EIndexOutOfBounds make-error throw ] when
  over #len over <= [ f "index out of bounds" EIndexOutOfBounds make-error throw ] when
  swap data>> swap #nth
] ;

ref: ( ndarray index-array -- val ) [
  over rank over #len =
  not [ f "index array length must equal rank" EInvalidArgument make-error throw ] when

  over shape 2 pick-n strides>>
  \ stack: ndarray idx-arr shape strides
  0 0
  \ stack: ndarray idx-arr shape strides offset dim
  [ dup 5 pick-n #len < ] [
    dup 5 pick-n swap #nth
    \ stack: ndarray idx-arr shape strides offset dim idx-val
    dup 0 < [ f "negative index" EIndexOutOfBounds make-error throw ] when
    over 5 pick-n swap #nth
    \ stack: ndarray idx-arr shape strides offset dim idx-val shape-dim
    over swap >= [ f "index out of bounds" EIndexOutOfBounds make-error throw ] when
    \ stack: ndarray idx-arr shape strides offset dim idx-val
    over 4 pick-n swap #nth *
    \ stack: ndarray idx-arr shape strides offset dim product
    <rot- + swap
    \ stack: ndarray idx-arr shape strides offset' dim
    ++
  ] while
  drop nip nip nip swap data>> swap #nth
] ;

ref2d: ( ndarray i j -- val ) [
  2 pick-n rank 2 =
  not [ f "ref2d requires rank-2 ndarray" EInvalidArgument make-error throw ] when
  { } 2 pick-n #push over #push nip nip ref
] ;

ref3d: ( ndarray i j k -- val ) [
  3 pick-n rank 3 =
  not [ f "ref3d requires rank-3 ndarray" EInvalidArgument make-error throw ] when
  { } 3 pick-n #push 2 pick-n #push over #push nip nip nip ref
] ;

\ Element-wise arithmetic support

EShapeMismatch: [ shape-mismatch: ] ;

assert-shapes=: ( ndarray ndarray -- ) [
  over shape over shape =
  not [
    over shape inspect " vs " #append
    swap shape inspect #append
    EShapeMismatch make-error throw
  ] [ 2drop ] if
] ;

vec>ndarray: ( result-vec result-shape -- ndarray ) [
  dup row-major-strides
  2 pick-n 0 #nth type-of
  make-ndarray
] ;

scalar-op: ( ndarray scalar quot -- ndarray ) [
  curry
  \ stack: ndarray quot'
  swap dup shape swap data>> >iterator
  \ stack: quot' result-shape data-iter
  <rot-
  \ stack: result-shape data-iter quot'
  #map #collect
  \ stack: result-shape result-arr
  [ ] make-vector swap #append!
  \ stack: result-shape result-vec
  swap vec>ndarray
] ;

\ Element-wise ndarray+ndarray iteration using #each on data-a.
\ The body increments i and accesses data-b[i], applies the operation,
\ and pushes the result into result-vec.

element-wise+: ( ndarray ndarray -- ndarray ) [
  2dup assert-shapes=
  over shape -rot> data>> swap data>> swap
  \ stack: result-shape data-a data-b
  [ ] make-vector 0
  \ stack: result-shape data-a data-b result-vec i
  3 pick-n >iterator [
    \ stack: result-shape data-a data-b result-vec i elem-a
    over 4 pick-n swap #nth +
    2 pick-n swap #push! drop
    ++
  ] #each
  drop nip nip
  \ stack: result-shape result-vec
  swap vec>ndarray
] ;

element-wise-: ( ndarray ndarray -- ndarray ) [
  2dup assert-shapes=
  over shape -rot> data>> swap data>> swap
  \ stack: result-shape data-a data-b
  [ ] make-vector 0
  3 pick-n >iterator [
    over 4 pick-n swap #nth -
    2 pick-n swap #push! drop
    ++
  ] #each
  drop nip nip
  swap vec>ndarray
] ;

element-wise*: ( ndarray ndarray -- ndarray ) [
  2dup assert-shapes=
  over shape -rot> data>> swap data>> swap
  [ ] make-vector 0
  3 pick-n >iterator [
    over 4 pick-n swap #nth *
    2 pick-n swap #push! drop
    ++
  ] #each
  drop nip nip
  swap vec>ndarray
] ;

element-wise/: ( ndarray ndarray -- ndarray ) [
  2dup assert-shapes=
  over shape -rot> data>> swap data>> swap
  [ ] make-vector 0
  3 pick-n >iterator [
    over 4 pick-n swap #nth /
    2 pick-n swap #push! drop
    ++
  ] #each
  drop nip nip
  swap vec>ndarray
] ;

\ ndarray + ndarray element-wise arithmetic

+: method{ ndarray ndarray } [ element-wise+ ] ;
-: method{ ndarray ndarray } [ element-wise- ] ;
*: method{ ndarray ndarray } [ element-wise* ] ;
/: method{ ndarray ndarray } [ element-wise/ ] ;

\ ndarray + scalar (right-hand)

+: method{ ndarray fixnum } [ [ + ] scalar-op ] ;
-: method{ ndarray fixnum } [ [ - ] scalar-op ] ;
*: method{ ndarray fixnum } [ [ * ] scalar-op ] ;
/: method{ ndarray fixnum } [ [ / ] scalar-op ] ;

+: method{ ndarray float } [ [ + ] scalar-op ] ;
-: method{ ndarray float } [ [ - ] scalar-op ] ;
*: method{ ndarray float } [ [ * ] scalar-op ] ;
/: method{ ndarray float } [ [ / ] scalar-op ] ;

+: method{ ndarray bignum } [ [ + ] scalar-op ] ;
-: method{ ndarray bignum } [ [ - ] scalar-op ] ;
*: method{ ndarray bignum } [ [ * ] scalar-op ] ;
/: method{ ndarray bignum } [ [ / ] scalar-op ] ;

+: method{ ndarray ratio } [ [ + ] scalar-op ] ;
-: method{ ndarray ratio } [ [ - ] scalar-op ] ;
*: method{ ndarray ratio } [ [ * ] scalar-op ] ;
/: method{ ndarray ratio } [ [ / ] scalar-op ] ;

\ scalar + ndarray (left-hand)

+: method{ fixnum ndarray } [ swap [ + ] scalar-op ] ;
-: method{ fixnum ndarray } [ swap [ swap - ] scalar-op ] ;
*: method{ fixnum ndarray } [ swap [ * ] scalar-op ] ;
/: method{ fixnum ndarray } [ swap [ swap / ] scalar-op ] ;

+: method{ float ndarray } [ swap [ + ] scalar-op ] ;
-: method{ float ndarray } [ swap [ swap - ] scalar-op ] ;
*: method{ float ndarray } [ swap [ * ] scalar-op ] ;
/: method{ float ndarray } [ swap [ swap / ] scalar-op ] ;

+: method{ bignum ndarray } [ swap [ + ] scalar-op ] ;
-: method{ bignum ndarray } [ swap [ swap - ] scalar-op ] ;
*: method{ bignum ndarray } [ swap [ * ] scalar-op ] ;
/: method{ bignum ndarray } [ swap [ swap / ] scalar-op ] ;

+: method{ ratio ndarray } [ swap [ + ] scalar-op ] ;
-: method{ ratio ndarray } [ swap [ swap - ] scalar-op ] ;
*: method{ ratio ndarray } [ swap [ * ] scalar-op ] ;
/: method{ ratio ndarray } [ swap [ swap / ] scalar-op ] ;
