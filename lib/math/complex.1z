\ lib/complex.1z - Complex numbers

use "math" ;
use "math/ratio" ;

complex: H{ numeric: t } virtual{ struct{ real imag } } ;

\\ Extract the real component of a complex number.
real-part: ( c -- f ) [ unmake-complex drop ] ;

\\ Extract the imaginary component of a complex number.
imaginary-part: ( c -- f ) [ unmake-complex nip ] ;

\\ Complex literal syntax. Promotes components to float.
C{: parse-time [ "}" parse-until call >float swap >float swap make-complex ] ;

inspect: method{ complex } [
  "C{ " over real-part >string #append
  " " #append
  swap imaginary-part >string #append
  " }" #append
] ;

\ --- Complex-complex arithmetic ---

+: method{ complex complex } [
  over real-part over real-part +
  2 pick-n imaginary-part 2 pick-n imaginary-part +
  make-complex -rot> 2drop
] ;

-: method{ complex complex } [
  over real-part over real-part -
  2 pick-n imaginary-part 2 pick-n imaginary-part -
  make-complex -rot> 2drop
] ;

*: method{ complex complex } [
  over real-part over real-part *
  2 pick-n imaginary-part 2 pick-n imaginary-part *
  -
  2 pick-n real-part 2 pick-n imaginary-part *
  3 pick-n imaginary-part 3 pick-n real-part *
  +
  make-complex -rot> 2drop
] ;

/: method{ complex complex } [
  over real-part over real-part *
  2 pick-n imaginary-part 2 pick-n imaginary-part *
  +
  2 pick-n imaginary-part 2 pick-n real-part *
  3 pick-n real-part 3 pick-n imaginary-part *
  -
  2 pick-n real-part dup *
  3 pick-n imaginary-part dup *
  +
  tuck / -rot> / swap
  make-complex -rot> 2drop
] ;

=: method{ complex complex } [
  over real-part over real-part =
  [ imaginary-part swap imaginary-part = ]
  [ 2drop f ]
  if
] ;

\ --- Mixed complex/float ---

+: method{ complex float } [ 0.0 make-complex + ] ;
+: method{ float complex } [ swap 0.0 make-complex swap + ] ;

-: method{ complex float } [ 0.0 make-complex - ] ;
-: method{ float complex } [ swap 0.0 make-complex swap - ] ;

*: method{ complex float } [ 0.0 make-complex * ] ;
*: method{ float complex } [ swap 0.0 make-complex swap * ] ;

/: method{ complex float } [ 0.0 make-complex / ] ;
/: method{ float complex } [ swap 0.0 make-complex swap / ] ;

=: method{ complex float } [ 0.0 make-complex = ] ;
=: method{ float complex } [ swap 0.0 make-complex swap = ] ;

\ --- Mixed complex/fixnum ---

+: method{ complex fixnum } [ >float 0.0 make-complex + ] ;
+: method{ fixnum complex } [ swap >float 0.0 make-complex swap + ] ;

-: method{ complex fixnum } [ >float 0.0 make-complex - ] ;
-: method{ fixnum complex } [ swap >float 0.0 make-complex swap - ] ;

*: method{ complex fixnum } [ >float 0.0 make-complex * ] ;
*: method{ fixnum complex } [ swap >float 0.0 make-complex swap * ] ;

/: method{ complex fixnum } [ >float 0.0 make-complex / ] ;
/: method{ fixnum complex } [ swap >float 0.0 make-complex swap / ] ;

=: method{ complex fixnum } [ >float 0.0 make-complex = ] ;
=: method{ fixnum complex } [ swap >float 0.0 make-complex swap = ] ;

\ --- Mixed complex/bignum ---

+: method{ complex bignum } [ >float 0.0 make-complex + ] ;
+: method{ bignum complex } [ swap >float 0.0 make-complex swap + ] ;

-: method{ complex bignum } [ >float 0.0 make-complex - ] ;
-: method{ bignum complex } [ swap >float 0.0 make-complex swap - ] ;

*: method{ complex bignum } [ >float 0.0 make-complex * ] ;
*: method{ bignum complex } [ swap >float 0.0 make-complex swap * ] ;

/: method{ complex bignum } [ >float 0.0 make-complex / ] ;
/: method{ bignum complex } [ swap >float 0.0 make-complex swap / ] ;

=: method{ complex bignum } [ >float 0.0 make-complex = ] ;
=: method{ bignum complex } [ swap >float 0.0 make-complex swap = ] ;

\ --- Mixed complex/ratio ---

+: method{ complex ratio } [ >float 0.0 make-complex + ] ;
+: method{ ratio complex } [ swap >float 0.0 make-complex swap + ] ;

-: method{ complex ratio } [ >float 0.0 make-complex - ] ;
-: method{ ratio complex } [ swap >float 0.0 make-complex swap - ] ;

*: method{ complex ratio } [ >float 0.0 make-complex * ] ;
*: method{ ratio complex } [ swap >float 0.0 make-complex swap * ] ;

/: method{ complex ratio } [ >float 0.0 make-complex / ] ;
/: method{ ratio complex } [ swap >float 0.0 make-complex swap / ] ;

=: method{ complex ratio } [ >float 0.0 make-complex = ] ;
=: method{ ratio complex } [ swap >float 0.0 make-complex swap = ] ;

\ --- Transcendental functions ---

\\ Complex exponential: e^(a+bi) = e^a * (cos b + i sin b).
\\ No branch cut.
exp: method{ complex } [
  dup real-part native.exp
  swap imaginary-part
  dup native.cos 2 pick-n *
  swap native.sin 2 pick-n *
  make-complex nip
] ;

\\ Complex natural logarithm: ln|z| + i*arg(z).
\\ Branch cut: negative real axis (imaginary part of result in (-pi, pi]).
log: method{ complex } [
  dup magnitude native.log
  swap phase
  make-complex
] ;

\\ Complex square root via polar form: sqrt(|z|) * cis(arg(z)/2).
\\ Branch cut: negative real axis (result has non-negative real part).
sqrt: method{ complex } [
  dup magnitude native.sqrt
  swap phase 2.0 /
  dup native.cos 2 pick-n *
  swap native.sin 2 pick-n *
  make-complex nip
] ;

\\ Complex sine: sin(a+bi) = sin(a)*cosh(b) + i*cos(a)*sinh(b).
\\ No branch cut.
sin: method{ complex } [
  dup real-part swap imaginary-part
  native.exp dup 1.0 swap /
  over over + 2.0 /
  \ stack: a e^b e^(-b) cosh(b)
  3 pick-n native.sin *
  \ stack: a e^b e^(-b) sin(a)*cosh(b)
  -rot> - 2.0 /
  \ stack: a sin(a)*cosh(b) sinh(b)
  2 pick-n native.cos *
  \ stack: a sin(a)*cosh(b) cos(a)*sinh(b)
  make-complex nip
] ;

\\ Complex cosine: cos(a+bi) = cos(a)*cosh(b) - i*sin(a)*sinh(b).
\\ No branch cut.
cos: method{ complex } [
  dup real-part swap imaginary-part
  native.exp dup 1.0 swap /
  over over + 2.0 /
  \ stack: a e^b e^(-b) cosh(b)
  3 pick-n native.cos *
  \ stack: a e^b e^(-b) cos(a)*cosh(b)
  -rot> - 2.0 /
  \ stack: a cos(a)*cosh(b) sinh(b)
  2 pick-n native.sin * 0.0 swap -
  \ stack: a cos(a)*cosh(b) -sin(a)*sinh(b)
  make-complex nip
] ;

\\ Complex exponentiation: base^exp = exp(exp * log(base)).
\\ Branch cut: inherited from log (negative real axis of base).
pow: method{ complex complex } [ swap log * exp ] ;
pow: method{ complex float } [ 0.0 make-complex pow ] ;
pow: method{ float complex } [ swap 0.0 make-complex swap pow ] ;
pow: method{ complex fixnum } [ >float 0.0 make-complex pow ] ;
pow: method{ fixnum complex } [ swap >float 0.0 make-complex swap pow ] ;
pow: method{ complex bignum } [ >float 0.0 make-complex pow ] ;
pow: method{ bignum complex } [ swap >float 0.0 make-complex swap pow ] ;
pow: method{ complex ratio } [ >float 0.0 make-complex pow ] ;
pow: method{ ratio complex } [ swap >float 0.0 make-complex swap pow ] ;

\ --- Misc. library words ---

\\ Absolute value (modulus) of a complex number.
magnitude: ( c -- f ) [
  dup real-part dup * swap imaginary-part dup * + native.sqrt
] ;

\\ Argument (angle in radians) of a complex number.
phase: ( c -- f ) [
  dup imaginary-part swap real-part native.atan2
] ;

\\ Complex conjugate: negate the imaginary part.
conjugate: ( c -- c ) [
  dup real-part swap imaginary-part 0.0 swap - make-complex
] ;
