\ lib/ratio.1z - Exact rational arithmetic

EInexactConversion: [ inexact-conversion: ] ;

ratio: H{ numeric: t exact: t } virtual{ struct{ numer denom } } ;

\ Accessors: unwrap the virtual type, then extract by position
\ Virtual structs don't export these by default
numer>>: ( ratio -- n ) [ unmake-ratio drop ] ;
denom>>: ( ratio -- d ) [ unmake-ratio nip ] ;

\ Normalizing constructor: reduces to lowest terms, enforces positive
\ denominator, demotes to integer when denominator is 1.
normalize-ratio: ( numer denom -- ratio-or-int ) [
  dup 0 = [ f "division by zero" EDivisionByZero make-error throw ] when
  2dup gcd
  tuck
  div
  -rot>
  div
  swap
  dup 0 <
  [ [ 0 swap - ] dip 0 swap - ] when
  dup 1 =
  [ drop ]
  [ make-ratio ]
  if
] ;

inspect: method{ ratio } [
  dup numer>> >string "/" #append
  swap denom>> >string #append
] ;

\ --- Ratio-ratio arithmetic ---

+: method{ ratio ratio } [
  over numer>> over denom>> *
  2 pick-n denom>> 2 pick-n numer>> *
  +
  -rot> denom>> swap denom>> *
  normalize-ratio
] ;

-: method{ ratio ratio } [
  over numer>> over denom>> *
  2 pick-n denom>> 2 pick-n numer>> *
  -
  -rot> denom>> swap denom>> *
  normalize-ratio
] ;

*: method{ ratio ratio } [
  over numer>> over numer>> *
  -rot> denom>> swap denom>> *
  normalize-ratio
] ;

/: method{ ratio ratio } [
  over numer>> over denom>> *
  -rot> numer>> swap denom>> *
  normalize-ratio
] ;

\ --- Integer division producing ratios when inexact ---

/: method{ fixnum fixnum } [
  2dup rem 0 = [ div ] [ normalize-ratio ] if
] ;

/: method{ bignum bignum } [
  2dup rem 0 = [ div ] [ normalize-ratio ] if
] ;

/: method{ fixnum bignum } [
  2dup rem 0 = [ div ] [ normalize-ratio ] if
] ;

/: method{ bignum fixnum } [
  2dup rem 0 = [ div ] [ normalize-ratio ] if
] ;

%: method{ ratio ratio } [
  over numer>> over denom>> *
  2 pick-n denom>> 2 pick-n numer>> *
  %
  -rot> denom>> swap denom>> *
  normalize-ratio
] ;

=: method{ ratio ratio } [
  over numer>> over numer>> =
  [ denom>> swap denom>> = ]
  [ 2drop f ]
  if
] ;

<: method{ ratio ratio } [
  over numer>> over denom>> *
  -rot> numer>> swap denom>> *
  <
] ;

>: method{ ratio ratio } [
  over numer>> over denom>> *
  -rot> numer>> swap denom>> *
  >
] ;

\ --- Ratio-to-float promotion ---

ratio>float: ( ratio -- f ) [ dup numer>> >float swap denom>> >float / ] ;

\ --- Mixed ratio/float arithmetic ---

+: method{ ratio float } [ swap ratio>float swap + ] ;
+: method{ float ratio } [ ratio>float + ] ;

-: method{ ratio float } [ swap ratio>float swap - ] ;
-: method{ float ratio } [ ratio>float - ] ;

*: method{ ratio float } [ swap ratio>float swap * ] ;
*: method{ float ratio } [ ratio>float * ] ;

/: method{ ratio float } [ swap ratio>float swap / ] ;
/: method{ float ratio } [ ratio>float / ] ;

%: method{ ratio float } [ swap ratio>float swap % ] ;
%: method{ float ratio } [ ratio>float % ] ;

=: method{ ratio float } [ swap ratio>float swap = ] ;
=: method{ float ratio } [ ratio>float = ] ;

<: method{ ratio float } [ swap ratio>float swap < ] ;
<: method{ float ratio } [ ratio>float < ] ;

>: method{ ratio float } [ swap ratio>float swap > ] ;
>: method{ float ratio } [ ratio>float > ] ;

\ --- Mixed integer/ratio arithmetic ---

+: method{ ratio fixnum } [ 1 make-ratio + ] ;
+: method{ fixnum ratio } [ swap 1 make-ratio swap + ] ;
+: method{ ratio bignum } [ 1 make-ratio + ] ;
+: method{ bignum ratio } [ swap 1 make-ratio swap + ] ;

-: method{ ratio fixnum } [ 1 make-ratio - ] ;
-: method{ fixnum ratio } [ swap 1 make-ratio swap - ] ;
-: method{ ratio bignum } [ 1 make-ratio - ] ;
-: method{ bignum ratio } [ swap 1 make-ratio swap - ] ;

*: method{ ratio fixnum } [ 1 make-ratio * ] ;
*: method{ fixnum ratio } [ swap 1 make-ratio swap * ] ;
*: method{ ratio bignum } [ 1 make-ratio * ] ;
*: method{ bignum ratio } [ swap 1 make-ratio swap * ] ;

/: method{ ratio fixnum } [ 1 make-ratio / ] ;
/: method{ fixnum ratio } [ swap 1 make-ratio swap / ] ;
/: method{ ratio bignum } [ 1 make-ratio / ] ;
/: method{ bignum ratio } [ swap 1 make-ratio swap / ] ;

%: method{ ratio fixnum } [ 1 make-ratio % ] ;
%: method{ fixnum ratio } [ swap 1 make-ratio swap % ] ;
%: method{ ratio bignum } [ 1 make-ratio % ] ;
%: method{ bignum ratio } [ swap 1 make-ratio swap % ] ;

=: method{ ratio fixnum } [ 1 make-ratio = ] ;
=: method{ fixnum ratio } [ swap 1 make-ratio swap = ] ;
=: method{ ratio bignum } [ 1 make-ratio = ] ;
=: method{ bignum ratio } [ swap 1 make-ratio swap = ] ;

<: method{ ratio fixnum } [ 1 make-ratio < ] ;
<: method{ fixnum ratio } [ swap 1 make-ratio swap < ] ;
<: method{ ratio bignum } [ 1 make-ratio < ] ;
<: method{ bignum ratio } [ swap 1 make-ratio swap < ] ;

>: method{ ratio fixnum } [ 1 make-ratio > ] ;
>: method{ fixnum ratio } [ swap 1 make-ratio swap > ] ;
>: method{ ratio bignum } [ 1 make-ratio > ] ;
>: method{ bignum ratio } [ swap 1 make-ratio swap > ] ;

\ --- Conversion words ---

>integer: method{ ratio } [ dup numer>> swap denom>> div ] ;
>float: method{ ratio } [ ratio>float ] ;

float-approx-ratio: ( f -- ratio-or-int ) [ native.float-approx-ratio normalize-ratio ] ;

\ Exact f64 bit representation as a ratio using float-parts.
\ value = sign * mantissa * 2^exponent
float>ratio: ( f -- ratio-or-int ) [
  float-parts
  -rot>
  dup 0 >= [
    1 swap shift-left
    swap *
    swap *
  ] [
    0 swap -
    1 swap shift-left
    normalize-ratio
    swap *
  ] if
] ;

\\ Exact float conversion. Errors with EInexactConversion if the conversion
\\ loses precision (e.g., large integers or non-dyadic rationals).
>float(exact): ( x -- f ) [
  dup float?
  [ ]
  [ dup >float dup float>ratio <rot- = not [ f "inexact conversion" EInexactConversion make-error throw ] when ]
  if
] ;

\ --- Rational precision constants ---

(e-terms): ( n -- terms ) [ 10 * 3 div dup 10 < [ drop 10 ] when ] ;

\\ Compute e as a rational to n decimal digits of precision.
\\ Uses the Taylor series in Horner form: starting from k=N down to 1,
\\ result = 1 + result/k.
e-approx: ( n -- ratio ) [
  (e-terms)
  1 swap
  [ dup 0 > ]
  [ dup -rot> / 1 + swap 1 - ]
  while
  drop
] ;

(pi-terms): ( n -- terms ) [ dup 10 < [ drop 10 ] when ] ;

\\ Compute arctan(x) as a rational, where x is a ratio and terms is the
\\ number of series terms. Uses Horner evaluation of the series
\\ arctan(x) = x * (1 - x^2/3 + x^4/5 - ...).
\\ Loop stack layout: x x^2 result k
(arctan-ratio): ( x terms -- ratio ) [
  over dup *
  swap
  dup 1 - 2 * 1 + 1 swap normalize-ratio
  swap 1 -
  [ dup 0 >= ]
  [
    swap 2 pick-n *
    over 2 * 1 + 1 swap normalize-ratio
    swap - swap 1 -
  ]
  while
  drop nip *
] ;

\\ Compute pi as a rational to n decimal digits of precision.
\\ Uses Machin's formula: pi = 16*arctan(1/5) - 4*arctan(1/239).
pi-approx: ( n -- ratio ) [
  (pi-terms)
  1 5 normalize-ratio over (arctan-ratio) 16 *
  1 239 normalize-ratio <rot- (arctan-ratio) 4 *
  -
] ;

\\ Compute arctanh(x) as a rational, where x is a ratio and terms is the
\\ number of series terms. Uses Horner evaluation of the series
\\ arctanh(x) = x * (1 + x^2/3 + x^4/5 + ...).
\\ Same structure as (arctan-ratio) but all additions, no alternating signs.
\\ Loop stack layout: x x^2 result k
(arctanh-ratio): ( x terms -- ratio ) [
  over dup *
  swap
  dup 1 - 2 * 1 + 1 swap normalize-ratio
  swap 1 -
  [ dup 0 >= ]
  [
    swap 2 pick-n *
    over 2 * 1 + 1 swap normalize-ratio
    swap + swap 1 -
  ]
  while
  drop nip *
] ;

(ln-terms): ( n -- terms ) [ 10 * 3 div dup 10 < [ drop 10 ] when ] ;

\\ Generic Newton-Raphson square root: compute sqrt(S) as a rational
\\ to n decimal digits. Quadratic convergence needs ~ceil(log2(3.32*n))
\\ iterations. Uses x_{n+1} = (x_n + S/x_n) / 2. Initial guess is 1.
\\ Compute ceil(log2(4*n)) by repeated halving, minimum 5.
(sqrt-iters): ( n -- iters ) [
  4 * 1 swap
  [ dup 1 > ] [ swap 1 + swap 2 div ] while
  drop
  dup 5 < [ drop 5 ] when
] ;

\\ Loop stack layout: S x iters
(sqrt-approx): ( S n -- ratio ) [
  (sqrt-iters)
  1 swap
  [ dup 0 > ]
  [
    -rot>
    2dup / + 2 /
    <rot-
    1 -
  ]
  while
  drop nip
] ;

\\ Compute sqrt(2) as a rational to n decimal digits of precision.
sqrt2-approx: ( n -- ratio ) [ 2 swap (sqrt-approx) ] ;

\\ Compute sqrt(5) as a rational to n decimal digits of precision.
sqrt5-approx: ( n -- ratio ) [ 5 swap (sqrt-approx) ] ;

\\ Compute the golden ratio (1 + sqrt(5)) / 2 as a rational
\\ to n decimal digits of precision.
phi-approx: ( n -- ratio ) [ sqrt5-approx 1 + 2 / ] ;

\\ Compute ln(2) as a rational to n decimal digits of precision.
\\ Uses the identity ln(2) = 2 * arctanh(1/3).
ln2-approx: ( n -- ratio ) [
  (ln-terms)
  1 3 normalize-ratio swap (arctanh-ratio) 2 *
] ;

\\ Compute ln(10) as a rational to n decimal digits of precision.
\\ Uses the identity ln(10) = 2 * ln(2) + 2 * arctanh(3/7).
ln10-approx: ( n -- ratio ) [
  dup ln2-approx 2 *
  swap (ln-terms)
  3 7 normalize-ratio swap (arctanh-ratio) 2 *
  +
] ;
