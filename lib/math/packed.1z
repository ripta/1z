\ Reductions

\\ The sum of the elements, or 0 when empty. An integer sum wraps in the element type, so
\\ `{ 100 200 } >packed:u8 packed-sum` is 44.
packed-sum: generic ( packed-T -- number ) [
  f "packed-sum: not a packed type" EInvalidArgument make-error throw
] ;
packed-sum: method{ packed-i8 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-i16 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-i32 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-i64 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-u8 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-u16 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-u32 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-u64 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-f32 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-f64 } [ native.packed-sum-impl ] ;

\\ The product of the elements, or 1 when empty. An integer product wraps in the element type.
packed-product: generic ( packed-T -- number ) [
  f "packed-product: not a packed type" EInvalidArgument make-error throw
] ;
packed-product: method{ packed-i8 } [ native.packed-product-impl ] ;
packed-product: method{ packed-i16 } [ native.packed-product-impl ] ;
packed-product: method{ packed-i32 } [ native.packed-product-impl ] ;
packed-product: method{ packed-i64 } [ native.packed-product-impl ] ;
packed-product: method{ packed-u8 } [ native.packed-product-impl ] ;
packed-product: method{ packed-u16 } [ native.packed-product-impl ] ;
packed-product: method{ packed-u32 } [ native.packed-product-impl ] ;
packed-product: method{ packed-u64 } [ native.packed-product-impl ] ;
packed-product: method{ packed-f32 } [ native.packed-product-impl ] ;
packed-product: method{ packed-f64 } [ native.packed-product-impl ] ;

\\ The smallest element. Throws `invalid-argument` when empty.
packed-min: generic ( packed-T -- number ) [
  f "packed-min: not a packed type" EInvalidArgument make-error throw
] ;
packed-min: method{ packed-i8 } [ native.packed-min-impl ] ;
packed-min: method{ packed-i16 } [ native.packed-min-impl ] ;
packed-min: method{ packed-i32 } [ native.packed-min-impl ] ;
packed-min: method{ packed-i64 } [ native.packed-min-impl ] ;
packed-min: method{ packed-u8 } [ native.packed-min-impl ] ;
packed-min: method{ packed-u16 } [ native.packed-min-impl ] ;
packed-min: method{ packed-u32 } [ native.packed-min-impl ] ;
packed-min: method{ packed-u64 } [ native.packed-min-impl ] ;
packed-min: method{ packed-f32 } [ native.packed-min-impl ] ;
packed-min: method{ packed-f64 } [ native.packed-min-impl ] ;

\\ The largest element. Throws `invalid-argument` when empty.
packed-max: generic ( packed-T -- number ) [
  f "packed-max: not a packed type" EInvalidArgument make-error throw
] ;
packed-max: method{ packed-i8 } [ native.packed-max-impl ] ;
packed-max: method{ packed-i16 } [ native.packed-max-impl ] ;
packed-max: method{ packed-i32 } [ native.packed-max-impl ] ;
packed-max: method{ packed-i64 } [ native.packed-max-impl ] ;
packed-max: method{ packed-u8 } [ native.packed-max-impl ] ;
packed-max: method{ packed-u16 } [ native.packed-max-impl ] ;
packed-max: method{ packed-u32 } [ native.packed-max-impl ] ;
packed-max: method{ packed-u64 } [ native.packed-max-impl ] ;
packed-max: method{ packed-f32 } [ native.packed-max-impl ] ;
packed-max: method{ packed-f64 } [ native.packed-max-impl ] ;

\\ The sum of the element-wise products of two packed arrays of the same type, or 0 when empty.
\\ An integer result wraps in the element type. Throws `type-mismatch` when the lengths differ.
\\
\\   { 1 2 3 } >packed:i32 { 4 5 6 } >packed:i32 packed-dot
\\   => 32
packed-dot: generic ( packed-T packed-T -- number ) [
  f "packed-dot: not a packed type" EInvalidArgument make-error throw
] ;
packed-dot: method{ packed-i8 packed-i8 } [ native.packed-dot-impl ] ;
packed-dot: method{ packed-i16 packed-i16 } [ native.packed-dot-impl ] ;
packed-dot: method{ packed-i32 packed-i32 } [ native.packed-dot-impl ] ;
packed-dot: method{ packed-i64 packed-i64 } [ native.packed-dot-impl ] ;
packed-dot: method{ packed-u8 packed-u8 } [ native.packed-dot-impl ] ;
packed-dot: method{ packed-u16 packed-u16 } [ native.packed-dot-impl ] ;
packed-dot: method{ packed-u32 packed-u32 } [ native.packed-dot-impl ] ;
packed-dot: method{ packed-u64 packed-u64 } [ native.packed-dot-impl ] ;
packed-dot: method{ packed-f32 packed-f32 } [ native.packed-dot-impl ] ;
packed-dot: method{ packed-f64 packed-f64 } [ native.packed-dot-impl ] ;

\ Sequence protocol

#len: method{ packed-i8 } [ native.packed-len ] ;
#len: method{ packed-i16 } [ native.packed-len ] ;
#len: method{ packed-i32 } [ native.packed-len ] ;
#len: method{ packed-i64 } [ native.packed-len ] ;
#len: method{ packed-u8 } [ native.packed-len ] ;
#len: method{ packed-u16 } [ native.packed-len ] ;
#len: method{ packed-u32 } [ native.packed-len ] ;
#len: method{ packed-u64 } [ native.packed-len ] ;
#len: method{ packed-f32 } [ native.packed-len ] ;
#len: method{ packed-f64 } [ native.packed-len ] ;

#nth: method{ packed-i8 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-i16 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-i32 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-i64 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-u8 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-u16 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-u32 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-u64 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-f32 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-f64 fixnum } [ native.packed-nth ] ;

>iterator: method{ packed-i8 } [ unmake-packed-i8 "i8" native.packed-iterator ] ;
>iterator: method{ packed-i16 } [ unmake-packed-i16 "i16" native.packed-iterator ] ;
>iterator: method{ packed-i32 } [ unmake-packed-i32 "i32" native.packed-iterator ] ;
>iterator: method{ packed-i64 } [ unmake-packed-i64 "i64" native.packed-iterator ] ;
>iterator: method{ packed-u8 } [ unmake-packed-u8 "u8" native.packed-iterator ] ;
>iterator: method{ packed-u16 } [ unmake-packed-u16 "u16" native.packed-iterator ] ;
>iterator: method{ packed-u32 } [ unmake-packed-u32 "u32" native.packed-iterator ] ;
>iterator: method{ packed-u64 } [ unmake-packed-u64 "u64" native.packed-iterator ] ;
>iterator: method{ packed-f32 } [ unmake-packed-f32 "f32" native.packed-iterator ] ;
>iterator: method{ packed-f64 } [ unmake-packed-f64 "f64" native.packed-iterator ] ;

\\ Decompose a packed float array into its backing byte-array and element-type symbol.
\\
\\ #map probes this word to vectorize a recognized arithmetic quotation. Only the float
\\ types register it: a recognized #map over a packed-f32 computes in f32, matching the
\\ explicit broadcast path rather than the f64 the scalar quotation path computes in.
\\
\\   { 1.5 2.5 } >packed:f32 packed-parts nip
\\   => f32:
packed-parts: generic ( packed-T -- byte-array elem-type ) [
  f "packed-parts: not a packed float type" EInvalidArgument make-error throw
] ;
packed-parts: method{ packed-f32 } [ unmake-packed-f32 f32: ] ;
packed-parts: method{ packed-f64 } [ unmake-packed-f64 f64: ] ;

\ Display support

(packed-inspect-helper): ( packed-T type-name -- string ) [
  "packed-" swap #append "{ " #append
  swap packed>array
  dup #len 0 = [ drop "}" #append ] [
    >iterator [ inspect ] #map #collect " " #join #append " }" #append
  ] if
] ;

inspect: method{ packed-i8 } [ "i8" (packed-inspect-helper) ] ;
inspect: method{ packed-i16 } [ "i16" (packed-inspect-helper) ] ;
inspect: method{ packed-i32 } [ "i32" (packed-inspect-helper) ] ;
inspect: method{ packed-i64 } [ "i64" (packed-inspect-helper) ] ;
inspect: method{ packed-u8 } [ "u8" (packed-inspect-helper) ] ;
inspect: method{ packed-u16 } [ "u16" (packed-inspect-helper) ] ;
inspect: method{ packed-u32 } [ "u32" (packed-inspect-helper) ] ;
inspect: method{ packed-u64 } [ "u64" (packed-inspect-helper) ] ;
inspect: method{ packed-f32 } [ "f32" (packed-inspect-helper) ] ;
inspect: method{ packed-f64 } [ "f64" (packed-inspect-helper) ] ;

>string: method{ packed-i8 } [ inspect ] ;
>string: method{ packed-i16 } [ inspect ] ;
>string: method{ packed-i32 } [ inspect ] ;
>string: method{ packed-i64 } [ inspect ] ;
>string: method{ packed-u8 } [ inspect ] ;
>string: method{ packed-u16 } [ inspect ] ;
