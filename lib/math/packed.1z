\ Sequence protocol

#len: method{ packed-i8 } [ native.packed-len ] ;
#len: method{ packed-i16 } [ native.packed-len ] ;
#len: method{ packed-i32 } [ native.packed-len ] ;
#len: method{ packed-i64 } [ native.packed-len ] ;
#len: method{ packed-u8 } [ native.packed-len ] ;
#len: method{ packed-u16 } [ native.packed-len ] ;
#len: method{ packed-u32 } [ native.packed-len ] ;
#len: method{ packed-u64 } [ native.packed-len ] ;
#len: method{ packed-f32 } [ native.packed-len ] ;
#len: method{ packed-f64 } [ native.packed-len ] ;

#nth: method{ packed-i8 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-i16 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-i32 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-i64 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-u8 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-u16 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-u32 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-u64 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-f32 fixnum } [ native.packed-nth ] ;
#nth: method{ packed-f64 fixnum } [ native.packed-nth ] ;

>iterator: method{ packed-i8 } [ unmake-packed-i8 "i8" native.packed-iterator ] ;
>iterator: method{ packed-i16 } [ unmake-packed-i16 "i16" native.packed-iterator ] ;
>iterator: method{ packed-i32 } [ unmake-packed-i32 "i32" native.packed-iterator ] ;
>iterator: method{ packed-i64 } [ unmake-packed-i64 "i64" native.packed-iterator ] ;
>iterator: method{ packed-u8 } [ unmake-packed-u8 "u8" native.packed-iterator ] ;
>iterator: method{ packed-u16 } [ unmake-packed-u16 "u16" native.packed-iterator ] ;
>iterator: method{ packed-u32 } [ unmake-packed-u32 "u32" native.packed-iterator ] ;
>iterator: method{ packed-u64 } [ unmake-packed-u64 "u64" native.packed-iterator ] ;
>iterator: method{ packed-f32 } [ unmake-packed-f32 "f32" native.packed-iterator ] ;
>iterator: method{ packed-f64 } [ unmake-packed-f64 "f64" native.packed-iterator ] ;

\ Display support

(packed-inspect-helper): ( packed-T type-name -- string ) [
  "packed-" swap #append "{ " #append
  swap packed>array
  dup #len 0 = [ drop "}" #append ] [
    >iterator [ inspect ] #map #collect " " #join #append " }" #append
  ] if
] ;

inspect: method{ packed-i8 } [ "i8" (packed-inspect-helper) ] ;
inspect: method{ packed-i16 } [ "i16" (packed-inspect-helper) ] ;
inspect: method{ packed-i32 } [ "i32" (packed-inspect-helper) ] ;
inspect: method{ packed-i64 } [ "i64" (packed-inspect-helper) ] ;
inspect: method{ packed-u8 } [ "u8" (packed-inspect-helper) ] ;
inspect: method{ packed-u16 } [ "u16" (packed-inspect-helper) ] ;
inspect: method{ packed-u32 } [ "u32" (packed-inspect-helper) ] ;
inspect: method{ packed-u64 } [ "u64" (packed-inspect-helper) ] ;
inspect: method{ packed-f32 } [ "f32" (packed-inspect-helper) ] ;
inspect: method{ packed-f64 } [ "f64" (packed-inspect-helper) ] ;

>string: method{ packed-i8 } [ inspect ] ;
>string: method{ packed-i16 } [ inspect ] ;
>string: method{ packed-i32 } [ inspect ] ;
>string: method{ packed-i64 } [ inspect ] ;
>string: method{ packed-u8 } [ inspect ] ;
>string: method{ packed-u16 } [ inspect ] ;
>string: method{ packed-u32 } [ inspect ] ;
>string: method{ packed-u64 } [ inspect ] ;
>string: method{ packed-f32 } [ inspect ] ;
>string: method{ packed-f64 } [ inspect ] ;
