/: method{ packed-i64 fixnum } [ native.packed-scalar-div ] ;
/: method{ packed-i64 float } [ native.packed-scalar-div ] ;

+: method{ packed-u8 fixnum } [ native.packed-scalar-add ] ;
+: method{ packed-u8 float } [ native.packed-scalar-add ] ;
-: method{ packed-u8 fixnum } [ native.packed-scalar-sub ] ;
-: method{ packed-u8 float } [ native.packed-scalar-sub ] ;
*: method{ packed-u8 fixnum } [ native.packed-scalar-mul ] ;
*: method{ packed-u8 float } [ native.packed-scalar-mul ] ;
/: method{ packed-u8 fixnum } [ native.packed-scalar-div ] ;
/: method{ packed-u8 float } [ native.packed-scalar-div ] ;

+: method{ packed-u16 fixnum } [ native.packed-scalar-add ] ;
+: method{ packed-u16 float } [ native.packed-scalar-add ] ;
-: method{ packed-u16 fixnum } [ native.packed-scalar-sub ] ;
