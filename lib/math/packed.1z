+: method{ packed-u32 packed-u32 } [ native.packed-add ] ;
-: method{ packed-u32 packed-u32 } [ native.packed-sub ] ;
*: method{ packed-u32 packed-u32 } [ native.packed-mul ] ;
/: method{ packed-u32 packed-u32 } [ native.packed-div ] ;

+: method{ packed-u64 packed-u64 } [ native.packed-add ] ;
-: method{ packed-u64 packed-u64 } [ native.packed-sub ] ;
*: method{ packed-u64 packed-u64 } [ native.packed-mul ] ;
/: method{ packed-u64 packed-u64 } [ native.packed-div ] ;

+: method{ packed-f32 packed-f32 } [ native.packed-add ] ;
-: method{ packed-f32 packed-f32 } [ native.packed-sub ] ;
*: method{ packed-f32 packed-f32 } [ native.packed-mul ] ;
/: method{ packed-f32 packed-f32 } [ native.packed-div ] ;

+: method{ packed-f64 packed-f64 } [ native.packed-add ] ;
-: method{ packed-f64 packed-f64 } [ native.packed-sub ] ;
*: method{ packed-f64 packed-f64 } [ native.packed-mul ] ;
/: method{ packed-f64 packed-f64 } [ native.packed-div ] ;

