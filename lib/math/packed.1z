/: method{ packed-u16 fixnum } [ native.packed-scalar-div ] ;
/: method{ packed-u16 float } [ native.packed-scalar-div ] ;

+: method{ packed-u32 fixnum } [ native.packed-scalar-add ] ;
+: method{ packed-u32 float } [ native.packed-scalar-add ] ;
-: method{ packed-u32 fixnum } [ native.packed-scalar-sub ] ;
