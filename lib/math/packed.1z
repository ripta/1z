\ lib/math/packed.1z - Packed array types with SIMD-accelerated element-wise arithmetic

use "strings" ;

\ A byte-array backing is deliberately not freezable, so these are not set members or container
\ keys. See docs/guides/type-system.md, "Freezing a Newtype".

\\ A packed array of signed 8-bit integers. Integer `+`, `-`, and `*` wrap on overflow.
packed-i8: virtual{ byte-array } ;

\\ A packed array of signed 16-bit integers. Integer `+`, `-`, and `*` wrap on overflow.
packed-i16: virtual{ byte-array } ;

\\ A packed array of signed 32-bit integers. Integer `+`, `-`, and `*` wrap on overflow.
packed-i32: virtual{ byte-array } ;

\\ A packed array of signed 64-bit integers. Integer `+`, `-`, and `*` wrap on overflow.
packed-i64: virtual{ byte-array } ;

\\ A packed array of unsigned 8-bit integers. Integer `+`, `-`, and `*` wrap on overflow.
packed-u8: virtual{ byte-array } ;

\\ A packed array of unsigned 16-bit integers. Integer `+`, `-`, and `*` wrap on overflow.
packed-u16: virtual{ byte-array } ;

\\ A packed array of unsigned 32-bit integers. Integer `+`, `-`, and `*` wrap on overflow.
packed-u32: virtual{ byte-array } ;

\\ A packed array of unsigned 64-bit integers. Integer `+`, `-`, and `*` wrap on overflow.
packed-u64: virtual{ byte-array } ;

\\ A packed array of 32-bit floats. Arithmetic computes in single precision.
packed-f32: virtual{ byte-array } ;

\\ A packed array of 64-bit floats.
packed-f64: virtual{ byte-array } ;

\\ A packed-i8 of the array's elements. Throws `type-mismatch` when an element is not a whole
\\ number in the i8 range.
>packed:i8: ( array -- packed-i8 ) [ "i8" native.packed-from-array >packed-i8 ] ;

\\ A packed-i16 of the array's elements. Throws `type-mismatch` when an element is not a whole
\\ number in the i16 range.
>packed:i16: ( array -- packed-i16 ) [ "i16" native.packed-from-array >packed-i16 ] ;

\\ A packed-i32 of the array's elements. Throws `type-mismatch` when an element is not a whole
\\ number in the i32 range.
>packed:i32: ( array -- packed-i32 ) [ "i32" native.packed-from-array >packed-i32 ] ;

\\ A packed-i64 of the array's elements. Throws `type-mismatch` when an element is not a whole
\\ number in the i64 range.
>packed:i64: ( array -- packed-i64 ) [ "i64" native.packed-from-array >packed-i64 ] ;

\\ A packed-u8 of the array's elements. Throws `type-mismatch` when an element is not a whole
\\ number in the u8 range.
>packed:u8: ( array -- packed-u8 ) [ "u8" native.packed-from-array >packed-u8 ] ;

\\ A packed-u16 of the array's elements. Throws `type-mismatch` when an element is not a whole
\\ number in the u16 range.
>packed:u16: ( array -- packed-u16 ) [ "u16" native.packed-from-array >packed-u16 ] ;

\\ A packed-u32 of the array's elements. Throws `type-mismatch` when an element is not a whole
\\ number in the u32 range.
>packed:u32: ( array -- packed-u32 ) [ "u32" native.packed-from-array >packed-u32 ] ;

\\ A packed-u64 of the array's elements. Throws `type-mismatch` when an element is not a whole
\\ number in the u64 range.
>packed:u64: ( array -- packed-u64 ) [ "u64" native.packed-from-array >packed-u64 ] ;

\\ A packed-f32 of the array's elements, with integers converted to float.
>packed:f32: ( array -- packed-f32 ) [ "f32" native.packed-from-array >packed-f32 ] ;

\\ A packed-f64 of the array's elements, with integers converted to float.
>packed:f64: ( array -- packed-f64 ) [ "f64" native.packed-from-array >packed-f64 ] ;

\\ A packed-i8 of n copies of value. Throws `type-mismatch` when the value does not fit.
\\
\\   3 -7 packed-fill:i8 packed>array
\\   => { -7 -7 -7 }
packed-fill:i8: ( n: fixnum value -- packed-i8 ) [ "i8" native.packed-fill-impl >packed-i8 ] ;

\\ A packed-i16 of n copies of value. Throws `type-mismatch` when the value does not fit.
\\
\\   3 7 packed-fill:i16 packed>array
\\   => { 7 7 7 }
packed-fill:i16: ( n: fixnum value -- packed-i16 ) [ "i16" native.packed-fill-impl >packed-i16 ] ;

\\ A packed-i32 of n copies of value. Throws `type-mismatch` when the value does not fit.
\\
\\   2 -1 packed-fill:i32 packed>array
\\   => { -1 -1 }
packed-fill:i32: ( n: fixnum value -- packed-i32 ) [ "i32" native.packed-fill-impl >packed-i32 ] ;

\\ A packed-i64 of n copies of value. Throws `type-mismatch` when the value does not fit.
\\
\\   2 5 packed-fill:i64 packed>array
\\   => { 5 5 }
packed-fill:i64: ( n: fixnum value -- packed-i64 ) [ "i64" native.packed-fill-impl >packed-i64 ] ;

\\ A packed-u8 of n copies of value. Throws `type-mismatch` when the value does not fit.
\\
\\   3 255 packed-fill:u8 packed>array
\\   => { 255 255 255 }
packed-fill:u8: ( n: fixnum value -- packed-u8 ) [ "u8" native.packed-fill-impl >packed-u8 ] ;

\\ A packed-u16 of n copies of value. Throws `type-mismatch` when the value does not fit.
\\
\\   2 9 packed-fill:u16 packed>array
\\   => { 9 9 }
packed-fill:u16: ( n: fixnum value -- packed-u16 ) [ "u16" native.packed-fill-impl >packed-u16 ] ;

\\ A packed-u32 of n copies of value. Throws `type-mismatch` when the value does not fit.
\\
\\   2 9 packed-fill:u32 packed>array
\\   => { 9 9 }
packed-fill:u32: ( n: fixnum value -- packed-u32 ) [ "u32" native.packed-fill-impl >packed-u32 ] ;

\\ A packed-u64 of n copies of value. Throws `type-mismatch` when the value does not fit.
\\
\\   2 9 packed-fill:u64 packed>array
\\   => { 9 9 }
packed-fill:u64: ( n: fixnum value -- packed-u64 ) [ "u64" native.packed-fill-impl >packed-u64 ] ;

\\ A packed-f32 of n copies of value.
\\
\\   2 0.5 packed-fill:f32 packed>array
\\   => { 0.5 0.5 }
packed-fill:f32: ( n: fixnum value -- packed-f32 ) [ "f32" native.packed-fill-impl >packed-f32 ] ;

\\ A packed-f64 of n copies of value.
\\
\\   2 1.5 packed-fill:f64 packed>array
\\   => { 1.5 1.5 }
packed-fill:f64: ( n: fixnum value -- packed-f64 ) [ "f64" native.packed-fill-impl >packed-f64 ] ;

\\ The elements as an array of numbers. Throws `invalid-argument` on a value that is
\\ not a packed array.
packed>array: generic ( packed-T -- array ) [
  f "packed>array: not a packed type" EInvalidArgument make-error throw
] ;
packed>array: method{ packed-i8 } [ native.packed-to-array ] ;
packed>array: method{ packed-i16 } [ native.packed-to-array ] ;
packed>array: method{ packed-i32 } [ native.packed-to-array ] ;
packed>array: method{ packed-i64 } [ native.packed-to-array ] ;
packed>array: method{ packed-u8 } [ native.packed-to-array ] ;
packed>array: method{ packed-u16 } [ native.packed-to-array ] ;
packed>array: method{ packed-u32 } [ native.packed-to-array ] ;
packed>array: method{ packed-u64 } [ native.packed-to-array ] ;
packed>array: method{ packed-f32 } [ native.packed-to-array ] ;
packed>array: method{ packed-f64 } [ native.packed-to-array ] ;

\ Element-wise arithmetic: + - * /
+: method{ packed-i8 packed-i8 } [ native.packed-add ] ;
-: method{ packed-i8 packed-i8 } [ native.packed-sub ] ;
*: method{ packed-i8 packed-i8 } [ native.packed-mul ] ;
/: method{ packed-i8 packed-i8 } [ native.packed-div ] ;

+: method{ packed-i16 packed-i16 } [ native.packed-add ] ;
-: method{ packed-i16 packed-i16 } [ native.packed-sub ] ;
*: method{ packed-i16 packed-i16 } [ native.packed-mul ] ;
/: method{ packed-i16 packed-i16 } [ native.packed-div ] ;

+: method{ packed-i32 packed-i32 } [ native.packed-add ] ;
-: method{ packed-i32 packed-i32 } [ native.packed-sub ] ;
*: method{ packed-i32 packed-i32 } [ native.packed-mul ] ;
/: method{ packed-i32 packed-i32 } [ native.packed-div ] ;

