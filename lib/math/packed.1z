packed-dot: method{ packed-u32 packed-u32 } [ native.packed-dot-impl ] ;
packed-dot: method{ packed-u64 packed-u64 } [ native.packed-dot-impl ] ;
packed-dot: method{ packed-f32 packed-f32 } [ native.packed-dot-impl ] ;
