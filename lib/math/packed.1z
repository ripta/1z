\ Reductions

packed-sum: generic ( packed-T -- number ) [
  f "packed-sum: not a packed type" EInvalidArgument make-error throw
] ;
packed-sum: method{ packed-i8 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-i16 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-i32 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-i64 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-u8 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-u16 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-u32 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-u64 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-f32 } [ native.packed-sum-impl ] ;
packed-sum: method{ packed-f64 } [ native.packed-sum-impl ] ;

