packed-max: method{ packed-u16 } [ native.packed-max-impl ] ;
packed-max: method{ packed-u32 } [ native.packed-max-impl ] ;
packed-max: method{ packed-u64 } [ native.packed-max-impl ] ;
packed-max: method{ packed-f32 } [ native.packed-max-impl ] ;
