+: method{ packed-i32 float } [ native.packed-scalar-add ] ;
-: method{ packed-i32 fixnum } [ native.packed-scalar-sub ] ;
-: method{ packed-i32 float } [ native.packed-scalar-sub ] ;
*: method{ packed-i32 fixnum } [ native.packed-scalar-mul ] ;
*: method{ packed-i32 float } [ native.packed-scalar-mul ] ;
/: method{ packed-i32 fixnum } [ native.packed-scalar-div ] ;
/: method{ packed-i32 float } [ native.packed-scalar-div ] ;

+: method{ packed-i64 fixnum } [ native.packed-scalar-add ] ;
+: method{ packed-i64 float } [ native.packed-scalar-add ] ;
-: method{ packed-i64 fixnum } [ native.packed-scalar-sub ] ;
-: method{ packed-i64 float } [ native.packed-scalar-sub ] ;
*: method{ packed-i64 fixnum } [ native.packed-scalar-mul ] ;
