\ Unit tests for lib/math/ratio.1z.

use "testing" ;
use "math/ratio" ;

math: "math" load ;

\ --- Accessors ---

test-numer-denom: ( -- ) [
  "accessors" test-section
  3 4 make-ratio numer>> 3 "numer>> extracts the numerator" assert=
  3 4 make-ratio denom>> 4 "denom>> extracts the denominator" assert=
] ;

\ --- normalize-ratio ---

test-normalize-reduces: ( -- ) [
  "normalize-ratio" test-section
  2 4 normalize-ratio numer>> 1 "2/4 reduces numerator to 1" assert=
  2 4 normalize-ratio denom>> 2 "2/4 reduces denominator to 2" assert=
] ;

test-normalize-collapses-to-int: ( -- ) [
  6 3 normalize-ratio 2 "6/3 collapses to the integer 2" assert=
  6 3 normalize-ratio fixnum? t "6/3 result is a fixnum" assert=
  -6 3 normalize-ratio -2 "-6/3 collapses to the integer -2" assert=
] ;

test-normalize-positive-denominator: ( -- ) [
  -1 -2 normalize-ratio numer>> 1 "negatives cancel to a positive numerator" assert=
  -1 -2 normalize-ratio denom>> 2 "negatives cancel to a positive denominator" assert=
  -3 6 normalize-ratio numer>> -1 "sign moves to the numerator" assert=
  -3 6 normalize-ratio denom>> 2 "denominator stays positive" assert=
] ;

test-normalize-division-by-zero: ( -- ) [
  [ 1 0 normalize-ratio ] division-by-zero: "zero denominator throws" assert-error-type
] ;

\ --- make-ratio (raw, no reduction) ---

test-make-ratio-raw: ( -- ) [
  "make-ratio" test-section
  2 4 make-ratio numer>> 2 "make-ratio does not reduce the numerator" assert=
  2 4 make-ratio denom>> 4 "make-ratio does not reduce the denominator" assert=
] ;

\ --- ratio>float (exact binary cases) ---

test-ratio-to-float-exact: ( -- ) [
  "ratio>float" test-section
  1 2 normalize-ratio ratio>float 0.5 "1/2 is exactly 0.5" assert=
  1 4 normalize-ratio ratio>float 0.25 "1/4 is exactly 0.25" assert=
  3 4 make-ratio ratio>float 0.75 "3/4 is exactly 0.75" assert=
] ;

\ --- >float / >integer methods ---

test-to-float-method: ( -- ) [
  "conversions" test-section
  1 2 normalize-ratio >float 0.5 ">float on a ratio yields 0.5" assert=
] ;

test-to-integer-method: ( -- ) [
  1 2 normalize-ratio >integer 0 ">integer truncates 1/2 to 0" assert=
  3 2 normalize-ratio >integer 1 ">integer truncates 3/2 to 1" assert=
] ;

\ --- float>ratio (exact f64 decomposition) ---

test-float-to-ratio-exact: ( -- ) [
  "float>ratio" test-section
  0.5 float>ratio numer>> 1 "0.5 decomposes to numerator 1" assert=
  0.5 float>ratio denom>> 2 "0.5 decomposes to denominator 2" assert=
  0.25 float>ratio numer>> 1 "0.25 decomposes to numerator 1" assert=
  0.25 float>ratio denom>> 4 "0.25 decomposes to denominator 4" assert=
] ;

\ --- float-approx-ratio ---

test-float-approx-ratio: ( -- ) [
  "float-approx-ratio" test-section
  0.5 float-approx-ratio numer>> 1 "0.5 approximates to numerator 1" assert=
  0.5 float-approx-ratio denom>> 2 "0.5 approximates to denominator 2" assert=
  0.1 float-approx-ratio numer>> 1 "0.1 approximates to numerator 1" assert=
  0.1 float-approx-ratio denom>> 10 "0.1 approximates to denominator 10" assert=
] ;

\ --- Ratio arithmetic via the numeric tower ---

test-ratio-arithmetic: ( -- ) [
  "arithmetic" test-section
  1 2 normalize-ratio 1 2 normalize-ratio + 1 "1/2 + 1/2 collapses to 1" assert=
  1 3 normalize-ratio 1 6 normalize-ratio + numer>> 1 "1/3 + 1/6 numerator is 1" assert=
  1 3 normalize-ratio 1 6 normalize-ratio + denom>> 2 "1/3 + 1/6 denominator is 2" assert=
  2 3 normalize-ratio 3 4 normalize-ratio * numer>> 1 "2/3 * 3/4 numerator is 1" assert=
  2 3 normalize-ratio 3 4 normalize-ratio * denom>> 2 "2/3 * 3/4 denominator is 2" assert=
] ;

\ --- Series approximations return ratios ---

test-approx-types: ( -- ) [
  "approximation types" test-section
  10 e-approx ratio instance-of? "e-approx returns a ratio" assert-true
  10 pi-approx ratio instance-of? "pi-approx returns a ratio" assert-true
  10 sqrt2-approx ratio instance-of? "sqrt2-approx returns a ratio" assert-true
  10 sqrt5-approx ratio instance-of? "sqrt5-approx returns a ratio" assert-true
  10 phi-approx ratio instance-of? "phi-approx returns a ratio" assert-true
  10 ln2-approx ratio instance-of? "ln2-approx returns a ratio" assert-true
  10 ln10-approx ratio instance-of? "ln10-approx returns a ratio" assert-true
] ;

\ --- Series approximations are accurate within a tolerance ---
\ Asserting a boolean tolerance check rather than fragile float equality.

test-approx-accuracy: ( -- ) [
  "approximation accuracy" test-section
  10 pi-approx ratio>float math.pi - abs 0.000001 <
  "pi-approx is within 1e-6 of pi" assert-true
  10 e-approx ratio>float math.e - abs 0.000001 <
  "e-approx is within 1e-6 of e" assert-true
  10 sqrt2-approx ratio>float dup * 2.0 - abs 0.000001 <
  "sqrt2-approx squared is within 1e-6 of 2" assert-true
  10 sqrt5-approx ratio>float dup * 5.0 - abs 0.000001 <
  "sqrt5-approx squared is within 1e-6 of 5" assert-true
  10 phi-approx ratio>float 1.618033988749895 - abs 0.000001 <
  "phi-approx is within 1e-6 of the golden ratio" assert-true
  10 ln2-approx ratio>float 0.6931471805599453 - abs 0.000001 <
  "ln2-approx is within 1e-6 of ln 2" assert-true
  10 ln10-approx ratio>float 2.302585092994046 - abs 0.000001 <
  "ln10-approx is within 1e-6 of ln 10" assert-true
] ;

\ --- Golden-ratio identity: phi^2 - phi = 1 ---

test-phi-identity: ( -- ) [
  "golden ratio identity" test-section
  10 phi-approx dup dup * swap - ratio>float 1.0 - abs 0.0001 <
  "phi^2 - phi is within 1e-4 of 1" assert-true
] ;
