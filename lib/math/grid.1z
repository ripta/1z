\ lib/grid.1z - Grid data structure and printing

use "ranges" ;
use "strings" ;
use "sequences" ;

\\ A width-by-height grid of cells for text output. `marks` is a set of `{ x y }` pairs, and each
\\ marked cell prints as `mark-char` while every other cell prints as `empty-char`.
grid: struct{ width height marks mark-char empty-char } ;

\\ A grid that prints marked cells as "X" and empty cells as ".".
\\
\\   3 2 S{ { 0 0 } { 2 1 } } new-grid grid>string
\\   => "X..\n..X"
new-grid: ( width height marks -- grid ) [
  "X" "." make-grid
] ;

\\ A copy of the grid with new mark and empty characters.
\\
\\   3 2 S{ { 0 0 } { 2 1 } } new-grid "#" " " with-chars grid>string
\\   => "#  \n  #"
with-chars: ( grid: grid mark-char: string empty-char: string -- grid ) [
  ec: swap ;
  mc: swap ;
  g:  swap ;
  g width>> g height>> g marks>> mc ec make-grid
] ;

\\ True when `{ x y }` is in the grid's marks.
\\
\\   3 2 S{ { 0 0 } { 2 1 } } new-grid 2 1 marked?
\\   => t
marked?: ( grid x y -- ? ) [
  swap { } swap #suffix swap #suffix
  swap marks>> swap @in?
] ;

\\ Row y as a string of one character per column, with no trailing newline.
\\
\\   3 2 S{ { 0 0 } { 2 1 } } new-grid 1 row>string
\\   => "..X"
row>string: ( grid: grid y: fixnum -- str ) [
  row-y: swap ;
  row-g: swap ;
  row-g width>> iota >iterator
  [
    col-x: swap ;
    row-g col-x row-y marked?
    [ row-g mark-char>> ] [ row-g empty-char>> ] if
  ] #map #collect
  "" #join
] ;

\\ Every row from y = 0 down, joined by newlines, with no trailing newline.
grid>string: ( grid -- str ) [
  dup g: swap ;
  height>> iota >iterator
  [ g swap row>string ] #map #collect
  "\n" #join
] ;

\\ Print the grid as `grid>string` renders it, followed by a newline.
print-grid: ( grid -- ) [
  grid>string print-line
] ;

pragma{ lint-suppress: { broad-import: dead-definition: import-ordering: missing-type-annotation: with-combinator-naming: } }
