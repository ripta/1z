\ lib/graph.1z - Persistent graph over a bst-map adjacency.
\
\ Adjacency is a persistent `bst-map` from a vertex to a `cons-list` of `graph-edge`
\ records, so an edge insert is O(log V) and building E edges is O(E log V). Vertices
\ are arbitrary values identified by the comparator the constructor takes. A vertex
\ with no edges is stored with an empty edge list, so isolated vertices exist. One
\ type serves both kinds: the `directed?` flag distinguishes a digraph, and the edge
\ words consult it rather than splitting the type.
\
\ Adding an edge that is already present appends a second one rather than replacing it.
\ Detecting the duplicate would cost a scan of the source's edge list on every insert,
\ including the inserts that add nothing, which makes building a high-degree vertex
\ quadratic. A caller that wants at most one edge per pair probes with `graph-has-edge?`
\ and pays that scan where it writes it.
\
\ The graph registers no sequence protocol method, `>iterator` included. Vertices and
\ edges are both first-class readings, so `#len` and a drained `#count` would have no
\ subject recoverable from the call site. Contents ship under explicit per-reading
\ names instead.

use { bst-map: <bst-map>: map-insert: map-lookup: map-delete: map-size: map-empty?: unmake-bst-map: tree-each: key>>: unmake-kv-pair: } "bst" ;
use { nil: cons: cons?: head: tail: list-len: } "cons-list" ;
use { <heap>: heap-insert: heap-pop-min?: } "heap" ;

\\ One edge. `source` and `target` are vertices, and `payload` is an arbitrary
\\ per-edge value; an unweighted edge stores `f`. Adjacency stores this record with
\\ `source` filled in, so every edge-yielding word returns the same type.
graph-edge: struct{ source target payload } ;

\\ A persistent graph over arbitrary vertices. `adjacency` maps a vertex to the
\\ cons-list of `graph-edge` records leaving it. `comparator` has effect
\\ `( a b -- ordering )`, as `cmp` does, and identifies vertices. `directed?` records
\\ which constructor built the graph. `edge-count` is the logical edge count, which
\\ every mutation maintains in O(1).
graph: struct{ adjacency: bst-map comparator: quotation directed?: boolean edge-count: fixnum } ;

\\ An empty undirected graph over vertices ordered by the comparator.
\\
\\   [ cmp ] <graph> graph-directed?
\\   => f
<graph>: ( comparator: quotation -- graph ) [ dup <bst-map> swap f 0 make-graph ] ;

\\ An empty directed graph over vertices ordered by the comparator.
\\
\\   [ cmp ] <digraph> graph-directed?
\\   => t
<digraph>: ( comparator: quotation -- graph ) [ dup <bst-map> swap t 0 make-graph ] ;

\\ Whether the graph is directed.
\\
\\   [ cmp ] <digraph> graph-directed?
\\   => t
graph-directed?: ( g: graph -- ? ) [ directed?>> ] ;

private{
  \ Every adjacency walk below is a loop. The recursive cons-list words keep one native
  \ frame per element, and a vertex's edge list runs as long as its degree, which a star
  \ takes to O(V).

  \ Reverse a list, O(n).
  list-reverse-loop: ( list -- list' ) [
    nil swap
    [ dup cons? ] [ dup head swap tail [ swap cons ] dip ] while
    drop
  ] ;

  \ Append every entry of the list to the vector, head first.
  entries>vector: ( vec: vector list -- vec ) [
    [ dup cons? ] [ dup head swap tail [ #push! ] dip ] while
    drop
  ] ;

  \ The first entry whose target is comparator-equal to the argument. The list head is
  \ the most recently added entry, so this is the newest of a set of parallel edges.
  find-entry?: ( comparator: quotation target list -- option ) [
    option:none swap
    [ dup cons? ] [
      dup head dup target>>
      4 pick-n 6 pick-n call ordering:eq?
      [ >option:some [ 2drop ] dip nil ]
      [ drop tail ]
      if
    ] while
    drop nip nip
  ] ;

  \ Drop every entry whose target is comparator-equal to the argument, reporting how
  \ many went. The kept entries come back in their original relative order: the filter
  \ pass reverses, and the second pass puts them back.
  drop-entries: ( comparator: quotation target list -- list' removed ) [
    0 swap nil swap
    [ dup cons? ] [
      dup head dup target>>
      5 pick-n 7 pick-n call ordering:eq?
      [ drop tail [ [ 1 + ] dip ] dip ]
      [ swap tail [ swap cons ] dip ]
      if
    ] while
    drop list-reverse-loop swap [ 2drop ] 2dip
  ] ;

  throw-unknown-vertex: never-returns ( -- * ) [
    f "graph has no such vertex" EKeyNotFound make-error throw
  ] ;

  throw-no-such-edge: never-returns ( -- * ) [
    f "graph has no such edge" EKeyNotFound make-error throw
  ] ;

  \ Rebuild the graph around a new adjacency map and edge count, keeping the comparator
  \ and the flag. Every persistent update routes its rewrap through here.
  rebuild: ( adj: bst-map count: fixnum g: graph -- g' ) [
    unmake-graph drop [ drop ] 2dip <rot- make-graph
  ] ;

  \ Rewrap around a new adjacency, leaving the edge count alone.
  with-adjacency: ( g: graph adj: bst-map -- g' ) [
    over edge-count>> 2 pick-n rebuild nip
  ] ;

  increment-edge-count: ( g: graph -- g' ) [
    dup adjacency>> over edge-count>> 1 + 2 pick-n rebuild nip
  ] ;

  decrement-edge-count: ( g: graph n: fixnum -- g' ) [
    over adjacency>>
    2 pick-n edge-count>> 2 pick-n -
    3 pick-n rebuild
    nip nip
  ] ;

  \ The edge list stored under v, or `option:none` for an unknown vertex. O(log V).
  vertex-edges?: ( g: graph v -- option ) [ [ adjacency>> ] dip map-lookup ] ;

  \ Store v with an empty edge list when absent. A known vertex is left as it is,
  \ edges included. O(log V).
  ensure-vertex: ( g: graph v -- g' ) [
    2dup vertex-edges? option:some?
    [ drop ]
    [ over adjacency>> swap nil map-insert with-adjacency ]
    if
  ] ;

  \ Cons one adjacency entry for source -> target onto source's list, creating source
  \ when it is absent. One lookup and one insert, O(log V). The target is left to the
  \ caller, which either mirrors the entry or ensures the vertex.
  add-entry: ( g: graph source target payload -- g' ) [
    2 pick-n 2 pick-n 2 pick-n make-graph-edge
    [ 2drop ] dip
    2 pick-n 2 pick-n vertex-edges?
    dup option:some? [ option:some> ] [ drop nil ] if
    cons
    2 pick-n adjacency>> -rot>
    map-insert with-adjacency
  ] ;

  \ Drop every entry from u's list that targets v, reporting how many went. An unknown u
  \ removes nothing. O(log V + deg u).
  drop-edges-to: ( g: graph u v -- g' removed ) [
    2 pick-n 2 pick-n vertex-edges?
    dup option:some? [
      option:some>
      3 pick-n comparator>> 2 pick-n 2 pick-n drop-entries
      [ nip nip ] dip
      [ 2 pick-n adjacency>> -rot> map-insert with-adjacency ] dip
    ] [
      drop 2drop 0
    ] if
  ] ;

  \ The two sweeps below account for their own removals, so they discard the count.
  strip-back-edge: ( g: graph u v -- g' ) [ drop-edges-to drop ] ;

  \ Every adjacency entry as a kv-pair, ascending under the comparator. O(V).
  \
  \ Not map>array: that builds its result with the array #push, which allocates and copies
  \ the whole array on every call, so it costs O(V^2). The in-order walk into a mutable
  \ vector is what makes this and its three callers meet the bounds they document.
  map-entries: ( m: bst-map -- vector ) [
    [ ] make-vector dup [ swap #push! drop ] curry
    <rot- unmake-bst-map swap tree-each
  ] ;

  \ Every vertex, ascending under the comparator. O(V).
  vertex-array: ( g: graph -- array ) [ adjacency>> map-entries [ key>> ] #map #collect ] ;

  \ Every stored adjacency entry. An undirected edge appears twice, once per endpoint.
  \ O(V + E).
  all-entries: ( g: graph -- array ) [
    adjacency>> map-entries
    [ ] make-vector swap
    [ unmake-kv-pair nip entries>vector ] #each
    >array
  ] ;

  \ Whether the entry has v at either end.
  edge-touches?: ( edge: graph-edge comparator: quotation v -- ? ) [
    2 pick-n source>> over 3 pick-n call ordering:eq?
    3 pick-n target>> 2 pick-n 4 pick-n call ordering:eq?
    or
    nip nip nip
  ] ;

  \ How many stored entries have v at either end, O(V + E). On a digraph that is the
  \ number of logical edges v is part of, since each is stored once.
  count-incident: ( g: graph v -- n ) [
    over comparator>> over [ edge-touches? ] curry curry
    2 pick-n all-entries swap #filter #count
    nip nip
  ] ;

  \ Strip v out of the lists of the vertices named by its own edge list. Sound only when
  \ the graph is undirected, where every edge is stored at both endpoints.
  strip-neighbors: ( g: graph v vlist -- g' ) [
    [ ] make-vector swap entries>vector [ target>> ] #map #collect
    over [ strip-back-edge ] curry
    [ drop ] 2dip
    #each
  ] ;

  \ Strip v out of every list. A digraph's in-edges are not locatable from v, so the
  \ whole map is swept: O(V log V + E).
  strip-all: ( g: graph v -- g' ) [
    over vertex-array
    over [ strip-back-edge ] curry
    [ drop ] 2dip
    #each
  ] ;

  \ Delete v's own entry and subtract the edges the removal took with it.
  finish-remove-vertex: ( g: graph v n: fixnum -- g' ) [
    2 pick-n adjacency>> 2 pick-n map-delete
    3 pick-n edge-count>> 2 pick-n -
    4 pick-n rebuild
    nip nip nip
  ] ;

  \ Remove a vertex that is known to be present, along with every edge touching it. The
  \ decrement differs by kind: an undirected edge appears once in v's own list, where a
  \ digraph's in-edges appear in lists v does not name.
  remove-known-vertex: ( g: graph v vlist -- g' ) [
    2 pick-n directed?>> [
      2 pick-n 2 pick-n count-incident
      [ drop dup [ strip-all ] dip ] dip
    ] [
      dup list-len
      [ over [ strip-neighbors ] dip ] dip
    ] if
    finish-remove-vertex
  ] ;
}

\\ Add v with no edges. A vertex that is already present is left as it is, edges
\\ included. O(log V).
\\
\\   [ cmp ] <graph> 1 graph-add-vertex graph-vertex-count
\\   => 1
graph-add-vertex: ( g: graph v -- g' ) [ ensure-vertex ] ;

\\ Remove v and every edge touching it. An unknown vertex is left alone. Undirected
\\ edges are stored at both endpoints, so only v's neighbors are touched, at
\\ O(deg log V); a digraph's in-edges are not locatable from v, so every list is
\\ swept, at O(V log V + E).
\\
\\   [ cmp ] <graph> 1 2 graph-add-edge 1 graph-remove-vertex graph-edge-count
\\   => 0
graph-remove-vertex: ( g: graph v -- g' ) [
  2dup vertex-edges?
  dup option:some?
  [ option:some> remove-known-vertex ]
  [ 2drop ]
  if
] ;

\\ Add an edge from u to v carrying the payload, adding either endpoint that is absent.
\\ O(log V). An undirected graph stores the edge at both endpoints, except a self-loop,
\\ which is stored once. A pair that already has an edge gains a second one.
\\
\\   [ cmp ] <graph> 1 2 weight: graph-add-edge-with-payload 1 2 graph-edge-get payload>>
\\   => weight:
graph-add-edge-with-payload: ( g: graph u v payload -- g' ) [
  3 pick-n 3 pick-n 3 pick-n 3 pick-n add-entry
  dup directed?>> [
    2 pick-n ensure-vertex
  ] [
    3 pick-n 3 pick-n 2 pick-n comparator>> call ordering:eq? not
    [ 2 pick-n 4 pick-n 3 pick-n add-entry ] when
  ] if
  increment-edge-count
  [ 2drop 2drop ] dip
] ;

\\ Add an unweighted edge from u to v, storing `f` as the payload. O(log V).
\\
\\   [ cmp ] <graph> 1 2 graph-add-edge 1 2 graph-has-edge?
\\   => t
graph-add-edge: ( g: graph u v -- g' ) [ f graph-add-edge-with-payload ] ;

\\ Remove every edge from u to v, and on an undirected graph the entries stored at v as
\\ well. A pair with no edge is left alone. O(log V + deg u + deg v).
\\
\\   [ cmp ] <graph> 1 2 graph-add-edge 1 2 graph-remove-edge 1 2 graph-has-edge?
\\   => f
graph-remove-edge: ( g: graph u v -- g' ) [
  2 pick-n directed?>> [
    drop-edges-to
  ] [
    \ Strip u's list, then v's with the endpoints swapped. The count from the first
    \ strip is rotated over the second call's operands, since both take the same edges.
    2dup [ drop-edges-to ] 2dip
    swap <rot-
    [ drop-edges-to drop ] dip
  ] if
  decrement-edge-count
] ;

private{
  \ Materialize an edge list, head first, so the newest entry leads.
  entries>array: ( list -- array ) [ [ ] make-vector swap entries>vector >array ] ;

  \ Whether an undirected edge should be emitted from this end: the one whose source
  \ sorts at or before its target, so each logical edge is reported once.
  edge-forward?: ( edge: graph-edge comparator: quotation -- ? ) [
    swap dup source>> swap target>> 2 pick-n call ordering:gt? not nip
  ] ;
}

\\ Whether v is a vertex of the graph. O(log V).
\\
\\   [ cmp ] <graph> 1 graph-add-vertex 1 graph-has-vertex?
\\   => t
graph-has-vertex?: ( g: graph v -- ? ) [ vertex-edges? option:some? ] ;

\\ The newest edge from u to v as an option, `option:none` when u is not a vertex or
\\ carries no such edge. O(log V + deg u).
\\
\\   [ cmp ] <graph> 1 2 graph-edge-get? option:none?
\\   => t
graph-edge-get?: ( g: graph u v -- option ) [
  2 pick-n 2 pick-n vertex-edges?
  dup option:some? [
    option:some>
    3 pick-n comparator>> 2 pick-n 2 pick-n find-entry?
    [ 2drop 2drop ] dip
  ] [
    2drop 2drop option:none
  ] if
] ;

\\ The newest edge from u to v. O(log V + deg u). Throws `key-not-found` when u is not
\\ a vertex or carries no such edge.
\\
\\   [ cmp ] <graph> 1 2 graph-add-edge 1 2 graph-edge-get target>>
\\   => 2
graph-edge-get: ( g: graph u v -- edge: graph-edge ) [
  graph-edge-get? dup option:some? [ option:some> ] [ drop throw-no-such-edge ] if
] ;

\\ Whether an edge runs from u to v. An unknown u answers `f` rather than throwing.
\\ O(log V + deg u).
\\
\\   [ cmp ] <digraph> 1 2 graph-add-edge 2 1 graph-has-edge?
\\   => f
graph-has-edge?: ( g: graph u v -- ? ) [ graph-edge-get? option:some? ] ;

\\ The edges leaving v as an option, `option:none` for an unknown vertex. The newest
\\ entry leads. O(log V + deg v).
\\
\\   [ cmp ] <graph> 1 graph-neighbors? option:none?
\\   => t
graph-neighbors?: ( g: graph v -- option ) [ vertex-edges? [ entries>array ] ?map ] ;

\\ The edges leaving v, newest first. O(log V + deg v). Throws `key-not-found` for a
\\ vertex the graph does not have.
\\
\\   [ cmp ] <graph> 1 2 graph-add-edge 1 graph-neighbors #len
\\   => 1
graph-neighbors: ( g: graph v -- array ) [
  graph-neighbors? dup option:some? [ option:some> ] [ drop throw-unknown-vertex ] if
] ;

\\ Every vertex, ascending under the comparator. O(V).
\\
\\   [ cmp ] <graph> 2 graph-add-vertex 1 graph-add-vertex graph-vertices
\\   => { 1 2 }
graph-vertices: ( g: graph -- array ) [ vertex-array ] ;

\\ Every edge, one record per logical edge. On an undirected graph each edge is stored
\\ at both endpoints, so only the end whose source sorts at or before its target is
\\ emitted. O(V + E).
\\
\\   [ cmp ] <graph> 1 2 graph-add-edge graph-edges #len
\\   => 1
graph-edges: ( g: graph -- array ) [
  dup all-entries swap
  dup directed?>>
  [ drop ]
  [ comparator>> [ edge-forward? ] curry #filter #collect ]
  if
] ;

\\ How many vertices the graph has, O(1).
\\
\\   [ cmp ] <graph> 1 2 graph-add-edge graph-vertex-count
\\   => 2
graph-vertex-count: ( g: graph -- n ) [ adjacency>> map-size ] ;

\\ How many edges the graph has, O(1). An undirected edge counts once even though it is
\\ stored at both endpoints, and a repeated add counts again.
\\
\\   [ cmp ] <graph> 1 2 graph-add-edge 1 2 graph-add-edge graph-edge-count
\\   => 2
graph-edge-count: ( g: graph -- n ) [ edge-count>> ] ;

\\ Whether the graph has no vertices, O(1).
\\
\\   [ cmp ] <graph> graph-empty?
\\   => t
graph-empty?: ( g: graph -- ? ) [ adjacency>> map-empty? ] ;

\ The dense projection every algorithm runs on. Reading adjacency through the persistent
\ map would turn each visited mark and distance write into a map probe, which costs
\ breadth-first search a log factor and Dijkstra two. Projecting once per call moves that
\ cost out of the inner loop: the algorithm reads vector slots at O(1), and translates its
\ results back to vertex values on the way out.
\
\ The two struct declarations sit in their own block. A private{ } body is parsed whole
\ before it runs, so a parse-time type reference resolves only names an earlier top-level
\ statement installed.

private{
  \\ One dense adjacency entry: the target's dense index, and the stored record the entry
  \\ came from. The index is what an unweighted algorithm reads. The record is where a
  \\ weighted one reads its payload, so a weight projection costs no second map lookup.
  dense-edge: struct{ target: fixnum edge: graph-edge } ;

  \\ A graph in dense form. `vertices` translates an index back to its vertex and
  \\ `indices` translates the other way, both over `[0, V)`. `adjacency` holds each
  \\ vertex's dense entries at that vertex's own index.
  dense-graph: struct{ vertices: vector indices: bst-map adjacency: vector } ;

  \\ A traversal in progress, in dense indices where `graph-traversal` holds vertices.
  \\ `visits` is the visit order, `depths` holds each vertex's distance and `origins` its
  \\ parent, both at the vertex's own index.
  \\
  \\ An `f` in `depths` is the unvisited mark, and an `f` in `origins` means the vertex
  \\ started the walk. Only `f` is falsy, so depth 0 and index 0 both read as set.
  dense-walk: struct{ visits: vector depths: vector origins: vector } ;
}

private{
  \ Drain a sequence into a fresh vector.
  seq>vector: ( seq -- vector ) [
    [ ] make-vector dup [ swap #push! drop ] curry <rot- swap #each
  ] ;

  \ Pass one: number the vertices in entry order, which is ascending under the comparator.
  \ Both translations fall out of the same walk. O(V log V), the map inserts.
  index-vertices: ( comparator: quotation entries: vector -- vertices indices ) [
    [ key>> ] #map seq>vector
    swap <bst-map>
    0 swap
    [ 1 pick-n 3 pick-n #len < ]
    [ 2 pick-n 2 pick-n #nth 2 pick-n map-insert swap 1 + swap ]
    while
    swap drop
  ] ;

  \ One vertex's edge list as dense records, head first, so the newest entry leads as
  \ graph-neighbors does. O(deg log V), one index lookup per entry.
  \
  \ The lookup cannot miss: both endpoints of an edge are stored as vertices when it is
  \ added, and removing a vertex strips the entries that name it.
  entries>dense: ( indices: bst-map list -- vector ) [
    [ ] make-vector swap
    [ dup cons? ] [
      dup head
      dup target>> 4 pick-n swap map-lookup option:some>
      swap make-dense-edge
      2 pick-n swap #push! drop
      tail
    ] while
    drop nip
  ] ;

  \ Pass two: each vertex's entries, at that vertex's own index. It cannot share pass one's
  \ walk, since an edge leaving the first vertex may target the last and the map has to be
  \ complete before any target is translated. O(E log V).
  dense-adjacency: ( indices: bst-map entries: vector -- adjacency ) [
    0 [ ] make-vector
    [ 1 pick-n 3 pick-n #len < ]
    [
      2 pick-n 2 pick-n #nth unmake-kv-pair nip
      4 pick-n swap entries>dense
      #push!
      swap 1 + swap
    ]
    while
    swap drop nip nip
  ] ;

  \ Project the graph to dense form, O((V + E) log V): one walk of the vertices to build
  \ the numbering, and one of the stored entries to translate their targets against it.
  \ Both terms carry the map's log factor, the first from its inserts and the second from
  \ its lookups.
  \
  \ The result is a snapshot. Every algorithm builds its own, so a graph run from many
  \ sources pays one projection per run.
  project: ( g: graph -- dense-graph ) [
    dup comparator>> swap adjacency>> map-entries
    dup [ index-vertices ] dip
    over swap dense-adjacency
    make-dense-graph
  ] ;

  \ The dense index of a vertex an algorithm was handed. Throws `key-not-found` for a
  \ vertex the graph does not have, as the public lookups do.
  dense-index: ( dg: dense-graph v -- i ) [
    [ indices>> ] dip map-lookup
    dup option:some? [ option:some> ] [ drop throw-unknown-vertex ] if
  ] ;

  \ The vertex at a dense index. The index comes first so a curried form feeds #map, which
  \ is why this reads the other way round from dense-index.
  index-vertex: ( i: fixnum dg: dense-graph -- v ) [ vertices>> swap #nth ] ;

  \ A vector of n slots, each holding the fill value. Nothing preallocates a vector, so
  \ this is n pushes.
  filled-vector: ( n: fixnum fill -- vector ) [
    [ ] make-vector -rot>
    [ #push! ] curry
    times
  ] ;

  \ A vector of n slots, each holding a fresh empty vector of its own. Not filled-vector,
  \ which would put one shared vector in every slot.
  slot-vectors: ( n: fixnum -- vector ) [
    [ ] make-vector swap [ [ ] make-vector #push! ] times
  ] ;
}

\\ What one traversal pass produced. `order` is the vertices in visit order, `distances`
\\ maps a reached vertex to its distance from the source, and `parents` maps a reached
\\ vertex to the one it was reached from. All three come out of the same pass, so a caller
\\ wanting two of them pays for one traversal rather than two.
\\
\\ Only reached vertices appear. The source has distance 0 and no parent entry, since it
\\ was reached from nowhere.
graph-traversal: struct{ order: array distances: bst-map parents: bst-map } ;

\\ The distance from the traversal's source to v, or `option:none` when the traversal did
\\ not reach v. O(log V).
\\
\\   [ cmp ] <graph> 1 2 graph-add-edge 1 graph-breadth-first 2 graph-traversal-distance? option:some>
\\   => 1
graph-traversal-distance?: ( t: graph-traversal v -- option ) [ [ distances>> ] dip map-lookup ] ;

\\ The vertex v was reached from, or `option:none` when the traversal did not reach v or
\\ when v is the source it started from. `graph-traversal-distance?` is what tells those two
\\ apart. O(log V).
\\
\\   [ cmp ] <graph> 1 2 graph-add-edge 1 graph-breadth-first 2 graph-traversal-parent? option:some>
\\   => 1
graph-traversal-parent?: ( t: graph-traversal v -- option ) [ [ parents>> ] dip map-lookup ] ;

private{
  \ Fresh scratch for a walk over n vertices.
  <dense-walk>: ( n: fixnum -- dense-walk ) [
    [ ] make-vector swap
    dup f filled-vector
    swap f filled-vector
    make-dense-walk
  ] ;

  \ Record v as reached from origin at the given depth, and append it to the visit order.
  \ The depth is untyped because it is an edge count for the traversals and a weight the
  \ caller's projection produced for the shortest-path walk.
  mark-visit: ( walk: dense-walk v: fixnum origin depth -- ) [
    3 pick-n depths>> 3 pick-n 2 pick-n #nth! drop
    3 pick-n origins>> 3 pick-n 3 pick-n #nth! drop
    2drop
    over visits>> swap #push! 2drop
  ] ;

  \ The visit order as vertex values. O(V).
  visit-order: ( dg: dense-graph walk: dense-walk -- array ) [
    visits>> swap [ index-vertex ] curry #map #collect
  ] ;

  \ Map every visited vertex to its depth. O(V log V).
  depth-map: ( g: graph dg: dense-graph walk: dense-walk -- map: bst-map ) [
    0 3 pick-n comparator>> <bst-map>
    [ over 3 pick-n visits>> #len < ]
    [
      2 pick-n visits>> 2 pick-n #nth
      dup 5 pick-n index-vertex
      4 pick-n depths>> 2 pick-n #nth
      [ drop ] 2dip
      map-insert
      [ 1 + ] dip
    ]
    while
    [ 2drop 2drop ] dip
  ] ;

  \ Map every visited vertex to the vertex it was reached from. A slot holding f means the
  \ vertex started the walk, so it gets no entry. O(V log V).
  origin-map: ( g: graph dg: dense-graph walk: dense-walk -- map: bst-map ) [
    0 3 pick-n comparator>> <bst-map>
    [ over 3 pick-n visits>> #len < ]
    [
      2 pick-n visits>> 2 pick-n #nth
      3 pick-n origins>> over #nth
      dup not
      [ 2drop ]
      [
        5 pick-n index-vertex
        [ dup 5 pick-n index-vertex ] dip
        [ drop ] 2dip
        map-insert
      ]
      if
      [ 1 + ] dip
    ]
    while
    [ 2drop 2drop ] dip
  ] ;

  \ Translate a finished walk to vertex values.
  walk>traversal: ( g: graph dg: dense-graph walk: dense-walk -- traversal: graph-traversal ) [
    3dup depth-map
    [ 3dup origin-map ] dip
    [ [ drop ] 2dip visit-order ] 2dip
    swap make-graph-traversal
  ] ;

  \ Reach one dense entry's target during breadth-first search: an unmarked target is
  \ recorded at one more than the current vertex's depth and appended to the frontier. The
  \ entry comes first so a curried form feeds #each.
  bfs-reach: ( e: dense-edge walk: dense-walk u: fixnum -- ) [
    [ target>> ] 2dip <rot-
    2 pick-n depths>> over #nth not
    [
      2 pick-n depths>> 2 pick-n #nth 1 +
      [ swap ] dip
      mark-visit
    ]
    [ 3drop ]
    if
  ] ;

  \ Breadth-first from s. The visit order doubles as the frontier: a cursor walks it while
  \ newly-marked vertices are appended to its tail, so nothing ever shifts. Marking on push
  \ is what enqueues each vertex exactly once. O(V + E).
  bfs-walk: ( dg: dense-graph s: fixnum -- walk: dense-walk ) [
    over vertices>> #len <dense-walk>
    -rot>
    2 pick-n swap f 0 mark-visit
    0
    [ dup 3 pick-n visits>> #len < ]
    [
      2 pick-n visits>> over #nth
      2 pick-n adjacency>> over #nth
      4 pick-n 2 pick-n [ bfs-reach ] curry curry
      #each
      drop 1 +
    ]
    while
    2drop
  ] ;

  \ Push v's unmarked neighbors onto the pending stacks, back to front, so the newest entry
  \ ends up on top and is popped first. That is what makes the visit order follow
  \ graph-neighbors rather than reverse it.
  dfs-push-neighbors: ( walk: dense-walk pending: vector pending-origins: vector v: fixnum adj: vector -- ) [
    dup #len 1 -
    [ dup 0 >= ]
    [
      2dup #nth target>>
      6 pick-n depths>> over #nth not
      [
        5 pick-n over #push! drop
        4 pick-n 4 pick-n #push! drop
      ]
      when
      drop 1 -
    ]
    while
    2drop 2drop 2drop
  ] ;

  \ Depth-first from s over two pending stacks holding a vertex and the vertex it was
  \ reached from. Marking happens on pop, so a vertex may sit on the stack more than once
  \ and the first pop wins, which is what makes the recorded parent the depth-first tree's
  \ parent rather than whichever push landed last. O(V + E).
  dfs-walk: ( dg: dense-graph s: fixnum -- walk: dense-walk ) [
    over vertices>> #len <dense-walk>
    swap
    [ ] make-vector swap #push!
    [ ] make-vector f #push!
    [ over #len 0 > ]
    [
      [ #pop! ] dip #pop! [ swap ] dip
      4 pick-n depths>> 2 pick-n #nth
      [ 2drop ]
      [
        [ dup ] dip
        dup dup not [ drop 0 ] [ 6 pick-n depths>> swap #nth 1 + ] if
        6 pick-n 3 rot-n> mark-visit
        4 pick-n adjacency>> over #nth
        4 pick-n 4 pick-n 4 pick-n 4 pick-n 4 pick-n dfs-push-neighbors
        2drop
      ]
      if
    ]
    while
    2drop nip
  ] ;
}

\\ Breadth-first search from the source, reaching every vertex a path leads to. `distances`
\\ is the number of edges on a shortest path from the source, since a breadth-first frontier
\\ reaches every vertex at its shortest depth. O((V + E) log V), the projection's cost, with
\\ the search itself O(V + E). Throws `key-not-found` when the source is not a vertex.
\\
\\   [ cmp ] <graph> 1 2 graph-add-edge 2 3 graph-add-edge 1 graph-breadth-first order>>
\\   => { 1 2 3 }
graph-breadth-first: ( g: graph source -- traversal: graph-traversal ) [
  over project
  tuck swap dense-index
  over swap bfs-walk
  walk>traversal
] ;

\\ Alias of `graph-breadth-first`.
graph-bfs: ( g: graph source -- traversal: graph-traversal ) [ graph-breadth-first ] ;

\\ Depth-first search from the source, reaching every vertex a path leads to. Neighbors are
\\ followed in `graph-neighbors` order. `distances` is depth in the depth-first tree, which
\\ is not a shortest-path distance: a vertex reached down a long branch records that
\\ branch's depth. O((V + E) log V), the projection's cost, with the search itself O(V + E).
\\ Throws `key-not-found` when the source is not a vertex.
\\
\\   [ cmp ] <graph> 1 2 graph-add-edge 2 3 graph-add-edge 1 graph-depth-first order>>
\\   => { 1 2 3 }
graph-depth-first: ( g: graph source -- traversal: graph-traversal ) [
  over project
  tuck swap dense-index
  over swap dfs-walk
  walk>traversal
] ;

\\ Alias of `graph-depth-first`.
graph-dfs: ( g: graph source -- traversal: graph-traversal ) [ graph-depth-first ] ;

\\ Error type thrown when a digraph has a cycle, so it has no topological order.
ECyclicGraph: ( -- sym ) [ cyclic-graph: ] ;

private{
  throw-undirected-sort: never-returns ( -- * ) [
    f "topological sort requires a digraph" EInvalidArgument make-error throw
  ] ;

  throw-cyclic-graph: never-returns ( -- * ) [
    f "graph has a cycle, so it has no topological order" ECyclicGraph make-error throw
  ] ;

  \ Add one to the target's incoming count. The entry comes first so a curried form feeds
  \ #each.
  tally-target: ( e: dense-edge degrees: vector -- ) [
    over target>> 2dup #nth 1 + #nth! 2drop
  ] ;

  \ How many incoming edges each vertex has. O(V + E).
  in-degrees: ( dg: dense-graph -- degrees: vector ) [
    dup vertices>> #len 0 filled-vector
    tuck [ tally-target ] curry [ #each ] curry
    swap adjacency>> swap #each
  ] ;

  \ Take one incoming edge off the target, and release it once its last one is gone. The
  \ entry comes first so a curried form feeds #each.
  kahn-release: ( e: dense-edge degrees: vector queue: vector -- ) [
    2 pick-n target>>
    2 pick-n over #nth 1 -
    3 pick-n 2 pick-n 2 pick-n #nth! drop
    0 = [ 2dup #push! drop ] when
    2drop 2drop
  ] ;

  \ Kahn's algorithm on the dense form: seed the queue with every vertex that has no
  \ incoming edge, then release a target as its last one is removed. The queue doubles as
  \ the emitted order and is walked by a cursor, so nothing ever shifts. A queue shorter
  \ than the vertex count means the rest sit on a cycle. O(V + E).
  kahn-order: ( dg: dense-graph -- queue: vector ) [
    dup in-degrees
    [ ] make-vector
    0
    [ dup 3 pick-n #len < ]
    [
      2 pick-n over #nth 0 = [ 2dup #push! drop ] when
      1 +
    ]
    while
    drop
    0
    [ dup 2 pick-n #len < ]
    [
      2dup #nth
      4 pick-n adjacency>> over #nth
      4 pick-n 4 pick-n [ kahn-release ] curry curry
      #each
      drop 1 +
    ]
    while
    drop nip nip
  ] ;
}

\\ The vertices in an order that puts every edge's source before its target.
\\ O((V + E) log V), the projection's cost, with the sort itself O(V + E).
\\
\\ The order is deterministic for a given graph but is not the lexicographically smallest
\\ topological order. The vertices with no incoming edge lead, ascending under the
\\ comparator, and each later vertex joins as its last incoming edge is removed, which
\\ follows stored edge order.
\\
\\ Throws `cyclic-graph` when the digraph has a cycle. Throws `invalid-argument` on an
\\ undirected graph, which has no topological order at all: every undirected edge is stored
\\ at both endpoints, so any edge is a two-cycle.
\\
\\   [ cmp ] <digraph> 1 2 graph-add-edge 2 3 graph-add-edge graph-topological-sort
\\   => { 1 2 3 }
graph-topological-sort: ( g: graph -- array ) [
  dup graph-directed? not [ throw-undirected-sort ] when
  project dup kahn-order
  dup #len 2 pick-n vertices>> #len < [ throw-cyclic-graph ] when
  swap [ index-vertex ] curry #map #collect
] ;

private{
  \ Record one direction-free adjacency. Every stored entry contributes its target to its
  \ source's list, and on a digraph its source to its target's list as well. The entry comes
  \ first so a curried form feeds #each.
  link-neighbor: ( e: dense-edge neighbors: vector directed?: boolean u: fixnum -- ) [
    3 pick-n target>>
    3 pick-n 2 pick-n #nth over #push! drop
    2 pick-n [ 3 pick-n over #nth 2 pick-n #push! drop ] when
    3drop 2drop
  ] ;

  \ A neighbor view that ignores direction. An undirected graph already stores both ends of
  \ every edge, so the mirror pass runs only for a digraph and one walk covers both kinds.
  \ O(V + E).
  undirected-neighbors: ( dg: dense-graph directed?: boolean -- neighbors: vector ) [
    over vertices>> #len slot-vectors
    0
    [ dup 2 pick-n #len < ]
    [
      3 pick-n adjacency>> over #nth
      2 pick-n 4 pick-n 3 pick-n [ link-neighbor ] curry curry curry
      #each
      1 +
    ]
    while
    drop nip nip
  ] ;

  \ Push an unlabelled neighbor onto the pending stack. The neighbor comes first so a
  \ curried form feeds #each.
  flood-push: ( w: fixnum labels: vector pending: vector -- ) [
    over 3 pick-n #nth not [ dup 3 pick-n #push! drop ] when
    3drop
  ] ;

  \ Label everything reachable from start, by a depth-first walk over the direction-free
  \ neighbor view. Amortized O(1) per vertex and edge reached.
  flood-component: ( neighbors: vector labels: vector label: fixnum start: fixnum -- ) [
    [ ] make-vector swap #push!
    [ dup #len 0 > ]
    [
      #pop!
      3 pick-n over #nth not
      [
        3 pick-n over 4 pick-n #nth! drop
        4 pick-n over #nth
        4 pick-n 3 pick-n [ flood-push ] curry curry
        #each
      ]
      when
      drop
    ]
    while
    2drop 2drop
  ] ;

  \ Label each vertex with the component it lands in, sweeping depth-first from every vertex
  \ no earlier sweep reached. O(V + E).
  component-labels: ( neighbors: vector -- labels: vector count: fixnum ) [
    dup #len f filled-vector
    0
    0
    [ dup 3 pick-n #len < ]
    [
      2 pick-n over #nth not
      [ 3 pick-n 3 pick-n 3 pick-n 3 pick-n flood-component [ 1 + ] dip ]
      when
      1 +
    ]
    while
    drop
    [ drop ] 2dip
  ] ;

  \ Group the vertices by label in one index-order scan. Components come out ordered by
  \ smallest member with members ascending, since a dense index is ascending under the
  \ comparator. O(V).
  group-by-label: ( dg: dense-graph labels: vector count: fixnum -- array ) [
    slot-vectors
    0
    [ dup 3 pick-n #len < ]
    [
      2 pick-n over #nth
      2 pick-n swap #nth
      over 5 pick-n index-vertex
      #push! drop
      1 +
    ]
    while
    drop
    [ >array ] #map #collect
    [ 2drop ] dip
  ] ;
}

\\ The connected components, each an array of its vertices. Components come ordered by
\\ smallest member with members ascending, both under the graph's comparator. An isolated
\\ vertex is a component of its own. O((V + E) log V), the projection's cost, with the sweep
\\ itself O(V + E).
\\
\\ The components are those of the underlying undirected graph, which on a digraph makes
\\ them the weakly connected components rather than the strongly connected ones.
\\
\\   [ cmp ] <graph> 1 2 graph-add-edge 5 graph-add-vertex graph-connected-components
\\   => { { 1 2 } { 5 } }
graph-connected-components: ( g: graph -- array ) [
  dup graph-directed? swap project swap
  over swap undirected-neighbors
  component-labels
  group-by-label
] ;

\ Dijkstra runs on the same dense form the traversals do, with the heap standing in for the
\ breadth-first frontier. A frontier settles a vertex the first time it is reached. That is
\ a cheapest route only when every edge costs the same. The heap settles a vertex when it
\ comes off cheapest instead.
\
\ A stale route is dropped rather than corrected. The persistent heap has no node handles,
\ so heap-decrease-key is an O(n) scan, and its own doc comment names lazy deletion as the
\ alternative for this consumer. A cheaper route to a vertex is queued as a second entry.
\ Whichever entry loses is dropped when its vertex comes off already settled.

private{
  \\ One queued route: the distance a path through `origin` reaches `vertex` at. `origin` is
  \\ f for the source, which was reached from nowhere, as `dense-walk` records it.
  dijkstra-entry: struct{ distance: any vertex: fixnum origin: any } ;

  \\ The three things a relaxation reads and one run never changes. `queue` is a one-element
  \\ vector holding the heap, since a step fed to #each cannot hand a persistent value back.
  dijkstra-scratch: struct{ walk: dense-walk queue: vector weight: quotation } ;
}

private{
  throw-negative-weight: never-returns ( -- * ) [
    f "shortest paths require non-negative edge weights" EInvalidArgument make-error throw
  ] ;

  \ Take the boxed queue's cheapest entry, leaving the rest boxed. option:none once it is
  \ drained.
  queue-pop?: ( q: vector -- option ) [
    dup 0 #nth heap-pop-min?
    swap 2 pick-n 0 <rot- #nth! drop
    nip
  ] ;

  \ Add an entry to the boxed queue.
  queue-push: ( q: vector e -- ) [
    over 0 #nth swap heap-insert
    swap 0 <rot- #nth! drop
  ] ;

  \ One edge's weight under the caller's projection.
  edge-weight: ( e: dense-edge weight: quotation -- w ) [ [ edge>> ] dip call ] ;

  \ A weight for a shortest-path walk. This is the only place Dijkstra reads one, so the
  \ guard here sees every weight that walk examines, and only those.
  \
  \ Prim reads weights through the unguarded word instead. A minimum spanning tree is well
  \ defined for a negative weight, where a cheapest path is not.
  checked-weight: ( e: dense-edge weight: quotation -- w ) [
    edge-weight
    dup 0 cmp ordering:lt? [ throw-negative-weight ] when
  ] ;

  \ Offer one of u's edges as a route to its target, at the distance through u. A settled
  \ target cannot improve, so nothing is queued for it. A target that already has a better
  \ pending route is left to the check on pop. The entry comes first so a curried form feeds
  \ #each.
  dijkstra-relax: ( e: dense-edge st: dijkstra-scratch dist u: fixnum -- ) [
    3 pick-n target>>
    3 pick-n walk>> depths>> over #nth
    [ ]
    [
      4 pick-n 4 pick-n weight>> checked-weight
      3 pick-n +
      1 pick-n 3 pick-n make-dijkstra-entry
      4 pick-n queue>> swap queue-push
    ]
    if
    2drop 2drop drop
  ] ;

  \ Settle one queued route, or drop it when a cheaper one already settled its vertex.
  \ Settling records the distance and the origin, then offers every edge leaving the vertex.
  dijkstra-settle: ( dg: dense-graph st: dijkstra-scratch e: dijkstra-entry -- ) [
    dup vertex>>
    2 pick-n walk>> depths>> over #nth
    [ ]
    [
      2 pick-n walk>> 1 pick-n 3 pick-n origin>> 4 pick-n distance>> mark-visit
      3 pick-n adjacency>> over #nth
      3 pick-n 3 pick-n distance>> 3 pick-n [ dijkstra-relax ] curry curry curry
      #each
    ]
    if
    2drop 2drop
  ] ;

  \ Dijkstra from s, seeded with the source at distance zero. Each pop settles a vertex or
  \ is dropped as stale, and each settlement queues a route along every edge leaving it.
  \ O(E log V): one push per edge, and one pop for each.
  dijkstra-walk: ( dg: dense-graph s: fixnum weight: quotation -- walk: dense-walk ) [
    2 pick-n vertices>> #len <dense-walk>
    [ ] make-vector [ [ distance>> ] dip distance>> cmp ] <heap> #push!
    2 pick-n make-dijkstra-scratch
    dup queue>> 0 4 pick-n f make-dijkstra-entry queue-push
    [ 2drop ] dip
    [
      dup queue>> queue-pop?
      dup option:some?
      [ option:some> [ 1 pick-n 1 pick-n ] dip dijkstra-settle t ]
      [ drop f ]
      if
    ] loop
    nip walk>>
  ] ;
}

\\ Cheapest paths from the source, priced by the weight projection. `distances` is a
\\ cheapest path's total weight, where a breadth-first walk's is an edge count. `parents`
\\ names the vertex before this one on that path, so a route reads back by following
\\ `parents` from the far end. `order` is settle order, so it is non-decreasing in distance.
\\ Among equal distances it follows the queue rather than the comparator. Only reached
\\ vertices appear, as in the traversals.
\\
\\ The projection has effect `( edge: graph-edge -- weight )`. It is an argument rather than
\\ a field on the graph, so one graph runs as distance and then as time with no second
\\ graph. Weights are compared with `cmp` and added with `+`, and the source starts at 0. A
\\ digraph is followed along its out-edges.
\\
\\ O((V + E) log V), the projection's cost, with the search itself O(E log V). Throws
\\ `key-not-found` when the source is not a vertex. Throws `invalid-argument` on a negative
\\ weight; only the edges the walk examines are priced, so only those can raise.
\\
\\   [ cmp ] <graph> 1 2 1 graph-add-edge-with-payload 2 3 1 graph-add-edge-with-payload
\\   1 3 10 graph-add-edge-with-payload 1 [ payload>> ] graph-dijkstra
\\   3 graph-traversal-distance? option:some>
\\   => 2
graph-dijkstra: ( g: graph source weight: quotation -- traversal: graph-traversal ) [
  [ over project tuck swap dense-index ] dip
  [ over swap ] dip
  dijkstra-walk
  walk>traversal
] ;

\ Prim runs on the same dense form Dijkstra does, over the same heap and the same lazy
\ deletion, but it queues a different key. Dijkstra queues a vertex at its total distance
\ from the source, so it settles cheapest-route-first. Prim queues a vertex at the weight of
\ the one edge that would join it to the tree built so far, so it settles cheapest-edge-first.
\ That one difference is all that separates the two.
\
\ The tree grows one component at a time. A vertex no earlier growth reached starts the next
\ one, so a disconnected graph comes out as a spanning forest.

private{
  \\ One queued candidate: the weight of the edge that would bring `target` into the tree,
  \\ and the stored record that edge came from, which is what the result is built out of.
  prim-entry: struct{ cost: any target: fixnum edge: graph-edge } ;

  \\ What one growth reads and writes. `in-tree` marks the vertices already joined, and
  \\ `tree` collects the records it accepted.
  \\
  \\ `queue` is a one-element vector holding the heap, since a step fed to #each cannot hand
  \\ a persistent value back.
  prim-scratch: struct{ in-tree: vector queue: vector weight: quotation tree: vector } ;
}

private{
  throw-directed-spanning-tree: never-returns ( -- * ) [
    f "a minimum spanning tree requires an undirected graph" EInvalidArgument make-error throw
  ] ;

  \ Queue one of an in-tree vertex's edges as a way to reach its target. The entry comes
  \ first so a curried form feeds #each.
  \
  \ A target already in the tree needs no edge. That is also what drops a self-loop, since a
  \ vertex's own edges are offered only after it joins.
  prim-offer: ( e: dense-edge st: prim-scratch -- ) [
    over target>>
    over in-tree>> over #nth
    [ ]
    [
      2 pick-n 2 pick-n weight>> edge-weight
      over 4 pick-n edge>> make-prim-entry
      2 pick-n queue>> swap queue-push
    ]
    if
    3drop
  ] ;

  \ Join v to the tree and offer every edge leaving it. Each vertex joins once, so each of
  \ its stored entries is offered once.
  prim-admit: ( dg: dense-graph st: prim-scratch v: fixnum -- ) [
    over in-tree>> over t #nth! drop
    2 pick-n adjacency>> over #nth
    2 pick-n [ prim-offer ] curry
    #each
    3drop
  ] ;

  \ Take a popped candidate, or drop it when a cheaper one already brought its target in.
  \ Taking it records the edge and joins the target.
  prim-accept: ( dg: dense-graph st: prim-scratch e: prim-entry -- ) [
    dup target>>
    2 pick-n in-tree>> over #nth
    [ ]
    [
      2 pick-n tree>> 2 pick-n edge>> #push! drop
      3 pick-n 3 pick-n 2 pick-n prim-admit
    ]
    if
    2drop 2drop
  ] ;

  \ Grow one component, starting from a root that is not yet in the tree. Only an in-tree
  \ vertex offers edges, so the queue drains exactly when the component is covered, which
  \ leaves it empty for the next root.
  prim-grow: ( dg: dense-graph st: prim-scratch root: fixnum -- ) [
    2 pick-n 2 pick-n 2 pick-n prim-admit
    drop
    [
      dup queue>> queue-pop?
      dup option:some?
      [ option:some> [ 1 pick-n 1 pick-n ] dip prim-accept t ]
      [ drop f ]
      if
    ] loop
    2drop
  ] ;

  \ Grow from every vertex no earlier growth reached, in index order. O(V + E log V): the
  \ sweep looks at every vertex whatever the edge count, and each stored entry is pushed once
  \ and popped once.
  prim-forest: ( dg: dense-graph weight: quotation -- array ) [
    over vertices>> #len f filled-vector
    [ ] make-vector [ [ cost>> ] dip cost>> cmp ] <heap> #push!
    2 pick-n
    [ ] make-vector
    make-prim-scratch
    0
    [ dup 2 pick-n in-tree>> #len < ]
    [
      1 pick-n in-tree>> over #nth not
      [ 3 pick-n 2 pick-n 2 pick-n prim-grow ]
      when
      1 +
    ]
    while
    drop
    tree>> >array
    nip nip
  ] ;
}

\\ A minimum spanning tree, as the tree edges. A disconnected graph gives a minimum spanning
\\ forest, one tree per component, so a connected graph of V vertices gives V-1 edges and a
\\ graph of C components gives V-C. An isolated vertex contributes none.
\\
\\ Components come ordered by smallest member, as `graph-connected-components` does, and
\\ within each the edges come in the order the tree took them. Each record's `source` is the
\\ endpoint that was already in the tree, so orientation follows the order of discovery
\\ rather than the comparator.
\\
\\ The projection has effect `( edge: graph-edge -- weight )`, as `graph-dijkstra`'s does.
\\ Weights are compared with `cmp` and never added, so a negative one is fine here where a
\\ cheapest path rejects it. An edge is priced only when it is offered as a way in, so the
\\ projection runs at most once per stored entry.
\\
\\ O((V + E) log V), the projection's cost, with the walk itself O(V + E log V). The V term is
\\ the sweep that finds each component's root, which `graph-dijkstra` has no counterpart to.
\\ Throws `invalid-argument` on a digraph, whose spanning problem is a different one.
\\
\\   [ cmp ] <graph> 1 2 1 graph-add-edge-with-payload 2 3 1 graph-add-edge-with-payload
\\   1 3 10 graph-add-edge-with-payload [ payload>> ] graph-prim #len
\\   => 2
graph-prim: ( g: graph weight: quotation -- array ) [
  over graph-directed? [ throw-directed-spanning-tree ] when
  [ project ] dip
  prim-forest
] ;
