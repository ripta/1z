\ Math module - trigonometry, exponentials, logarithms, rounding, and constants

\\ Circle constant.
pi: ( -- f ) [ 3.141592653589793 ] ;
\\ Tau.
tau: ( -- f ) [ 6.283185307179586 ] ;
\\ Euler's number.
e: ( -- f ) [ 2.718281828459045 ] ;

\\ Sine.
sin: generic ( n -- f ) [ native.sin ] ;
\\ Cosine.
cos: generic ( n -- f ) [ native.cos ] ;
\\ Tangent.
tan: ( n -- f ) [ native.tan ] ;
\\ Arcsine.
asin: ( n -- f ) [ native.asin ] ;
\\ Arccosine.
acos: ( n -- f ) [ native.acos ] ;
\\ Arctangent.
atan: ( n -- f ) [ native.atan ] ;
\\ Two-argument arctangent.
atan2: ( y x -- f ) [ native.atan2 ] ;

\\ Natural exponential (e^n).
exp: generic ( n -- f ) [ native.exp ] ;
\\ Natural logarithm.
log: generic ( n -- f ) [ native.log ] ;
\\ Base-2 logarithm.
log2: ( n -- f ) [ native.log2 ] ;
\\ Base-10 logarithm.
log10: ( n -- f ) [ native.log10 ] ;

\\ Square root.
sqrt: generic ( n -- f ) [ native.sqrt ] ;
\\ Exponentiation.
pow: generic ( base exp -- f ) [ native.pow ] ;

\\ Round toward negative infinity.
floor: ( n -- f ) [ native.floor ] ;
\\ Round toward positive infinity.
ceil: ( n -- f ) [ native.ceil ] ;
\\ Round to nearest, ties to even.
round: ( n -- f ) [ native.round ] ;
\\ Round toward zero.
truncate: ( n -- f ) [ native.truncate ] ;

\ --- IEEE 754 bit introspection ---

\\ Virtual type wrapping a raw IEEE 754 bit pattern as an integer.
bits: virtual{ fixnum } ;

\\ Convert a float to its raw IEEE 754 bit pattern.
float>bits: ( f -- bits ) [ 64 native.float-raw-bits make-bits ] ;
\\ Convert a raw IEEE 754 bit pattern back to a float.
bits>float: ( bits -- f ) [ unmake-bits 64 native.raw-bits-float ] ;

\\ Convert a float to its raw 32-bit IEEE 754 bit pattern as a fixnum.
float32>bits: ( f -- fixnum ) [ 32 native.float-raw-bits ] ;
\\ Convert a raw 32-bit IEEE 754 bit pattern to a float.
bits>float32: ( fixnum -- f ) [ 32 native.raw-bits-float ] ;
\\ Alias for float>bits.
float64>bits: ( f -- bits ) [ float>bits ] ;
\\ Alias for bits>float.
bits>float64: ( bits -- f ) [ bits>float ] ;

\ Prepend "0" until the string is 16 characters.
bits-pad-hex: [
  dup #len 16 < [
    "0" swap #append bits-pad-hex
  ] when
] ;

\\ Display bits as zero-padded 16-digit uppercase hex.
inspect: method{ bits } [
  unmake-bits 16 >string-base uppercase
  bits-pad-hex
  "0x" swap #append
] ;

bitand:      method{ bits bits } [ swap unmake-bits swap unmake-bits bitand make-bits ] ;
bitor:       method{ bits bits } [ swap unmake-bits swap unmake-bits bitor make-bits ] ;
bitxor:      method{ bits bits } [ swap unmake-bits swap unmake-bits bitxor make-bits ] ;
bitnot:      method{ bits } [ unmake-bits bitnot make-bits ] ;
shift-left:  method{ bits fixnum } [ swap unmake-bits swap shift-left make-bits ] ;
shift-right: method{ bits fixnum } [ swap unmake-bits swap shift-right make-bits ] ;
ushift-right: method{ bits fixnum } [ swap unmake-bits swap ushift-right make-bits ] ;
shift: method{ bits fixnum } [ swap unmake-bits swap shift make-bits ] ;

\\ Next representable float toward positive infinity.
next-float: ( f -- f' ) [
  dup nan? [ ] [
    dup inf = [ ] [
      dup 0.0 = [
        drop 1 64 native.raw-bits-float
      ] [
        dup 0.0 > [
          64 native.float-raw-bits 1 + 64 native.raw-bits-float
        ] [
          64 native.float-raw-bits 1 - 64 native.raw-bits-float
        ] if
      ] if
    ] if
  ] if
] ;

\\ Next representable float toward negative infinity.
prev-float: ( f -- f' ) [
  dup nan? [ ] [
    dup -inf = [ ] [
      dup 0.0 = [
        drop 9223372036854775809 64 native.raw-bits-float
      ] [
        dup 0.0 > [
          64 native.float-raw-bits 1 - 64 native.raw-bits-float
        ] [
          64 native.float-raw-bits 1 + 64 native.raw-bits-float
        ] if
      ] if
    ] if
  ] if
] ;

\\ Unit in the last place of a float.
float-ulp: ( f -- ulp ) [
  dup nan? [ ] [
    dup infinite? [
      "float-ulp: undefined for infinity" EInvalidArgument make-error throw
    ] [
      dup 0.0 < [ -1.0 * ] when
      dup next-float swap -
    ] if
  ] if
] ;
