\ Unit tests for lib/heap.1z.
\
\ Ordering is pinned by draining through repeated heap-pop-min, which is the delete-min
\ chain along one version.

use "heap" ;
use { <range>: } "ranges" ;
use "testing" ;

\ --- Helpers ---

\ Insert 0, 1, ... n-1.
insert-n: ( heap n -- heap ) [ 0 swap <range> [ heap-insert ] #each ] ;

\ A permutation of 0 .. n-1: i * m mod n over i = 0 .. n-1, for m coprime with n.
scramble: ( n m -- array ) [
  [ * ] curry
  over [ % ] curry compose
  [ 0 swap <range> ] dip
  #map #collect
] ;

insert-scrambled: ( heap n m -- heap ) [ scramble [ heap-insert ] #each ] ;

\ Drain the whole heap in priority order by repeated pop-min.
drain-min: ( heap -- array ) [
  { } swap [ dup #len 0 > ] [ heap-pop-min swap [ #push ] dip ] while drop
] ;

\ --- Error constant ---

test-empty-heap-constant: ( -- ) [
  "error constant" test-section
  EEmptyHeap empty-heap: "EEmptyHeap carries the empty-heap type" assert=
] ;

\ --- Construction and size ---

test-constructor-is-empty: ( -- ) [
  "construction" test-section
  [ cmp ] <heap> #len 0 "#len of an empty heap is 0" assert=
] ;

test-insert-maintains-size: ( -- ) [
  "size" test-section
  [ cmp ] <heap> 1 insert-n #len 1 "#len after one insert" assert=
  [ cmp ] <heap> 64 insert-n #len 64 "#len after 64 inserts" assert=
] ;

test-merge-sums-sizes: ( -- ) [
  [ cmp ] <heap> 3 insert-n
  [ cmp ] <heap> 4 insert-n
  heap-merge #len 7 "#len of a merge sums both operands" assert=
  [ cmp ] <heap> [ cmp ] <heap> heap-merge #len 0 "merging two empty heaps stays empty" assert=
] ;

\ --- Merge ---

test-merge-with-empty-keeps-elements: ( -- ) [
  "merge" test-section
  [ cmp ] <heap> 5 insert-n
  [ cmp ] <heap> heap-merge
  drain-min 0 5 <range> #collect "empty right operand keeps the left elements" assert=
  [ cmp ] <heap>
  [ cmp ] <heap> 5 insert-n heap-merge
  drain-min 0 5 <range> #collect "empty left operand keeps the right elements" assert=
] ;

test-merge-interleaves: ( -- ) [
  [ cmp ] <heap> 0 heap-insert 2 heap-insert 4 heap-insert
  [ cmp ] <heap> 1 heap-insert 3 heap-insert 5 heap-insert
  heap-merge drain-min
  0 6 <range> #collect "a merge drains both operands' elements in order" assert=
] ;

test-merge-carries-left-comparator: ( -- ) [
  [ 2drop ordering:lt ] <heap>
  [ 2drop ordering:gt ] <heap>
  heap-merge comparator>>
  [ 1 2 ] dip call
  ordering:lt? "the merged heap answers with the left comparator" assert-true
] ;

\ --- Ordering through the pairing pass ---

test-min-after-inserts: ( -- ) [
  "ordering" test-section
  [ cmp ] <heap> 8 insert-n heap-min 0 "min after ascending inserts" assert=
  [ cmp ] <heap> 8 3 insert-scrambled heap-min 0 "min after scrambled inserts" assert=
  [ cmp ] <heap> 7 heap-insert 3 heap-insert 5 heap-insert
  heap-min 3 "min after interleaved inserts" assert=
] ;

test-drain-is-sorted: ( -- ) [
  [ cmp ] <heap> 64 insert-n drain-min
  0 64 <range> #collect "ascending fill drains sorted" assert=
  [ cmp ] <heap> 64 37 insert-scrambled drain-min
  0 64 <range> #collect "scrambled fill drains sorted" assert=
] ;

test-max-heap-via-inverted-comparator: ( -- ) [
  [ swap cmp ] <heap> 16 5 insert-scrambled
  dup heap-min 15 "inverted comparator surfaces the max" assert=
  drain-min 0 16 <range> [ 15 swap - ] #map #collect "inverted comparator drains descending" assert=
] ;

\ --- Persistence ---

test-insert-is-persistent: ( -- ) [
  "persistence" test-section
  [ cmp ] <heap> 4 insert-n
  dup 99 heap-insert
  #len 5 "the new version grew" assert=
  dup #len 4 "the retained version kept its size" assert=
  drain-min 0 4 <range> #collect "the retained version kept its elements" assert=
] ;

test-merge-is-persistent: ( -- ) [
  [ cmp ] <heap> 3 insert-n
  [ cmp ] <heap> 3 insert-n
  2dup heap-merge #len 6 "the merged version holds both" assert=
  [ #len 3 "the left operand is unchanged" assert= ] dip
  #len 3 "the right operand is unchanged" assert=
] ;

test-drain-twice-answers-the-same: ( -- ) [
  [ cmp ] <heap> 32 7 insert-scrambled
  dup drain-min swap drain-min
  "draining the same version twice answers the same array" assert=
] ;

test-pop-min-is-persistent: ( -- ) [
  [ cmp ] <heap> 8 3 insert-scrambled
  dup heap-pop-min 2drop
  drain-min 0 8 <range> #collect "a pop leaves the retained version whole" assert=
] ;

\ --- Pop-min ---

test-pop-min-shrinks: ( -- ) [
  "pop-min" test-section
  [ cmp ] <heap> 8 3 insert-scrambled
  heap-pop-min 0 "pop-min returns the min" assert=
  #len 7 "pop-min removes one element" assert=
] ;

\ --- Empty behavior and option twins ---

test-empty-behavior: ( -- ) [
  "empty behavior" test-section
  [ [ cmp ] <heap> heap-min ] empty-heap: "min on empty throws" assert-error-type
  [ [ cmp ] <heap> heap-pop-min ] empty-heap: "pop-min on empty throws" assert-error-type
  [ cmp ] <heap> heap-min? option:none? "min? on empty is none" assert-true
] ;

test-pop-min-empty-twin: ( -- ) [
  [ cmp ] <heap> heap-pop-min?
  option:none? "pop-min? on empty is none" assert-true
  dup #len 0 "the heap comes back unchanged" assert=
  7 heap-insert heap-pop-min nip 7 "the unchanged heap still works" assert=
] ;

test-twins-surface-the-min: ( -- ) [
  [ cmp ] <heap> 8 3 insert-scrambled heap-min? option:some>
  0 "min? surfaces the min" assert=
  [ cmp ] <heap> 5 heap-insert 2 heap-insert heap-pop-min? nip option:some>
  2 "pop-min? surfaces the min" assert=
] ;

\ --- Decrease-key ---

test-decrease-key-reorders: ( -- ) [
  "decrease-key" test-section
  [ cmp ] <heap> 8 3 insert-scrambled
  5 -1 heap-decrease-key
  dup #len 8 "size is unchanged" assert=
  dup heap-min -1 "the replacement is the new min" assert=
  heap-pop-min drop
  drain-min { 0 1 2 3 4 6 7 } "the old element is gone" assert=
] ;

test-decrease-key-general-replace: ( -- ) [
  [ cmp ] <heap> 3 heap-insert 7 heap-insert
  3 5 heap-decrease-key
  drain-min { 5 7 } "the min is replaceable by a larger value" assert=
] ;

test-decrease-key-removes-one-duplicate: ( -- ) [
  [ cmp ] <heap> 4 heap-insert 4 heap-insert 4 heap-insert
  4 1 heap-decrease-key
  drain-min { 1 4 4 } "duplicates lose exactly one element" assert=
] ;

test-decrease-key-matches-by-comparator: ( -- ) [
  [ [ 0 #nth ] dip 0 #nth cmp ] <heap>
  { 1 10 } heap-insert { 2 20 } heap-insert
  { 1 99 } { 0 0 } heap-decrease-key
  heap-min { 0 0 } "the match is by comparator equality, not structural equality" assert=
] ;

test-decrease-key-not-found-throws: ( -- ) [
  [ [ cmp ] <heap> 3 heap-insert 9 1 heap-decrease-key ]
  key-not-found: "a missing key throws" assert-error-type
  [ [ cmp ] <heap> 9 1 heap-decrease-key ]
  key-not-found: "an empty heap throws" assert-error-type
] ;

test-decrease-key-is-persistent: ( -- ) [
  [ cmp ] <heap> 8 3 insert-scrambled
  dup 5 -1 heap-decrease-key drop
  drain-min 0 8 <range> #collect "the original version is untouched" assert=
] ;

\ --- Iteration ---

test-sorted-agrees-with-drain-min: ( -- ) [
  "iteration" test-section
  [ cmp ] <heap> 64 37 insert-scrambled
  dup heap-sorted #collect
  swap drain-min "heap-sorted agrees with the pop-min drain" assert=
] ;

test-sorted-is-lazy-and-persistent: ( -- ) [
  [ cmp ] <heap> 16 5 insert-scrambled
  dup heap-sorted 3 #take #collect { 0 1 2 } "taking three yields the three smallest" assert=
  dup #len 16 "the source heap is unchanged after a partial take" assert=
  dup heap-sorted #collect 0 16 <range> #collect "a fresh iterator sees everything" assert=
  heap-sorted #collect 0 16 <range> #collect "each call carries independent state" assert=
] ;

test-iteration-on-empty: ( -- ) [
  [ cmp ] <heap> heap-sorted #collect { } "sorted over an empty heap yields nothing" assert=
  [ cmp ] <heap> heap-unsorted #collect { } "unsorted over an empty heap yields nothing" assert=
] ;

test-unsorted-yields-every-element: ( -- ) [
  [ cmp ] <heap> 64 37 insert-scrambled
  dup heap-unsorted [ < ] #sort
  swap drain-min "the unsorted walk yields exactly the heap's elements" assert=
] ;

test-unsorted-leaves-heap-intact: ( -- ) [
  [ cmp ] <heap> 32 7 insert-scrambled
  dup heap-unsorted #count 32 "the unsorted walk visits every element" assert=
  #len 32 "the walk is read-only" assert=
] ;

\ --- Protocol methods ---

test-iterator-dispatches-sorted: ( -- ) [
  "protocol methods" test-section
  [ cmp ] <heap> 16 5 insert-scrambled
  >iterator #collect 0 16 <range> #collect ">iterator drains in priority order" assert=
] ;

test-empty-method: ( -- ) [
  [ cmp ] <heap> #empty? "an empty heap is #empty?" assert-true
  [ cmp ] <heap> 1 heap-insert #empty? "a filled heap is not #empty?" assert-false
] ;

test-first-and-twin: ( -- ) [
  [ cmp ] <heap> 8 3 insert-scrambled #first 0 "#first is the min" assert=
  [ [ cmp ] <heap> #first ] empty-heap: "#first on empty throws empty-heap" assert-error-type
  [ cmp ] <heap> 8 3 insert-scrambled #first? option:some> 0 "#first? surfaces the min" assert=
  [ cmp ] <heap> #first? option:none? "#first? on empty is none" assert-true
] ;

test-to-array-is-the-sorted-dump: ( -- ) [
  [ cmp ] <heap> 16 5 insert-scrambled >array
  0 16 <range> #collect ">array is the sorted dump" assert=
] ;

test-unregistered-words-throw: ( -- ) [
  [ [ cmp ] <heap> 1 heap-insert 0 #nth ] "#nth on a heap throws" assert-error
  [ [ cmp ] <heap> 1 heap-insert #last ] "#last on a heap throws" assert-error
  [ [ cmp ] <heap> 1 heap-insert 2 #push ] "#push on a heap throws" assert-error
  [ [ cmp ] <heap> 1 heap-insert #pop ] "#pop on a heap throws" assert-error
] ;

\ --- Deep shapes ---
\
\ An ascending fill hangs every element off the root, so the first pop runs one pairing
\ pass over O(n) children and a full-scan replace walks the same width. An inverted
\ comparator turns the same fill into the deep-tree shape. Pinned at a width that
\ overflowed the task stack when the pass and the scans were arm-tail recursion. The
\ iterator walks ride the same two shapes.

test-deep-wide-root: ( -- ) [
  "deep shapes" test-section
  [ cmp ] <heap> 2000 insert-n
  dup heap-pop-min 0 "the first pop of a wide root answers the min" assert=
  #len 1999 "the wide-root pop removed one element" assert=
  0 -5 heap-decrease-key
  dup #len 2000 "a full-scan replace keeps the size" assert=
  heap-min -5 "a full-scan replace of the root landed" assert=
] ;

test-deep-tree-scan: ( -- ) [
  [ swap cmp ] <heap> 2000 insert-n
  0 5000 heap-decrease-key
  heap-min 5000 "a deep-tree scan lands the replacement" assert=
] ;

test-deep-iteration: ( -- ) [
  [ cmp ] <heap> 2000 insert-n
  dup heap-unsorted #count 2000 "the unsorted walk covers a wide root" assert=
  >iterator #count 2000 "the sorted drain covers a wide root" assert=
  [ swap cmp ] <heap> 2000 insert-n
  dup heap-unsorted #count 2000 "the unsorted walk covers a deep tree" assert=
  >iterator #count 2000 "the sorted drain covers a deep tree" assert=
] ;

\ --- priority-queue ---

\ Drain the queue's values in priority order by repeated pop-min.
drain-pq-values: ( pq -- array ) [
  { } swap [ dup #len 0 > ] [ priority-queue-pop-min value>> swap [ #push ] dip ] while drop
] ;

test-pq-constructor-is-empty: ( -- ) [
  "priority-queue" test-section
  [ cmp ] <priority-queue> #len 0 "#len of an empty queue is 0" assert=
  [ cmp ] <priority-queue> #empty? "an empty queue is #empty?" assert-true
] ;

test-pq-insert-and-min-entry: ( -- ) [
  [ cmp ] <priority-queue> 2 20 priority-queue-insert 1 10 priority-queue-insert
  dup #len 2 "#len counts the entries" assert=
  priority-queue-min
  dup priority>> 1 "min surfaces the smallest priority" assert=
  value>> 10 "min carries that priority's value" assert=
] ;

test-pq-drains-in-priority-order: ( -- ) [
  [ cmp ] <priority-queue>
  3 30 priority-queue-insert 1 10 priority-queue-insert
  4 40 priority-queue-insert 2 20 priority-queue-insert
  drain-pq-values { 10 20 30 40 } "values drain in priority order" assert=
] ;

test-pq-keeps-equal-priorities: ( -- ) [
  [ cmp ] <priority-queue> 1 10 priority-queue-insert 1 11 priority-queue-insert
  dup #len 2 "equal priorities do not overwrite" assert=
  drain-pq-values [ < ] #sort { 10 11 } "both values drain" assert=
] ;

test-pq-empty-behavior: ( -- ) [
  [ [ cmp ] <priority-queue> priority-queue-min ] empty-heap:
  "min on empty throws" assert-error-type
  [ [ cmp ] <priority-queue> priority-queue-pop-min ] empty-heap:
  "pop-min on empty throws" assert-error-type
  [ cmp ] <priority-queue> priority-queue-min? option:none? "min? on empty is none" assert-true
] ;

test-pq-pop-min-empty-twin: ( -- ) [
  [ cmp ] <priority-queue> priority-queue-pop-min?
  option:none? "pop-min? on empty is none" assert-true
  dup #len 0 "the queue comes back unchanged" assert=
  7 70 priority-queue-insert priority-queue-pop-min nip
  value>> 70 "the unchanged queue still works" assert=
] ;

test-pq-merge: ( -- ) [
  [ cmp ] <priority-queue> 2 20 priority-queue-insert
  [ cmp ] <priority-queue> 1 10 priority-queue-insert
  priority-queue-merge
  dup #len 2 "#len of a merge sums both operands" assert=
  priority-queue-min value>> 10 "the merge surfaces the global min" assert=
] ;

test-pq-is-persistent: ( -- ) [
  [ cmp ] <priority-queue> 2 20 priority-queue-insert 1 10 priority-queue-insert
  dup priority-queue-pop-min 2drop
  dup #len 2 "the retained version kept its entries" assert=
  drain-pq-values { 10 20 } "the retained version drains whole" assert=
] ;

\ --- priority-queue aliases ---

test-pq-aliases: ( -- ) [
  "priority-queue aliases" test-section
  [ cmp ] <priority-queue> 2 20 pq-insert 1 10 pq-insert
  dup pq-min value>> 10 "pq-min surfaces the min entry" assert=
  dup pq-min? option:some> priority>> 1 "pq-min? wraps the min entry" assert=
  pq-pop-min value>> 10 "pq-pop-min takes the min entry" assert=
  pq-pop-min value>> 20 "then the next" assert=
  drop
] ;

\ Drain with the option twin until it answers none, keeping priority order.
pq-drain-all: ( pq -- array ) [
  { } swap
  [ pq-pop-min? dup option:some? ]
  [ option:some> value>> swap [ #push ] dip ]
  while
  2drop
] ;

test-pq-pop-twin-composes-a-drain-loop: ( -- ) [
  [ cmp ] <priority-queue>
  3 30 pq-insert 1 10 pq-insert 2 20 pq-insert
  pq-drain-all { 10 20 30 } "the drain loop stops on none and keeps priority order" assert=
] ;

\ --- priority-queue protocol methods ---

test-pq-iterator-yields-entries-sorted: ( -- ) [
  "priority-queue protocol methods" test-section
  [ cmp ] <priority-queue>
  3 30 priority-queue-insert 1 10 priority-queue-insert 2 20 priority-queue-insert
  >iterator [ value>> ] #map #collect
  { 10 20 30 } ">iterator yields entries in priority order" assert=
] ;

test-pq-sorted-is-lazy: ( -- ) [
  [ cmp ] <priority-queue>
  3 30 priority-queue-insert 1 10 priority-queue-insert 2 20 priority-queue-insert
  dup priority-queue-sorted 1 #take [ priority>> ] #map #collect
  { 1 } "taking one yields the smallest" assert=
  #len 3 "the source queue is unchanged after a partial take" assert=
] ;

test-pq-unsorted-yields-every-entry: ( -- ) [
  [ cmp ] <priority-queue>
  3 30 priority-queue-insert 1 10 priority-queue-insert 2 20 priority-queue-insert
  priority-queue-unsorted [ value>> ] #map [ < ] #sort
  { 10 20 30 } "the unsorted walk yields exactly the entries" assert=
] ;

test-pq-first-and-twin: ( -- ) [
  [ cmp ] <priority-queue> 2 20 priority-queue-insert 1 10 priority-queue-insert
  #first value>> 10 "#first is the min entry" assert=
  [ cmp ] <priority-queue> 2 20 priority-queue-insert 1 10 priority-queue-insert
  #first? option:some> value>> 10 "#first? surfaces the min entry" assert=
  [ [ cmp ] <priority-queue> #first ] empty-heap: "#first on empty throws empty-heap" assert-error-type
  [ cmp ] <priority-queue> #first? option:none? "#first? on empty is none" assert-true
] ;

test-pq-to-array-is-the-sorted-entry-dump: ( -- ) [
  [ cmp ] <priority-queue> 2 20 priority-queue-insert 1 10 priority-queue-insert
  >array [ priority>> ] #map #collect { 1 2 } ">array is the sorted entry dump" assert=
] ;

test-pq-unregistered-words-throw: ( -- ) [
  [ [ cmp ] <priority-queue> 1 10 priority-queue-insert 0 #nth ] "#nth on a queue throws" assert-error
  [ [ cmp ] <priority-queue> 1 10 priority-queue-insert #last ] "#last on a queue throws" assert-error
  [ [ cmp ] <priority-queue> 1 10 priority-queue-insert 2 #push ] "#push on a queue throws" assert-error
  [ [ cmp ] <priority-queue> 1 10 priority-queue-insert #pop ] "#pop on a queue throws" assert-error
] ;
