\ lib/ratio.1z - Exact rational arithmetic

EInexactConversion: [ inexact-conversion: ] ;

ratio: H{ numeric: t exact: t } virtual{ struct{ numer denom } } ;

\ Accessors: unwrap the virtual type, then extract by position
\ Virtual structs don't export these by default
numer>>: ( ratio -- n ) [ unmake-ratio drop ] ;
denom>>: ( ratio -- d ) [ unmake-ratio nip ] ;

\ Normalizing constructor: reduces to lowest terms, enforces positive
\ denominator, demotes to integer when denominator is 1.
normalize-ratio: ( numer denom -- ratio-or-int ) [
  dup 0 = [ f "division by zero" EDivisionByZero make-error throw ] when
  2dup gcd
  tuck
  div
  -rot>
  div
  swap
  dup 0 <
  [ [ 0 swap - ] dip 0 swap - ] when
  dup 1 =
  [ drop ]
  [ make-ratio ]
  if
] ;

>string: method{ ratio } [
  dup numer>> >string "/" #append
  swap denom>> >string #append
] ;

\ --- Ratio-ratio arithmetic ---

+: method{ ratio ratio } [
  over numer>> over denom>> *
  2 pick-n denom>> 2 pick-n numer>> *
  +
  -rot> denom>> swap denom>> *
  normalize-ratio
] ;

-: method{ ratio ratio } [
  over numer>> over denom>> *
  2 pick-n denom>> 2 pick-n numer>> *
  -
  -rot> denom>> swap denom>> *
  normalize-ratio
] ;

*: method{ ratio ratio } [
  over numer>> over numer>> *
  -rot> denom>> swap denom>> *
  normalize-ratio
] ;

/: method{ ratio ratio } [
  over numer>> over denom>> *
  -rot> numer>> swap denom>> *
  normalize-ratio
] ;

\ --- Integer division producing ratios when inexact ---

/: method{ fixnum fixnum } [
  2dup rem 0 = [ div ] [ normalize-ratio ] if
] ;

/: method{ bignum bignum } [
  2dup rem 0 = [ div ] [ normalize-ratio ] if
] ;

/: method{ fixnum bignum } [
  2dup rem 0 = [ div ] [ normalize-ratio ] if
] ;

/: method{ bignum fixnum } [
  2dup rem 0 = [ div ] [ normalize-ratio ] if
] ;

%: method{ ratio ratio } [
  over numer>> over denom>> *
  2 pick-n denom>> 2 pick-n numer>> *
  %
  -rot> denom>> swap denom>> *
  normalize-ratio
] ;

=: method{ ratio ratio } [
  over numer>> over numer>> =
  [ denom>> swap denom>> = ]
  [ 2drop f ]
  if
] ;

<: method{ ratio ratio } [
  over numer>> over denom>> *
  -rot> numer>> swap denom>> *
  <
] ;

>: method{ ratio ratio } [
  over numer>> over denom>> *
  -rot> numer>> swap denom>> *
  >
] ;

\ --- Ratio-to-float promotion ---

ratio>float: ( ratio -- f ) [ dup numer>> >float swap denom>> >float / ] ;

\ --- Mixed ratio/float arithmetic ---

+: method{ ratio float } [ swap ratio>float swap + ] ;
+: method{ float ratio } [ ratio>float + ] ;

-: method{ ratio float } [ swap ratio>float swap - ] ;
-: method{ float ratio } [ ratio>float - ] ;

*: method{ ratio float } [ swap ratio>float swap * ] ;
*: method{ float ratio } [ ratio>float * ] ;

/: method{ ratio float } [ swap ratio>float swap / ] ;
/: method{ float ratio } [ ratio>float / ] ;

%: method{ ratio float } [ swap ratio>float swap % ] ;
%: method{ float ratio } [ ratio>float % ] ;

=: method{ ratio float } [ swap ratio>float swap = ] ;
=: method{ float ratio } [ ratio>float = ] ;

<: method{ ratio float } [ swap ratio>float swap < ] ;
<: method{ float ratio } [ ratio>float < ] ;

>: method{ ratio float } [ swap ratio>float swap > ] ;
>: method{ float ratio } [ ratio>float > ] ;

\ --- Mixed integer/ratio arithmetic ---

+: method{ ratio fixnum } [ 1 make-ratio + ] ;
+: method{ fixnum ratio } [ swap 1 make-ratio swap + ] ;
+: method{ ratio bignum } [ 1 make-ratio + ] ;
+: method{ bignum ratio } [ swap 1 make-ratio swap + ] ;

-: method{ ratio fixnum } [ 1 make-ratio - ] ;
-: method{ fixnum ratio } [ swap 1 make-ratio swap - ] ;
-: method{ ratio bignum } [ 1 make-ratio - ] ;
-: method{ bignum ratio } [ swap 1 make-ratio swap - ] ;

*: method{ ratio fixnum } [ 1 make-ratio * ] ;
*: method{ fixnum ratio } [ swap 1 make-ratio swap * ] ;
*: method{ ratio bignum } [ 1 make-ratio * ] ;
*: method{ bignum ratio } [ swap 1 make-ratio swap * ] ;

/: method{ ratio fixnum } [ 1 make-ratio / ] ;
/: method{ fixnum ratio } [ swap 1 make-ratio swap / ] ;
/: method{ ratio bignum } [ 1 make-ratio / ] ;
/: method{ bignum ratio } [ swap 1 make-ratio swap / ] ;

%: method{ ratio fixnum } [ 1 make-ratio % ] ;
%: method{ fixnum ratio } [ swap 1 make-ratio swap % ] ;
%: method{ ratio bignum } [ 1 make-ratio % ] ;
%: method{ bignum ratio } [ swap 1 make-ratio swap % ] ;

=: method{ ratio fixnum } [ 1 make-ratio = ] ;
=: method{ fixnum ratio } [ swap 1 make-ratio swap = ] ;
=: method{ ratio bignum } [ 1 make-ratio = ] ;
=: method{ bignum ratio } [ swap 1 make-ratio swap = ] ;

<: method{ ratio fixnum } [ 1 make-ratio < ] ;
<: method{ fixnum ratio } [ swap 1 make-ratio swap < ] ;
<: method{ ratio bignum } [ 1 make-ratio < ] ;
<: method{ bignum ratio } [ swap 1 make-ratio swap < ] ;

>: method{ ratio fixnum } [ 1 make-ratio > ] ;
>: method{ fixnum ratio } [ swap 1 make-ratio swap > ] ;
>: method{ ratio bignum } [ 1 make-ratio > ] ;
>: method{ bignum ratio } [ swap 1 make-ratio swap > ] ;

\ --- Conversion words ---

>integer: method{ ratio } [ dup numer>> swap denom>> div ] ;
>float: method{ ratio } [ ratio>float ] ;

float-approx-ratio: ( f -- ratio-or-int ) [ native.float-approx-ratio normalize-ratio ] ;

\ Exact f64 bit representation as a ratio using float-parts.
\ value = sign * mantissa * 2^exponent
float>ratio: ( f -- ratio-or-int ) [
  float-parts
  -rot>
  dup 0 >= [
    1 swap shift-left
    swap *
    swap *
  ] [
    0 swap -
    1 swap shift-left
    normalize-ratio
    swap *
  ] if
] ;

\\ Exact float conversion. Errors with EInexactConversion if the conversion
\\ loses precision (e.g., large integers or non-dyadic rationals).
>float(exact): ( x -- f ) [
  dup float?
  [ ]
  [ dup >float dup float>ratio <rot- = not [ f "inexact conversion" EInexactConversion make-error throw ] when ]
  if
] ;
