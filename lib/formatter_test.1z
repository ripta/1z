\ Unit tests for lib/formatter.1z.
\
\ These cover the chunk fold and the classifier, the two places where the 1z
\ formatter has to reproduce a host tokenizer that splits on whitespace alone,
\ and the two alignment passes, whose line rules are easier to pin down here
\ than through a whole formatted file.

use "1z-tokens" ;
use "formatter" ;
use "lexer" ;
use { using-temp-directory: } "os/fs" ;
use { path-join: } "os/path" ;
use "strings" ;
use "testing" ;

private{
  (chunks-of): ( src: string -- array ) [ 1z-tokenize #collect (chunk-tokens) ] ;
  (texts-of):  ( src: string -- array ) [ (chunks-of) [ value>> ] #map #collect ] ;
  (kinds-of):  ( src: string -- array ) [ (chunks-of) [ kind>> ] #map #collect ] ;

  \\ One commented line: code, a two-space gap widened by pad, and a comment.
  \\ pad is the padding the aligner is expected to add.
  \\
  \\ Assembled rather than written out. A source line holding two spaces before a
  \\ backslash is an inline comment to the aligner, so a literal would let a
  \\ `make fmt` run rewrite the data these tests assert against.
  (with-comment): ( code: string pad: fixnum text: string -- string ) [
    [ " " swap 2 + repeat #append "\\ " #append ] dip #append
  ] ;

  \\ The same line, terminated.
  (commented): ( code: string pad: fixnum text: string -- string ) [
    (with-comment) "\n" #append
  ] ;

  \\ The default config with one key replaced. `fmt-config` is immutable, so the
  \\ round trip through its hash is the way to vary one rule.
  (config-with): ( key: string value -- fmt-config ) [
    [ default-fmt-config >hash ] 2dip @set >fmt-config
  ] ;

  \\ Format src under the defaults with one key replaced.
  (formatted-with): ( key: string value src: string -- string ) [
    [ (config-with) current-fmt-config ] dip
    [ format-source ] curry
    with-parameter
  ] ;
}

"chunk folding" test-section

test-chunk-bracket-glued-to-number: ( -- ) [
  "[1 2 +]" (texts-of) { "[1" "2" "+]" }
  "a bracket glued to a number stays in one chunk" assert=
] ;

test-chunk-comment-stands-alone: ( -- ) [
  "a  \\ hi" (texts-of) { "a" "\\ hi" }
  "a comment is its own chunk" assert=
] ;

test-chunk-newline-stands-alone: ( -- ) [
  "a\nb" (texts-of) { "a" "\n" "b" }
  "a newline is its own chunk" assert=
] ;

test-chunk-stack-effect-splits: ( -- ) [
  "foo:( a -- b )" (texts-of) { "foo:(" "a" "--" "b" ")" }
  "a stack effect splits into its whitespace-separated pieces" assert=
] ;

test-chunk-string-closes-a-chunk-it-opened: ( -- ) [
  "\"a\"print" (texts-of) { "\"a\"" "print" }
  "a string that opened a chunk closes it" assert=
] ;

test-chunk-string-extends-an-open-chunk: ( -- ) [
  "[\"a\"]" (texts-of) { "[\"a\"]" }
  "a string inside a run extends the chunk" assert=
] ;

test-chunk-string-preceded-by-a-word: ( -- ) [
  "x\"a\"" (texts-of) { "x\"a\"" }
  "a word running into a string stays one chunk" assert=
] ;

"classification" test-section

test-classify-brace-word-opens: ( -- ) [
  "struct{ x }" (kinds-of) 0 #nth open-brace:
  "a word ending in a brace opens a block" assert=
] ;

test-classify-close-brace-glued-to-separator: ( -- ) [
  "H{ a: 1 };" (kinds-of) 3 #nth close-brace:
  "a close brace glued to its separator still closes the block" assert=
] ;

test-classify-close-bracket-glued-to-separator: ( -- ) [
  "[ 1 ];" (kinds-of) 2 #nth word:
  "a close bracket glued to a separator is a word, not a closer" assert=
] ;

test-classify-parenthesized-name-is-a-symbol: ( -- ) [
  "(check-zlib): [ ]" (kinds-of) 0 #nth symbol:
  "a parenthesized word name is a symbol" assert=
] ;

"line splitting" test-section

test-split-lines-drops-the-empty-tail: ( -- ) [
  "a\nb\n" (split-lines) { "a" "b" }
  "a final newline adds no empty line" assert=
] ;

test-split-lines-keeps-an-unterminated-last-line: ( -- ) [
  "a\nb" (split-lines) { "a" "b" }
  "a last line without a newline is still a line" assert=
] ;

test-split-lines-keeps-a-blank-line: ( -- ) [
  "a\n\nb\n" (split-lines) { "a" "" "b" }
  "a blank line in the middle survives" assert=
] ;

test-split-lines-of-empty-text: ( -- ) [
  "" (split-lines) { }
  "empty text has no lines" assert=
] ;

"inline comment detection" test-section

test-comment-pos-behind-two-spaces: ( -- ) [
  "abc  \\ note" (inline-comment-pos) 5
  "a marker behind two spaces is inline" assert=
] ;

test-comment-pos-behind-one-space: ( -- ) [
  "abc \\ note" (inline-comment-pos) f
  "a marker behind one space is not inline" assert=
] ;

test-comment-pos-indented-standalone: ( -- ) [
  "  \\ note" (inline-comment-pos) f
  "an indented standalone comment is not inline" assert=
] ;

test-comment-pos-at-first-character: ( -- ) [
  "\\ note" (inline-comment-pos) f
  "a marker at the first character is not inline" assert=
] ;

test-comment-pos-at-second-character: ( -- ) [
  "a\\ note" (inline-comment-pos) f
  "a marker at the second character is not inline" assert=
] ;

test-comment-pos-without-a-marker: ( -- ) [
  "abc def" (inline-comment-pos) f
  "a line holding no backslash has no marker" assert=
] ;

test-comment-pos-hidden-by-a-string: ( -- ) [
  "\"a\\\\nb\" x  \\ note" (inline-comment-pos) f
  "a backslash inside a string hides the marker after it" assert=
] ;

"comment alignment" test-section

test-align-run-shares-one-column: ( -- ) [
  "a" 0 "one" (commented)
  "bbbb" 0 "two" (commented) #append
  "cc" 0 "three" (commented) #append
  (align-comments)
  "a" 3 "one" (commented)
  "bbbb" 0 "two" (commented) #append
  "cc" 2 "three" (commented) #append
  "a run of commented lines shares one column" assert=
] ;

test-align-uncommented-line-ends-a-run: ( -- ) [
  "a" 0 "one" (commented) "plain\n" #append
  "bbbb" 0 "two" (commented) #append
  dup (align-comments) swap
  "an uncommented line ends a run" assert=
] ;

test-align-blank-line-ends-a-run: ( -- ) [
  "a" 0 "one" (commented) "\n" #append
  "bbbb" 0 "two" (commented) #append
  dup (align-comments) swap
  "a blank line ends a run" assert=
] ;

test-align-standalone-comment-ends-a-run: ( -- ) [
  "a" 0 "one" (commented) "\\ header\n" #append
  "bbbb" 0 "two" (commented) #append
  dup (align-comments) swap
  "a standalone comment ends a run" assert=
] ;

test-align-without-comments: ( -- ) [
  "one\ntwo\n" (align-comments) "one\ntwo\n"
  "text holding no inline comments passes through" assert=
] ;

test-align-empty-text: ( -- ) [
  "" (align-comments) ""
  "empty text stays empty" assert=
] ;

test-align-keeps-a-missing-final-newline: ( -- ) [
  "a  " "\\ one" #append
  dup (align-comments) swap
  "text without a final newline does not gain one" assert=
] ;

test-rtrim-spaces-leaves-a-tab: ( -- ) [
  "a\t  " (rtrim-spaces) "a\t"
  "only spaces are trimmed, never tabs" assert=
] ;

"alignable line parsing" test-section

test-rtrim-blanks-takes-a-tab: ( -- ) [
  "a\t  " (rtrim-blanks) "a"
  "spaces and tabs are both trimmed" assert=
] ;

test-indent-width-stops-at-a-tab: ( -- ) [
  " \tx" (indent-width) 1
  "a tab does not count as indentation" assert=
] ;

test-parse-definition-with-effect: ( -- ) [
  "add: ( a b -- c ) [ + ] ;" (parse-alignable)
  dup name>> "add:" "the name is the line's first word" assert=
  dup effect>> "( a b -- c )" "the stack effect runs to the first ` )`" assert=
  dup body>> "[ + ]" "the body is what follows the stack effect" assert=
  dup suffix>> " ;" "a top-level definition carries the ` ;` suffix" assert=
  has-effect>> "a body opening with `(` is a stack effect" assert-true
] ;

test-parse-definition-without-effect: ( -- ) [
  "pi: 3.14159 ;" (parse-alignable)
  dup has-effect>> "a body not opening with `(` is no stack effect" assert-false
  dup body>> "3.14159" "the body is everything after the name" assert=
  comment>> f "a line holding no marker has no comment" assert=
] ;

test-parse-definition-with-comment: ( -- ) [
  "double: ( n -- n ) [ 2 * ] ;" 0 "times two" (with-comment) (parse-alignable)
  dup body>> "[ 2 * ]" "the comment is not part of the body" assert=
  comment>> "\\ times two" "the comment is kept whole" assert=
] ;

test-parse-block-entry: ( -- ) [
  "  name: string" (parse-alignable)
  dup indent>> "  " "the indent is the literal leading spaces" assert=
  dup has-effect>> "an indented line parses no stack effect" assert-false
  dup body>> "string" "the body is everything after the name" assert=
  suffix>> "" "a block entry carries no suffix" assert=
] ;

test-parse-rejects-line-without-semicolon: ( -- ) [
  "add: ( a b -- c ) [ + ]" (parse-alignable) f
  "an unindented line not ending in ` ;` is not alignable" assert=
] ;

test-parse-rejects-unnamed-line: ( -- ) [
  "dup drop ;" (parse-alignable) f
  "a first word not ending in `:` is not alignable" assert=
] ;

test-parse-rejects-bodyless-definition: ( -- ) [
  "pi: ;" (parse-alignable) f
  "a definition with nothing but its suffix is not alignable" assert=
] ;

test-parse-rejects-unclosed-stack-effect: ( -- ) [
  "foo: ( a b -- [ + ] ;" (parse-alignable) f
  "a stack effect with no closing paren is not alignable" assert=
] ;

test-parse-rejects-definition-that-is-all-stack-effect: ( -- ) [
  "foo: ( a -- b ) ;" (parse-alignable) f
  "a definition with nothing after its stack effect is not alignable" assert=
] ;

test-parse-rejects-bodyless-block-entry: ( -- ) [
  "  name:" 0 "note" (with-comment) (parse-alignable) f
  "a block entry whose only content is a comment is not alignable" assert=
] ;

"symbol alignment" test-section

test-align-run-shares-one-column: ( -- ) [
  "pi: 3.14 ;\ne: 2.71 ;\ntau: 6.28 ;\n" (align-symbols)
  "pi:  3.14 ;\ne:   2.71 ;\ntau: 6.28 ;\n"
  "a run of three definitions shares one column" assert=
] ;

test-align-under-minimum-is-untouched: ( -- ) [
  "pi: 3.14 ;\ntau: 6.28 ;\n" dup (align-symbols) swap
  "a run of two definitions is left alone" assert=
] ;

test-align-divergent-name-splits-a-run: ( -- ) [
  "x: 1 ;\ny: 2 ;\nz: 3 ;\nthis-is-a-very-long-name: 4 ;\nanother-very-long-name: 5 ;\nyet-another-long-name: 6 ;\n"
  (align-symbols)
  "x: 1 ;\ny: 2 ;\nz: 3 ;\nthis-is-a-very-long-name: 4 ;\nanother-very-long-name:   5 ;\nyet-another-long-name:    6 ;\n"
  "a name further from the shortest than it is long starts a new subgroup" assert=
] ;

\ The divergence limit is inclusive. These three names spread exactly as wide as
\ the shortest of them, so they stay one subgroup; a strict test would split them.
test-align-joins-at-the-divergence-limit: ( -- ) [
  "abc: 1 ;\nabcdefg: 2 ;\nabcd: 3 ;\n" (align-symbols)
  "abc:     1 ;\nabcdefg: 2 ;\nabcd:    3 ;\n"
  "a spread equal to the shortest name still joins" assert=
] ;

test-align-indent-change-ends-a-group: ( -- ) [
  "a: 1 ;\nbb: 2 ;\n  ccc: 3\n  dd: 4\n  e: 5\n" (align-symbols)
  "a: 1 ;\nbb: 2 ;\n  ccc: 3\n  dd:  4\n  e:   5\n"
  "a change of indent ends a group" assert=
] ;

test-align-effect-change-ends-a-run: ( -- ) [
  "aa: ( -- ) [ ] ;\nbb: ( -- ) [ ] ;\ncc: ( -- ) [ ] ;\npi: 1 ;\ne: 2 ;\ntau: 3 ;\n" (align-symbols)
  "aa: ( -- ) [ ] ;\nbb: ( -- ) [ ] ;\ncc: ( -- ) [ ] ;\npi:  1 ;\ne:   2 ;\ntau: 3 ;\n"
  "gaining a stack effect ends a run" assert=
] ;

test-align-unparsable-line-ends-a-group: ( -- ) [
  "pi: 3.14 ;\ndup drop ;\ne: 2.71 ;\ntau: 6.28 ;\n" dup (align-symbols) swap
  "a line that is not a definition ends a group" assert=
] ;

test-align-widens-the-stack-effect-column: ( -- ) [
  "a: ( x -- ) [ ] ;\nb: ( x y -- ) [ ] ;\nc: ( x -- ) [ ] ;\n" (align-symbols)
  "a: ( x -- )   [ ] ;\nb: ( x y -- ) [ ] ;\nc: ( x -- )   [ ] ;\n"
  "the stack effect column is padded to the widest in the run" assert=
] ;

test-align-empty-text: ( -- ) [
  "" (align-symbols) ""
  "empty text stays empty" assert=
] ;

"configuration" test-section

test-config-defaults-are-the-formatter-s-original-values: ( -- ) [
  default-fmt-config >hash
  H{
    "indent-size" 2 "max-blank-lines" 1 "align-comments" t "align-symbols" t
    "align-min-group" 3 "align-max-padding" 15 "trailing-newline" t
  }
  "the zero-config rules are the ones the formatter carried hardcoded" assert=
] ;

test-config-indent-size-widens-a-block: ( -- ) [
  "indent-size" 4 "foo: [\n1\n] ;\n" (formatted-with)
  "foo: [\n    1\n] ;\n"
  "indent-size sets the spaces per nesting level" assert=
] ;

test-config-max-blank-lines-zero-removes-the-blank-line: ( -- ) [
  "max-blank-lines" 0 "a: 1 ;\n\n\n\nb: 2 ;\n" (formatted-with)
  "a: 1 ;\nb: 2 ;\n"
  "zero blank lines leaves the statements adjacent" assert=
] ;

test-config-max-blank-lines-two-keeps-both: ( -- ) [
  "max-blank-lines" 2 "a: 1 ;\n\n\n\nb: 2 ;\n" (formatted-with)
  "a: 1 ;\n\n\nb: 2 ;\n"
  "two blank lines survive where the default keeps one" assert=
] ;

test-config-align-comments-off-keeps-the-two-space-gap: ( -- ) [
  ac-src: "a" 0 "one" (commented) "bbbb" 0 "two" (commented) #append ;
  "align-comments" f ac-src (formatted-with)
  ac-src
  "the comments keep the gap the token pass wrote" assert=
] ;

test-config-align-symbols-off-leaves-the-columns-alone: ( -- ) [
  "align-symbols" f "pi: 3.14 ;\ne: 2.71 ;\ntau: 6.28 ;\n" (formatted-with)
  "pi: 3.14 ;\ne: 2.71 ;\ntau: 6.28 ;\n"
  "a run of three definitions is left unaligned" assert=
] ;

test-config-align-min-group-two-aligns-a-pair: ( -- ) [
  "align-min-group" 2 "pi: 3.14 ;\ntau: 6.28 ;\n" (formatted-with)
  "pi:  3.14 ;\ntau: 6.28 ;\n"
  "a minimum of two aligns the pair the default leaves alone" assert=
] ;

test-config-align-min-group-four-leaves-a-triple-alone: ( -- ) [
  "align-min-group" 4 "pi: 3.14 ;\ne: 2.71 ;\ntau: 6.28 ;\n" (formatted-with)
  "pi: 3.14 ;\ne: 2.71 ;\ntau: 6.28 ;\n"
  "a minimum of four leaves the run of three unaligned" assert=
] ;

\ The default joins these three, since their spread equals the shortest name.
\ A limit of zero makes every subgroup a single line, and each falls under the
\ minimum group size.
test-config-align-max-padding-zero-splits-every-name: ( -- ) [
  "align-max-padding" 0 "abc: 1 ;\nabcdefg: 2 ;\nabcd: 3 ;\n" (formatted-with)
  "abc: 1 ;\nabcdefg: 2 ;\nabcd: 3 ;\n"
  "a divergence limit of zero splits a run the default joins" assert=
] ;

test-config-trailing-newline-on-terminates-a-definition: ( -- ) [
  "foo: [ 1 ] ;" format-source "foo: [ 1 ] ;\n"
  "the default terminates a file that had no final newline" assert=
] ;

test-config-trailing-newline-off-after-a-definition: ( -- ) [
  "trailing-newline" f "foo: [ 1 ] ;\n" (formatted-with)
  "foo: [ 1 ] ;"
  "the newline the `;` arm wrote comes back off" assert=
] ;

test-config-trailing-newline-off-without-a-definition: ( -- ) [
  "trailing-newline" f "a b c\n" (formatted-with)
  "a b c"
  "the newline `(fmt-finish)` wrote comes back off" assert=
] ;

test-config-trailing-newline-off-leaves-empty-output-empty: ( -- ) [
  "trailing-newline" f "   \n  \n" (formatted-with)
  ""
  "a whitespace-only file has no newline to take off" assert=
] ;

"config file loading" test-section

test-load-takes-the-keys-the-file-names: ( -- ) [
  "tests/fixtures/fmt/valid.1z" load-fmt-config
  dup indent-size>> 4 "the file's indent-size lands" assert=
  align-symbols>> f "the file's align-symbols lands" assert=
] ;

test-load-defaults-the-keys-the-file-omits: ( -- ) [
  "tests/fixtures/fmt/valid.1z" load-fmt-config
  dup max-blank-lines>> 1 "an omitted number keeps its default" assert=
  align-comments>> t "an omitted flag keeps its default" assert=
] ;

test-load-rejects-an-unknown-key: ( -- ) [
  [ "tests/fixtures/fmt/unknown-key.1z" load-fmt-config ]
  invalid-argument: "a misspelled key is rejected" assert-error-type
] ;

test-load-rejects-a-wrong-typed-number: ( -- ) [
  [ "tests/fixtures/fmt/wrong-type.1z" load-fmt-config ]
  invalid-argument: "a string where a number belongs is rejected" assert-error-type
] ;

test-load-rejects-a-negative-number: ( -- ) [
  [ "tests/fixtures/fmt/negative.1z" load-fmt-config ]
  invalid-argument: "a negative number is rejected" assert-error-type
] ;

test-load-rejects-a-wrong-typed-flag: ( -- ) [
  [ "tests/fixtures/fmt/wrong-boolean.1z" load-fmt-config ]
  invalid-argument: "a number where a flag belongs is rejected" assert-error-type
] ;

\ Caught one layer down, where `>config` wraps: `config` is a virtual over
\ `hash`, so the formatter never sees anything else.
test-load-rejects-a-file-that-is-not-a-hash: ( -- ) [
  [ "tests/fixtures/fmt/not-a-hash.1z" load-fmt-config ]
  "a file evaluating to something other than a hash is rejected" assert-error
] ;

"config file discovery" test-section

test-discovery-climbs-to-the-config: ( -- ) [
  "tests/fixtures/fmt/nested/deeper" fmt-config-for indent-size>> 8
  "a `.fmt.1z` one directory up is found" assert=
] ;

test-discovery-without-a-config-gives-the-defaults: ( -- ) [
  "tests/fixtures/fmt" fmt-config-for default-fmt-config
  "a directory with no `.fmt.1z` above it formats with the defaults" assert=
] ;

test-format-file-applies-the-discovered-config: ( -- ) [
  "tests/fixtures/fmt/nested/deeper/sample.txt" format-file
  "foo: [\n        1\n] ;\n"
  "format-file indents by what the discovered config says" assert=
] ;

"driver" test-section

private{
  (unformatted): ( -- string ) "foo: [\n1\n] ;\n" ;
  (formatted): ( -- string ) "foo: [\n  1\n] ;\n" ;

  (write-file): ( path: string text: string -- ) [
    wf-text: swap ;
    write: stream-open
    dup wf-text stream-write-string drop
    stream-close
  ] ;

  (read-file): ( path: string -- string ) [
    read: stream-open dup stream-read-all swap stream-close bytes>
  ] ;

  \\ Write an unformatted file into dir and answer its path.
  (dirty-file): ( dir: string -- path: string ) [
    "sample.1z" path-join dup (unformatted) (write-file)
  ] ;

  \\ Run `run-fmt` with its stderr captured, so a report lands in the returned
  \\ text rather than in the test output.
  (run-fmt-captured): ( files: array mode: symbol -- result: boolean text: string ) [
    [ run-fmt ] curry curry
    [ [ error-stream ] dip with-parameter ] curry
    using-string-builder
  ] ;
}

test-format-file-bang-rewrites-the-file: ( -- ) [
  [
    (dirty-file)
    dup format-file!
    (read-file) (formatted) "the file on disk holds the formatted text" assert=
  ] using-temp-directory
] ;

test-formatted-answers-before-and-after-the-rewrite: ( -- ) [
  [
    (dirty-file)
    dup formatted? "an unformatted file answers f" assert-false
    dup format-file!
    formatted? "the rewritten file answers t" assert-true
  ] using-temp-directory
] ;

test-run-fmt-in-place-rewrites-and-answers-clean: ( -- ) [
  [
    (dirty-file)
    dup 1array in-place: run-fmt "an in-place run answers t" assert-true
    (read-file) (formatted) "the file was rewritten" assert=
  ] using-temp-directory
] ;

test-run-fmt-check-names-the-unformatted-file: ( -- ) [
  [
    (dirty-file)
    dup 1array check: (run-fmt-captured)
    " needs formatting\n" #ends-with? "the report names the file" assert-true
    "an unformatted file fails the check" assert-false
    drop
  ] using-temp-directory
] ;

test-run-fmt-check-passes-a-formatted-file: ( -- ) [
  [
    (dirty-file)
    dup format-file!
    1array check: (run-fmt-captured)
    "" "a clean run reports nothing" assert=
    "a formatted file passes the check" assert-true
  ] using-temp-directory
] ;

test-run-fmt-reports-an-unreadable-file-and-keeps-going: ( -- ) [
  [
    (dirty-file)
    "absent.1z" swap 2 array-n check: (run-fmt-captured)
    dup "Error formatting" #in? "the unreadable file is named" assert-true
    " needs formatting\n" #ends-with? "the file after it was still checked" assert-true
    "the run fails when one file cannot be read" assert-false
  ] using-temp-directory
] ;

test-run-fmt-rejects-an-unknown-mode: ( -- ) [
  [
    (dirty-file) 1array sideways: (run-fmt-captured)
    "unknown fmt mode sideways" #in? "the mode is named" assert-true
    "an unknown mode fails the run" assert-false
  ] using-temp-directory
] ;
