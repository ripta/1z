\ lib/flags.1z - Declarative CLI flag parsing
\
\ Usage:
\   use flags ;
\   use conversions ;
\
\   help: flag{ description: "Show help" short: "h" } ;
\   number: required positional flag{ type: fixnum description: "Number to check" } ;
\
\   command-line-args "Check if a number is prime." parse-flags
\   "number" @get ...

use "conversions" ;
use "strings" ;
use "sequences" ;

\ Markers
required: make-marker ;
positional: make-marker ;

\ Shared state
flag-registry: ( -- registry: mutable-map ) M{ } ;

\ Monotonic counter assigning each registered flag a definition order. Shared
\ across define-flag calls, so it lives at module scope rather than nested inside
\ define-flag's body where AOT discovery could not see it.
flag-order: ( -- order: mutable-map ) M{ n: 0 } ;

\\ Defines a command-line flag.
flag{: parse-time [
  "}" parse-until make-hash
  M{ type: struct-descriptor: }
  swap fields: swap @set!
  [ define-flag ] define: swap @set!
] ;

\\ Registers the flag in the global registry.
define-flag: ( name fields markers -- ) [
  \ The declared flag type lives under the descriptor's "fields" hash. A symbol
  \ there (the dropped `type: integer:` form) is a loud definition-time error.
  over "fields" @get
  dup "type" @has?
  [ "type" @get symbol?
    [ f "flags: type: requires a TypeValue, not a symbol" EInvalidArgument make-error throw ]
    when
  ]
  [ drop ]
  if

  [ ] make-mutable-map
  swap markers: swap @set!
  swap descriptor: swap @set!

  flag-order "n" @get
  order: swap @set!

  flag-registry -rot> @set! drop

  flag-order "n" @get 1 +
  flag-order swap n: swap @set! drop
] ;

private{
  sym-to-str: ( name: symbol -- string ) [ >string ] ;

  is-positional-flag: ( name: symbol -- ? ) [
    flag-registry swap @get
    "markers" @get
    positional [ = ] curry #filter #count 0 >
  ] ;

  positional-names: ( -- names: array ) [
    flag-registry @keys
    [ is-positional-flag ] #filter #collect
  ] ;

  \\ True when the flag named key declares short as its short alias. The short
  \\ alias lives under the descriptor's fields hash, like every declared field.
  flag-short-matches?: ( key short -- ? ) [
    swap flag-registry swap @get
    "descriptor" @get "fields" @get
    dup "short" @has?
    [ "short" @get = ]
    [ 2drop f ]
    if
  ] ;

  find-flag-by-short: ( short: string -- name/f ) [
    flag-registry @keys swap
    [ flag-short-matches? ] curry #filter #collect
    dup #len 0 =
    [ drop f ]
    [ #first ]
    if
  ] ;

  print-flag-help: ( name: symbol -- ) [
    dup flag-registry swap @get
    dup "markers" @get
    swap "descriptor" @get

    swap positional [ = ] curry #filter #count 0 >
    [
      over sym-to-str
      "  <" swap #append ">" #append
      swap dup "description" @has?
      [ "description" @get "  " swap #append #append ]
      [ drop ]
      if
      nip
    ]
    [
      over sym-to-str
      "  --" swap #append
      over dup "short" @has?
      [
        "short" @get
        ", -" swap #append
        #append
      ]
      [ drop ]
      if
      swap dup "description" @has?
      [ "description" @get "  " swap #append #append ]
      [ drop ]
      if
      nip
    ]
    if

    stderr swap stream-write-string drop
    stderr "\n" >bytes stream-write drop
  ] ;

  print-help: ( description: string -- ) [
    "Usage: " swap #append
    stderr swap stream-write-string drop
    stderr "\n" >bytes stream-write drop

    flag-registry @keys
    [ print-flag-help ] #each
  ] ;

  mth-src: parameter{ [ [ ] make-mutable-map ] } ;
  mth-copy-key: ( hash: hash key -- hash' ) [
    dup mth-src get swap @get
    @set
  ] ;
  mmap-to-hash: ( m: mutable-map -- result: hash ) [
    dup mth-src [
      @keys
      H{ }
      [ mth-copy-key ] #reduce
    ] with-parameter
  ] ;

  process-named-flag: ( name: string -- ) [
    dup flag-registry swap @has?
    [ pf-result get swap t @set! drop ]
    [ drop ]
    if
  ] ;

  \ Store value under name in the result map. @set! is ( map key value -- map ).
  store-value: ( name value -- ) [ pf-result get -rot> @set! drop ] ;

  \\ A flag consumes a following value when it declares a type other than
  \\ boolean. A presence flag has no type; a boolean flag (future) is presence.
  flag-takes-value?: ( name -- ? ) [
    flag-registry swap @get
    "descriptor" @get "fields" @get
    dup "type" @has?
    [ "type" @get boolean = not ]
    [ drop f ]
    if
  ] ;

  \\ Store the =-form value only when the name is a registered flag.
  (store-eq): ( name value -- ) [
    over flag-registry swap @has?
    [ store-value ]
    [ 2drop ]
    if
  ] ;

  \\ Consume the token following idx as name's value and return idx+2. A missing
  \\ token prints help and exits. next is bounds-checked before #nth, which throws
  \\ on an out-of-bounds index. The exit is inlined rather than delegated so the
  \\ terminal sys-exit is visible to the AOT stack-effect checker, which otherwise
  \\ models the branch as returning and reports an underflow against the other
  \\ branch's result.
  consume-value: ( name idx -- idx' ) [
    ++
    dup pf-args get #len >=
    [
      drop
      "Error: flag --" swap #append " requires a value" #append
      stderr swap stream-write-string drop
      stderr "\n" >bytes stream-write drop
      pf-desc get print-help
      1 sys-exit
    ]
    [
      dup pf-args get swap #nth
      swap [ store-value ] dip
      ++
    ]
    if
  ] ;

  \\ A bare --name that is not itself a registered flag. When name is no-<base>
  \\ and <base> is a boolean (presence) flag, set base false. Otherwise the
  \\ unknown flag is ignored, matching prior behavior. An exact flag-name match
  \\ never reaches here, so a flag literally named no-cache wins over stripping.
  process-no-flag: ( name -- ) [
    dup "no-" #starts-with?
    [
      3 over #len #slice
      dup flag-registry swap @has?
      [ dup flag-takes-value? not
        [ pf-result get swap f @set! drop ]
        [ drop ]
        if
      ]
      [ drop ]
      if
    ]
    [ drop ]
    if
  ] ;

  \\ Long flag: --name, --name=value, or --name value (value flag consumes next).
  process-long: ( arg idx -- idx' ) [
    swap 2 over #len #slice
    dup "=" split-once?
    dup option:some?
    [
      nip option:some>
      dup #first swap #last
      (store-eq)
      ++
    ]
    [
      drop
      dup flag-registry swap @has?
      [
        dup flag-takes-value?
        [ swap consume-value ]
        [ process-named-flag ++ ]
        if
      ]
      [ process-no-flag ++ ]
      if
    ]
    if
  ] ;

  \\ Short flag: -o (presence) or -o value (value flag consumes next). No = or
  \\ attached form.
  process-short-arg: ( arg idx -- idx' ) [
    swap 1 over #len #slice
    find-flag-by-short
    dup f =
    [ drop ++ ]
    [
      dup flag-takes-value?
      [ swap consume-value ]
      [ process-named-flag ++ ]
      if
    ]
    if
  ] ;

  process-positional: ( arg: string -- ) [
    positional-names
    pf-pos-state get "idx" @get
    over #len over <=
    [ 2drop drop ]
    [
      swap over #nth
      nip
      pf-result get -rot> swap @set! drop
      pf-pos-state get "idx" @get 1 +
      pf-pos-state get swap idx: swap @set! drop
    ]
    if
  ] ;

  \\ Dispatch one non-terminator argument and return the index to continue from.
  \\ A value flag advances by two, having swallowed the following token.
  process-arg: ( arg idx -- idx' ) [
    over "--" #starts-with?
    [ process-long ]
    [
      over "-" #starts-with?
      [ process-short-arg ]
      [ swap process-positional ++ ]
      if
    ]
    if
  ] ;

  \\ Apply one argument's effect and return the index to continue from. Returning
  \\ the next index (rather than the loop hardcoding idx 1 +) is the seam a value
  \\ flag uses to swallow the following token by returning idx 2 +. When term is
  \\ true the arg is a post-terminator positional and bypasses dash dispatch.
  dispatch-arg: ( arg idx term -- idx' term ) [
    dup
    [ [ swap process-positional ++ ] dip ]
    [ [ process-arg ] dip ]
    if
  ] ;

  \\ Walk args by index, threading (args idx term). A bare "--" while not yet
  \\ terminated is consumed, not stored, and flips term to true; thereafter every
  \\ arg is routed to process-positional through dispatch-arg's terminated branch.
  process-args: stack-recursive ( args idx term -- ) [
    1 pick-n 3 pick-n #len >=
    [
      drop 2drop
    ]
    [
      2 pick-n 2 pick-n #nth
      dup "--" = 2 pick-n not and
      [
        drop drop ++ t
      ]
      [
        -rot> dispatch-arg
      ]
      if
      process-args
    ]
    if
  ] ;

  check-required: ( -- ) [
    flag-registry @keys
    [
      dup flag-registry swap @get
      "markers" @get
      required [ = ] curry #filter #count 0 >
      [
        pf-result get over @has?
        [ drop ]
        [
          "Error: missing required argument: " swap sym-to-str #append
          stderr swap stream-write-string drop
          stderr "\n" >bytes stream-write drop
          pf-desc get print-help
          1 sys-exit
        ]
        if
      ]
      [ drop ]
      if
    ] #each
  ] ;

  \\ Convert a raw flag value to its declared type. A boolean value is only
  \\ string-parsed: a presence-true or a --no- false is already a boolean and
  \\ passes through. Unknown or string types pass through unchanged.
  convert-flag-value: ( value type -- value' ) [
    dup fixnum =
    [ drop parse-integer ]
    [ dup float =
      [ drop parse-float ]
      [ boolean =
        [ dup string? [ parse-boolean ] when ]
        [ ]
        if
      ]
      if
    ]
    if
  ] ;

  \\ Convert value by type, returning option:some(value') or option:none on a bad
  \\ value. recover is the terminal operation in this word and the parsers throw a
  \\ clean stack, so the handler is just [ drop option:none ], matching the prelude
  \\ #nth? / receive? idiom. Keeping recover terminal here also keeps it AOT-safe.
  try-convert-flag-value: ( value type -- opt ) [
    [ convert-flag-value >option:some ] [ drop option:none ] recover
  ] ;

  \\ True when the declared TypeValue is an enum type. descriptor-kind yields the
  \\ enum-descriptor symbol for an enum, and something else for every scalar type.
  enum-type?: ( type -- ? ) [
    native.type-descriptor native.descriptor-kind
    enum-descriptor: =
  ] ;

  \\ Short variant name from a full "enum:variant" symbol: color:red -> "red".
  \\ enum-variants returns fully-qualified symbols; the user types the short name.
  \\ Every enum variant name carries exactly one colon, so the split always hits.
  variant-short-name: ( full: symbol -- short: string ) [
    >string ":" split-once? option:some> #last
  ] ;

  \\ The enum's short variant names, in definition order, as strings.
  enum-short-names: ( type -- names: array ) [
    native.type-name >symbol enum-variants
    [ variant-short-name ] #map #collect
  ] ;

  \\ ", "-joined short names for the out-of-set error listing.
  enum-valid-values: ( type -- string ) [ enum-short-names ", " #join ] ;

  \\ Is the raw string argument a valid short variant name of the enum type? The
  \\ membership check is throw-free, so the enum path avoids the try-convert
  \\ recover idiom, whose clean-stack precondition an enum conversion cannot meet.
  enum-member?: ( value type -- ? ) [ enum-short-names swap #in? ] ;

  \\ Full listing error message for an out-of-set enum argument.
  enum-invalid-message: ( key type value -- string ) [
    "Error: invalid value \"" swap #append "\" for --" #append
    2 pick-n sym-to-str #append
    swap enum-valid-values
    " (valid values: " swap #append ")" #append
    #append nip
  ] ;

  \\ Convert a provided enum flag to its variant, or print the listing error and
  \\ exit. Membership is checked first, so >symbol and enum-from-symbol cannot
  \\ throw. The error branch ends in sys-exit so the AOT checker treats it as
  \\ non-returning, matching the check-required pattern.
  apply-enum-conversion: ( key type value -- ) [
    dup 2 pick-n enum-member?
    [ >symbol swap native.enum-from-symbol store-value ]
    [
      enum-invalid-message
      stderr swap stream-write-string drop
      stderr "\n" >bytes stream-write drop
      1 sys-exit
    ]
    if
  ] ;

  \\ Convert a provided scalar flag through the type parsers, or print a one-line
  \\ error and exit. Same ( key type value -- ) shape as apply-enum-conversion so
  \\ the apply-conversions branches balance. The error branch ends in sys-exit.
  apply-scalar-conversion: ( key type value -- ) [
    over try-convert-flag-value
    dup option:some?
    [ option:some> nip store-value ]
    [
      drop
      over pf-result get swap @get
      "Error: invalid value \"" swap #append "\" for --" #append
      2 pick-n sym-to-str #append
      nip nip
      stderr swap stream-write-string drop
      stderr "\n" >bytes stream-write drop
      1 sys-exit
    ]
    if
  ] ;

  apply-conversions: ( -- ) [
    pf-result get @keys
    [
      dup flag-registry swap @has?
      [
        dup flag-registry swap @get
        "descriptor" @get "fields" @get
        dup "type" @has?
        [
          "type" @get
          over pf-result get swap @get
          over enum-type?
          [ apply-enum-conversion ]
          [ apply-scalar-conversion ]
          if
        ]
        [ 2drop ]
        if
      ]
      [ drop ]
      if
    ] #each
  ] ;

  set-defaults: ( -- ) [
    flag-registry @keys
    [
      dup pf-result get swap @has?
      [ drop ]
      [
        dup flag-registry swap @get
        "markers" @get
        positional [ = ] curry #filter #count 0 >
        [ drop ]
        [ pf-result get swap f @set! drop ]
        if
      ]
      if
    ] #each
  ] ;

  \ Parameter is bound fresh per call rather than a shared map, so positional indexing doesn't
  \ leak across invocations.
  pf-pos-state: parameter{ [ [ ] make-mutable-map idx: 0 @set! ] } ;
  pf-result:    parameter{ [ [ ] make-mutable-map ] } ;
  pf-desc:      parameter{ [ "" ] } ;
  pf-args:      parameter{ [ { } ] } ;
}

\\ Parses command-line arguments according to registered flags.
parse-flags: ( args: array description: string -- result: hash ) [
  swap
  [ ] make-mutable-map

  pf-result [
    swap pf-desc [
      [ ] make-mutable-map idx: 0 @set!
      pf-pos-state [
        dup pf-args [

          dup { "--help" } = over { "-h" } = or
          [
            drop pf-desc get print-help 0 sys-exit
          ] when

          0 f process-args

          check-required
          apply-conversions
          set-defaults

          pf-result get mmap-to-hash

        ] with-parameter
      ] with-parameter
    ] with-parameter
  ] with-parameter
] ;
