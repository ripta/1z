\ lib/tcp.1z - Mid-level TCP words

use "net" ;

server: virtual{ struct{ fd bound-addr } } ;

\ Create a listening TCP server socket.
\ Resolves the address, creates a socket, binds, and starts listening.
listen: ( addr backlog -- server ) [
  swap resolve #first              \ backlog resolved-addr
  dup socket                       \ backlog resolved-addr fd
  dup 2 pick-n bind                \ backlog resolved-addr fd
  -rot>                            \ fd backlog resolved-addr
  [ over swap native.listen ] dip  \ fd resolved-addr
  make-server
] ;

\ Connect to a remote TCP address and return a read-write stream.
connect: ( addr -- stream ) [
  resolve #first
  dup socket
  dup <rot- native.connect
  fd>stream
] ;

\ Accept a connection on a listening server.
\ Returns the client stream and the peer address.
accept: ( server -- stream addr ) [
  unmake-server drop native.accept
  make-addr:tcp
  [ fd>stream ] dip
] ;

\ Close a server's listening socket.
close: ( server -- ) [
  unmake-server drop fd-close
] ;
