\ lib/sqlite.1z - SQLite database via dynamic FFI

use "ffi" ;

\\ Bind sqlite3 functions via dynamic FFI against system libsqlite3.
"sqlite3" lib-open ffi-def{
  (open):       "sqlite3_open" ffi{ cstring out-ptr:sqlite3 -> i32 }
  (close-v2):   "sqlite3_close_v2" ffi{ ptr -> i32 }
  (prepare-v2): "sqlite3_prepare_v2" ffi{ ptr cstring i32 out-ptr:sqlite3-stmt isize -> i32 }
  (finalize):   "sqlite3_finalize" ffi{ ptr -> i32 }
  (step):       "sqlite3_step" ffi{ ptr -> i32 }
  (reset):      "sqlite3_reset" ffi{ ptr -> i32 }
  (exec):       "sqlite3_exec" ffi{ ptr cstring isize isize isize -> i32 }
  (errmsg):     "sqlite3_errmsg" ffi{ ptr -> cstring }
  (column-count):  "sqlite3_column_count" ffi{ ptr -> i32 }
  (column-name):   "sqlite3_column_name" ffi{ ptr i32 -> cstring }
  (column-type):   "sqlite3_column_type" ffi{ ptr i32 -> i32 }
  (column-int64):  "sqlite3_column_int64" ffi{ ptr i32 -> i64 }
  (column-double): "sqlite3_column_double" ffi{ ptr i32 -> f64 }
  (column-text):   "sqlite3_column_text" ffi{ ptr i32 -> cstring }
  (column-blob):   "sqlite3_column_blob" ffi{ ptr i32 -> ptr }
  (column-bytes):  "sqlite3_column_bytes" ffi{ ptr i32 -> i32 }
  (bind-int64):    "sqlite3_bind_int64" ffi{ ptr i32 i64 -> i32 }
  (bind-double):   "sqlite3_bind_double" ffi{ ptr i32 f64 -> i32 }
  (bind-text):     "sqlite3_bind_text" ffi{ ptr i32 cstring i32 isize -> i32 }
  (bind-blob):     "sqlite3_bind_blob" ffi{ ptr i32 ptr i32 isize -> i32 }
  (bind-null):     "sqlite3_bind_null" ffi{ ptr i32 -> i32 }
  (db-handle):     "sqlite3_db_handle" ffi{ ptr -> ptr }
} call "sqlite-raw" swap >module reexport

SQLITE_OK:   ( -- fixnum ) 0 ;
SQLITE_ROW:  ( -- fixnum ) 100 ;
SQLITE_DONE: ( -- fixnum ) 101 ;

\ Handle types

\\ A distinct type for an open SQLite database connection.
db-handle: virtual{ resource } ;

\\ A distinct type for a prepared SQLite statement.
stmt-handle: virtual{ resource } ;

\ Error handling
ESqliteError: ( -- sym ) [ sqlite-error: ] ;

\\ Check that a return code is SQLITE_OK; throw ESqliteError with errmsg otherwise.
(check-ok): ( rc db -- ) [
  over SQLITE_OK = [ 2drop ] [
    (errmsg) ESqliteError make-error throw
  ] if
] ;

\\ Check return code using the parent db handle extracted from a prepared statement.
(check-ok-stmt): ( rc stmt -- ) [ (db-handle) (check-ok) ] ;

\ Resource management

\\ Open a SQLite database, returning a db-handle. Throws ESqliteError on failure.
open: ( path -- db-handle ) [
  (open)
  \ Stack: resource rc
  dup SQLITE_OK = [ drop ] [
    \ sqlite3_open allocates a handle even on error; close it before throwing
    swap dup (errmsg) swap resource-close
    ESqliteError make-error throw
  ] if
  >db-handle
] ;

\\ Close a database handle opened with `open`.
close-db: ( db-handle -- ) [ unmake-db-handle resource-close ] ;

\\ Open a database for the duration of a quotation, closing it on exit.
using-db: ( ..a path: string quot: ( ..a db: db-handle -- ..b ) -- ..b ) [ [ open ] dip over [ close-db ] curry cleanup ] ;

\\ Deprecated alias of `using-db`.
with-db: deprecated ( ..a path: string quot: ( ..a db: db-handle -- ..b ) -- ..b ) [ using-db ] ;

\\ Prepare a statement for the duration of a quotation, finalizing it on exit.
using-stmt: ( ..a db: db-handle sql: string quot: ( ..a stmt: stmt-handle -- ..b ) -- ..b ) [
  [ [ unmake-db-handle ] dip -1 0 (prepare-v2) over (check-ok-stmt) >stmt-handle ] dip
  over [ unmake-stmt-handle resource-close ] curry cleanup
] ;

\\ Deprecated alias of `using-stmt`.
with-stmt: deprecated ( ..a db: db-handle sql: string quot: ( ..a stmt: stmt-handle -- ..b ) -- ..b ) [ using-stmt ] ;

\ Polymorphic parameter binding

\\ Bind a value to a prepared statement parameter by index (1-based).
\\ Dispatches on the value's type: fixnum, float, string, byte-array, or option:none.
bind: ( stmt i value -- ) [ [ unmake-stmt-handle ] 2dip (bind) ] ;

\\ Bind against the unwrapped raw statement resource.
(bind): ( stmt i value -- ) [
  2 pick-n
  -rot> (bind-dispatch) swap (check-ok-stmt)
] ;

\\ Dispatch the appropriate bind call based on value type. Returns rc.
(bind-dispatch): ( stmt i value -- rc ) [
  dup option:none? [
    drop (bind-null)
  ] [
    dup type-name {
      { "fixnum" [ (bind-int64) ] }
      { "float" [ (bind-double) ] }
      { "string" [ -1 -1 (bind-text) ] }
      { "byte-array" [ dup [ bytes>ffi-ptr+len -1 (bind-blob) ] dip drop ] }
      [ "fixnum, float, string, byte-array, or option:none" throw-type-error ]
    } case
  ] if
] ;

\ Column reading

\\ Read a single column value from the current row, dispatching on column type.
(read-column): ( stmt i -- value ) [
  2dup (column-type) {
    { 1 [ (column-int64) ] }
    { 2 [ (column-double) ] }
    { 3 [ (column-text) ] }
    { 4 [ 2dup (column-bytes) -rot> (column-blob) swap ffi-ptr+len>bytes ] }
    { 5 [ 2drop option:none ] }
    [ 2dup (column-type) >string "unexpected sqlite column type: " swap #append ESqliteError make-error throw ]
  } case
] ;

\\ Read the current row as a hash keyed by column name. NULL columns are omitted.
(read-row-hash): ( stmt -- hash ) [
  dup (column-count) 0 H{ } (read-hash-loop)
] ;

(read-hash-loop): ( stmt count i hash -- hash ) [
  over 3 pick-n < [
    3 pick-n 2 pick-n (read-hash-col)
    swap ++ swap (read-hash-loop)
  ] [
    3nip
  ] if
] ;

\\ Read one column into a hash, skipping NULLs.
(read-hash-col): ( hash stmt i -- hash ) [
  2dup (column-type) 5 = [
    2drop
  ] [
    2dup (column-name) -rot> (read-column)
    @set
  ] if
] ;

\\ Read the current row as an array. NULL columns become option:none, others option:some.
(read-row-array): ( stmt -- array ) [
  dup (column-count) 0 { } (read-array-loop)
] ;

(read-array-loop): ( stmt count i array -- array ) [
  over 3 pick-n < [
    3 pick-n 2 pick-n (read-array-col)
    swap ++ swap (read-array-loop)
  ] [
    3nip
  ] if
] ;

\\ Read one column into an array.
(read-array-col): ( array stmt i -- array ) [
  (read-column)
  dup option:none? [ ] [ >option:some ] if
  1array #append
] ;

\ Step words

\\ Step a prepared statement and return the current row as an option hash.
\\ Returns option:some with a hash on SQLITE_ROW, option:none on SQLITE_DONE.
step-hash: ( stmt -- option ) [
  unmake-stmt-handle
  dup (step) dup SQLITE_ROW = [
    drop (read-row-hash) >option:some
  ] [
    dup SQLITE_DONE = [
      2drop option:none
    ] [
      swap (check-ok-stmt)
    ] if
  ] if
] ;

\\ Step a prepared statement and return the current row as an option array.
\\ Returns option:some with an array on SQLITE_ROW, option:none on SQLITE_DONE.
step-array: ( stmt -- option ) [
  unmake-stmt-handle
  dup (step) dup SQLITE_ROW = [
    drop (read-row-array) >option:some
  ] [
    dup SQLITE_DONE = [
      2drop option:none
    ] [
      swap (check-ok-stmt)
    ] if
  ] if
] ;

\ Batch execution

\\ Bind an array of parameters to a prepared statement with 1-based indexing.
(bind-params): ( stmt params -- ) [
  dup #len 1 swap (bind-loop) 2drop
] ;

\\ i goes from 1 to limit (inclusive). Binds params[i-1] at 1-based index i.
(bind-loop): ( stmt params i limit -- stmt params ) [
  2dup > [
    2drop
  ] [
    over 3 pick-n over -- #nth
    5 pick-n -rot> (bind)
    swap ++ swap (bind-loop)
  ] if
] ;

\\ Execute a SQL statement with parameters, discarding all results.
\\ Use for INSERT, UPDATE, DELETE, and DDL statements.
execute: ( db sql params -- ) [
  [ [ unmake-stmt-handle ] dip over swap (bind-params) (step-until-done) ] curry
  using-stmt
] ;

\\ Step until SQLITE_DONE, discarding all rows.
(step-until-done): ( stmt -- ) [
  dup (step) dup SQLITE_DONE = [
    2drop
  ] [
    dup SQLITE_ROW = [
      drop (step-until-done)
    ] [
      swap (check-ok-stmt)
    ] if
  ] if
] ;

\ Lazy row iterators

\\ Query returning a lazy iterator of hash rows. Prepares and binds the statement,
\\ then returns a callback iterator that steps through results and finalizes on cleanup.
query-hash: ( db sql params -- iterator ) [
  (query-prepare-bind) >stmt-handle
  dup [ step-hash ] curry
  swap [ unmake-stmt-handle resource-close ] curry
  >iterator(with-cleanup)
] ;

\\ Query returning a lazy iterator of array rows. Same lifecycle as query-hash
\\ but each row is an array of option values.
query-array: ( db sql params -- iterator ) [
  (query-prepare-bind) >stmt-handle
  dup [ step-array ] curry
  swap [ unmake-stmt-handle resource-close ] curry
  >iterator(with-cleanup)
] ;

\\ Shared helper: prepare a statement and bind parameters, returning the statement.
(query-prepare-bind): ( db sql params -- stmt ) [
  [ [ unmake-db-handle ] dip -1 0 (prepare-v2) over (check-ok-stmt) ] dip
  over swap (bind-params)
] ;

\ Transaction support

\\ Execute a quotation inside a transaction. Commits on success, rolls back on error.
\\ The quotation receives db on the stack.
using-transaction: ( ..a db: db-handle quot: ( ..a db: db-handle -- ..b ) -- ..b ) [
  over unmake-db-handle dup "BEGIN" 0 0 0 (exec) swap (check-ok)
  over [ unmake-db-handle dup "COMMIT" 0 0 0 (exec) swap (check-ok) ] curry
  compose
  over [ unmake-db-handle dup "ROLLBACK" 0 0 0 (exec) swap (check-ok) throw ] curry
  recover
] ;

\\ Deprecated alias of `using-transaction`.
with-transaction: deprecated ( ..a db: db-handle quot: ( ..a db: db-handle -- ..b ) -- ..b ) [ using-transaction ] ;
