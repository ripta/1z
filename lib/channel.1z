\ lib/channel.1z - Channel combinators for use within task-scope

use "task" ;

\\ Receive values until the channel closes, calling `quot ( value -- )` on each one. Blocks while
\\ the channel is open and empty.
channel-each: ( ch quot -- ) [
  over receive?
  dup option:some? [
    unwrap-or-throw
    over call
    channel-each
  ] [
    3drop
  ] if
] ;

\\ Receive values until the channel closes, and return them in arrival order. Blocks until the
\\ channel is closed.
channel>array: ( ch -- array ) [

  c>a-loop: ( arr ch -- arr ) [
    dup receive?
    dup option:some? [
      unwrap-or-throw
      swap [ #push ] dip
      c>a-loop
    ] [
      2drop
    ] if
  ] ;

  { } swap c>a-loop
] ;

\\ Create an unbuffered channel and spawn a task that runs `channel-each` with the quotation over
\\ it. Closing the channel ends the task. Must be called inside a `task-scope`.
\\
\\   [ [ 2 * . ] spawn-server 5 over send close-channel await drop ] task-scope
\\   => 10
spawn-server: ( quot -- task ch ) [
  <channel>
  swap
  [ channel-each ] curry
  over swap curry
  spawn swap
] ;

\\ Spawn a task that sends `quot ( value -- value' )` of each value received from in-ch to a new
\\ unbuffered channel. The new channel closes when in-ch does. Must be called inside a
\\ `task-scope`.
\\
\\   [
\\     2 <buffered-channel> 1 over send 2 over send dup close-channel
\\     [ 10 * ] pipeline channel>array .
\\   ] task-scope
\\   => { 10 20 }
pipeline: ( in-ch quot -- out-ch ) [
  <channel>
  [
    [ send ] curry compose
    [ channel-each ] curry
    curry
  ] keep
  swap over [ close-channel ] curry
  compose spawn drop
] ;

\\ Spawn n tasks that each run `channel-each` with the quotation over the same channel, so each
\\ value goes to whichever task receives it first. Returns the task handles. Must be called inside
\\ a `task-scope`.
\\
\\   [
\\     2 <buffered-channel> 1 over send 2 over send dup close-channel
\\     [ drop ] 3 fan-out #len .
\\   ] task-scope
\\   => 3
fan-out: ( ch quot n -- array ) [
  [ [ channel-each ] curry curry ] dip
  spawn-n
] ;

pragma{ lint-suppress: { dead-definition: missing-type-annotation: } }
