\ lib/highlight.1z - Syntax highlighting for 1z source code
\
\ Tokenizes source code and produces styled output in ANSI
\ terminal escape codes or HTML spans. Uses the 1z-tokens
\ tokenizer to produce a token stream, maps tokens to
\ highlight categories, and applies styling from a
\ configurable theme.
\
\ Usage:
\   use "highlight" ;
\   "foo: [ 1 + ] ;" highlight-ansi print-line
\   "foo: [ 1 + ] ;" highlight-html print-line

use "scanner" ;
use "lexer" ;
use "1z-tokens" ;
use "strings" ;
use "conversions" ;
use "config" ;

\ --- ANSI escape helpers ---

(esc): ( -- str ) [ 27 >char ] ;
(ansi-reset): ( -- str ) [ (esc) "[0m" #append ] ;
(ansi-sgr): ( code-str -- escape-str ) [ (esc) "[" #append swap #append "m" #append ] ;

\ --- HTML escape helpers ---

(html-escape-char): ( char -- str ) [
  dup "&" = [ drop "&amp;" ] [
    dup "<" = [ drop "&lt;" ] [
      dup ">" = [ drop "&gt;" ] [
      ] if
    ] if
  ] if
] ;

(html-escape): ( str -- str ) [
  >iterator [ (html-escape-char) ] #map #collect "" #join
] ;

\ --- Word category lookup hashes ---
\ Token values are strings; convert to symbols with >symbol before @has?.

(parse-time-words): const [
  H{ if: t when: t unless: t use: t reexport: t const: t load: t }
] ;

(flow-words): const [
  H{ cond: t case: t loop: t times: t while: t }
] ;

(error-words): const [
  H{ recover: t try: t throw: t with-cleanup: t ignore-errors: t }
] ;

(iteration-words): const [
  H{ each: t map: t filter: t reduce: t call: t }
] ;

(combinator-words): const [
  H{ dip: t keep: t bi: t tri: t curry: t compose: t }
] ;

\ --- Word sub-classification ---

(classify-word): ( token -- category-sym ) [
  value>> >symbol
  dup (parse-time-words) swap @has? [ drop parse-time: ] [
    dup (flow-words) swap @has? [ drop flow: ] [
      dup (error-words) swap @has? [ drop error: ] [
        dup (iteration-words) swap @has? [ drop iteration: ] [
          dup (combinator-words) swap @has? [ drop combinator: ] [
            drop default:
          ] if
        ] if
      ] if
    ] if
  ] if
] ;

\ --- Token-to-category mapping ---

(token>category): ( token -- category-sym ) [
  dup kind>>
  dup comment: = [ 2drop comment: ] [
    dup doc-comment: = [ 2drop doc-comment: ] [
      dup string: = [ 2drop string: ] [
        dup number: = [ 2drop number: ] [
          dup open-bracket: = [ 2drop bracket: ] [
            dup close-bracket: = [ 2drop bracket: ] [
              dup stack-effect: = [ 2drop stack-effect: ] [
                dup semicolon: = [ 2drop punctuation: ] [
                  dup open-brace: = [ 2drop parse-time: ] [
                    dup symbol: = [ 2drop definition: ] [
                      dup word: = [ drop (classify-word) ] [
                        \ whitespace:, newline:, close-brace:
                        2drop default:
                      ] if
                    ] if
                  ] if
                ] if
              ] if
            ] if
          ] if
        ] if
      ] if
    ] if
  ] if
] ;

\ --- Theme definitions ---
\ Themes map category symbols to ANSI SGR code strings.
\ Uses standard 16-color codes for maximum terminal compatibility.

(ansi-theme-light): const [
  H{
    parse-time: "1;35"
    flow:      "35"
    error:     "1;31"
    iteration: "36"
    combinator:   "33"
    definition:   "1;34"
    comment:      "37"
    doc-comment:  "3;37"
    string:       "32"
    number:       "34"
    bracket:      "1"
    stack-effect: "37"
    punctuation:  "37"
  }
] ;

(ansi-theme-dark): const [
  H{
    parse-time: "1;35"
    flow:      "35"
    error:     "1;31"
    iteration: "36"
    combinator:   "33"
    definition:   "1;34"
    comment:      "90"
    doc-comment:  "3;90"
    string:       "32"
    number:       "34"
    bracket:      "1"
    stack-effect: "90"
    punctuation:  "90"
  }
] ;

\ --- HTML theme ---
\ Theme maps category symbols to CSS class name strings.

(html-theme-default): const [
  H{
    parse-time: "token-parse-time"
    flow:      "token-flow"
    error:     "token-error"
    iteration: "token-iteration"
    combinator:   "token-combinator"
    definition:   "token-definition"
    comment:      "token-comment"
    doc-comment:  "token-doc-comment"
    string:       "token-string"
    number:       "token-number"
    bracket:      "token-bracket"
    stack-effect: "token-stack-effect"
    punctuation:  "token-punctuation"
  }
] ;

\ --- ANSI rendering ---

(apply-theme): ( token category theme -- str ) [
  2dup swap @has? [
    \ token category theme -- category found
    swap @get (ansi-sgr)
    \ token sgr-str
    swap value>> #append
    (ansi-reset) #append
  ] [
    \ token category theme -- category not found
    drop drop value>>
  ] if
] ;

(token>ansi): ( token theme -- str ) [
  [ dup (token>category) ] dip
  \ token category theme
  (apply-theme)
] ;

(highlight-ansi-with): ( source-string theme -- styled-string ) [
  swap 1z-tokenize
  swap [ (token>ansi) ] curry
  #map #collect "" #join
] ;

\ --- HTML rendering ---

(apply-html-theme): ( token category theme -- str ) [
  2dup swap @has? [
    swap @get
    \ token class-name
    "<span class=\"" swap #append "\">" #append
    swap value>> (html-escape) #append
    "</span>" #append
  ] [
    drop drop value>> (html-escape)
  ] if
] ;

(token>html): ( token theme -- str ) [
  [ dup (token>category) ] dip
  (apply-html-theme)
] ;

(highlight-html-with): ( source-string theme -- html-string ) [
  swap 1z-tokenize
  swap [ (token>html) ] curry
  #map #collect "" #join
] ;

\ --- Public API ---

\\ Return the default ANSI light color theme hash.
default-ansi-theme-light: ( -- theme ) [ (ansi-theme-light) ] ;

\\ Return the default ANSI dark color theme hash.
default-ansi-theme-dark: ( -- theme ) [ (ansi-theme-dark) ] ;

\\ Highlight 1z source code with ANSI terminal colors using the default light theme.
highlight-ansi: ( source-string -- styled-string ) [
  (ansi-theme-light) (highlight-ansi-with)
] ;

\\ Highlight 1z source code with ANSI terminal colors using a custom theme.
highlight-ansi-themed: ( source-string theme -- styled-string ) [
  (highlight-ansi-with)
] ;

\\ Return the default HTML theme hash (category symbols to CSS class names).
default-html-theme: ( -- theme ) [ (html-theme-default) ] ;

\\ Highlight 1z source code as HTML spans using the default theme.
highlight-html: ( source-string -- html-string ) [
  (html-theme-default) (highlight-html-with)
] ;

\\ Highlight 1z source code as HTML spans using a custom theme.
highlight-html-themed: ( source-string theme -- html-string ) [
  (highlight-html-with)
] ;

\\ Load a highlight theme from a data-only config file.
\\
\\ The file must contain a single hash mapping category symbols to style
\\ values (ANSI SGR codes for ANSI themes, CSS class names for HTML themes).
\\ The returned hash can be passed to highlight-ansi-themed or
\\ highlight-html-themed.
load-highlight-theme: ( path -- theme ) [
  load-config-data config-unwrap
] ;
