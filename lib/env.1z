\ lib/env.1z - Shortcut words for common environment variables

\ 1z environment variables
$ONEZ_MAX_MEMORY: ( -- str ) [ environ "ONEZ_MAX_MEMORY" @get ] ;
$ONEZ_LOAD_PATH: ( -- str ) [ environ "ONEZ_LOAD_PATH" @get ] ;
$ONEZ_STDLIB: ( -- str ) [ environ "ONEZ_STDLIB" @get ] ;

\ Common environment variables
$HOME: ( -- str ) [ environ "HOME" @get ] ;
$PATH: ( -- str ) [ environ "PATH" @get ] ;
$USER: ( -- str ) [ environ "USER" @get ] ;
$SHELL: ( -- str ) [ environ "SHELL" @get ] ;
$EDITOR: ( -- str ) [ environ "EDITOR" @get ] ;
$TMPDIR: ( -- str ) [ environ "TMPDIR" @get ] ;
