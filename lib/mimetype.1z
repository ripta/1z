\ lib/mimetype.1z - MIME type lookup by file extension

\\ Look up the MIME content type for a file extension.
\\ The extension must include the leading dot (matching path.extension output).
\\ Returns "application/octet-stream" for unknown or empty extensions.
for-extension: ( ext -- content-type ) [
  H{
    ".html" "text/html; charset=utf-8"
    ".htm" "text/html; charset=utf-8"
    ".css" "text/css; charset=utf-8"
    ".js" "application/javascript; charset=utf-8"
    ".json" "application/json; charset=utf-8"
    ".txt" "text/plain; charset=utf-8"
    ".xml" "application/xml; charset=utf-8"
    ".png" "image/png"
    ".jpg" "image/jpeg"
    ".jpeg" "image/jpeg"
    ".gif" "image/gif"
    ".svg" "image/svg+xml"
    ".ico" "image/x-icon"
    ".woff" "font/woff"
    ".woff2" "font/woff2"
    ".pdf" "application/pdf"
  }
  swap "application/octet-stream" @get-or
] ;
