\ Unit tests for lib/graph.1z.
\
\ The mutation and lookup surface is public, so the groups below reach the structure
\ through it rather than through the adjacency machinery the runner borrows in. The
\ runner executes test words in alphabetical order, so each group's section banner sits
\ on its alphabetically first word.

use "graph" ;
use { <range>: } "ranges" ;
use "testing" ;

\ --- Helpers ---

\ A triangle over 1, 2, 3, whichever kind the constructor built.
triangle: ( g -- g ) [ 1 2 graph-add-edge 2 3 graph-add-edge 3 1 graph-add-edge ] ;

\ A star of n leaves around 0.
star: ( g n -- g ) [ 1 swap 1 + <range> [ 0 swap graph-add-edge ] #each ] ;

\ n parallel edges between 0 and 1, which is the cheapest way to grow one adjacency
\ list: every insert lands in a two-key map.
parallel-bundle: ( g n -- g ) [ 0 swap <range> [ drop 0 1 graph-add-edge ] #each ] ;

\ A path 0-1-2-...-n.
path: ( g n -- g ) [ 1 swap 1 + <range> [ dup 1 - swap graph-add-edge ] #each ] ;

\ A ring 0-1-...-n-0.
ring: ( g n -- g ) [ dup [ path ] dip 0 graph-add-edge ] ;

\ A path 1-2-3-4 with 1 and 4 also joined, so a depth-first walk down the 4 end reaches 2
\ at depth 3 where a breadth-first one reaches it at depth 1.
loop4: ( g -- g ) [ 1 2 graph-add-edge 2 3 graph-add-edge 3 4 graph-add-edge 1 4 graph-add-edge ] ;

\ A fork: 1 joined to 2 and 3, with 3 carrying a further 4.
fork: ( g -- g ) [ 1 2 graph-add-edge 1 3 graph-add-edge 3 4 graph-add-edge ] ;

\ --- Add edge ---

test-add-edge-creates-endpoints: ( -- ) [
  "add edge" test-section
  [ cmp ] <graph> 1 2 graph-add-edge
  dup 1 graph-has-vertex? "the source is created" assert-true
  2 graph-has-vertex? "the target is created" assert-true
  [ cmp ] <digraph> 1 2 graph-add-edge
  2 graph-has-vertex? "a digraph creates its target too" assert-true
] ;

test-add-edge-payload-default: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge 1 2 graph-edge-get payload>> f
  "the payload-less form stores f" assert=
  [ cmp ] <graph> 1 2 weight: graph-add-edge-with-payload 1 2 graph-edge-get payload>> weight:
  "the payload-bearing twin stores what it is given" assert=
] ;

test-add-edge-undirected-both-ends: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge
  dup 1 2 graph-has-edge? "the edge is visible from the source" assert-true
  dup 2 1 graph-has-edge? "and from the target" assert-true
  graph-edge-count 1 "but it counts once" assert=
] ;

\ --- Add vertex ---

test-add-vertex-idempotent: ( -- ) [
  "add vertex" test-section
  [ cmp ] <graph> 1 graph-add-vertex 1 graph-add-vertex graph-vertex-count 1
  "a repeated add adds nothing" assert=
] ;

test-add-vertex-isolated: ( -- ) [
  [ cmp ] <graph> 1 graph-add-vertex
  dup 1 graph-has-vertex? "an isolated vertex exists" assert-true
  dup 1 graph-neighbors #len 0 "with no edges" assert=
  graph-edge-count 0 "and no edge count" assert=
] ;

test-add-vertex-keeps-edges: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge 1 graph-add-vertex
  dup 1 graph-neighbors #len 1 "a re-added vertex keeps its edges" assert=
  graph-edge-count 1 "and the count is untouched" assert=
] ;

\ --- Breadth-first search ---

test-bfs-alias-agrees: ( -- ) [
  "breadth-first search" test-section
  [ cmp ] <graph> fork
  dup 1 graph-bfs order>> swap 1 graph-breadth-first order>>
  "graph-bfs agrees with the canonical word" assert=
] ;

test-bfs-digraph-out-edges: ( -- ) [
  [ cmp ] <digraph> 1 2 graph-add-edge 3 2 graph-add-edge 1 graph-breadth-first
  dup order>> { 1 2 } "a digraph is followed along its out-edges only" assert=
  3 graph-traversal-distance? option:none? "the in-edge's source is not reached" assert-true
] ;

test-bfs-distances-and-order: ( -- ) [
  [ cmp ] <graph> 4 path 0 graph-breadth-first
  dup order>> { 0 1 2 3 4 } "a path is walked end to end" assert=
  dup 0 graph-traversal-distance? option:some> 0 "the source is at distance zero" assert=
  4 graph-traversal-distance? option:some> 4 "and the far end at the path length" assert=
] ;

test-bfs-level-order: ( -- ) [
  [ cmp ] <graph> fork 1 graph-breadth-first
  dup order>> { 1 3 2 4 } "the whole level comes before the next one" assert=
  dup 2 graph-traversal-distance? option:some> 1 "both of the source's neighbors are one away" assert=
  4 graph-traversal-distance? option:some> 2 "and the vertex behind one of them is two" assert=
] ;

test-bfs-parents: ( -- ) [
  [ cmp ] <graph> fork 1 graph-breadth-first
  dup 4 graph-traversal-parent? option:some> 3 "a vertex names the one it was reached from" assert=
  3 graph-traversal-parent? option:some> 1 "and the chain leads back to the source" assert=
] ;

test-bfs-source-has-no-parent: ( -- ) [
  [ cmp ] <graph> fork 1 graph-breadth-first
  1 graph-traversal-parent? option:none? "the source was reached from nowhere" assert-true
] ;

test-bfs-unknown-source: ( -- ) [
  [ [ cmp ] <graph> 1 graph-add-vertex 9 graph-breadth-first ] key-not-found:
  "a source the graph does not have throws" assert-error-type
] ;

test-bfs-unreached-absent: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge 8 9 graph-add-edge 1 graph-breadth-first
  dup order>> { 1 2 } "only the source's own component is walked" assert=
  dup 9 graph-traversal-distance? option:none? "an unreached vertex has no distance" assert-true
  9 graph-traversal-parent? option:none? "and no parent" assert-true
] ;

\ --- Connected components ---

test-components-digraph-weak: ( -- ) [
  "connected components" test-section
  [ cmp ] <digraph> 1 2 graph-add-edge 3 2 graph-add-edge 9 graph-add-vertex
  graph-connected-components { { 1 2 3 } { 9 } }
  "a digraph yields the components of the underlying undirected graph" assert=
] ;

test-components-empty: ( -- ) [
  [ cmp ] <graph> graph-connected-components { } "an empty graph has no components" assert=
] ;

test-components-isolated: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge 5 graph-add-vertex graph-connected-components
  { { 1 2 } { 5 } } "an isolated vertex is a component of its own" assert=
] ;

test-components-ordering: ( -- ) [
  [ cmp ] <graph> 7 8 graph-add-edge 2 5 graph-add-edge 5 3 graph-add-edge
  graph-connected-components { { 2 3 5 } { 7 8 } }
  "components come ordered by smallest member, members ascending" assert=
] ;

test-components-single: ( -- ) [
  [ cmp ] <graph> triangle graph-connected-components { { 1 2 3 } }
  "a connected graph is one component" assert=
] ;

\ --- Constructors ---

test-construct-digraph-flag: ( -- ) [
  "constructors" test-section
  [ cmp ] <digraph> graph-directed? "a digraph is directed" assert-true
] ;

test-construct-empty: ( -- ) [
  [ cmp ] <graph>
  dup graph-empty? "a fresh graph is empty" assert-true
  dup graph-vertex-count 0 "with no vertices" assert=
  graph-edge-count 0 "and no edges" assert=
] ;

test-construct-graph-flag: ( -- ) [
  [ cmp ] <graph> graph-directed? "an undirected graph is not directed" assert-false
] ;

test-construct-same-type: ( -- ) [
  [ cmp ] <graph> graph? "the undirected constructor yields a graph" assert-true
  [ cmp ] <digraph> graph? "the directed constructor yields the same type" assert-true
] ;

\ --- Contents ---

test-contents-edge-type: ( -- ) [
  "contents" test-section
  [ cmp ] <graph> 1 2 graph-add-edge
  dup graph-edges #first graph-edge? "graph-edges yields edge records" assert-true
  2 graph-neighbors #first graph-edge? "and so does graph-neighbors" assert-true
] ;

test-contents-edges-deduped: ( -- ) [
  [ cmp ] <graph> triangle graph-edges #len 3
  "each undirected edge is emitted once" assert=
  [ cmp ] <digraph> triangle graph-edges #len 3
  "a digraph emits every stored entry" assert=
] ;

test-contents-edges-forward: ( -- ) [
  [ cmp ] <graph> 2 1 graph-add-edge graph-edges #first
  dup source>> 1 "the emitted end is the one sorting first" assert=
  target>> 2 "with the other as its target" assert=
] ;

test-contents-neighbors-source: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge 2 graph-neighbors #first
  dup source>> 2 "an entry's source is the vertex it is stored under" assert=
  target>> 1 "and its target the other end" assert=
] ;

test-contents-vertices-ascending: ( -- ) [
  [ cmp ] <graph> 3 graph-add-vertex 1 graph-add-vertex 2 graph-add-vertex
  graph-vertices { 1 2 3 } "vertices come ascending under the comparator" assert=
] ;

test-contents-vertex-domains: ( -- ) [
  [ cmp ] <graph> 7 graph-add-vertex 7 graph-has-vertex?
  "a fixnum vertex is stored" assert-true
  [ cmp ] <graph> "a" graph-add-vertex "a" graph-has-vertex?
  "a string vertex is stored" assert-true
  [ [ >string ] dip >string cmp ] <graph> left: graph-add-vertex left: graph-has-vertex?
  "a symbol vertex is stored" assert-true
] ;

\ --- Counts ---

test-counts-edge-count-parallel: ( -- ) [
  "counts" test-section
  [ cmp ] <graph> 1 2 graph-add-edge 1 2 graph-add-edge graph-edge-count 2
  "a repeated add counts again" assert=
] ;

test-counts-empty-is-vertices: ( -- ) [
  [ cmp ] <graph> 1 graph-add-vertex graph-empty?
  "a graph with an isolated vertex is not empty" assert-false
] ;

test-counts-vertex-count: ( -- ) [
  [ cmp ] <graph> triangle
  dup graph-vertex-count 3 "the triangle has three vertices" assert=
  graph-edge-count 3 "and three edges" assert=
] ;

\ --- Depth-first search ---

test-dfs-alias-agrees: ( -- ) [
  "depth-first search" test-section
  [ cmp ] <graph> fork
  dup 1 graph-dfs order>> swap 1 graph-depth-first order>>
  "graph-dfs agrees with the canonical word" assert=
] ;

test-dfs-depth-is-tree-depth: ( -- ) [
  [ cmp ] <graph> loop4
  dup 1 graph-depth-first 2 graph-traversal-distance? option:some> 3
  "a vertex reached down a long branch records that branch's depth" assert=
  1 graph-breadth-first 2 graph-traversal-distance? option:some> 1
  "where a breadth-first walk reaches it by the short way" assert=
] ;

test-dfs-goes-deep-first: ( -- ) [
  [ cmp ] <graph> fork
  dup 1 graph-depth-first order>> { 1 3 4 2 }
  "a branch is finished before the next one starts" assert=
  1 graph-breadth-first order>> { 1 3 2 4 }
  "where a breadth-first walk takes the level first" assert=
] ;

test-dfs-neighbor-order: ( -- ) [
  [ cmp ] <graph> fork
  dup 1 graph-neighbors [ target>> ] #map #collect { 3 2 }
  "the stored neighbors lead with the newest" assert=
  1 graph-depth-first order>> { 1 3 4 2 } "and the walk follows that order" assert=
] ;

test-dfs-parents: ( -- ) [
  [ cmp ] <graph> fork 1 graph-depth-first
  dup 4 graph-traversal-parent? option:some> 3 "a vertex names the one it was reached from" assert=
  1 graph-traversal-parent? option:none? "and the source was reached from nowhere" assert-true
] ;

test-dfs-unknown-source: ( -- ) [
  [ [ cmp ] <graph> 1 graph-add-vertex 9 graph-depth-first ] key-not-found:
  "a source the graph does not have throws" assert-error-type
] ;

\ --- Digraph ---

test-digraph-edges-one-way: ( -- ) [
  "digraph" test-section
  [ cmp ] <digraph> 1 2 graph-add-edge
  dup 1 2 graph-has-edge? "the edge runs from source to target" assert-true
  dup 2 1 graph-has-edge? "and not back" assert-false
  dup 2 graph-neighbors #len 0 "the target has no out-edges" assert=
  graph-edge-count 1 "one edge" assert=
] ;

test-digraph-remove-vertex-clears-in-edges: ( -- ) [
  [ cmp ] <digraph> 1 2 graph-add-edge 3 2 graph-add-edge 2 graph-remove-vertex
  dup graph-edge-count 0 "in-edges go with the vertex" assert=
  dup 1 graph-neighbors #len 0 "the first source lost its edge" assert=
  dup 3 graph-neighbors #len 0 "and so did the second" assert=
  graph-vertex-count 2 "the sources remain" assert=
] ;

test-digraph-remove-vertex-counts-both-ways: ( -- ) [
  [ cmp ] <digraph> 1 2 graph-add-edge 2 3 graph-add-edge 2 graph-remove-vertex
  graph-edge-count 0 "an out-edge and an in-edge both leave the count" assert=
] ;

\ --- Edge record ---

test-edge-record-fields: ( -- ) [
  "edge record" test-section
  1 2 weight: make-graph-edge
  dup source>> 1 "the record keeps its source" assert=
  dup target>> 2 "the record keeps its target" assert=
  payload>> weight: "the record keeps its payload" assert=
] ;

test-edge-record-predicate: ( -- ) [
  1 2 f make-graph-edge graph-edge? "an edge record satisfies graph-edge?" assert-true
  5 graph-edge? "a bare value does not" assert-false
] ;

\ --- Errors ---

test-errors-edge-get-missing: ( -- ) [
  "errors" test-section
  [ [ cmp ] <graph> 1 2 graph-edge-get ] key-not-found:
  "edge-get on an unknown vertex throws" assert-error-type
  [ [ cmp ] <graph> 1 graph-add-vertex 2 graph-add-vertex 1 2 graph-edge-get ] key-not-found:
  "edge-get on a pair with no edge throws" assert-error-type
] ;

test-errors-has-edge-is-quiet: ( -- ) [
  [ cmp ] <graph> 1 2 graph-has-edge?
  "has-edge? on an unknown vertex answers f" assert-false
] ;

test-errors-neighbors-unknown: ( -- ) [
  [ [ cmp ] <graph> 1 graph-neighbors ] key-not-found:
  "neighbors on an unknown vertex throws" assert-error-type
] ;

test-errors-removals-are-quiet: ( -- ) [
  [ cmp ] <graph> 1 graph-add-vertex 5 graph-remove-vertex graph-vertex-count 1
  "removing an unknown vertex changes nothing" assert=
  [ cmp ] <graph> 1 2 graph-add-edge 1 3 graph-remove-edge graph-edge-count 1
  "removing a missing edge changes nothing" assert=
] ;

\ --- Lookups ---

test-lookup-edge-get-newest: ( -- ) [
  "lookups" test-section
  [ cmp ] <graph> 1 2 first: graph-add-edge-with-payload 1 2 second: graph-add-edge-with-payload
  1 2 graph-edge-get payload>> second: "edge-get answers with the newest entry" assert=
] ;

test-lookup-option-twins: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge
  dup 1 2 graph-edge-get? option:some> target>> 2 "edge-get? unwraps the edge" assert=
  dup 1 3 graph-edge-get? option:none? "edge-get? on a missing edge is none" assert-true
  dup 1 graph-neighbors? option:some> #len 1 "neighbors? unwraps the edges" assert=
  9 graph-neighbors? option:none? "neighbors? on an unknown vertex is none" assert-true
] ;

test-lookup-twins-agree: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge
  dup dup 1 2 graph-edge-get? option:some> swap 1 2 graph-edge-get
  "edge-get? agrees with the bare form" assert=
  dup 1 graph-neighbors? option:some> swap 1 graph-neighbors
  "neighbors? agrees with the bare form" assert=
] ;

\ --- Parallel edges ---

test-parallel-lists-both-entries: ( -- ) [
  "parallel edges" test-section
  [ cmp ] <graph> 1 2 graph-add-edge 1 2 graph-add-edge
  dup 1 graph-neighbors #len 2 "both entries are stored" assert=
  dup 2 graph-neighbors #len 2 "at both ends" assert=
  graph-edges #len 2 "and both are emitted" assert=
] ;

test-parallel-remove-takes-all: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge 1 2 graph-add-edge 1 2 graph-remove-edge
  dup graph-edge-count 0 "one removal takes every parallel entry" assert=
  dup 1 graph-neighbors #len 0 "the source's list is empty" assert=
  2 graph-neighbors #len 0 "and so is the target's" assert=
] ;

\ --- Persistence ---

test-persistence-add-edge: ( -- ) [
  "persistence" test-section
  [ cmp ] <graph> 1 2 graph-add-edge
  dup 2 3 graph-add-edge graph-edge-count 2 "the new version has both edges" assert=
  graph-edge-count 1 "the prior version is unchanged" assert=
] ;

test-persistence-remove-edge: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge
  dup 1 2 graph-remove-edge graph-edge-count 0 "the new version lost the edge" assert=
  dup 1 2 graph-has-edge? "the prior version still has it" assert-true
  graph-edge-count 1 "count included" assert=
] ;

test-persistence-remove-vertex: ( -- ) [
  [ cmp ] <graph> triangle
  dup 2 graph-remove-vertex graph-vertex-count 2 "the new version lost the vertex" assert=
  dup 2 graph-has-vertex? "the prior version still has it" assert-true
  graph-edge-count 3 "with all three edges" assert=
] ;

\ --- Projection ---

\ The dense form is private and the runner borrows the sibling's privates in, so the group
\ below calls project and dense-index by name.

\ The dense target indices stored at one vertex's own index.
dense-targets: ( dg i -- array ) [
  swap adjacency>> swap #nth [ target>> ] #map #collect
] ;

test-projection-adjacency-order: ( -- ) [
  "projection" test-section
  [ cmp ] <graph> 1 2 graph-add-edge 2 3 graph-add-edge project
  dup 1 dense-targets { 2 0 }
  "a vertex's entries are its stored ones, newest first" assert=
  dup 0 dense-targets { 1 } "each names the other end by index" assert=
  adjacency>> 1 #nth 0 #nth edge>> target>> 3 "and carries the record it came from" assert=
  [ cmp ] <graph> 1 2 weight: graph-add-edge-with-payload project
  adjacency>> 0 #nth 0 #nth edge>> payload>> weight: "the payload travels with it" assert=
] ;

test-projection-digraph-out-edges: ( -- ) [
  [ cmp ] <digraph> 1 2 graph-add-edge project
  dup 0 dense-targets { 1 } "a digraph entry sits at its source" assert=
  1 dense-targets { } "and nowhere else" assert=
] ;

test-projection-empty: ( -- ) [
  [ cmp ] <graph> project
  dup vertices>> #len 0 "an empty graph projects to no vertices" assert=
  adjacency>> #len 0 "and no adjacency slots" assert=
] ;

test-projection-index-round-trip: ( -- ) [
  [ cmp ] <graph> triangle
  dup project swap graph-vertices
  over vertices>> >array over "the numbering follows the comparator order" assert=
  dup 2 pick-n [ tuck swap dense-index swap vertices>> swap #nth ] curry #map #collect
  swap "every vertex survives the round trip" assert=
  drop
] ;

test-projection-isolated-vertex: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge 5 graph-add-vertex project
  dup 2 dense-targets { } "an isolated vertex gets an empty slot" assert=
  adjacency>> #len 3 "and a slot of its own" assert=
] ;

test-projection-scale: ( -- ) [
  [ cmp ] <graph> 1000 parallel-bundle project
  0 dense-targets #len 1000 "a 1000-entry list projects" assert=
  [ cmp ] <graph> 200 star project
  dup 0 dense-targets #len 200 "so does a 200-leaf center" assert=
  vertices>> #len 201 "with every leaf numbered" assert=
] ;

test-projection-self-loop: ( -- ) [
  [ cmp ] <graph> 1 1 graph-add-edge project
  0 dense-targets { 0 } "a self-loop points at its own index, once" assert=
] ;

test-projection-unknown-vertex: ( -- ) [
  [ cmp ] <graph> 1 graph-add-vertex project
  [ 9 dense-index ] curry key-not-found:
  "dense-index on an unknown vertex throws" assert-error-type
] ;

\ --- Protocol decline ---

test-protocol-no-iterator: ( -- ) [
  "protocol decline" test-section
  [ [ cmp ] <graph> >iterator ] ">iterator on a graph throws" assert-error
  [ [ cmp ] <graph> #len ] "#len on a graph throws" assert-error
  [ [ cmp ] <graph> #first ] "#first on a graph throws" assert-error
] ;

\ --- Remove edge ---

test-remove-edge-directed-one-way: ( -- ) [
  "remove edge" test-section
  [ cmp ] <digraph> 1 2 graph-add-edge 2 1 graph-add-edge 1 2 graph-remove-edge
  dup 1 2 graph-has-edge? "the named direction goes" assert-false
  dup 2 1 graph-has-edge? "the other direction stays" assert-true
  graph-edge-count 1 "one edge left" assert=
] ;

test-remove-edge-undirected-both-ends: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge 2 3 graph-add-edge 1 2 graph-remove-edge
  dup 1 2 graph-has-edge? "the entry at the source goes" assert-false
  dup 2 1 graph-has-edge? "and the entry at the target too" assert-false
  dup 2 3 graph-has-edge? "the other edge is untouched" assert-true
  graph-edge-count 1 "one edge left" assert=
] ;

test-remove-edge-keeps-vertices: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge 1 2 graph-remove-edge
  graph-vertex-count 2 "removing an edge leaves both vertices" assert=
] ;

\ --- Remove vertex ---

test-remove-vertex-clears-back-edges: ( -- ) [
  "remove vertex" test-section
  [ cmp ] <graph> triangle 2 graph-remove-vertex
  dup graph-vertex-count 2 "two vertices remain" assert=
  dup graph-edge-count 1 "one edge remains" assert=
  dup 1 graph-neighbors #len 1 "the first neighbor kept only its other edge" assert=
  3 graph-neighbors #len 1 "and so did the second" assert=
] ;

test-remove-vertex-isolated: ( -- ) [
  [ cmp ] <graph> 1 graph-add-vertex 1 graph-remove-vertex
  graph-empty? "removing the only vertex empties the graph" assert-true
] ;

\ --- Scale ---

\ A cons-list word that recurses once per element overflows the task stack somewhere
\ between 600 and 800 entries, so a 1000-entry adjacency list is what pins the walks
\ below to their loop form.

test-scale-parallel-bundle: ( -- ) [
  "scale" test-section
  [ cmp ] <graph> 1000 parallel-bundle
  dup 0 graph-neighbors #len 1000 "a 1000-entry list walks" assert=
  dup graph-edges #len 1000 "and so does the whole-graph walk" assert=
  dup graph-edge-count 1000 "the count tracks every parallel add" assert=
  dup 0 1 graph-remove-edge graph-edge-count 0 "one removal clears the bundle" assert=
  0 graph-remove-vertex graph-edge-count 0 "so does removing an endpoint" assert=
] ;

test-scale-star: ( -- ) [
  [ cmp ] <graph> 200 star
  dup 0 graph-neighbors #len 200 "the center carries every leaf" assert=
  dup graph-edges #len 200 "each spoke is emitted once" assert=
  dup graph-vertex-count 201 "the center and its leaves" assert=
  0 graph-remove-vertex
  dup graph-edge-count 0 "removing the center clears every spoke" assert=
  graph-vertex-count 200 "and leaves the leaves" assert=
] ;

\ A ring is where a walk that re-enqueued an already-marked vertex would never finish, and
\ a 200-deep chain is where one that recursed per vertex would exhaust the task stack. The
\ size is what an interpreted O((V + E) log V) projection plus O(V log V) of result
\ building affords: a traversal costs roughly a second per hundred vertices here.

test-scale-traversal: ( -- ) [
  [ cmp ] <graph> 200 ring
  dup 0 graph-breadth-first
  dup order>> #len 201 "every vertex of the ring is visited once" assert=
  100 graph-traversal-distance? option:some> 100 "and the far side is half the ring away" assert=
  dup 0 graph-depth-first order>> #len 201 "a 200-deep chain walks without recursing" assert=
  graph-connected-components #len 1 "and the ring is one component" assert=
] ;

\ --- Self loop ---

test-self-loop-counts-once: ( -- ) [
  "self loop" test-section
  [ cmp ] <graph> 1 1 graph-add-edge
  dup graph-edge-count 1 "an undirected self-loop counts once" assert=
  dup 1 graph-neighbors #len 1 "and is stored once" assert=
  graph-edges #len 1 "and is emitted once" assert=
] ;

test-self-loop-digraph: ( -- ) [
  [ cmp ] <digraph> 1 1 graph-add-edge
  dup graph-edge-count 1 "a directed self-loop counts once" assert=
  dup 1 1 graph-has-edge? "and is found from its own end" assert-true
  1 graph-remove-vertex graph-edge-count 0 "removing the vertex clears it" assert=
] ;

test-self-loop-removal: ( -- ) [
  [ cmp ] <graph> 1 1 graph-add-edge 1 1 graph-remove-edge
  dup graph-edge-count 0 "removing a self-loop clears the count" assert=
  1 graph-has-vertex? "and leaves the vertex" assert-true
  [ cmp ] <graph> 1 1 graph-add-edge 1 graph-remove-vertex
  graph-edge-count 0 "removing the vertex clears it too" assert=
] ;

test-self-loop-with-neighbors: ( -- ) [
  [ cmp ] <graph> 1 1 graph-add-edge 1 2 graph-add-edge 1 3 graph-add-edge
  dup graph-edge-count 3 "the loop and two spokes" assert=
  dup 1 graph-neighbors #len 3 "all three sit in the vertex's own list" assert=
  1 graph-remove-vertex
  dup graph-edge-count 0 "removing it takes the loop and both spokes" assert=
  dup 2 graph-neighbors #len 0 "the first spoke's other end is clear" assert=
  3 graph-neighbors #len 0 "and so is the second's" assert=
] ;

\ --- Topological sort ---

test-topological-cycle: ( -- ) [
  "topological sort" test-section
  [ [ cmp ] <digraph> 1 2 graph-add-edge 2 3 graph-add-edge 3 1 graph-add-edge
    graph-topological-sort
  ] cyclic-graph:
  "a digraph with a cycle has no topological order" assert-error-type
] ;

test-topological-edgeless: ( -- ) [
  [ cmp ] <digraph> 3 graph-add-vertex 1 graph-add-vertex 2 graph-add-vertex
  graph-topological-sort { 1 2 3 }
  "vertices with no edges come out ascending under the comparator" assert=
] ;

test-topological-empty: ( -- ) [
  [ cmp ] <digraph> graph-topological-sort { } "an empty digraph sorts to nothing" assert=
] ;

test-topological-isolated-vertex: ( -- ) [
  [ cmp ] <digraph> 1 2 graph-add-edge 9 graph-add-vertex graph-topological-sort
  { 1 9 2 } "a vertex with no edges still appears" assert=
] ;

test-topological-respects-edges: ( -- ) [
  [ cmp ] <digraph> 3 4 graph-add-edge 1 2 graph-add-edge 2 3 graph-add-edge
  graph-topological-sort { 1 2 3 4 }
  "a chain comes out in its one possible order, whatever order it was built in" assert=
] ;

test-topological-self-loop: ( -- ) [
  [ [ cmp ] <digraph> 1 1 graph-add-edge graph-topological-sort ] cyclic-graph:
  "a self-loop is a cycle of one" assert-error-type
] ;

test-topological-tie-order: ( -- ) [
  [ cmp ] <digraph> 1 2 graph-add-edge 1 3 graph-add-edge
  2 4 graph-add-edge 3 4 graph-add-edge
  graph-topological-sort { 1 3 2 4 }
  "a vertex freed later joins in the order its last incoming edge was stored" assert=
] ;

test-topological-undirected: ( -- ) [
  [ [ cmp ] <graph> 1 2 graph-add-edge graph-topological-sort ] invalid-argument:
  "an undirected graph has no topological order at all" assert-error-type
] ;

\ --- Traversal lookups ---

test-traversal-fields: ( -- ) [
  "traversal lookups" test-section
  [ cmp ] <graph> 1 2 graph-add-edge 1 graph-breadth-first
  dup graph-traversal? "a traversal is its own record type" assert-true
  order>> { 1 2 } "carrying the visit order" assert=
] ;

test-traversal-unknown-vertex: ( -- ) [
  [ cmp ] <graph> 1 2 graph-add-edge 1 graph-breadth-first
  dup 9 graph-traversal-distance? option:none?
  "a vertex the graph never had has no distance" assert-true
  9 graph-traversal-parent? option:none? "and no parent" assert-true
] ;
