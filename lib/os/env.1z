\ lib/env.1z - Shortcut words for common environment variables

\ 1z environment variables

\\ Default heap memory limit for the runtime, parsed as a byte size such as
\\ `256M` or `1G`. The `--max-memory` flag overrides it, and it takes precedence
\\ over container/cgroup memory detection and the built-in default.
$ONEZ_MAX_MEMORY: ( -- str ) [ environ "ONEZ_MAX_MEMORY" @get ] ;

\\ Colon-separated list of extra module search directories, searched before the
\\ standard-library path when resolving search-mode imports such as
\\ `use "mymod"`. Corresponds to the `--load-path` flag.
$ONEZ_LOAD_PATH: ( -- str ) [ environ "ONEZ_LOAD_PATH" @get ] ;

\\ Standard-library search path used to resolve search-mode imports such as
\\ `use "testing"`.
\\
\\ This variable overrides the default `../lib` location beside the executable.
\\ An explicit `--stdlib-path` overrides this in turn. AOT binaries honor this
\\ variable but have no default, so it is the usual way to point an AOT program
\\ at the stdlib for imports it resolves at runtime.
$ONEZ_STDLIB: ( -- str ) [ environ "ONEZ_STDLIB" @get ] ;

\ Common environment variables

\\ The current user's home directory, from the OS environment.
$HOME: ( -- str ) [ environ "HOME" @get ] ;

\\ The OS executable search path, a colon-separated list of directories.
$PATH: ( -- str ) [ environ "PATH" @get ] ;

\\ The current user's login name, from the OS environment.
$USER: ( -- str ) [ environ "USER" @get ] ;

\\ Path to the current user's login shell, from the OS environment.
$SHELL: ( -- str ) [ environ "SHELL" @get ] ;

\\ The user's preferred text editor command, from the OS environment.
$EDITOR: ( -- str ) [ environ "EDITOR" @get ] ;

\\ Directory for temporary files, from the OS environment.
$TMPDIR: ( -- str ) [ environ "TMPDIR" @get ] ;
