\ lib/os/path.1z - Path manipulation

use "strings" ;
use "sequences" ;

\\ Recursively strip trailing slashes unless the string is entirely slashes.
strip-trailing-slashes: ( path -- path ) [
  dup #len 1 <=
  [ ]
  [ dup #last "/" =
    [ dup #len 1 - #take strip-trailing-slashes ]
    when
  ]
  if
] ;

\\ Extract the filename component from a path.
\\ "/foo/bar.txt" -> "bar.txt", "/foo/bar/" -> "bar", "/" -> "/", "" -> ""
basename: ( path -- name ) [
  dup #empty?
  [ ]
  [
    strip-trailing-slashes
    "/" split #last
    dup #empty? [ drop "/" ] when
  ]
  if
] ;

\\ Extract the directory component from a path.
\\ "/foo/bar.txt" -> "/foo", "foo.txt" -> ".", "/" -> "/", "" -> "."
dirname: ( path -- dir ) [
  dup #empty?
  [ drop "." ]
  [
    dup "/" =
    [ ]
    [
      strip-trailing-slashes
      "/" split
      dup #len 1 <=
      [ drop "." ]
      [
        dup #len 1 - #take
        "/" #join
        dup #empty? [ drop "/" ] when
      ]
      if
    ]
    if
  ]
  if
] ;

\\ Extract the file extension including the leading dot.
\\ "bar.txt" -> ".txt", "foo.tar.gz" -> ".gz", "foo" -> "", ".hidden" -> ""
extension: ( path -- ext ) [
  basename
  dup "/" = [ drop "" ] [
    "." split
    dup #len 1 <=
    [ drop "" ]
    [
      dup #first #empty?
      over #len 2 = and
      [ drop "" ]
      [ #last "." swap #append ]
      if
    ]
    if
  ]
  if
] ;

\\ Join two path segments. If rel is absolute, it replaces base.
\\ "/foo" "bar.txt" -> "/foo/bar.txt", "/foo" "/bar" -> "/bar"
path-join: ( base rel -- path ) [
  dup "/" #starts-with?
  [ nip ]
  [ swap strip-trailing-slashes "/" <rot- #append #append ]
  if
] ;

\\ Process one segment during normalize's reduce.
\\ The abs? flag is curried in by normalize.
normalize-seg: ( acc seg abs? -- acc ) [
  swap dup ".." =
  [
    drop
    over #empty?
    [
      [ ]
      [ drop { ".." } ]
      if
    ]
    [
      drop
      dup #last ".." =
      [ ".." #suffix ]
      [ dup #len 1 - #take ]
      if
    ]
    if
  ]
  [
    swap drop #suffix
  ]
  if
] ;

\\ Resolve `.` and `..` segments, collapse repeated slashes.
\\ Prevents directory traversal: `/../../../etc/passwd` -> `/etc/passwd`
normalize: ( path -- path ) [
  dup "/" #starts-with?  \ path abs?

  \ Split and filter empty/dot segments
  swap "/" split
  [ dup #len 0 > swap "." /= and ] #filter #collect

  \ Reduce with normalize-seg, currying in abs? flag
  over [ normalize-seg ] curry  \ abs? segments quot
  { } swap #reduce              \ abs? result-array

  \ Reassemble
  "/" #join  \ abs? joined
  dup #empty?
  [ drop [ "/" ] [ "." ] if ]
  [ swap [ "/" swap #append ] when ]
  if
] ;

private{
  \ Split an already-normalized path into segments with normalize's own
  \ filter, dropping empty and `.` parts.
  path-segments: ( path -- segs ) [
    "/" split [ dup #len 0 > swap "." /= and ] #filter #collect
  ] ;

  leading-updir?: ( segs -- ? ) [
    dup #empty? [ drop f ] [ #first ".." = ] if
  ] ;

  \ Drop the leading segments the two arrays share.
  drop-common: ( psegs bsegs -- psegs bsegs ) [
    over #empty? over #empty? or
    [ ]
    [ 2dup [ #first ] dip #first =
      [ [ 1 #drop ] dip 1 #drop drop-common ]
      when
    ]
    if
  ] ;
}

\\ Express path relative to base, comparing normalized segments. The result may lead with `..`,
\\ and equal paths give ".".
\\ "/a/b/c/d.txt" "/a/b" -> "c/d.txt", "/a" "/a/b/c" -> "../.."
\\
\\ Purely lexical: unlike Python's os.path.relpath, the working directory is never consulted.
\\
\\ Raises invalid-argument when exactly one side is absolute, or when either side still leads
\\ with `..` after normalization.
relative-path: ( path: string base: string -- rel ) [
  [ normalize ] dip normalize
  2dup [ "/" #starts-with? ] dip "/" #starts-with? xor
  [ 2drop f "cannot relate an absolute path and a relative path" EInvalidArgument make-error throw ]
  when
  [ path-segments ] dip path-segments
  2dup [ leading-updir? ] dip leading-updir? or
  [ 2drop f "cannot relate a path that leads with .." EInvalidArgument make-error throw ]
  when
  drop-common
  #len { } swap [ ".." #suffix ] times
  swap #append
  "/" #join
  dup #empty? [ drop "." ] when
] ;

\\ Express path relative to base, answering option:some rel on a comparable pair and
\\ option:none otherwise.
relative-path?: ( path: string base: string -- option ) [
  [ relative-path >option:some ]
  [ drop option:none ]
  recover
] ;
