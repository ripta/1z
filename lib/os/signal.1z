\ lib/os/signal.1z - Signal handling API

\ Virtual type wrapping POSIX signal numbers
signal: virtual{ fixnum } ;

\ Named constants (platform-correct via native lookup)
SIGINT:   ( -- signal: signal ) const [ INT: native.signal-number >signal ] ;
SIGTERM:  ( -- signal: signal ) const [ TERM: native.signal-number >signal ] ;
SIGHUP:   ( -- signal: signal ) const [ HUP: native.signal-number >signal ] ;
SIGQUIT:  ( -- signal: signal ) const [ QUIT: native.signal-number >signal ] ;
SIGPIPE:  ( -- signal: signal ) const [ PIPE: native.signal-number >signal ] ;
SIGUSR1:  ( -- signal: signal ) const [ USR1: native.signal-number >signal ] ;
SIGUSR2:  ( -- signal: signal ) const [ USR2: native.signal-number >signal ] ;
SIGALRM:  ( -- signal: signal ) const [ ALRM: native.signal-number >signal ] ;
SIGCHLD:  ( -- signal: signal ) const [ CHLD: native.signal-number >signal ] ;
SIGWINCH: ( -- signal: signal ) const [ WINCH: native.signal-number >signal ] ;

\ Convenience words that unwrap the virtual type before calling the native primitives.

\\ Register a handler quotation for a signal.
\\
\\ The handler receives the signal number (fixnum) on the stack, and must consume it and leave
\\ nothing. When it fails, the stack it interrupted is put back. An error other than a `throw`, or
\\ a return with the stack changed, is reported on stderr. A `throw` still propagates.
on-signal: ( signal quot: ( signum -- ) -- ) [ swap unmake-signal swap set-signal-handler ] ;

\\ Remove the handler for a signal, restoring default behavior.
off-signal: ( signal -- ) [ unmake-signal clear-signal-handler ] ;

\\ Get the handler for a signal, or f if none is registered.
signal-handler: ( signal -- quot/f ) [ unmake-signal get-signal-handler ] ;

\\ Register a handler for SIGINT (Ctrl-C).
on-interrupt: ( quot: ( signum -- ) -- ) [ SIGINT swap on-signal ] ;

\\ Register a handler for SIGTERM.
on-terminate: ( quot: ( signum -- ) -- ) [ SIGTERM swap on-signal ] ;

pragma{ lint-suppress: { dead-definition: missing-doc-comment: missing-type-annotation: non-kebab-case: } }
