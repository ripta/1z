\ lib/os/watch.1z - High-level file watching API

use "os/fs" ;
use "os/path" ;
use "channel" ;
use "task" ;
use "process" ;

\\ Path payload for create/modify/delete watcher events.
watch-path: struct{ path } ;
\\ Rename payload carrying the old path and the new path when available.
watch-rename: struct{ old-path new-path } ;

\\ File watcher event enum with per-variant path payloads.
watch-event: enum{
  created:  watch-path
  modified: watch-path
  deleted:  watch-path
  renamed:  watch-rename
} ;

\\ Watcher handle wrapping a native watcher resource.
watcher: virtual{ resource } ;

(raw-event>watch-event): ( raw -- event ) [
  dup kind: @get created: = [
    path: @get
    make-watch-path
    make-watch-event:created
  ] [
    dup kind: @get modified: = [
      path: @get
      make-watch-path
      make-watch-event:modified
    ] [
      dup kind: @get deleted: = [
        path: @get
        make-watch-path
        make-watch-event:deleted
      ] [
        dup kind: @get renamed: = [
          dup path: @get
          swap new-path: @get
          make-watch-rename
          make-watch-event:renamed
        ] [
          drop
          f "unknown watcher event kind" EInvalidArgument make-error throw
        ] if
      ] if
    ] if
  ] if
] ;

\\ Create an OS-native event watcher.
<event-watcher>: ( -- watcher ) [ event: watcher-create >watcher ] ;

\\ Create a portable polling watcher.
<polling-watcher>: ( -- watcher ) [ polling: watcher-create >watcher ] ;

\\ Probe whether OS-native event watching works on the given path.
supports-event-watch?: ( path -- bool ) [ watcher-probe ] ;

\\ Add a non-recursive watch for all event kinds on a path.
add-watch: ( watcher path -- watch-id ) [ swap unmake-watcher swap f watcher-add ] ;

\\ Recursively watch a directory tree. Returns an array of watch-ids.
\\ Only watches directories that exist at call time; newly created
\\ subdirectories are not automatically watched.
add-watch-recursive: ( watcher path -- watch-ids ) [
  \ stack: watcher path
  2dup add-watch
  \ stack: watcher path root-id
  { } swap #push
  \ stack: watcher path ids-array
  over walk [ type>> directory: = ] #filter #collect
  \ stack: watcher path ids-array dir-entries
  [
    \ stack: watcher path ids-array dir-entry
    name>> 2 pick-n swap path-join
    \ stack: watcher path ids-array abs-subdir
    3 pick-n swap add-watch
    \ stack: watcher path ids-array sub-id
    #push
    \ stack: watcher path ids-array'
  ] #each
  nip nip
] ;

\\ Remove a previously registered watch id.
remove-watch: ( watcher watch-id -- ) [ swap unmake-watcher swap watcher-remove ] ;

\\ Read the next watcher event and convert it to watch-event.
next-event: ( watcher -- event ) [ unmake-watcher watcher-read (raw-event>watch-event) ] ;

\\ Close a watcher explicitly.
close-watcher: ( watcher -- ) [ unmake-watcher resource-close ] ;

\\ Run a quotation with a watcher and close it on exit.
with-watcher: ( watcher quot -- ... ) [ over [ close-watcher ] curry cleanup ] ;

\\ Loop forever, calling quot with each event as it arrives.
each: stack-recursive ( watcher quot -- ) [
  over next-event
  over call
  each
] ;

(drain-latest): stack-recursive ( ch latest -- latest' ) [
  over try-receive [
    nip (drain-latest)
  ] [
    drop nip
  ] if
] ;

(forward-events): stack-recursive ( watcher ch -- ) [
  over next-event
  1 pick-n send
  (forward-events)
] ;

(spawn-forwarder): ( watcher ch -- task ) [
  [
    [ (forward-events) ]
    [
      dup use-after-close: error-type?
      swap task-cancelled: error-type?
      or
      [ drop ]
      [ throw ]
      if
    ] recover
  ] curry curry spawn
] ;

(cancel-await): ( task -- ) [
  dup cancel-task
  [ await drop ] curry
  [ drop ] recover
] ;

(debounced-each-loop): stack-recursive ( watcher duration quot ch -- ) [
  dup receive?
  dup option:some? [
    unwrap-or-throw
    3 pick-n sleep
    1 pick-n swap (drain-latest)
    2 pick-n curry call
    (debounced-each-loop)
  ] [
    drop 3drop drop
  ] if
] ;

(debounced-each-body): ( watcher duration quot -- ) [
  64 <buffered-channel>
  3 pick-n over (spawn-forwarder)
  [
    [ (debounced-each-loop) ] dip
  ] [
    swap
    (cancel-await)
    throw
  ] recover
] ;

\\ Loop reading events with debounce coalescing. Rapid events within
\\ the duration window are collapsed; the quotation receives the latest
\\ event after the quiet period expires. Creates its own task-scope.
debounced-each: ( watcher duration quot -- ) [
  [ (debounced-each-body) ] curry curry curry task-scope
] ;

\\ Watch for changes and run a shell command on each debounced event.
watch-exec: ( watcher duration command -- ) [
  [ drop run-shell drop ] curry
  debounced-each
] ;
