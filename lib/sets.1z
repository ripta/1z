\ lib/sets.1z - Set predicates and utilities

\\ True when every element of set1 is also in set2.
\\
\\   S{ 1 2 } S{ 1 2 3 } @subset?
\\   => t
@subset?: ( set1 set2 -- ? ) [ @difference #len 0 = ] ;

\\ True when every element of set2 is also in set1.
\\
\\   S{ 1 2 3 } S{ 1 2 } @superset?
\\   => t
@superset?: ( set1 set2 -- ? ) [ swap @subset? ] ;

\\ True when the two sets have no element in common.
\\
\\   S{ 1 2 } S{ 3 4 } @disjoint?
\\   => t
@disjoint?: ( set1 set2 -- ? ) [ @intersection #len 0 = ] ;

\\ The elements in exactly one of the two sets.
\\
\\   S{ 1 2 3 } S{ 2 3 4 } @symmetric-difference S{ 1 4 } =
\\   => t
@symmetric-difference: ( set1 set2 -- set ) [ 2dup @difference -rot> swap @difference @union ] ;

pragma{ lint-suppress: { dead-definition: missing-type-annotation: } }
