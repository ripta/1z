\ lib/memo.1z - Memoization helpers
\
\ See ./tests/benchmark/fibonacci.1z for an example usage.

\ Parameter holding the current memo cache
memo-cache: parameter{ [ M{ } ] } ;

\ Run a quotation with a fresh memo cache, after which the memo is discarded
with-memo: ( quot -- ... ) [
  [ M{ } memo-cache ] dip with-parameter
] ;

\ Check whether a key exists in the memo cache.
memo-has?: ( key -- ? ) [
  memo-cache get swap @has?
] ;

\ Look up a key in the memo cache, returning an option.
memo-get?: ( key -- option ) [
  memo-cache get over @has?
  [ memo-cache get swap @get >option:some ]
  [ drop option:none ]
  if
] ;

\ Look up a key in the memo cache, or throw if not found.
memo-get: ( key -- value ) [
  memo-get?
  dup option:some?
  [ option:some> ]
  [ drop f "key not in memo cache" EKeyNotFound make-error throw ]
  if
] ;

\ Store a key-value pair in the memo cache.
memo!: ( key value -- ) [
  memo-cache get -rot> @set! drop
] ;
