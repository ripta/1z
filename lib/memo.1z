\ lib/memo.1z - Memoization helpers
\
\ See ./tests/benchmark/fibonacci.1z for an example usage.

\ Parameter holding the current memo cache
memo-cache: parameter{ [ M{ } ] } ;

\\ Run a quotation with a fresh, empty memo cache. The cache is discarded when the quotation
\\ returns, so memoized values never outlive one call.
\\
\\ The cache is an `M{ }` hash, so every key is a string or a symbol.
with-memo: ( quot -- ... ) [
  [ M{ } memo-cache ] dip with-parameter
] ;

\\ True when the current memo cache holds the key.
memo-has?: ( key -- ? ) [
  memo-cache get swap @has?
] ;

\\ The value cached under the key, or `option:none`.
memo-get?: ( key -- option ) [
  memo-cache get over @has?
  [ memo-cache get swap @get >option:some ]
  [ drop option:none ]
  if
] ;

\\ The value cached under the key. Throws `key-not-found` when the key is absent.
memo-get: ( key -- value ) [
  memo-get?
  dup option:some?
  [ option:some> ]
  [ drop f "key not in memo cache" EKeyNotFound make-error throw ]
  if
] ;

\\ Cache a value under a string or symbol key in the current memo cache, replacing any earlier
\\ value.
\\
\\   [ "5" 25 memo! "5" memo-get ] with-memo
\\   => 25
memo!: ( key value -- ) [
  memo-cache get -rot> @set! drop
] ;

pragma{ lint-suppress: { dead-definition: missing-type-annotation: mutation-suffix-misuse: predicate-naming: } }
