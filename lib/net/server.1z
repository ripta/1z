\ lib/server.1z - TCP server framework

use "net" ;
use "net/tcp" ;

server-config: mutable struct{ host port backlog handler on-error } ;

\ Create a default server config.
<server-config>: ( -- config ) [
  "0.0.0.0" 0 128 [ drop ] [ drop ] make-server-config
] ;

\ Start a server from a config. Returns the server handle.
\ The server binds and listens but does not start accepting connections.
start-server: ( config -- server ) [
  dup host>> over port>> make-addr:tcp
  swap backlog>>
  listen
] ;

private{
  \ Repeatedly accept connections and spawn handler tasks.
  serve-loop: ( handler on-error server -- ) [
    dup accept                        \ handler on-error server stream addr
    4 pick-n curry curry              \ handler on-error server [stream addr handler...]
    2 pick-n [ recover ] curry curry  \ handler on-error server [[stream addr handler...] on-error recover]
    spawn drop                        \ handler on-error server
    serve-loop
  ] ;
}

\ Run a server forever: start, then loop accepting connections.
\ Each connection spawns a task that runs the handler with the stream
\ and the peer address. Must be called inside task-scope.
serve-forever: ( config -- ) [
  dup handler>> swap
  dup on-error>> swap
  start-server
  serve-loop
] ;
