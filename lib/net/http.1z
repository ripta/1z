\ lib/net/http.1z - HTTP/1.1 server library.
\
\ Exposes a `request` value (wire-derived, socket-derived, and TLS-derived fields), a `response`
\ value, and the `serve` entry point that accepts connections and dispatches them to a user-supplied
\ `( stream request -- )` handler.
\
\ `serve-static` serves a directory of files. Routing lives in `lib/net/http/router.1z`.
\
\ See `docs/guides/http.md` for an overview.

use "strings" ;
use "conversions" ;
use "os/path" ;
use "mimetype" ;
use "net/server" ;
use "data/url" ;
use "time" ;

EMalformedRequest: ( -- err: symbol ) [ malformed-request: ] ;

request: struct{ method path query-string version headers body
  remote-addr remote-port server-name server-port
  is-tls? tls-version tls-cipher
} ;

\\ Parse header lines from a stream into a hash with lowercased keys.
read-headers: ( stream -- headers ) [
  H{ } read-headers-loop
] ;

read-headers-loop: ( stream headers -- headers ) [
  over stream-read-line
  dup f = [ drop swap drop ] [
    dup #empty? [ drop swap drop ] [
      ":" split-once
      dup #first lowercase swap #last trim
      @set
      read-headers-loop
    ] if
  ] if
] ;

\ Split a request-target on the first `?` into a path and a query-string.
\ A target with no `?` keeps the whole target as the path and yields an
\ empty query-string. A target with `?` and an empty tail also yields an
\ empty query-string.
(split-target): ( target -- path query-string ) [
  dup "?" split-once?
  dup option:some?
  [ option:some> nip
    dup #first swap #last
  ]
  [ drop "" ]
  if
] ;

private{
  \ Parse an already-read request line plus the header block into the five
  \ wire fields. Split out from (read-request-wire) so the server loop can read
  \ the request line non-throwing, decide whether the connection has closed, and
  \ then parse the line it already holds without re-reading the stream.
  (parse-request-line): ( stream line -- method path query-string version headers ) [
    " " split
    dup #len 3 < [ dup " " #join "malformed request line" EMalformedRequest make-error throw ] when
    dup 2 #nth
    over 0 #nth
    -rot>
    swap 1 #nth (split-target)
    <rot-
    4 pick-n read-headers
    5 drop-at
  ] ;
}

\ Read the wire-derived portion of an HTTP request from a stream. Returns the
\ five wire fields on the stack with `headers` on top. Used by `read-request`
\ and the server-path dispatch.
(read-request-wire): ( stream -- method path query-string version headers ) [
  dup stream-read-line
  dup f = [ f "unexpected EOF reading request line" EUnexpectedEOF make-error throw ] when
  (parse-request-line)
] ;

private{
  \ Read the next request line, non-throwing. Returns option:none on a clean
  \ close at a request boundary (stream-read-line yields f), else option:some the line.
  (read-request-line?): ( stream -- option ) [
    stream-read-line
    dup f =
    [ drop option:none ]
    [ >option:some ]
    if
  ] ;
}

\\ Maximum number of bytes the server reads for a request body. A request whose
\\ Content-Length exceeds this cap is answered with 413 Content Too Large and the
\\ connection is closed, rather than reading the oversized body. Bind it
\\ dynamically with `with-max-request-body`.
max-request-body: parameter{ [ 1048576 ] } ;

\\ Run `quot` with the maximum request body size bound to `size` bytes.
with-max-request-body: ( size quot -- ) [ max-request-body swap with-parameter ] ;

\\ How long the server waits for the next request on a persistent connection before closing it as idle.
\\
\\ The wait covers only the gap between requests. Once a request line arrives, the header and body
\\ reads that follow run without this timeout.
\\
\\ Bind it dynamically with `with-idle-connection-timeout`.
idle-connection-timeout: parameter{ [ 30 seconds ] } ;

\\ Run `quot` with `idle-connection-timeout` bound to `duration`.
with-idle-connection-timeout: ( duration quot -- ) [ idle-connection-timeout swap with-parameter ] ;

\\ Maximum number of requests the server serves on one persistent connection.
\\ When a dispatched request reaches this count, the loop forces close on that
\\ response through the connection's disposition cell, so the client gets a
\\ final answer and then must open a fresh connection. Bind it dynamically with
\\ `with-requests-per-connection`.
requests-per-connection: parameter{ [ 100 ] } ;

\\ Run `quot` with `requests-per-connection` bound to `count`.
with-requests-per-connection: ( count quot -- ) [ requests-per-connection swap with-parameter ] ;

\\ Read the next request line under the idle-connection timeout.
\\
\\ Returns `option:none` on a clean close and, uniformly, on an idle timeout, so the
\\ loop terminates in both cases. Returns `option:some` the line otherwise. `recover`
\\ stays terminal so the timeout throw lands on a clean stack.
(read-request-line-timed?): ( stream -- option ) [
  [ [ (read-request-line?) ] curry idle-connection-timeout get with-timeout ]
  [ drop option:none ]
  recover
] ;

private{
  \ True when the request's declared Content-Length exceeds the max-request-body
  \ cap. A missing content-length reads as 0 and is never too large.
  (body-too-large?): ( headers -- too-large? ) [
    "content-length" "0" @get-or parse-integer max-request-body get >
  ] ;
}

\ Parse a header value as a case-insensitive comma-separated token set. A missing
\ header yields a single empty token, which no real token matches.
(header-tokens): ( headers name -- tokens ) [
  "" @get-or lowercase "," split [ trim ] #map #collect
] ;

private{
  \ True when the request declares Transfer-Encoding: chunked. The header value is
  \ a case-insensitive comma-separated token list. A chunked body is not
  \ Content-Length framed, so the eager body read cannot frame it; such a request
  \ is rejected with 411 rather than desynchronizing the stream.
  (chunked-request?): ( headers -- chunked? ) [
    "transfer-encoding" (header-tokens) "chunked" #in?
  ] ;
}

\ Negotiated default connection disposition for a request, per RFC 7230. A client
\ Connection: close closes on any version. HTTP/1.1 is persistent by default.
\ HTTP/1.0 persists only on an explicit Connection: keep-alive. Any other version
\ closes. The Connection header is a case-insensitive comma-separated token set.
(negotiate-keep-alive?): ( request -- keep-alive? ) [
  dup headers>> "connection" (header-tokens)
  dup "close" #in?
  [ 2drop f ]
  [ swap version>>
    dup "HTTP/1.1" =
    [ 2drop t ]
    [ "HTTP/1.0" =
      [ "keep-alive" #in? ]
      [ drop f ]
      if
    ]
    if
  ]
  if
] ;

\ Read exactly Content-Length bytes of the request body from a stream. A
\ missing content-length header yields an empty body and reads nothing. A
\ stream that reaches EOF before content-length bytes have arrived is a
\ framing violation and throws EUnexpectedEOF. Reading the body eagerly here
\ keeps the stream positioned at the start of the next request regardless of
\ what the handler does with the body.
(read-request-body): ( headers stream -- body ) [
  swap "content-length" "0" @get-or parse-integer
  dup [ stream-read(exact) ] dip
  over #len over =
  [ drop ]
  [ 2drop f "unexpected EOF reading request body" EUnexpectedEOF make-error throw ]
  if
] ;

\\ Read and parse an HTTP request line, headers, and body from a stream. The
\\ returned request rides sentinel defaults for the socket-derived fields; the
\\ server path overrides them when dispatching to a handler.
read-request: ( stream -- request ) [
  dup (read-request-wire)
  dup 6 pick-n (read-request-body)
  "" 0 "" 0 f "" ""
  make-request
  nip
] ;

\\ Decode an application/x-www-form-urlencoded body into a hash mapping each
\\ decoded key to an array of decoded values, accumulating in the order they
\\ appeared. The body bytes are the ones the dispatch layer read eagerly and
\\ attached to the request, so a handler calls `request body>> read-form`.
\\ Throws EInvalidArgument on malformed percent sequences. Empty segments and
\\ pairs without `=` follow the WHATWG application/x-www-form-urlencoded
\\ parser: empty segments are dropped; a bare key produces an empty-string
\\ value.
read-form: ( body -- form ) [
  bytes> decode-query
] ;

response: struct{ status reason headers body } ;

status-reasons: ( -- reasons: hash ) H{
  "100" "Continue" "101" "Switching Protocols"
  "200" "OK" "201" "Created" "202" "Accepted" "204" "No Content" "206" "Partial Content"
  "301" "Moved Permanently" "302" "Found" "304" "Not Modified" "307" "Temporary Redirect" "308" "Permanent Redirect"
  "400" "Bad Request" "401" "Unauthorized" "403" "Forbidden" "404" "Not Found"
  "405" "Method Not Allowed" "406" "Not Acceptable" "408" "Request Timeout" "409" "Conflict"
  "410" "Gone" "411" "Length Required" "413" "Content Too Large" "415" "Unsupported Media Type" "422" "Unprocessable Content" "429" "Too Many Requests"
  "500" "Internal Server Error" "501" "Not Implemented" "502" "Bad Gateway" "503" "Service Unavailable" "504" "Gateway Timeout"
} ;

\\ Look up the reason phrase for an HTTP status code.
reason-for: ( status -- reason ) [
  >string status-reasons swap 2dup @has?
  [ @get ] [ 2drop "Unknown" ] if
] ;

\\ Format response headers hash as HTTP header lines. The `connection` key is
\\ filtered out: send-response emits the Connection header itself from the loop's
\\ disposition, so a handler-set connection header must not be double-emitted.
format-response-headers: ( headers -- string ) [
  dup @keys [ >string "connection" = not ] #filter #collect "" format-headers-loop
] ;

format-headers-loop: ( headers keys accum -- string ) [
  over #empty?
  [ nip nip ]
  [
    over #first
    3 pick-n over @get
    swap >string ": " #append swap #append "\r\n" #append
    #append
    swap 1 #drop swap
    format-headers-loop
  ] if
] ;

\\ First-line prefix that `send-response` emits in front of the status code
\\ and reason phrase. Defaults to the HTTP/1.1 wire format. Parsed-CGI
\\ consumers bind `"Status: "` around their handler invocation so the same
\\ `send-response` call site produces a CGI-shaped status line instead.
response-status-line-prefix: parameter{ [ "HTTP/1.1 " ] } ;

\\ Connection-disposition cell bound by the server loop around each handler.
\\ Holds the mutable cell whose "keep-alive?" flag decides the emitted Connection
\\ header and whether the loop serves another request. Unbound outside the
\\ server, so a standalone send-response defaults to close.
connection-disposition: parameter{ [ f ] } ;

\ Build a fresh disposition cell with the given initial keep-alive? flag.
(make-disposition-cell): ( keep-alive? -- cell ) [
  M{ } swap "keep-alive?" swap @set!
] ;

\ Read the bound cell's keep-alive? flag. f when unbound (outside the server).
(read-disposition): ( -- keep-alive? ) [
  connection-disposition get
  dup mutable-map? [ "keep-alive?" @get ] [ drop f ] if
] ;

\\ Force the current connection to close after this response. Flips the loop's
\\ disposition cell; a no-op outside a server connection. Does not close the
\\ stream immediately.
disable-keep-alive: ( -- ) [
  connection-disposition get
  dup mutable-map? [ "keep-alive?" f @set! drop ] [ drop ] if
] ;

\ True when the response carries a `Connection: close` header, by which a handler
\ forces the connection to close.
(response-forces-close?): ( response -- forces? ) [
  headers>> "connection" "" @get-or lowercase "close" =
] ;

\\ Per-connection request-count cell bound by the server loop around the whole
\\ connection. (bump-request-count-at-cap?) increments it once per dispatched
\\ request. Unbound outside the server.
connection-request-count: parameter{ [ f ] } ;

\ Build a fresh per-connection request-count cell starting at zero.
(make-request-count-cell): ( -- cell ) [ M{ } "count" 0 @set! ] ;

\ Increment the bound request-count cell and report whether the connection has
\ now reached the requests-per-connection cap. Unbound (outside the server)
\ never reports at-cap, since there is no cap to enforce.
(bump-request-count-at-cap?): ( -- at-cap? ) [
  connection-request-count get
  dup mutable-map?
  [ dup "count" @get 1 +
    [ "count" swap @set! drop ] keep
    requests-per-connection get >=
  ]
  [ drop f ]
  if
] ;

\\ Write a complete HTTP response to a stream.
\\ Builds the full response as a single string and writes it in one call, looping via
\\ `stream-write(exact)` so a body larger than one socket write is still sent in full.
\\ `stream-write(exact)` swallows a write error into a short count rather than throwing, so a
\\ short write here forces the connection closed instead of letting the loop reuse a dead stream.
\\ The emitted Connection header reflects the loop's disposition cell: a handler
\\ forces close via `disable-keep-alive` or a response `Connection: close` header.
\\ Outside the server the cell is unbound, so the default is close.
send-response: ( stream response -- ) [
  response-status-line-prefix get over status>> >string #append
  " " #append over reason>> #append "\r\n" #append
  over (response-forces-close?)
  [ disable-keep-alive "Connection: close\r\n" ]
  [ (read-disposition) [ "Connection: keep-alive\r\n" ] [ "Connection: close\r\n" ] if ]
  if #append
  "Content-Length: " #append over body>> #len >string #append "\r\n" #append
  over headers>> format-response-headers #append
  "\r\n" #append
  swap body>> #append
  \ #len on a string counts UTF-8 codepoints; the response can carry an arbitrary-bytes body
  \ (e.g. a compiled binary), so convert to a byte-array first to get the true wire length.
  >bytes dup #len [ stream-write(exact) ] dip
  < [ disable-keep-alive ] when
] ;

\\ Construct an HTTP response with a single Content-Type header.
<response>: ( status reason content-type body -- response ) [
  [ H{ } swap "content-type" swap @set ] dip
  make-response
] ;

\\ Construct a 200 OK response.
ok: ( body content-type -- response ) [
  swap [ 200 dup reason-for ] 2dip <response>
] ;

\\ Construct a 404 Not Found response.
not-found: ( -- response ) [
  404 dup reason-for "text/plain; charset=utf-8" "404 Not Found" <response>
] ;

\\ Construct a 405 Method Not Allowed response.
method-not-allowed: ( -- response ) [
  405 dup reason-for "text/plain; charset=utf-8" "405 Method Not Allowed" <response>
] ;

\\ Construct a 413 Content Too Large response.
content-too-large: ( -- response ) [
  413 dup reason-for "text/plain; charset=utf-8" "413 Content Too Large" <response>
] ;

\\ Construct a 411 Length Required response.
length-required: ( -- response ) [
  411 dup reason-for "text/plain; charset=utf-8" "411 Length Required" <response>
] ;

\\ Construct an error response with text/plain body.
error-response: ( status reason message -- response ) [
  "text/plain; charset=utf-8" swap <response>
] ;

private{
  \ Run the user handler with ( stream request ) under a fresh disposition cell
  \ bound to `init?`, then return the cell's final keep-alive? flag. The cell read
  \ happens inside the binding, since with-parameter pops the binding on return.
  (dispatch-under-disposition): ( stream request handler init? -- keep-alive? ) [
    [ curry curry [ (read-disposition) ] compose ] dip
    (make-disposition-cell)
    connection-disposition <rot-
    with-parameter
  ] ;

  \\ Handle one request on a persistent connection.
  \\
  \\ The bottom six items are the connection context, shared across every request on the connection,
  \\ and are left intact for the next loop iteration. Only the wire fields on top are consumed.
  \\
  \\ Returns whether the connection should keep going: the negotiated `keep-alive?` after a normal
  \\ dispatch, f after a framing rejection that closes the connection.
  (handle-request): ( stream sh sp uh rh rp m p q v h -- stream sh sp uh rh rp keep? ) [
    dup (chunked-request?)
    [           \ chunked body: reject with 411 and close; the eager read cannot frame it
      5 drop-n  \ drop the wire fields, leaving the connection context
      5 pick-n length-required send-response
      f
    ]
    [ dup (body-too-large?)
      [  \ over cap: reject with 413 and close; do not read the body or dispatch
        5 drop-n
        5 pick-n content-too-large send-response
        f
      ]
      [                                       \ within cap: read body eagerly, build request, dispatch
        dup 11 pick-n (read-request-body)     \ append body
        7 pick-n                              \ append rh
        7 pick-n                              \ append rp
        12 pick-n                             \ append sh
        12 pick-n                             \ append sp
        f "" ""                               \ TLS sentinels
        make-request                          \ ( stream sh sp uh rh rp request )
        6 pick-n swap 4 pick-n                \ ( ... stream-copy request handler )
        1 pick-n (negotiate-keep-alive?)      \ ( ... stream-copy request handler keep? )
        (bump-request-count-at-cap?) not and  \ fold the requests-per-connection cap into the seed
        (dispatch-under-disposition)          \ ( ... keep-alive? )
      ]
      if
    ]
    if
  ] ;

  \\ Persistant-connection read loop.
  \\
  \\ Holds the connection context:
  \\
  \\    ( stream server-host server-port user-handler remote-host remote-port )
  \\
  \\ across requests and serves each in turn. Terminates and returns the stream when the client
  \\ closes at a request boundary or goes idle past the timeout (both yield a next-request read
  \\ of option:none), or when a request is rejected for framing.
  (serve-connection): ( stream sh sp uh rh rp -- stream ) [
    5 pick-n (read-request-line-timed?)  \ next-request line, none on close or idle timeout
    dup option:some?
    [ option:some>
      6 pick-n swap (parse-request-line)
      (handle-request)
      [ (serve-connection) ] [ 5 drop-n ] if
    ]
    [ drop 5 drop-n ]  \ clean close at a request boundary: ( stream )
    if
  ] ;
}

\ Per-connection dispatch. Invoked by serve-loop with ( stream addr ) and the
\ curried context ( server-host server-port user-handler ). Computes the
\ socket-derived remote address once, then loops through (serve-connection),
\ serving each request on the connection and calling the user handler with
\ ( stream request ). Closes the stream when the client closes at a request
\ boundary. The eager body read in (handle-request) keeps the stream positioned
\ at the next request regardless of what the handler does.
(serve-dispatch): ( stream addr server-host server-port user-handler -- ) [
  3 <rot-n                                                                                  \ ( stream sh sp uh addr )
  addr-host-port                                                                            \ ( stream sh sp uh rh rp )
  (make-request-count-cell) connection-request-count [ (serve-connection) ] with-parameter  \ ( stream )
  stream-close
] ;

\\ Start an HTTP server.
\\
\\ The handler reads request data through:
\\
\\ - the wire-derived fields `method>>`, `path>>`, `query-string>>`, `version>>`, and `headers>>`;
\\ - the socket-derived fields `remote-addr>>` and `remote-port>>` from the accepted connection;
\\ - the server config-derived fields `server-name>>` and `server-port>>`; and
\\ - the TLS-handshake fields `is-tls?>>`, `tls-version>>`, and `tls-cipher>>`.
\\
\\ The TLS fields stay at sentinel defaults (`f`, `""`, `""`) until server-side TLS lands.
\\ The stream is closed automatically after the handler returns.
\\ This word blocks forever, creating its own task-scope.
serve: ( host: string port: fixnum handler: ( s: stream req: request -- ) -- ) [
  \ Duplicate host, port, and handler so they can be curried into the wrapper
  \ while the originals remain on the stack for server-config setup. The
  \ wrapper's body sees ( stream addr server-host server-port user-handler ).
  pick 2 pick-n 2 pick-n
  [ (serve-dispatch) ] curry curry curry
  1 drop-at
  <server-config> swap >>handler swap >>port swap >>host
  [ serve-forever ] curry task-scope
] ;

\\ Serve a single static file request.
\\
\\ Normalizes the path, appends index.html for directory paths,
\\ resolves the file from the document root, and sends the response.
static-file-handler: ( stream request doc-root -- ) [
  swap path>>
  dup "/" #ends-with?
  swap normalize
  swap [ dup "/" #ends-with? not [ "/" #append ] when "index.html" #append ] when
  dup "/" #starts-with? [ 1 #drop ] when
  path-join
  dup extension for-extension swap
  [ read: stream-open dup stream-read-all swap stream-close ] try
  dup result:ok?
  [ unwrap-or-throw swap ok send-response ]
  [ drop drop not-found send-response ]
  if
] ;

\\ Start an HTTP server that serves static files from a directory.
\\
\\ Normalizes request paths to prevent directory traversal.
\\ Serves index.html for paths ending in /.
serve-static: ( host port doc-root -- ) [
  [ static-file-handler ] curry serve
] ;
