\ lib/net/uri.1z - URI parser and value type per RFC 3986 with a WHATWG overlay.

use "strings" ;
use "char" ;
use "conversions" ;
use "scanner" ;

\ === Internal data shape ===
\ The inner struct's auto-generated `>>` getters use field names prefixed
\ with `uri-` so that the public `scheme>> .. fragment>>` accessors below
\ do not collide with them when parsed. The `uri-has-*?` booleans record
\ whether the corresponding delimiter (`//`, `?`, `#`) appeared in the
\ parsed input, so `>string` reproduces the original byte sequence even
\ when a delimiter body is empty.

uri-data: struct{
  uri-scheme
  uri-has-authority? uri-authority uri-host uri-port
  uri-path
  uri-has-query? uri-query
  uri-has-fragment? uri-fragment
} ;

(uri-error): never-returns ( msg -- * ) [ f swap EInvalidArgument make-error throw ] ;

\ === Public type and constructors ===

\\ A parsed URI value. Components are stored raw exactly as they appeared
\\ in the parser input. Construct via the parsers (`parse`, `parse(rfc3986)`,
\\ `parse(whatwg)`) or the smart constructor `<uri>`.
uri: virtual{ uri-data } ;

\ Internal ten-argument constructor used by the parser. Stores the three
\ delimiter-presence bits as observed by the scanner stages.
(make-uri-raw): ( scheme has-authority? authority host port path has-query? query has-fragment? fragment -- uri ) [
  make-uri-data >uri
] ;

\\ Bare positional URI constructor used internally by the smart constructor.
\\ Derives the delimiter-presence bits from non-empty bodies: any non-empty
\\ authority/host/port marks `//` present, a non-empty query marks `?`
\\ present, a non-empty fragment marks `#` present. Public callers should
\\ prefer `<uri>`, which validates component shape.
make-uri: ( scheme authority host port path query fragment -- uri ) [
  dup #empty? not swap
  2 pick-n #empty? not 3 rot-n>
  7 pick-n #empty? not
  7 pick-n #empty? not or
  6 pick-n #empty? not or
  8 rot-n>
  (make-uri-raw)
] ;

\ === Public accessors ===

\\ Scheme component (text before the first `:`).
scheme>>: ( uri -- s ) [ unmake-uri uri-scheme>> ] ;

\\ Authority component (text between `//` and the next `/`, `?`, or `#`),
\\ including any `userinfo@` prefix and `:port` suffix.
authority>>: ( uri -- s ) [ unmake-uri uri-authority>> ] ;

\\ Host portion of the authority with `userinfo@` stripped and any port
\\ removed. IPv6 hosts retain their `[` and `]` brackets.
host>>: ( uri -- s ) [ unmake-uri uri-host>> ] ;

\\ Port portion of the authority as a digit string, or `""` when absent.
port>>: ( uri -- s ) [ unmake-uri uri-port>> ] ;

\\ Path component, from end of authority (or directly after `scheme:`) up
\\ to the next `?`, `#`, or end of input.
path>>: ( uri -- s ) [ unmake-uri uri-path>> ] ;

\\ Query component (without the leading `?`), or `""` when absent.
query>>: ( uri -- s ) [ unmake-uri uri-query>> ] ;

\\ Fragment component (without the leading `#`), or `""` when absent.
fragment>>: ( uri -- s ) [ unmake-uri uri-fragment>> ] ;

\ === Private presence accessors ===

(has-authority?>>): ( uri -- ? ) [ unmake-uri uri-has-authority?>> ] ;
(has-query?>>):     ( uri -- ? ) [ unmake-uri uri-has-query?>> ] ;
(has-fragment?>>):  ( uri -- ? ) [ unmake-uri uri-has-fragment?>> ] ;

\ === Scheme validation ===

\ RFC 3986: scheme = ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ).
(scheme-tail-char?): ( ch -- ? ) [
  dup alpha?
  over digit? or
  over "+" = or
  over "-" = or
  swap "." = or
] ;

(valid-rfc3986-scheme?): ( s -- ? ) [
  dup #len 0 = [ drop f ] [
    dup 0 #nth alpha?
    [ 1 over #len #slice [ (scheme-tail-char?) ] #all ]
    [ drop f ]
    if
  ] if
] ;

\ WHATWG-style scheme detection: alpha-start, no `/`, `?`, or `#` in the
\ rest. Used by the reference parser when scheme-byte validation is relaxed.
(valid-whatwg-scheme?): ( s -- ? ) [
  dup #len 0 = [ drop f ] [
    dup 0 #nth alpha?
    [ [ "/?#" swap #in? not ] #all ]
    [ drop f ]
    if
  ] if
] ;

(valid-port?): ( s -- ? ) [
  dup #len 0 = [ drop t ] [
    [ digit? ] #all
  ] if
] ;

\ === Authority decomposition ===
\ Authority shape: [ userinfo "@" ] host [ ":" port ]. Stored host preserves
\ any IPv6 brackets; userinfo (if any) appears in the raw authority but not
\ in host.

(strip-userinfo): ( authority -- host-port ) [
  dup "@" #index-of dup f =
  [ drop ]
  [ 1 + over #len #slice ]
  if
] ;

(bracketed-host-port): ( host-port -- host port ) [
  dup "]" #index-of dup f =
  [ drop "" ]
  [
    \ host-port idx
    2dup 1 + 0 swap #slice      \ host-port idx host
    -rot> 1 + over #len #slice  \ host rest
    dup #len 0 =
    [ drop "" ]
    [
      dup 0 #nth ":" =
      [ 1 over #len #slice ]
      [ drop "" ]
      if
    ]
    if
  ]
  if
] ;

(plain-host-port): ( host-port -- host port ) [
  dup ":" #index-of dup f =
  [ drop "" ]
  [
    2dup 0 swap #slice
    -rot> 1 + over #len #slice
  ]
  if
] ;

(split-host-port-raw): ( host-port -- host port ) [
  dup #len 0 =
  [ "" ]
  [
    dup 0 #nth "[" =
    [ (bracketed-host-port) ]
    [ (plain-host-port) ]
    if
  ]
  if
] ;

\ === Per-stage scanner readers ===
\ Each takes a scanner on top, returns the consumed component underneath
\ the scanner so the orchestrator can chain stages without juggling.

(read-scheme): ( scanner strict? -- scheme scanner ) [
  swap ":" take-until
  \ strict? scanner consumed
  dup f =
  [ 3drop "missing scheme separator" (uri-error) ]
  [
    dup #len 0 = [ 3drop "empty scheme" (uri-error) ] when
    \ strict? scanner consumed
    2 pick-n
    \ strict? scanner consumed strict?
    [ dup (valid-rfc3986-scheme?) not [ "invalid scheme" (uri-error) ] when ] when
    \ strict? scanner consumed
    [ ":" expect ] dip
    \ strict? scanner' consumed
    [ drop ] 2dip swap
  ]
  if
] ;

\ Like (read-scheme) but returns "" + the original scanner when the input
\ does not begin with a syntactically valid scheme followed by ":". Used by
\ the reference parser to allow scheme-absent inputs like "../foo" or "?y".
(read-scheme-or-not): ( scanner strict? -- scheme scanner ) [
  over rest          \ scanner strict? rest
  dup ":" #index-of  \ scanner strict? rest idx-or-f
  dup f =
  [
    \ No `:`: no scheme.
    drop drop drop "" swap
  ] [
    \ Slice the candidate prefix: rest[0..idx].
    1 pick-n 0 2 pick-n #slice  \ scanner strict? rest idx prefix
    nip nip                     \ scanner strict? prefix
    over
    \ scanner strict? prefix strict?
    [ (valid-rfc3986-scheme?) ]
    [ (valid-whatwg-scheme?) ]
    if
    \ scanner strict? valid?
    [
      \ Valid scheme prefix. Re-read in permissive mode to consume it
      \ along with the trailing ":" using the shared scanner stage.
      drop f (read-scheme)
    ] [
      \ Prefix is not a syntactically valid scheme. Treat as relative.
      drop "" swap
    ] if
  ] if
] ;

\ Reads "//authority" if present, splits into authority/host/port. Returns
\ five items below the scanner: has-authority? bit, authority, host, port,
\ then the scanner. The has-authority? bit records whether `//` was
\ consumed, even when the authority body is empty.
(read-authority-block): ( scanner -- has-authority? authority host port scanner ) [
  dup "//" skip-exact dup f =
  [
    drop f "" "" "" 4 <rot-n
  ]
  [
    nip
    [ "/?#" swap #in? not ] take-while
    \ scanner authority-raw
    dup (strip-userinfo) (split-host-port-raw)
    \ scanner authority host port
    3 <rot-n
    \ authority host port scanner
    t 4 rot-n>
  ]
  if
] ;

(read-path): ( scanner -- path scanner ) [
  [ "?#" swap #in? not ] take-while
  swap
] ;

(read-query): ( scanner -- has-query? query scanner ) [
  dup "?" skip-exact dup f =
  [ drop f "" 2 <rot-n ]
  [
    nip
    [ "#" = not ] take-while
    swap
    t 2 rot-n>
  ]
  if
] ;

(read-fragment): ( scanner -- has-fragment? fragment scanner ) [
  dup "#" skip-exact dup f =
  [ drop f "" 2 <rot-n ]
  [
    nip
    dup rest swap
    t 2 rot-n>
  ]
  if
] ;

(parse-uri-with-strictness): ( s strict? -- uri ) [
  swap <scanner> swap
  \ scanner strict?
  (read-scheme)
  \ scheme scanner
  (read-authority-block)
  \ scheme has-authority? authority host port scanner
  (read-path)
  \ scheme has-authority? authority host port path scanner
  (read-query)
  \ scheme has-authority? authority host port path has-query? query scanner
  (read-fragment)
  \ scheme has-authority? authority host port path has-query? query has-fragment? fragment scanner
  drop
  (make-uri-raw)
] ;

\ Parse a URI reference: either an absolute URI (with scheme) or a relative
\ reference (no scheme). The strict? flag controls scheme-byte validation
\ when a scheme is present. Used internally by the resolution words.
(parse-reference): ( s strict? -- uri ) [
  swap <scanner> swap
  (read-scheme-or-not)
  (read-authority-block)
  (read-path)
  (read-query)
  (read-fragment)
  drop
  (make-uri-raw)
] ;

\ === Parsers ===

\\ Parse an absolute URI per RFC 3986. Throws `EInvalidArgument` on a
\\ missing or invalid scheme, or any other structural malformation.
parse(rfc3986): ( s -- uri ) [ t (parse-uri-with-strictness) ] ;

\\ Parse an absolute URI with WHATWG-style permissiveness for the URL-shaped
\\ special schemes (`http`, `https`, `ws`, `wss`, `ftp`, `file`). URNs and
\\ other non-special schemes fall through to strict RFC 3986 parsing. The
\\ permissive path relaxes scheme-byte validation.
parse(whatwg): ( s -- uri ) [ f (parse-uri-with-strictness) ] ;

\\ Default parser: strict RFC 3986. Equivalent to `parse(rfc3986)`.
parse: ( s -- uri ) [ parse(rfc3986) ] ;

\ === Smart constructor ===

\\ Construct a `uri` value from raw components. Validates that the scheme
\\ matches the RFC 3986 production and the port is empty or all digits.
\\ Other components are accepted as raw bytes.
<uri>: ( scheme authority host port path query fragment -- uri ) [
  6 pick-n (valid-rfc3986-scheme?) not [ "invalid scheme" (uri-error) ] when
  3 pick-n (valid-port?) not [ "invalid port" (uri-error) ] when
  make-uri
] ;

\ === Option-returning parsers ===

\\ Option-returning `parse(rfc3986)`. Returns `option:some uri` on success
\\ and `option:none` on any malformed input.
parse?(rfc3986): ( s -- option ) [
  [ parse(rfc3986) >option:some ]
  [ drop option:none ]
  recover
] ;

\\ Option-returning `parse(whatwg)`. Returns `option:some uri` on success
\\ and `option:none` on any malformed input.
parse?(whatwg): ( s -- option ) [
  [ parse(whatwg) >option:some ]
  [ drop option:none ]
  recover
] ;

\\ Option-returning default parser. Equivalent to `parse?(rfc3986)`.
parse?: ( s -- option ) [ parse?(rfc3986) ] ;

\ === Reference resolution per RFC 3986 §5 ===

\ Drop the last segment (and its preceding "/" if any) from the output
\ buffer. Used by case C of remove-dot-segments.
(rds-pop-output): ( output -- output ) [
  "/" split
  dup #len 1 <=
  [ drop "" ]
  [ dup #len 1 - #take "/" #join ]
  if
] ;

\ Move the first path segment from the input buffer to the end of the
\ output buffer. A segment is the initial "/" (if any) plus subsequent
\ characters up to but not including the next "/" or end of input.
(rds-move): ( output input -- output input ) [
  dup 0 #nth "/" =
  [
    dup 1 over #len #slice "/" #index-of
    dup f =
    [ drop dup #len ]
    [ 1 + ]
    if
  ] [
    dup "/" #index-of
    dup f =
    [ drop dup #len ]
    [ ]
    if
  ] if
  \ output input segment-end
  2dup 0 swap #slice  \ output input segment-end segment
  -rot>               \ output segment input segment-end
  over #len #slice    \ output segment remaining
  [ #append ] dip     \ output' remaining
] ;

\ Walk the input buffer applying the RFC 3986 §5.2.4 cases until empty,
\ returning the accumulated output. Pre-dot-segment removal is required by
\ the reference-transform algorithm before assembling the resolved path.
(rds-loop): stack-recursive ( output input -- output ) [
  dup #empty?
  [ drop ]
  [
    dup "../" #starts-with?
    [ 3 over #len #slice (rds-loop) ]
    [
      dup "./" #starts-with?
      [ 2 over #len #slice (rds-loop) ]
      [
        dup "/./" #starts-with?
        [ 2 over #len #slice (rds-loop) ]
        [
          dup "/." =
          [ drop "/" (rds-loop) ]
          [
            dup "/../" #starts-with?
            [
              3 over #len #slice
              swap (rds-pop-output) swap
              (rds-loop)
            ]
            [
              dup "/.." =
              [
                drop "/"
                swap (rds-pop-output) swap
                (rds-loop)
              ]
              [
                dup "." =
                [ drop "" (rds-loop) ]
                [
                  dup ".." =
                  [ drop "" (rds-loop) ]
                  [ (rds-move) (rds-loop) ]
                  if
                ]
                if
              ]
              if
            ]
            if
          ]
          if
        ]
        if
      ]
      if
    ]
    if
  ]
  if
] ;

\\ Remove dot segments (".", "..", and the slash-prefixed forms) from a
\\ path per RFC 3986 §5.2.4. Used as the path-normalization step in URI
\\ reference resolution.
(remove-dot-segments): ( path -- path ) [
  "" swap (rds-loop)
] ;

\ Return the portion of a path up to and including its last "/", or "" if
\ there is no "/" in the path. Used by (merge-paths).
(path-up-to-last-slash): ( path -- prefix ) [
  "/" split
  dup #len 1 <=
  [ drop "" ]
  [
    dup #len 1 - #take
    "/" #join
    "/" #append
  ] if
] ;

\ Merge a base URI's path with a relative path per RFC 3986 §5.2.3.
(merge-paths): ( base-uri rel-path -- merged-path ) [
  over (has-authority?>>)
  2 pick-n path>> #empty?
  and
  [
    \ Base has authority and empty path: "/" + rel.
    nip "/" swap #append
  ] [
    swap path>>
    (path-up-to-last-slash)
    swap #append
  ] if
] ;

\ Case 1 builder: R has a scheme, so T uses every R component (with
\ dot-segment removal applied to R.path).
(build-case-1): ( R -- T ) [
  dup scheme>>
  1 pick-n (has-authority?>>)
  2 pick-n authority>>
  3 pick-n host>>
  4 pick-n port>>
  5 pick-n path>> (remove-dot-segments)
  6 pick-n (has-query?>>)
  7 pick-n query>>
  8 pick-n (has-fragment?>>)
  9 pick-n fragment>>
  10 <rot-n drop
  (make-uri-raw)
] ;

\ Case 2 builder: R has authority but no scheme. T.scheme inherits from B;
\ authority quartet, path (dot-cleaned), query, and fragment come from R.
(build-case-2): ( B R -- T ) [
  over scheme>>
  1 pick-n (has-authority?>>)
  2 pick-n authority>>
  3 pick-n host>>
  4 pick-n port>>
  5 pick-n path>> (remove-dot-segments)
  6 pick-n (has-query?>>)
  7 pick-n query>>
  8 pick-n (has-fragment?>>)
  9 pick-n fragment>>
  10 <rot-n drop
  10 <rot-n drop
  (make-uri-raw)
] ;

\ Helper for case 3's conditional query inheritance: if R.has-query, T
\ uses R's query pair, otherwise T uses B's. Identical fragment policy is
\ not applied here -- T always uses R's fragment pair.
(t-query-pair): ( B R -- has-query query ) [
  dup (has-query?>>)
  [
    nip dup (has-query?>>) swap query>>
  ] [
    drop dup (has-query?>>) swap query>>
  ] if
] ;

\ Case 3 builder: R has no scheme, no authority, empty path. T inherits
\ scheme, authority quartet, and path from B. Query inheritance flips on
\ whether R observed a "?".
(build-case-3): ( B R -- T ) [
  over scheme>>
  2 pick-n (has-authority?>>)
  3 pick-n authority>>
  4 pick-n host>>
  5 pick-n port>>
  6 pick-n path>>
  7 pick-n 7 pick-n (t-query-pair)
  8 pick-n (has-fragment?>>)
  9 pick-n fragment>>
  10 <rot-n drop
  10 <rot-n drop
  (make-uri-raw)
] ;

\ Case 4 builder: R has no scheme, no authority, absolute path. T inherits
\ scheme/authority from B; path is R.path dot-cleaned; query and fragment
\ come from R.
(build-case-4): ( B R -- T ) [
  over scheme>>
  2 pick-n (has-authority?>>)
  3 pick-n authority>>
  4 pick-n host>>
  5 pick-n port>>
  5 pick-n path>> (remove-dot-segments)
  6 pick-n (has-query?>>)
  7 pick-n query>>
  8 pick-n (has-fragment?>>)
  9 pick-n fragment>>
  10 <rot-n drop
  10 <rot-n drop
  (make-uri-raw)
] ;

\ Case 5 builder: R has no scheme, no authority, relative path. T inherits
\ scheme/authority from B; path is dot-cleaned after merging R.path against
\ B's path; query and fragment come from R.
(build-case-5): ( B R -- T ) [
  over scheme>>
  2 pick-n (has-authority?>>)
  3 pick-n authority>>
  4 pick-n host>>
  5 pick-n port>>
  6 pick-n 6 pick-n path>> (merge-paths) (remove-dot-segments)
  6 pick-n (has-query?>>)
  7 pick-n query>>
  8 pick-n (has-fragment?>>)
  9 pick-n fragment>>
  10 <rot-n drop
  10 <rot-n drop
  (make-uri-raw)
] ;

\ Apply the RFC 3986 §5.3 reference-transform table on a base URI and an
\ already-parsed reference, returning the resolved URI.
(transform-references): ( B R -- T ) [
  dup scheme>> #empty? not
  [
    nip (build-case-1)
  ] [
    dup (has-authority?>>)
    [
      (build-case-2)
    ] [
      dup path>> #empty?
      [
        (build-case-3)
      ] [
        dup path>> "/" #starts-with?
        [
          (build-case-4)
        ] [
          (build-case-5)
        ] if
      ] if
    ] if
  ] if
] ;

(resolve-impl): ( base rel-str strict? -- uri ) [
  (parse-reference)
  (transform-references)
] ;

\\ Resolve a relative reference string against a base URI per RFC 3986 §5.3.
\\ The reference is parsed with strict scheme-byte validation.
resolve(rfc3986): ( uri string -- uri ) [ t (resolve-impl) ] ;

\\ Resolve a relative reference string against a base URI. The reference is
\\ parsed with WHATWG-style scheme-byte permissiveness, but the resolution
\\ algorithm is the shared RFC 3986 §5.3 transform.
resolve(whatwg): ( uri string -- uri ) [ f (resolve-impl) ] ;

\\ Default resolver: strict RFC 3986. Equivalent to `resolve(rfc3986)`.
resolve: ( uri string -- uri ) [ resolve(rfc3986) ] ;

\ === Serialization ===

\ Write `str` to the builder stream beneath the uri, keeping `( uri stream )`
\ on the stack so successive writes can chain.
(write-component): ( uri stream str -- uri stream ) [
  over swap stream-write-string drop
] ;

\ Body for `>string`: append every component to a fresh string-builder using
\ the presence bits to suppress missing delimiters, then drain the builder.
(render-uri): ( uri -- s ) [
  [
    \ Stack: stream uri  (curry pushed uri on top of stream)
    swap
    \ uri stream
    over scheme>> (write-component)
    ":" (write-component)
    over (has-authority?>>)
    [
      "//" (write-component)
      over authority>> (write-component)
    ] when
    over path>> (write-component)
    over (has-query?>>)
    [
      "?" (write-component)
      over query>> (write-component)
    ] when
    over (has-fragment?>>)
    [
      "#" (write-component)
      over fragment>> (write-component)
    ] when
    drop drop
  ] curry using-string-builder
] ;

\\ Reconstruct the URI as a string. Components are joined with the standard
\\ delimiters (`scheme:`, `//`, `?`, `#`) following the presence bits the
\\ parser observed, so a value built by any of the `parse` variants produces
\\ a string byte-equal to the original input.
>string: method{ uri } [ (render-uri) ] ;

\ === Normalization per RFC 3986 §6 ===

\ Lowercase a single-character ASCII string in place. Bytes outside A-Z are
\ returned unchanged. Non-ASCII characters pass through.
(ascii-lower-char): ( ch -- ch ) [
  dup upper?
  [ >codepoint 32 + >char ]
  when
] ;

\ Lowercase ASCII letters in a string character-by-character; non-ASCII
\ bytes pass through. Used on scheme and host, which are guaranteed ASCII
\ after parsing.
(lower-loop): stack-recursive ( output input -- output ) [
  dup #empty?
  [ drop ]
  [
    dup 0 1 #slice (ascii-lower-char)
    swap 1 over #len #slice
    \ ( output lower-char input' )
    [ #append ] dip
    (lower-loop)
  ] if
] ;

(lower-ascii): ( s -- s ) [
  "" swap (lower-loop)
] ;

\ Map 0..15 to an uppercase hex character ("0".."9" / "A".."F").
(nibble>upper-hex-char): ( n -- ch ) [
  dup 10 < [ 48 + ] [ 55 + ] if >char
] ;

\ Decoded-byte value (0..255) is in the RFC 3986 unreserved set: A-Z / a-z /
\ 0-9 / "-" / "." / "_" / "~". Used to decide whether a `%HH` triple should
\ be replaced by its literal character.
(unreserved-codepoint?): ( n -- ? ) [
  >char
  dup alnum?
  [ drop t ] [
    dup "-" =
    over "." = or
    over "_" = or
    swap "~" = or
  ] if
] ;

\ Walk a percent-normalization pass over a string. At every `%HH` triple
\ whose two hex bytes parse cleanly, replace the triple with the literal
\ character if the decoded byte is in the unreserved set, otherwise keep
\ the triple but uppercase its hex digits. Anything else passes through
\ untouched: a bare `%` followed by fewer than two characters, or two
\ non-hex characters, are preserved as-is so already-broken input round-
\ trips rather than throwing during normalization.
\
\ Each branch lands the stack at `( output chunk input' )` where `chunk` is
\ the next bytes to append and `input'` is the remaining unread input, then
\ `[ #append ] dip` produces `( output++chunk input' )` for the recursive
\ tail call.
(pct-loop): stack-recursive ( output input -- output ) [
  dup #empty?
  [ drop ]
  [
    dup 0 #nth "%" =
    over #len 3 >= and
    [
      dup 1 #nth hex-digit?
      over 2 #nth hex-digit? and
      [
        dup 1 #nth hex>fixnum 4 shift-left
        over 2 #nth hex>fixnum bitor
        \ ( output input byte )
        dup (unreserved-codepoint?)
        [
          \ Replace triple with the literal character; advance 3.
          >char
          \ ( output input char )
          swap 3 over #len #slice
          \ ( output char input' )
        ] [
          \ Keep the triple but uppercase its hex digits; advance 3.
          dup 4 ushift-right (nibble>upper-hex-char)
          swap 15 bitand (nibble>upper-hex-char)
          \ ( output input hi lo )
          \ Build chunk = "%" + hi + lo.
          swap "%" swap #append swap #append
          \ ( output input chunk )
          swap 3 over #len #slice
          \ ( output chunk input' )
        ] if
      ] [
        \ Not a valid hex pair: copy "%" and advance 1.
        "%" swap 1 over #len #slice
        \ ( output "%" input' )
      ] if
    ] [
      \ Not `%` (or fewer than 3 chars left): copy one char and advance 1.
      dup 0 1 #slice
      swap 1 over #len #slice
      \ ( output first-char input' )
    ] if
    [ #append ] dip
    \ ( output' input' )
    (pct-loop)
  ] if
] ;

\\ Apply RFC 3986 §6.2.2.2 percent-encoding normalization to a string:
\\ `%HH` triples whose decoded byte is in the unreserved set become the
\\ literal byte; surviving triples have their hex digits uppercased.
(normalize-pct): ( s -- s ) [
  "" swap (pct-loop)
] ;

\ Return the default port for a scheme's hierarchical use, or `""` if the
\ scheme has no recognized default. The schemes covered are the ones whose
\ default ports are universally interoperable: http (80), https (443),
\ ws (80), wss (443), ftp (21).
(default-port-for): ( scheme -- port ) [
  dup "http" = [ drop "80" ] [
    dup "https" = [ drop "443" ] [
      dup "ws" = [ drop "80" ] [
        dup "wss" = [ drop "443" ] [
          dup "ftp" = [ drop "21" ] [
            drop ""
          ] if
        ] if
      ] if
    ] if
  ] if
] ;

\ Extract the userinfo (everything before the first `@`) from an authority
\ string, or `""` if no `@` is present.
(extract-userinfo): ( authority -- userinfo ) [
  dup "@" #index-of dup f =
  [ 2drop "" ]
  [ 0 swap #slice ]
  if
] ;

\ Re-derive the raw authority string from its parts: `[userinfo@]host[:port]`.
\ Components that are empty are omitted along with their delimiter.
(rebuild-authority): ( userinfo host port -- authority ) [
  \ Convert port to suffix (":port" or "").
  dup #empty? [ ] [ ":" swap #append ] if
  \ ( userinfo host port-suffix )

  \ Pull userinfo to top and convert to prefix ("userinfo@" or "").
  2 <rot-n
  dup #empty? [ ] [ "@" #append ] if
  \ ( host port-suffix userinfo-prefix )

  \ Pull host to top, then concatenate prefix + host + suffix.
  2 <rot-n
  \ ( port-suffix userinfo-prefix host )
  #append swap #append
] ;

\ Per-component normalizers that each take a `uri` and return a single
\ transformed component. Splitting these out keeps (normalize-impl) free of
\ deep stack juggling.

(norm-scheme): ( uri -- s ) [ scheme>> (lower-ascii) ] ;

(norm-host): ( uri -- s ) [ host>> (lower-ascii) (normalize-pct) ] ;

\ Effective port: empty if the stored port matches the scheme's default.
(norm-port): ( uri -- s ) [
  dup port>>
  swap (norm-scheme) (default-port-for)
  over = [ drop "" ] when
] ;

\ Rebuild the authority string from the normalized userinfo, host, and port.
(norm-authority): ( uri -- s ) [
  dup authority>> (extract-userinfo) (normalize-pct)
  over (norm-host)
  \ Stack: uri userinfo' host'. Pull uri to the top via 3-rot, then apply
  \ (norm-port) so we end with ( userinfo' host' port' ) for the join.
  <rot- (norm-port)
  (rebuild-authority)
] ;

\ Path: percent-normalize, remove dot segments, then hoist an empty path on
\ a URI that has an authority to "/" per RFC 3986 §6.2.3.
(norm-path): ( uri -- s ) [
  dup path>> (normalize-pct) (remove-dot-segments)
  swap (has-authority?>>)
  [ dup #empty? [ drop "/" ] when ] when
] ;

(norm-query): ( uri -- s ) [ query>> (normalize-pct) ] ;

(norm-fragment): ( uri -- s ) [ fragment>> (normalize-pct) ] ;

\ Shared normalization implementation. Both public normalize variants
\ delegate here; the variant seam exists for future per-mode behavior such
\ as differing percent-encoding sets or special-scheme handling.
(normalize-impl): ( uri -- uri ) [
  dup (norm-scheme)
  1 pick-n (has-authority?>>)
  2 pick-n (norm-authority)
  3 pick-n (norm-host)
  4 pick-n (norm-port)
  5 pick-n (norm-path)
  6 pick-n (has-query?>>)
  7 pick-n (norm-query)
  8 pick-n (has-fragment?>>)
  9 pick-n (norm-fragment)
  10 <rot-n drop
  (make-uri-raw)
] ;

\\ Apply RFC 3986 §6 normalization. Both syntax-based (§6.2.2) and scheme-
\\ based (§6.2.3) rules fire: scheme and host lowercased; `%HH` triples
\\ whose decoded byte is unreserved replaced with the literal byte;
\\ surviving triples uppercased; path normalized via dot-segment removal;
\\ default ports for the recognized scheme set (`http`/`https`/`ws`/`wss`/
\\ `ftp`) elided; empty path on a hierarchical URI hoisted to `/`.
normalize(rfc3986): ( uri -- uri ) [ (normalize-impl) ] ;

\\ Apply WHATWG URL normalization.
\\
\\ The output matches `normalize(rfc3986)` exactly; the variant word exists
\\ as a stable seam for future WHATWG-specific behavior such as percent-
\\ encoding sets or `file://` handling.
normalize(whatwg): ( uri -- uri ) [ (normalize-impl) ] ;

\\ Default normalizer: strict RFC 3986. Equivalent to `normalize(rfc3986)`.
normalize: ( uri -- uri ) [ normalize(rfc3986) ] ;

\ === Query helpers (re-exported from lib/data/url.1z) ===
\ Structured access to the `?…` body lives next to the percent codec; this
\ module re-exports the two words so a caller that already imported uri
\ does not need a second `use` for them. The url module is bound under a
\ private name and the forwarders defer through qualified access so the
\ underlying helpers resolve through url.1z's own deps frame.

(url-codec): "data/url" load ;

\\ Decode an `application/x-www-form-urlencoded` body into a hash mapping
\\ each decoded key to an array of decoded values. Re-exported from
\\ `lib/data/url.1z`; see `url.decode-query` for the full contract.
decode-query: ( string -- hash ) [ (url-codec).decode-query ] ;

\\ Encode a hash whose values are arrays of strings into an
\\ `application/x-www-form-urlencoded` body. Re-exported from
\\ `lib/data/url.1z`; see `url.encode-query` for the full contract.
encode-query: ( hash -- string ) [ (url-codec).encode-query ] ;
