\ lib/game/draw.1z - Drawing words over the browser game platform's framebuffer
\
\ The host provides one drawing primitive: present a linear memory buffer to the canvas. Every
\ actual drawing operation here -- pixels, rectangles, sprites, text -- is composed in 1z over
\ that single buffer. The native `(wasm-framebuffer)` word (src/capi_wasm.zig) is the only
\ Zig-level piece: a borrowed, mutable byte-array view over the wasm-owned framebuffer memory.
\
\ A named `name: swap ;` local bound to a struct is retained until the program exits, so the
\ drawing words destructure a color or a sprite before binding.
\
\ A contiguous run of pixels moves in one call rather than a loop. clear-background covers the
\ whole canvas with one #fill32!, draw-rectangle takes one per row, and blit-sprite copies a
\ sprite row at a time with #copy!.
\
\ The constants below carry `const inline`, so a read is a push of the value in the reading body
\ rather than a word dispatch. A loop body reads them where it needs them.
\
\ A region is clipped against the canvas once, before the loop, so the body writes without
\ testing each pixel. tests/benchmark/game_draw.1z and tests/benchmark/minesweeper_reset.1z
\ track the numbers.
\
\ (set-pixel!) keeps the per-pixel clip test and stays the general path. The glyph loop below relies
\ on that test to discard unset bits when a glyph hangs off the canvas.

use "ranges" ;
use "sequences" ;
use "bytes" ;
use "game/font" ;

\\ The canvas width in pixels.
framebuffer-width: const inline 256 ;

\\ The canvas height in pixels.
framebuffer-height: const inline 224 ;

\\ Bytes per framebuffer pixel: one each of red, green, blue, and alpha, in that order.
framebuffer-bytes-per-pixel: const inline 4 ;

\\ The byte-array every drawing word writes into. Defaults to the real wasm framebuffer; tests
\\ (and any non-wasm caller) rebind it to a scratch buffer via with-parameter, since
\\ (wasm-framebuffer) only exists under the wasm C-API root.
\\
\\ `inline` copies the push of the handle, never the binding. A reader still runs the whole of
\\ `get`, so with-parameter keeps its full effect.
current-framebuffer: const inline parameter{ [ (wasm-framebuffer) ] } ;

\\ An RGBA color with each component from 0 to 255. Build one with `<color>`, which checks the
\\ range.
color: struct{ r: fixnum g: fixnum b: fixnum a: fixnum } ;

\\ A width by height image whose pixels are RGBA8888 bytes in row-major order, the framebuffer's
\\ own layout. Build one with `<sprite>`, which checks the length.
sprite: struct{ width: fixnum height: fixnum pixels: byte-array } ;

private{
  (byte-range?): ( n -- ? ) [ dup 0 >= swap 255 <= and ] ;
}

\\ Validate r/g/b/a are each in [0, 255] and construct a color.
\\
\\   1 2 3 4 <color> g>>
\\   => 2
<color>: ( r: fixnum g: fixnum b: fixnum a: fixnum -- color ) [
  bind-inputs
  r (byte-range?) g (byte-range?) and b (byte-range?) and a (byte-range?) and
  not [ f "<color> components must be in [0, 255]" EInvalidArgument make-error throw ] when
  r g b a make-color
] ;

\\ Validate width/height are non-negative and pixels' length matches width * height * 4
\\ (RGBA8888, the same layout the framebuffer uses), then construct a sprite.
\\
\\   2 1 B{ 1 2 3 4 5 6 7 8 } <sprite> width>>
\\   => 2
<sprite>: ( width: fixnum height: fixnum pixels: byte-array -- sprite ) [
  sp: swap ;
  sh: swap ;
  sw: swap ;
  sw 0 >= sh 0 >= and sp #len sw sh * framebuffer-bytes-per-pixel * = and
  not [ f "<sprite> requires non-negative width/height and pixels length == width * height * 4" EInvalidArgument make-error throw ] when
  sw sh sp make-sprite
] ;

private{
  \\ Pack a color's r/g/b/a components into one framebuffer-native fixnum. Little-endian
  \\ RGBA8888: r lands in the lowest byte, matching #poke32!'s least-significant-byte-first
  \\ write order, so r/g/b/a end up in that order in memory.
  (color>packed): ( color: color -- packed ) [
    dup r>> cr: swap ;
    dup g>> cg: swap ;
    dup b>> cb: swap ;
    a>> ca: swap ;
    cr cg 8 shift-left bitor cb 16 shift-left bitor ca 24 shift-left bitor
  ] ;

  \\ Write one packed RGBA8888 pixel into fb at (x, y), silently clipped if outside the canvas
  \\ -- the standard convention for a 2D framebuffer API.
  \\
  \\ The framebuffer arrives as an argument rather than being read here, so a caller reads
  \\ current-framebuffer once and passes the same buffer to every pixel of a glyph.
  \\
  \\ Nothing is returned, which keeps the call in tail position at both call sites. A returned
  \\ buffer would cost the caller a drop, and a drop after the call is what turns a free tail
  \\ call into an interpreter frame.
  \\
  \\ No name: swap ; locals at all: x and y are threaded through via dup/over/swap under dip.
  \\ This word is called once per pixel, up to tens of thousands of times per draw call.
  (set-pixel!): ( fb x y packed -- ) [
    [
      dup 0 >= over framebuffer-height < and
      [
        framebuffer-width *
        swap
        dup 0 >= over framebuffer-width < and
        [ + framebuffer-bytes-per-pixel * ] [ drop drop -1 ] if
      ] [ drop drop -1 ] if
    ] dip
    over 0 >=
    [ #poke32! drop ] [ drop drop drop ] if
  ] ;
}

\\ Draw one pixel at (x, y). A pixel outside the canvas is silently skipped.
\\
\\ 3 rot-n> buries the framebuffer under the coordinates, since (set-pixel!) takes it first.
\\
\\   framebuffer-width framebuffer-height * 4 * bytes-alloc current-framebuffer [
\\     10 20 255 0 0 255 <color> draw-pixel
\\     current-framebuffer get 20 framebuffer-width * 10 + 4 * #nth .
\\   ] with-parameter
\\   => 255
draw-pixel: ( x y color -- ) [ (color>packed) current-framebuffer get 3 rot-n> (set-pixel!) ] ;

\\ Fill the entire framebuffer with one color.
\\
\\ The canvas is one contiguous run of pixels, so this needs no coordinate arithmetic and no
\\ clipping: one fill covers the whole buffer.
clear-background: ( color -- ) [
  (color>packed)
  [ current-framebuffer get 0 ] dip
  framebuffer-width framebuffer-height * #fill32! drop
] ;

\\ Fill an axis-aligned rectangle. width/height must be non-negative. A rectangle reaching past
\\ the canvas is clipped, the standard convention for a 2D framebuffer API.
\\
\\   framebuffer-width framebuffer-height * 4 * bytes-alloc current-framebuffer [
\\     2 3 4 5 0 255 0 255 <color> draw-rectangle
\\     current-framebuffer get 5 framebuffer-width * 4 + 4 * 1 + #nth .
\\   ] with-parameter
\\   => 255
draw-rectangle: ( x: fixnum y: fixnum width: fixnum height: fixnum color: color -- ) [
  (color>packed)
  rp: swap ;
  rh: swap ;
  rw: swap ;
  ry: swap ;
  rx: swap ;
  rw 0 >= rh 0 >= and
  not [ f "draw-rectangle requires non-negative width and height" EInvalidArgument make-error throw ] when

  cx: rx 0 max ;
  cy: ry 0 max ;
  cw: rx rw + framebuffer-width min cx - ;
  ch: ry rh + framebuffer-height min cy - ;

  cw 0 > ch 0 > and [
    current-framebuffer get
    ch iota >iterator [
      cy + framebuffer-width * cx + framebuffer-bytes-per-pixel * rp cw #fill32!
    ] #each
    drop
  ] when
] ;

\\ Copy a sprite's RGBA8888 pixels into current-framebuffer at (x, y). An opaque copy: alpha is
\\ carried through as-is, with no blending against the destination.
\\
\\ One #copy! per row. A row is contiguous on both sides, but the two strides differ -- the
\\ framebuffer's is the canvas width and the sprite's is its own -- so the rows cannot merge into
\\ one call.
\\
\\ The sprite is destructured into its three fields before any local binds, because a local bound
\\ to the sprite itself would be retained for the rest of the program while a local bound to its
\\ pixel byte-array is reclaimed when this call returns.
\\
\\   framebuffer-width framebuffer-height * 4 * bytes-alloc current-framebuffer [
\\     0 0 2 1 B{ 1 2 3 4 5 6 7 8 } <sprite> blit-sprite
\\     current-framebuffer get 4 #nth .
\\   ] with-parameter
\\   => 5
blit-sprite: ( x: fixnum y: fixnum sprite: sprite -- ) [
  dup width>> bw: swap ;
  dup height>> bh: swap ;
  pixels>> bs: swap ;
  by: swap ;
  bx: swap ;

  cx: bx 0 max ;
  cy: by 0 max ;
  cw: bx bw + framebuffer-width min cx - ;
  ch: by bh + framebuffer-height min cy - ;

  cw 0 > ch 0 > and [
    rowb: cw framebuffer-bytes-per-pixel * ;
    current-framebuffer get
    ch iota >iterator [
      r: swap ;
      dbase: r cy + framebuffer-width * cx + framebuffer-bytes-per-pixel * ;
      sbase: r cy + by - bw * cx bx - + framebuffer-bytes-per-pixel * ;
      dbase bs sbase rowb #copy!
    ] #each
    drop
  ] when
] ;

private{
  \ A glyph row's bit for column c is `(row >> c) & 1`, so column zero is the leftmost.

  \\ The glyph loop for a cell that sits entirely on the canvas: one row byte read per row instead
  \\ of per pixel, and a direct write per set bit with no clip test. This is the path all ordinary
  \\ text takes.
  (draw-glyph-whole): ( offset x y packed -- ) [
    gp:   swap ;
    gy:   swap ;
    gx:   swap ;
    goff: swap ;
    current-framebuffer get
    font-cell-size iota >iterator [
      gr:   swap ;
      row:  font-glyph-bytes goff gr + #peek8 ;
      base: gy gr + framebuffer-width * gx + framebuffer-bytes-per-pixel * ;
      font-cell-size iota >iterator [
        gc: swap ;
        row gc shift-right 1 bitand 1 =
        [ gc framebuffer-bytes-per-pixel * base + gp #poke32! ] when
      ] #each
    ] #each
    drop
  ] ;

  \\ The glyph loop for a cell hanging off an edge. An unset bit steers (set-pixel!) to (-1, -1),
  \\ which its own bounds check clips as a no-op, so one test covers both the unset bits and the
  \\ overhang.
  \\
  \\ The framebuffer is read once and bound, rather than read inside the loop. A local read is a
  \\ word dispatch, but the parameter read it replaces runs the parameter's default quotation
  \\ wherever the framebuffer is unbound, which is every browser frame.
  (draw-glyph-clipped): ( offset x y packed -- ) [
    cp2:  swap ;
    cy2:  swap ;
    cx2:  swap ;
    coff: swap ;
    cfb:  current-framebuffer get ;
    font-cell-size font-cell-size * iota >iterator [
      di: swap ;
      font-glyph-bytes coff di font-cell-size div + #peek8
      di font-cell-size % shift-right 1 bitand
      bit: swap ;
      cfb
      cx2 di font-cell-size % + 1 + bit * 1 -
      cy2 di font-cell-size div + 1 + bit * 1 -
      cp2
      (set-pixel!)
    ] #each
  ] ;

  \\ Draw one glyph from an already-packed color. The shared body under draw-char and
  \\ draw-text: both pack the color before any local binds it, because a named local bound
  \\ to a color struct is retained until the program exits, and text is drawn every frame.
  (draw-glyph-packed): ( x: fixnum y: fixnum ch: string packed: fixnum -- ) [
    dp:  swap ;
    dch: swap ;
    dy:  swap ;
    dx:  swap ;
    dch >codepoint (font-glyph-offset)
    dup f =
    [
      drop
    ] [
      doff: swap ;
      dx 0 >= dy 0 >= and
      dx font-cell-size + framebuffer-width <= and
      dy font-cell-size + framebuffer-height <= and
      [ doff dx dy dp (draw-glyph-whole) ]
      [ doff dx dy dp (draw-glyph-clipped) ]
      if
    ] if
  ] ;
}

\\ Draw one character's glyph at (x, y). Characters outside the font's covered range
\\ (0x20-0x7E) are silently skipped. Background pixels (unset glyph bits) are transparent --
\\ not drawn in any background color.
\\
\\   framebuffer-width framebuffer-height * 4 * bytes-alloc current-framebuffer [
\\     0 0 "A" 255 255 255 255 <color> draw-char
\\     current-framebuffer get 2 4 * #nth .
\\   ] with-parameter
\\   => 255
draw-char: ( x y ch color -- ) [ (color>packed) (draw-glyph-packed) ] ;

\\ Draw a string starting at (x, y), advancing by font-cell-size pixels per character.
\\ Characters outside the font's covered range are silently skipped (via draw-char's glyph
\\ lookup).
\\
\\   framebuffer-width framebuffer-height * 4 * bytes-alloc current-framebuffer [
\\     0 0 "AB" 255 255 255 255 <color> draw-text
\\     current-framebuffer get 10 4 * #nth .
\\   ] with-parameter
\\   => 255
draw-text: ( x: fixnum y: fixnum str: string color: color -- ) [
  (color>packed)
  tp: swap ;
  ts: swap ;
  ty: swap ;
  tx: swap ;
  ts #len iota >iterator [
    ti: swap ;
    tx ti font-cell-size * +
    ty
    ts ti #nth
    tp
    (draw-glyph-packed)
  ] #each
] ;

pragma{ lint-suppress: { broad-import: dead-definition: import-ordering: missing-type-annotation: unused-import: } }
