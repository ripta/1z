\ lib/game/input.1z - Keyboard and mouse input for the browser game platform
\
\ Held-key state crosses the host boundary as a shared-memory byte array: the browser's
\ keydown/keyup listeners write directly into wasm linear memory at a fixed key index, so
\ key-down? is a pure local byte-array read with no host call. key-pressed?/key-released? are
\ pure 1z-level words that diff current-keyboard against a snapshot of the previous tick's,
\ advanced once per update tick by advance-keyboard-frame -- not a second host mechanism, the
\ same "host provides one primitive, 1z composes everything above it" shape game/draw.1z's
\ framebuffer already uses.
\
\ Keys are named as kebab-cased KeyboardEvent.code values -- the physical/positional key, not
\ the layout-dependent character -- matching every browser game framework's convention.
\
\ The mouse crosses the same way, through a second shared byte array, but a click is not a key.
\ A held key survives any number of slow frames, so sampling it at update ticks loses nothing.
\ A click's button-down lasts tens of milliseconds and can begin and end inside one slow frame,
\ where sampling would never see it. So the mouse buffer carries sampled state (the pointer
\ position, an inside-canvas flag, a held-button bitmap) alongside a ring of button events that
\ the browser appends to and advance-mouse-frame drains once per update tick, so no click is
\ lost at any frame time.

use "bytes" ;
use "ranges" ;
use "sequences" ;

\\ The byte array JS writes into: one byte per tracked key, 0 = up, nonzero = down. Defaults to
\\ the real wasm keyboard buffer; tests (and any non-wasm caller) rebind it to a scratch buffer
\\ via with-parameter, since (wasm-keyboard) only exists under the wasm C-API root.
current-keyboard: parameter{ [ (wasm-keyboard) ] } ;

private{
  \\ Maps each tracked key's name to its byte offset in current-keyboard and
  \\ keyboard-previous. The index assignment is a private contract with the JS host harness
  \\ (examples/wasm-game/host.js's KEY_INDEX table) and with capi_wasm.zig's
  \\ keyboard_key_count -- all three must agree on the same 48 entries.
  key-index: H{
    arrow-up:   0 arrow-down: 1 arrow-left: 2 arrow-right: 3
    key-a:      4 key-b: 5 key-c: 6 key-d: 7 key-e: 8 key-f: 9 key-g: 10 key-h: 11 key-i: 12
    key-j:      13 key-k: 14 key-l: 15 key-m: 16 key-n: 17 key-o: 18 key-p: 19 key-q: 20 key-r: 21
    key-s:      22 key-t: 23 key-u: 24 key-v: 25 key-w: 26 key-x: 27 key-y: 28 key-z: 29
    digit-0:    30 digit-1: 31 digit-2: 32 digit-3: 33 digit-4: 34 digit-5: 35 digit-6: 36
    digit-7:    37 digit-8: 38 digit-9: 39
    space:      40 enter: 41 escape: 42 tab: 43
    shift-left: 44 shift-right: 45 control-left: 46 control-right: 47
  } ;

  key-count: ( -- n ) const [ key-index @keys #len ] ;

  \\ Previous frame's keyboard snapshot, for edge detection. A bracket-less top-level local:
  \\ its initializer runs once, when this module loads, and every later reference resolves to
  \\ the same mutable byte array, mirroring game/loop's game-loop instance.
  keyboard-previous: key-count bytes-alloc ;
}

\\ True if key is currently held down. A pure local byte-array read; no host call. Throws if
\\ key is not one of the tracked names.
key-down?: ( key: symbol -- bool ) [
  key-index swap @get
  current-keyboard get swap #peek8
  0 = not
] ;

\\ True the first update tick key reads as down after being up -- a rising edge. Diffs
\\ current-keyboard against keyboard-previous, the snapshot advance-keyboard-frame refreshes
\\ once per tick, so a held key reads pressed on only one tick even during a multi-tick
\\ catch-up burst.
key-pressed?: ( key: symbol -- bool ) [
  key-index swap @get
  dup current-keyboard get swap #peek8 0 = not
  swap keyboard-previous swap #peek8 0 =
  and
] ;

\\ True the first update tick key reads as up after being down -- a falling edge. See
\\ key-pressed?.
key-released?: ( key: symbol -- bool ) [
  key-index swap @get
  dup current-keyboard get swap #peek8 0 =
  swap keyboard-previous swap #peek8 0 = not
  and
] ;

\\ Copies current-keyboard into keyboard-previous. Called once per update tick by game/loop's
\\ run-frame, right after that tick's update call, so a held key's key-pressed?/key-released?
\\ result changes on the very next tick rather than staying true for an entire multi-tick
\\ catch-up burst; not meant to be called directly by game code.
\\
\\ Zero name: swap ; locals in the per-key quotation: called key-count times per update tick,
\\ and update ticks run at up to 60Hz (higher still during a catch-up burst), so a named
\\ local here leaks memory in proportion to call count -- see the workaround note on
\\ (set-pixel!) in game/draw.1z.
advance-keyboard-frame: ( -- ) [
  current-keyboard get
  [ over #peek8 keyboard-previous -rot> #poke8! drop ] curry
  key-count iota >iterator
  swap #each
] ;

\\ The byte array JS writes pointer state and button events into. Defaults to the real wasm
\\ mouse buffer; tests (and any non-wasm caller) rebind it to a scratch buffer via
\\ with-parameter, since (wasm-mouse) only exists under the wasm C-API root.
current-mouse: parameter{ [ (wasm-mouse) ] } ;

\\ One button press or release drained from the host's event ring. button is left:, middle:,
\\ or right:. kind is press: or release:. x and y are framebuffer pixels, and inside is whether
\\ the pointer was over the canvas at the event; when it was not, x and y hold the pointer's
\\ last in-canvas position.
mouse-event: struct{ button: symbol kind: symbol x: fixnum y: fixnum inside: boolean } ;

private{
  \ Byte layout of current-mouse. A private contract with the JS host harness
  \ (examples/wasm-game/host.js's MOUSE table); capi_wasm.zig only sizes the buffer, at
  \ mouse-buffer-length. Multi-byte fields are little-endian and unsigned.
  \
  \ Header: x at 0 and y at 2 (2 bytes each), inside at 4, the held-button bitmap at 5, the
  \ ring's write index at 6 and read index at 7, the dropped-event counter at 8 (2 bytes).
  \ Slots start at 16, 8 bytes each: button id, kind (1 press, 0 release), inside, a reserved
  \ byte, then x and y (2 bytes each).
  \
  \ Both indices are free-running byte counters. JS advances the write index as it appends;
  \ advance-mouse-frame advances the read index as it drains. A slot is its index modulo the
  \ ring capacity, and the pending count is the difference modulo 256.
  mouse-x-offset:       ( -- n ) const [ 0 ] ;
  mouse-y-offset:       ( -- n ) const [ 2 ] ;
  mouse-inside-offset:  ( -- n ) const [ 4 ] ;
  mouse-buttons-offset: ( -- n ) const [ 5 ] ;
  mouse-write-offset:   ( -- n ) const [ 6 ] ;
  mouse-read-offset:    ( -- n ) const [ 7 ] ;
  mouse-dropped-offset: ( -- n ) const [ 8 ] ;
  mouse-ring-offset:    ( -- n ) const [ 16 ] ;
  mouse-ring-capacity:  ( -- n ) const [ 32 ] ;
  mouse-slot-length:    ( -- n ) const [ 8 ] ;
  mouse-buffer-length:  ( -- n ) const [ mouse-ring-offset mouse-ring-capacity mouse-slot-length * + ] ;

  \\ Maps each button's name to its id, the slot's button byte. Its held-bitmap bit is 1
  \\ shifted left by the id.
  mouse-button-index: H{ left: 0 middle: 1 right: 2 } ;

  \\ The inverse of mouse-button-index, indexed by id.
  mouse-button-name: { left: middle: right: } ;

  \\ The one shared empty array a drain with nothing pending stores, so an idle tick
  \\ allocates nothing.
  (no-mouse-events): ( -- array ) const [ { } ] ;

  mouse-state: mutable struct{ events } ;

  \\ The events the most recent drain produced. A bracket-less top-level local, one instance
  \\ per module load, mirroring keyboard-previous.
  mouse-frame: (no-mouse-events) make-mouse-state ;

  (mouse-read-index): ( buf -- n ) [ mouse-read-offset #peek8 ] ;
  (mouse-write-index): ( buf -- n ) [ mouse-write-offset #peek8 ] ;

  \\ How many slots JS has appended that have not been drained: write minus read, modulo 256.
  (mouse-pending-count): ( buf -- n ) [
    dup (mouse-write-index) swap (mouse-read-index) - 256 + 256 %
  ] ;

  \\ Decodes the slot at a ring position into a mouse-event.
  (mouse-event-at): ( buf slot -- event ) [
    mouse-slot-length * mouse-ring-offset +
    [ #peek8 mouse-button-name swap #nth ] 2keep
    [ 1 + #peek8 0 = [ release: ] [ press: ] if ] 2keep
    [ 4 + #peek16 ] 2keep
    [ 6 + #peek16 ] 2keep
    2 + #peek8 0 = not
    make-mouse-event
  ] ;
}

\\ The pointer's position in framebuffer pixels. While the pointer is off the canvas
\\ (mouse-inside? is false), this is its last in-canvas position.
mouse-position: ( -- x y ) [
  current-mouse get dup mouse-x-offset #peek16 swap mouse-y-offset #peek16
] ;

\\ True while the pointer is over the canvas.
mouse-inside?: ( -- bool ) [
  current-mouse get mouse-inside-offset #peek8 0 = not
] ;

\\ True if button (left:, middle:, or right:) is currently held. A pure local read of the
\\ held-button bitmap; no host call. Throws if button is not one of the three names.
mouse-down?: ( button: symbol -- bool ) [
  mouse-button-index swap @get 1 swap shift-left
  current-mouse get mouse-buttons-offset #peek8
  bitand 0 = not
] ;

\\ The button events advance-mouse-frame drained at the start of the most recent update tick,
\\ oldest first. Empty on a tick with nothing pending. Read this from a game's update
\\ quotation; every tick of a catch-up burst after the first sees an empty array, so a click
\\ is handled exactly once.
mouse-events: ( -- array ) [ mouse-frame events>> ] ;

\\ True for a press event, false for a release.
pressed?: ( event: mouse-event -- bool ) [ kind>> press: = ] ;

\\ How many button events the host has dropped because the ring was full, cumulative since
\\ load and wrapping at 65536. The platform drains once per update tick, so this only grows
\\ when more events than the ring holds arrive between two ticks.
mouse-dropped-events: ( -- n ) [
  current-mouse get mouse-dropped-offset #peek16
] ;

\\ Drains every pending slot of the ring into mouse-events and advances the read index to
\\ meet the write index. Called once per update tick by game/loop's run-frame, right before
\\ that tick's update call; not meant to be called directly by game code.
\\
\\ Zero name: swap ; locals, for the same reason as advance-keyboard-frame: the read index and
\\ the buffer are curried into the slot decoder instead.
advance-mouse-frame: ( -- ) [
  current-mouse get dup (mouse-pending-count)
  dup 0 = [
    2drop mouse-frame (no-mouse-events) >>events drop
  ] [
    over (mouse-read-index) [ + mouse-ring-capacity % ] curry
    pick [ swap (mouse-event-at) ] curry compose
    swap iota >iterator swap #map #collect
    mouse-frame swap >>events drop
    dup (mouse-write-index) mouse-read-offset swap #poke8! drop
  ] if
] ;
