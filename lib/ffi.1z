\ lib/ffi.1z - FFI signature descriptor and convenience wrappers

ffi-sig: struct{
  params:      array
  return-type: string
  errno:       any
  cap: any
} ;

\\ Parse-time word for FFI signature descriptors.
\\
\\ The form:
\\
\\     ffi{ i32 i32 -> i32 }
\\
\\ produces an ffi-sig with params { "i32" "i32" } and return-type i32.
\\
\\ If no `->` is present, then the return type defaults to "void".
\\ The errno and cap fields default to f.
\\ The form `ffi-def{` populates them from an options hash.
ffi{: parse-time [
  (read-ffi-params): ( accum -- params return-type ) [
    peek-token
    dup "->" = [
      drop parse-token drop
      peek-token
      dup "}" = [
        drop parse-token drop
        "void"
      ] [
        drop parse-token
        parse-token drop
      ] if
    ] [
      dup "}" = [
        drop parse-token drop
        "void"
      ] [
        drop parse-token
        1array #append (read-ffi-params)
      ] if
    ] if
  ] ;

  { } (read-ffi-params) f f make-ffi-sig
] ;

\\ Parse-time word for FFI struct layout descriptors.
\\ ffi-struct{ x: f32 y: f32 } produces a virtual type backed by a byte array
\\ with field offsets computed via libffi.
ffi-struct{: parse-time [
  M{ type: ffi-struct-descriptor: }
  fields: "}" parse-tokens-until @set!
  define: [ define-ffi-struct ] @set!
] ;

\\ Open a shared library by path or short name.
lib-open: ( path-or-name -- dylib ) [ native.lib-open ] ;

\\ Look up a symbol in a shared library. Use bound-symbol for a one-shot lookup+bind.
lib-symbol: ( dylib name -- ffi-fn ) [ native.lib-symbol ] ;

\\ Attach an FFI signature to an ffi-fn resource. Use bound-symbol for a one-shot lookup+bind.
bind-sig: ( ffi-fn sig -- ffi-fn ) [ native.bind-sig ] ;

\\ Convenience wrapper to look up a symbol and bind a signature in one step.
bound-symbol: ( dylib name sig -- ffi-fn ) [
  -rot> lib-symbol
  swap bind-sig
] ;

\\ Call a foreign function via libffi.
\\ Arguments are consumed from the stack based on the bound signature.
ffi-call: ( ..args ffi-fn -- result ) [ native.ffi-call ] ;

\\ Bind an FFI close function to a resource.
\\ The ffi-fn must have exactly one ptr parameter; any return type is accepted and discarded.
\\ When resource-close is called, the bound function is invoked via libffi.
bind-close: ( resource ffi-fn -- ) [ native.bind-close ] ;

\\ Create a C-callable function pointer from a 1z quotation and FFI signature.
\\ The returned resource can be passed as a ptr:ffi-callback argument to ffi-call.
\\ Close the resource when done to free the closure memory.
ffi-callback: ( quotation sig -- ffi-callback ) [ f f native.ffi-callback ] ;

\\ Like ffi-callback, but with an error hook bound at creation.
\\
\\ When the callback fails for any reason -- the quotation throws, an argument cannot be
\\ unmarshalled, or the result cannot be marshalled -- the trampoline invokes hook from its
\\ boundary frame instead of only stashing the error.
\\
\\ `hook` is an `ffi-fn` symbol with the C signature:
\\
\\    void hook(void *arg0, void *userdata, const char *message)
\\
\\ arg0 is the callback's first argument when its declared type is ptr, else NULL.
\\ userdata is a resource whose pointer is passed through, or f for NULL.
\\ message is the 1z error message.
\\
\\ The Zig stack has fully unwound when the hook runs, so the hook may raise the C library's own
\\ non-local error, such as lua_error's longjmp. The error courier is set before the hook runs.
\\
\\ A hook that returns falls through to the stash path: the original 1z error is re-raised when
\\ control returns to the driving ffi-call. A hook that never returns (a longjmp) hands the error
\\ to the C library's own error protocol, so the automatic re-raise is disabled; the binding calls
\\ take-callback-error after the library's protected call returns and reconciles against the
\\ library's status.
ffi-callback-with-error-hook: ( quotation sig hook userdata -- ffi-callback ) [ native.ffi-callback ] ;

\\ Drain a pending callback error without raising it. Pushes the boxed original error, or f when
\\ no callback error is pending.
\\
\\ An error a longjmp hook delivered into the C library is exempt from the automatic ffi-call
\\ re-raise, so this is the only way it is delivered.
take-callback-error: ( -- error/f ) [ native.take-callback-error ] ;

\\ Extract the raw buffer pointer and length from a byte array.
\\ The resource wraps the byte array's internal buffer; it becomes
\\ dangling if the byte array is resized or freed.
bytes>ffi-ptr+len: ( byte-array -- resource fixnum ) [ native.bytes-raw-ptr ] ;

\\ Keep a byte-array on the stack while extracting its raw FFI pointer.
bytes>ffi-ptr: ( byte-array -- byte-array ptr ) [ dup bytes>ffi-ptr+len drop ] ;

\\ Allocate a byte-array and leave both the byte-array and raw FFI pointer.
bytes-alloc-ptr: ( n -- byte-array ptr ) [ bytes-alloc dup bytes>ffi-ptr+len drop ] ;

\\ True iff sym is one of the errno failure sentinels: neg1, null, or neg.
(valid-errno-sentinel?): ( sym -- bool ) [
  dup neg1: = over null: = or swap neg: = or
] ;

\\ Read the errno sentinel from a binding's options hash, validating it
\\ against the closed set. Returns f when the key is absent.
(option-errno): ( hash -- errno ) [
  dup errno: @has? [
    errno: @get
    dup (valid-errno-sentinel?) [ ] [
      f "FFI binding errno sentinel must be neg1:, null:, or neg:" EInvalidArgument make-error throw
    ] if
  ] [ drop f ] if
] ;

\\ Read the cap symbol from a binding's options hash, verbatim.
\\ Capability validation happens at bind time. Returns f when absent.
(option-cap): ( hash -- cap ) [
  dup cap: @has? [ cap: @get ] [ drop f ] if
] ;

\\ Rebuild an ffi-sig, folding in errno/cap from a binding's options hash.
\\ ffi-sig is immutable, so this reconstructs rather than mutates in place.
(apply-ffi-options): ( hash sig -- sig ) [
  over (option-errno)                \ hash sig errno
  <rot- (option-cap)                 \ sig errno cap
  <rot-                              \ errno cap sig
  [ params>> ] [ return-type>> ] bi  \ errno cap params return-type
  2swap                              \ params return-type errno cap
  make-ffi-sig
] ;

\\ True when the token is one of the strings in set, keeping the token.
(ffi-token-in?): ( token set -- token ? ) [ over [ = ] curry #any ] ;

\\ 1z type name a non-out parameter token marshals from, or f when no single
\\ 1z type matches. Every integer width maps to fixnum, because argument
\\ marshalling accepts exactly a fixnum for all of them. Pointers and
\\ struct-by-value stay untyped: a named ptr resource reports its FFI pointer
\\ name as its type, so no concrete annotation would hold.
(ffi-input-type): ( token -- typename/f ) [
  dup "inout-" #starts-with? [ 6 #drop ] when
  { "i8" "i16" "i32" "i64" "u8" "u16" "u32" "u64" "usize" "isize" } (ffi-token-in?) [ drop "fixnum" ] [
    { "f32" "f64" } (ffi-token-in?) [ drop "float" ] [
      dup "bool" = [ drop "boolean" ] [
        { "cstring" "cstring-retained" } (ffi-token-in?) [ drop "string" ] [ drop f ] if
      ] if
    ] if
  ] if
] ;

\\ 1z type name an out-capable token or return-type token pushes, or f when no
\\ single 1z type matches. u64 and usize stay untyped, because a large value
\\ promotes to bignum on the way out.
(ffi-output-type): ( token -- typename/f ) [
  dup "out-" #starts-with? [ 4 #drop ] when
  dup "inout-" #starts-with? [ 6 #drop ] when
  { "i8" "i16" "i32" "i64" "u8" "u16" "u32" "isize" } (ffi-token-in?) [ drop "fixnum" ] [
    { "f32" "f64" } (ffi-token-in?) [ drop "float" ] [
      dup "bool" = [ drop "boolean" ] [
        { "cstring" "cstring-retained" "cstring-owned" } (ffi-token-in?) [ drop "string" ] [ drop f ] if
      ] if
    ] if
  ] if
] ;

\\ One effect-source fragment: "name" for an untyped parameter, "name: type"
\\ for an annotated one.
(effect-frag): ( name typename/f -- frag ) [
  dup f = [ drop ] [ ": " swap #append #append ] if
] ;

\ Append an input fragment for a non-out parameter, named by C position.
(ffi-input-frag): ( acc token idx -- acc ) [
  over "out-" #starts-with? [ 2drop ] [
    1 + >string "a" swap #append  \ acc token name
    swap (ffi-input-type)         \ acc name typename/f
    (effect-frag)                 \ acc frag
    swap " " #append swap #append
  ] if
] ;

\ Append an output fragment for an out or inout parameter, named by C position.
(ffi-output-frag): ( acc token idx -- acc ) [
  over dup "out-" #starts-with? swap "inout-" #starts-with? or [
    1 + >string "o" swap #append  \ acc token name
    swap (ffi-output-type)        \ acc name typename/f
    (effect-frag)                 \ acc frag
    swap " " #append swap #append
  ] [ 2drop ] if
] ;

\\ Derive a wrapper's stack effect from its ffi-sig: one input per non-out
\\ parameter, then out and inout parameters followed by the return value as
\\ outputs, mirroring what ffi-call consumes and pushes.
(sig>effect): ( sig -- stack-effect ) [
  dup params>>                      \ sig params
  "" swap                           \ sig acc params
  [ (ffi-input-frag) ] #each-index  \ sig acc
  " --" #append
  over params>>                      \ sig acc params
  [ (ffi-output-frag) ] #each-index  \ sig acc
  swap return-type>>                 \ acc ret
  dup "void" = [ drop ] [
    (ffi-output-type) "r" swap (effect-frag)
    swap " " #append swap #append
  ] if
  native.parse-stack-effect
] ;

\\ Build one FFI binding entry in the accumulator mutable map.
\\ Looks up the C symbol in the dylib, binds the signature, curries
\\ into a self-contained [ ffi-call ] quotation with the effect derived
\\ from the signature attached, and stores it by name.
(build-ffi-entry): ( mmap dylib word-name c-symbol sig -- mmap dylib ) [
  dup (sig>effect)  \ mmap dylib word-name c-symbol sig effect
  [
    3 pick-n -rot> bound-symbol
    [ ffi-call ] curry
  ] dip                       \ mmap dylib word-name wrapper effect
  native.attach-stack-effect  \ mmap dylib word-name wrapper'
  <rot- [ @set! ] dip
] ;

\\ Parse-time block syntax for declaring multiple FFI bindings.
\\ Each entry is: word-name: "c_symbol" ffi{ sig }
\\ Produces a quotation ( dylib -- mmap ) that resolves all symbols
\\ and builds a hashtable of callable quotations.
ffi-def{: parse-time [
  (read-ffi-def): ( accum -- accum ) [
    peek-token dup "}" = [
      drop parse-token drop
    ] [
      drop
      parse-token dup #len 1 - 0 swap #slice
      parse-literal
      peek-token dup "H{" = [
        drop parse-literal parse-literal (apply-ffi-options)
      ] [
        "M{" = [
          f "FFI binding options must be an immutable H{ } hash" EInvalidArgument make-error throw
        ] [
          parse-literal
        ] if
      ] if
      [ (build-ffi-entry) ] curry curry curry
      compose
      (read-ffi-def)
    ] if
  ] ;

  [ M{ } swap ]
  (read-ffi-def)
  [ drop ] compose
] ;
