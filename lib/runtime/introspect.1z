\ lib/introspect.1z - Word introspection and dictionary queries

use "strings" ;

\\ Structured opcode information from quotation introspection.
\\ opcode: is push-literal: or call-word:; detail: is the literal value or word name.
opcode-info: struct{ opcode: symbol detail: any } ;

(raw>opcode-info): ( raw -- opcode-info ) [
  dup 0 #nth swap 1 #nth make-opcode-info
] ;

\\ Extract a quotation's instructions as an array of opcode-info structs.
quotation>opcodes: ( quotation -- array ) [
  native.quotation>opcodes [ (raw>opcode-info) ] #map #collect
] ;

\\ Test whether a quotation contains any word-call instructions.
quotation-has-calls?: ( quotation -- bool ) [
  native.quotation>opcodes [ 0 #nth call-word: = ] #any
] ;

\ Format a method-info struct as "  method{ type1 }" or "  method{ type1 type2 }"
format-method: ( method-info -- str ) [
  types>> "  method{ " swap " " #join #append " }" #append
] ;

\ Pad string to width with trailing spaces
pad-right: ( str width -- str ) [
  over #len - dup 0 > [ " " swap repeat #append ] [ drop ] if
] ;

\ Find max variant name length across an array of descriptor-variant structs
variant-max-name-len-acc: ( max variants -- max ) [
  dup #len 0 =
  [ drop ]
  [
    dup #first name>> >string #len
    -rot> 1 #drop
    [ max ] dip
    variant-max-name-len-acc
  ]
  if
] ;

variant-max-name-len: ( variants -- n ) [
  0 swap variant-max-name-len-acc
] ;

\ Format one variant line: "    name:PADDING typename\n"
format-one-variant: ( max-name-len name tname -- line ) [
  -rot>
  ":" #append
  swap 2 + pad-right
  "    " swap #append
  swap #append "\n" #append
] ;

\ Format all variant lines with column-aligned type names. `variants` is an
\ array of descriptor-variant struct instances.
format-variant-lines: stack-recursive ( variants max-name-len -- str ) [
  over #len 0 =
  [ 2drop "" ]
  [
    over #first dup name>> >string swap type>> native.type-name
    2 pick-n -rot>
    format-one-variant
    -rot> swap 1 #drop swap
    format-variant-lines
    #append
  ]
  if
] ;

format-builtin-type-info: ( desc -- str ) [
  drop "type info:\n  kind: builtin-type\n"
] ;

format-struct-type-info: ( desc -- str ) [
  "type info:\n  kind: struct\n  fields: "
  swap descriptor-fields? unwrap-or-throw " " #join #append "\n" #append
] ;

format-virtual-type-info: ( desc -- str ) [
  dup descriptor-inner-type? dup option:some?
  [
    option:some> swap drop native.type-name
    "type info:\n  kind: virtual\n  wraps: " swap #append "\n" #append
  ]
  [
    drop descriptor-fields? unwrap-or-throw " " #join
    "type info:\n  kind: virtual\n  fields: " swap #append "\n" #append
  ]
  if
] ;

format-enum-type-info: ( desc -- str ) [
  "type info:\n  kind: enum\n  variants:\n"
  swap descriptor-variants? unwrap-or-throw
  dup variant-max-name-len
  format-variant-lines #append
] ;

format-type-info: ( wi -- str ) [
  dup markers>> [ typed = ] #any
  [ name>> native.type-info-string ]
  [ drop "" ]
  if
] ;

\ Format word-info as a multi-line help string matching the native help output
format-word-info: ( wi -- str ) [
  dup
  dup name>>
  over stack-effect>> dup f = [ drop ] [ " " swap >string #append #append ] if
  over markers>> dup #len 0 = [ drop ] [
    " [" swap >iterator [ inspect ] #map #collect ", " #join #append #append "]" #append
  ] if
  over native?>> [ " \\native" #append ] [ " \\compound" #append ] if
  "\n" #append
  over doc>> dup f = [ drop ] [ swap "\n" swap #append #append "\n" #append ] if
  swap methods>> dup #len 0 = [ drop ] [
    >iterator [ format-method ] #map #collect "\n" #join
    #append "\n" #append
  ] if
  swap format-type-info #append
] ;

\ Display help for a word, matching the output of the native help primitive
help: ( symbol -- ) [
  dup >word-info? dup option:some?
  [ option:some> nip format-word-info ]
  [ drop inspect ": no such word\n" #append ]
  if print flush
] ;

\ Find words whose markers include the given marker. Compares by marker
\ identity, so pass the marker value itself (e.g. parse-time words-with-marker).
words-with-marker: ( m: marker -- array ) [
  all-words >iterator swap
  [ swap markers>> swap #in? ] curry #filter
  #collect
] ;

\ Find words whose input arity matches n
words-with-arity: ( n -- array ) [
  all-words >iterator swap
  [ swap stack-effect>> dup f = [ drop drop f ] [ inputs>> #len = ] if ] curry #filter
  #collect
] ;

\ Find words whose name contains the given substring
words-matching: ( str -- array ) [
  all-words >iterator swap
  [ swap name>> swap #in? ] curry #filter
  #collect
] ;

\ Get the source location of a word as an option
word-source: ( symbol -- option ) [
  >word-info? [ source-loc>> ] ?map
] ;

\ Format a single word line as "name stack-effect\n"
format-word-line: ( wi -- ) [
  dup name>> print
  stack-effect>> dup f = [ drop ] [ " " print >string print ] if
  "\n" print
] ;

\ Look up the provenance of a generated word, or f if none
generated-by: ( symbol -- provenance/f ) [
  >word-info? dup option:some?
  [ option:some> provenance>> ]
  [ drop f ]
  if
] ;

\ Return the generated-words array for a type name
generated-words: ( symbol -- array ) [
  native.type-generated-words
] ;

\ Print all defined words in the dictionary, grouped by native vs user-defined
words: ( -- ) [
  all-words [ name>> ] #sort-by

  "=== Native Primitives ===\n" print
  dup >iterator [ native?>> ] #filter #collect
  >iterator [ format-word-line ] #each

  "\n=== User-Defined Words ===\n" print
  >iterator [ native?>> not ] #filter #collect
  >iterator [ format-word-line ] #each

  flush
] ;
