\ lib/debug.1z - Debugging utilities

\\ Print the current scope frames to stderr, one line each. A line shows the frame type, its index
\\ when it has one, its word count, and whether it is an import frame.
scope-trace: ( -- ) [
  native.scope-frames
  >iterator [
    dup "type" @get
    over "index" @get dup -1 =
    [ drop ]
    [ >string "[" swap #append "]" #append #append ]
    if
    ": " #append
    over "count" @get >string #append " words" #append
    over "import-frame?" @get [ " (import-frame)" #append ] when
    nip
    eprint-line
  ] #each
] ;

pragma{ lint-suppress: { dead-definition: } }
