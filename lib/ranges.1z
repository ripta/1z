\ lib/ranges.1z - Range type for lazy integer sequences

\ Range record: start, end, step, infinite? fields
range: struct{ start: fixnum | bignum | float end: fixnum | bignum | float step: fixnum infinite?: boolean } ;

\\ The exclusive range `[start, end)`. It steps by 1 when start < end and by -1 otherwise.
\\
\\   1 4 <range> #collect
\\   => { 1 2 3 }
<range>: ( start end -- range ) [
  2dup < [ 1 ] [ -1 ] if f make-range
] ;

\\ The inclusive range `[start, end]`. It steps by 1 when start < end and by -1 otherwise. It is
\\ stored as the equivalent exclusive range.
\\
\\   3 1 range= #collect
\\   => { 3 2 1 }
range=: ( start end -- range ) [
  2dup < [ ++ 1 ] [ -- -1 ] if f make-range
] ;

\\ The exclusive range `[start, end)` with an explicit step.
\\
\\ Throws `invalid-argument` when the step is zero, or when its sign points away from `end`.
\\
\\   0 10 3 range-step #collect
\\   => { 0 3 6 9 }
range-step: ( start end step -- range ) [
  dup 0 = [ f "step must not be zero" EInvalidArgument make-error throw ] when
  2 pick-n 2 pick-n < over 0 < and
  [ f "ascending range requires positive step" EInvalidArgument make-error throw ] when
  2 pick-n 2 pick-n > over 0 > and
  [ f "descending range requires negative step" EInvalidArgument make-error throw ] when
  f make-range
] ;

\\ The exclusive range `[0, n)`.
\\
\\   3 iota #collect
\\   => { 0 1 2 }
iota: ( n -- range ) [ 0 swap <range> ] ;

\\ The infinite range from start, stepping by 1. `#len` and `#last` throw on it.
\\
\\   5 range-from 3 #take #collect
\\   => { 5 6 7 }
range-from: ( start -- range ) [ 0 1 t make-range ] ;

\\ The infinite range from start with an explicit step. Throws `invalid-argument` when the step is
\\ zero.
\\
\\   0 -2 range-from-step 3 #take #collect
\\   => { 0 -2 -4 }
range-from-step: ( start step -- range ) [
  dup 0 = [ f "step must not be zero" EInvalidArgument make-error throw ] when
  0 swap t make-range
] ;

\\ Alias of `range=`.
\\
\\   1 3 range-inclusive #collect
\\   => { 1 2 3 }
range-inclusive: ( start end -- range ) [ range= ] ;

\ Iterator support: convert range to a lazy iterator
>iterator: method{ range } [ unmake-range make-range-iter ] ;

\ O(1) length: max(0, (end - start + step - signum(step)) / step)
\ Throws for infinite ranges.
#len: method{ range } [
  unmake-range
  [ f "infinite range has no length" EInvalidArgument make-error throw ] when
  -rot> swap - over + over dup 0 > [ drop 1 ] [ drop -1 ] if - swap div
  dup 0 < [ drop 0 ] when
] ;

\ O(1) indexed access: start + n * step
\ Validates index is non-negative and within bounds.
#nth: method{ range fixnum } [
  dup 0 < [ f "negative index" EIndexOutOfBounds make-error throw ] when
  swap unmake-range
  [
    nip <rot- * +
  ] [
    3 pick-n over * 3 pick-n +
    over 0 >
    [ dup 3 pick-n >= ]
    [ dup 3 pick-n <= ] if
    [ f "index out of bounds" EIndexOutOfBounds make-error throw ] when
    nip nip nip nip
  ] if
] ;

\ First element (start). Throws for empty ranges.
#first: method{ range } [
  unmake-range
  [ drop drop ] [
    dup 0 > [ drop 2dup >= ] [ drop 2dup <= ] if
    [ 2drop f "empty range" EIndexOutOfBounds make-error throw ] when
    drop
  ] if
] ;

\ Last element: start + (len - 1) * step. Throws for infinite or empty ranges.
#last: method{ range } [
  dup #len
  dup 0 = [ 2drop f "empty range" EIndexOutOfBounds make-error throw ] when
  swap unmake-range drop nip
  <rot- -- * +
] ;

inspect: method{ range } [
  unmake-range
  \ Stack: start end step infinite?
  [ nip "inf" swap ] [ swap inspect swap ] if
  \ Stack: start end-str step
  inspect [ inspect ] 2dip
  \ Stack: start-str end-str step-str
  "<range "
  3 pick-n #append " " #append
  2 pick-n #append " " #append
  1 pick-n #append ">" #append
  nip nip nip
] ;

pragma{ lint-suppress: { dead-definition: missing-type-annotation: } }
