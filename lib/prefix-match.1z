\ lib/prefix-match.1z - Longest prefix matching

use "radix-tree" ;

\\ A prefix table: a string-keyed radix tree, so a lookup costs the key's length rather
\\ than the table's size. Built once by `<prefix-table>` and only queried afterwards.
prefix-table: virtual{ radix-tree } ;

\\ Build a prefix table from any sequence of { prefix value } pairs. A prefix listed twice
\\ takes its last value.
<prefix-table>: ( seq -- prefix-table ) [
  string <radix-tree> [ dup 0 #nth swap 1 #nth radix-insert ] #reduce
  make-prefix-table
] ;

\\ The value for the longest registered prefix of `key`, or `option:none`. O(k) in the
\\ key's character count.
prefix-match?: ( table: prefix-table key: string -- option ) [
  [ unmake-prefix-table ] dip radix-longest?
] ;

\\ The value for the longest registered prefix of `key`, or throw `key-not-found`.
prefix-match: ( table: prefix-table key: string -- value ) [
  prefix-match?
  dup option:some?
  [ option:some> ]
  [ drop f "no matching prefix" EKeyNotFound make-error throw ]
  if
] ;

inspect: method{ prefix-table } [
  "<prefix-table " swap unmake-prefix-table #len inspect #append " entries>" #append
] ;
