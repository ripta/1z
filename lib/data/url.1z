\ lib/data/url.1z - RFC 3986 percent-encoding for URLs

use "strings" ;

(url-error): ( msg -- * ) [ f swap EInvalidArgument make-error throw ] ;

(invalid-hex-error): ( -- * ) [
  "invalid percent-encoded hex digit" (url-error)
] ;

(truncated-error): ( -- * ) [
  "truncated percent-encoded sequence" (url-error)
] ;

(upper-byte?): ( byte -- ? ) [ dup 0x41 >= swap 0x5A <= and ] ;

(lower-byte?): ( byte -- ? ) [ dup 0x61 >= swap 0x7A <= and ] ;

(digit-byte?): ( byte -- ? ) [ dup 0x30 >= swap 0x39 <= and ] ;

(special-unreserved-byte?): ( byte -- ? ) [
  dup 0x2D =
  over 0x2E = or
  over 0x5F = or
  swap 0x7E = or
] ;

(unreserved-byte?): ( byte -- ? ) [
  dup (upper-byte?)
  over (lower-byte?) or
  over (digit-byte?) or
  swap (special-unreserved-byte?) or
] ;

\ Map 0..9 to 0x30..0x39 and 10..15 to 0x41..0x46 (uppercase hex).
(nibble>hex-byte): ( n -- byte ) [
  dup 10 < [ 0x30 + ] [ 55 + ] if
] ;

\ Map a hex-digit byte (0-9, A-F, a-f) to its 0..15 value; throw otherwise.
(hex-byte>nibble): ( byte -- n ) [
  dup 0x30 >= over 0x39 <= and
  [ 0x30 - ]
  [
    dup 0x41 >= over 0x46 <= and
    [ 0x41 - 10 + ]
    [
      dup 0x61 >= over 0x66 <= and
      [ 0x61 - 10 + ]
      [ drop (invalid-hex-error) ]
      if
    ]
    if
  ]
  if
] ;

(encode-reserved): ( acc byte -- acc' ) [
  dup 4 ushift-right (nibble>hex-byte)
  swap 15 bitand (nibble>hex-byte)
  [ 0x25 #push ] 2dip
  [ #push ] dip
  #push
] ;

(encode-byte-into): ( acc byte -- acc' ) [
  dup (unreserved-byte?)
  [ #push ]
  [ (encode-reserved) ]
  if
] ;

\\ RFC 3986 percent-encode a byte sequence. Each byte outside the unreserved
\\ set (A-Z / a-z / 0-9 / `-` / `.` / `_` / `~`) is replaced with `%HH` using
\\ uppercase hex digits; unreserved bytes pass through unchanged. The `%`
\\ byte itself has no special treatment and is encoded as `%25`, so the
\\ operation is well-defined on arbitrary opaque byte input.
encode-bytes: ( bytes -- bytes ) [
  B{ } [ (encode-byte-into) ] #reduce
] ;

url-decode-state: mutable struct{ src pos out } ;

(dec-remaining): ( state -- n ) [ dup src>> #len swap pos>> - ] ;

(dec-src-at): ( state offset -- byte ) [
  over pos>> + over src>> swap #nth nip
] ;

(dec-append): ( state byte -- state ) [
  over out>> swap #push >>out
] ;

(dec-advance): ( state n -- state ) [
  over pos>> + >>pos
] ;

(dec-step): ( state -- state ) [
  dup 0 (dec-src-at)
  dup 0x25 =
  [
    drop
    dup (dec-remaining) 3 < [ (truncated-error) ] when
    dup 1 (dec-src-at) (hex-byte>nibble) 4 shift-left
    over 2 (dec-src-at) (hex-byte>nibble) bitor
    (dec-append) 3 (dec-advance)
  ]
  [
    (dec-append) 1 (dec-advance)
  ]
  if
] ;

\\ RFC 3986 percent-decode a byte sequence. Any `%HH` triple (hex digits in
\\ either case) decodes to the byte it represents; every other byte passes
\\ through unchanged. Throws `EInvalidArgument` on a trailing `%` with fewer
\\ than two hex digits remaining, or on a `%XY` triple where `X` or `Y` is
\\ not a hex digit.
decode-bytes: ( bytes -- bytes ) [
  0 B{ } make-url-decode-state
  [ dup (dec-remaining) 0 > ] [ (dec-step) ] while
  out>>
] ;

\\ RFC 3986 percent-encode a string. The string is interpreted as UTF-8 bytes
\\ and passed to `encode-bytes`; the result is ASCII (unreserved characters
\\ plus `%HH` triples) and is re-wrapped as a string.
encode: ( string -- string ) [ >bytes encode-bytes bytes> ] ;

\\ RFC 3986 percent-decode a string. The string is interpreted as UTF-8 bytes
\\ and passed to `decode-bytes`; the resulting bytes are re-wrapped as a
\\ string. Throws `EInvalidArgument` on malformed `%HH` sequences, matching
\\ the byte-level decoder.
decode: ( string -- string ) [ >bytes decode-bytes bytes> ] ;

(encode-byte-into-form): ( acc byte -- acc' ) [
  dup 0x20 =
  [ drop 0x2B #push ]
  [ (encode-byte-into) ]
  if
] ;

(encode-bytes-form): ( bytes -- bytes ) [
  B{ } [ (encode-byte-into-form) ] #reduce
] ;

\\ application/x-www-form-urlencoded encode. Identical to `encode` except
\\ that space (0x20) becomes `+` rather than `%20`; the literal byte `+`
\\ (0x2B) is percent-encoded as `%2B`.
encode(form): ( string -- string ) [ >bytes (encode-bytes-form) bytes> ] ;

(dec-step-form): ( state -- state ) [
  dup 0 (dec-src-at) 0x2B =
  [ 0x20 (dec-append) 1 (dec-advance) ]
  [ (dec-step) ]
  if
] ;

\\ application/x-www-form-urlencoded byte-level decode. `+` decodes to space;
\\ `%HH` triples decode as in `decode-bytes` (so `%2B` decodes to a literal
\\ `+`). Throws `EInvalidArgument` on malformed `%` sequences.
decode-bytes(form): ( bytes -- bytes ) [
  0 B{ } make-url-decode-state
  [ dup (dec-remaining) 0 > ] [ (dec-step-form) ] while
  out>>
] ;

\\ application/x-www-form-urlencoded string-level decode. Wraps
\\ `decode-bytes(form)`. Throws `EInvalidArgument` on malformed `%HH`
\\ sequences.
decode(form): ( string -- string ) [ >bytes decode-bytes(form) bytes> ] ;

\ Append `value` to the array stored at `key` in `hash`. Creates a fresh
\ single-element array when the key is absent. Returns the updated hash.
(append-multi): ( hash key value -- hash' ) [
  -rot>             \ value hash key
  2dup { } @get-or  \ value hash key list
  3 <rot-n          \ hash key list value
  #push             \ hash key list'
  @set              \ hash'
] ;

\ Decode one `key=value` (or bare-key) segment and append it to the
\ accumulator hash. Empty segments are skipped.
(decode-query-pair): ( form pair -- form ) [
  dup #empty?
  [ drop ]
  [
    dup "=" split-once?
    dup option:some?
    [ option:some> nip
      dup #first decode(form)
      swap #last decode(form)
      (append-multi)
    ]
    [ drop
      decode(form) ""
      (append-multi)
    ]
    if
  ]
  if
] ;

\\ Decode an `application/x-www-form-urlencoded` body into a hash mapping
\\ each decoded key to an array of decoded values, accumulating in the
\\ order they appeared. Splits the input on `&`; each non-empty segment
\\ is split once on the first `=` and both sides are passed through
\\ `decode(form)` (so `+` decodes to space and `%2B` to a literal `+`).
\\ A segment without `=` becomes a bare key with an empty-string value.
\\ Repeated keys accumulate; a key seen once still yields a one-element
\\ array. An empty input yields the empty hash. Throws `EInvalidArgument`
\\ on malformed `%HH` sequences inside any segment.
decode-query: ( string -- hash ) [
  dup #empty?
  [ drop H{ } ]
  [
    "&" split
    H{ } [ (decode-query-pair) ] #reduce
  ]
  if
] ;

\ Push one form-encoded `key=value` segment onto the accumulator vector.
\ Called inside an inner #each whose surrounding stack is
\ ( vec hash key-enc ... ); the vector sits at depth 3 from the value.
(push-query-pair): ( vec hash key-enc value -- vec hash key-enc ) [
  encode(form)               \ vec hash key-enc v-enc
  "=" swap #append           \ vec hash key-enc "=v-enc"
  over swap #append          \ vec hash key-enc "k=v"
  3 pick-n swap #push! drop  \ vec hash key-enc
] ;

\ Emit all segments for one key. Captured state ( vec hash ) sits below
\ the iterated key; the body fetches the value array and walks it. `@keys`
\ returns symbols even when the keys were inserted as strings, so the key
\ is coerced through `>string` before encoding.
(emit-query-key): ( vec hash key -- vec hash ) [
  over over @get             \ vec hash key arr
  swap >string encode(form)  \ vec hash arr key-enc
  swap                       \ vec hash key-enc arr
  [ (push-query-pair) ] #each
  drop  \ vec hash
] ;

\\ Encode a hash whose values are arrays of strings into an
\\ `application/x-www-form-urlencoded` body. Each key emits one
\\ `key=value` segment per array element, in the order the array was
\\ stored; both sides are passed through `encode(form)` (so spaces become
\\ `+` and other reserved bytes become `%HH`). An empty hash yields the
\\ empty string. The order of keys in the output follows the hash's own
\\ key iteration order, which is implementation-defined; callers that
\\ need a specific ordering should sort the keys themselves.
encode-query: ( hash -- string ) [
  V{ } swap                   \ vec hash
  dup @keys                   \ vec hash keys
  [ (emit-query-key) ] #each  \ vec hash
  drop                        \ vec
  >array "&" #join            \ string
] ;
