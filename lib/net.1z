\ lib/net.1z - Network address types and utilities

use "strings" ;
use "conversions" ;

host-port: struct{ host port } ;
unix-addr: struct{ path } ;
addr: enum{
  tcp:  host-port
  udp:  host-port
  unix: unix-addr
} ;

\ Split a "host:port" string on the last colon, parse port as integer.
\ Handles IPv6 addresses in brackets: "[::1]:8080" -> "::1" 8080
\ Returns a hash with host: and port: keys.
split-host-port: ( str -- hash ) [
  dup #first "[" = [
    \ Bracketed host: "[host]:port"
    "]:" #index-of dup not [
      drop f "invalid address: missing ]:port" EInvalidArgument make-error throw
    ] [
      \ str idx -- idx points at "]"
      2dup 2 + over #len #slice parse-integer  \ str idx port
      [ 1 swap #slice ] dip                    \ host port
    ] if
  ] [
    \ Plain host:port -- split on ":" and rejoin all but last
    ":" split
    dup #len 1 = [ drop f "invalid address: missing port" EInvalidArgument make-error throw ] [
      dup #last parse-integer swap  \ port parts
      0 over #len 1 - #slice        \ port host-parts
      ":" #join                     \ port host
      swap                          \ host port
    ] if
  ] if
  H{ } swap port: swap @set swap host: swap @set
] ;
