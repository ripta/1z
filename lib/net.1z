\ lib/net.1z - Network address types and utilities

use "strings" ;
use "conversions" ;

\\ A host name or address string and a port number, the payload of a TCP or UDP `addr`.
host-port: struct{ host port } ;

\\ A Unix domain socket's filesystem path, the payload of a Unix `addr`.
unix-addr: struct{ path } ;

\\ A socket address: TCP or UDP with a host and port, or a Unix socket path. Build one with
\\ `make-addr:tcp`, `make-addr:udp`, or `>addr:unix`.
addr: enum{
  tcp:  host-port
  udp:  host-port
  unix: unix-addr
} ;

\\ A parsed IP address in network byte order: 4 bytes for IPv4, 16 for IPv6.
ip: virtual{ byte-array } ;

\\ Extract host and port from an addr enum value. Unix addresses produce
\\ sentinel values ("" and 0) since they have no host or port.
\\
\\   "example.com" 80 make-addr:tcp addr-host-port
\\   => "example.com" 80
addr-host-port: ( addr -- host port ) [
  match{
    addr:tcp:  [ ]
    addr:udp:  [ ]
    addr:unix: [ drop "" 0 ]
  }
] ;

\\ Parse an IPv4 address string into an ip value.
parse-ipv4: ( str -- ip ) [ inet: swap inet-pton make-ip ] ;

\\ Parse an IPv6 address string into an ip value.
parse-ipv6: ( str -- ip ) [ inet6: swap inet-pton make-ip ] ;

\\ Parse an IP address string, auto-detecting IPv4 or IPv6.
>ip: ( str -- ip ) [ dup ":" #in? [ parse-ipv6 ] [ parse-ipv4 ] if ] ;

private{
  \ The address ended before its separator, so the failure points at its end.
  (missing-port): never-returns ( str: string what: string -- * ) [
    [ #len [ H{ } offset: ] dip @set ] dip throw-parse-error
  ] ;

  (invalid-port): never-returns ( tok: string start: fixnum -- * ) [
    [ H{ } offset: ] dip @set text: 2 pick-n @set
    "invalid port '" <rot- #append "'" #append throw-parse-error
  ] ;

  \ Parse the port token that begins at offset start of the address.
  (parse-port): ( tok: string start: fixnum -- port ) [
    over [ parse-integer 2nip ] [ 2drop (invalid-port) ] recover
  ] ;
}

\\ Split a "host:port" string on the last colon and parse the port as an integer. Returns a hash
\\ with `host:` and `port:` keys. An IPv6 host goes in brackets, which are removed. A malformed
\\ address raises `parse-error:` with an offset into str.
\\
\\   "[::1]:8080" split-host-port
\\   => H{ host: "::1" port: 8080 }
split-host-port: ( str: string -- hash ) [
  dup #first "[" = [
    \ Bracketed host: "[host]:port"
    dup "]:" #index-of dup not [
      drop "invalid address: missing ]:port" (missing-port)
    ] [
      \ str idx -- idx points at "]"
      2dup 2 + over #len #slice  \ str idx port-tok
      over 2 + (parse-port)      \ str idx port
      [ 1 swap #slice ] dip      \ host port
    ] if
  ] [
    \ Plain host:port -- split on ":" and rejoin all but last
    dup ":" split
    dup #len 1 = [ drop "invalid address: missing port" (missing-port) ] [
      dup #last                         \ str parts port-tok
      dup #len 3 pick-n #len swap -     \ str parts port-tok start
      (parse-port) swap                 \ str port parts
      0 over #len 1 - #slice ":" #join  \ str port host
      swap <rot- drop                   \ host port
    ] if
  ] if
  H{ } swap port: swap @set swap host: swap @set
] ;

pragma{ lint-suppress: { broad-import: dead-definition: import-ordering: missing-type-annotation: } }
