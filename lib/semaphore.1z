\ lib/semaphore.1z - Counting semaphore backed by a buffered channel

semaphore: struct{ ch: channel } ;

\\ A counting semaphore holding n permits, backed by a buffered channel of capacity n.
<semaphore>: ( n: fixnum -- sem ) [
  dup <buffered-channel>
  swap [ dup t swap send ] times
  make-semaphore
] ;

acquire: method{ semaphore } [
  ch>> receive drop
] ;

try-acquire: method{ semaphore } [
  ch>> try-receive [ >option:some ] [ drop option:none ] if
] ;

\\ Release a permit back to the semaphore.
release: ( sem -- ) [
  ch>> t swap send
] ;

inspect: method{ semaphore } [ drop "<semaphore>" ] ;

pragma{ lint-suppress: { dead-definition: missing-type-annotation: } }
