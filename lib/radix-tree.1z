\ lib/radix-tree.1z - Persistent compressed trie (radix tree) keyed by strings or bytes.
\
\ A node's edge label is a run of key units rather than a single one, so a chain with no
\ branch in it collapses to one node. A lookup walks the key in place: at each node it
\ takes the key's next unit, finds it in the node's first-unit index, and checks that the
\ chosen child's whole label matches. Registered prefixes therefore leave the cost model
\ entirely, and only the key's length is left.
\
\ A key is a string or a byte-array, fixed per tree by a constructor parameter. A unit is
\ a character on a string key and a byte on a byte-array key. Both readings come from the
\ same native words: `#len`, `#nth`, `#slice`, `#index-of`, and `#push` each already read
\ both types in unit terms, so there is one code path and no per-type branch below the
\ constructor. On a string that also makes every edge split land on a character boundary,
\ since `#slice` is codepoint-indexed.
\
\ The two key types differ in cost, not in behavior. A string label is a zero-copy
\ sub-slice, while a byte-array label is a fresh allocation. Against that, a string's
\ `#nth` and `#slice` re-walk the key's UTF-8 prefix on every hop, so a string lookup
\ scans O(d · k) bytes for d hops and a key of k units, where a byte-array lookup is O(k).
\ A route table has a handful of hops.
\
\ The tree is persistent. An insert copies the nodes on its path and leaves prior versions
\ valid, which is the formulation `bst` uses. Nothing writes during a read, so persistence
\ costs a lookup nothing. The path copy also rebuilds each node's child arrays, making an
\ insert O(k · c) in the per-node fan-out.
\
\ A delete path-copies the same way. Clearing an entry can leave a node with nothing to say:
\ its parent drops it when no children are left, and folds it into its child when one is.
\ A node already in either shape cannot exist below the root, so one delete drops at most one
\ node and merges at most one.
\
\ Enumeration is lazy. `>iterator` and `radix-under` both hand back a walk over an explicit
\ pending stack, so a prefix query costs its descent plus whatever the caller actually draws.
\
\ A node's children are a first-unit index sequence beside a positionally parallel array
\ of children, and the index is kept ascending. Those parallel arrays are the invariant
\ every insert and delete has to preserve. Ascending order is what makes a leftmost descent
\ reach the lexicographically smallest entry.
\
\ `insert-node` and `delete-node` recurse once per hop, so their depth is the number of
\ compressed nodes on the path, bounded by the key's unit count. The entry descents and
\ `radix-iter-step` self-call in tail position, so they cost no depth at all.

\\ One node. `label` is the edge from the parent, in the tree's key type, and the root's is
\\ empty. `value` holds the entry that ends here, or `option:none`. `index` holds one unit
\\ per child, ascending, and `children` is the parallel array of child nodes.
radix-node: struct{ label value index children } ;

\\ A persistent radix tree over `key-type`, which is `string` or `byte-array`. Every key is
\\ checked against it. `count` is the entry count, maintained by every insert.
radix-tree: struct{ root: radix-node key-type: type count: fixnum } ;

\\ One stored key and the value under it. This is what the tree's iterators, `#first`, and
\\ `#last` yield. A key lives in the tree only as the labels along its path, so an entry is
\\ where it is spelled out whole.
radix-entry: struct{ key value } ;

private{
  throw-key-type: never-returns ( -- * ) [
    f "radix-tree key does not match the tree's key type" ETypeMismatch make-error throw
  ] ;

  \ Key-type gate shared by every public word, so the raising behavior has one choke point.
  require-key: ( tree key -- tree key ) [
    2dup [ key-type>> ] dip type-of = not [ throw-key-type ] when
  ] ;

  \ A childless node holding one entry. Its empty index comes from the label, so the key
  \ type never has to be threaded this far down.
  leaf-node: ( label value -- radix-node ) [
    >option:some over 0 0 #slice { } make-radix-node
  ] ;

  with-label: ( node label -- radix-node ) [
    swap dup value>> swap dup index>> swap children>> make-radix-node
  ] ;

  with-value: ( node value-opt -- radix-node ) [
    over label>> -rot> swap dup index>> swap children>> make-radix-node
  ] ;

  with-children: ( node index children -- radix-node ) [
    [ dup label>> swap value>> ] 2dip make-radix-node
  ] ;

  \ `seq[0..i]` with `elem` pushed, then `seq[from..]` appended. `#slice`, `#push`, and
  \ `#append` all read arrays and both key types, so one helper splices the children array
  \ and the index sequence alike.
  seq-splice: ( seq i elem from -- seq' ) [
    3 pick-n 0 4 pick-n #slice
    2 pick-n #push
    4 pick-n 2 pick-n 1 pick-n #len #slice
    #append
    nip nip nip nip
  ] ;

  seq-insert: ( seq i elem -- seq' ) [ over seq-splice ] ;
  seq-set: ( seq i elem -- seq' ) [ over 1 + seq-splice ] ;

  \ `seq` without the element at `i`. No derivation of `seq-splice` reaches this, since that
  \ helper always pushes an element between the two halves.
  seq-remove: ( seq i -- seq' ) [
    over 0 2 pick-n #slice
    2 pick-n 2 pick-n 1 + 1 pick-n #len #slice
    #append
    nip nip
  ] ;

  \ The sorted slot for `unit` in an ascending index sequence. Units are distinct, so this
  \ is the first position holding a unit above it.
  index-slot: ( index unit -- i ) [
    over #len 0
    [ 2dup > [ 3 pick-n 1 pick-n #nth 3 pick-n < ] [ f ] if ]
    [ 1 + ]
    while
    nip nip nip
  ] ;

  \ Break a label at `c` units into the head a new parent keeps and the tail the old child
  \ keeps.
  split-label: ( label c -- head tail ) [
    2dup 0 swap #slice
    -rot> over #len #slice
  ] ;

  \ The number of leading units the key from `offset` shares with `label`. At least one at
  \ every call site, since the caller found the child by that first unit.
  common-units: ( key offset label -- n ) [
    2 pick-n #len 2 pick-n - over #len min 0
    \ ( key(4) offset(3) label(2) limit(1) n(0) )
    [ 2dup > [ 4 pick-n 4 pick-n 2 pick-n + #nth 3 pick-n 2 pick-n #nth = ] [ f ] if ]
    [ 1 + ]
    while
    nip nip nip nip
  ] ;

  \ A node with exactly two children, indexed in ascending first-unit order. The two labels
  \ start with different units, since that divergence is what forced the fork.
  fork-node: ( label value-opt a b -- radix-node ) [
    over label>> 0 #nth over label>> 0 #nth > [ swap ] when
    2dup 2 array-n
    2 pick-n label>> 0 1 #slice
    2 pick-n label>> 0 #nth #push
    swap [ 2drop ] 2dip
    make-radix-node
  ] ;

  \ Splice `child` in at slot i, where the sorted index wants `unit`.
  splice-child: ( node i unit child -- radix-node ) [
    3 pick-n index>> 3 pick-n 3 pick-n seq-insert
    4 pick-n children>> 4 pick-n 3 pick-n seq-insert
    [ 3drop ] 2dip with-children
  ] ;

  \ Swap the child at slot i, leaving the index untouched.
  replace-child: ( node i child -- radix-node ) [
    2 pick-n children>> 2 pick-n 2 pick-n seq-set
    [ 2drop ] dip
    over index>> swap with-children
  ] ;

  \ Drop slot i, index entry included. What is left keeps its order, so the index still
  \ ascends.
  drop-child: ( node i -- radix-node ) [
    over index>> over seq-remove
    2 pick-n children>> 2 pick-n seq-remove
    [ drop ] 2dip with-children
  ] ;

  \ Fold a valueless single-child node into that child, joining their labels. The merged
  \ label opens on the same unit, so the parent's index entry still stands.
  merge-child: ( node i child -- radix-node ) [
    dup children>> 0 #nth
    over label>> over label>> #append
    with-label
    [ drop ] dip
    replace-child
  ] ;

  \ Put a rebuilt child back, compressing away what a delete emptied. A childless node with
  \ no value has nothing left to say, and a single-child one with no value is a label its
  \ parent's edge should absorb.
  \
  \ The value has to be read first. A node that just lost its last child may still hold an
  \ entry of its own.
  prune-child: ( node i child -- radix-node ) [
    dup value>> option:some? [
      replace-child
    ] [
      dup children>> #len
      dup 0 = [ 2drop drop-child ] [ 1 = [ merge-child ] [ replace-child ] if ] if
    ] if
  ] ;

  \ Both descent arms end the same way: the arm has built the node that replaces slot i,
  \ and the key state the insert walk carried down is spent.
  finish-insert: ( node key offset value i child -- radix-node ) [
    [ 3drop ] 2dip replace-child
  ] ;

  \ The delete counterpart. A delete that found nothing rebuilds no node at any level, so
  \ the parent goes back untouched.
  finish-delete: ( node i child removed? -- radix-node removed? ) [
    [ prune-child t ] [ 2drop f ] if
  ] ;

  \ Add a childless node for the key's untaken units, keeping the index sorted.
  add-leaf: ( node unit label value -- radix-node ) [
    leaf-node
    2 pick-n index>> 2 pick-n index-slot
    -rot> splice-child
  ] ;

  \ Break a child's edge at `c` units. The child keeps the tail of its label. A new node
  \ takes the head, and holds the value itself when the key ends at the break; otherwise it
  \ gains a second child for the key's remaining units.
  split-child: ( child c rest value -- radix-node ) [
    [ [ dup label>> ] dip split-label ] 2dip
    [ swap [ with-label ] dip swap ] 2dip
    \ ( head tail-node rest value )
    over #len 0 = [
      nip >option:some
      over label>> 0 1 #slice
      2 pick-n 1array
      [ drop ] 3dip
      make-radix-node
    ] [
      leaf-node [ option:none ] 2dip fork-node
    ] if
  ] ;
}

private{
  \ Path-copying insert. `added?` reports whether the entry is new, which is what keeps the
  \ tree's count exact.
  insert-node: stack-recursive ( node key offset value -- radix-node added? ) [
    2 pick-n #len 2 pick-n = [
      \ The key ends here, so the entry is this node's own value.
      >option:some
      3 pick-n value>> option:some? not
      [ [ 2drop ] dip with-value ] dip
    ] [
      2 pick-n 2 pick-n #nth
      4 pick-n index>> over #index-of
      dup not [
        \ Nothing is indexed under the key's next unit: the rest of the key is a new leaf.
        drop
        [ over #len #slice ] 2dip -rot> add-leaf
        t
      ] [
        nip
        \ ( node(4) key(3) offset(2) value(1) i(0) )
        4 pick-n children>> over #nth
        dup label>>
        5 pick-n 5 pick-n 2 pick-n common-units
        \ ( node(7) key(6) offset(5) value(4) i(3) child(2) label(1) c(0) )
        over #len over = [
          \ The label is spent, so the key continues below this child.
          [ drop ] dip
          1 pick-n 6 pick-n 6 pick-n 3 pick-n + 6 pick-n insert-node
          [ 2nip finish-insert ] dip
        ] [
          \ The key diverges partway along the label, so the edge breaks at that point.
          [ drop ] dip
          5 pick-n 5 pick-n 2 pick-n + 1 pick-n #len #slice
          2 pick-n 2 pick-n 2 pick-n 7 pick-n split-child
          [ 3drop ] dip
          finish-insert
          t
        ] if
      ] if
    ] if
  ] ;
}

private{
  \ Path-copying delete. `removed?` reports whether the key was there, which is what keeps
  \ the tree's count exact.
  \
  \ The descent test is `insert-node`'s. `common-units` clamps its count to what is left of
  \ the key, so a count reaching the whole label says both that the label fits and that it
  \ matches. Reading it the same way keeps the two write paths from disagreeing about which
  \ child a key belongs under.
  delete-node: stack-recursive ( node key offset -- radix-node removed? ) [
    1 pick-n #len over = [
      \ The key ends here, so the entry is this node's own value.
      2drop
      dup value>> option:some? [ option:none with-value t ] [ f ] if
    ] [
      1 pick-n over #nth
      3 pick-n index>> over #index-of
      dup not [
        \ Nothing is indexed under the key's next unit, so the key is not in the tree.
        drop 3drop f
      ] [
        nip
        \ ( node(3) key(2) offset(1) i(0) )
        3 pick-n children>> over #nth
        3 pick-n 3 pick-n 2 pick-n label>> common-units
        \ ( node(5) key(4) offset(3) i(2) child(1) c(0) )
        dup 2 pick-n label>> #len = [
          \ The label is spent, so the key continues below this child.
          3 pick-n +
          over 5 pick-n 2 pick-n delete-node
          [ 2drop 2nip ] 2dip
          finish-delete
        ] [
          \ The key diverges partway along the label, so it was never in the tree.
          3drop 2drop f
        ] if
      ] if
    ] if
  ] ;
}

private{
  \ One descent step, run in the predicate so the body gets the child it found. Leaves
  \ ( child end t ) when the child's whole label matches the key at `offset`, and f when
  \ the key is spent, no child is indexed under its next unit, or the label diverges.
  \
  \ `carried` is whatever the body accumulates down the path. The step never reads it, which is
  \ what lets the lookup walk and the cover walk below share this one.
  walk-step?: ( key key-len carried node offset -- ..a ? ) [
    dup 4 pick-n < [
      4 pick-n over #nth
      2 pick-n index>> over #index-of
      dup not [ 2drop f ] [
        3 pick-n children>> swap #nth
        nip
        dup label>> #len 2 pick-n +
        dup 6 pick-n > [ 2drop f ] [
          6 pick-n 3 pick-n 2 pick-n #slice
          2 pick-n label>> = [ t ] [ 2drop f ] if
        ] if
      ] if
    ] [ f ] if
  ] ;

  \ Step onto the matched child, remembering its value when it holds one.
  walk-advance: ( key key-len best node offset child end -- key key-len best node offset ) [
    1 pick-n value>> dup option:some? [ ] [ drop 4 pick-n ] if
    -rot> [ 3drop ] 3dip
  ] ;

  \ Descend as far as the key allows. Every node the walk enters has its whole path matched
  \ against the key, so `best` ends as the longest registered prefix, and a walk that spends
  \ the key ends on the node holding the exact entry.
  radix-walk: ( tree key -- key key-len best node offset ) [
    swap root>> over #len swap dup value>> swap 0
    [ walk-step? ] [ walk-advance ] while
  ] ;
}

private{
  \\ One node still to visit, paired with the key its path spells out. A key exists in the tree
  \\ only as the labels above a node, so an enumeration carries it down rather than recovering it.
  radix-frame: struct{ key node } ;

  \ Push every child of `node`, largest first, so the smallest comes off next. A child's key is
  \ its parent's with the child's own label appended.
  push-children: ( stack key node -- stack ) [
    children>> dup #len
    [ dup 0 > ]
    [
      1 -
      2dup #nth
      dup label>> 4 pick-n swap #append
      swap make-radix-frame
      4 pick-n swap #push! drop
    ]
    while
    3drop
  ] ;

  \ Iterator step: state is the pending stack. A node is popped ahead of its children and the
  \ children come off in index order, which is what makes the walk lexicographic: a node's own
  \ key is a proper prefix of every key below it, and an ascending index orders whole subtrees.
  \
  \ A node with no value of its own is skipped once its children are queued, so passing a fork
  \ costs a step rather than an element.
  radix-iter-step: ( state -- option ) [
    dup #empty? [
      drop option:none
    ] [
      #pop! unmake-radix-frame
      2 pick-n 2 pick-n 2 pick-n push-children drop
      dup value>> dup option:some? [
        option:some> nip make-radix-entry nip >option:some
      ] [
        drop 2drop radix-iter-step
      ] if
    ] if
  ] ;

  \ Entries under one node, `key` being what that node's own path spells.
  subtree-iterator: ( key node -- iterator ) [
    make-radix-frame
    [ ] make-vector swap #push!
    [ radix-iter-step ] curry
    >iterator
  ] ;
}

private{
  \ Step onto the matched child, extending the key by the label just crossed.
  cover-advance: ( prefix prefix-len key node offset child end -- prefix prefix-len key node offset ) [
    1 pick-n label>> 5 pick-n swap #append
    -rot> [ 3drop ] 3dip
  ] ;

  \ Descend while whole labels fit inside the prefix. What is left is the deepest node whose path
  \ the prefix covers, and whatever the prefix still has to spend below it.
  \
  \ The descent condition is the lookup walk's, so `walk-step?` is shared. Only the body differs:
  \ a lookup remembers the deepest value it passed, and this remembers the key it has spelled.
  cover-walk: ( tree prefix -- prefix prefix-len key node offset ) [
    swap root>> over #len swap
    dup label>> swap 0
    [ walk-step? ] [ cover-advance ] while
  ] ;

  \ The node whose subtree is exactly the keys extending `prefix`, paired with the key its own
  \ path spells. `option:none` when no key in the tree starts with `prefix`.
  cover-frame?: ( tree prefix -- option ) [
    cover-walk
    dup 4 pick-n = [
      \ The prefix is spent, so the node the walk stopped on is the cover.
      drop make-radix-frame >option:some 2nip
    ] [
      4 pick-n over #nth
      2 pick-n index>> over #index-of
      dup not [
        \ Nothing is indexed under what the prefix has left.
        3drop 2drop 2drop option:none
      ] [
        3 pick-n children>> swap #nth
        nip
        5 pick-n 2 pick-n 2 pick-n label>> common-units
        dup 3 pick-n + 6 pick-n = [
          \ The prefix runs out partway along this child's label. Every key below the child
          \ therefore opens with the whole prefix, so the child is the cover.
          drop
          dup label>> 4 pick-n swap #append
          swap make-radix-frame >option:some
          [ 3drop 2drop ] dip
        ] [
          \ The two diverge inside the label.
          3drop 2drop 2drop option:none
        ] if
      ] if
    ] if
  ] ;
}

private{
  throw-empty: never-returns ( -- * ) [
    f "operation on an empty radix tree" EEmptySequence make-error throw
  ] ;

  \ The lexicographically smallest entry below `node`. A node's own value beats everything under
  \ it, since every key down there extends this one.
  first-entry: ( key node -- radix-entry ) [
    dup value>> dup option:some? [
      option:some> nip make-radix-entry
    ] [
      drop
      children>> 0 #nth
      dup label>> swap [ #append ] dip
      first-entry
    ] if
  ] ;

  \ The lexicographically largest entry below `node`. The descent takes the last child until a
  \ node has none, and the compression invariant leaves a childless node holding a value.
  last-entry: ( key node -- radix-entry ) [
    dup children>> dup #len 0 = [
      drop value>> option:some> make-radix-entry
    ] [
      dup #len 1 - #nth nip
      dup label>> swap [ #append ] dip
      last-entry
    ] if
  ] ;
}

\\ An empty tree over `key-type`, which must be `string` or `byte-array`. O(1). Throws
\\ `invalid-argument` on any other type.
\\
\\   string <radix-tree> count>>
\\   => 0
<radix-tree>: ( key-type: type -- radix-tree ) [
  dup string = over byte-array = or not
  [ f "<radix-tree> requires a string or byte-array key type" EInvalidArgument make-error throw ] when
  \ The root's empty label and index have to be in the key's own type. This is the only
  \ place a key type is read rather than compared.
  dup string = [ "" ] [ "" >bytes ] if
  option:none 1 pick-n { } make-radix-node
  swap 0 make-radix-tree
] ;

\\ Store `value` under `key`, returning a new tree. A key already present is replaced and
\\ the count is unchanged. O(k · c) in the key's unit count and the per-node fan-out: the
\\ walk copies the nodes on its path, and each copy rebuilds its child arrays. Throws
\\ `type-mismatch` on a key outside the tree's key type.
\\
\\   string <radix-tree> "/api/" 7 radix-insert count>>
\\   => 1
radix-insert: ( tree: radix-tree key value -- radix-tree ) [
  [ require-key ] dip
  2 pick-n root>> 2 pick-n 0 3 pick-n insert-node
  4 pick-n count>> swap [ 1 + ] when
  4 pick-n key-type>> swap
  [ 3drop ] 3dip
  make-radix-tree
] ;

\\ Remove `key`, returning a new tree. A key that is not present yields an equal tree rather
\\ than raising. O(k · c), like `radix-insert`: the walk copies the nodes on its path, and a
\\ node the delete leaves valueless with one child is folded into that child. Throws
\\ `type-mismatch` on a key outside the tree's key type.
\\
\\   string <radix-tree> "/api/" 7 radix-insert "/api/" radix-delete count>>
\\   => 0
radix-delete: ( tree: radix-tree key -- radix-tree ) [
  require-key
  over root>> over 0 delete-node
  3 pick-n count>> swap [ 1 - ] when
  3 pick-n key-type>> swap
  [ 2drop ] 3dip
  make-radix-tree
] ;

\\ The value stored at exactly `key`, or `option:none`. O(k). Throws `type-mismatch` on a
\\ key outside the tree's key type.
\\
\\   string <radix-tree> "/api/" 7 radix-insert "/api/" radix-lookup? option:some>
\\   => 7
radix-lookup?: ( tree: radix-tree key -- option ) [
  require-key radix-walk
  dup 4 pick-n = [
    drop value>> 2nip nip
  ] [
    3drop 2drop option:none
  ] if
] ;

\\ The value of the longest registered prefix of `key`, or `option:none`. An entry stored
\\ under the empty key is a prefix of every key. O(k). Throws `type-mismatch` on a key
\\ outside the tree's key type.
\\
\\   string <radix-tree> "/api/" 7 radix-insert "/api/v1/x" radix-longest? option:some>
\\   => 7
radix-longest?: ( tree: radix-tree key -- option ) [
  require-key radix-walk
  2drop 2nip
] ;

\\ A lazy iterator over every entry whose key starts with `prefix`, in key order. A key equal to
\\ `prefix` is one of them. O(k) to reach the covering node, and nothing is materialized: taking
\\ the first entry costs the walk, not the subtree. Throws `type-mismatch` on a prefix outside
\\ the tree's key type.
\\
\\   string <radix-tree> "/api/" 1 radix-insert "/api/v1/" 2 radix-insert
\\   "/api/" radix-under #collect #len
\\   => 2
radix-under: ( tree: radix-tree prefix -- iterator ) [
  require-key cover-frame?
  dup option:some?
  [ option:some> unmake-radix-frame subtree-iterator ]
  [ drop { } >iterator ]
  if
] ;

\ Iterator protocol integration: a lazy pre-order walk yielding entries in key order, O(depth)
\ space. The whole tree is the subtree under the root, whose label is already the empty key in
\ the tree's own type.
>iterator: method{ radix-tree } [ root>> dup label>> swap subtree-iterator ] ;

\ Cost-rule protocol conformance: #len and #empty? read the entry count every insert and delete
\ already maintains, and #first and #last are single O(k) descents down the leftmost and
\ rightmost edges.
\
\ #nth is left unimplemented. Selecting by rank would need a subtree count on every node,
\ maintained on every path copy, to answer a question that is unusual against a trie. Iteration
\ through >iterator stays the visible path for positional access.
#len: method{ radix-tree } [ count>> ] ;
#empty?: method{ radix-tree } [ count>> 0 = ] ;

\ Both peeks drop the tree before throwing on empty. The prelude's #first? and #last? recover
\ around the bare form, and recover keeps whatever the failed quotation left behind, so a method
\ that throws with its operand still up leaks it into the caller's stack.
#first: method{ radix-tree } [
  dup count>> 0 = [ drop throw-empty ] [ root>> dup label>> swap first-entry ] if
] ;

#last: method{ radix-tree } [
  dup count>> 0 = [ drop throw-empty ] [ root>> dup label>> swap last-entry ] if
] ;

>array: method{ radix-tree } [ #collect ] ;
