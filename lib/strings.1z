\ lib/strings.1z - String manipulation utilities

use "sequences" ;

\ Split string by delimiter (any string), keeping empty segments
\ Examples:
\   "a,b,c" "," split        →  { "a" "b" "c" }
\   "a,,b" "," split          →  { "a" "" "b" }
\   "hello" "," split         →  { "hello" }
\   "" "," split              →  { "" }
\   "a::b::c" "::" split      →  { "a" "b" "c" }
split: ( str delim -- array ) [
  (split-scan): stack-recursive ( str delim vec pos -- array ) [
    3 pick-n 3 pick-n 2 pick-n #index-of-from
    dup
    [
      \ Found at idx: push str[pos..idx] to vec, advance pos, recurse
      4 pick-n 2 pick-n 2 pick-n #slice
      3 pick-n swap #push! drop
      3 pick-n #len + swap drop
      (split-scan)
    ]
    [
      \ Not found: push str[pos..end] to vec, freeze
      drop
      3 pick-n dup #len 2 pick-n swap #slice
      2 pick-n swap #push! drop
      drop nip nip >array
    ]
    if
  ] ;

  dup #len 0 =
  [ drop 1array ]
  [
    over #len 0 =
    [ 2drop { "" } ]
    [ V{ } 0 (split-scan) ]
    if
  ]
  if
] ;

\ Join array of values into string with separator
\ Examples:
\   { "a" "b" "c" } ", " #join  →  "a, b, c"
\   { 1 2 3 } "-" #join         →  "1-2-3"
\   { } ", " #join              →  ""
\   { "only" } ", " #join       →  "only"
#join: ( array sep -- string ) [
  over #len 0 = [ 2drop "" ] [
    over #len 1 = [ drop #first >string ] [

      \ Main case: 2+ elements
      \ Stack: array sep

      swap dup #first >string swap  \ sep first-str array
      1 over #len #slice            \ sep first-str rest
      <rot-                         \ first-str rest sep

      \ Build reduce quotation: [ >string sep swap #append #append ]
      [ swap #append #append ] curry  \ first-str rest [ sep swap #append #append ]
      [ >string ] swap compose        \ first-str rest quot

      \ Arrange for #reduce: seq init quot
      swap -rot>  \ rest first-str quot
      #reduce

    ] if
  ] if
] ;

\ Helper for repeat: ( pattern result n -- pattern result )
repeat-loop: [
  dup 0 >
  [
    1 -
    [ over #append ] dip
    repeat-loop
  ]
  [ drop ]
  if
] ;

\ Repeat string n times
repeat: ( str n -- str ) [
  dup 1 < [ 2drop "" ] [
    \ Stack: str n (n >= 1)
    over swap    \ str str n (str is both pattern and accumulator)
    1 -          \ str str (n-1)
    repeat-loop  \ str result
    swap drop    \ result
  ] if
] ;

\\ True if a single character is ASCII whitespace (space, tab, newline, CR).
whitespace?: ( char -- ? ) [
  >codepoint
  dup 32 = over 9 = or over 10 = or swap 13 = or
] ;

\\ Remove leading ASCII whitespace.
ltrim: ( str -- str ) [
  dup #empty? not
  [ dup #first whitespace? [ 1 #drop ltrim ] when ]
  when
] ;

\\ Remove trailing ASCII whitespace.
rtrim: ( str -- str ) [
  dup #empty? not
  [ dup #last whitespace?
    [ dup #len 1 - #take rtrim ] when
  ] when
] ;

\\ Remove leading and trailing ASCII whitespace.
trim: ( str -- str ) [ ltrim rtrim ] ;

\\ Split on first occurrence of delimiter. Returns some of { before after } or none.
split-once?: ( str delim -- option ) [
  2dup #index-of dup not
  [ 3drop option:none ]
  [
    -rot> #len <rot-     \ str dlen idx
    2 pick-n over #take  \ str dlen idx before
    [ + ] dip            \ str after-start before
    [ #drop ] dip        \ after before
    swap
    [ 1array ] dip 1array #append
    >option:some
  ]
  if
] ;

\\ Split on first occurrence of delimiter, or throw if not found.
split-once: ( str delim -- pair ) [
  split-once?
  dup option:some?
  [ option:some> ]
  [ drop f "delimiter not found" EKeyNotFound make-error throw ]
  if
] ;
