\ lib/strings.1z - String manipulation utilities
\
\ Compositional layer above scanner and sequences: split, join, trim,
\ and other compound string operations. Some languages place scanner
\ above strings; here scanner is a thin native-level abstraction and
\ strings composes it into higher-level words.

use "sequences" ;
use "scanner" ;

\\ Recursively scan str for delim starting at byte offset pos, pushing each
\\ segment onto vec; once no further delimiter is found, push the trailing
\\ segment and freeze vec into an array. pos is a byte offset throughout, so the
\\ scan is O(n) regardless of multi-byte density. delim-blen is the delimiter's
\\ byte length, threaded so the advance past a found delimiter needs no rescan.
(split-scan): stack-recursive ( str delim delim-blen vec pos -- array ) [
  4 pick-n 4 pick-n 2 pick-n #byte-index-of-from
  dup
  [
    \ Found at byte idx: push str[pos..idx] to vec, advance pos, recurse
    5 pick-n 2 pick-n 2 pick-n #byte-slice
    3 pick-n swap #push! drop
    3 pick-n + swap drop
    (split-scan)
  ]
  [
    \ Not found: push str[pos..byte-len] to vec, freeze
    drop
    4 pick-n dup >bytes #len 2 pick-n swap #byte-slice
    2 pick-n swap #push! drop
    drop nip nip nip >array
  ]
  if
] ;

\\ Split string by delimiter (any string), keeping empty segments.
\\
\\ Examples:
\\
\\   "a,b,c" "," split      →  { "a" "b" "c" }
\\   "a,,b" "," split       →  { "a" "" "b" }
\\   "hello" "," split      →  { "hello" }
\\   "" "," split           →  { "" }
\\   "a::b::c" "::" split   →  { "a" "b" "c" }
split: ( str delim -- array ) [
  dup #len 0 =
  [ drop 1array ]
  [
    over #len 0 =
    [ 2drop { "" } ]
    [ dup >bytes #len V{ } 0 (split-scan) ]
    if
  ]
  if
] ;

\\ Reduce step for #join: coerce item to a string, then push the separator
\\ and that string onto the accumulator vector.
(join-push): ( sep vec item -- sep vec ) [
  >string              \ sep vec itemstr
  [ over #push! ] dip  \ push separator before this element
  #push!               \ push the element's string
] ;

\\ Join array of values into string with separator.
\\
\\ Collects the fragments into a vector, then concatenates once. A single
\\ #append over the whole vector is O(total length); repeated pairwise
\\ #append would re-copy the growing accumulator on every element.
\\
\\ Examples:
\\
\\   { "a" "b" "c" } ", " #join  →  "a, b, c"
\\   { 1 2 3 } "-" #join         →  "1-2-3"
\\   { } ", " #join              →  ""
\\   { "only" } ", " #join       →  "only"
#join: ( array sep -- string ) [
  over #len 0 = [ 2drop "" ] [
    over #len 1 = [ drop #first >string ] [
      swap                     \ sep array
      dup #first >string       \ sep array first-str
      V{ } swap #push!         \ sep array vec   (vec = [ first-str ])
      swap                     \ sep vec array
      1 over #len #slice       \ sep vec rest    (array[1..])
      swap                     \ sep rest vec
      [ (join-push) ] #reduce  \ sep vec         (all fragments collected)
      "" swap #append          \ sep result      (single O(total) concat)
      nip                      \ result
    ] if
  ] if
] ;

\\ Concatenate a sequence of string fragments into one string.
\\
\\ A single #append over the whole sequence is O(total length); building the
\\ result with repeated pairwise #append would re-copy the growing accumulator
\\ on every fragment. Fragments must already be strings; coerce with >string
\\ first if needed.
\\
\\ Examples:
\\
\\   { "a" "b" "c" } #concat  →  "abc"
\\   { "only" } #concat       →  "only"
\\   { } #concat              →  ""
#concat: ( seq -- string ) [ "" swap #append ] ;

\\ Create a write-only in-memory string stream with initial capacity n.
<sized-string-builder>: ( n -- stream ) [ <string-stream> ] ;

\\ Create a write-only in-memory string stream with a 256-byte reservation.
<string-builder>: ( -- stream ) [ 256 <sized-string-builder> ] ;

\ Construct a string-builder, run quot with the builder threaded in (quot has
\ effect ( stream -- )), then drain it with drain-quot. If quot or the drain
\ throws, the builder is closed and the error re-raised, so its buffer is never
\ leaked.
(with-builder-drain): ( quot drain-quot -- result ) [
  <string-builder>
  dup [ stream-close rethrow ] curry
  [ -rot> [ bi ] curry curry curry ] dip
  recover
] ;

\\ Run quot with a fresh in-memory string-builder threaded in (quot has effect
\\ ( stream -- )) and return the accumulated string. The builder is closed even
\\ if quot throws.
using-string-builder: ( quot -- string ) [ [ >string! ] (with-builder-drain) ] ;

\\ As `using-string-builder`, but returns the accumulated bytes as a byte-array.
using-string-builder(bytes): ( quot -- byte-array ) [ [ >bytes! ] (with-builder-drain) ] ;

\\ Append pattern to result n more times, recurring until n reaches zero.
repeat-loop: ( pattern result n -- pattern result ) [
  dup 0 >
  [
    1 -
    [ over #append ] dip
    repeat-loop
  ]
  [ drop ]
  if
] ;

\\ Repeat string n times.
\\
\\ Examples:
\\
\\   "ab" 3 repeat  →  "ababab"
\\   "x" 0 repeat   →  ""
repeat: ( str n -- str ) [
  dup 1 < [ 2drop "" ] [
    \ Stack: str n (n >= 1)
    over swap    \ str str n (str is both pattern and accumulator)
    1 -          \ str str (n-1)
    repeat-loop  \ str result
    swap drop    \ result
  ] if
] ;

\\ True if a single character is ASCII whitespace (space, tab, newline, CR).
whitespace?: ( char -- ? ) [
  >codepoint
  dup 32 = over 9 = or over 10 = or swap 13 = or
] ;

\\ Remove leading ASCII whitespace.
ltrim: ( str -- str ) [
  dup #empty? not
  [ dup #first whitespace? [ 1 #drop ltrim ] when ]
  when
] ;

\\ Remove trailing ASCII whitespace.
rtrim: ( str -- str ) [
  dup #empty? not
  [ dup #last whitespace?
    [ dup #len 1 - #take rtrim ] when
  ] when
] ;

\\ Remove leading and trailing ASCII whitespace.
trim: ( str -- str ) [ ltrim rtrim ] ;

\\ Split on first occurrence of delimiter. Returns some of { before after } or none.
split-once?: ( str delim -- option ) [
  swap <scanner> swap
  \ scanner delim
  dup -rot>
  \ delim scanner delim
  take-until
  \ delim scanner-at-match before  (found)
  \ delim original-scanner f       (not found)
  dup f = [
    drop 2drop option:none
  ] [
    -rot>
    \ before delim scanner-at-match
    swap skip-exact
    \ before scanner-past-delim/f
    dup f = [
      2drop option:none
    ] [
      rest
      2 array-n >option:some
    ] if
  ] if
] ;

\\ Split on first occurrence of delimiter, or throw if not found.
split-once: ( str delim -- pair ) [
  split-once?
  dup option:some?
  [ option:some> ]
  [ drop f "delimiter not found" EKeyNotFound make-error throw ]
  if
] ;
