\ Unit tests for lib/union-find.1z.
\
\ The forest is mutable, so every test builds its own structure. Path halving is pinned
\ by reading the parent vector around a root query, which is the write that makes a
\ repeat query cheaper. The runner executes test words in alphabetical order, so each
\ group's section banner sits on its alphabetically first word.

use "union-find" ;
use { <range>: } "ranges" ;
use "testing" ;

\ --- Helpers ---

\ A forest of the shape 0 <- { 1, 2 }, 2 <- 3. Merging two equal-size pairs puts the
\ second pair's root one level down, so element 3 sits at depth two.
depth-two-fixture: ( -- uf ) [
  4 <union-find>
  dup 0 1 union-find-merge drop
  dup 2 3 union-find-merge drop
  dup 0 2 union-find-merge drop
] ;

\ Six elements merged as (5,0) and (1,2). Both are size ties, so the second argument's
\ root moves and the first component's root is 5 while its smallest member is 0.
\ First-encounter iteration order therefore differs from root order, which is what pins
\ the documented ordering.
iteration-fixture: ( -- uf ) [
  6 <union-find>
  dup 5 0 union-find-merge drop
  dup 1 2 union-find-merge drop
] ;

\ --- Add ---

test-add-appends-singletons: ( -- ) [
  "add" test-section
  2 <union-find>
  dup union-find-add 2 "the first add returns the next index" assert=
  dup union-find-add 3 "adds return sequential indices" assert=
  dup components>> 4 "each add is one more component" assert=
  3 union-find-root 3 "an added element is its own root" assert=
] ;

test-add-matches-presized: ( -- ) [
  0 <union-find> 3 [ dup union-find-add drop ] times
  3 <union-find>
  over parents>> >array over parents>> >array "grown parents match presized" assert=
  over sizes>> >array over sizes>> >array "grown sizes match presized" assert=
  over components>> over components>> "grown component count matches presized" assert=
  2drop
] ;

\ --- Out of range ---

test-bounds-connected-throws: ( -- ) [
  "out of range" test-section
  [ 2 <union-find> 0 5 union-find-connected? ] index-out-of-bounds:
  "connected? with an out-of-range index throws" assert-error-type
] ;

test-bounds-merge-throws: ( -- ) [
  [ 2 <union-find> 0 5 union-find-merge ] index-out-of-bounds:
  "merge with an out-of-range index throws" assert-error-type
] ;

test-bounds-negative-throws: ( -- ) [
  [ 2 <union-find> -1 union-find-root ] index-out-of-bounds:
  "root at a negative index throws" assert-error-type
] ;

test-bounds-nothing-extended: ( -- ) [
  2 <union-find>
  dup [ 2 union-find-root ] curry index-out-of-bounds: "root at n throws" assert-error-type
  union-find-add 2 "the failed lookup extended nothing" assert=
] ;

test-bounds-root-throws: ( -- ) [
  [ 2 <union-find> 2 union-find-root ] index-out-of-bounds:
  "root at n throws" assert-error-type
] ;

test-bounds-size-throws: ( -- ) [
  [ 2 <union-find> 2 union-find-size ] index-out-of-bounds:
  "size at n throws" assert-error-type
] ;

\ --- Component size ---

test-component-size-after-merges: ( -- ) [
  "component size" test-section
  4 <union-find>
  dup 0 1 union-find-merge drop
  dup 0 2 union-find-merge drop
  dup 0 union-find-size 3 "the merged set counts three" assert=
  dup 3 union-find-size 1 "the untouched singleton counts one" assert=
  drop
] ;

test-component-size-either-member: ( -- ) [
  3 <union-find>
  dup 0 1 union-find-merge drop
  dup 1 union-find-size over 0 union-find-size "either member reads the same size" assert=
  drop
] ;

test-component-size-singleton-after-add: ( -- ) [
  1 <union-find>
  dup union-find-add
  union-find-size 1 "an added element is a singleton" assert=
] ;

\ --- Connected ---

test-connected-reports-pairs: ( -- ) [
  "connected" test-section
  3 <union-find>
  dup 0 1 union-find-merge drop
  dup 0 1 union-find-connected? "a merged pair is connected" assert-true
  dup 1 0 union-find-connected? "connectedness is symmetric" assert-true
  dup 0 2 union-find-connected? "an unmerged pair is not connected" assert-false
  drop
] ;

test-connected-transitive: ( -- ) [
  4 <union-find>
  dup 0 1 union-find-merge drop
  dup 1 2 union-find-merge drop
  dup 0 2 union-find-connected? "connectivity is transitive" assert-true
  drop
] ;

\ --- Construction ---

test-construct-empty: ( -- ) [
  "construction" test-section
  0 <union-find> components>> 0 "an empty union-find has zero components" assert=
] ;

test-construct-negative-throws: ( -- ) [
  [ -1 <union-find> ] invalid-argument: "a negative count throws" assert-error-type
] ;

test-construct-singletons: ( -- ) [
  3 <union-find>
  dup 0 union-find-root 0 "element 0 is its own root" assert=
  dup 2 union-find-root 2 "element 2 is its own root" assert=
  components>> 3 "n singletons are n components" assert=
] ;

\ --- Path halving ---

test-halving-repoints-to-grandparent: ( -- ) [
  "path halving" test-section
  depth-two-fixture
  dup parents>> 3 #nth 2 "element 3 starts at depth two" assert=
  dup 3 union-find-root 0 "the deep element resolves to the root" assert=
  parents>> 3 #nth 0 "the query re-pointed 3 at its grandparent" assert=
] ;

\ --- Iteration ---

test-iter-components-ordered: ( -- ) [
  "iteration" test-section
  iteration-fixture >iterator #collect
  { { 0 5 } { 1 2 } { 3 } { 4 } }
  "components come by smallest member, members ascending" assert=
] ;

test-iter-empty-structure: ( -- ) [
  0 <union-find> >iterator #collect { } "no elements yield no components" assert=
] ;

test-iter-groups-at-first-step: ( -- ) [
  4 <union-find>
  dup >iterator
  over 0 1 union-find-merge drop
  #collect nip
  { { 0 1 } { 2 } { 3 } }
  "grouping runs at the first step, not at iterator creation" assert=
] ;

test-iter-snapshot-survives-merge: ( -- ) [
  iteration-fixture
  dup >iterator
  dup [ drop t ] #any drop
  over 3 4 union-find-merge drop
  #collect nip
  { { 1 2 } { 3 } { 4 } }
  "a merge does not disturb an iterator already in flight" assert=
] ;

\ --- Union-find-map ---

test-map-add-and-root: ( -- ) [
  "union-find-map" test-section
  [ cmp ] <union-find-map>
  dup 10 union-find-map-add
  dup 20 union-find-map-add
  dup 30 union-find-map-add
  dup 10 20 union-find-map-merge t "joining two singletons reports t" assert=
  dup 10 20 union-find-map-merge f "an already-connected pair reports f" assert=
  dup 20 union-find-map-root 10 "root answers in the element domain" assert=
  dup 10 30 union-find-map-connected? "unmerged elements are not connected" assert-false
  10 union-find-map-size 2 "the merged set counts two" assert=
] ;

test-map-domains: ( -- ) [
  [ cmp ] <union-find-map>
  dup 7 union-find-map-add
  dup 9 union-find-map-add
  dup 7 9 union-find-map-merge drop
  9 union-find-map-root 7 "fixnum elements resolve" assert=
  [ cmp ] <union-find-map>
  dup "left" union-find-map-add
  dup "right" union-find-map-add
  dup "left" "right" union-find-map-merge drop
  "right" union-find-map-root "left" "string elements resolve" assert=
  [ [ >string ] dip >string cmp ] <union-find-map>
  dup left: union-find-map-add
  dup right: union-find-map-add
  dup left: right: union-find-map-merge drop
  right: union-find-map-root left: "symbol elements resolve" assert=
] ;

test-map-duplicate-add: ( -- ) [
  [ cmp ] <union-find-map>
  dup "a" union-find-map-add
  dup "a" union-find-map-add
  dup #len 1 "a repeated add is a no-op" assert=
  dup "a" union-find-map-size 1 "the element is still a singleton" assert=
  "a" union-find-map-root "a" "the element still roots itself" assert=
] ;

test-map-iteration: ( -- ) [
  [ cmp ] <union-find-map>
  dup "a" union-find-map-add
  dup "b" union-find-map-add
  dup "c" union-find-map-add
  dup "d" union-find-map-add
  dup "c" "a" union-find-map-merge drop
  dup >iterator #collect
  { { "a" "c" } { "b" } { "d" } }
  "components come as element arrays in first-encounter order" assert=
  "a" union-find-map-root "c" "on a tie the second argument's root moved" assert=
] ;

test-map-protocol: ( -- ) [
  [ cmp ] <union-find-map>
  dup #empty? "an empty map is #empty?" assert-true
  dup #len 0 "an empty map has zero components" assert=
  dup "a" union-find-map-add
  dup "b" union-find-map-add
  dup #empty? "elements make it non-empty" assert-false
  dup #len 2 "#len is the component count" assert=
  dup "a" "b" union-find-map-merge drop
  dup #len 1 "a join drops #len by one" assert=
  [ 0 #nth ] curry "#nth on a union-find-map throws" assert-error
  [ cmp ] <union-find-map> [ #first ] curry "#first on a union-find-map throws" assert-error
] ;

test-map-root-option: ( -- ) [
  [ cmp ] <union-find-map>
  dup "a" union-find-map-add
  dup "a" union-find-map-root? option:some> "a" "root? unwraps to the representative" assert=
  dup "z" union-find-map-root? option:some? "root? on an unknown element is none" assert-false
  #len 1 "the failed lookup interned nothing" assert=
] ;

test-map-unknown-raises: ( -- ) [
  [ cmp ] <union-find-map>
  dup "a" union-find-map-add
  dup [ "z" union-find-map-root ] curry index-out-of-bounds:
  "root on an unknown element throws" assert-error-type
  dup [ "z" "a" union-find-map-merge ] curry index-out-of-bounds:
  "merge on an unknown first element throws" assert-error-type
  dup [ "a" "z" union-find-map-merge ] curry index-out-of-bounds:
  "merge on an unknown second element throws" assert-error-type
  dup [ "z" "a" union-find-map-connected? ] curry index-out-of-bounds:
  "connected? on an unknown element throws" assert-error-type
  dup [ "z" union-find-map-size ] curry index-out-of-bounds:
  "size on an unknown element throws" assert-error-type
  #len 1 "the failed lookups interned nothing" assert=
] ;

\ --- Merge ---

test-merge-connects-transitively: ( -- ) [
  "merge" test-section
  4 <union-find>
  dup 0 1 union-find-merge drop
  dup 1 2 union-find-merge drop
  dup 0 union-find-root over 2 union-find-root "chained merges share one root" assert=
  drop
] ;

test-merge-joins-and-reports: ( -- ) [
  3 <union-find>
  dup 0 1 union-find-merge t "joining two singletons reports t" assert=
  dup 0 union-find-root over 1 union-find-root "merged elements share a root" assert=
  dup 0 1 union-find-merge f "an already-connected pair reports f" assert=
  components>> 2 "only the join dropped the component count" assert=
] ;

\ --- Protocol methods ---

test-protocol-empty: ( -- ) [
  "protocol methods" test-section
  0 <union-find> #empty? "no elements is #empty?" assert-true
  1 <union-find> #empty? "a singleton is not #empty?" assert-false
] ;

test-protocol-len-counts-components: ( -- ) [
  3 <union-find>
  dup #len 3 "#len is the component count" assert=
  dup 0 1 union-find-merge drop
  dup #len 2 "a join drops #len by one" assert=
  dup #len over components>> "#len reads the maintained counter" assert=
  drop
] ;

test-protocol-unregistered-throw: ( -- ) [
  [ 2 <union-find> 0 #nth ] "#nth on a union-find throws" assert-error
  [ 2 <union-find> #first ] "#first on a union-find throws" assert-error
  [ 2 <union-find> 9 #push ] "#push on a union-find throws" assert-error
  [ 2 <union-find> #pop ] "#pop on a union-find throws" assert-error
] ;

\ --- Scale ---

test-scale-chain-collapses: ( -- ) [
  "scale" test-section
  2000 <union-find>
  0 1999 <range> [ over swap dup 1 + union-find-merge drop ] #each
  dup 0 union-find-root over 1999 union-find-root "the chain collapses to one root" assert=
  components>> 1 "one component remains" assert=
] ;

test-scale-components-cover-all: ( -- ) [
  2000 <union-find>
  0 1999 <range> [ over swap dup 1 + union-find-merge drop ] #each
  dup #len 1 "one component remains through the protocol" assert=
  >iterator #collect 0 #nth #len 2000 "the single component holds every element" assert=
] ;

\ --- Union by size ---

test-size-attaches-smaller-under-larger: ( -- ) [
  "union by size" test-section
  4 <union-find>
  dup 0 1 union-find-merge drop
  dup 0 2 union-find-merge drop
  dup 3 0 union-find-merge drop
  dup 3 union-find-root 0 "the singleton joined the larger tree's root" assert=
  dup parents>> 3 #nth 0 "the smaller tree's root moved, not the larger's" assert=
  sizes>> 0 #nth 4 "the winner's size is the exact sum" assert=
] ;

test-size-tie-moves-second-arguments-root: ( -- ) [
  2 <union-find>
  dup 1 0 union-find-merge drop
  parents>> 0 #nth 1 "on a tie the second argument's root moves" assert=
] ;
