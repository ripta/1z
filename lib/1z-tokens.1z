\ lib/1z-tokens.1z - Tokenizer for 1z source code
\
\ Configures the generic lexer framework with rules for all 1z token types.
\ Produces a lazy token stream suitable for linting, syntax highlighting,
\ and other source-level tools.

use "scanner" ;
use "lexer" ;
use "char" ;
use "conversions" ;

\ --- Character helpers ---

(tab): ( -- str ) [ 9 >char ] ;
(lf):  ( -- str ) [ 10 >char ] ;
(cr):  ( -- str ) [ 13 >char ] ;

(non-newline?): ( ch -- ? ) [ (lf) = not ] ;
(ws-not-newline?): ( ch -- ? ) [ dup " " = swap (tab) = or ] ;

\ Slice the matched text by byte offsets while keeping the codepoint start position for the token.
\
\ Callers capture both a codepoint position `(start-cp)` and a byte mark `(start-byte)` before
\ advancing the scanner; this slices `source[start-byte .. current-byte]` and discards start-byte.
\ Output matches the shape of take-while: start-cp scanner' value.
(extract-value): ( start-cp start-byte scanner -- start-cp scanner value ) [
  dup str>> over mark
  \ start-cp start-byte scanner source end-byte
  3 pick-n swap
  \ start-cp start-byte scanner source start-byte end-byte
  #byte-slice
  \ start-cp start-byte scanner value
  [ nip ] dip
] ;

\ --- Rule 1: newline ---

(newline-match): ( scanner -- new-scanner token | f ) [
  dup peek (lf) = [
    dup position>> swap advance swap
    [ newline: (lf) ] dip make-token
  ] [ drop f ] if
] ;

\ --- Rule 2: whitespace (spaces and tabs, not newlines) ---

(ws-match): ( scanner -- new-scanner token | f ) [
  dup peek dup f = [ 2drop f ] [
    (ws-not-newline?) [
      dup position>> swap
      [ (ws-not-newline?) ] take-while
      <rot- [ whitespace: swap ] dip make-token
    ] [ drop f ] if
  ] if
] ;

\ --- Rule 3: doc-comment (\\  followed by whitespace or at end) ---

(starts-doc-comment?): ( scanner -- ? ) [
  dup peek "\\" = [
    dup advance peek "\\" = [
      \ two backslashes present; check third char or end
      advance advance peek dup f = [
        \ exactly \\ at end of input
        drop t
      ] [
        dup " " = over (tab) = or over (lf) = or swap (cr) = or
      ] if
    ] [ drop f ] if
  ] [ drop f ] if
] ;

(doc-comment-match): ( scanner -- new-scanner token | f ) [
  dup (starts-doc-comment?) [
    dup position>> swap
    [ (non-newline?) ] take-while
    <rot- [ doc-comment: swap ] dip make-token
  ] [ drop f ] if
] ;

\ --- Rule 4: comment (\  followed by whitespace or at end) ---

(starts-comment?): ( scanner -- ? ) [
  dup peek "\\" = [
    advance peek dup f = [
      \ lone backslash at end of input
      drop t
    ] [
      dup " " = over (tab) = or over (lf) = or swap (cr) = or
    ] if
  ] [ drop f ] if
] ;

(comment-match): ( scanner -- new-scanner token | f ) [
  dup (starts-comment?) [
    dup position>> swap
    [ (non-newline?) ] take-while
    <rot- [ comment: swap ] dip make-token
  ] [ drop f ] if
] ;

\ --- Rule 5: interpreter line (#! at the very start of the source) ---
\
\ Emitted as a comment, matching the host tokenizer, so an executable script lints and
\ highlights like any other file. Off the first character a `#` falls through to the word rule,
\ which is what keeps `#len` and its siblings intact.

(starts-shebang?): ( scanner -- ? ) [
  dup position>> 0 = [
    dup peek "#" = [ advance peek "!" = ] [ drop f ] if
  ] [ drop f ] if
] ;

(shebang-match): ( scanner -- new-scanner token | f ) [
  dup (starts-shebang?) [
    dup position>> swap
    [ (non-newline?) ] take-while
    <rot- [ comment: swap ] dip make-token
  ] [ drop f ] if
] ;

\ --- Rule 6: string literal ---

(string-loop): ( scanner -- scanner ) [
  dup at-end? not [
    dup peek dup "\"" = [
      \ closing quote: advance past it and stop
      drop advance
    ] [
      "\\" = [
        \ escape: advance past backslash and the escaped char
        advance
        dup at-end? not [ advance ] when
        (string-loop)
      ] [
        advance (string-loop)
      ] if
    ] if
  ] when
] ;

(string-match): ( scanner -- new-scanner token | f ) [
  dup peek "\"" = [
    dup position>> over mark <rot-
    \ start-cp start-byte scanner
    advance (string-loop)
    \ start-cp start-byte scanner'
    (extract-value)
    <rot- [ string: swap ] dip make-token
  ] [ drop f ] if
] ;

\ --- Rule 7: stack effect ( ... ) ---

\ A `)` immediately followed by `:` closes a parenthesized word name such as
\ `(check-zlib):`, not a stack effect. Declining here lets the run fall through
\ to `(symbol-match)`, which accepts it. A real stack effect is always followed
\ by whitespace or a bracket.
(stack-effect-loop): ( scanner -- scanner found? ) [
  dup at-end? [ f ] [
    dup peek dup ")" = [
      drop advance
      dup peek ":" = not
    ] [
      (lf) = [
        \ newline inside parens: not a stack effect
        f
      ] [
        advance (stack-effect-loop)
      ] if
    ] if
  ] if
] ;

(stack-effect-match): ( scanner -- new-scanner token | f ) [
  dup peek "(" = [
    dup position>> over mark <rot-
    \ start-cp start-byte scanner
    advance (stack-effect-loop)
    \ start-cp start-byte scanner' found?
    [
      (extract-value)
      <rot- [ stack-effect: swap ] dip make-token
    ] [
      \ not a stack effect: drop consumed scanner, return f
      3drop f
    ] if
  ] [ drop f ] if
] ;

\ --- Rule 8: number literal ---

(digit-or-sep?):  ( ch -- ? ) [ dup digit? swap "_" = or ] ;
(hex-or-sep?):    ( ch -- ? ) [ dup hex-digit? swap "_" = or ] ;
(octal-digit?):   ( ch -- ? ) [ >codepoint dup 48 >= swap 55 <= and ] ;
(octal-or-sep?):  ( ch -- ? ) [ dup (octal-digit?) swap "_" = or ] ;
(binary-digit?):  ( ch -- ? ) [ dup "0" = swap "1" = or ] ;
(binary-or-sep?): ( ch -- ? ) [ dup (binary-digit?) swap "_" = or ] ;

\ Check if scanner's next chars form a number (digit, or - followed by digit)
(starts-number?): ( scanner -- ? ) [
  dup peek dup f = [ 2drop f ] [
    dup digit? [ 2drop t ] [
      "-" = [
        advance peek dup f = [ drop f ] [ digit? ] if
      ] [ drop f ] if
    ] if
  ] if
] ;

\ Consume the exponent part: e/E, optional +/-, digits
(consume-exponent): ( scanner -- scanner ) [
  dup peek dup f = [ drop ] [
    dup "e" = swap "E" = or [
      advance
      dup peek dup f = [ drop ] [
        dup "+" = swap "-" = or [ advance ] when
        [ (digit-or-sep?) ] take-while drop
      ] if
    ] when
  ] if
] ;

\ Consume the fractional part: . followed by digits, then optional exponent
(consume-fractional): ( scanner -- scanner ) [
  dup peek "." = [
    dup advance peek dup f = [ drop ] [
      digit? [
        advance
        [ (digit-or-sep?) ] take-while drop
        (consume-exponent)
      ] when
    ] if
  ] when
] ;

(1z-number-match): ( scanner -- new-scanner token | f ) [
  dup (starts-number?) [
    dup position>> over mark <rot-
    \ start-cp start-byte scanner
    \ skip optional leading -
    dup peek "-" = [ advance ] when
    \ check for base prefix
    dup peek "0" = [
      dup advance peek dup f = [ drop
        \ just "0" followed by end: consume the 0
        advance
      ] [
        dup "x" = over "X" = or [
          drop advance advance
          [ (hex-or-sep?) ] take-while drop
        ] [
          dup "o" = over "O" = or [
            drop advance advance
            [ (octal-or-sep?) ] take-while drop
          ] [
            "b" = over advance peek "B" = or [
              advance advance
              [ (binary-or-sep?) ] take-while drop
            ] [
              \ decimal starting with 0
              [ (digit-or-sep?) ] take-while drop
              (consume-fractional)
              (consume-exponent)
            ] if
          ] if
        ] if
      ] if
    ] [
      \ decimal number
      [ (digit-or-sep?) ] take-while drop
      (consume-fractional)
      (consume-exponent)
    ] if
    \ start-cp start-byte scanner'
    (extract-value)
    <rot- [ number: swap ] dip make-token
  ] [ drop f ] if
] ;

\ --- Rule 9: semicolon ---

(semicolon-match): ( scanner -- new-scanner token | f ) [
  dup peek ";" = [
    dup position>> swap advance swap
    [ semicolon: ";" ] dip make-token
  ] [ drop f ] if
] ;

\ --- Rule 10: open-bracket ---

(open-bracket-match): ( scanner -- new-scanner token | f ) [
  dup peek "[" = [
    dup position>> swap advance swap
    [ open-bracket: "[" ] dip make-token
  ] [ drop f ] if
] ;

\ --- Rule 11: close-bracket ---

(close-bracket-match): ( scanner -- new-scanner token | f ) [
  dup peek "]" = [
    dup position>> swap advance swap
    [ close-bracket: "]" ] dip make-token
  ] [ drop f ] if
] ;

\ --- Rule 12: close-brace ---

(close-brace-match): ( scanner -- new-scanner token | f ) [
  dup peek "}" = [
    dup position>> swap advance swap
    [ close-brace: "}" ] dip make-token
  ] [ drop f ] if
] ;

\ --- Rule 13: open-brace (including compound forms) ---

BRACE-PREFIXES: ( -- array ) const [
  { "virtual{" "struct{" "pragma{" "method{" "match{" "enum{" "H{" "V{" "M{" "{" }
] ;

(try-brace-prefix): ( scanner prefixes -- new-scanner token | f ) [
  dup #empty? [ 2drop f ] [
    dup #first
    2 pick-n rest over #starts-with? [
      \ scanner prefixes prefix
      [ drop ] dip
      \ scanner prefix
      2dup expect -rot>
      \ new-scanner scanner prefix
      swap position>>
      [ open-brace: swap ] dip make-token
    ] [
      drop 1 #drop (try-brace-prefix)
    ] if
  ] if
] ;

(open-brace-match): ( scanner -- new-scanner token | f ) [
  dup at-end? [ drop f ] [
    BRACE-PREFIXES (try-brace-prefix)
  ] if
] ;

\ --- Rule 14: symbol (2+ non-whitespace chars ending in :) ---

(symbol-match): ( scanner -- new-scanner token | f ) [
  dup position>> swap
  [ whitespace? not ] take-while
  \ start-pos scanner' candidate
  dup #len 1 > over #last ":" = and [
    <rot- [ symbol: swap ] dip make-token
  ] [
    3drop f
  ] if
] ;

\ --- Rule 15: word (fallback, any non-whitespace) ---

\ Pick the kind for a bare word, tagging one that ends in `{` as a brace
\ opener.
\
\ BRACE-PREFIXES names only the forms with a dedicated first-character
\ dispatch, so `private{`, `ffi-def{`, `choose{`, `flag{`, and the rest arrive
\ here. Their `}` is a plain close-brace either way, so leaving them as words
\ hands consumers a stream whose braces do not pair.
(word-kind): ( str -- kind str ) [
  dup #len 1 > over #last "{" = and
  [ open-brace: ] [ word: ] if
  swap
] ;

(1z-word-match): ( scanner -- new-scanner token | f ) [
  dup peek dup f = [ 2drop f ] [
    drop
    dup position>> swap
    [ whitespace? not ] take-while
    <rot- [ (word-kind) ] dip make-token
  ] if
] ;

\ --- Public API ---

\ Module-private cache holding the built lexer, populated once on first use so
\ the first-character dispatch table is built once per process rather than per
\ tokenization. Empty at freeze, so it serializes into an AOT runtime image.
(1z-lexer-cache): ( -- vec ) V{ } ;

\\ Construct a lexer configured for all 1z token types.
\\
\\ Each rule declares the first characters it can begin with via `first:` so the
\\ generic lexer dispatches on the scanner's current character; the symbol and
\\ word rules are fallbacks (no `first:`) tried for every character.
<1z-lexer>: ( -- lexer ) [
  (1z-lexer-cache) dup #empty? [
    drop
    V{ }
    H{ kind: newline: first: "\n" match: [ (newline-match) ] } #push!
    H{ kind: whitespace: first: " \t" match: [ (ws-match) ] } #push!
    H{ kind: doc-comment: first: "\\" match: [ (doc-comment-match) ] } #push!
    H{ kind: comment: first: "\\" match: [ (comment-match) ] } #push!
    H{ kind: comment: first: "#" match: [ (shebang-match) ] } #push!
    H{ kind: string: first: "\"" match: [ (string-match) ] } #push!
    H{ kind: stack-effect: first: "(" match: [ (stack-effect-match) ] } #push!
    H{ kind: number: first: "-0123456789" match: [ (1z-number-match) ] } #push!
    H{ kind: semicolon: first: ";" match: [ (semicolon-match) ] } #push!
    H{ kind: open-bracket: first: "[" match: [ (open-bracket-match) ] } #push!
    H{ kind: close-bracket: first: "]" match: [ (close-bracket-match) ] } #push!
    H{ kind: close-brace: first: "}" match: [ (close-brace-match) ] } #push!
    H{ kind: open-brace: first: "vspmeHVM{" match: [ (open-brace-match) ] } #push!
    H{ kind: symbol: match: [ (symbol-match) ] } #push!
    H{ kind: word: match: [ (1z-word-match) ] } #push!
    >array <lexer>
    (1z-lexer-cache) over #push! drop
  ] [
    #first
  ] if
] ;

\\ Tokenize a 1z source string into a lazy token iterator.
1z-tokenize: ( string -- iterator ) [
  <1z-lexer> tokenize
] ;
