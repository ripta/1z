\ lib/sequences.1z - Sequence predicates and utilities

\ Check if sequence starts with prefix
#starts-with?: ( seq prefix -- ? ) [
  over #len over #len <  \ seq prefix (seqlen < prefixlen)?
  [ 2drop f ]            \ prefix longer than seq -> false
  [
    dup #len               \ seq prefix plen
    swap                   \ seq plen prefix
    [ 0 swap #slice ] dip  \ seq[0:plen] prefix
    =
  ] if
] ;
#head?: [ #starts-with? ] ;

\ Check if sequence ends with suffix
#ends-with?: ( seq suffix -- ? ) [
  over #len over #len <  \ seq suffix (seqlen < suffixlen)?
  [ 2drop f ]            \ suffix longer than seq -> false
  [
    over #len                 \ seq suffix seqlen
    over #len                 \ seq suffix seqlen sufflen
    - swap                    \ seq start suffix
    [ over #len #slice ] dip  \ seq[start:end] suffix
    =
  ] if
] ;
#tail?: [ #ends-with? ] ;

\ Check if index is within bounds of sequence
#in-bounds?: ( index seq -- ? ) [
  dupd #len < [ 0 >= ] [ drop f ] if
] ;

\ Sequence element operations
#suffix: ( seq elem -- seq' ) [ 1array #append ] ;
#prefix: ( elem seq -- seq' ) [ swap 1array #prepend ] ;

\ Remove empty elements from a sequence
\
\ Examples:
\   { "a" "" "b" "" "c" } #squeeze #collect  →  { "a" "b" "c" }
\   { "" } #squeeze #collect                 →  { }
#squeeze: ( seq -- iterator ) [
  [ #len 0 > ] #filter
] ;

\ Split sequence into two arrays by predicate
\\
\\ Elements satisfying the predicate go into the deeper array;
\\ others go into the top array.
\\
\\   { 1 2 3 4 5 } [ even? ] #partition
\\   => { 2 4 } { 1 3 5 }
#partition: ( seq quot -- true-arr false-arr ) [
  swap dup iterator? [ #collect ] when swap
  2dup #filter #collect
  -rot>
  [ call not ] curry
  #filter #collect
] ;
