\ lib/sequences.1z - Sequence predicates and utilities

\ `#starts-with?` and `#ends-with?` are prelude words. Aliases only here.

\\ Alias of `#starts-with?`.
\\
\\   "hello" "he" #head?
\\   => t
#head?: ( seq prefix -- ? ) [ #starts-with? ] ;

\\ Alias of `#ends-with?`.
\\
\\   "hello" "lo" #tail?
\\   => t
#tail?: ( seq suffix -- ? ) [ #ends-with? ] ;

\\ True when the index is a valid 0-based position in the sequence.
\\
\\   3 { 1 2 3 } #in-bounds?
\\   => f
#in-bounds?: ( index seq -- ? ) [
  dupd #len < [ 0 >= ] [ drop f ] if
] ;

\\ A new sequence with the element added at the end.
\\
\\   { 1 2 } 3 #suffix
\\   => { 1 2 3 }
#suffix: ( seq elem -- seq' ) [ 1array #append ] ;

\\ A new sequence with the element added at the front.
\\
\\   0 { 1 2 } #prefix
\\   => { 0 1 2 }
#prefix: ( elem seq -- seq' ) [ swap 1array #prepend ] ;

\\ A lazy iterator over the elements whose length is not zero, such as the non-empty strings.
\\
\\   { "a" "" "b" "" "c" } #squeeze #collect
\\   => { "a" "b" "c" }
#squeeze: ( seq -- iterator ) [
  [ #len 0 > ] #filter
] ;

\\ Split sequence into two arrays by predicate.
\\
\\ Elements satisfying the predicate go into the deeper array;
\\ others go into the top array.
\\
\\   { 1 2 3 4 5 } [ even? ] #partition
\\   => { 2 4 } { 1 3 5 }
#partition: ( seq quot -- true-arr false-arr ) [
  swap dup iterator? [ #collect ] when swap
  2dup #filter #collect
  -rot>
  [ call not ] curry
  #filter #collect
] ;

\\ Group elements by a key function into a hash of arrays.
\\ The key function must return a string or symbol.
\\
\\   { "apple" "avocado" "banana" "blueberry" }
\\   [ 0 #nth ] #group-by a: @get
\\   => { "apple" "avocado" }
#group-by: ( seq quot -- hash ) [
  [
    -rot>
    dup 3 pick-n call
    2 pick-n over @get?
    dup option:some?
    [ option:some> <rot- #suffix @set ]
    [ drop swap 1array @set ]
    if
    swap drop
  ] curry
  H{ } swap
  #reduce
] ;

pragma{ lint-suppress: { dead-definition: missing-type-annotation: } }
