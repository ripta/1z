\ lib/lua.1z - Embedded Lua 5.4 via dynamic FFI over the vendored liblua5.4

use "ffi" ;
use "os/path" ;

\ Dylib resolution
\
\ liblua5.4 is vendored and installed beside the interpreter (zig-out/ext), not on
\ the system loader path. Probe a short list of candidate absolute paths and open
\ the first that exists. An installed interpreter finds the sibling ext directory
\ next to a real stdlib directory. In the dev/test tree zig-out/lib is a symlink to
\ the source lib, so the stdlib anchor resolves into the source tree; the working
\ directory candidate covers that case, matching the toy-library test convention.
\
\ Resolution runs once, at load: the path is chosen, the library opened, and the
\ close function captured here, so `open` never re-probes or re-opens per call.

\\ Shared-library extension for the host OS.
(lib-ext): ( -- str ) [ sys-info "os" @get "macos" = [ ".dylib" ] [ ".so" ] if ] ;

\\ True when the path is a string naming an existing file. A non-string (an absent
\\ candidate reported as f) is not a path.
(exists-path?): ( path-or-f -- bool ) [ dup string? [ path-exists? ] [ drop f ] if ] ;

\\ Candidate dylib path beside an installed interpreter: the ext directory that is a
\\ sibling of the standard-library directory. Yields f when the stdlib anchor cannot
\\ be resolved.
(install-lua-path): ( -- path-or-f ) [
  [ "ffi" native.resolve-load-path dirname dirname "/ext/liblua5.4" #append (lib-ext) #append ]
  [ drop f ] recover
] ;

\\ Candidate dylib path in the development tree, relative to the working directory.
\\ Yields f when PWD is unset, which is common under non-shell process launchers.
(cwd-lua-path): ( -- path-or-f ) [
  environ "PWD" f @get-or
  dup string? [ "/zig-out/ext/liblua5.4" #append (lib-ext) #append ] [ ] if
] ;

\\ Resolved dylib path. Prefers the installed sibling, then the development-tree
\\ path, then a bare name for a loader-path install.
(lua-lib-path): ( -- path ) [
  (install-lua-path) dup (exists-path?) [ ] [
    drop (cwd-lua-path) dup (exists-path?) [ ] [ drop "lua5.4" ] if
  ] if
] ;

\\ Bind the Lua C API and the lua_close function, all resolved once at load.
\\
\\ lua_pcall, lua_tonumber, lua_tointeger, lua_tostring, and lua_pop are macros;
\\ the exported targets are bound here and the macros recomposed in 1z.
\\
\\ luaL_newstate raises on a null return via the errno null sentinel.
\\
\\ (lua-close-fn) is the raw lua_close ffi-fn, folded into the reexported module so
\\ `open` can bind it to each state for generic resource-close. ffi-def only exposes
\\ callable wrappers, so the raw function is looked up separately.
(lua-lib-path) lib-open dup ffi-def{
  (new-state):    "luaL_newstate" H{ errno: null: } ffi{ -> ptr:lua-state }
  (open-libs):    "luaL_openlibs" ffi{ ptr -> void }
  (close):        "lua_close" ffi{ ptr -> void }
  (load-string):  "luaL_loadstring" ffi{ ptr cstring -> i32 }
  (pcallk):       "lua_pcallk" ffi{ ptr i32 i32 i32 isize isize -> i32 }
  (push-number):  "lua_pushnumber" ffi{ ptr f64 -> void }
  (push-integer): "lua_pushinteger" ffi{ ptr i64 -> void }
  (push-string):  "lua_pushstring" ffi{ ptr cstring -> cstring }
  (push-boolean): "lua_pushboolean" ffi{ ptr i32 -> void }
  (push-nil):     "lua_pushnil" ffi{ ptr -> void }
  (set-global):   "lua_setglobal" ffi{ ptr cstring -> void }
  (get-global):   "lua_getglobal" ffi{ ptr cstring -> i32 }
  (type):       "lua_type" ffi{ ptr i32 -> i32 }
  (tonumberx):  "lua_tonumberx" ffi{ ptr i32 isize -> f64 }
  (tointegerx): "lua_tointegerx" ffi{ ptr i32 isize -> i64 }
  (tolstring):  "lua_tolstring" ffi{ ptr i32 isize -> cstring }
  (toboolean):  "lua_toboolean" ffi{ ptr i32 -> i32 }
  (gettop):     "lua_gettop" ffi{ ptr -> i32 }
  (settop):     "lua_settop" ffi{ ptr i32 -> void }
} call
over "lua_close" ffi{ ptr -> void } bound-symbol [ ] curry
"(lua-close-fn)" swap @set!
swap drop "lua-raw" swap >module reexport

\\ An open Lua interpreter state.
lua-state: virtual{ resource } ;

\\ Open a Lua state with the standard libraries loaded. lua_close is bound as the
\\ resource's close function, so generic resource-close frees the state.
open: ( -- lua-state ) [
  (new-state)
  dup (lua-close-fn) bind-close
  dup (open-libs)
  >lua-state
] ;

\\ Close a Lua state opened with `open`. Double-close is a no-op.
close-lua: ( lua-state -- ) [ unmake-lua-state resource-close ] ;

\\ Open a Lua state for the duration of a quotation, closing it on every exit path.
using-lua: ( ..a quot: ( ..a lua: lua-state -- ..b ) -- ..b ) [ [ open ] dip over [ close-lua ] curry cleanup ] ;

\ Running code and exchanging scalars

\\ The lua_pcall/luaL_loadstring success status.
LUA_OK: 0 ;

\\ Pass a load or call status through when OK, otherwise fail.
\\
\\ The informative Lua error message and status code arrive with the ELuaError mapping.
\\ Until then a non-OK status fails loudly with a generic error.
(check-ok): ( state rc -- state ) [
  LUA_OK = [ ] [ f "lua evaluation failed" EUserThrown make-error throw ] if
] ;

\\ lua_pcall(state, nargs, nresults, 0): no message handler, no continuation.
(pcall): ( state nargs nresults -- rc ) [ 0 0 0 (pcallk) ] ;

\\ Compile src and leave the chunk on the Lua stack, failing on a syntax error.
(load): ( state src -- state ) [ over [ (load-string) ] dip swap (check-ok) ] ;

\\ Call the chunk on top of the Lua stack with no arguments, keeping nresults results.
(call-n): ( state nresults -- state ) [ over [ 0 swap (pcall) ] dip swap (check-ok) ] ;

\\ Load and run src, keeping nresults results on the Lua stack.
(eval-n): ( state src nresults -- state ) [ [ (load) ] dip (call-n) ] ;

\\ lua_pop(state, n): drop the top n values off the Lua stack.
(pop): ( state n -- ) [ -1 * 1 - (settop) ] ;

\ Read the value at Lua stack index idx as each scalar type.
(to-integer): ( state idx -- fixnum )  [ 0 (tointegerx) ] ;
(to-number):  ( state idx -- float )   [ 0 (tonumberx) ] ;
(to-lstring): ( state idx -- string )  [ 0 (tolstring) ] ;
(to-boolean): ( state idx -- boolean ) [ (toboolean) 1 = ] ;

\\ Read the value on top of the Lua stack with reader, then pop it.
(read-pop): ( state reader: ( state idx -- value ) -- value ) [
  [ dup -1 ] dip call swap 1 (pop)
] ;

\\ Run Lua source for its side effects, discarding any results.
eval: ( lua: lua-state src: string -- ) [ [ unmake-lua-state ] dip 0 (eval-n) drop ] ;

\\ Run Lua source and read its single result as a fixnum.
eval>fixnum: ( lua: lua-state src: string -- fixnum ) [ [ unmake-lua-state ] dip 1 (eval-n) [ (to-integer) ] (read-pop) ] ;

\\ Run Lua source and read its single result as a float.
eval>float: ( lua: lua-state src: string -- float ) [ [ unmake-lua-state ] dip 1 (eval-n) [ (to-number) ] (read-pop) ] ;

\\ Run Lua source and read its single result as a string.
eval>string: ( lua: lua-state src: string -- string ) [ [ unmake-lua-state ] dip 1 (eval-n) [ (to-lstring) ] (read-pop) ] ;

\\ Run Lua source and read its single result as a boolean.
eval>boolean: ( lua: lua-state src: string -- boolean ) [ [ unmake-lua-state ] dip 1 (eval-n) [ (to-boolean) ] (read-pop) ] ;

\\ Convert a 1z boolean to the Lua C boolean integer.
(to-lua-bool): ( boolean -- i32 ) [ [ 1 ] [ 0 ] if ] ;

\\ Push a 1z scalar onto the Lua stack, dispatching on its type.
(push-value): ( state value -- ) [
  dup type-name {
    { "fixnum" [ (push-integer) ] }
    { "float" [ (push-number) ] }
    { "string" [ (push-string) drop ] }
    { "boolean" [ (to-lua-bool) (push-boolean) ] }
    [ "fixnum, float, string, or boolean" throw-type-error ]
  } case
] ;

\\ Push value and assign it to the named Lua global.
(do-set-global): ( state name value -- ) [ 2 pick-n swap (push-value) (set-global) ] ;

\\ Push the named Lua global onto the stack, discarding its type tag.
(push-global): ( state name -- state ) [ over [ (get-global) drop ] dip ] ;

\\ Push the named Lua global, read it with reader, then pop it.
(with-global): ( state name reader: ( state idx -- value ) -- value ) [ [ (push-global) ] dip (read-pop) ] ;

\\ Set a Lua global from a 1z scalar value.
set-global: ( lua: lua-state name: string value -- ) [ [ unmake-lua-state ] 2dip (do-set-global) ] ;

\\ Read a Lua global as a fixnum.
get-global>fixnum: ( lua: lua-state name: string -- fixnum ) [ [ unmake-lua-state ] dip [ (to-integer) ] (with-global) ] ;

\\ Read a Lua global as a float.
get-global>float: ( lua: lua-state name: string -- float ) [ [ unmake-lua-state ] dip [ (to-number) ] (with-global) ] ;

\\ Read a Lua global as a string.
get-global>string: ( lua: lua-state name: string -- string ) [ [ unmake-lua-state ] dip [ (to-lstring) ] (with-global) ] ;

\\ Read a Lua global as a boolean.
get-global>boolean: ( lua: lua-state name: string -- boolean ) [ [ unmake-lua-state ] dip [ (to-boolean) ] (with-global) ] ;
