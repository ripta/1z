\ lib/lua.1z - Embedded Lua 5.4 via dynamic FFI over the vendored liblua5.4

use "ffi" ;
use "os/path" ;

\ Dylib resolution
\
\ liblua5.4 is vendored and installed beside the interpreter (zig-out/ext), not on
\ the system loader path. Probe a short list of candidate absolute paths and open
\ the first that exists. An installed interpreter finds the sibling ext directory
\ next to a real stdlib directory. In the dev/test tree zig-out/lib is a symlink to
\ the source lib, so the stdlib anchor resolves into the source tree; the working
\ directory candidate covers that case, matching the toy-library test convention.
\
\ Resolution runs once, at load: the path is chosen, the library opened, and the
\ close function captured here, so `open` never re-probes or re-opens per call.

\\ Shared-library extension for the host OS.
(lib-ext): ( -- str ) [ sys-info "os" @get "macos" = [ ".dylib" ] [ ".so" ] if ] ;

\\ True when the path is a string naming an existing file. A non-string (an absent
\\ candidate reported as f) is not a path.
(exists-path?): ( path-or-f -- bool ) [ dup string? [ path-exists? ] [ drop f ] if ] ;

\\ Candidate dylib path beside an installed interpreter: the ext directory that is a
\\ sibling of the standard-library directory. Yields f when the stdlib anchor cannot
\\ be resolved.
(install-lua-path): ( -- path-or-f ) [
  [ "ffi" native.resolve-load-path dirname dirname "/ext/liblua5.4" #append (lib-ext) #append ]
  [ drop f ] recover
] ;

\\ Candidate dylib path in the development tree, relative to the working directory.
\\ Yields f when PWD is unset, which is common under non-shell process launchers.
(cwd-lua-path): ( -- path-or-f ) [
  environ "PWD" f @get-or
  dup string? [ "/zig-out/ext/liblua5.4" #append (lib-ext) #append ] [ ] if
] ;

\\ Resolved dylib path. Prefers the installed sibling, then the development-tree
\\ path, then a bare name for a loader-path install.
(lua-lib-path): ( -- path ) [
  (install-lua-path) dup (exists-path?) [ ] [
    drop (cwd-lua-path) dup (exists-path?) [ ] [ drop "lua5.4" ] if
  ] if
] ;

\\ Bind the Lua C API and the lua_close function, all resolved once at load.
\\
\\ lua_pcall, lua_tonumber, lua_tointeger, lua_tostring, lua_pop, and lua_newtable
\\ are macros; the exported targets are bound here and the macros recomposed in 1z.
\\
\\ luaL_newstate raises on a null return via the errno null sentinel.
\\
\\ lua_topointer returns const void*; it is bound as isize so a table's identity
\\ lands as a plain fixnum for cycle tracking. isize rather than usize, since a
\\ high address as usize would promote to bignum.
\\
\\ (lua-close-fn) is the raw lua_close ffi-fn, folded into the reexported module so
\\ `open` can bind it to each state for generic resource-close. ffi-def only exposes
\\ callable wrappers, so the raw function is looked up separately.
\\
\\ (lua-error-hook) is the raw onez_lua_error_hook ffi-fn from the local shim in the
\\ same dylib: the ffi-callback error hook `register` binds so a callback error
\\ raises lua_error from the trampoline boundary. It is looked up unbound, since a
\\ hook is passed as a function pointer, never called through ffi-call.
(lua-lib-path) lib-open dup ffi-def{
  (new-state):    "luaL_newstate" H{ errno: null: } ffi{ -> ptr:lua-state }
  (open-libs):    "luaL_openlibs" ffi{ ptr -> void }
  (close):        "lua_close" ffi{ ptr -> void }
  (load-string):  "luaL_loadstring" ffi{ ptr cstring -> i32 }
  (pcallk):       "lua_pcallk" ffi{ ptr i32 i32 i32 isize isize -> i32 }
  (push-number):  "lua_pushnumber" ffi{ ptr f64 -> void }
  (push-integer): "lua_pushinteger" ffi{ ptr i64 -> void }
  (push-string):  "lua_pushstring" ffi{ ptr cstring -> cstring }
  (push-boolean): "lua_pushboolean" ffi{ ptr i32 -> void }
  (push-nil):     "lua_pushnil" ffi{ ptr -> void }
  (set-global):   "lua_setglobal" ffi{ ptr cstring -> void }
  (get-global):   "lua_getglobal" ffi{ ptr cstring -> i32 }
  (type):       "lua_type" ffi{ ptr i32 -> i32 }
  (tonumberx):  "lua_tonumberx" ffi{ ptr i32 out-i32 -> f64 }
  (tointegerx): "lua_tointegerx" ffi{ ptr i32 out-i32 -> i64 }
  (tolstring):  "lua_tolstring" ffi{ ptr i32 isize -> cstring }
  (toboolean):  "lua_toboolean" ffi{ ptr i32 -> i32 }
  (gettop):     "lua_gettop" ffi{ ptr -> i32 }
  (settop):     "lua_settop" ffi{ ptr i32 -> void }
  (create-table): "lua_createtable" ffi{ ptr i32 i32 -> void }
  (get-table):    "lua_gettable" ffi{ ptr i32 -> i32 }
  (set-table):    "lua_settable" ffi{ ptr i32 -> void }
  (get-i):        "lua_geti" ffi{ ptr i32 i64 -> i32 }
  (set-i):        "lua_seti" ffi{ ptr i32 i64 -> void }
  (get-field):    "lua_getfield" ffi{ ptr i32 cstring -> i32 }
  (set-field):    "lua_setfield" ffi{ ptr i32 cstring -> void }
  (next):        "lua_next" ffi{ ptr i32 -> i32 }
  (raw-len):     "lua_rawlen" ffi{ ptr i32 -> usize }
  (is-integer):  "lua_isinteger" ffi{ ptr i32 -> i32 }
  (to-pointer):  "lua_topointer" ffi{ ptr i32 -> isize }
  (check-stack): "lua_checkstack" ffi{ ptr i32 -> i32 }
  (push-closure): "lua_pushcclosure" ffi{ ptr ptr:ffi-callback i32 -> void }
} call
over "lua_close" ffi{ ptr -> void } bound-symbol [ ] curry
"(lua-close-fn)" swap @set!
over "onez_lua_error_hook" lib-symbol [ ] curry
"(lua-error-hook)" swap @set!
swap drop "lua-raw" swap >module reexport

\\ An open Lua interpreter state: the raw state resource plus the callback
\\ resources registered into it, which the state owns and frees on close.
\\
\\ The fields are untyped: a ptr:lua-state resource reports its FFI pointer
\\ name, not resource, as its type, and typed and untyped fields cannot mix.
lua-state-inner: struct{ state callbacks } ;
lua-state: virtual{ lua-state-inner } ;

\\ The raw state resource backing lua.
(raw-state): ( lua -- state ) [ unmake-lua-state state>> ] ;

\\ Open a Lua state with the standard libraries loaded. lua_close is bound as the
\\ resource's close function, so generic resource-close frees the state.
open: ( -- lua-state ) [
  (new-state)
  dup (lua-close-fn) bind-close
  dup (open-libs)
  V{ } make-lua-state-inner >lua-state
] ;

\\ Close a Lua state opened with `open`. The state closes first and its
\\ registered callbacks free after, so no live Lua reference can reach a freed
\\ callback. Double-close is a no-op.
close-lua: ( lua-state -- ) [
  unmake-lua-state
  dup state>> resource-close
  callbacks>> [ resource-close ] #each
] ;

\\ Open a Lua state for the duration of a quotation, closing it on every exit path.
using-lua: ( ..a quot: ( ..a lua: lua-state -- ..b ) -- ..b ) [ [ open ] dip over [ close-lua ] curry cleanup ] ;

\ Running code and exchanging scalars

\\ The lua_pcall/luaL_loadstring success status.
LUA_OK: 0 ;

\\ The lua_type tag for nil.
LUA_TNIL: 0 ;

\\ The lua_type tag for tables.
LUA_TTABLE: 5 ;

\\ The 1z error type raised for a Lua load or runtime failure, mirroring
\\ ESqliteError: the numeric status code is the error data, the Lua message the
\\ error message.
ELuaError: [ lua-error: ] ;

\\ Read the Lua error object at the top of the stack as a string, pop it, and
\\ throw ELuaError carrying the status code and message. On a non-OK status Lua
\\ leaves its error object on top of the stack.
\\
\\ The raw (tolstring) and (settop) bindings are called directly, since the
\\ (to-lstring) and (pop) helpers are defined later in the file. -1 0 (tolstring)
\\ reads index -1 with a NULL length pointer; -2 (settop) is lua_pop(state, 1).
(raise-lua-error): never-returns ( state rc -- * ) [
  over -1 0 (tolstring) <rot- -2 (settop) ELuaError make-error throw
] ;

\\ Pass a load or call status through when OK, otherwise raise an error,
\\ reconciling a pending callback error against the status first.
\\
\\ A callback error the hook raised into Lua is exempt from the automatic
\\ ffi-call re-raise, so it is still pending here. A non-OK status means the
\\ abort reached this pcall: pop Lua's error object and re-raise the original
\\ 1z error. An OK status means a script-side pcall caught it: drop the stale
\\ error and continue. A non-OK status with no pending callback error is a
\\ genuine Lua error and raises ELuaError as before.
(check-ok): ( state rc -- state ) [
  take-callback-error
  over LUA_OK = [ 2drop ] [
    dup [ nip over -2 (settop) nip throw ] [ drop (raise-lua-error) ] if
  ] if
] ;

\\ lua_pcall(state, nargs, nresults, 0): no message handler, no continuation.
(pcall): ( state nargs nresults -- rc ) [ 0 0 0 (pcallk) ] ;

\\ Compile src and leave the chunk on the Lua stack, failing on a syntax error.
(load): ( state src -- state ) [ over [ (load-string) ] dip swap (check-ok) ] ;

\\ Call the chunk on top of the Lua stack with no arguments, keeping nresults results.
(call-n): ( state nresults -- state ) [ over [ 0 swap (pcall) ] dip swap (check-ok) ] ;

\\ Load and run src, keeping nresults results on the Lua stack.
(eval-n): ( state src nresults -- state ) [ [ (load) ] dip (call-n) ] ;

\\ lua_pop(state, n): drop the top n values off the Lua stack.
(pop): ( state n -- ) [ -1 * 1 - (settop) ] ;

\ Read the value at Lua stack index idx as each scalar type, raising ELuaError
\ when Lua cannot convert the value.
\
\ The number readers check the isnum out-parameter, which the out-i32 binding
\ pushes below the converted result.
\
\ The string reader admits only the number and string type tags, exactly what
\ lua_tolstring converts; its NULL return for other types would otherwise
\ marshal to an ambiguous "".
\
\ lua_toboolean is total (Lua truthiness), so the boolean reader never raises.
(to-integer): ( state idx -- fixnum ) [
  (tointegerx) swap 1 = [ ] [
    drop f "Lua value is not convertible to a fixnum" ELuaError make-error throw
  ] if
] ;
(to-number): ( state idx -- float ) [
  (tonumberx) swap 1 = [ ] [
    drop f "Lua value is not convertible to a float" ELuaError make-error throw
  ] if
] ;
(to-lstring): ( state idx -- string ) [
  2dup (type) {
    { 3 [ 0 (tolstring) ] }
    { 4 [ 0 (tolstring) ] }
    [ [ 2drop ] dip "Lua value is not convertible to a string" ELuaError make-error throw ]
  } case
] ;
(to-boolean): ( state idx -- boolean ) [ (toboolean) 1 = ] ;

\\ Read the value on top of the Lua stack with reader, then pop it.
(read-pop): ( state reader: ( state idx -- value ) -- value ) [
  [ dup -1 ] dip call swap 1 (pop)
] ;

\\ Run quot, and if it raises, restore the Lua stack top captured on entry
\\ before rethrowing. This keeps an error thrown mid-word, after values are
\\ already pushed, from leaking Lua stack slots on a long-lived state.
(lua-guard): ( ..a state quot: ( ..a -- ..b ) -- ..b ) [
  swap dup (gettop)
  [ (settop) throw ] curry curry
  recover
] ;

\\ Run Lua source and return its first result: option:some of the natural 1z
\\ scalar, or option:none when the chunk returns nothing or nil, which are
\\ indistinguishable in Lua. Extra results are discarded. A table, function,
\\ or userdata result raises ELuaError.
eval: ( lua: lua-state src: string -- opt ) [
  [ (raw-state) ] dip
  over [
    1 (eval-n)
    dup -1 (type) LUA_TNIL = [
      1 (pop) option:none
    ] [
      [ (to-value) ] (read-pop) >option:some
    ] if
  ] (lua-guard)
] ;

\\ Run Lua source and read its single result as a fixnum, through Lua's number
\\ coercion; raises ELuaError on a non-convertible result.
eval>fixnum: ( lua: lua-state src: string -- fixnum ) [
  [ (raw-state) ] dip over [ 1 (eval-n) [ (to-integer) ] (read-pop) ] (lua-guard)
] ;

\\ Run Lua source and read its single result as a float, through Lua's number
\\ coercion; raises ELuaError on a non-convertible result.
eval>float: ( lua: lua-state src: string -- float ) [
  [ (raw-state) ] dip over [ 1 (eval-n) [ (to-number) ] (read-pop) ] (lua-guard)
] ;

\\ Run Lua source and read its single result as a string, through Lua's string
\\ coercion of numbers; raises ELuaError on a non-convertible result.
eval>string: ( lua: lua-state src: string -- string ) [
  [ (raw-state) ] dip over [ 1 (eval-n) [ (to-lstring) ] (read-pop) ] (lua-guard)
] ;

\\ Run Lua source and read its single result as a boolean, via Lua truthiness.
eval>boolean: ( lua: lua-state src: string -- boolean ) [ [ (raw-state) ] dip 1 (eval-n) [ (to-boolean) ] (read-pop) ] ;

\\ Convert a 1z boolean to the Lua C boolean integer.
(to-lua-bool): ( boolean -- i32 ) [ [ 1 ] [ 0 ] if ] ;

\\ Ensure headroom on the Lua C stack before a table descent. Lua guarantees
\\ only LUA_MINSTACK free slots; pushing past that unchecked is undefined
\\ behavior, so every recursion level reserves its few slots here first.
(check-lua-stack): ( state -- ) [
  4 (check-stack) 0 = [
    f "cannot grow the Lua stack" ELuaError make-error throw
  ] when
] ;

\\ Push hash as a fresh Lua table: each entry's value goes through
\\ (push-value), so nested hashes and arrays build nested tables. @keys yields
\\ symbols, so keys are coerced back through >string before lua_setfield.
(push-hash): ( state hash -- ) [
  over (check-lua-stack)
  over 0 0 (create-table)
  dup @keys
  swap [ <rot- >string 2dup @get 3 pick-n swap (push-value) nip -2 swap (set-field) ] curry
  <rot- swap curry #each
] ;

\\ Push array as a fresh Lua table sequence: element i lands at Lua key i+1,
\\ each element pushed through (push-value).
(push-array): ( state array -- ) [
  over (check-lua-stack)
  over 0 0 (create-table)
  swap [ <rot- over swap (push-value) swap 1 + -2 swap (set-i) ] curry #each-index
] ;

\\ Push a 1z value onto the Lua stack, dispatching on its type: scalars push
\\ directly; a hash or array builds a Lua table recursively.
(push-value): ( state value -- ) [
  dup type-name {
    { "fixnum" [ (push-integer) ] }
    { "float" [ (push-number) ] }
    { "string" [ (push-string) drop ] }
    { "boolean" [ (to-lua-bool) (push-boolean) ] }
    { "hash" [ (push-hash) ] }
    { "array" [ (push-array) ] }
    [ "fixnum, float, string, boolean, hash, or array" throw-type-error ]
  } case
] ;

\\ Push value and assign it to the named Lua global.
(do-set-global): ( state name value -- ) [ 2 pick-n swap (push-value) (set-global) ] ;

\\ Push the named Lua global onto the stack, discarding its type tag.
(push-global): ( state name -- state ) [ over [ (get-global) drop ] dip ] ;

\\ Push the named Lua global, read it with reader, then pop it.
(with-global): ( state name reader: ( state idx -- value ) -- value ) [ [ (push-global) ] dip (read-pop) ] ;

\\ Set a Lua global from a 1z value: a scalar pushes directly; a hash or array
\\ builds a Lua table recursively.
set-global: ( lua: lua-state name: string value -- ) [ [ (raw-state) ] 2dip (do-set-global) ] ;

\\ Read a Lua global as a fixnum, through Lua's number coercion; raises
\\ ELuaError on a non-convertible global.
get-global>fixnum: ( lua: lua-state name: string -- fixnum ) [
  [ (raw-state) ] dip over [ [ (to-integer) ] (with-global) ] (lua-guard)
] ;

\\ Read a Lua global as a float, through Lua's number coercion; raises
\\ ELuaError on a non-convertible global.
get-global>float: ( lua: lua-state name: string -- float ) [
  [ (raw-state) ] dip over [ [ (to-number) ] (with-global) ] (lua-guard)
] ;

\\ Read a Lua global as a string, through Lua's string coercion of numbers;
\\ raises ELuaError on a non-convertible global.
get-global>string: ( lua: lua-state name: string -- string ) [
  [ (raw-state) ] dip over [ [ (to-lstring) ] (with-global) ] (lua-guard)
] ;

\\ Read a Lua global as a boolean, via Lua truthiness.
get-global>boolean: ( lua: lua-state name: string -- boolean ) [ [ (raw-state) ] dip [ (to-boolean) ] (with-global) ] ;

\\ Read a Lua global as its natural 1z scalar type: boolean, fixnum for an
\\ integer number, float for any other number, or string. A table global
\\ raises; read it with get-global-hash or get-global-array instead.
get-global: ( lua: lua-state name: string -- value ) [
  [ (raw-state) ] dip
  over [
    2dup (get-global) LUA_TTABLE = [
      over 1 (pop) nip
      dup "global " swap #append " is a table; use get-global-hash or get-global-array" #append
      ELuaError make-error throw
    ] [
      drop [ (to-value) ] (read-pop)
    ] if
  ] (lua-guard)
] ;

\\ Register quot as a Lua-callable global function under name. The quotation
\\ receives the raw lua_State resource, reads its scalar arguments off the Lua
\\ stack with the scalar readers at indices 1..n, pushes its scalar results,
\\ and returns the result count.
\\
\\ The state owns the callback and frees it on close, so no handle is
\\ returned. Registering an existing name replaces the Lua global; the old
\\ callback stays owned until the state closes. The callback is tracked before
\\ it touches Lua, so a failure during install still frees it on close.
\\
\\ The quotation must not yield the green thread from inside the live Lua C
\\ frame; that is out of scope for the scalar tier.
\\
\\ A quotation that throws aborts the enclosing Lua pcall: the error hook raises
\\ lua_error with the 1z error message from the trampoline boundary. When the
\\ abort reaches the driving pcall, the original 1z error is re-raised with its
\\ error-type intact; a script-side pcall that catches it sees Lua's usual
\\ false-plus-message and the script continues.
register: ( lua: lua-state name: string quot: ( state -- nresults ) -- ) [
  ffi{ ptr:lua-state -> i32 } (lua-error-hook) f ffi-callback-with-error-hook
  [ unmake-lua-state ] 2dip
  2 pick-n callbacks>> over #push! drop
  [ state>> ] 2dip
  2 pick-n [ 2 pick-n swap 0 (push-closure) (set-global) ] (lua-guard)
] ;

\ Raw table access
\
\ Tables are reached through named Lua globals. Each word looks the global up,
\ works on it with the Lua stack balanced, and pops what it pushed. Keys are
\ strings for fields or fixnums for indices; values are the scalar set that
\ (push-value) and (to-value) cover. A nested table stays reachable by aliasing
\ it to a global with eval.

\\ Read the Lua value at idx as its natural 1z scalar: boolean, fixnum for an
\\ integer number, float for any other number, or string. Any other Lua type
\\ raises ELuaError carrying the type tag.
\\
\\ Number keys during lua_next traversal must be read here, never via
\\ (to-lstring): lua_tolstring converts a number in place and corrupts the
\\ traversal.
(to-value): ( state idx -- value ) [
  2dup (type) {
    { 1 [ (to-boolean) ] }
    { 3 [ 2dup (is-integer) 1 = [ (to-integer) ] [ (to-number) ] if ] }
    { 4 [ (to-lstring) ] }
    [ [ 2drop ] dip "expected a boolean, number, or string Lua value" ELuaError make-error throw ]
  } case
] ;

\\ Push the global named name onto the Lua stack, requiring it to be a table.
\\ Any other type, including an undefined global, is popped back off and raises
\\ ELuaError naming the global. The check also keeps a non-table from reaching
\\ the table C calls, whose failure mode is an unprotected Lua panic.
(push-table): ( state name -- state ) [
  2dup (get-global) LUA_TTABLE = [ drop ] [
    over 1 (pop) nip
    dup "global " swap #append " is not a table" #append
    ELuaError make-error throw
  ] if
] ;

\\ Push the value at key from the table on top of the Lua stack, returning the
\\ pushed value's type tag. A string key routes to lua_getfield, a fixnum key
\\ to lua_geti.
(get-key): ( state key -- state tag ) [
  over swap dup type-name {
    { "string" [ -1 swap (get-field) ] }
    { "fixnum" [ -1 swap (get-i) ] }
    [ drop "string or fixnum" throw-type-error ]
  } case
] ;

\\ Store the value on top of the Lua stack at key in the table just below it,
\\ popping the value. A string key routes to lua_setfield, a fixnum key to
\\ lua_seti.
(set-key): ( state key -- ) [
  dup type-name {
    { "string" [ -2 swap (set-field) ] }
    { "fixnum" [ -2 swap (set-i) ] }
    [ drop "string or fixnum" throw-type-error ]
  } case
] ;

\\ Look key up in the table global named name: option:some of the converted
\\ scalar, or option:none for a nil entry. Missing and explicitly-nil entries
\\ are indistinguishable in Lua.
(table-lookup): ( state name key -- opt ) [
  [ (push-table) ] dip (get-key)
  LUA_TNIL = [
    2 (pop) option:none
  ] [
    dup -1 (to-value) swap 2 (pop) >option:some
  ] if
] ;

\\ One lua_next step per call: with the table at absolute index tidx and the
\\ previous key on top of the Lua stack, visit the next entry with quot and
\\ recurse; once the table is exhausted, pop it.
(each-loop): ( state quot tidx -- ) [
  2 pick-n over (next) 0 = [
    2drop 1 (pop)
  ] [
    2 pick-n -2 (to-value)
    3 pick-n -1 (to-value)
    3 pick-n call
    2 pick-n 1 (pop)
    (each-loop)
  ] if
] ;

\\ Create a fresh empty table and bind it to the named Lua global.
new-table: ( lua: lua-state name: string -- ) [
  [ (raw-state) ] dip over 0 0 (create-table) (set-global)
] ;

\\ Set key in the table global named name: a scalar value stores directly; a
\\ hash or array value builds a nested Lua table.
table-set: ( lua: lua-state name: string key value -- ) [
  [ [ (raw-state) ] dip ] 2dip
  3 pick-n [
    [ (push-table) ] 2dip
    2 pick-n swap (push-value)
    over swap (set-key)
    1 (pop)
  ] (lua-guard)
] ;

\\ Read key from the table global named name as its natural 1z scalar type.
\\ A nil entry, which is also how a missing key reads, raises ELuaError; use
\\ table-get-or for a default instead.
table-get: ( lua: lua-state name: string key -- value ) [
  [ (raw-state) ] 2dip
  dup [ 2 pick-n [ (table-lookup) ] (lua-guard) ] dip
  swap dup option:none? [
    drop dup >string [ "key not found: " ] dip #append
    ELuaError make-error throw
  ] [
    nip option:some>
  ] if
] ;

\\ Read key from the table global named name, returning default for a nil
\\ entry.
table-get-or: ( lua: lua-state name: string key default -- value ) [
  [ [ (raw-state) ] 2dip 2 pick-n [ (table-lookup) ] (lua-guard) ] dip
  swap dup option:none? [ drop ] [ nip option:some> ] if
] ;

\\ Raw sequence length of the table global named name via lua_rawlen: the
\\ count of consecutive integer keys from 1, ignoring any __len metamethod.
table-len: ( lua: lua-state name: string -- fixnum ) [
  [ (raw-state) ] dip (push-table)
  dup -1 (raw-len) swap 1 (pop)
] ;

\\ Call quot with each key/value entry of the table global named name, both
\\ converted to 1z scalars. Iteration order is unspecified, per Lua semantics.
table-each: ( lua: lua-state name: string quot: ( key value -- ) -- ) [
  [ [ (raw-state) ] dip ] dip
  2 pick-n [
    [ (push-table) ] dip
    over (gettop)
    2 pick-n (push-nil)
    (each-loop)
  ] (lua-guard)
] ;

\ Table marshalling
\
\ Whole-table conversion from Lua tables to 1z values: an eager immutable
\ snapshot, never a live view. The walk auto-detects nested shapes: a nested
\ table that is a Lua sequence becomes a 0-based array, any other nested table
\ a hash; the caller-directed shape demand applies only to the top-level
\ table. Cycles are refused by tracking the ancestor path of lua_topointer
\ identities; shared non-cyclic subtables convert normally.

\\ One lua_next step of the sequence check: count entries whose key is an
\\ integer in 1..n; any other key ends the check early. True iff the table
\\ holds exactly n such entries, which means the keys are exactly 1..n.
(seq-loop): ( state tidx n count -- bool ) [
  3 pick-n 3 pick-n (next) 0 = [
    = [ 2drop ] dip
  ] [
    3 pick-n -2 (is-integer) 1 = [
      3 pick-n -2 (to-integer)
      dup 3 pick-n <= over 1 >= and [
        drop 1 +
        3 pick-n 1 (pop)
        (seq-loop)
      ] [
        drop 3 pick-n 2 (pop)
        2drop 2drop f
      ] if
    ] [
      3 pick-n 2 (pop)
      2drop 2drop f
    ] if
  ] if
] ;

\\ True when the table at absolute Lua stack index tidx is a Lua sequence:
\\ lua_rawlen gives n, and the table holds exactly n entries with integer keys
\\ in 1..n. An empty table passes with n = 0.
(sequence?): ( state tidx -- bool ) [
  2dup (raw-len)
  2 pick-n (push-nil)
  0 (seq-loop)
] ;

\\ The lua_next key at Lua stack index -2 as a 1z hash key: a string key is
\\ taken verbatim; an integer key is stringified, as is a non-integral float
\\ key (Lua normalizes an integral float key to an integer key). Any other
\\ key type raises.
\\
\\ Number keys go through the numeric readers, never lua_tolstring, which
\\ would convert the key in place and corrupt the traversal.
(key-string): ( state -- str ) [
  dup -2 (type) {
    { 3 [ dup -2 (is-integer) 1 = [ -2 (to-integer) ] [ -2 (to-number) ] if >string ] }
    { 4 [ -2 (to-lstring) ] }
    [ [ drop ] dip "unsupported Lua table key type for a hash" ELuaError make-error throw ]
  } case
] ;

\\ One lua_next step of the hash walk: stringify the key, refuse a
\\ stringification collision, convert the value, and store it in the staging
\\ map m.
(hash-loop): ( state tidx path m -- hash ) [
  3 pick-n 3 pick-n (next) 0 = [
    >hash [ drop 2drop ] dip
  ] [
    3 pick-n (key-string)
    2dup @has? [
      dup "Lua keys collide after stringification: " swap #append
      ELuaError make-error throw
    ] when
    4 pick-n dup (gettop) 4 pick-n (table-to-value)
    @set!
    3 pick-n 1 (pop)
    (hash-loop)
  ] if
] ;

\\ Convert the table at absolute Lua stack index tidx to a hash, walking its
\\ entries with lua_next into a staging mutable map.
(table-to-hash): stack-recursive ( state tidx path -- hash ) [
  M{ }
  3 pick-n (push-nil)
  (hash-loop)
] ;

\\ One step of the array walk: read t[i], convert it, and push it onto the
\\ staging vector v.
(array-loop): ( state tidx path n v i -- array ) [
  2 pick-n over < [
    drop nip >array [ drop 2drop ] dip
  ] [
    5 pick-n 5 pick-n 2 pick-n (get-i) drop
    5 pick-n dup (gettop) 5 pick-n (table-to-value)
    swap [ #push! ] dip
    5 pick-n 1 (pop)
    1 + (array-loop)
  ] if
] ;

\\ Convert the sequence at absolute Lua stack index tidx to a 0-based array,
\\ reading keys 1..n in order. Callers must have verified (sequence?) first.
(table-to-array): stack-recursive ( state tidx path -- array ) [
  2 pick-n 2 pick-n (raw-len)
  V{ }
  1 (array-loop)
] ;

\\ Enter the table at absolute Lua stack index idx: reserve C-stack headroom,
\\ refuse a table already on its own ancestor path, then convert as an array
\\ when it is a sequence and as a hash otherwise.
(table-descend): ( state idx path -- value ) [
  2 pick-n (check-lua-stack)
  2 pick-n 2 pick-n (to-pointer)
  2dup #in? [
    f "cannot marshal a cyclic Lua table" ELuaError make-error throw
  ] when
  #push
  2 pick-n 2 pick-n (sequence?)
  [ (table-to-array) ] [ (table-to-hash) ] if
] ;

\\ Convert the Lua value at absolute Lua stack index idx to a 1z value: a
\\ scalar through (to-value), a table through the marshalling walk with path
\\ carrying the ancestor table identities.
(table-to-value): stack-recursive ( state idx path -- value ) [
  2 pick-n 2 pick-n (type) LUA_TTABLE = [
    (table-descend)
  ] [
    drop (to-value)
  ] if
] ;

\\ Push the table global named name and hand it to builder at its absolute
\\ index, with the ancestor path seeded with the table's own identity; pop the
\\ table and return builder's value. The Lua stack is restored on any error.
(read-table): ( lua name builder: ( state tidx path -- value ) -- value ) [
  [ [ (raw-state) ] dip ] dip
  2 pick-n [
    [ (push-table) ] dip
    over dup (gettop)
    2dup (to-pointer) 1array
    3 pick-n call
    nip
    swap 1 (pop)
  ] (lua-guard)
] ;

\\ Read the table global named name as a hash: string keys verbatim, number
\\ keys stringified, values converted recursively with nested auto-detection.
\\ Raises ELuaError when the global is not a table, on an unsupported or
\\ colliding key, and on a cyclic table.
get-global-hash: ( lua: lua-state name: string -- hash ) [
  [ (table-to-hash) ] (read-table)
] ;

\\ Read the table global named name as a 0-based array, demanding the table
\\ be a Lua sequence (keys exactly 1..n); values convert recursively with
\\ nested auto-detection. Raises ELuaError when the global is not a table or
\\ not a sequence, and on a cyclic table.
get-global-array: ( lua: lua-state name: string -- array ) [
  [
    2 pick-n 2 pick-n (sequence?) [ ] [
      f "global is not a Lua sequence" ELuaError make-error throw
    ] if
    (table-to-array)
  ] (read-table)
] ;
