\ lib/lint.1z - Lint engine for 1z source code
\
\ Provides rule registration, per-file token-level and semantic
\ analysis, diagnostic collection, and output formatting.
\
\ Usage:
\   use "lint" ;
\   "my-rule" warning: [ check-quot ] f make-lint-rule register-lint-rule
\   command-line-args run-lint

use "scanner" ;
use "lexer" ;
use "1z-tokens" ;
use "os/fs" ;
use "os/path" ;
use "ranges" ;

\ --- Struct definitions ---

\\ A lint rule: id (string), severity (symbol), check (quotation), fix (reserved).
\\ The check quotation has signature:
\\   ( path source tokens line-index semantic-context -- diagnostics )
\\ where semantic-context is a semantic-context struct or f if loading failed.
\\ It returns an array of lint-diagnostic structs (possibly empty).
lint-rule: struct{ id severity check fix } ;

\\ A lint diagnostic produced by a rule check.
lint-diagnostic: struct{ rule-id severity file line column message } ;

\\ Semantic context: module loaded in check mode plus a hash of word-info structs.
semantic-context: struct{ module word-infos } ;

\ --- Rule registry (module-scoped mutable storage) ---

(lint-registry-storage): ( -- mmap ) parse-time [ [ rules: { } ] make-mutable-map ] ;
(lint-registry): ( -- mmap ) [ (lint-registry-storage) ] ;

\ --- Run-scoped state shared by rules that need the full checked file set ---

(lint-run-storage): ( -- mmap ) parse-time [
  [
    checked-files: { } dead-definitions: f circular-files: { }
    semantic-context-error: f corpus-index: f
  ]
  make-mutable-map
] ;
(lint-run-state): ( -- mmap ) [ (lint-run-storage) ] ;

lint-checked-files: ( -- array ) [ (lint-run-state) checked-files: @get ] ;
set-lint-checked-files: ( files -- ) [ (lint-run-state) swap checked-files: swap @set! drop ] ;

lint-dead-definitions: ( -- array/f ) [ (lint-run-state) dead-definitions: @get ] ;
set-lint-dead-definitions: ( dead-defs -- ) [ (lint-run-state) swap dead-definitions: swap @set! drop ] ;

lint-circular-files: ( -- array ) [ (lint-run-state) circular-files: @get ] ;
set-lint-circular-files: ( circular -- ) [ (lint-run-state) swap circular-files: swap @set! drop ] ;

\ Canonical path of every checked file, mapped to the spelling the caller passed, or f before
\ (build-dep-graph) has run.
(lint-corpus-index): ( -- mmap/f ) [ (lint-run-state) corpus-index: @get ] ;
(set-lint-corpus-index): ( index -- ) [ (lint-run-state) swap corpus-index: swap @set! drop ] ;

\\ The error raised by the most recent (build-semantic-context) attempt for
\\ the file currently being linted, or f if it succeeded or was skipped.
lint-semantic-context-error: ( -- error/f ) [ (lint-run-state) semantic-context-error: @get ] ;
set-lint-semantic-context-error: ( error -- ) [
  (lint-run-state) swap semantic-context-error: swap @set! drop
] ;

\\ Return the array of registered lint rules.
lint-rules: ( -- array ) [ (lint-registry) rules: @get ] ;

\\ Register a lint rule for use by run-lint.
register-lint-rule: ( lint-rule -- ) [
  \ stack: rule
  (lint-registry) dup rules: @get
  \ stack: rule registry old-rules
  <rot- 1array #append
  \ stack: registry new-rules
  rules: swap @set! drop
] ;

\ --- Line index computation ---

(lf-string): ( -- str ) [ 10 >char ] ;

\\ Build an array of newline character positions from a source string.
\\ Used to convert character offsets to line:column.
(build-line-index): ( source -- array ) [
  dup #len 0 = [ drop V{ } ] [
    V{ }
    over #len 0 swap 1 - <range> >iterator [
      2 pick-n over #nth (lf-string) = [
        over swap #push!
      ] when
      drop
    ] #each
    nip
  ] if
] ;

\\ Convert a 0-based character offset to 1-based line and column numbers.
\\ line-index is the array of newline positions from (build-line-index).
(pos>line-col): ( line-index pos -- line column ) [
  \ Filter to newlines that occur strictly before pos.
  swap over [ < ] curry #filter #collect
  \ stack: pos newlines-before
  dup #len ++ swap
  \ stack: pos line newlines-before
  dup #len 0 = [
    \ No newlines before pos: column = pos + 1
    \ stack: pos line { }
    drop swap ++
  ] [
    \ Column = pos - last-newline-pos
    \ stack: pos line newlines-before
    #last [ swap ] dip -
  ] if
] ;

\ --- Diagnostic construction helper ---

\\ Create a lint-diagnostic from rule metadata and a token position.
\\ Converts pos to line:column using the line-index, then constructs
\\ the lint-diagnostic struct.
(make-diag): ( rule-id severity path line-index pos message -- lint-diagnostic ) [
  \ Save message, compute line:col from line-index and pos
  [ (pos>line-col) ] dip
  \ stack: rule-id severity path line column message
  make-lint-diagnostic
] ;

\\ Public helper: create a diagnostic anchored at a character offset.
diag-at-pos: ( rule-id severity path line-index pos message -- lint-diagnostic ) [
  (make-diag)
] ;

\\ Public helper: create a diagnostic anchored at a token's position.
diag-at-token: ( rule-id severity path line-index token message -- lint-diagnostic ) [
  [ pos>> ] dip
  diag-at-pos
] ;

\\ Predicate: token has the given kind.
token-kind?: ( token kind -- ? ) [
  swap kind>> =
] ;

\\ Predicate: token is significant for token-level scans.
\\ Whitespace and newline tokens are not significant.
significant-token?: ( token -- ? ) [
  kind>> dup whitespace: = swap newline: = or not
] ;

\\ Predicate: token is a definition symbol token.
definition-symbol?: ( token -- ? ) [
  symbol: token-kind?
] ;

\ --- File reading ---

(read-file): ( path -- contents ) [
  read: stream-open dup stream-read-all swap stream-close bytes>
] ;

\ --- Pragma suppression parsing ---

\ A file opts out of rules with pragma{ lint-suppress: { non-kebab-case: dead-definition: } }.
\
\ The key may sit anywhere among a pragma block's keys, and every entry in the file counts.
\
\ The suppression list is the entries' rule-id symbol tokens, kept as tokens so a diagnostic about
\ an unknown id can point at it.

\ Check if a token matches kind and value.
(tok-match?): ( token kind value -- bool ) [
  \ stack: token kind value
  swap 2 pick-n kind>> =
  \ stack: token value kind-match?
  [ swap value>> = ] dip and
] ;

\ Whether index i is inside sig-tokens and the token there matches kind and value.
(tok-at?): ( sig-tokens i kind value -- bool ) [
  2over swap #len < [
    [ #nth ] 2dip (tok-match?)
  ] [
    2drop 2drop f
  ] if
] ;

\ Collect the symbol tokens from index i up to the close-brace ending a lint-suppress array, and
\ return them with the index just past that close-brace.
(collect-rule-symbols): ( sig-tokens i -- symbols next ) [
  { } swap
  \ stack: sig-tokens symbols i
  [
    2 pick-n #len over > [
      2 pick-n over #nth
      dup close-brace: token-kind? [
        drop ++ f
      ] [
        dup symbol: token-kind? [
          1array swap [ #append ] dip
        ] [
          drop
        ] if
        ++ t
      ] if
    ] [ f ] if
  ] loop
  <rot- drop
] ;

\ Add the rule symbols of the lint-suppress entry whose key is at index i to suppressions, and
\ return the index just past the entry's array.
(take-suppress-entry): ( sig-tokens suppressions i depth -- sig-tokens suppressions' next depth ) [
  [
    2 + 2 pick-n swap (collect-rule-symbols)
    \ stack: sig-tokens suppressions symbols next
    [ over f = [ nip ] [ #append ] if ] dip
  ] dip
] ;

\ Add the rule symbols of every lint-suppress entry in one pragma block to suppressions, which is f
\ until the first entry is found. The block's contents start at index i.
\
\ Only the block's own keys sit at depth 1, so counting brace depth keeps a symbol inside another
\ key's value from being read as the key.
(scan-pragma-block): ( sig-tokens i suppressions -- suppressions' ) [
  swap 1
  \ stack: sig-tokens suppressions i depth
  [
    over 4 pick-n #len < over 0 > and [
      dup 1 = [
        3 pick-n 2 pick-n symbol: "lint-suppress:" (tok-at?) [
          3 pick-n 2 pick-n ++ open-brace: "{" (tok-at?)
        ] [ f ] if
      ] [ f ] if
      [
        (take-suppress-entry)
      ] [
        3 pick-n 2 pick-n #nth kind>>
        dup open-brace: = [
          drop ++
        ] [
          close-brace: = [ 1 - ] [ ] if
        ] if
        [ ++ ] dip
      ] if
      t
    ] [ f ] if
  ] loop
  2drop nip
] ;

\ The suppression list for a significant-token array, or f when the file has no lint-suppress entry.
(collect-suppressions): ( sig-tokens -- suppressions-or-f ) [
  f 0
  \ stack: sig-tokens suppressions i
  [
    2 pick-n #len over > [
      2 pick-n over open-brace: "pragma{" (tok-at?) [
        2 pick-n over ++ 3 pick-n (scan-pragma-block)
        swap [ nip ] dip
      ] [ ] if
      ++ t
    ] [ f ] if
  ] loop
  drop nip
] ;

\ The suppression list for a file's full token array, or f when it has no lint-suppress entry.
(parse-suppressions): ( tokens -- suppressions-or-f ) [
  [ significant-token? ] #filter #collect (collect-suppressions)
] ;

\ The rule id a suppression token names, which is the symbol without its colon.
(suppression-rule-id): ( token -- string ) [
  value>> dup #len 1 - #take
] ;

\\ Check whether a rule ID is in the suppression list.
(suppressed?): ( rule-id suppressions -- bool ) [
  dup f = [
    2drop f
  ] [
    swap [ swap (suppression-rule-id) = ] curry #any
  ] if
] ;

\ Report a suppression token whose rule id names none of the rules being run. A misspelled id would
\ otherwise suppress nothing and say nothing.
(unknown-suppression-diagnostic): ( token ctx -- diagnostic ) [
  "unknown-suppressed-rule" warning:
  2 pick-n 0 #nth
  3 pick-n 4 #nth
  5 pick-n
  dup (suppression-rule-id) "lint-suppress names no lint rule: " swap #append
  diag-at-token
  2nip
] ;

\ The unknown-suppressed-rule diagnostics for one file's lint context.
(unknown-suppression-diagnostics): ( rules ctx -- diagnostics ) [
  dup 3 #nth dup f = [
    3drop { }
  ] [
    <rot- [ id>> ] #map #collect
    \ stack: ctx suppressions rule-ids
    [ swap (suppression-rule-id) #in? not ] curry #filter #collect
    swap [ (unknown-suppression-diagnostic) ] curry #map #collect
  ] if
] ;

\ --- Semantic analysis ---

(lint-load-cache-storage): ( -- mmap ) parse-time [ M{ } ] ;
(lint-load-cache): ( -- mmap ) [ (lint-load-cache-storage) ] ;

\\ Build a semantic context by loading a file in check mode.
\\ Returns a semantic-context struct, or f if loading fails. On failure the
\\ error is stashed via set-lint-semantic-context-error so (lint-file) can
\\ report it instead of letting semantic rules silently see no words.
(build-semantic-context): ( path -- semantic-context-or-f ) [
  [ (lint-load-cache) swap native.load-check-file ] [ set-lint-semantic-context-error f ] recover
  dup f = [ ] [
    dup @keys
    H{ }
    swap [
      \ stack: module hash word-name-symbol
      >string
      2 pick-n over >symbol native.>word (raw>word-info)
      \ stack: module hash word-name-string word-info
      \ @set ( assoc key value -- assoc' ): hash is already in position
      @set
      \ stack: module hash'
    ] #each
    \ stack: module word-infos-hash
    make-semantic-context
  ] if
] ;

\\ Look up a word-info by name from a semantic context. Returns word-info or f.
semantic-word-info: ( semantic-context name -- word-info-or-f ) [
  swap dup f = [ nip ] [
    word-infos>> swap
    \ stack: hash name
    2dup @has? [
      @get
    ] [ 2drop f ] if
  ] if
] ;

\\ Get all word names from a semantic context. Returns array or empty array.
semantic-word-names: ( semantic-context -- array ) [
  dup f = [ drop { } ] [ word-infos>> @keys ] if
] ;

\ Load a module in check mode via the lint cache, or f on failure.
(lint-fallback-load): ( resolved-path -- module/f ) [
  [ (lint-load-cache) swap native.load-check-file ] [ drop f ] recover
] ;

\\ Load a module by resolved path using the lint cache, returning exported word
\\ names as an array of strings, or an empty array on failure.
lint-module-exports: ( resolved-path -- array ) [
  \ First try the standard module cache (module was loaded during use),
  \ then fall back to loading via the lint cache.
  dup native.module-cache-value swap native.cached-module
  dup
  [ swap drop ]
  [ drop (lint-fallback-load) ]
  if
  dup f = [ drop { } ] [ @keys [ >string ] #map #collect ] if
] ;

\ --- Per-file analysis ---

(lint-file): ( path rules -- diagnostics ) [
  f set-lint-semantic-context-error
  swap dup (read-file)
  \ stack: rules path source
  dup 1z-tokenize #collect
  \ stack: rules path source tokens
  dup (parse-suppressions)
  \ stack: rules path source tokens suppressions
  2 pick-n (build-line-index)
  \ stack: rules path source tokens suppressions line-index
  4 pick-n (lint-circular-file?) [
    f
  ] [
    4 pick-n (build-semantic-context)
  ] if
  \ stack: rules(6) path(5) source(4) tokens(3) suppressions(2) line-index(1) sem-ctx(0)

  6 array-n
  \ stack: rules(1) ctx(0)
  2dup (unknown-suppression-diagnostics)
  [
    dup [ swap ] dip
    \ stack: ctx(2) rules(1) ctx(0)
    [ (lint-rule-with-context) ] curry #map #collect
    { } [ #append ] #reduce
    \ stack: ctx(1) diagnostics(0)
    swap (append-semantic-context-diagnostic)
  ] dip
  #append
] ;

\\ Build the diagnostic reported when the semantic context could not be
\\ built for a file. Anchored at the start of the file, since the failure
\\ is not tied to a specific token.
(semantic-context-error-diagnostic): ( ctx error -- diagnostic ) [
  message: @get "semantic analysis unavailable for this file: " swap #append
  \ stack: ctx message
  [
    dup 0 #nth swap 4 #nth
    [ "semantic-context-unavailable" warning: ] 2dip
    0
  ] dip
  \ stack: rule-id severity path line-index pos message
  diag-at-pos
] ;

\\ Append a diagnostic reporting that the semantic context could not be
\\ built for this file, unless it was skipped for being part of a detected
\\ circular dependency, which circular-dependency already reports.
(append-semantic-context-diagnostic): ( diagnostics ctx -- diagnostics' ) [
  dup 5 #nth f = [
    lint-semantic-context-error dup f = [
      2drop
    ] [
      (semantic-context-error-diagnostic)
      1array #append
    ] if
  ] [
    drop
  ] if
] ;

\ --- Output formatting ---

\\ Format a lint diagnostic as "file:line:col: severity: [rule-id] message".
format-diagnostic: ( lint-diagnostic -- string ) [
  dup file>>
  ":" #append over line>> >string #append
  ":" #append over column>> >string #append
  ": " #append over severity>> >string #append
  ": [" #append over rule-id>> #append
  "] " #append swap message>> #append
] ;

\ --- Whole-run semantic helpers ---

(ensure-lint-file-exists): ( path -- path ) [
  dup file-exists? not [
    "Error: file not found: " swap #append eprint-line
    2 sys-exit
  ] when
] ;

(preload-lint-file): ( path -- ) [
  (ensure-lint-file-exists)
  [ (lint-load-cache) swap native.load-check-file drop ] [ drop ] recover
] ;

(compute-dead-definitions): ( files -- array/f ) [
  [ (lint-load-cache) swap native.dead-definitions ] [ drop f ] recover
] ;

\ --- Circular dependency detection (token-level, runs before preload) ---

\ Is this import written as a path? The loader resolves those against the importing file, and
\ everything else is a module name it looks up on the search paths. Mirrors the loader's own
\ classification.
(path-mode-import?): ( path -- ? ) [
  dup "./" #starts-with? [ drop t ] [
    dup "../" #starts-with? [ drop t ] [
      dup "/" #starts-with? [ drop t ] [ ".1z" #ends-with? ] if
    ] if
  ] if
] ;

\ Resolve a relative import path against the importing file's directory.
(resolve-use-path): ( source-file import-path -- resolved ) [
  swap dirname swap path-join normalize
] ;

\ Canonical path of a checked file or of a path-mode import, or f when it names no file. Resolved
\ against the working directory, since a lint path comes from the command line rather than from a
\ `use` statement.
(canonical-file-path): ( path -- canonical/f ) [
  [ canonical-path ] [ drop f ] recover
] ;

\ Canonical path of a module name the loader would find on its search paths, or f when nothing
\ resolves.
(canonical-module-path): ( name -- canonical/f ) [
  [ native.resolve-load-path ] [ drop f ] recover
] ;

\ Record one checked file under its canonical path. A file that does not resolve contributes
\ nothing.
(index-corpus-file): ( index file -- index ) [
  dup (canonical-file-path)
  dup [ swap @set! ] [ 2drop ] if
] ;

\ Map each checked file's canonical path to the spelling the caller passed, so a resolved import
\ can be named the way diagnostics name it.
(build-corpus-index): ( files -- index ) [
  M{ } [ (index-corpus-file) ] #reduce
] ;

\ The checked file an import names, or f when it names none. An import that resolves outside the
\ checked set has no node to point at, so it yields no edge; the loader's own check covers what the
\ corpus cannot see.
(resolve-import-target): ( source-file import-path -- target/f ) [
  dup (path-mode-import?)
  [ (resolve-use-path) (canonical-file-path) ]
  [ nip (canonical-module-path) ]
  if
  dup [ (lint-corpus-index) dup [ swap f @get-or ] [ 2drop f ] if ] when
] ;

\ Strip the surrounding quotes from a use-string token value.
(strip-use-string-quotes): ( str -- str' ) [
  1 #drop dup #len 1 - #take
] ;

\ Kind of the token at i, or f past the end.
(token-kind-at): ( tokens i -- kind/f ) [
  2dup swap #len < [ #nth kind>> ] [ 2drop f ] if
] ;

\ Value of the word token at i, or f past the end or on another kind.
(word-value-at): ( tokens i -- value/f ) [
  2dup (token-kind-at) word: = [ #nth value>> ] [ 2drop f ] if
] ;

\ Index of the string naming the module in the use statement whose `use` sits at i, or f when the
\ statement holds no string before its semicolon.
\
\ Scanning to the first string rather than taking the next token is what lets a selective import
\ through: its `{ ... }` group holds symbols, never strings.
(use-string-index): ( tokens i -- idx/f ) [
  ++
  [
    2dup (token-kind-at)
    dup f = swap dup string: = swap semicolon: = or or not
  ] [ ++ ] while
  2dup (token-kind-at) string: = [ nip ] [ 2drop f ] if
] ;

\ Does a `"module" load reexport` statement start at i? That is how a module republishes another
\ one's words, and it is an import edge like any other.
(reexport-import-at?): ( tokens i -- ? ) [
  2dup ++ (word-value-at) "load" = [
    2 + (word-value-at) "reexport" =
  ] [ 2drop f ] if
] ;

\ Index of the string naming a module imported at i, or f when no import statement starts there.
(import-string-index): ( tokens i -- idx/f ) [
  2dup (word-value-at) "use" = [
    (use-string-index)
  ] [
    2dup (reexport-import-at?) [ nip ] [ 2drop f ] if
  ] if
] ;

\ Build the { target line col } tuple for one resolved import.
(use-target-tuple): ( line-index token target -- tuple ) [
  swap pos>>
  \ stack: line-index(2) target(1) pos(0)
  2 pick-n swap (pos>line-col)
  \ stack: line-index(3) target(2) line(1) col(0)
  3 array-n nip
] ;

\ Append the import named at i, if any, to the target list.
(collect-use-target): ( path line-index tokens targets i -- ) [
  2 pick-n swap (import-string-index)
  \ stack: path(4) line-index(3) tokens(2) targets(1) idx/f(0)
  dup [
    2 pick-n swap #nth
    \ stack: path(4) line-index(3) tokens(2) targets(1) token(0)
    dup value>> (strip-use-string-quotes)
    \ stack: path(5) line-index(4) tokens(3) targets(2) token(1) import(0)
    5 pick-n swap (resolve-import-target)
    \ stack: path(5) line-index(4) tokens(3) targets(2) token(1) target(0)
    dup [
      4 pick-n -rot> (use-target-tuple)
      over swap #push! drop
    ] [ 2drop ] if
  ] [ drop ] if
  2drop 2drop
] ;

\ Extract the modules a file imports, each resolved to the checked file it names. Returns an array
\ of { target line col } tuples.
(extract-use-targets): ( path source tokens -- path targets ) [
  swap (build-line-index) swap
  [ significant-token? ] #filter #collect
  V{ } 0
  \ Each token is visited by position rather than by value, since recognizing an import needs to
  \ look ahead past a selective-import group.
  2 pick-n [
    \ stack: path(5) line-index(4) tokens(3) targets(2) i(1) token(0)
    drop
    4 pick-n 4 pick-n 4 pick-n 4 pick-n 4 pick-n (collect-use-target)
    ++
  ] #each
  drop
  [ 2drop ] dip
] ;

\ Read and tokenize a file, then extract its import targets.
(file-use-targets): ( path -- path targets ) [
  dup (read-file) dup 1z-tokenize #collect (extract-use-targets)
] ;

\ Run one lint rule against a materialized lint-file context array:
\ { path source tokens suppressions line-index sem-ctx }.
(lint-rule-with-context): ( rule ctx -- diags ) [
  swap
  dup id>> 2 pick-n 3 #nth (suppressed?) [
    2drop { }
  ] [
    1 pick-n 0 #nth
    2 pick-n 1 #nth
    3 pick-n 2 #nth
    4 pick-n 4 #nth
    5 pick-n 5 #nth
    5 pick-n check>> call
    swap drop swap drop
  ] if
] ;

\ Build a dependency graph from all checked files.
\ Returns M{ source-path -> [ { target-path line col } ... ] }.
\
\ The corpus index every edge resolves through is built here, from the same file list, so no caller
\ has to set it up first.
(build-dep-graph): ( files -- graph ) [
  dup (build-corpus-index) (set-lint-corpus-index)
  M{ } swap
  \ stack: graph(1) files(0)
  0
  \ stack: graph(2) files(1) idx(0)
  [
    over #len over >
  ] [
    1 pick-n over #nth
    \ stack: graph(3) files(2) idx(1) file(0)
    dup (file-use-targets)
    \ stack: graph(5) files(4) idx(3) file(2) file(1) targets(0)
    dup #len 0 > [
      5 pick-n -rot> @set! drop
    ] [ 2drop ] if
    drop
    ++
  ] while
  2drop
] ;

\ Import edges leaving one node, or an empty array when it imports nothing.
(graph-edges): ( graph node -- edges ) [
  2dup @has? [ @get ] [ 2drop { } ] if
] ;

\ Record one import edge. The first visit to a target fixes the node that reached it, and every
\ target but start joins the queue.
\
\ An entry under start is therefore the search's answer: something imported its way back to where
\ the walk began.
(visit-cycle-edge): ( start parent queue node target -- ) [
  \ stack: start(4) parent(3) queue(2) node(1) target(0)
  3 pick-n over @has? not [
    3 pick-n over 3 pick-n @set! drop
    dup 5 pick-n = not [ 2 pick-n over #push! drop ] when
  ] when
  2drop 2drop drop
] ;

\ Visit every import edge leaving one node.
(visit-cycle-node): ( graph start parent queue node -- ) [
  4 pick-n over (graph-edges)
  \ stack: graph(5) start(4) parent(3) queue(2) node(1) edges(0)
  [
    \ stack: graph(5) start(4) parent(3) queue(2) node(1) edge(0)
    0 #nth
    4 pick-n 4 pick-n 4 pick-n 4 pick-n 4 pick-n (visit-cycle-edge)
    drop
  ] #each
  2drop 2drop drop
] ;

\ The cycle chain in import order: start, then the nodes reached on the way to the import that
\ closed back onto it, then start again.
\
\ `rev` holds those nodes closing-first, because a parent walk runs backwards, so popping off its
\ end yields them in import order.
(chain-from-reversed): ( start rev -- chain ) [
  over 1array
  \ stack: start(2) rev(1) chain(0)
  [ over #len 0 > ] [
    [ #pop! ] dip
    swap 1array #append
  ] while
  2 pick-n 1array #append
  [ 2drop ] dip
] ;

\ Rebuild the cycle the search found, walking the parent links back from the node whose import
\ closed onto start.
(cycle-chain): ( parent start node -- chain ) [
  V{ }
  \ stack: parent(3) start(2) node(1) rev(0)
  [ over 3 pick-n = not ] [
    over #push!
    [ 2 pick-n swap @get ] dip
  ] while
  nip (chain-from-reversed) nip
] ;

\ The shortest cycle through start, as the chain of files it passes through with start repeated at
\ the end, or f when nothing imports its way back.
\
\ Breadth-first, so the chain reported for a file is the shortest it sits on.
(find-cycle-from): ( graph start -- cycle-or-f ) [
  M{ }
  V{ } 2 pick-n #push!
  0
  \ stack: graph(4) start(3) parent(2) queue(1) head(0)
  [ 1 pick-n #len over > [ 2 pick-n 4 pick-n @has? not ] [ f ] if ] [
    over over #nth
    [ ++ ] dip
    \ stack: graph(5) start(4) parent(3) queue(2) head(1) node(0)
    5 pick-n 5 pick-n 5 pick-n 5 pick-n 4 pick-n (visit-cycle-node)
    drop
  ] while
  2 pick-n 4 pick-n @has? [
    2 pick-n 4 pick-n over over @get (cycle-chain)
  ] [ f ] if
  [ 2drop 2drop drop ] dip
] ;

\ Is this file part of a detected circular dependency?
(lint-circular-file?): ( path -- ? ) [
  lint-circular-files [ 1 #nth ] #map #collect swap #in?
] ;

\ Position of the import that takes file to target, as line and column. A chain always has one, so
\ the 1:1 fallback only guards a caller passing a target the file does not import.
(import-position): ( graph file target -- line col ) [
  [ (graph-edges) ] dip
  \ stack: edges(1) target(0)
  0
  [ 2 pick-n #len over > [ 2 pick-n over #nth 0 #nth 2 pick-n = not ] [ f ] if ] [ ++ ] while
  \ stack: edges(2) target(1) i(0)
  2 pick-n #len over > [
    nip #nth dup 1 #nth swap 2 #nth
  ] [
    3drop 1 1
  ] if
] ;

\ Build a circular-dependency record { chain file line col }, anchored at the import that opens the
\ cycle.
(cycle-record): ( graph file cycle -- record ) [
  2 pick-n 2 pick-n 2 pick-n 1 #nth (import-position)
  \ stack: graph(4) file(3) cycle(2) line(1) col(0)
  2 pick-n 4 pick-n 3 pick-n 3 pick-n 4 array-n
  [ 2drop 2drop drop ] dip
] ;

\ The circular-dependency record for one file, or f when it sits on no cycle.
(file-cycle-record): ( graph file -- record/f ) [
  2dup (find-cycle-from)
  dup [ (cycle-record) ] [ [ 2drop ] dip ] if
] ;

\ Compute files involved in circular dependencies.
\ Returns an array of { chain file line col } records, one for each checked file that sits on a
\ cycle, naming the shortest chain through it.
(compute-circular-deps): ( files -- records ) [
  dup (build-dep-graph)
  swap V{ } swap
  \ stack: graph(2) records(1) files(0)
  [
    \ stack: graph(2) records(1) file(0)
    2 pick-n over (file-cycle-record)
    dup [ 2 pick-n swap #push! drop ] [ drop ] if
    drop
  ] #each
  nip
] ;

\ Compute the set of file paths involved in any circular dependency.
(circular-file-set): ( records -- set ) [
  [ 1 #nth ] #map #collect
  H{ } [ t @set ] #reduce
] ;

\ Preload one file unless it is marked circular for this lint run.
(preload-file-if-needed): ( file circular-set -- ) [
  2dup swap @has? [ 2drop ] [ drop (preload-lint-file) ] if
] ;

\ Preload checked files that are not part of a detected cycle.
(preload-non-circular-files): ( files circular-set -- ) [
  [ (preload-file-if-needed) ] curry #each
] ;

\ Run lint rules across the checked file set and accumulate diagnostics.
(lint-files): ( files rules -- diagnostics ) [
  [ (lint-file) ] curry #map #collect
  { } [ #append ] #reduce
] ;

\ Left-pad a line or column number to a fixed width, so a string comparison of two sort keys orders
\ them numerically.
(sort-key-number): ( n -- str ) [
  >string
  [ dup #len 8 < ] [ "0" swap #append ] while
] ;

\ --- Main entry point ---

\\ Run all registered lint rules against the given file list.
\\ Prints diagnostics to stderr. Leaves t (clean) or f (findings) on stack.
run-lint: ( files -- bool ) [
  lint-rules dup #len 0 = [
    \ No rules registered: everything is clean
    2drop t
  ] [
    swap
    \ stack: rules files
    dup set-lint-checked-files
    \ Detect circular dependencies from tokens before preloading.
    dup (compute-circular-deps) dup set-lint-circular-files
    (circular-file-set)
    \ Preload non-circular files into the lint module cache.
    over over (preload-non-circular-files)
    lint-checked-files (compute-dead-definitions) set-lint-dead-definitions
    drop
    over (lint-files)
    nip

    \ Sort by file, then line, then column, on a "file:NNNNNNNN:NNNNNNNN" key.
    [
      dup file>> ":" #append
      over line>> (sort-key-number) #append
      ":" #append
      swap column>> (sort-key-number) #append
    ] #sort-by

    dup #len 0 = [
      drop t
    ] [
      [ format-diagnostic eprint-line ] #each
      f
    ] if
  ] if
] ;
