\ lib/lint.1z - Lint engine for 1z source code
\
\ Provides rule registration, per-file token-level and semantic
\ analysis, diagnostic collection, and output formatting.
\
\ Usage:
\   use "lint" ;
\   "my-rule" warning: [ check-quot ] f make-lint-rule register-lint-rule
\   command-line-args run-lint

use "scanner" ;
use "lexer" ;
use "1z-tokens" ;
use "os/fs" ;
use "os/path" ;
use "ranges" ;

\ --- Struct definitions ---

\\ A lint rule: id (string), severity (symbol), check (quotation), fix (reserved).
\\ The check quotation has signature:
\\   ( path source tokens line-index semantic-context -- diagnostics )
\\ where semantic-context is a semantic-context struct or f if loading failed.
\\ It returns an array of lint-diagnostic structs (possibly empty).
lint-rule: struct{ id severity check fix } ;

\\ A lint diagnostic produced by a rule check.
lint-diagnostic: struct{ rule-id severity file line column message } ;

\\ Semantic context: module loaded in check mode plus a hash of word-info structs.
semantic-context: struct{ module word-infos } ;

\ --- Rule registry (module-scoped mutable storage) ---

(lint-registry-storage): ( -- mmap ) parse-time [ [ rules: { } ] make-mutable-map ] ;
(lint-registry): ( -- mmap ) [ (lint-registry-storage) ] ;

\ --- Run-scoped state shared by rules that need the full checked file set ---

(lint-run-storage): ( -- mmap ) parse-time [
  [ checked-files: { } dead-definitions: f circular-files: { } ] make-mutable-map
] ;
(lint-run-state): ( -- mmap ) [ (lint-run-storage) ] ;

lint-checked-files: ( -- array ) [ (lint-run-state) checked-files: @get ] ;
set-lint-checked-files: ( files -- ) [ (lint-run-state) swap checked-files: swap @set! drop ] ;

lint-dead-definitions: ( -- array/f ) [ (lint-run-state) dead-definitions: @get ] ;
set-lint-dead-definitions: ( dead-defs -- ) [ (lint-run-state) swap dead-definitions: swap @set! drop ] ;

lint-circular-files: ( -- array ) [ (lint-run-state) circular-files: @get ] ;
set-lint-circular-files: ( circular -- ) [ (lint-run-state) swap circular-files: swap @set! drop ] ;

\\ Return the array of registered lint rules.
lint-rules: ( -- array ) [ (lint-registry) rules: @get ] ;

\\ Register a lint rule for use by run-lint.
register-lint-rule: ( lint-rule -- ) [
  \ stack: rule
  (lint-registry) dup rules: @get
  \ stack: rule registry old-rules
  <rot- 1array #append
  \ stack: registry new-rules
  rules: swap @set! drop
] ;

\ --- Line index computation ---

(lf-string): ( -- str ) [ 10 >char ] ;

\\ Build an array of newline character positions from a source string.
\\ Used to convert character offsets to line:column.
(build-line-index): ( source -- array ) [
  dup #len 0 = [ drop V{ } ] [
    V{ }
    over #len 0 swap 1 - <range> >iterator [
      2 pick-n over #nth (lf-string) = [
        over swap #push!
      ] when
      drop
    ] #each
    nip
  ] if
] ;

\\ Convert a 0-based character offset to 1-based line and column numbers.
\\ line-index is the array of newline positions from (build-line-index).
(pos>line-col): ( line-index pos -- line column ) [
  \ Filter to newlines that occur strictly before pos.
  swap over [ < ] curry #filter #collect
  \ stack: pos newlines-before
  dup #len ++ swap
  \ stack: pos line newlines-before
  dup #len 0 = [
    \ No newlines before pos: column = pos + 1
    \ stack: pos line { }
    drop swap ++
  ] [
    \ Column = pos - last-newline-pos
    \ stack: pos line newlines-before
    #last [ swap ] dip -
  ] if
] ;

\ --- Diagnostic construction helper ---

\\ Create a lint-diagnostic from rule metadata and a token position.
\\ Converts pos to line:column using the line-index, then constructs
\\ the lint-diagnostic struct.
(make-diag): ( rule-id severity path line-index pos message -- lint-diagnostic ) [
  \ Save message, compute line:col from line-index and pos
  [ (pos>line-col) ] dip
  \ stack: rule-id severity path line column message
  make-lint-diagnostic
] ;

\\ Public helper: create a diagnostic anchored at a character offset.
diag-at-pos: ( rule-id severity path line-index pos message -- lint-diagnostic ) [
  (make-diag)
] ;

\\ Public helper: create a diagnostic anchored at a token's position.
diag-at-token: ( rule-id severity path line-index token message -- lint-diagnostic ) [
  [ pos>> ] dip
  diag-at-pos
] ;

\\ Predicate: token has the given kind.
token-kind?: ( token kind -- ? ) [
  swap kind>> =
] ;

\\ Predicate: token is significant for token-level scans.
\\ Whitespace and newline tokens are not significant.
significant-token?: ( token -- ? ) [
  kind>> dup whitespace: = swap newline: = or not
] ;

\\ Predicate: token is a definition symbol token.
definition-symbol?: ( token -- ? ) [
  symbol: token-kind?
] ;

\ --- File reading ---

(read-file): ( path -- contents ) [
  read: stream-open dup stream-read-all swap stream-close bytes>
] ;

\ --- Pragma suppression parsing ---

\ Scan a materialized token array for pragma{ lint-suppress: { rule1 rule2 ... } }.
\ Returns an array of suppressed rule ID strings, or f if no suppression found.
\
\ Looks for the three-token prefix pragma{ lint-suppress: { in the
\ significant (non-whitespace, non-newline) tokens, then collects
\ word values until the first close-brace.
(parse-suppressions): ( tokens -- suppressions-or-f ) [
  drop f
] ;

\ Check if a token matches kind and value.
(tok-match?): ( token kind value -- bool ) [
  \ stack: token kind value
  swap 2 pick-n kind>> =
  \ stack: token value kind-match?
  [ swap value>> = ] dip and
] ;

\ Find the lint-suppress pragma prefix in a significant-token array.
\ Scans for pragma{ lint-suppress: { anywhere in the token stream,
\ then collects word values until close-brace.
(find-suppress-prefix): ( sig-tokens -- suppressions-or-f ) [
  dup #len 4 < [ drop f ] [
    \ Find index of pragma{ token with value "pragma{"
    f  \ result
    over #len 2 - 0 swap <range> >iterator [
      \ stack: sig-tokens result i
      over f = [
        \ result is still f: check this position
        2 pick-n over #nth open-brace: "pragma{" (tok-match?)
        [
          2 pick-n over ++ #nth symbol: "lint-suppress:" (tok-match?)
          [
            2 pick-n over 2 + #nth open-brace: "{" (tok-match?)
            [
              \ Found: collect from i+3 until close-brace
              2 pick-n swap 3 + #drop
              \ stack: sig-tokens result remaining-sig-tokens
              { } swap
              [
                dup #len 0 > [
                  dup 0 #nth kind>> close-brace: = [
                    drop f
                  ] [
                    dup 0 #nth value>> [ 1array #append ] dip
                    1 #drop t
                  ] if
                ] [ f ] if
              ] loop
              drop
              \ stack: sig-tokens old-result collected-rules
              nip
            ] when
          ] when
        ] when
        drop
      ] [ drop ] if
    ] #each
    nip
  ] if
] ;

\\ Check whether a rule ID is in the suppression list.
(suppressed?): ( rule-id suppressions -- bool ) [
  dup f = [
    2drop f
  ] [
    swap [ = ] curry #any
  ] if
] ;

\ --- Semantic analysis ---

(lint-load-cache-storage): ( -- mmap ) parse-time [ M{ } ] ;
(lint-load-cache): ( -- mmap ) [ (lint-load-cache-storage) ] ;

\\ Build a semantic context by loading a file in check mode.
\\ Returns a semantic-context struct, or f if loading fails.
(build-semantic-context): ( path -- semantic-context-or-f ) [
  [ (lint-load-cache) swap native.load-check-file ] [ drop f ] recover
  dup f = [ ] [
    dup @keys
    H{ }
    swap [
      \ stack: module hash word-name-symbol
      >string
      2 pick-n over >symbol native.>word (raw>word-info)
      \ stack: module hash word-name-string word-info
      \ @set ( assoc key value -- assoc' ): hash is already in position
      @set
      \ stack: module hash'
    ] #each
    \ stack: module word-infos-hash
    make-semantic-context
  ] if
] ;

\\ Look up a word-info by name from a semantic context. Returns word-info or f.
semantic-word-info: ( semantic-context name -- word-info-or-f ) [
  swap dup f = [ nip ] [
    word-infos>> swap
    \ stack: hash name
    2dup @has? [
      @get
    ] [ 2drop f ] if
  ] if
] ;

\\ Get all word names from a semantic context. Returns array or empty array.
semantic-word-names: ( semantic-context -- array ) [
  dup f = [ drop { } ] [ word-infos>> @keys ] if
] ;

\\ Load a module by resolved path using the lint cache, returning exported word
\\ names as an array of strings, or an empty array on failure.
lint-module-exports: ( resolved-path -- array ) [
  \ First try the standard module cache (module was loaded during use).
  [ native.module-cache-value swap @get ] [ 2drop f ] recover
  dup f = [
    drop
    \ Fall back to loading via the lint cache.
    [ (lint-load-cache) swap native.load-check-file ] [ drop f ] recover
  ] when
  dup f = [ drop { } ] [ @keys [ >string ] #map #collect ] if
] ;

\ --- Per-file analysis ---

(lint-file): ( path rules -- diagnostics ) [
  swap dup (read-file)
  \ stack: rules path source
  dup 1z-tokenize #collect
  \ stack: rules path source tokens
  dup (parse-suppressions)
  \ stack: rules path source tokens suppressions
  2 pick-n (build-line-index)
  \ stack: rules path source tokens suppressions line-index
  4 pick-n (lint-circular-file?) [
    f
  ] [
    4 pick-n (build-semantic-context)
  ] if
  \ stack: rules(6) path(5) source(4) tokens(3) suppressions(2) line-index(1) sem-ctx(0)

  6 array-n
  \ stack: rules(1) ctx(0)
  [ (lint-rule-with-context) ] curry #map #collect
  { } [ #append ] #reduce
] ;

\ --- Output formatting ---

\\ Format a lint diagnostic as "file:line:col: severity: [rule-id] message".
format-diagnostic: ( lint-diagnostic -- string ) [
  dup file>>
  ":" #append over line>> >string #append
  ":" #append over column>> >string #append
  ": " #append over severity>> >string #append
  ": [" #append over rule-id>> #append
  "] " #append swap message>> #append
] ;

\ --- Whole-run semantic helpers ---

(ensure-lint-file-exists): ( path -- path ) [
  dup file-exists? not [
    "Error: file not found: " swap #append eprint-line
    2 sys-exit
  ] when
] ;

(preload-lint-file): ( path -- ) [
  (ensure-lint-file-exists)
  [ (lint-load-cache) swap native.load-check-file drop ] [ drop ] recover
] ;

(compute-dead-definitions): ( files -- array/f ) [
  [ (lint-load-cache) swap native.dead-definitions ] [ drop f ] recover
] ;

\ --- Circular dependency detection (token-level, runs before preload) ---

\ Does a module path refer to a relative import?
(relative-import?): ( path -- ? ) [
  dup "./" #starts-with? swap "../" #starts-with? or
] ;

\ Resolve a relative import path against the importing file's directory.
(resolve-use-path): ( source-file import-path -- resolved ) [
  swap dirname swap path-join normalize
] ;

\ Strip the surrounding quotes from a use-string token value.
(strip-use-string-quotes): ( str -- str' ) [
  1 #drop dup #len 1 - #take
] ;

\ Extract relative use targets from a file's token stream.
\ Returns an array of { resolved-path line col } tuples.
(extract-use-targets): ( path source tokens -- path targets ) [
  swap (build-line-index) swap
  \ stack: path(2) line-index(1) tokens(0)
  V{ } f
  \ stack: path(4) line-index(3) tokens(2) targets(1) saw-use?(0)
  2 pick-n [
    \ stack: ... targets(2) saw-use?(1) token(0)
    dup significant-token? [
      swap
      \ stack: ... path(4) line-index(3) tokens(2) targets(1) token(0) saw-use?
      \ if consumes saw-use?, leaving token on top
      [
        \ Previous was use: check if this is a relative string import
        dup kind>> string: = [
          dup value>> (strip-use-string-quotes)
          dup (relative-import?) [
            5 pick-n swap (resolve-use-path)
            over pos>> 5 pick-n swap (pos>line-col)
            3 array-n
            2 pick-n swap #push! drop
          ] [ drop ] if
          drop f
        ] [
          drop f
        ] if
      ] [
        dup kind>> word: = over value>> "use" = and [
          drop t
        ] [
          drop f
        ] if
      ] if
    ] [ drop ] if
  ] #each
  drop
  [ drop drop ] dip
] ;

\ Read and tokenize a file, then extract relative use targets.
(file-use-targets): ( path -- path targets ) [
  dup (read-file) dup 1z-tokenize #collect (extract-use-targets)
] ;

\ Read and tokenize a file, returning only its relative use targets.
(file-use-targets-only): ( path -- targets ) [
  (file-use-targets) nip
] ;

\ Run one lint rule against a materialized lint-file context array:
\ { path source tokens suppressions line-index sem-ctx }.
(lint-rule-with-context): ( rule ctx -- diags ) [
  swap
  dup id>> 2 pick-n 3 #nth (suppressed?) [
    2drop { }
  ] [
    1 pick-n 0 #nth
    2 pick-n 1 #nth
    3 pick-n 2 #nth
    4 pick-n 4 #nth
    5 pick-n 5 #nth
    5 pick-n check>> call
    swap drop swap drop
  ] if
] ;

\ Build a dependency graph from all checked files.
\ Returns M{ source-path -> [ { target-path line col } ... ] }.
(build-dep-graph): ( files -- graph ) [
  M{ } swap
  \ stack: graph(1) files(0)
  0
  \ stack: graph(2) files(1) idx(0)
  [
    1 pick-n #len <
  ] [
    1 pick-n over #nth
    \ stack: graph(3) files(2) idx(1) file(0)
    dup (file-use-targets)
    \ stack: graph(5) files(4) idx(3) file(2) file(1) targets(0)
    dup #len 0 > [
      5 pick-n -rot> @set! drop
    ] [ drop ] if
    drop
    ++
  ] while
  drop [ drop ] dip
] ;

\ Check if target is reachable from start via BFS through the dep graph.
\ Returns the cycle path (array of file paths) or f.
(find-cycle-from): ( graph start -- cycle-or-f ) [
  \ BFS: seen M{}, parent M{}, work V{}
  M{ } over t @set! drop  \ seen
  M{ }                    \ parent
  V{ }                    \ work
  \ stack: graph(4) start(3) seen(2) parent(1) work(0)

  \ Seed work list with start's direct neighbors
  4 pick-n 4 pick-n @has? [
    4 pick-n 4 pick-n @get
    dup #len 0
    \ stack: graph(7) start(6) seen(5) parent(4) work(3) edges(2) len(1) i(0)
    [
      dup 2 pick-n <
    ] [
      2 pick-n over #nth 0 #nth
      \ stack: ... len(2) i(1) target(0)
      dup 6 pick-n swap @has? not [
        5 pick-n swap #push! drop
        6 pick-n over t @set! drop
        5 pick-n over 7 pick-n @set! drop
        drop
      ] [ drop ] if
      ++
    ] while
    drop drop
  ] when

  f
  \ stack: graph(5) start(4) seen(3) parent(2) work(1) result(0)

  [
    dup f = 2 pick-n #len 0 > and
  ] [
    \ Pop from work
    2 pick-n dup #len 1 - #nth
    3 pick-n dup #len 1 - #take drop
    \ stack: graph(6) start(5) seen(4) parent(3) work(2) result(1) node(0)

    dup 5 pick-n = [
      \ Found path back to start! Reconstruct via parent chain.
      V{ } over #push! drop
      \ stack: ... result(1) node(0) path-V{}
      swap
      \ stack: ... result(2) path(1) node(0)
      [
        dup 6 pick-n = not
      ] [
        2 pick-n over #push! drop
        5 pick-n swap @get
      ] while
      2 pick-n swap #push! drop
      \ Reverse path
      { } swap #len 0
      [
        dup 2 pick-n #len <
      ] [
        2 pick-n over #nth
        3 pick-n swap #suffix
        [ drop ] dip
        ++
      ] while
      drop nip
      \ stack: ... result(1) reversed-path(0)
      nip
    ] [
      \ Explore node's neighbors
      6 pick-n over @has? [
        6 pick-n over @get
        dup #len 0
        \ stack: ... result(2) node(1) edges(0) len i
        [
          dup 2 pick-n <
        ] [
          2 pick-n over #nth 0 #nth
          \ stack: ... node(4) edges(3) len(2) i(1) target(0)
          dup 9 pick-n swap @has? not [
            8 pick-n swap #push! drop
            9 pick-n over t @set! drop
            8 pick-n over 5 pick-n @set! drop
            drop
          ] [ drop ] if
          ++
        ] while
        drop drop
      ] when
      drop
    ] if
  ] while

  [ drop drop drop drop drop ] dip
] ;

\ Does target directly import source?
(reciprocal-import?): ( source target -- ? ) [
  dup (file-use-targets-only) [ 0 #nth ] #map #collect nip swap #in?
] ;

\ Is this file part of a detected circular dependency?
(lint-circular-file?): ( path -- ? ) [
  lint-circular-files [ 1 #nth ] #map #collect swap #in?
] ;

\ Build a circular-dependency record { target-file file line col }.
(make-reciprocal-cycle-record): ( file edge -- record ) [
  dup 0 #nth
  2 pick-n
  2 pick-n 1 #nth
  3 pick-n 2 #nth
  4 array-n
  [ drop drop ] dip
] ;

\ Does this import edge participate in a direct cycle with the given file?
(direct-cycle-edge?): ( edge file -- ? ) [
  swap dup 0 #nth nip (reciprocal-import?)
] ;

\ Convert an import edge into a circular-dependency record for the given file.
(edge>circular-record): ( edge file -- record ) [
  swap (make-reciprocal-cycle-record)
] ;

\ Compute circular-dependency records contributed by one file.
(file-circular-records): ( file -- records ) [
  dup dup (file-use-targets-only) swap
  [ (direct-cycle-edge?) ] curry #filter #collect
  swap [ (edge>circular-record) ] curry #map #collect
] ;

\ Compute files involved in circular dependencies.
\ Returns an array of { target-file file line col } records for each
\ import that participates in a direct circular dependency.
(compute-circular-deps): ( files -- records ) [
  [ (file-circular-records) ] #map #collect
  { } [ #append ] #reduce
] ;

\ Compute the set of file paths involved in any circular dependency.
(circular-file-set): ( records -- set ) [
  [ 1 #nth ] #map #collect
  H{ } [ t @set ] #reduce
] ;

\ Preload one file unless it is marked circular for this lint run.
(preload-file-if-needed): ( file circular-set -- ) [
  2dup swap @has? [ 2drop ] [ drop (preload-lint-file) ] if
] ;

\ Preload checked files that are not part of a detected cycle.
(preload-non-circular-files): ( files circular-set -- ) [
  [ (preload-file-if-needed) ] curry #each
] ;

\ Run lint rules across the checked file set and accumulate diagnostics.
(lint-files): ( files rules -- diagnostics ) [
  [ (lint-file) ] curry #map #collect
  { } [ #append ] #reduce
] ;

\ --- Main entry point ---

\\ Run all registered lint rules against the given file list.
\\ Prints diagnostics to stderr. Leaves t (clean) or f (findings) on stack.
run-lint: ( files -- bool ) [
  lint-rules dup #len 0 = [
    \ No rules registered: everything is clean
    2drop t
  ] [
    swap
    \ stack: rules files
    dup set-lint-checked-files
    \ Detect circular dependencies from tokens before preloading.
    dup (compute-circular-deps) dup set-lint-circular-files
    (circular-file-set)
    \ Preload non-circular files into the lint module cache.
    over over (preload-non-circular-files)
    lint-checked-files (compute-dead-definitions) set-lint-dead-definitions
    drop
    over (lint-files)
    nip

    \ Sort by file, then line, then column.
    \ Build a string key "file:NNNNNNNN:NNNNNNNN" with zero-padded numbers.
    [
      dup file>> ":" #append
      over line>> >string dup #len 8 swap - [ "0" #append ] times swap #append
      ":" #append
      swap column>> >string dup #len 8 swap - [ "0" #append ] times swap #append
    ] #sort-by

    dup #len 0 = [
      drop t
    ] [
      [ format-diagnostic eprint-line ] #each
      f
    ] if
  ] if
] ;
