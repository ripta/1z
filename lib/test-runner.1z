\ lib/test-runner.1z - Unit test runner for *_test.1z files
\
\ Loads a test file as a module, imports its definitions so each test word
\ carries its source_module (which restores the module's deps frame on
\ invocation, resolving `assert=` and same-file helpers), enumerates the
\ `test-` prefixed entries, and calls each one. Filters tests by markers
\ when ONEZ_TEST_TAGS is set. When the test file defines `before-each` or
\ `after-each` words, they run around every test that actually executes;
\ skipped tests fire neither hook. Leaves the testing library's failure
\ count on the stack so the caller can derive an exit code.
\
\ For a `foo_test.1z` file that imports its same-directory sibling `foo.1z`,
\ the runner also borrows the sibling's private helpers into the test module,
\ so test words can call them by name. This is the convention trigger for the
\ borrow feature; explicit `borrow` covers every other invocation.

use "testing" ;
use "sequences" ;
use "strings" ;
use "os/path" ;

\ Build a tag-spec hash from include and exclude arrays.
(make-tag-spec): ( includes excludes -- hash ) [
  H{ } swap exclude: swap @set
  swap include: swap @set
] ;

\ Parse ONEZ_TEST_TAGS into a tag-spec, or return f when the variable is
\ unset or yields no usable entries. Entries are comma-separated; whitespace
\ is trimmed; an entry beginning with `-` is an exclude (the prefix is
\ stripped), everything else is an include.
(parse-tag-spec): ( -- spec ) [
  environ "ONEZ_TEST_TAGS" @has? not
  [ f ]
  [
    environ "ONEZ_TEST_TAGS" @get
    "," split
    >iterator
    [ trim ] #map
    [ #empty? not ] #filter
    [ "-" #starts-with? ] #partition
    \ stack: excludes-prefixed includes
    swap
    \ stack: includes excludes-prefixed
    >iterator [ 1 #drop ] #map #collect
    \ stack: includes excludes
    2dup #empty? swap #empty? and
    [ 2drop f ]
    [ (make-tag-spec) ]
    if
  ]
  if
] ;

\ True iff at least one element of seq is present in entries.
(any-in?): ( seq entries -- ? ) [
  [ swap #in? ] curry #any
] ;

\ Decide whether a test with the given marker names should run under the spec.
\ - spec = f          → always run.
\ - empty markers     → skip (filter is active, but the test is untagged).
\ - any in excludes   → skip.
\ - includes empty    → run (exclude-only filter).
\ - any in includes   → run; otherwise skip.
(should-run?): ( marker-strs spec -- ? ) [
  dup f =
  [ 2drop t ]
  [
    over #empty?
    [ 2drop f ]
    [
      dup exclude: @get
      2 pick-n swap (any-in?)
      [ 2drop f ]
      [
        dup include: @get
        dup #empty?
        [ drop 2drop t ]
        [
          2 pick-n swap (any-in?)
          -rot> 2drop
        ]
        if
      ]
      if
    ]
    if
  ]
  if
] ;

\ Call (module name) if the module defines a word by that name; otherwise
\ leave the stack untouched. Used to dispatch optional `before-each` and
\ `after-each` hooks around each executed test.
(call-if-defined): ( module name -- ) [
  2dup @has?
  [ @get call ]
  [ 2drop ]
  if
] ;

\ Run or skip a single test word from the loaded module.
\ The module was `import`ed into the runner's scope, so the prelude
\ `word-markers` finds the test word via `current-scope`.
(run-or-skip): ( module spec name -- module spec ) [
  >string                              \ module spec name-str
  dup word-markers                     \ module spec name-str markers
  >iterator [ >string ] #map #collect  \ module spec name-str marker-strs
  2 pick-n                             \ module spec name-str marker-strs spec
  (should-run?)                        \ module spec name-str run?
  [
    \ Run path: before-each, the test, after-each.
    \ stack: module spec name-str
    2 pick-n "before-each" (call-if-defined)
    eval-string
    \ stack: module spec
    over "after-each" (call-if-defined)
  ]
  [ skip ]
  if
] ;

\ Derive the sibling module path for a `*_test.1z` file: same directory, with
\ the `_test.1z` suffix stripped back to `.1z`. "a/foo_test.1z" -> "a/foo.1z".
(sibling-path): ( filepath -- path ) [
  dup dirname swap basename                       \ dir base
  dup #len "_test.1z" #len - #take ".1z" #append  \ dir sibling-base
  path-join
] ;

\ True when the dep word `name` in `deps-mod` is sourced from `sibling`.
\ A word with no source module yields a non-module `word-source` (f), never a
\ match. `#any` curries `sibling` then `deps-mod` on top of each key, so the
\ arguments arrive in this order.
(dep-sourced-from?): ( name sibling deps-mod -- ? ) [
  -rot> [ native.word-source ] dip  \ src sibling
  over module?
  [ = ]
  [ 2drop f ]
  if
] ;

\ True when the test module directly imported `sibling`: one of its own `deps`
\ carries a word whose source module is `sibling`. A transitive-only import
\ leaves no such dep, so it does not match.
(imports-module?): ( test-module sibling -- ? ) [
  swap native.module-deps              \ sibling deps-mod
  dup @keys                            \ sibling deps-mod keys
  -rot>                                \ keys sibling deps-mod
  [ (dep-sourced-from?) ] curry curry  \ keys ( name -- ? )
  #any
] ;

\ Borrow a `*_test.1z` file's same-directory sibling private helpers into its
\ already-loaded module, but only when the test file itself imported the
\ sibling. The sibling module is taken from the cache by canonical path, so no
\ load the test did not declare is ever initiated. A non-`*_test.1z` name, an
\ unresolvable sibling, an uncached sibling, or a merely transitive import all
\ leave the module untouched.
(borrow-sibling): ( filepath module -- ) [
  swap  \ module filepath
  dup basename "_test.1z" #ends-with?
  [
    (sibling-path)                                   \ module sibling-path
    [ native.resolve-load-path ] [ drop f ] recover  \ module resolved-or-f
    dup
    [
      module-cache get over @has?
      [
        module-cache get swap @get  \ module sibling-module
        2dup (imports-module?)
        [ swap native.borrow-deps ]
        [ 2drop ]
        if
      ]
      [ drop drop ]
      if
    ]
    [ 2drop ]
    if
  ]
  [ 2drop ]
  if
] ;

\ Run every `test-` word defined in the given file.
\
\ Stack: ( filepath -- failed )
\
\   - filepath: path to a *_test.1z file
\   - failed: number of failed assertions across all tests in the file
run-test-file: ( filepath -- failed ) [
  dup load
  tuck
  (borrow-sibling)
  dup import
  \ stack: module
  (parse-tag-spec)
  \ stack: module spec
  over @keys
  [ >string "test-" #starts-with? ] #filter
  [ >string ] #sort-by
  \ stack: module spec names
  [ (run-or-skip) ] #each
  \ stack: module spec
  drop drop
  test-counts failed: @get
] ;
