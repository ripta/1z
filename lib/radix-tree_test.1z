\ Unit tests for lib/radix-tree.1z.
\
\ The tree is persistent, so a fixture word can be shared: every insert returns a new tree
\ and leaves the fixture's own version alone. The runner executes test words in
\ alphabetical order, so each group's section banner sits on its alphabetically first word.

use "radix-tree" ;
use "testing" ;

\ --- Helpers ---

\ Three entries that force each insert shape in turn. "roman" lands as a bare leaf, "rom"
\ splits its label at a point where the key ends, and "romulus" descends through the new
\ interior node and diverges below it.
roman-fixture: ( -- radix-tree ) [
  string <radix-tree>
  "roman" 1 radix-insert
  "rom" 2 radix-insert
  "romulus" 3 radix-insert
] ;

\ A table shaped like the router's: a catch-all, a prefix, and a deeper prefix.
route-fixture: ( -- radix-tree ) [
  string <radix-tree>
  "/" 0 radix-insert
  "/api/" 1 radix-insert
  "/api/v1/" 2 radix-insert
] ;

\ The keys the interleaved run below is left holding, inserted straight into a fresh tree.
survivors-fixture: ( -- radix-tree ) [
  string <radix-tree>
  "/static/" 5 radix-insert
  "/api/beta/" 6 radix-insert
] ;

\ The value an option carries, so an assertion reads against a plain value.
unwrap: ( option -- value ) [ option:some> ] ;

\ One projection of a run of entries, so an assertion reads against a plain array.
entry-keys: ( iterator -- array ) [ [ key>> ] #map #collect ] ;

entry-values: ( iterator -- array ) [ [ value>> ] #map #collect ] ;

index-ascends?: stack-recursive ( index j -- ? ) [
  dup 2 pick-n #len < [
    2dup 1 - #nth 2 pick-n 2 pick-n #nth <
    [ 1 + index-ascends? ] [ 2drop f ] if
  ] [ 2drop t ] if
] ;

\ Every rule a node has to satisfy: a node with no value is the root or a genuine fork, each
\ of its children carries a label, and its index runs parallel to those children, opening
\ each of their labels in ascending order. A node reads its children's labels rather than
\ its own, so the root is exempt from the label rule and every other node is covered.
\
\ This is checked directly rather than by comparing the tree against a rebuild, because a
\ delete that broke the shape the same way an insert does would still match one. The label
\ rule gates the rest, so a violation reports rather than reading past an empty label.
node-compressed?: stack-recursive ( node root? -- ? ) [
  over dup value>> option:some? swap children>> #len 1 > or over or
  [ drop ] dip
  over children>> t [ label>> #len 0 > and ] #reduce and
  [
    dup children>> over index>> 0 0 #slice [ label>> 0 #nth #push ] #reduce
    over index>> =
    over index>> 1 index-ascends? and
    swap children>> t [ f node-compressed? and ] #reduce
    and
  ] [ drop f ] if
] ;

\ Threads the tree through, so a step of an interleaved run can be checked in place.
assert-compressed: ( radix-tree -- radix-tree ) [
  dup root>> t node-compressed?
  "the tree stays compressed" assert-true
] ;

\ --- Character boundary ---

test-boundary-splits-on-characters: ( -- ) [
  "character boundary" test-section
  string <radix-tree>
  "café" 1 radix-insert
  "cafè" 2 radix-insert
  dup root>> children>> 0 #nth
  dup label>> "caf" "the shared label stops at the last common character" assert=
  index>> "èé" "both divergent characters index whole, in codepoint order" assert=
  dup "café" radix-lookup? unwrap 1 "the first key survives the split" assert=
  "cafè" radix-lookup? unwrap 2 "the second key survives the split" assert=
] ;

\ --- Byte-array keys ---

test-bytes-keys-round-trip: ( -- ) [
  "byte-array keys" test-section
  byte-array <radix-tree>
  "roman" >bytes 1 radix-insert
  "rom" >bytes 2 radix-insert
  dup count>> 2 "both byte keys count" assert=
  dup "roman" >bytes radix-lookup? unwrap 1 "the longer byte key reads back" assert=
  "rom" >bytes radix-lookup? unwrap 2 "the split point reads back" assert=
] ;

test-bytes-longest-prefix: ( -- ) [
  byte-array <radix-tree>
  "rom" >bytes 2 radix-insert
  dup "romx" >bytes radix-longest? unwrap 2 "a byte key extends its prefix" assert=
  "ro" >bytes radix-longest? option:some? "a shorter byte key matches nothing" assert-false
] ;

test-bytes-split-labels: ( -- ) [
  byte-array <radix-tree>
  "roman" >bytes 1 radix-insert
  "roast" >bytes 2 radix-insert
  root>> children>> 0 #nth
  dup label>> "ro" >bytes "the byte label splits at the shared bytes" assert=
  index>> "am" >bytes "the two divergent bytes index in ascending order" assert=
] ;

\ --- Construction ---

test-construct-empty: ( -- ) [
  "construction" test-section
  string <radix-tree>
  dup count>> 0 "a fresh tree holds no entries" assert=
  dup key-type>> string = "the key type is the one asked for" assert-true
  root>> label>> "" "the root's label is empty in the key's own type" assert=
] ;

test-construct-rejects-other-types: ( -- ) [
  [ fixnum <radix-tree> ] invalid-argument:
  "a key type outside string and byte-array is rejected" assert-error-type
] ;

\ --- Delete ---

test-delete-bytes-merges: ( -- ) [
  "delete" test-section
  byte-array <radix-tree>
  B{ 0x80 0x61 } 1 radix-insert
  B{ 0x80 0x61 0x62 } 2 radix-insert
  B{ 0x80 0x61 } radix-delete
  assert-compressed
  dup count>> 1 "the byte entry is gone" assert=
  dup root>> children>> 0 #nth label>> B{ 0x80 0x61 0x62 }
  "the merged byte label joins both edges" assert=
  B{ 0x80 0x61 0x62 } radix-lookup? unwrap 2 "the surviving byte key reads back" assert=
] ;

test-delete-canonical-under-interleaving: ( -- ) [
  string <radix-tree>
  "/api/" 1 radix-insert assert-compressed
  "/api/v1/" 2 radix-insert assert-compressed
  "/api/v2/" 3 radix-insert assert-compressed
  "/admin/" 4 radix-insert assert-compressed
  "/api/v1/" radix-delete assert-compressed
  "/static/" 5 radix-insert assert-compressed
  "/api/v1/" 7 radix-insert assert-compressed
  "/admin/" radix-delete assert-compressed
  "/api/v2/" radix-delete assert-compressed
  "/api/v1/" radix-delete assert-compressed
  "/api/beta/" 6 radix-insert assert-compressed
  "/api/" radix-delete assert-compressed
  survivors-fixture
  "interleaving insert and delete leaves the tree a fresh build produces" assert=
] ;

test-delete-cascades-drop-then-merge: ( -- ) [
  \ A delete that fires both steps. The leaf goes, and the fork above it, now valueless with
  \ a single child, folds into what is left.
  string <radix-tree>
  "abc" 1 radix-insert
  "abd" 2 radix-insert
  "x" 3 radix-insert
  "abc" radix-delete
  assert-compressed
  dup root>> index>> "ax" "the root's index is untouched by the fold below it" assert=
  dup root>> children>> 0 #nth
  dup label>> "abd" "the surviving key becomes one label again" assert=
  value>> unwrap 2 "carrying its own value" assert=
  "abd" radix-lookup? unwrap 2 "the surviving key reads back" assert=
] ;

test-delete-empty-key: ( -- ) [
  string <radix-tree> "" 7 radix-insert "abc" 1 radix-insert
  "" radix-delete
  assert-compressed
  dup count>> 1 "the root's own entry is one entry to remove" assert=
  dup "" radix-lookup? option:some? "the empty key is gone" assert-false
  dup "abc" radix-lookup? unwrap 1 "the root keeps the child below it" assert=
  "zzz" radix-longest? option:some? "nothing covers a key the root no longer does" assert-false
] ;

test-delete-keeps-fork: ( -- ) [
  \ The arm where a valueless node legitimately survives, because it still forks two ways.
  string <radix-tree>
  "a" 1 radix-insert
  "ab" 2 radix-insert
  "ac" 3 radix-insert
  "a" radix-delete
  assert-compressed
  dup count>> 2 "only the forking key goes" assert=
  dup root>> children>> 0 #nth
  dup value>> option:some? "the fork keeps no value of its own" assert-false
  index>> "bc" "and keeps both children" assert=
  dup "ab" radix-lookup? unwrap 2 "one arm reads back" assert=
  dup "ac" radix-lookup? unwrap 3 "the other arm reads back" assert=
  "axx" radix-longest? option:some? "and the deleted key covers nothing" assert-false
] ;

test-delete-last-entry: ( -- ) [
  string <radix-tree> "only" 1 radix-insert "only" radix-delete
  assert-compressed
  dup string <radix-tree> "the last entry leaves the tree as it started" assert=
  "only" 1 radix-insert
  string <radix-tree> "only" 1 radix-insert
  "and rebuilding from there gives the tree back" assert=
  byte-array <radix-tree> B{ 0x61 } 1 radix-insert B{ 0x61 } radix-delete
  byte-array <radix-tree>
  "the byte twin empties its index in its own type" assert=
] ;

test-delete-leaves-prior-version: ( -- ) [
  string <radix-tree> "a" 1 radix-insert "ab" 2 radix-insert
  dup "ab" radix-delete
  swap "ab" radix-lookup? unwrap 2 "the tree deleted from still answers the key" assert=
  "ab" radix-lookup? option:some? "the returned tree does not" assert-false
] ;

test-delete-merges-into-parent: ( -- ) [
  string <radix-tree> "a" 1 radix-insert "ab" 2 radix-insert
  "a" radix-delete
  assert-compressed
  dup count>> 1 "the parent key goes" assert=
  dup root>> children>> 0 #nth
  dup label>> "ab" "the two edges become one label" assert=
  value>> unwrap 2 "carrying the surviving value" assert=
  "ab" radix-lookup? unwrap 2 "the merged key reads back" assert=
] ;

test-delete-missing-key: ( -- ) [
  roman-fixture
  dup dup "ro" radix-delete = "a key ending partway along a label is not there" assert-true
  dup dup "romanx" radix-delete = "an extension of an entry is not there" assert-true
  dup dup "zzz" radix-delete = "a first unit outside the index is not there" assert-true
  "ro" radix-delete count>> 3 "and none of them moves the count" assert=
  string <radix-tree> dup "q" radix-delete = "deleting from an empty tree is a no-op" assert-true
] ;

test-delete-multibyte-index: ( -- ) [
  \ The index unit spliced out here is two bytes but one character. `#index-of` reports a
  \ codepoint index and `#slice` takes one, so the splice cuts between characters rather
  \ than inside one.
  string <radix-tree>
  "café" 1 radix-insert
  "cafè" 2 radix-insert
  "cafê" 3 radix-insert
  "cafè" radix-delete
  assert-compressed
  dup count>> 2 "only the deleted key goes" assert=
  dup root>> children>> 0 #nth index>> "éê" "the index keeps both survivors whole" assert=
  dup "café" radix-lookup? unwrap 1 "one survivor reads back" assert=
  "cafê" radix-lookup? unwrap 3 "the other reads back" assert=
] ;

\ --- Insert and exact lookup ---

test-insert-adds-entry: ( -- ) [
  "insert" test-section
  string <radix-tree> "abc" 1 radix-insert
  dup count>> 1 "one insert is one entry" assert=
  dup "abc" radix-lookup? unwrap 1 "the key reads back its value" assert=
  dup "ab" radix-lookup? option:some? "a proper prefix is not an exact hit" assert-false
  "abcd" radix-lookup? option:some? "an extension is not an exact hit" assert-false
] ;

test-insert-empty-key: ( -- ) [
  string <radix-tree> "" 7 radix-insert
  dup count>> 1 "the empty key is an entry" assert=
  "" radix-lookup? unwrap 7 "the empty key reads back from the root" assert=
] ;

test-insert-keeps-index-sorted: ( -- ) [
  string <radix-tree>
  "c" 3 radix-insert
  "a" 1 radix-insert
  "b" 2 radix-insert
  root>> index>> "abc" "out-of-order inserts leave an ascending index" assert=
] ;

test-insert-leaves-prior-version: ( -- ) [
  string <radix-tree> "a" 1 radix-insert
  dup "ab" 2 radix-insert
  swap "ab" radix-lookup? option:some? "the tree inserted into is unchanged" assert-false
  "ab" radix-lookup? unwrap 2 "the returned tree carries the new entry" assert=
] ;

test-insert-replaces-value: ( -- ) [
  string <radix-tree>
  "k" 1 radix-insert
  "k" 2 radix-insert
  dup count>> 1 "replacing a key adds no entry" assert=
  "k" radix-lookup? unwrap 2 "the later value wins" assert=
] ;

\ --- Iteration ---

test-iter-after-a-merge: ( -- ) [
  "iteration" test-section
  \ A delete folds two edges into one label. A key is spelled out of the labels along its path,
  \ so the merged one has to read back whole.
  string <radix-tree>
  "a" 1 radix-insert
  "ab" 2 radix-insert
  "a" radix-delete
  >iterator entry-keys { "ab" } "a key spanning a merged label reads back whole" assert=
] ;

test-iter-byte-keys: ( -- ) [
  byte-array <radix-tree>
  B{ 0x80 0x61 } 1 radix-insert
  B{ 0x01 } 2 radix-insert
  >iterator entry-keys
  { B{ 0x01 } B{ 0x80 0x61 } } "byte keys come in ascending byte order" assert=
] ;

test-iter-empty-tree: ( -- ) [
  string <radix-tree> >iterator #collect { } "an empty tree yields no entries" assert=
] ;

test-iter-is-fresh-per-call: ( -- ) [
  roman-fixture
  dup >iterator 1 #take entry-keys { "rom" } "a partial take reads the smallest key" assert=
  dup >iterator entry-keys { "rom" "roman" "romulus" } "a later iterator is fresh" assert=
  count>> 3 "iteration leaves the tree unchanged" assert=
] ;

test-iter-orders-keys: ( -- ) [
  route-fixture
  dup >iterator entry-keys
  { "/" "/api/" "/api/v1/" } "entries come in key order, a prefix ahead of what extends it" assert=
  >iterator entry-values { 0 1 2 } "each key carries its own value" assert=
] ;

test-iter-passes-forks: ( -- ) [
  \ "ab" forks two ways and holds no value. A node with no entry of its own costs a step
  \ rather than an element.
  string <radix-tree>
  "abc" 1 radix-insert
  "abd" 2 radix-insert
  "" 3 radix-insert
  >iterator entry-keys
  { "" "abc" "abd" } "the empty key leads and the fork yields nothing of its own" assert=
] ;

test-iter-wide-fork: ( -- ) [
  \ A fork wider than the two-way ones above. Children go onto the pending stack largest first,
  \ so the count of them is what the push loop turns on.
  string <radix-tree>
  "c" 3 radix-insert
  "a" 1 radix-insert
  "d" 4 radix-insert
  "b" 2 radix-insert
  dup >iterator entry-keys { "a" "b" "c" "d" } "a four-way fork yields every branch in order" assert=
  >iterator entry-values { 1 2 3 4 } "each branch carries its own value" assert=
] ;

\ --- Longest prefix ---

test-longest-empty-key-covers-all: ( -- ) [
  "longest prefix" test-section
  string <radix-tree> "" 7 radix-insert
  "anything" radix-longest? unwrap 7 "an entry under the empty key is a prefix of every key" assert=
] ;

test-longest-none-without-match: ( -- ) [
  string <radix-tree> "/api/" 1 radix-insert
  dup "/other" radix-longest? option:some? "an unmatched key has no prefix" assert-false
  "/api" radix-longest? option:some? "a key short of the entry has no prefix" assert-false
] ;

test-longest-picks-deepest: ( -- ) [
  route-fixture
  dup "/api/v1/users" radix-longest? unwrap 2 "the deepest matching prefix wins" assert=
  dup "/api/users" radix-longest? unwrap 1 "a key short of the deeper prefix takes the shallower" assert=
  dup "/other" radix-longest? unwrap 0 "the catch-all covers what nothing else does" assert=
  "/api/" radix-longest? unwrap 1 "an exact key is its own longest prefix" assert=
] ;

\ --- Key type mismatch ---

test-mismatch-delete-throws: ( -- ) [
  "key type mismatch" test-section
  [ string <radix-tree> "x" >bytes radix-delete ] type-mismatch:
  "a byte key into a string tree is rejected" assert-error-type
  [ byte-array <radix-tree> "x" radix-delete ] type-mismatch:
  "a string key into a byte tree is rejected" assert-error-type
] ;

test-mismatch-insert-throws: ( -- ) [
  [ string <radix-tree> "x" >bytes 1 radix-insert ] type-mismatch:
  "a byte key into a string tree is rejected" assert-error-type
  [ byte-array <radix-tree> "x" 1 radix-insert ] type-mismatch:
  "a string key into a byte tree is rejected" assert-error-type
] ;

test-mismatch-lookup-throws: ( -- ) [
  [ string <radix-tree> "x" >bytes radix-lookup? ] type-mismatch:
  "an exact lookup checks the key type" assert-error-type
  [ string <radix-tree> "x" >bytes radix-longest? ] type-mismatch:
  "a longest-prefix lookup checks the key type" assert-error-type
] ;

\ --- Protocol methods ---

test-protocol-array-method: ( -- ) [
  "protocol methods" test-section
  string <radix-tree> >array { } ">array of an empty tree is the empty array" assert=
  route-fixture >array [ key>> ] #map #collect
  { "/" "/api/" "/api/v1/" } ">array materializes every entry in key order" assert=
] ;

test-protocol-empty: ( -- ) [
  string <radix-tree> #empty? "a fresh tree is empty" assert-true
  string <radix-tree> "" 1 radix-insert #empty?
  "an entry under the empty key still makes a tree non-empty" assert-false
  route-fixture #empty? "and so does any other entry" assert-false
] ;

test-protocol-first-and-last: ( -- ) [
  roman-fixture
  dup #first dup key>> "rom" "#first is the smallest key" assert=
  value>> 2 "carrying the value stored under it" assert=
  #last dup key>> "romulus" "#last is the largest key" assert=
  value>> 3 "carrying its own value" assert=
  [ string <radix-tree> #first ] empty-sequence: "#first on an empty tree throws" assert-error-type
  [ string <radix-tree> #last ] empty-sequence: "#last on an empty tree throws" assert-error-type
] ;

test-protocol-first-and-last-twins: ( -- ) [
  \ The option twins recover around the throwing form, and recover keeps whatever the failed
  \ quotation left behind. A peek that threw with the tree still up would leak it here.
  string <radix-tree> #first? option:none? "#first? on an empty tree is none" assert-true
  string <radix-tree> #last? option:none? "#last? on an empty tree is none" assert-true
  route-fixture
  dup #first? unwrap key>> "/" "#first? wraps the smallest entry" assert=
  #last? unwrap key>> "/api/v1/" "#last? wraps the largest" assert=
] ;

test-protocol-len: ( -- ) [
  string <radix-tree> #len 0 "#len of a fresh tree is 0" assert=
  route-fixture #len 3 "#len counts every entry" assert=
  route-fixture "/api/" radix-delete #len 2 "#len follows a delete" assert=
  route-fixture "/api/" 9 radix-insert #len 3 "replacing a key does not move it" assert=
  route-fixture >iterator #count 3 "and a drained #count agrees with it" assert=
] ;

test-protocol-nth-is-not-registered: ( -- ) [
  [ route-fixture 0 #nth ] "#nth on a radix tree throws" assert-error
] ;

\ --- Edge splitting ---

test-split-forks-into-two-children: ( -- ) [
  "edge splitting" test-section
  string <radix-tree>
  "roman" 1 radix-insert
  "roast" 2 radix-insert
  dup root>> children>> 0 #nth
  dup label>> "ro" "the split node keeps the shared units" assert=
  dup value>> option:some? "a fork point holds no value of its own" assert-false
  index>> "am" "the two divergent units index in ascending order" assert=
  dup "roman" radix-lookup? unwrap 1 "the split key still reads back" assert=
  "roast" radix-lookup? unwrap 2 "the forked key reads back" assert=
] ;

test-split-lands-on-interior-key: ( -- ) [
  roman-fixture
  dup root>> children>> 0 #nth
  dup label>> "rom" "the interior key becomes the node's own label" assert=
  value>> unwrap 2 "the interior node carries the key that split it" assert=
  "rom" radix-lookup? unwrap 2 "the interior key reads back exactly" assert=
] ;

test-split-preserves-deeper-entries: ( -- ) [
  roman-fixture
  dup count>> 3 "each distinct key counts once through the splits" assert=
  dup "roman" radix-lookup? unwrap 1 "the key that was split reads back" assert=
  dup "romulus" radix-lookup? unwrap 3 "the key added below the split reads back" assert=
  dup "ro" radix-lookup? option:some? "the shared units alone are not an entry" assert-false
  "romanx" radix-longest? unwrap 1 "a deeper key falls back to the entry above it" assert=
] ;

\ --- Prefix enumeration ---

test-under-byte-prefix: ( -- ) [
  "prefix enumeration" test-section
  byte-array <radix-tree>
  B{ 0x80 0x61 } 1 radix-insert
  B{ 0x80 0x62 } 2 radix-insert
  B{ 0x01 } 3 radix-insert
  B{ 0x80 } radix-under entry-values { 1 2 } "a byte prefix takes its own subtree" assert=
] ;

test-under-covers-a-valueless-fork: ( -- ) [
  \ "ab" forks two ways and holds no value, so the cover contributes no entry of its own.
  string <radix-tree>
  "abc" 1 radix-insert
  "abd" 2 radix-insert
  "b" 3 radix-insert
  "ab" radix-under entry-keys { "abc" "abd" } "a fork covers its own branch and no more" assert=
] ;

test-under-empty-prefix-takes-all: ( -- ) [
  route-fixture "" radix-under entry-keys
  { "/" "/api/" "/api/v1/" } "the empty prefix covers the whole tree" assert=
] ;

test-under-includes-an-exact-key: ( -- ) [
  route-fixture "/api/" radix-under entry-keys
  { "/api/" "/api/v1/" } "a prefix that is itself an entry is one of its own results" assert=
] ;

test-under-is-lazy: ( -- ) [
  route-fixture
  dup "/" radix-under type-of iterator "the result is an iterator, not a materialized array" assert=
  dup "/" radix-under 1 #take entry-keys { "/" } "a partial take reads only what it asked for" assert=
  "/" radix-under entry-keys { "/" "/api/" "/api/v1/" } "a later call is fresh" assert=
] ;

test-under-mismatched-key-type-throws: ( -- ) [
  [ string <radix-tree> "x" >bytes radix-under ] type-mismatch:
  "prefix enumeration checks the key type" assert-error-type
] ;

test-under-splits-mid-label: ( -- ) [
  \ "/api" ends partway along the "/api/" edge, so the cover is the child below the break and
  \ every key under it opens with the whole prefix.
  route-fixture "/api" radix-under entry-keys
  { "/api/" "/api/v1/" } "a prefix ending inside a label covers that whole edge" assert=
] ;

test-under-stops-at-a-character: ( -- ) [
  string <radix-tree>
  "café" 1 radix-insert
  "cafét" 2 radix-insert
  "cafè" 3 radix-insert
  "café" radix-under entry-keys
  { "café" "cafét" } "a prefix ending on a multibyte character takes only its own branch" assert=
] ;

test-under-without-a-match: ( -- ) [
  route-fixture
  dup "/other" radix-under #collect { } "a diverging prefix covers nothing" assert=
  "/api/v2/" radix-under #collect { } "a prefix diverging below a fork covers nothing" assert=
  string <radix-tree> dup "x" radix-under #collect { } "an empty tree covers nothing" assert=
  "" radix-under #collect { } "not even under the empty prefix" assert=
] ;
