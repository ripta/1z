\ lib/ffi-gen.1z - FFI binding generator
\
\ Generates 1z FFI bindings from C headers by parsing
\ zig translate-c output.

use "process" ;
use "strings" ;

\\ Run zig translate-c on a C header file and return its Zig source output.
\\ flags is an array of additional CLI flags (e.g., { "-I" "/usr/include" }).
\\ Throws on non-zero exit.
translate-c: ( header-path flags -- zig-source ) [
  { "zig" "translate-c" } swap #append
  swap 1array #append
  <stdio-opts> capture-all
  dup exit-code>> 0 =
  [ stdout>> bytes> ]
  [ stderr>> bytes>
    "zig translate-c failed: " swap #append
    f swap EUserThrown make-error throw
  ]
  if
] ;

\ --- Type mapping ---

\\ Map a Zig type string from translate-c output to a 1z FFI type string.
\\ Returns the mapped type, or the input unchanged if no mapping exists
\\ for simple types. Pointer types are handled structurally.
zig>ffi-type: ( zig-type -- ffi-type ) [
  \ Pointer types: [*c]const u8 and [*c]u8 → cstring
  dup "[*c]const u8" = [ drop "cstring" ] [
    dup "[*c]u8" = [ drop "cstring" ] [
      \ Opaque pointer: ?*name → ptr:name
      dup "?*" #starts-with? [
        2 #drop "ptr:" swap #append
      ] [
        \ Non-opaque pointer: [*c]T → ptr
        dup "[*c]" #starts-with? [ drop "ptr" ] [
          \ Simple type lookup
          (zig-simple-type)
        ] if
      ] if
    ] if
  ] if
] ;

(zig-simple-type): ( zig-type -- ffi-type ) [
  dup "c_int" = [ drop "i32" ] [
    dup "c_uint" = [ drop "u32" ] [
      dup "c_short" = [ drop "i16" ] [
        dup "c_ushort" = [ drop "u16" ] [
          dup "c_long" = [ drop "i64" ] [
            dup "c_ulong" = [ drop "u64" ] [
              dup "c_longlong" = [ drop "i64" ] [
                dup "c_ulonglong" = [ drop "u64" ] [
                  dup "c_longdouble" = [ drop "f128" ] [
                    \ i8..i64, u8..u64, f32, f64, usize, isize, bool, void
                    \ pass through unchanged
                  ] if
                ] if
              ] if
            ] if
          ] if
        ] if
      ] if
    ] if
  ] if
] ;

\ --- Function parameter parsing ---

\\ Parse a single "name: type" parameter string into a hash.
\\ Returns f if the parameter cannot be parsed (e.g., partial fn pointer).
(parse-param): ( param-str -- hash/f ) [
  trim
  ": " split-once?
  dup option:some? [
    option:some>
    dup 0 #nth swap 1 #nth
    zig>ffi-type
    swap
    \ Strip @"..." quoting from parameter names (zig translate-c
    \ quotes names that are Zig keywords)
    dup "@\"" #starts-with? [
      2 #drop
      dup #len 1 - #take  \ strip trailing "
    ] when
    M{ } swap name: swap @set! swap type: swap @set!
  ] [
    drop f
  ] if
] ;

\\ Parse the parameter list string (between parens) into an array of
\\ param hashes and a variadic flag.
(parse-params): ( params-str -- params variadic? ) [
  ", " split
  \ Check for variadic: last element is "..."
  dup #last "..." = [
    dup #len 1 - #take t
  ] [
    f
  ] if
  \ Stack: params-array variadic?
  \ Move variadic? below so we can work on the array
  swap
  \ Filter out empty params (e.g., void functions)
  [ trim #len 0 > ] #filter #collect
  \ Parse each param; filter out f (unparseable, e.g., fn pointer fragments)
  [ (parse-param) ] #map #collect
  [ f = not ] #filter #collect
  swap
] ;

\ --- Function declaration parsing ---

\\ Split a string on the last occurrence of a delimiter.
\\ Returns { before after }.
(rsplit-once): ( str delim -- pair ) [
  2dup split
  \ Stack: str delim parts
  dup #len 1 = [
    \ No delimiter found
    -rot> 2drop
    "" 2 array-n
  ] [
    \ Last element is after the final delimiter
    dup #last swap
    dup #len 1 - #take
    \ Rejoin everything before the last delimiter
    2 pick-n #join
    \ Stack: str delim before after
    swap 2 array-n
    -rot> 2drop
  ] if
] ;

\\ Parse a "pub extern fn" line into a declaration hash.
\\ Input: "pub extern fn toy_add(a: c_int, b: c_int) c_int;"
(parse-fn-decl): ( line -- decl ) [
  \ Strip "pub extern fn " prefix (14 chars)
  14 #drop

  \ Split on first "(" to get name and rest
  "(" split-once
  dup 0 #nth swap 1 #nth

  \ rest contains params and possibly nested parens from fn pointer types
  \ Split on the LAST ")" to correctly handle nested parens
  ")" (rsplit-once)
  dup 0 #nth swap 1 #nth

  \ return-type part is " c_int;", so trim and strip trailing ";"
  trim
  dup #len 1 - #take  \ strip ";"
  trim
  zig>ffi-type

  \ Stack: name params-str return-type
  swap (parse-params)

  \ Stack: name return-type params variadic?
  M{ }
  fn: kind: swap @set!
  swap variadic?: swap @set!
  swap params: swap @set!
  swap return-type: swap @set!
  swap name: swap @set!
] ;

\ --- Struct declaration parsing ---

\\ Parse a struct field line like "    x: f32 = @import(...),"
\\ into a { name: type: } hash.
(parse-struct-field): ( line -- hash ) [
  trim
  \ Strip trailing comma if present
  dup #last "," = [ dup #len 1 - #take ] when

  \ Split on " = " to strip default initializer
  " = " split-once? dup option:some?
  [ option:some> 0 #nth ]
  [ drop ]
  if

  \ Now we have "x: f32", so split on ": "
  ": " split-once
  dup 0 #nth swap 1 #nth
  zig>ffi-type
  swap
  M{ } swap name: swap @set! swap type: swap @set!
] ;

\\ Parse a struct block starting at index i in lines.
\\ The line at i is "pub const name = extern struct {".
\\ Returns the declaration hash and the index past the closing "};".
(parse-struct-decl): ( lines i -- decl next-i ) [
  2dup #nth

  \ Extract struct name from "pub const name = extern struct {"
  10 #drop
  " = extern struct {" split-once
  0 #nth  \ struct name

  \ Stack: lines i struct-name
  \ Advance i past the opening line, stash name below
  swap 1 + swap

  \ Stack: lines i+1 struct-name
  \ Collect fields into a vector
  V{ }

  \ Stack: lines i struct-name fields-vec
  \ Use dip to keep fields-vec on top while accessing lines/i
  (collect-struct-fields)

  \ Stack: lines next-i struct-name fields-vec
  >array
  M{ }
  struct: kind: swap @set!
  swap fields: swap @set!
  swap name: swap @set!

  \ Stack: lines next-i decl
  \ Return ( next-i decl ), drop lines
  <rot- drop
] ;

\\ Collect struct fields from lines starting at index i.
\\ Reads lines until "};" and advances i past it.
\\ Stack: lines i name fields-vec
\\ After: lines next-i name fields-vec
(collect-struct-fields): [
  \ Check if current line is "};"
  [ 3 pick-n 3 pick-n #nth trim "};" = not ] [
    \ Get current line
    3 pick-n 3 pick-n #nth
    (parse-struct-field)
    over swap #push! drop
    \ Advance i: swap name and i, increment, swap back
    [ [ 1 + ] dip ] dip
  ] while
  \ Advance past "};"
  [ [ 1 + ] dip ] dip
] ;

\\ Parse an opaque type line into a declaration hash.
\\ Input: "pub const struct_toy_counter = opaque {};"
(parse-opaque-decl): ( line -- decl ) [
  \ Strip "pub const " prefix (10 chars)
  10 #drop
  " = opaque {};" split-once 0 #nth
  M{ }
  opaque: kind: swap @set!
  swap name: swap @set!
] ;

\ --- Enum declaration parsing ---

\\ Parse an enum variant line like "    ALIGN_LEFT = 0,"
\\ into a { name: value: } hash. Returns f for the catch-all "_," line.
(parse-enum-variant): ( line -- hash/f ) [
  trim
  \ Strip trailing comma
  dup #last "," = [ dup #len 1 - #take ] when
  trim

  \ Skip the "_" catch-all
  dup "_" = [ drop f ] [
    " = " split-once
    dup 0 #nth swap 1 #nth
    swap
    M{ } swap name: swap @set! swap value: swap @set!
  ] if
] ;

\\ Parse an enum block starting at index i in lines.
\\ The line at i is "pub const name = enum(c_int) {".
\\ Returns the declaration hash and the index past the closing "};".
(parse-enum-decl): ( lines i -- decl next-i ) [
  2dup #nth

  \ Extract enum name from "pub const name = enum(c_int) {"
  10 #drop
  " = enum(c_int) {" split-once
  0 #nth  \ enum name

  \ Stack: lines i enum-name
  \ Advance i past the opening line
  swap 1 + swap

  \ Stack: lines i+1 enum-name
  V{ }

  \ Stack: lines i enum-name variants-vec
  (collect-enum-variants)

  \ Stack: lines next-i enum-name variants-vec
  >array
  M{ }
  enum: kind: swap @set!
  swap variants: swap @set!
  swap name: swap @set!

  \ Stack: lines next-i decl
  \ Return ( next-i decl ), drop lines
  <rot- drop
] ;

\\ Collect enum variants from lines starting at index i.
\\ Stack: lines i name variants-vec
\\ After: lines next-i name variants-vec
(collect-enum-variants): [
  [ 3 pick-n 3 pick-n #nth trim "};" = not ] [
    3 pick-n 3 pick-n #nth
    (parse-enum-variant)
    dup [ over swap #push! drop ] [ drop ] if
    [ [ 1 + ] dip ] dip
  ] while
  \ Advance past "};"
  [ [ 1 + ] dip ] dip
] ;

\ --- Line classification helpers ---

(line-contains?): ( line str -- ? ) [
  #index-of f = not
] ;

\ --- Top-level parser ---

\\ Parse pre-filtered Zig translate-c output into declaration hashes.
\\ The input should contain only declaration-relevant lines; use
\\ translate-c-decls for end-to-end header parsing.
parse-zig-decls: ( zig-source -- decls ) [
  "\n" split
  V{ } swap  \ results lines
  0
  \ Stack throughout: results lines i
  [ dup 2 pick-n #len < ] [
    1 pick-n over #nth
    (dispatch-line)
  ] while
  drop drop  \ drop i and lines
  >array
] ;

\\ Run zig translate-c on a header, pre-filter the output through awk to
\\ keep only declaration-relevant lines, and parse into declaration
\\ hashes. The awk pre-filter is ~35-50x faster than feeding the full
\\ ~6000-line translate-c output through parse-zig-decls in 1z, or
\\ replicating the filter in 1z; see tests/benchmark/ffi_gen_filter.1z.
translate-c-decls: ( header-path flags -- decls ) [
  (translate-c-filtered)
  parse-zig-decls
] ;

\\ Run zig translate-c piped through awk to keep only declaration lines.
\\ Returns a string with only pub extern fn, pub const, struct/enum
\\ field lines, and closing "};".
(translate-c-filtered): ( header-path flags -- filtered-source ) [
  \ Build: zig translate-c <flags> <header> | awk '<filter>'
  { "zig" "translate-c" } swap #append
  swap 1array #append
  " " #join
  " | awk '/^pub extern fn /{print} /^pub const .* = (extern struct |opaque \\{\\}|enum\\(c_int\\) )/{b=1} b{print} /^\\};/{b=0}'" #append
  >shell-safe unmake-shell-safe
  1array
  { "/bin/sh" "-c" } swap #append
  <stdio-opts> capture-stdout
  dup exit-code>> dup 0 = swap 1 = or
  [ stdout>> dup [ bytes> ] [ drop "" ] if ]
  [ stderr>> dup [ bytes> ] [ drop "" ] if
    "translate-c filtering failed: " swap #append
    f swap EUserThrown make-error throw
  ]
  if
] ;

\ --- Emission: declaration hash → 1z FFI source ---

\\ Convert a C snake_case name to 1z kebab-case.
(c-name>kebab): ( c-name -- kebab-name ) [
  "_" split "-" #join
] ;

\\ Emit a struct declaration hash as 1z ffi-struct{ syntax.
\\ Example: "toy_vec2: ffi-struct{ x: f32 y: f32 } ;"
(struct-decl>ffi-binding): ( decl -- str ) [
  dup name: @get ": ffi-struct{ " #append
  swap fields: @get
  [ dup name: @get ": " #append swap type: @get #append ] #map #collect
  " " #join
  #append
  " } ;" #append
] ;

\\ Emit an enum declaration hash as 1z const words.
\\ Example: "ALIGN_LEFT: const [ 0 ] ;\nALIGN_RIGHT: const [ 1 ] ;"
(enum-decl>ffi-binding): ( decl -- str ) [
  variants: @get
  [ dup name: @get ": const [ " #append swap value: @get #append " ] ;" #append ] #map #collect
  "\n" #join
] ;

\\ Emit an opaque type declaration hash as a comment.
\\ Example: "\ opaque: struct_toy_counter"
(opaque-decl>ffi-binding): ( decl -- str ) [
  name: @get "\\ opaque: " swap #append
] ;

\\ Emit a function declaration hash as an ffi-def{ entry line.
\\ Example: "  toy-add: \"toy_add\" ffi{ i32 i32 -> i32 }"
(fn-decl>ffi-binding): ( decl -- str ) [
  \ Stack: decl
  dup dup word-name: @has?
  [ word-name: @get ]
  [ name: @get (c-name>kebab) ]
  if

  \ Build: "  word-name: \"c_name\" ffi{ "
  "  " swap #append ": " #append
  "\"" #append over name: @get #append "\" ffi{ " #append

  \ Stack: decl result-str
  \ Build param types
  over params: @get
  [ type: @get ] #map #collect
  " " #join

  \ Stack: decl result-str params-joined
  \ Variadic?
  2 pick-n variadic?: @get [
    dup #len 0 > [ " ..." #append ] [ drop "..." ] if
  ] when

  \ Append params and return type
  dup #len 0 > [ " " #append #append ] [ drop ] if
  "-> " #append
  swap return-type: @get #append
  " }" #append
] ;

\\ Emit a function binding with TODO annotations for bare ptr parameters.
\\ If any parameter has type exactly "ptr", appends a comment listing
\\ those parameter names for manual out-param review.
(fn-decl>ffi-binding+todo): ( decl -- str ) [
  dup (fn-decl>ffi-binding)
  swap params: @get
  [ type: @get "ptr" = ] #filter #collect
  dup #len 0 > [
    [ name: @get ] #map #collect ", " #join
    "  \\ TODO: check if out-param: " swap #append
    #append
  ] [ drop ] if
] ;

\\ Convert a single declaration hash to 1z FFI syntax.
\\ Dispatches on the kind: field.
decl>ffi-binding: ( decl -- str ) [
  dup kind: @get
  dup fn: = [ drop (fn-decl>ffi-binding+todo) ] [
    dup struct: = [ drop (struct-decl>ffi-binding) ] [
      dup enum: = [ drop (enum-decl>ffi-binding) ] [
        dup opaque: = [ drop (opaque-decl>ffi-binding) ] [
          inspect "unknown declaration kind: " swap #append
          f swap EUserThrown make-error throw
        ] if
      ] if
    ] if
  ] if
] ;

\\ Classify a line and dispatch to the appropriate parser.
\\ Stack: results lines i line
\\ After: results lines i' (i' advanced appropriately)
(dispatch-line): [
  dup "pub extern fn " #starts-with? [
    \ Single-line function declaration
    (parse-fn-decl)
    \ Stack: results lines i decl
    3 pick-n swap #push! drop
    1 +
  ] [
    dup " = extern struct {" (line-contains?) [
      drop
      \ Stack: results lines i
      1 pick-n over  \ results lines i lines i
      (parse-struct-decl)
      \ Stack: results lines i next-i decl
      4 pick-n swap #push! drop
      \ Stack: results lines i next-i
      swap drop  \ results lines next-i
    ] [
      dup " = opaque {};" (line-contains?) [
        (parse-opaque-decl)
        \ Stack: results lines i decl
        3 pick-n swap #push! drop
        1 +
      ] [
        dup " = enum(c_int) {" (line-contains?) [
          drop
          1 pick-n over
          (parse-enum-decl)
          \ Stack: results lines i next-i decl
          4 pick-n swap #push! drop
          swap drop
        ] [
          \ Not a recognized declaration, so skip
          drop
          1 +
        ] if
      ] if
    ] if
  ] if
] ;

\ --- Header-origin filtering ---

\\ Read the entire contents of a file as a string.
(read-file-text): ( path -- text ) [
  read: stream-open dup stream-read-all swap stream-close bytes>
] ;

\\ Check if a declaration's name appears in the header text.
\\ Handles the struct_ prefix that zig translate-c adds for opaque types
\\ (e.g., struct_toy_counter for a C typedef struct toy_counter).
(decl-in-header?): ( decl header-text -- ? ) [
  swap name: @get
  \ Stack: header-text name
  2dup #index-of f = not [
    2drop t
  ] [
    \ Try stripping struct_ prefix
    dup "struct_" #starts-with? [
      7 #drop
      #index-of f = not
    ] [ 2drop f ] if
  ] if
] ;

\\ Filter declarations to those whose names appear in the header text.
(filter-to-header): ( decls header-path -- decls' ) [
  (read-file-text)
  [ (decl-in-header?) ] curry
  #filter #collect
] ;

\ --- End-to-end binding generation ---

\\ Strip a prefix from the start of a string.
\\ Returns the string unchanged if it does not start with the prefix.
(strip-prefix): ( name prefix -- name' ) [
  2dup #starts-with?
  [ #len #drop ]
  [ drop ]
  if
] ;

\\ Apply strip-prefix to a single function declaration.
\\ Strips prefix from name:, kebab-cases it, stores as word-name:.
\\ Non-fn decls are returned unchanged.
(strip-prefix-one): ( decl prefix -- decl ) [
  swap
  dup kind: @get fn: = [
    dup name: @get 2 pick-n (strip-prefix) (c-name>kebab)
    word-name: swap @set!
    swap drop
  ] [
    swap drop
  ] if
] ;

\\ Apply strip-prefix to all function declarations in an array.
\\ For each fn: decl, strips the prefix from name:, kebab-cases it,
\\ and stores the result as word-name:. Non-fn decls are unchanged.
(apply-strip-prefix): ( decls prefix -- decls ) [
  [ (strip-prefix-one) ] curry #map #collect
] ;

\\ Emit a section of declarations as a newline-joined string.
\\ Returns "" for an empty input array.
(emit-section): ( decls -- str ) [
  dup #len 0 = [ drop "" ] [
    [ decl>ffi-binding ] #map #collect "\n" #join
  ] if
] ;

\\ Wrap function binding strings in a lib-open ffi-def{ module block.
\\ lib-name is used for lib-open and the module name (lib-name + "-raw").
(emit-ffi-def-block): ( fn-decls lib-name -- str ) [
  swap
  dup #len 0 = [ 2drop "" ] [
    [ decl>ffi-binding ] #map #collect "\n" #join
    \ Stack: lib-name fns-str
    over
    \ Stack: lib-name fns-str lib-name
    "\"" swap #append "\" lib-open ffi-def{\n" #append
    \ Stack: lib-name fns-str header
    swap #append
    \ Stack: lib-name body (header + fns-str)
    swap "\n} call \"" swap #append "-raw\" swap >module import" #append
    \ Stack: body footer
    #append
  ] if
] ;

\\ Filter empty strings and join non-empty ones with double newlines.
(join-sections): ( sections -- str ) [
  [ #len 0 > ] #filter #collect
  "\n\n" #join
] ;

\\ Generate a complete .1z binding file from a C header.
\\ opts is a hash with optional keys:
\\   flags: -- array of extra CLI flags for zig translate-c (default { })
\\   strip-prefix: -- string prefix to strip from C function names (default f)
generate-bindings: ( header-path lib-name opts -- str ) [
  gb-lib-name: define-parameter [ "" ] ;

  \ Extract options
  dup flags: @has? [ dup flags: @get ] [ { } ] if
  swap dup strip-prefix: @has? [ strip-prefix: @get ] [ drop f ] if
  \ Stack: header-path lib-name tc-flags strip-prefix

  \ Stash lib-name, run translate-c
  swap 3 pick-n swap translate-c-decls
  \ Stack: header-path lib-name strip-prefix decls

  \ Filter to declarations originating from the user's header
  3 pick-n (filter-to-header)

  \ Apply strip-prefix if set
  over [ over (apply-strip-prefix) ] when
  swap drop
  \ Stack: header-path lib-name decls

  \ Stash lib-name via parameter
  swap gb-lib-name [
    swap drop
    \ Stack: decls

    \ Build sections into a vector
    V{ }

    \ Structs
    over [ kind: @get struct: = ] #filter #collect (emit-section)
    dup #len 0 > [ over swap #push! drop ] [ drop ] if

    \ Enums
    over [ kind: @get enum: = ] #filter #collect (emit-section)
    dup #len 0 > [ over swap #push! drop ] [ drop ] if

    \ Opaques
    over [ kind: @get opaque: = ] #filter #collect (emit-section)
    dup #len 0 > [ over swap #push! drop ] [ drop ] if

    \ Functions (wrapped in ffi-def{ block)
    swap [ kind: @get fn: = ] #filter #collect
    gb-lib-name get (emit-ffi-def-block)
    dup #len 0 > [ over swap #push! drop ] [ drop ] if

    \ Join sections
    >array (join-sections)
    "use \"ffi\" ;\n\n" swap #append "\n" #append
  ] with-parameter
] ;
