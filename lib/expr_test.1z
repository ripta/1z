\ Unit tests for the expr{ } surface form in lib/expr.1z.

use "testing" ;
use "expr" ;

"single value" test-section

test-single-number: ( -- ) [
  expr{ 42 } 42 "single number" assert=
] ;

"precedence" test-section

test-mul-binds-under-add: ( -- ) [
  expr{ 1 + 2 * 3 } 1 2 3 * + "1 + 2 * 3 matches 1 2 3 * +" assert=
] ;

test-mul-before-add: ( -- ) [
  expr{ 2 * 3 + 1 } 2 3 * 1 + "2 * 3 + 1 matches 2 3 * 1 +" assert=
] ;

"left associativity" test-section

test-subtraction-left-assoc: ( -- ) [
  expr{ 10 - 3 - 2 } 10 3 - 2 - "10 - 3 - 2 matches 10 3 - 2 -" assert=
] ;

"parentheses" test-section

test-parens-override-precedence: ( -- ) [
  expr{ (1 + 2) * 3 } 1 2 + 3 * "(1 + 2) * 3 matches 1 2 + 3 *" assert=
] ;

test-nested-parens: ( -- ) [
  expr{ ((1 + 2)) } 1 2 + "((1 + 2)) matches 1 2 +" assert=
] ;

"unary minus" test-section

test-unary-minus: ( -- ) [
  expr{ -5 } 5 -1 * "-5 matches 5 -1 *" assert=
] ;

test-unary-minus-in-expr: ( -- ) [
  expr{ -5 + 3 } 5 -1 * 3 + "-5 + 3 matches 5 -1 * 3 +" assert=
] ;

"division" test-section

test-division: ( -- ) [
  expr{ 20 / 4 / 2 } 20 4 / 2 / "20 / 4 / 2 matches 20 4 / 2 /" assert=
] ;

"comparisons" test-section

test-comparison: ( -- ) [
  expr{ 1 < 2 } 1 2 < "1 < 2 matches 1 2 <" assert=
] ;

test-comparison-binds-under-arithmetic: ( -- ) [
  expr{ 1 + 2 < 4 } 1 2 + 4 < "1 + 2 < 4 matches 1 2 + 4 <" assert=
] ;

test-equality: ( -- ) [
  expr{ 20 / 4 = 5 } 20 4 / 5 = "20 / 4 = 5 matches 20 4 / 5 =" assert=
] ;

test-two-character-comparisons: ( -- ) [
  expr{ 5 <= 5 } 5 5 <= "5 <= 5 matches 5 5 <=" assert=
  expr{ 4 >= 9 } 4 9 >= "4 >= 9 matches 4 9 >=" assert=
] ;

"multiline input" test-section

test-multiline: ( -- ) [
  expr{
    1 + 2
    * 3
    - 4
  }
  1 2 3 * + 4 - "multiline expr matches single-line equivalent" assert=
] ;

"public pipeline" test-section

test-parse-expr-lower-reachable: ( -- ) [
  "1 + 2" parse-expr lower call
  1 2 + "parse-expr lower call yields the value" assert=
] ;

"calls" test-section

\ Helper words for call parity. `sub2` is non-commutative, so it also verifies
\ left-to-right argument order.
add1:   ( n -- n )   [ 1 + ] ;
dbl:    ( n -- n )   [ 2 * ] ;
sub2:   ( a b -- c ) [ - ] ;
answer: ( -- n )     [ 42 ] ;

test-call-single-arg: ( -- ) [
  expr{ add1(41) } 41 add1 "add1(41) matches 41 add1" assert=
] ;

test-call-arg-is-expression: ( -- ) [
  expr{ add1(2 * 3) } 2 3 * add1 "add1(2 * 3) matches 2 3 * add1" assert=
] ;

test-call-multi-arg-order: ( -- ) [
  expr{ sub2(10, 3) } 10 3 sub2 "sub2(10, 3) matches 10 3 sub2 (left-to-right)" assert=
] ;

test-call-multi-arg-expressions: ( -- ) [
  expr{ sub2(1 + 2, 3 + 4) } 1 2 + 3 4 + sub2 "sub2(1 + 2, 3 + 4) matches 1 2 + 3 4 + sub2" assert=
] ;

test-call-zero-arg: ( -- ) [
  expr{ answer() } answer "answer() matches answer" assert=
] ;

test-call-nested: ( -- ) [
  expr{ add1(dbl(3)) } 3 dbl add1 "add1(dbl(3)) matches 3 dbl add1" assert=
] ;

test-call-precedence: ( -- ) [
  expr{ add1(1 + 2) * dbl(3) } 1 2 + add1 3 dbl * "f(1 + 2) * g(3) matches 1 2 + f 3 g *" assert=
] ;

test-call-inside-arithmetic: ( -- ) [
  expr{ add1(3) + 2 } 3 add1 2 + "add1(3) + 2 matches 3 add1 2 +" assert=
] ;

test-call-inside-comparison: ( -- ) [
  expr{ add1(1) > dbl(1) } 1 add1 1 dbl > "add1(1) > dbl(1) matches 1 add1 1 dbl >" assert=
] ;

\ A call resolves through ordinary lookup, so a callee defined after the expr{
\ use still works: the emitted call_word is resolved at run time.
test-call-forward-reference: ( -- ) [
  expr{ fwd7(5) } 5 fwd7 "fwd7(5) resolves a forward-referenced callee" assert=
] ;

fwd7: ( n -- n ) [ 2 + ] ;
