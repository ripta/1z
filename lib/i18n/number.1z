\ lib/i18n/number.1z - Locale-aware number formatting and parsing
\
\ Provides format-number, format-decimal, format-percent,
\ format-number-pattern, and parse-number via ICU's unum_* API.

use "ffi" ;
use "i18n/icu" ;
use "i18n/locale" ;

\ --- Library loading and FFI bindings ---

sys-info "os" @get "macos" = [
  "icucore" lib-open
] [
  "icui18n" lib-open
] if

ffi-def{
  (unum-open):          "unum_open" ffi{ i32 ptr i32 cstring isize inout-i32 -> ptr }
  (unum-close):         "unum_close" ffi{ ptr -> void }
  (unum-format-double): "unum_formatDouble" ffi{ ptr f64 ptr i32 isize inout-i32 -> i32 }
  (unum-parse-double):  "unum_parseDouble" ffi{ ptr ptr i32 isize inout-i32 -> f64 }
  (unum-set-attribute): "unum_setAttribute" ffi{ ptr i32 i32 -> void }
} call "icu-num-raw" swap >module reexport

\ --- Constants ---

(UNUM_PATTERN_DECIMAL):     const [ 0 ] ;
(UNUM_DECIMAL):             const [ 1 ] ;
(UNUM_PERCENT):             const [ 3 ] ;
(UNUM_MAX_FRACTION_DIGITS): const [ 6 ] ;
(UNUM_MIN_FRACTION_DIGITS): const [ 7 ] ;
(uchar-buf-size):           const [ 256 ] ;

\ --- Internal helpers ---

\\ Allocate a UChar result buffer and return (buf ptr).
(alloc-uchar-buf): ( -- byte-array ptr ) [
  (uchar-buf-size) 2 * bytes-alloc
  bytes>ffi-ptr
] ;

\\ Open a UNumberFormat for a given style (no pattern).
(open-number-format): ( style icu-locale-id -- fmt-ptr ) [
  \ Allocate a dummy 1-byte pattern buffer (not read, patternLength=0)
  1 bytes-alloc bytes>ffi-ptr
  \ Stack: style icu-locale-id pat-buf pat-ptr
  3 pick-n
  \ Stack: style icu-locale-id pat-buf pat-ptr style
  1 pick-n 0
  \ Stack: style icu-locale-id pat-buf pat-ptr style pat-ptr 0
  5 pick-n 0 0
  \ Stack: style icu-locale-id pat-buf pat-ptr style pat-ptr 0 icu-locale-id 0 0
  (unum-open)
  \ Stack: style icu-locale-id pat-buf pat-ptr status fmt-ptr
  swap (icu-check)
  \ Stack: style icu-locale-id pat-buf pat-ptr fmt-ptr
  4nip
] ;

\\ Open a UNumberFormat with a custom ICU pattern string.
(open-pattern-format): ( pattern icu-locale-id -- fmt-ptr ) [
  swap utf8>uchar
  \ Stack: icu-id uchar-buf uchar-len
  (UNUM_PATTERN_DECIMAL) swap
  \ Stack: icu-id uchar-buf 9 uchar-len
  2 pick-n bytes>ffi-ptr+len drop
  \ Stack: icu-id uchar-buf 9 uchar-len uchar-ptr
  swap
  \ Stack: icu-id uchar-buf 9 uchar-ptr uchar-len
  4 pick-n 0 0
  \ Stack: icu-id uchar-buf 9 uchar-ptr uchar-len icu-id 0 0
  (unum-open)
  \ Stack: icu-id uchar-buf status fmt-ptr
  swap (icu-check)
  \ Stack: icu-id uchar-buf fmt-ptr
  2nip
] ;

\\ Format a number as a double using an open UNumberFormat.
\\ Converts n to float, formats into UChar buffer, converts back to UTF-8.
(format-with-double): ( n fmt-ptr -- string ) [
  swap >float swap
  \ Stack: f64-val fmt-ptr
  (alloc-uchar-buf)
  \ Stack: f64-val fmt-ptr buf ptr
  2 pick-n 4 pick-n 2 pick-n
  \ Stack: f64-val fmt-ptr buf ptr fmt-ptr f64-val ptr
  (uchar-buf-size) 0 0
  \ Stack: ... fmt-ptr f64-val ptr 256 0 0
  (unum-format-double)
  \ Stack: f64-val fmt-ptr buf ptr status actual-len
  swap (icu-check)
  \ Stack: f64-val fmt-ptr buf ptr actual-len
  swap drop
  \ Stack: f64-val fmt-ptr buf actual-len
  uchar>utf8
  \ Stack: f64-val fmt-ptr string
  nip nip
] ;

\\ Format a number and close the UNumberFormat handle.
(format-and-close): ( n fmt-ptr -- string ) [
  dup [ (format-with-double) ] dip (unum-close)
] ;

\\ Extract the ICU locale ID from a locale value.
(locale>icu-id): ( locale -- icu-locale-id ) [
  unmake-locale (bcp47>icu-id)
] ;

\ --- Public words ---

\\ Format a number using the locale's default decimal format.
\\ All numeric types are accepted (fixnum, float, bignum, ratio).
format-number: ( n locale -- string ) [
  (locale>icu-id)
  (UNUM_DECIMAL) swap (open-number-format)
  (format-and-close)
] ;

\\ Format a number with a fixed number of decimal places.
format-decimal: ( n decimals locale -- string ) [
  (locale>icu-id)
  (UNUM_DECIMAL) swap (open-number-format)
  \ Stack: n decimals fmt-ptr
  dup 2 pick-n
  \ Stack: n decimals fmt-ptr fmt-ptr decimals
  (UNUM_MIN_FRACTION_DIGITS) swap (unum-set-attribute)
  \ Stack: n decimals fmt-ptr
  dup 2 pick-n
  \ Stack: n decimals fmt-ptr fmt-ptr decimals
  (UNUM_MAX_FRACTION_DIGITS) swap (unum-set-attribute)
  \ Stack: n decimals fmt-ptr
  nip
  \ Stack: n fmt-ptr
  (format-and-close)
] ;

\\ Format a number as a percentage. The input is multiplied by 100
\\ automatically (0.75 becomes "75%").
format-percent: ( n locale -- string ) [
  (locale>icu-id)
  (UNUM_PERCENT) swap (open-number-format)
  (format-and-close)
] ;

\\ Format a number using an ICU decimal format pattern string.
\\ Pattern examples:
\\   "#,##0.00"  -- grouping with 2 decimal places
\\   "0.###E0"   -- scientific notation
\\   "@@##"      -- significant digits
\\   "#,##,##0"  -- lakh-style grouping
\\ See ICU DecimalFormat documentation for full pattern syntax.
format-number-pattern: ( n pattern locale -- string ) [
  (locale>icu-id)
  (open-pattern-format)
  (format-and-close)
] ;

\\ Parse a locale-formatted number string into a float.
\\ Uses the locale's decimal format for parsing (e.g., "1,234.56"
\\ in en-US or "1.234,56" in de-DE).
parse-number: ( string locale -- float ) [
  (locale>icu-id)
  (UNUM_DECIMAL) swap (open-number-format)
  \ Stack: string fmt-ptr
  swap utf8>uchar
  \ Stack: fmt-ptr uchar-buf uchar-len
  over bytes>ffi-ptr+len drop
  \ Stack: fmt-ptr uchar-buf uchar-len uchar-ptr
  swap
  \ Stack: fmt-ptr uchar-buf uchar-ptr uchar-len
  3 pick-n 2 pick-n 2 pick-n 0 0
  \ Stack: fmt-ptr uchar-buf uchar-ptr uchar-len fmt-ptr uchar-ptr uchar-len 0 0
  (unum-parse-double)
  \ Stack: fmt-ptr uchar-buf uchar-ptr uchar-len status f64
  swap (icu-check)
  \ Stack: fmt-ptr uchar-buf uchar-ptr uchar-len f64
  3nip swap (unum-close)
] ;
