\ lib/testing.1z - Test helper library for 1z
\
\ Usage:
\
\   use "testing" ;
\
\   "test section name" test-section
\   5 5 "five equals five" assert=
\   t "condition is true" assert-true
\   f "condition is false" assert-false
\   [ 1 0 / ] "division by zero" assert-error
\   [ 1 0 / ] division-by-zero: "division by zero" assert-error-type
\
\ Design tests using assert words over printing the output.
\
\   - Clear pass/fail output: "PASS: test name" or "FAIL: test name (expected X, got Y)"
\   - Self-documenting: test intent is explicit in the assertion
\   - Failure details: shows expected vs actual values on failure
\   - Reduced golden file churn: no need to track exact output values

\ --- Module-scope mutable counter ---

(test-counts-storage): ( -- mmap ) parse-time [ [ counter: 0 passed: 0 failed: 0 skipped: 0 ] make-mutable-map ] ;

\\ The running tallies for this process, as a mutable map with `counter:`, `passed:`, `failed:`,
\\ and `skipped:` keys. `counter:` numbers every assertion and skip in order.
test-counts: ( -- mmap ) [ (test-counts-storage) ] ;

(section-state-storage): ( -- mmap ) parse-time [ [ current: f ] make-mutable-map ] ;

private{
  section-state: ( -- mmap ) [ (section-state-storage) ] ;
}

(next-counter): ( -- n ) [
  test-counts counter: @get 1 +
  dup test-counts swap counter: swap @set! drop
] ;

(record-pass): ( -- ) [
  test-counts passed: @get 1 +
  test-counts swap passed: swap @set! drop
] ;

(record-fail): ( -- ) [
  test-counts failed: @get 1 +
  test-counts swap failed: swap @set! drop
] ;

(record-skip): ( -- ) [
  test-counts skipped: @get 1 +
  test-counts swap skipped: swap @set! drop
] ;

\ --- Default reporter ---

(default-reporter): ( -- hash ) [ H{
    on-start: [ drop ]
    on-pass:  [ description: @get "PASS: " swap #append print-line ]
    on-fail:  [
      dup kind: @get
      no-error: =
      [
        description: @get
        "FAIL (no error): " swap #append print-line
      ]
      [
        dup expected: @get inspect
        swap dup actual: @get inspect
        swap description: @get
        -rot>
        \ msg expected-str actual-str
        ", got " swap #append
        swap "(expected " swap #append ")" #append
        #append
        " " swap #append #append
        "FAIL: " swap #append print-line
      ]
      if
    ]
    on-skip: [ drop ]
    on-section-start: [ name: @get "=== " swap #append " ===" #append print-line ]
    on-section-end:   [ drop ]
    on-complete:      [ drop ]
  }
] ;

\ --- TAP v13 reporter ---

(tap-reporter): ( -- hash ) [ H{
    on-start: [ drop "TAP version 13" print-line ]
    on-pass: [
      dup counter: @get inspect
      swap description: @get swap
      "ok " swap #append " - " #append swap #append print-line
    ]
    on-fail: [
      dup counter: @get inspect
      swap dup description: @get
      <rot-
      \ stack: details description counter-str
      "not ok " swap #append " - " #append swap #append print-line
      \ stack: details
      dup kind: @get no-error: =
      [
        "  ---" print-line
        "  severity: fail" print-line
        "  message: no error was thrown" print-line
        "  ..." print-line
        drop
      ]
      [
        "  ---" print-line
        "  severity: fail" print-line
        dup expected: @get inspect
        "  expected: " swap #append print-line
        actual: @get inspect
        "  actual: " swap #append print-line
        "  ..." print-line
      ]
      if
    ]
    on-skip: [
      dup counter: @get inspect
      swap description: @get swap
      "ok " swap #append " - " #append swap #append " # SKIP" #append print-line
    ]
    on-section-start: [ name: @get "# " swap #append print-line ]
    on-section-end:   [ drop ]
    on-complete:      [ counter: @get inspect "1.." swap #append print-line ]
  }
] ;

\ --- Reporter selection ---

\ `environ` does not exist on freestanding targets, so the environ-reading
\ selector is excluded at parse time and those builds always get the default
\ reporter.
target-os choose{
  freestanding: [
    (select-reporter): ( -- hash ) [ (default-reporter) ] ;
  ]
  _ [
    (select-reporter): ( -- hash ) [
      environ "ONEZ_TEST_REPORTER" @has?
      [ environ "ONEZ_TEST_REPORTER" @get "tap" =
        [ (tap-reporter) ] [ (default-reporter) ] if
      ]
      [ (default-reporter) ]
      if
    ] ;
  ]
}

\ --- Dynamic parameter and dispatch helper ---

\\ The parameter holding the active reporter: a hash from event keys, such as `on-pass:` and
\\ `on-fail:`, to quotations that each take the event's details hash. It defaults to plain
\\ PASS/FAIL lines, or to TAP output when the ONEZ_TEST_REPORTER environment variable is "tap".
\\ Bind it with `with-parameter` to report another way.
test-reporter: ( -- param ) [ test-reporter: [ (select-reporter) ] make-parameter ] ;

(fire-reporter): ( key details -- ) [
  swap test-reporter get swap @get call
] ;

\ --- Assertion words ---

\\ Pass when actual equals expected under `=`. A failure reports both values.
\\
\\   2 2 + 4 "two plus two" assert=
\\   => PASS: two plus two
assert=: ( actual expected msg -- ) [
  -rot>   \ msg actual expected
  2dup =  \ msg actual expected bool
  [
    2drop  \ msg
    (next-counter) swap
    H{ } swap description: swap @set swap counter: swap @set
    (record-pass)
    on-pass: swap (fire-reporter)
  ]
  [
    \ msg actual expected, then build fail details
    (next-counter)
    H{ }
    swap counter: swap @set
    mismatch: kind: swap @set
    swap expected: swap @set
    swap actual: swap @set
    swap description: swap @set
    (record-fail)
    on-fail: swap (fire-reporter)
  ]
  if
] ;

\\ Pass when bool is exactly `t`. Any other truthy value fails.
assert-true: ( bool msg -- ) [ t swap assert= ] ;

\\ Pass when bool is `f`.
assert-false: ( bool msg -- ) [ f swap assert= ] ;

\\ Pass when calling quot throws any error. Whatever quot left on the stack is dropped either way.
assert-error: ( quot msg -- ) [
  \ We save msg to parameter, execute test with start marker; after execution,
  \ recover and check if TOS is :__OK__: (success) or something else (error).

  \ Parameter to store test message during assert-error execution
  __assert_msg__: parameter{ [ "" ] } ;

  \ Drop values until TOS is :__START__: marker
  __drop_until_marker__: ( -- ) [
    dup :__START__: = not
    [ drop __drop_until_marker__ ]
    when
  ] ;

  dup __assert_msg__ [  \ with-parameter msg
    drop                \ quot msg-param

    :__START__:  \ quot :__START__:
    swap         \ :__START__: quot

    [ call :__OK__: ]  \ success: push OK marker
    [ 2drop ]          \ error: drop the quotation and the error
    recover

    \ Stack after recover:
    \   Success: :__START__: [results] :__OK__:
    \   Error:   :__START__:
    dup :__OK__: =
    [
      \ SUCCESS - FAIL the test (quotation didn't error)
      __drop_until_marker__
      drop  \ drop :__START__:
      __assert_msg__ get
      (next-counter) swap
      H{ } swap description: swap @set swap counter: swap @set
      no-error: kind: swap @set
      (record-fail)
      on-fail: swap (fire-reporter)
    ]
    [
      \ ERROR - PASS the test
      __drop_until_marker__
      drop  \ drop :__START__:
      __assert_msg__ get
      (next-counter) swap
      H{ } swap description: swap @set swap counter: swap @set
      (record-pass)
      on-pass: swap (fire-reporter)
    ]
    if
  ] with-parameter
] ;

\\ Pass when calling quot throws an error whose type is expected-type. A different error type, or
\\ no error at all, fails.
\\
\\   [ 1 0 / ] division-by-zero: "division by zero" assert-error-type
\\   => PASS: division by zero
assert-error-type: ( quot expected-type msg -- ) [
  __aet_msg__: parameter{ [ "" ] } ;
  __aet_expected__: parameter{ [ "" ] } ;

  __drop_until_marker__: ( -- ) [
    dup :__START__: = not
    [ drop __drop_until_marker__ ]
    when
  ] ;

  dup __aet_msg__ [
    drop  \ quot expected-type
    dup __aet_expected__ [
      drop  \ quot

      :__START__:
      swap

      [ call :__OK__: ]
      [
        \ Recovery quotation: the error sits above the tested quotation, and both are consumed.
        \ Compare error type and print result here, while parameter bindings are still in scope.
        nip
        error-type: @get      \ actual-type
        __aet_expected__ get  \ actual-type expected-type
        2dup =
        [
          2drop
          __aet_msg__ get
          (next-counter) swap
          H{ } swap description: swap @set swap counter: swap @set
          (record-pass)
          on-pass: swap (fire-reporter)
        ]
        [
          \ Wrong error type: actual expected on stack
          __aet_msg__ get
          (next-counter) swap
          H{ } swap description: swap @set swap counter: swap @set
          wrong-type: kind: swap @set
          swap expected: swap @set
          swap actual: swap @set
          (record-fail)
          on-fail: swap (fire-reporter)
        ]
        if
      ]
      recover

      dup :__OK__: =
      [
        \ SUCCESS - FAIL (quotation didn't error)
        __drop_until_marker__
        drop
        __aet_msg__ get
        (next-counter) swap
        H{ } swap description: swap @set swap counter: swap @set
        no-error: kind: swap @set
        (record-fail)
        on-fail: swap (fire-reporter)
      ]
      [
        \ Error path already printed result; just clean up stack
        __drop_until_marker__
        drop
      ]
      if
    ] with-parameter
  ] with-parameter
] ;

\\ Start a named section, which closes the previous one. The default reporter prints the name as
\\ a `=== msg ===` header.
test-section: ( msg -- ) [
  section-state current: @get
  dup f = not
  [ H{ } swap name: swap @set on-section-end: swap (fire-reporter) ]
  [ drop ]
  if
  dup section-state swap current: swap @set! drop
  H{ } swap name: swap @set
  on-section-start: swap (fire-reporter)
] ;

\\ Record a skipped test, with msg as both its description and the reason.
skip: ( msg -- ) [
  (next-counter) swap
  H{ } swap description: swap @set
  dup description: @get reason: swap @set
  swap counter: swap @set
  (record-skip)
  on-skip: swap (fire-reporter)
] ;

\ --- Top-level initialization ---

\ Fire on-start: when testing library is loaded
on-start: H{ } (fire-reporter)

\ Register exit hook to fire on-complete: with final counts.
\ The hook fires outside the testing module's frame, so curry in
\ the mutable counter map and the reporter hash.
test-counts section-state test-reporter get
[
  \ stack: exit-code test-counts section-state reporter
  over current: @get
  dup f = not
  [ H{ } swap name: swap @set
    1 pick-n on-section-end: @get call
  ]
  [ drop ]
  if
  \ stack: exit-code test-counts section-state reporter
  \ Remove exit-code and section-state, keep reporter and test-counts
  swap drop
  \ stack: exit-code test-counts reporter
  <rot- drop swap
  \ stack: reporter test-counts
  H{ }
  over counter: @get counter: swap @set
  over passed: @get passed: swap @set
  over failed: @get failed: swap @set
  swap skipped: @get skipped: swap @set
  swap on-complete: @get call
] curry curry curry
on:exit swap add-hook

\ --- Fake clock ---

\\ Switch the current task-scope's scheduler to a fake clock starting at 0, so sleeping tasks wake
\\ only when `advance-clock` moves it. Throws outside a task-scope.
fake-clock: ( -- ) [ native.fake-clock ] ;

\\ Move the fake clock forward by a duration, waking every sleeper whose deadline it reaches.
\\ Throws when the clock is not fake.
advance-clock: ( duration -- ) [ native.advance-clock ] ;

pragma{ lint-suppress: { dead-definition: missing-type-annotation: non-kebab-case: } }
