\ lib/testing.1z - Test helper library for 1z
\
\ Usage:
\
\   use "testing" ;
\
\   "test section name" test-section
\   5 5 "five equals five" assert=
\   t "condition is true" assert-true
\   f "condition is false" assert-false
\   [ 1 0 / ] "division by zero" assert-error
\   [ 1 0 / ] division-by-zero: "division by zero" assert-error-type
\
\ Design tests using assert words over printing the output.
\
\   - Clear pass/fail output: "PASS: test name" or "FAIL: test name (expected X, got Y)"
\   - Self-documenting: test intent is explicit in the assertion
\   - Failure details: shows expected vs actual values on failure
\   - Reduced golden file churn: no need to track exact output values

\ --- Module-scope mutable counter ---

test-counts: ( -- mmap ) [ M{ counter: 0 passed: 0 failed: 0 skipped: 0 } ] ;

(next-counter): ( -- n ) [
  test-counts counter: @get 1 +
  dup test-counts swap counter: swap @set! drop
] ;

(record-pass): ( -- ) [
  test-counts passed: @get 1 +
  test-counts swap passed: swap @set! drop
] ;

(record-fail): ( -- ) [
  test-counts failed: @get 1 +
  test-counts swap failed: swap @set! drop
] ;

(record-skip): ( -- ) [
  test-counts skipped: @get 1 +
  test-counts swap skipped: swap @set! drop
] ;

\ --- Default reporter ---

(default-reporter): ( -- hash ) [ H{
    on-start: [ drop ]
    on-pass:  [ description: @get "PASS: " swap #append print-line ]
    on-fail:  [
      dup kind: @get
      no-error: =
      [
        description: @get
        "FAIL (no error): " swap #append print-line
      ]
      [
        dup expected: @get inspect
        swap dup actual: @get inspect
        swap description: @get
        -rot>
        \ msg expected-str actual-str
        ", got " swap #append
        swap "(expected " swap #append ")" #append
        #append
        " " swap #append #append
        "FAIL: " swap #append print-line
      ]
      if
    ]
    on-skip: [ drop ]
    on-section-start: [ name: @get "=== " swap #append " ===" #append print-line ]
    on-section-end:   [ drop ]
    on-complete:      [ drop ]
  }
] ;

\ --- Dynamic parameter and dispatch helper ---

test-reporter: ( -- param ) [ test-reporter: [ (default-reporter) ] make-parameter ] ;

(fire-reporter): ( key details -- ) [
  swap test-reporter get swap @get call
] ;

\ --- Assertion words ---

\ Core assertion: check equality, print PASS/FAIL with values on failure
\ Stack: actual expected msg --
assert=: ( actual expected msg -- ) [
  -rot>   \ msg actual expected
  2dup =  \ msg actual expected bool
  [
    2drop  \ msg
    (next-counter) swap
    H{ } swap description: swap @set swap counter: swap @set
    (record-pass)
    on-pass: swap (fire-reporter)
  ]
  [
    \ msg actual expected, then build fail details
    (next-counter)
    H{ }
    swap counter: swap @set
    mismatch: kind: swap @set
    swap expected: swap @set
    swap actual: swap @set
    swap description: swap @set
    (record-fail)
    on-fail: swap (fire-reporter)
  ]
  if
] ;

\ Assert boolean is true
assert-true: ( bool msg -- ) [ t swap assert= ] ;

\ Assert boolean is false
assert-false: ( bool msg -- ) [ f swap assert= ] ;

\ Assert quotation throws an error (any error).
\
\ We save msg to parameter, execute test with start marker; after execution,
\ recover and check if TOS is :__OK__: (success) or something else (error).
assert-error: ( quot msg -- ) [

  \ Parameter to store test message during assert-error execution
  __assert_msg__: define-parameter [ "" ] ;

  \ Drop values until TOS is :__START__: marker
  __drop_until_marker__: ( -- ) [
    dup :__START__: = not
    [ drop __drop_until_marker__ ]
    when
  ] ;

  dup __assert_msg__ [  \ with-parameter msg
    drop                \ quot msg-param

    :__START__:  \ quot :__START__:
    swap         \ :__START__: quot

    [ call :__OK__: ]  \ success: push OK marker
    [ drop ]           \ error: drop error, effect (1 -- 0)
    recover

    \ Stack after recover:
    \   Success: :__START__: [results] :__OK__:
    \   Error:   :__START__: [partial-effects]
    dup :__OK__: =
    [
      \ SUCCESS - FAIL the test (quotation didn't error)
      __drop_until_marker__
      drop  \ drop :__START__:
      __assert_msg__ get
      (next-counter) swap
      H{ } swap description: swap @set swap counter: swap @set
      no-error: kind: swap @set
      (record-fail)
      on-fail: swap (fire-reporter)
    ]
    [
      \ ERROR - PASS the test
      __drop_until_marker__
      drop  \ drop :__START__:
      __assert_msg__ get
      (next-counter) swap
      H{ } swap description: swap @set swap counter: swap @set
      (record-pass)
      on-pass: swap (fire-reporter)
    ]
    if
  ] with-parameter
] ;

\ Assert quotation throws an error of a specific type.
\
\   [ 1 0 / ] division-by-zero: "division by zero" assert-error-type
assert-error-type: ( quot expected-type msg -- ) [
  __aet_msg__: define-parameter [ "" ] ;
  __aet_expected__: define-parameter [ "" ] ;

  __drop_until_marker__: ( -- ) [
    dup :__START__: = not
    [ drop __drop_until_marker__ ]
    when
  ] ;

  dup __aet_msg__ [
    drop  \ quot expected-type
    dup __aet_expected__ [
      drop  \ quot

      :__START__:
      swap

      [ call :__OK__: ]
      [
        \ Recovery quotation: error on TOS, must consume it (1 -- 0).
        \ Compare error type and print result here, while parameter
        \ bindings are still in scope.
        error-type: @get      \ actual-type
        __aet_expected__ get  \ actual-type expected-type
        2dup =
        [
          2drop
          __aet_msg__ get
          (next-counter) swap
          H{ } swap description: swap @set swap counter: swap @set
          (record-pass)
          on-pass: swap (fire-reporter)
        ]
        [
          \ Wrong error type: actual expected on stack
          __aet_msg__ get
          (next-counter) swap
          H{ } swap description: swap @set swap counter: swap @set
          wrong-type: kind: swap @set
          swap expected: swap @set
          swap actual: swap @set
          (record-fail)
          on-fail: swap (fire-reporter)
        ]
        if
      ]
      recover

      dup :__OK__: =
      [
        \ SUCCESS - FAIL (quotation didn't error)
        __drop_until_marker__
        drop
        __aet_msg__ get
        (next-counter) swap
        H{ } swap description: swap @set swap counter: swap @set
        no-error: kind: swap @set
        (record-fail)
        on-fail: swap (fire-reporter)
      ]
      [
        \ Error path already printed result; just clean up stack
        __drop_until_marker__
        drop
      ]
      if
    ] with-parameter
  ] with-parameter
] ;

\ Print section header
test-section: ( msg -- ) [
  H{ } swap name: swap @set
  on-section-start: swap (fire-reporter)
] ;

\ Skip a test
skip: ( msg -- ) [
  (next-counter) swap
  H{ } swap description: swap @set swap counter: swap @set
  (record-skip)
  on-skip: swap (fire-reporter)
] ;

\ --- Top-level initialization ---

\ Fire on-start: when testing library is loaded
on-start: H{ } (fire-reporter)

\ Register exit hook to fire on-complete: with final counts.
\ The hook fires outside the testing module's frame, so curry in
\ the mutable counter map and the reporter hash.
test-counts test-reporter get
[
  \ stack: exit-code test-counts-map reporter-hash
  -rot> swap drop
  \ stack: reporter-hash test-counts-map
  H{ }
  over counter: @get counter: swap @set
  over passed: @get passed: swap @set
  over failed: @get failed: swap @set
  swap skipped: @get skipped: swap @set
  \ stack: reporter-hash completed-hash
  swap on-complete: @get call
] curry curry
on:exit swap add-hook

\ --- Fake clock ---

\ Activate fake clock in the current task-scope
fake-clock: ( -- ) [ native.fake-clock ] ;

\ Advance the fake clock by the given duration
advance-clock: ( duration -- ) [ native.advance-clock ] ;
