\ lib/testing.1z - Test helper library for 1z
\
\ Usage:
\
\   use "testing" ;
\
\   "test section name" test-section
\   5 5 "five equals five" assert=
\   t "condition is true" assert-true
\   f "condition is false" assert-false
\   [ 1 0 / ] "division by zero" assert-error
\   [ 1 0 / ] division-by-zero: "division by zero" assert-error-type
\
\ Design tests using assert words over printing the output.
\
\   - Clear pass/fail output: "PASS: test name" or "FAIL: test name (expected X, got Y)"
\   - Self-documenting: test intent is explicit in the assertion
\   - Failure details: shows expected vs actual values on failure
\   - Reduced golden file churn: no need to track exact output values

\ Core assertion: check equality, print PASS/FAIL with values on failure
\ Stack: actual expected msg --
assert=: ( actual expected msg -- ) [
  -rot>   \ msg actual expected
  2dup =  \ msg actual expected bool
  [
    2drop  \ msg
    "PASS: " swap #append print-line
  ]
  [
    \ Build: "FAIL: {msg} (expected {expected}, got {actual})"
    to-string                  \ msg actual expected-str
    swap to-string             \ msg expected-str actual-str
    ", got " swap #append      \ msg expected-str ", got {actual}"
    swap                       \ msg ", got {actual}" expected-str
    "(expected " swap #append  \ msg ", got {actual}" "(expected {exp}"
    ")" #append                \ msg ", got {actual}" "(expected {exp})"
    #append                    \ msg "(expected {exp}), got {actual}"
    " " swap #append           \ msg " (expected {exp}), got {actual}"
    #append                    \ "{msg} (expected {exp}), got {actual}"
    "FAIL: " swap #append print-line
  ]
  if
] ;

\ Assert boolean is true
assert-true: ( bool msg -- ) [ t swap assert= ] ;

\ Assert boolean is false
assert-false: ( bool msg -- ) [ f swap assert= ] ;

\ Assert quotation throws an error (any error).
\
\ We save msg to parameter, execute test with start marker; after execution,
\ recover and check if TOS is :__OK__: (success) or something else (error).
assert-error: ( quot msg -- ) [

  \ Parameter to store test message during assert-error execution
  __assert_msg__: parameter [ "" ] ;

  \ Drop values until TOS is :__START__: marker
  __drop_until_marker__: ( -- ) [
    dup :__START__: = not
    [ drop __drop_until_marker__ ]
    when
  ] ;

  dup __assert_msg__ [  \ with-parameter msg
    drop                \ quot msg-param

    :__START__:  \ quot :__START__:
    swap         \ :__START__: quot

    [ call :__OK__: ]  \ success: push OK marker
    [ drop ]           \ error: drop error, effect (1 -- 0)
    recover

    \ Stack after recover:
    \   Success: :__START__: [results] :__OK__:
    \   Error:   :__START__: [partial-effects]
    dup :__OK__: =
    [
      \ SUCCESS - FAIL the test (quotation didn't error)
      __drop_until_marker__
      drop  \ drop :__START__:
      __assert_msg__ get
      "FAIL (no error): " swap #append print-line
    ]
    [
      \ ERROR - PASS the test
      __drop_until_marker__
      drop  \ drop :__START__:
      __assert_msg__ get
      "PASS: " swap #append print-line
    ]
    if
  ] with-parameter
] ;

\ Assert quotation throws an error of a specific type.
\
\   [ 1 0 / ] division-by-zero: "division by zero" assert-error-type
assert-error-type: ( quot expected-type msg -- ) [
  __aet_msg__: parameter [ "" ] ;
  __aet_expected__: parameter [ "" ] ;

  __drop_until_marker__: ( -- ) [
    dup :__START__: = not
    [ drop __drop_until_marker__ ]
    when
  ] ;

  dup __aet_msg__ [
    drop  \ quot expected-type
    dup __aet_expected__ [
      drop  \ quot

      :__START__:
      swap

      [ call :__OK__: ]
      [
        \ Recovery quotation: error on TOS, must consume it (1 -- 0).
        \ Compare error type and print result here, while parameter
        \ bindings are still in scope.
        error-type: @get      \ actual-type
        __aet_expected__ get  \ actual-type expected-type
        2dup =
        [
          2drop
          __aet_msg__ get
          "PASS: " swap #append print-line
        ]
        [
          \ Wrong error type
          swap  \ expected actual
          to-string ", got " swap #append
          swap to-string "(expected " swap #append
          ")" #append #append
          __aet_msg__ get
          " " swap #append swap #append
          "FAIL: " swap #append print-line
        ]
        if
      ]
      recover

      dup :__OK__: =
      [
        \ SUCCESS - FAIL (quotation didn't error)
        __drop_until_marker__
        drop
        __aet_msg__ get
        "FAIL (no error): " swap #append print-line
      ]
      [
        \ Error path already printed result; just clean up stack
        __drop_until_marker__
        drop
      ]
      if
    ] with-parameter
  ] with-parameter
] ;

\ Print section header
test-section: ( msg -- ) [ "=== " swap #append " ===" #append print-line ] ;
