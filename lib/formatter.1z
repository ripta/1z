\ lib/formatter.1z - Code formatter for 1z source
\
\ Reformats a source string: indentation, spacing around brackets and stack
\ effects, newline compression, semicolon placement, inline comment alignment,
\ and definition column alignment.
\
\ Usage:
\   use "formatter" ;
\   "double:(n--n)[2 *];" format-source print
\
\ The formatter works on a stream of whitespace-delimited chunks rather than on
\ the tokens `1z-tokenize` produces. See `(chunk-tokens)` for why.

use "1z-tokens" ;
use { load-config-data: config-unwrap: } "config" ;
use "lexer" ;
use { file-exists?: } "os/fs" ;
use { dirname: path-join: } "os/path" ;
use "strings" ;

\\ The rules one formatting run applies. Every field names the `.fmt.1z` key it
\\ is read from.
fmt-config: struct{
  indent-size:       fixnum
  max-blank-lines:   fixnum
  align-comments:    boolean
  align-symbols:     boolean
  align-min-group:   fixnum
  align-max-padding: fixnum
  trailing-newline:  boolean
} ;

\\ The rules applied when no `.fmt.1z` is found. These are the values the
\\ formatter carried hardcoded before it took configuration.
\\
\\ A binding rather than a `const` body, so the struct is built once at load
\\ instead of on every rule the formatter reads.
default-fmt-config: ( -- fmt-config ) 2 1 t t 3 15 t make-fmt-config ;

\\ The config the formatter reads. `format-file` binds what it discovers; bind it
\\ yourself around `format-source` to format under rules of your own.
current-fmt-config: parameter{ [ default-fmt-config ] } ;

private{

  \ The four numeric rules, read through the parameter at the point of use.
  \
  \ `(max-newlines)` is one greater than the configured blank-line count, since a
  \ run of n blank lines is n+1 line breaks.
  (indent-size):    ( -- n ) [ current-fmt-config get indent-size>> ] ;
  (max-newlines):   ( -- n ) [ current-fmt-config get max-blank-lines>> 1 + ] ;
  (min-group-size): ( -- n ) [ current-fmt-config get align-min-group>> ] ;
  (max-divergence): ( -- n ) [ current-fmt-config get align-max-padding>> ] ;

  \ --- Chunking ---

  \ Whether a character separates two chunks. A newline arrives as its own token,
  \ so only horizontal whitespace reaches here. A carriage return is included
  \ because the stack-effect rule stops at a line feed and will carry one through.
  (chunk-break?): ( ch -- ? ) [ dup " " = over "\t" = or swap "\r" = or ] ;

  \ The chunk stream under construction. `pending` is f between chunks and holds
  \ the accumulated text of a chunk in progress otherwise.
  chunker: mutable struct{ out pending pending-pos } ;

  \ Close the chunk in progress, if there is one, and classify it.
  (chunk-flush): ( c -- c ) [
    dup pending>> f = not [
      dup pending>>
      dup (classify) swap
      2 pick-n pending-pos>>
      make-token
      over out>> swap #push! drop
      f >>pending
    ] when
  ] ;

  \ Extend the chunk in progress with text, recording pos as its start when the
  \ chunk is empty.
  (chunk-add): ( c pos text -- c ) [
    [ over pending>> f = [ >>pending-pos ] [ drop ] if ] dip
    over pending>> dup f = [ drop "" ] when
    swap #append >>pending
  ] ;

  \ Close the chunk in progress and emit tok as a chunk of its own. A doc comment
  \ becomes a plain comment, since nothing downstream distinguishes them.
  (chunk-carry): ( c tok -- c ) [
    [ (chunk-flush) ] dip
    dup kind>> doc-comment: = [ comment: ] [ dup kind>> ] if
    over value>>
    2 pick-n pos>>
    make-token
    nip
    over out>> swap #push! drop
  ] ;

  (chunk-word): ( c tok -- c ) [ dup pos>> swap value>> (chunk-add) ] ;

  \ A string closes its chunk when it opened one, and extends the chunk otherwise.
  \
  \ The host tokenizer only takes a string as a token when a token starts at the
  \ quote, and that token stops at the closing quote. So `"a"print` is two tokens
  \ there while `["a"]` is one run, and this reproduces both.
  (chunk-string): ( c tok -- c ) [
    over pending>> f = [ (chunk-word) (chunk-flush) ] [ (chunk-word) ] if
  ] ;

  (effect-char): ( c ch idx base -- c ) [
    + swap
    dup (chunk-break?) [ 2drop (chunk-flush) ] [ (chunk-add) ] if
  ] ;

  \ Feed a stack-effect token in as its whitespace-separated pieces.
  \
  \ `1z-tokenize` returns `( a -- b )` whole, but the host tokenizer this
  \ formatter reproduces splits on whitespace, so `foo:( a -- b )` has to arrive
  \ as `foo:(`, `a`, `--`, `b`, `)`. The rule never matches across a newline, so
  \ only spaces and tabs can appear inside the value.
  (chunk-effect): ( c tok -- c ) [
    dup pos>> swap value>>
    swap [ (effect-char) ] curry
    [ swap ] dip
    #reduce-index
  ] ;

  (chunk-step): ( c tok -- c ) [
    dup kind>>
    dup whitespace: = [ 2drop (chunk-flush) ] [
      dup newline: = over comment: = or over doc-comment: = or
      [ drop (chunk-carry) ] [
        dup stack-effect: = [ drop (chunk-effect) ] [
          string: = [ (chunk-string) ] [ (chunk-word) ] if
        ] if
      ] if
    ] if
  ] ;

  \ Regroup a token stream into the whitespace-delimited chunks the host
  \ formatter's rules are written against.
  \
  \ The host tokenizer splits on whitespace and nothing else, so it sees `[1` as a
  \ single word and leaves `[1 2 +]` alone. `1z-tokenize` splits that into five
  \ tokens. Feeding those to the rules below would both insert spaces the host
  \ does not and treat `[1` as an opener, which shifts every following line's
  \ indentation. Merging adjacent non-whitespace tokens restores the host's view.
  (chunk-tokens): ( tokens: array -- array ) [
    V{ } f 0 make-chunker
    [ (chunk-step) ] #reduce
    (chunk-flush)
    out>> >array
  ] ;

  \ --- Classification ---

  (ends-with?): ( text ch -- ? ) [ over #len 1 > [ swap #last = ] [ 2drop f ] if ] ;

  \ The chunks the host formatter classifies by exact text.
  \
  \ Hoisting them out of the ordered tests below is safe because none of them can
  \ also satisfy a prefix or suffix test. A lone `{` is the near miss, and the
  \ brace-suffix test needs more than one character.
  (punctuation-kinds): ( -- hash ) const [
    H{
      "[" open-bracket: "]" close-bracket: "{" open-brace:
      "(" open-paren: ")" close-paren: "--" arrow: ";" semicolon:
    }
  ] ;

  \ Assign a chunk its formatting kind. Ports the host formatter's classifier,
  \ including its order: the first test that matches wins.
  (classify): ( text: string -- kind ) [
    dup (punctuation-kinds) swap f @get-or
    dup f = [
      drop
      dup "{" (ends-with?) [ drop open-brace: ] [
        dup "}" #starts-with? [ drop close-brace: ] [
          dup "\"" #starts-with? [ drop string: ] [
            ":" (ends-with?) [ symbol: ] [ word: ] if
          ] if
        ] if
      ] if
    ] [ nip ] if
  ] ;

  \ --- Chunk predicates ---

  (kind-of): ( chunks n -- kind ) [ #nth kind>> ] ;

  (opening?): ( kind -- ? ) [
    dup open-bracket: = over open-brace: = or swap open-paren: = or
  ] ;

  (closing?): ( kind -- ? ) [
    dup close-bracket: = over close-brace: = or swap close-paren: = or
  ] ;

  \ Index of the first chunk at or after start that is not a newline, or f when
  \ the rest of the stream is newlines.
  (next-non-newline): ( chunks start -- idx/f ) [
    dup 2 pick-n #len >= [ 2drop f ] [
      2dup (kind-of) newline: = [ 1 + (next-non-newline) ] [ nip ] if
    ] if
  ] ;

  \ --- Block index ---

  \ Positional facts the block predicates would otherwise recover by scanning
  \ backwards from every closer, semicolon, and line break. Those scans are what
  \ make the host formatter quadratic; here they are one forward pass instead.
  \
  \ `parent` holds the innermost opener still unclosed before a position, or f at
  \ the top level. `newlines` is a prefix count, one entry longer than the chunk
  \ array so a block reaching the last chunk can still be measured. `closer` maps
  \ an opener to its matching closer, or to the end of the stream when it has
  \ none. `gap` maps an opener to the line break that follows it before any
  \ content, or f when content comes first.
  block-index: struct{ parent newlines closer gap } ;

  (top-or-f): ( vec -- val ) [ dup #empty? [ drop f ] [ #last ] if ] ;

  (nl-prefix-step): ( vec chunk -- vec ) [
    kind>> newline: = [ 1 ] [ 0 ] if
    over #last +
    over swap #push! drop
  ] ;

  (newline-prefix): ( chunks -- array ) [
    V{ } 0 #push! [ (nl-prefix-step) ] #reduce >array
  ] ;

  \ The line break that follows an opener before any content, or f. A comment in
  \ between does not count as content.
  (gap-after): ( chunks k -- idx/f ) [
    dup 2 pick-n #len >= [ 2drop f ] [
      2dup (kind-of)
      dup newline: = [ drop nip ] [
        comment: = [ 1 + (gap-after) ] [ 2drop f ] if
      ] if
    ] if
  ] ;

  (index-blocks): ( chunks: array -- block-index ) [
    ib-chunks: swap ;
    ib-len:    ib-chunks #len ;
    ib-parent: V{ } ib-len f #resize! ;
    ib-closer: V{ } ib-len ib-len #resize! ;
    ib-gap:    V{ } ib-len f #resize! ;
    ib-open:   V{ } ;

    ib-open-step: ( i -- i' ) [
      ib-parent over ib-open (top-or-f) #nth! drop
      ib-chunks over #nth kind>>
      dup (opening?)
      [ drop dup ib-open swap #push! drop ]
      [
        (closing?)
        [
          ib-open #empty? not
          [
            ib-open #pop! nip
            ib-closer swap 2 pick-n #nth! drop
          ] when
        ] when
      ] if
      1 +
    ] ;

    ib-gap-step: ( i -- i' ) [
      ib-chunks over #nth kind>> (opening?)
      [ ib-gap over dup 1 + ib-chunks swap (gap-after) #nth! drop ] when
      1 +
    ] ;

    0 [ dup ib-len < ] [ ib-open-step ] while drop
    0 [ dup ib-len < ] [ ib-gap-step ] while drop

    ib-parent >array
    ib-chunks (newline-prefix)
    ib-closer >array
    ib-gap >array
    make-block-index
  ] ;

  (parent-of): ( blocks pos -- idx/f ) [ swap parent>> swap #nth ] ;

  \ Whether the enclosing block broke a line before any content appeared.
  (in-multi-line-block?): ( blocks pos -- ? ) [
    2dup (parent-of) dup f = [ 3drop f ] [
      2 pick-n gap>> swap #nth
      dup f = [ 3drop f ] [ swap < nip ] if
    ] if
  ] ;

  \ Whether a line break falls anywhere between the enclosing opener and pos.
  (multi-line-block?): ( blocks pos -- ? ) [
    2dup (parent-of) dup f = [ 3drop f ] [
      1 +
      2 pick-n newlines>> swap #nth
      2 pick-n newlines>> 2 pick-n #nth
      < nip nip
    ] if
  ] ;

  \ Whether the enclosing block spans lines, measured all the way to its matching
  \ closer. A brace form whose first row shares the opening line is still
  \ multi-line, so its row separators still break.
  (enclosing-block-multi-line?): ( blocks pos -- ? ) [
    2dup (parent-of) dup f = [ 3drop f ] [
      dup 1 +
      3 pick-n newlines>> swap #nth
      swap
      3 pick-n closer>> swap #nth
      3 pick-n newlines>> swap #nth
      < nip nip
    ] if
  ] ;

  (semi-advance): ( chunks k flag -- ? ) [ [ 1 + ] dip (semi-scan) ] ;

  (semi-scan): ( chunks k flag -- ? ) [
    over 3 pick-n #len >= [ nip nip ] [
      2 pick-n 2 pick-n (kind-of)
      dup newline: = [ drop nip nip ] [
        dup comment: = [ drop (semi-advance) ] [
          semicolon: = [ drop t ] [ drop f ] if (semi-advance)
        ] if
      ] if
    ] if
  ] ;

  \ Whether the source line holding pos ends in `;`, ignoring trailing comments.
  \
  \ Breaking after a top-level `;` turns one statement into two. The AOT freeze
  \ runs an entry-file statement at build time only when its last instruction is
  \ the `;` call, and collects it for binary runtime otherwise. A break is safe
  \ only where every piece still ends in `;`, which is exactly when the line
  \ already does.
  (line-ends-in-semicolon?): ( chunks pos -- ? ) [ f (semi-scan) ] ;

  \ --- Emission ---

  \ Everything phase one carries. `out` is the string-builder the result
  \ accumulates into, and `pending` holds inline comments waiting for the end of
  \ their line.
  fmt-state: mutable struct{
    chunks blocks out idx indent-level
    in-effect line-start after-comment at-start
    newlines-written pending
  } ;

  (<fmt-state>): ( chunks stream -- state ) [
    over (index-blocks) swap
    0 0 f t f t 0 V{ } make-fmt-state
  ] ;

  (cur-chunk): ( s -- s chunk ) [ dup dup chunks>> swap idx>> #nth ] ;
  (cur-kind):  ( s -- s kind ) [ (cur-chunk) kind>> ] ;
  (cur-text):  ( s -- s text ) [ (cur-chunk) value>> ] ;

  (advance): ( s -- s ) [ dup idx>> 1 + >>idx ] ;

  (write): ( s text -- s ) [ over out>> swap stream-write-string drop ] ;

  (write-indent): ( s -- s ) [
    dup indent-level>> (indent-size) * " " swap repeat (write)
  ] ;

  (indent-or-space): ( s -- s ) [
    dup line-start>> [ (write-indent) ] [ " " (write) ] if
  ] ;

  \ Emit every buffered inline comment, each behind a two-space gap. Phase two
  \ later widens that gap to align a run of them.
  (flush-pending): ( s -- s ) [
    dup pending>> swap
    [ swap "  " (write) swap (write) ] #reduce
    V{ } >>pending
  ] ;

  (start-content): ( s -- s ) [ f >>at-start f >>after-comment ] ;

  (end-inline): ( s -- s ) [ f >>line-start 0 >>newlines-written ] ;

  (emit-text): ( s -- s ) [
    (start-content) (indent-or-space) (cur-text) (write) (end-inline) (advance)
  ] ;

  (emit-open-paren): ( s -- s ) [
    (start-content) t >>in-effect
    dup line-start>> not [ " " (write) ] when
    "(" (write) (end-inline) (advance)
  ] ;

  (emit-close-paren): ( s -- s ) [
    (start-content) f >>in-effect " )" (write) (end-inline) (advance)
  ] ;

  (emit-arrow): ( s -- s ) [
    (start-content) " --" (write) (end-inline) (advance)
  ] ;

  (emit-opener): ( s -- s ) [
    (start-content) (indent-or-space) (cur-text) (write)
    dup indent-level>> 1 + >>indent-level
    (end-inline) (advance)
  ] ;

  \ A closer whose opener is on an earlier line moves to its own line at the
  \ dedented level. One that shares its opener's line keeps a leading space, which
  \ is what holds `[ ]` open instead of collapsing it to `[]`.
  (emit-closer): ( s -- s ) [
    (start-content)
    dup indent-level>> dup 0 > [ 1 - ] [ drop 0 ] if >>indent-level
    dup blocks>> over idx>> (multi-line-block?)
    [
      dup line-start>> not [ (flush-pending) "\n" (write) ] when
      (write-indent)
    ] [
      dup line-start>> not [ " " (write) ] when
    ] if
    (cur-text) (write) (end-inline) (advance)
  ] ;

  \ A comment at the start of a line stands on its own. Anywhere else it is
  \ buffered and re-emitted at the next line break, so it never splits the code it
  \ trails.
  (emit-comment): ( s -- s ) [
    f >>at-start
    dup line-start>>
    [
      (write-indent) (cur-text) (write)
      f >>line-start t >>after-comment
    ] [
      (cur-text) over pending>> swap #push! drop
    ] if
    0 >>newlines-written (advance)
  ] ;

  (ends-statement?): ( s -- ? ) [
    dup indent-level>> 0 =
    [ dup chunks>> over idx>> (line-ends-in-semicolon?) nip ]
    [ dup blocks>> over idx>> (enclosing-block-multi-line?) nip ]
    if
  ] ;

  (emit-semicolon): ( s -- s ) [
    (start-content) " ;" (write)
    dup (ends-statement?)
    [ (flush-pending) "\n" (write) t >>line-start 1 >>newlines-written ]
    [ (end-inline) ]
    if
    (advance)
  ] ;

  \ Index just past the run of newline chunks starting at k.
  (newline-run-end): ( chunks k -- idx ) [
    dup 2 pick-n #len >= [ nip ] [
      2dup (kind-of) newline: = [ 1 + (newline-run-end) ] [ nip ] if
    ] if
  ] ;

  (write-newlines): ( s n -- s ) [
    dup 0 > [ 1 - [ "\n" (write) ] dip (write-newlines) ] [ drop ] if
  ] ;

  \ Collapse a run of newlines to the number this position allows.
  \
  \ The host formatter picks from a twelve-priority ladder, but every arm past the
  \ zero group yields either a literal 2 or min(count, 2), and the count is
  \ clamped again below, so those arms collapse into one. What survives is the
  \ zero group, the lone arm that yields 1, and the arms that outrank it.
  \
  \ Those surviving 2s are where `max-blank-lines` lands. The 1 stays literal: it
  \ means no blank line at this position rather than a budget, as does the 0.
  (emit-newline-run): ( s -- s ) [
    dup chunks>> nlr-chunks: swap ;
    dup idx>> nlr-start: swap ;
    nlr-chunks nlr-start (newline-run-end) nlr-end: swap ;
    nlr-end nlr-start - nlr-count: swap ;
    nlr-chunks nlr-end (next-non-newline) nlr-next: swap ;

    nlr-next f = [ f ] [ nlr-chunks nlr-next (kind-of) ] if
    nlr-next-kind: swap ;
    nlr-start 0 = [ f ] [ nlr-chunks nlr-start 1 - (kind-of) ] if
    nlr-prev-kind: swap ;

    \ Suppressed: inside a stack effect, at end of file, before an opener that
    \ follows a stack effect or a symbol, and before a `;`.
    dup in-effect>>
    nlr-next f = or
    nlr-next-kind (opening?)
    nlr-prev-kind close-paren: = nlr-prev-kind symbol: = or
    and or
    nlr-next-kind semicolon: = or
    [ 0 ] [
      \ Outranking the pending-comment rule below: after a standalone comment, at
      \ the start of the file, just inside a block that has content, before the
      \ closer of a multi-line block, and between statements.
      dup after-comment>>
      over at-start>> or
      nlr-prev-kind (opening?) nlr-next-kind (closing?) not and or
      nlr-next-kind (closing?)
      2 pick-n blocks>> 3 pick-n idx>> (multi-line-block?) and or
      nlr-prev-kind semicolon: = or
      [ (max-newlines) ] [
        dup pending>> #len 0 >
        [
          dup indent-level>> 0 >
          over blocks>> 2 pick-n idx>> (in-multi-line-block?) and
          [ (max-newlines) ] [ 1 ] if
        ] [ (max-newlines) ] if
      ] if
    ] if

    nlr-count min
    over newlines-written>> - dup 0 < [ drop 0 ] when
    dup 0 > [
      [ (flush-pending) ] dip
      dup [ (write-newlines) ] dip
      over newlines-written>> + >>newlines-written
      t >>line-start
    ] [ drop ] if
    nlr-end >>idx
  ] ;

  \ The arm each chunk kind is emitted through. Words, symbols, and strings fall
  \ to the default, as they do in the host formatter, where the symbol kind
  \ differs from a word only in that the newline ladder inspects it.
  (emit-arms): ( -- hash ) const [
    H{
      newline:       [ (emit-newline-run) ]
      comment:       [ (emit-comment) ]
      semicolon:     [ (emit-semicolon) ]
      open-bracket:  [ (emit-opener) ]
      open-brace:    [ (emit-opener) ]
      close-bracket: [ (emit-closer) ]
      close-brace:   [ (emit-closer) ]
      open-paren:    [ (emit-open-paren) ]
      close-paren:   [ (emit-close-paren) ]
      arrow: [ (emit-arrow) ]
    }
  ] ;

  (fmt-step): ( s -- s ) [
    (cur-kind) (emit-arms) swap [ (emit-text) ] @get-or call
  ] ;

  (fmt-run): ( s -- s ) [
    [ dup idx>> over chunks>> #len < ] [ (fmt-step) ] while
  ] ;

  \ Emit any comment still buffered when the input runs out, then close the file
  \ with exactly one newline.
  (fmt-finish): ( s -- s ) [
    dup pending>> #len 0 > [ (flush-pending) f >>line-start ] when
    dup line-start>> not [ "\n" (write) ] when
  ] ;

  \ `curry` pushes the chunk array on top of the threaded builder, so the stream
  \ arrives underneath.
  (fmt-chunks): ( stream chunks -- ) [ swap (<fmt-state>) (fmt-run) (fmt-finish) drop ] ;

  \ --- Comment alignment ---

  \ Right-trim spaces. `rtrim` would also take tabs and carriage returns, where
  \ the host trims spaces alone.
  (rtrim-spaces): ( text: string -- string ) [
    dup #empty? not
    [ dup #last " " = [ dup #len 1 - #take (rtrim-spaces) ] when ] when
  ] ;

  \ Whether two spaces sit immediately before pos. Guards the read, since a
  \ marker at the first or second character has nothing to look back at.
  (two-spaces-before?): ( line pos -- ? ) [
    dup 2 < [ 2drop f ] [
      2dup 1 - #nth " " =
      [ 2 - #nth " " = ] [ 2drop f ] if
    ] if
  ] ;

  \ The line's code up to the two-space gap before pos, right-trimmed.
  (code-before): ( line pos -- string ) [ 2 - 0 swap #slice (rtrim-spaces) ] ;

  \ The position of a line's inline comment marker, or f when it has none.
  \
  \ The host takes the first backslash anywhere in the line, requires two spaces
  \ before it, and requires the content before those spaces to be non-empty and
  \ to not itself start with a backslash. That last test is what rejects an
  \ indented standalone comment.
  \
  \ Nothing here knows about string literals, so a backslash inside one is taken
  \ as a marker and a real marker after one is missed. Both are the host's
  \ behavior, reproduced rather than fixed.
  \
  \ The position is a codepoint index, where the host counts bytes. The two agree
  \ on everything but a line carrying non-ASCII code before its marker.
  (inline-comment-pos): ( line: string -- idx/f ) [
    dup "\\" #index-of
    dup f = [ nip ] [
      2dup (two-spaces-before?) [
        2dup (code-before)
        dup #empty? not swap "\\" #starts-with? not and
        [ nip ] [ 2drop f ] if
      ] [ 2drop f ] if
    ] if
  ] ;

  \ Split on line feeds, with no entry for the empty tail after a final one.
  \ Not the `text` module's `split-lines`, which drops the blank lines a run of
  \ commented lines has to end on.
  (split-lines): ( text: string -- array ) [
    dup #empty? [ drop { } ] [
      "\n" split
      dup #last #empty? [ dup 0 swap #len 1 - #slice ] when
    ] if
  ] ;

  \ Run one line-oriented pass over text. quot has the effect ( stream lines -- )
  \ and writes every line back, each with a trailing newline.
  \
  \ That leaves a text which ended without a newline one character too long. The
  \ host pops that character, and dropping it here is the same thing.
  (line-pass): ( text: string quot: quotation -- string ) [
    over #empty? [ drop ] [
      [ dup (split-lines) ] dip curry using-string-builder
      swap "\n" #ends-with? not [ dup #len 1 - #take ] when
    ] if
  ] ;

  \ Align every run of consecutive commented lines, writing the whole text out.
  \
  \ The host finds each line's marker twice, once while measuring a group and
  \ again while rebuilding it. One pass up front costs the same and reads better.
  (comment-lines): ( stream lines: array -- ) [
    al-lines: swap ;
    al-out:   swap ;
    al-pos:   al-lines [ (inline-comment-pos) ] #map #collect ;
    al-len:   al-lines #len ;

    al-write: ( text -- ) [ al-out swap stream-write-string drop ] ;

    al-commented?: ( k -- ? ) [ al-pos swap #nth f = not ] ;

    \ Index just past the run of commented lines starting at k.
    al-run-end: ( k -- idx ) [
      [ dup al-len < [ dup al-commented? ] [ f ] if ] [ 1 + ] while
    ] ;

    \ The run's shared code column. The host measures it from the marker
    \ position, not from the trimmed code it later pads against.
    al-run-width: ( start end -- n ) [
      [ al-pos ] 2dip #slice 0 [ 2 - max ] #reduce
    ] ;

    \ Rebuild one line as its trimmed code, padding, two spaces, and the comment.
    al-emit-at: ( width k -- ) [
      dup al-lines swap #nth
      swap al-pos swap #nth
      2dup (code-before) dup al-write
      #len 3 pick-n swap - dup 0 < [ drop 0 ] when
      2 + " " swap repeat al-write
      over #len #slice al-write
      "\n" al-write
      drop
    ] ;

    al-emit-run: ( start end -- ) [
      2dup al-run-width -rot> swap
      [ dup 2 pick-n < ] [ 2 pick-n over al-emit-at 1 + ] while
      3drop
    ] ;

    al-step: ( k -- k' ) [
      dup al-commented? [
        dup al-run-end dup [ al-emit-run ] dip
      ] [
        al-lines over #nth al-write "\n" al-write
        1 +
      ] if
    ] ;

    0 [ dup al-len < ] [ al-step ] while drop
  ] ;

  \ Align the inline comments in already token-level-formatted source.
  (align-comments): ( text: string -- string ) [ [ (comment-lines) ] (line-pass) ] ;

  \ --- Symbol alignment ---

  \ Right-trim spaces and tabs, where `(rtrim-spaces)` takes spaces alone. The
  \ host trims both off a line before it parses it.
  (rtrim-blanks): ( text: string -- string ) [
    dup #empty? not [
      dup #last dup " " = swap "\t" = or
      [ dup #len 1 - #take (rtrim-blanks) ] when
    ] when
  ] ;

  \ Count of leading spaces. A tab does not count, so a tab-indented line has an
  \ empty indent string and groups with the unindented lines around it.
  (indent-width): ( line: string -- n ) [
    0 [ 2dup swap #len < [ 2dup #nth " " = ] [ f ] if ] [ 1 + ] while nip
  ] ;

  (ltrim-spaces): ( text: string -- string ) [ dup (indent-width) over #len #slice ] ;

  \\ One parsed definition or block entry, ready to be rebuilt at a shared
  \\ column. `has-effect` and `effect` are set only for an unindented line, and
  \\ `suffix` is ` ;` there and empty for a block entry. `comment` is f when the
  \\ line carries no inline comment.
  alignable-line: struct{ indent name has-effect effect body suffix comment } ;

  \ The line's first word when it can name a definition, or f. The line must have
  \ its indent stripped already.
  \
  \ Rejects a line with no space in it, and a first word shorter than two
  \ characters or not ending in `:`.
  (alignable-name): ( stripped: string -- name/f ) [
    dup " " #index-of dup f = [ 2drop f ] [
      #take
      dup #len 2 < over ":" #ends-with? not or [ drop f ] when
    ] if
  ] ;

  \ The text after the name, left-trimmed, or f when nothing follows it.
  (after-name): ( text: string name: string -- rest/f ) [
    #len over #len 2dup > [ 3drop f ] [
      #slice (ltrim-spaces) dup #empty? [ drop f ] when
    ] if
  ] ;

  \ The line's code, with any inline comment and its two-space gap removed.
  (code-part): ( trimmed: string marker -- string ) [
    dup f = [ drop ] [ (code-before) ] if
  ] ;

  \ The line's inline comment, marker included, or f when the line has none.
  (trailing-comment): ( trimmed: string marker -- comment/f ) [
    dup f = [ 2drop f ] [ over #len #slice ] if
  ] ;

  \ A definition whose content after the name opens a stack effect. The first
  \ ` )` closes it and the rest is the body. f when there is no ` )`.
  (effect-line): ( indent: string name: string after: string comment -- alignable-line/f ) [
    ef-comment: swap ;
    ef-after:   swap ;
    ef-name:    swap ;
    ef-indent:  swap ;
    ef-close:   ef-after " )" #index-of ;
    ef-end:     ef-close f = [ 0 ] [ ef-close 2 + ] if ;
    ef-effect:  ef-after 0 ef-end #slice ;
    ef-body:    ef-after ef-end ef-after #len #slice (ltrim-spaces) ;

    ef-close f = ef-body #empty? or
    [ f ]
    [ ef-indent ef-name t ef-effect ef-body " ;" ef-comment make-alignable-line ]
    if
  ] ;

  \ A top-level definition, or f when the line does not end in ` ;` or has no
  \ body. `code` is the line with any inline comment already removed.
  (definition-line): ( indent: string name: string code: string comment -- alignable-line/f ) [
    dl-comment: swap ;
    dl-code:    swap ;
    dl-name:    swap ;
    dl-indent:  swap ;
    dl-end:     dl-code #len 2 - 0 max ;
    dl-content: dl-code 0 dl-end #slice (rtrim-spaces) ;
    dl-after:   dl-content dl-name (after-name) ;

    dl-code " ;" #ends-with? not dl-end 0 = or dl-after f = or
    [ f ]
    [
      dl-after "(" #starts-with?
      [ dl-indent dl-name dl-after dl-comment (effect-line) ]
      [ dl-indent dl-name f "" dl-after " ;" dl-comment make-alignable-line ]
      if
    ] if
  ] ;

  \ A block entry. No stack effect is parsed and no `;` is required, which is
  \ what lets struct fields, hash entries, and `ffi-def{` rows qualify.
  (entry-line): ( indent: string name: string code: string comment width: fixnum -- alignable-line/f ) [
    el-width:   swap ;
    el-comment: swap ;
    el-code:    swap ;
    el-name:    swap ;
    el-indent:  swap ;
    el-start:   el-width el-name #len + el-code #len min ;
    el-body:    el-code el-start el-code #len #slice (ltrim-spaces) ;

    el-body #empty?
    [ f ]
    [ el-indent el-name f "" el-body "" el-comment make-alignable-line ]
    if
  ] ;

  \ Parse a line as an alignable definition or block entry, or f.
  (parse-alignable): ( line: string -- alignable-line/f ) [
    pa-line:     swap ;
    pa-trimmed:  pa-line (rtrim-blanks) ;
    pa-width:    pa-line (indent-width) ;
    pa-indent:   pa-line 0 pa-width #slice ;
    pa-stripped: pa-line pa-width pa-line #len #slice ;
    pa-name:     pa-stripped (alignable-name) ;
    pa-marker:   pa-trimmed (inline-comment-pos) ;
    pa-code:     pa-trimmed pa-marker (code-part) ;
    pa-comment:  pa-trimmed pa-marker (trailing-comment) ;

    pa-name f = [ f ] [
      pa-stripped pa-name (after-name) f = [ f ] [
        pa-width 0 =
        [ pa-indent pa-name pa-code pa-comment (definition-line) ]
        [ pa-indent pa-name pa-code pa-comment pa-width (entry-line) ]
        if
      ] if
    ] if
  ] ;

  \ Align every group of like-shaped definition lines, writing the whole text out.
  (symbol-lines): ( stream lines: array -- ) [
    sl-lines:  swap ;
    sl-out:    swap ;
    sl-parsed: sl-lines [ (parse-alignable) ] #map #collect ;
    sl-len:    sl-lines #len ;

    sl-write: ( text -- ) [ sl-out swap stream-write-string drop ] ;
    sl-pad: ( n -- ) [ " " swap repeat sl-write ] ;

    sl-at: ( k -- alignable-line/f ) [ sl-parsed swap #nth ] ;
    sl-parsable?: ( k -- ? ) [ sl-at f = not ] ;
    sl-name-len:  ( k -- n ) [ sl-at name>> #len ] ;
    sl-slice:     ( start end -- array ) [ [ sl-parsed ] 2dip #slice ] ;

    sl-emit-raw: ( start end -- ) [
      swap [ 2dup > ] [ dup sl-lines swap #nth sl-write "\n" sl-write 1 + ] while 2drop
    ] ;

    \ Index just past the run of parsable lines sharing k's indent string.
    sl-group-end: ( k -- idx ) [
      dup sl-at indent>> swap
      [ dup sl-len < [ dup sl-parsable? ] [ f ] if
        [ 2dup sl-at indent>> = ] [ f ] if
      ]
      [ 1 + ] while
      nip
    ] ;

    \ Index just past the sub-run within a group agreeing on start's stack effect.
    sl-run-end: ( start end -- idx ) [
      over sl-at has-effect>> -rot> swap
      [ dup 2 pick-n <
        [ dup sl-at has-effect>> 3 pick-n = ] [ f ] if
      ]
      [ 1 + ] while
      nip nip
    ] ;

    \ The longest and shortest name once the line at k joins a subgroup whose
    \ names already run from min to max. The three carriers stay in place, since
    \ both the join test and the advance need them.
    sl-widened: ( k max min -- k max min max' min' ) [
      2 pick-n sl-name-len
      dup 2 pick-n min
      swap 3 pick-n max
      swap
    ] ;

    \ Index just past the divergence-limited slice starting at start. A candidate
    \ joins while the spread between the longest and shortest name so far is at
    \ most min(shortest, (max-divergence)).
    sl-subgroup-end: ( start end -- idx ) [
      swap dup 1 + swap sl-name-len dup
      [ 2 pick-n 4 pick-n <
        [ sl-widened
          2dup - over (max-divergence) min <=
          -rot> 2drop
        ] [ f ] if
      ]
      [ sl-widened [ 2drop 1 + ] 2dip ]
      while
      2drop nip
    ] ;

    sl-max-name: ( start end -- n ) [ sl-slice 0 [ name>> #len max ] #reduce ] ;
    sl-max-effect: ( start end -- n ) [ sl-slice 0 [ effect>> #len max ] #reduce ] ;

    \ Rebuild every line in [start, end) with its columns padded to the widest.
    sl-emit-aligned: ( start end -- ) [
      ea-end:        swap ;
      ea-start:      swap ;
      ea-name-width: ea-start ea-end sl-max-name ;
      ea-has-effect: ea-start sl-at has-effect>> ;
      ea-effect-width: ea-has-effect [ ea-start ea-end sl-max-effect ] [ 0 ] if ;

      ea-emit: ( k -- ) [
        sl-at
        dup indent>> sl-write
        dup name>> sl-write
        ea-name-width over name>> #len - sl-pad
        ea-has-effect [
          " " sl-write
          dup effect>> sl-write
          ea-effect-width over effect>> #len - sl-pad
        ] when
        " " sl-write
        dup body>> sl-write
        dup suffix>> sl-write
        comment>> dup f = [ drop ] [ "  " sl-write sl-write ] if
        "\n" sl-write
      ] ;

      ea-start [ dup ea-end < ] [ dup ea-emit 1 + ] while drop
    ] ;

    sl-emit-subgroup: ( start end -- ) [
      2dup swap - (min-group-size) < [ sl-emit-raw ] [ sl-emit-aligned ] if
    ] ;

    \ A run splits into divergence-limited subgroups. One shorter than the
    \ minimum goes out untouched, and so does a run too short to split at all.
    sl-emit-run: ( start end -- ) [
      2dup swap - (min-group-size) <
      [ sl-emit-raw ]
      [ swap [ 2dup > ]
        [ 2dup swap sl-subgroup-end 2dup sl-emit-subgroup nip ] while 2drop
      ]
      if
    ] ;

    sl-emit-group: ( start end -- ) [
      swap [ 2dup > ] [ 2dup swap sl-run-end 2dup sl-emit-run nip ] while 2drop
    ] ;

    sl-step: ( k -- k' ) [
      dup sl-parsable?
      [ dup sl-group-end 2dup sl-emit-group nip ]
      [ dup dup 1 + sl-emit-raw 1 + ]
      if
    ] ;

    0 [ dup sl-len < ] [ sl-step ] while drop
  ] ;

  \ Align the definition and block-entry columns in comment-aligned source.
  \
  \ The columns are measured in codepoints, where the host counts bytes. The two
  \ agree on everything but a line carrying non-ASCII text in its name, its stack
  \ effect, or its code before an inline comment marker.
  (align-symbols): ( text: string -- string ) [ [ (symbol-lines) ] (line-pass) ] ;

  \ --- Trailing newline ---

  \ Take the file's final newline off, for `trailing-newline` turned off.
  \
  \ The rule sits on the finished text rather than at either emitter. Two places
  \ write that newline: `(fmt-finish)`, and the `;` arm for a file ending in a
  \ top-level definition. The second one writes a statement separator and cannot
  \ tell that it is the last, so only the finished text can.
  (drop-final-newline): ( text: string -- string ) [
    dup "\n" #ends-with? [ dup #len 1 - #take ] when
  ] ;

  \ --- Config files ---

  \ Every `.fmt.1z` key and the type its value takes. The one place the key set
  \ is written down: the unknown-key test, the type test, and the message that
  \ lists the alternatives all read it.
  (config-keys): ( -- hash ) const [
    H{
      "indent-size" fixnum:
      "max-blank-lines" fixnum:
      "align-min-group" fixnum:
      "align-max-padding" fixnum:
      "align-comments" boolean:
      "align-symbols" boolean:
      "trailing-newline" boolean:
    }
  ] ;

  \ The known keys in one sorted line, for the unknown-key message. `@keys` has
  \ no order of its own, and a diagnostic that reshuffles between runs is worse
  \ than useless in a golden.
  (known-key-list): ( -- string ) [
    (config-keys) @keys [ >string ] #map #collect [ < ] #sort ", " #join
  ] ;

  (config-error): never-returns ( message: string -- * ) [
    f swap EInvalidArgument make-error throw
  ] ;

  \ Check one key the file names, then overlay it on the accumulating hash.
  (merge-key): ( acc raw path: string key: string -- acc ) [
    mk-key:  swap ;
    mk-path: swap ;
    mk-raw:  swap ;

    (config-keys) mk-key @has? not [
      "unknown key '" mk-key #append "' in " #append mk-path #append
      "; known keys are " #append (known-key-list) #append (config-error)
    ] when

    mk-want: (config-keys) mk-key @get ;
    mk-value: mk-raw mk-key @get ;

    mk-want fixnum: =
    [ mk-value fixnum? [ mk-value 0 >= ] [ f ] if ]
    [ mk-value boolean? ]
    if
    not [
      "key '" mk-key #append "' in " #append mk-path #append " must be " #append
      mk-want fixnum: = [ "a non-negative fixnum" ] [ "t or f" ] if #append
      ", got " #append mk-value inspect #append (config-error)
    ] when

    mk-key mk-value @set
  ] ;

  \ Turn what a `.fmt.1z` evaluated to into a config, defaults for absent keys.
  \
  \ The hash shape needs no test here. `config` is a virtual over `hash`, so a
  \ file evaluating to anything else is already rejected at the wrap inside
  \ `load-config-data`.
  (hash>fmt-config): ( raw: hash path: string -- fmt-config ) [
    hf-path: swap ;
    hf-raw: swap ;

    hf-raw @keys [ >string ] #map #collect
    default-fmt-config >hash
    [ [ hf-raw hf-path ] dip (merge-key) ] #reduce
    >fmt-config
  ] ;

  \ The first `.fmt.1z` at or above dir, or f.
  \
  \ The walk stops where `dirname` stops changing, which is the filesystem root
  \ for an absolute path and the working directory for a relative one.
  (find-config-file): ( dir: string -- path/f ) [
    dup ".fmt.1z" path-join
    dup file-exists? [ nip ] [
      drop dup dirname
      2dup = [ 2drop f ] [ nip (find-config-file) ] if
    ] if
  ] ;

  (read-source): ( path: string -- string ) [
    read: stream-open dup stream-read-all swap stream-close bytes>
  ] ;

  (write-source): ( path: string text: string -- ) [
    ws-text: swap ;
    write: stream-open
    dup ws-text stream-write-string drop
    stream-close
  ] ;
}

\\ Reformat 1z source and return the result.
format-source: ( source: string -- string ) [
  1z-tokenize #collect (chunk-tokens)
  dup #len 0 = [ drop "" ] [
    [ (fmt-chunks) ] curry using-string-builder
  ] if
  current-fmt-config get align-comments>> [ (align-comments) ] when
  current-fmt-config get align-symbols>> [ (align-symbols) ] when
  current-fmt-config get trailing-newline>> not [ (drop-final-newline) ] when
] ;

\\ Read a formatter config file, taking the default for every key it omits.
\\
\\ Raises on a key the formatter does not know, on a value of the wrong type,
\\ and on a negative number, each naming the key and the file.
load-fmt-config: ( path: string -- fmt-config ) [
  dup load-config-data config-unwrap swap (hash>fmt-config)
] ;

\\ The config that applies to files in dir: the first `.fmt.1z` at or above it,
\\ or the defaults when there is none.
\\
\\ The search stops at the filesystem root for an absolute path, and at the
\\ working directory for a relative one.
fmt-config-for: ( dir: string -- fmt-config ) [
  (find-config-file) dup f = [ drop default-fmt-config ] [ load-fmt-config ] if
] ;

\\ Read a file and return its reformatted source. The file is left alone.
\\
\\ The rules come from the `.fmt.1z` found at or above the file's directory. To
\\ format under rules of your own, bind `current-fmt-config` around
\\ `format-source` instead.
format-file: ( path: string -- string ) [
  dup dirname fmt-config-for
  swap [ (read-source) format-source ] curry
  [ current-fmt-config ] dip
  with-parameter
] ;

\\ Reformat a file in place, under the same rules `format-file` reads.
format-file!: ( path: string -- ) [
  dup format-file (write-source)
] ;

\\ True when the file's text already equals its formatted form.
formatted?: ( path: string -- ? ) [
  dup (read-source) swap format-file =
] ;

private{

  \ Report a file that differs from its formatted form, in the wording the host
  \ formatter's `--check` uses.
  (fmt-report): ( path: string -- boolean ) [
    fr-path: swap ;
    fr-path formatted?
    dup not [ fr-path " needs formatting" #append eprint-line ] when
  ] ;

  (mode-error): never-returns ( mode: symbol -- * ) [
    me-mode: swap ;
    f "unknown fmt mode " me-mode >string #append EInvalidArgument make-error throw
  ] ;

  \ A symbol nothing else in this module pushes, so a walk down to it cannot
  \ stop early.
  (fmt-mark): ( -- symbol ) const [ fmt-mark: ] ;

  (drop-to-mark): ( ... -- ... ) [
    dup (fmt-mark) = not [ drop (drop-to-mark) ] when
  ] ;

  \ One file under mode, answering whether it came out clean. A failure is
  \ reported and swallowed, so the remaining files still get their turn.
  \
  \ `recover` does not rewind the stack, so a raise leaves behind whatever the
  \ failing path had already pushed. The depth to unwind to is therefore marked
  \ before the attempt.
  \
  \ The failure message names the file and the raised text. It does not match
  \ the host formatter's wording, which renders a Zig error value.
  (fmt-one): ( path: string mode: symbol -- boolean ) [
    fo-mode: swap ;
    fo-path: swap ;
    (fmt-mark)
    [
      fo-mode {
        { check: [ fo-path (fmt-report) ] }
        { in-place: [ fo-path format-file! t ] }
        { stdout: [ fo-path format-file print t ] }
        [ (mode-error) ]
      } case
    ] [
      message: @get
      "Error formatting '" fo-path #append "': " #append swap #append
      fo-message: swap ;
      (drop-to-mark)
      fo-message eprint-line
      f
    ] recover
    nip
  ] ;
}

\\ Format every file in one of three modes, for the `1z fmt` subcommand.
\\
\\ `check:` names each file differing from its formatted form on stderr.
\\ `in-place:` rewrites each file. `stdout:` prints each formatted result.
\\
\\ Leaves t when every file was already formatted and none failed, which the
\\ caller turns into the process exit status.
\\
\\   { "lib/strings.1z" } check: run-fmt
\\   => t
run-fmt: ( files: array mode: symbol -- boolean ) [
  rf-mode: swap ;
  t [ rf-mode (fmt-one) and ] #reduce
] ;
