\ Time library - durations, timestamps, and formatting

\ Duration: virtual type backed by integer (nanoseconds)
duration: virtual{ integer } ;

\ Convenience constructors for durations
nanoseconds:  ( n -- duration ) [ >duration ] ;
microseconds: ( n -- duration ) [ 1000 * >duration ] ;
milliseconds: ( n -- duration ) [ 1000000 * >duration ] ;
seconds:      ( n -- duration ) [ 1000000000 * >duration ] ;
minutes:      ( n -- duration ) [ 60 * seconds ] ;
hours:        ( n -- duration ) [ 60 * minutes ] ;

\ Timestamp: virtual type backed by struct{ sec nsec }
timestamp-inner: struct{ sec nsec } ;
timestamp: virtual{ timestamp-inner } ;

\ Constructor from sec/nsec components
make-timestamp: ( sec nsec -- timestamp ) [ make-timestamp-inner >timestamp ] ;

\ Accessors
timestamp-sec:  ( timestamp -- sec )  [ timestamp> sec>> ] ;
timestamp-nsec: ( timestamp -- nsec ) [ timestamp> nsec>> ] ;

\ Create timestamp from current wall-clock time
now: ( -- timestamp ) [ clock-realtime make-timestamp ] ;

\ Duration arithmetic (dispatch via polymorphism hooks)
+: method{ duration duration } [ swap duration> swap duration> + >duration ] ;
-: method{ duration duration } [ swap duration> swap duration> - >duration ] ;
*: method{ duration integer } [ swap duration> swap * >duration ] ;
*: method{ integer duration } [ duration> * >duration ] ;
