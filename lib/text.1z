\ lib/text.1z - Line-oriented text processing

\ Reducer to split by newline
\ acc: { lines-array  current-line-string }
split-nl: ( acc char -- acc' ) [
  dup "\n" =
  [
    \ Newline: flush current line into lines if non-empty
    drop
    dup 1 #nth
    dup #len 0 >
    [
      over 0 #nth               \ acc current lines
      swap 1array #append       \ acc lines'
      nip                       \ lines'
      1array "" 1array #append  \ { lines' "" }
    ]
    [ drop ]
    if
  ]
  [
    \ Other: append to current line, rebuild accumulator
    over 1 #nth swap #append     \ acc new-current
    swap 0 #nth                  \ new-current lines
    1array swap 1array #append   \ { lines new-current }
  ]
  if
] ;

\ Flush the last line from accumulator into lines array
flush-last: ( acc -- lines ) [
  dup 1 #nth
  dup #len 0 >
  [ over 0 #nth swap 1array #append nip ]
  [ drop 0 #nth ]
  if
] ;

\ Split a string into an array of non-empty lines
split-lines: ( str -- lines ) [
  { { } "" } [ split-nl ] #reduce
  flush-last
] ;

\ Read a file and return its non-empty lines as an array
read-lines: ( path -- lines ) [
  read: stream-open
  dup stream-read-all swap stream-close
  bytes> split-lines
] ;
