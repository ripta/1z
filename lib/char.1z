\ lib/char.1z - ASCII character classification predicates

use "conversions" ;

\\ Test if single-character string is an ASCII uppercase letter (A-Z).
upper?: ( str -- ? ) [
  >codepoint dup 65 >= swap 90 <= and
] ;

\\ Test if single-character string is an ASCII lowercase letter (a-z).
lower?: ( str -- ? ) [
  >codepoint dup 97 >= swap 122 <= and
] ;

\\ Test if single-character string is an ASCII letter (a-z or A-Z).
alpha?: ( str -- ? ) [
  dup upper? swap lower? or
] ;

\\ Test if single-character string is an ASCII letter or digit.
alnum?: ( str -- ? ) [
  dup alpha? swap digit? or
] ;

\\ Test if single-character string is in the ASCII range (codepoint 0-127).
ascii?: ( str -- ? ) [
  >codepoint dup 0 >= swap 127 <= and
] ;

\\ Test if single-character string is a printable ASCII character (codepoint 32-126).
printable?: ( str -- ? ) [
  >codepoint dup 32 >= swap 126 <= and
] ;

\\ Test if single-character string is a hexadecimal digit (0-9, a-f, A-F).
hex-digit?: ( str -- ? ) [
  >codepoint
  dup dup 48 >= swap 57 <= and  \ 0-9
  [ drop t ]
  [ dup dup 65 >= swap 70 <= and  \ A-F
    [ drop t ]
    [ dup 97 >= swap 102 <= and ]  \ a-f
    if
  ]
  if
] ;

private{
  (not-a-hex-digit): never-returns ( str: string -- * ) [
    H{ } offset: 0 @set text: 2 pick-n @set
    "not a hex digit '" <rot- #append "'" #append throw-parse-error
  ] ;
}

\\ Convert a single hex digit character to its integer value (0-15).
\\ Raises parse-error: at position 0 on non-hex input.
hex>fixnum: ( str -- n ) [
  dup >codepoint
  dup dup 48 >= swap 57 <= and  \ 0-9
  [ 48 - nip ]
  [ dup dup 65 >= swap 70 <= and  \ A-F
    [ 65 - 10 + nip ]
    [ dup dup 97 >= swap 102 <= and  \ a-f
      [ 97 - 10 + nip ]
      [ drop (not-a-hex-digit) ]
      if
    ]
    if
  ]
  if
] ;

pragma{ lint-suppress: { broad-import: dead-definition: missing-type-annotation: } }
