\ lib/conversions.1z - Numeric conversions

\\ The value of a single ASCII digit character. Any other character gives its code point minus 48,
\\ so check it with `digit?` first.
\\
\\   "7" char>digit
\\   => 7
char>digit: ( str -- n ) [ >codepoint 48 - ] ;

\\ True when a single-character string is an ASCII digit, `0` through `9`.
digit?: ( str -- ? ) [
  >codepoint dup 48 >= swap 57 <= and
] ;

\\ Parse an integer literal, with any base prefix and digit separator the reader accepts.
\\
\\ Throws `parse-error` when the string is not a literal, or is a literal that is not an integer.
\\
\\   "0xFF" parse-integer
\\   => 255
parse-integer: ( str -- n ) [
  resolve-literal
  [ dup type-of dup fixnum = swap bignum = or
    [ drop f "not an integer" EParseError make-error throw ] unless
  ]
  [ drop f "invalid integer" EParseError make-error throw ]
  if
] ;

\\ Parse a float. An integer string becomes the equal float. Throws `type-mismatch` on a
\\ non-numeric string.
\\
\\   "5" parse-float
\\   => 5.0
parse-float: ( str -- f ) [ >float ] ;

\\ Parse a boolean, ignoring case. `true`, `t`, `1`, and `yes` give `t`. `false`, `f`, `0`, and `no`
\\ give `f`. Any other spelling throws `parse-error`.
\\
\\   "Yes" parse-boolean
\\   => t
parse-boolean: ( str -- ? ) [
  lowercase
  dup { "true" "t" "1" "yes" } swap #in?
  [ drop t ]
  [ dup { "false" "f" "0" "no" } swap #in?
    [ drop f ]
    [ drop f "invalid boolean" EParseError make-error throw ]
    if
  ]
  if
] ;

pragma{ lint-suppress: { dead-definition: missing-type-annotation: } }
