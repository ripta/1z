\ lib/conversions.1z - Numeric conversions

\ Convert single-digit character string to integer
\ "0" -> 0, "9" -> 9
char>digit: ( str -- n ) [ >codepoint 48 - ] ;

\ Check if single-char string is an ASCII digit
digit?: ( str -- ? ) [
  >codepoint dup 48 >= swap 57 <= and
] ;

\ Parse integer from string, supporting all bases and separators
\ "123" -> 123, "-42" -> -42, "0xFF" -> 255, "0o777" -> 511, "0b101" -> 5
parse-integer: ( str -- n ) [
  resolve-literal
  [ dup type-of dup fixnum = swap bignum = or
    [ "not an integer" throw ] unless
  ]
  [ "invalid integer" throw ]
  if
] ;
