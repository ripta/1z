\ lib/conversions.1z - Numeric conversions

\ Convert single-digit character string to integer
\ "0" -> 0, "9" -> 9
char>digit: ( str -- n ) [ >codepoint 48 - ] ;

\ Check if single-char string is an ASCII digit
digit?: ( str -- ? ) [
  >codepoint dup 48 >= swap 57 <= and
] ;

\ Parse integer from string, supporting all bases and separators
\ "123" -> 123, "-42" -> -42, "0xFF" -> 255, "0o777" -> 511, "0b101" -> 5
parse-integer: ( str -- n ) [
  resolve-literal
  [ dup type-of dup fixnum = swap bignum = or
    [ drop f "not an integer" EParseError make-error throw ] unless
  ]
  [ drop f "invalid integer" EParseError make-error throw ]
  if
] ;

\ Parse a float from a string. "0.25" -> 0.25, "5" -> 5.0. Throws on non-numeric.
parse-float: ( str -- f ) [ >float ] ;

\ Parse a boolean from a string using the flag spelling table. Case-insensitive.
\ true/t/1/yes -> t ; false/f/0/no -> f ; any other spelling throws.
parse-boolean: ( str -- ? ) [
  lowercase
  dup { "true" "t" "1" "yes" } swap #in?
  [ drop t ]
  [ dup { "false" "f" "0" "no" } swap #in?
    [ drop f ]
    [ drop f "invalid boolean" EParseError make-error throw ]
    if
  ]
  if
] ;
