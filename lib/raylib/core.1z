\ lib/raylib/core.1z - Raylib core window and drawing via dynamic FFI

use "ffi" ;
use "raylib/types" ;

"raylib" lib-open ffi-def{
  (init-window):         "InitWindow" ffi{ i32 i32 cstring -> void }
  (close-window):        "CloseWindow" ffi{ -> void }
  (window-should-close): "WindowShouldClose" ffi{ -> bool }
  (begin-drawing):       "BeginDrawing" ffi{ -> void }
  (end-drawing):         "EndDrawing" ffi{ -> void }
  (clear-background):    "ClearBackground" ffi{ Color -> void }
  (draw-rectangle):      "DrawRectangle" ffi{ i32 i32 i32 i32 Color -> void }
  (is-key-pressed):      "IsKeyPressed" ffi{ i32 -> bool }
  (set-target-fps):      "SetTargetFPS" ffi{ i32 -> void }
} call "raylib-core-raw" swap >module import

\\ Initialize a window with given dimensions and title. C: InitWindow
init-window: ( width height title -- ) [ (init-window) ] ;
\\ Close the current window and OpenGL context. C: CloseWindow
close-window: ( -- ) [ (close-window) ] ;
\\ Check if the window close button or ESC key has been pressed. C: WindowShouldClose
window-should-close?: ( -- bool ) [ (window-should-close) ] ;
\\ Begin drawing to the default framebuffer. C: BeginDrawing
begin-drawing: ( -- ) [ (begin-drawing) ] ;
\\ End drawing and swap buffers. C: EndDrawing
end-drawing: ( -- ) [ (end-drawing) ] ;
\\ Clear the background with a color. C: ClearBackground
clear-background: ( color -- ) [ (clear-background) ] ;
\\ Draw a filled rectangle at position (x, y) with given size and color. C: DrawRectangle
draw-rectangle: ( x y width height color -- ) [ (draw-rectangle) ] ;
\\ Check if a specific key has been pressed once. C: IsKeyPressed
key-pressed?: ( key -- bool ) [ (is-key-pressed) ] ;
\\ Set the target frames per second. C: SetTargetFPS
set-target-fps: ( fps -- ) [ (set-target-fps) ] ;

\\ Open a window, run a quotation, and close the window on exit.
with-window: ( width height title quot -- ... ) [
  [ init-window ] dip
  [ close-window ] cleanup
] ;

\\ Execute a quotation between begin-drawing and end-drawing calls.
draw: ( quot -- ) [
  begin-drawing
  [ end-drawing ] cleanup
] ;
