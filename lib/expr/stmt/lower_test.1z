\ Runtime-equivalence tests for the `stmt{ }` surface form and its lowering.
\ Each block is compared to the hand-written 1z it lowers to.

use "testing" ;
use "expr" ;

\ Callees the statement blocks invoke. `sub2` is non-commutative, so it also
\ verifies left-to-right argument order.
add1: ( n -- n )   [ 1 + ] ;
dbl:  ( n -- n )   [ 2 * ] ;
sub2: ( a b -- c ) [ - ] ;

\ Conditions. A hosted condition is an ordinary expression, so a call returning
\ a boolean is the smallest one that exercises both outcomes.
yes: ( -- ? ) [ t ] ;
no: ( -- ? ) [ f ] ;

\ A fixed number for the bare-identifier comparisons, so they do not depend on
\ the loop counters the tests below advance.
five: ( -- n ) [ 5 ] ;

\ The external state the loop tests advance. A hosted statement has no locals,
\ so a loop terminates through state its body mutates by side effect. The step
\ cell is the second counter a nested loop needs to bound its outer iteration.
\
\ Every word a hosted call names is alphanumeric, because the expression lexer
\ matches an identifier as a letter followed by alphanumerics and would split a
\ kebab-case name on its `-`.
tick-cell: V{ 0 } ;
step-cell: V{ 0 } ;

ticks:  ( -- n ) [ tick-cell 0 #nth ] ;
steps:  ( -- n ) [ step-cell 0 #nth ] ;
bump:   ( -- )   [ tick-cell 0 ticks 1 + #nth! drop ] ;
step:   ( -- )   [ step-cell 0 steps 1 + #nth! drop ] ;
under3: ( -- ? ) [ ticks 3 < ] ;
under2: ( -- ? ) [ steps 2 < ] ;

\ The cells are module state shared by every test, so each loop test starts from
\ zero.
reset-counters: ( -- ) [
  tick-cell 0 0 #nth! drop
  step-cell 0 0 #nth! drop
] ;

"single statement" test-section

test-single-call: ( -- ) [
  stmt{ add1(41) } 41 add1 "add1(41) matches 41 add1" assert=
] ;

test-single-expression: ( -- ) [
  stmt{ 1 + 2 * 3 } 1 2 3 * + "an expression statement matches its postfix form" assert=
] ;

test-trailing-semicolon: ( -- ) [
  stmt{ add1(41); } 41 add1 "a trailing ';' changes nothing" assert=
] ;

"sequencing" test-section

test-two-statements: ( -- ) [
  stmt{ add1(1); dbl(3) }
  6 "the second statement's value is on top" assert=
  2 "the first statement's value is beneath it" assert=
] ;

test-statement-order: ( -- ) [
  \ sub2 is not commutative, so this pins the order statements run in.
  stmt{ sub2(10, 3); sub2(3, 10) }
  -7 "the second statement computed 3 - 10" assert=
  7 "the first statement computed 10 - 3" assert=
] ;

test-empty-block: ( -- ) [
  7 stmt{ } 7 "an empty block emits nothing" assert=
] ;

"groups" test-section

test-group-flattens: ( -- ) [
  stmt{ { add1(1); dbl(3) } }
  6 "a group emits its members with no wrapper" assert=
  2 "the group's first member ran first" assert=
] ;

test-group-then-statement: ( -- ) [
  stmt{ { add1(1) }; dbl(3) }
  6 "the statement after a group runs after it" assert=
  2 "the group's statement ran first" assert=
] ;

test-nested-group: ( -- ) [
  stmt{ { { add1(1) }; dbl(3) } }
  6 "a nested group's members still run in order" assert=
  2 "the innermost group ran first" assert=
] ;

test-group-brace-spacing: ( -- ) [
  stmt{ {add1(1); dbl(3)} }
  6 "an unspaced group brace lowers the same" assert=
  2 "and its first member still ran first" assert=
] ;

"else-less conditional" test-section

test-when-taken: ( -- ) [
  stmt{ if yes() then add1(1) }
  yes [ 1 add1 ] when "a taken else-less conditional matches its `when`" assert=
] ;

test-when-not-taken: ( -- ) [
  \ The branch runs for its effect, so an untaken one leaves the stack alone.
  7 stmt{ if no() then add1(1) }
  7 "an untaken else-less conditional emits nothing" assert=
] ;

test-when-comparison-condition: ( -- ) [
  stmt{ if 1 + 2 < 4 then add1(1) }
  1 2 + 4 < [ 1 add1 ] when "a comparison condition matches its `when`" assert=
] ;

"two-branch conditional" test-section

test-if-taken: ( -- ) [
  stmt{ if yes() then add1(1) else dbl(3) }
  yes [ 1 add1 ] [ 3 dbl ] if "a taken conditional matches its `if`" assert=
] ;

test-if-not-taken: ( -- ) [
  stmt{ if no() then add1(1) else dbl(3) }
  no [ 1 add1 ] [ 3 dbl ] if "an untaken conditional matches its `if`" assert=
] ;

"group branches" test-section

test-group-branch-runs-in-order: ( -- ) [
  stmt{ if yes() then { add1(1); dbl(3) } else dbl(0) }
  6 "the group branch's second statement is on top" assert=
  2 "its first statement is beneath it" assert=
] ;

test-group-branch-not-taken: ( -- ) [
  stmt{ if no() then { add1(1); dbl(3) } else dbl(4) }
  8 "an untaken group branch runs nothing" assert=
] ;

"nesting" test-section

test-dangling-else-binds-inward: ( -- ) [
  \ The else belongs to the inner conditional, so this is `when` around `if`.
  stmt{ if yes() then if no() then add1(1) else dbl(3) }
  yes [ no [ 1 add1 ] [ 3 dbl ] if ] when
  "a dangling else lowers as the inner conditional's" assert=
] ;

test-group-moves-else-outward: ( -- ) [
  \ The group closes the inner conditional, so this is `if` around `when`.
  stmt{ if no() then { if yes() then add1(1) } else dbl(3) }
  no [ yes [ 1 add1 ] when ] [ 3 dbl ] if
  "a group in the then position lowers the else to the outer conditional" assert=
] ;

test-else-if-chain: ( -- ) [
  stmt{ if no() then add1(1) else if yes() then dbl(3) else dbl(4) }
  no [ 1 add1 ] [ yes [ 3 dbl ] [ 4 dbl ] if ] if
  "an else-if chain matches its nested `if`" assert=
] ;

"loop" test-section

test-loop-runs-until-the-condition-fails: ( -- ) [
  reset-counters
  stmt{ while under3() do bump() }
  ticks 3 "the loop ran until its condition went false" assert=
] ;

test-loop-matches-hand-written-while: ( -- ) [
  reset-counters stmt{ while under3() do bump() } ticks
  reset-counters [ under3 ] [ bump ] while ticks
  "a loop matches its hand-written `while`" assert=
] ;

test-loop-not-entered: ( -- ) [
  \ The condition is checked before the first iteration, so a false one leaves
  \ both the counter and the stack alone.
  reset-counters
  9 stmt{ while no() do bump() }
  9 "an untaken loop emits nothing onto the stack" assert=
  ticks 0 "and never ran its body" assert=
] ;

test-loop-group-body: ( -- ) [
  reset-counters
  stmt{ while under3() do { bump(); bump() } }
  ticks 4 "a group body runs both its statements each iteration" assert=
] ;

test-loop-comparison-condition: ( -- ) [
  reset-counters
  stmt{ while ticks() < 2 do bump() }
  ticks 2 "a comparison condition is re-evaluated each iteration" assert=
] ;

test-conditional-in-loop-body: ( -- ) [
  reset-counters
  stmt{ while under3() do if yes() then bump() }
  ticks 3 "a conditional body runs each iteration" assert=
] ;

test-loop-in-branch: ( -- ) [
  reset-counters
  stmt{ if yes() then while under3() do bump() }
  ticks
  reset-counters
  yes [ [ under3 ] [ bump ] while ] when
  ticks
  "a loop in a branch matches its hand-written form" assert=
] ;

test-nested-loops: ( -- ) [
  \ The inner condition is already false on the second outer pass, so this also
  \ pins that the inner loop re-checks rather than replaying its first result.
  reset-counters
  stmt{ while under2() do { step(); while under3() do bump() } }
  steps 2 "the outer loop ran twice" assert=
  ticks 3 "and the inner loop only ran on the first pass" assert=
] ;

"bare identifiers" test-section

\ A bare identifier is a call of the word of that name, in every position. The
\ inline emission path and the quotation-value path reach a condition through
\ different lowering words, so each position is pinned separately.

test-bare-identifier-statement: ( -- ) [
  stmt{ yes } yes "a bare identifier statement calls the word" assert=
] ;

test-bare-identifier-top-level-condition: ( -- ) [
  stmt{ if yes then add1(1) }
  yes [ 1 add1 ] when "a top-level bare condition matches its `when`" assert=
] ;

test-bare-identifier-comparison-taken: ( -- ) [
  stmt{ if five > 3 then add1(1) }
  five 3 > [ 1 add1 ] when "a bare-identifier comparison matches its `when`" assert=
] ;

test-bare-identifier-comparison-not-taken: ( -- ) [
  7 stmt{ if five < 3 then add1(1) }
  7 "an untaken bare-identifier comparison emits nothing" assert=
] ;

test-bare-identifier-nested-condition: ( -- ) [
  \ A nested branch becomes a quotation value, so its condition lowers through
  \ the other path.
  stmt{ if yes() then if no then add1(1) else dbl(3) }
  yes [ no [ 1 add1 ] [ 3 dbl ] if ] when
  "a nested bare condition matches its hand-written form" assert=
] ;

test-bare-identifier-loop-condition: ( -- ) [
  reset-counters
  stmt{ while under3 do bump() }
  ticks 3 "a bare loop condition is re-evaluated each iteration" assert=
] ;

"sequencing with conditionals" test-section

test-conditional-among-statements: ( -- ) [
  stmt{ add1(1); if yes() then dbl(3); add1(9) }
  10 "the statement after a conditional runs after it" assert=
  6 "the conditional's branch value is beneath it" assert=
  2 "the statement before it ran first" assert=
] ;

"multiline input" test-section

test-multiline: ( -- ) [
  stmt{
    add1(10);
    dbl(4)
  }
  8 "the second line's statement is on top" assert=
  11 "the first line's statement is beneath it" assert=
] ;

"forward reference" test-section

\ A call resolves through ordinary lookup, so a callee defined after the stmt{
\ use still works: the emitted call_word is resolved at run time.
test-forward-reference: ( -- ) [
  stmt{ fwd9(5) } 5 fwd9 "fwd9(5) resolves a forward-referenced callee" assert=
] ;

fwd9: ( n -- n ) [ 9 + ] ;

"public pipeline" test-section

test-parse-stmt-reachable: ( -- ) [
  "a(); b()" parse-stmt group-stmt? "parse-stmt is reachable through the expr facade" assert-true
] ;
