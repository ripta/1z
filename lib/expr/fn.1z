\ lib/expr/fn.1z: parser for the hosted function-definition sugar.
\
\ Parses a `name(params) = rhs` declaration into an fn-decl. The whole declaration is lexed once
\ with the punctuation-splitting sub-lexer the RHS uses (EXPR-LEXER / tokenize-expr from
\ expr/parser), so `square(a, b)` needs no internal spacing and every reported offset indexes the
\ declaration itself. The tokens after the first `=` are parsed by expr/parser's Pratt parser.
\ Lowering the fn-decl to an ordinary word definition lives elsewhere; this module only parses.

use "sequences" ;
use "lexer" ;
use "expr/parser" ;
use "expr/ast" ;
use { parse-complete: } "pratt" ;

\\ A parsed hosted function declaration: the word name, its ordered parameter
\\ names, and the right-hand-side expression node.
fn-decl: struct{ name params rhs } ;

private{
  (fn-error): never-returns ( token what: string -- * ) [
    swap pos>> [ H{ } offset: ] dip @set swap throw-parse-error
  ] ;

  \ Parse the comma-separated parameter names between '(' and ')'. `idx` points
  \ at the token expected to be either ')' (only with an empty accumulator, the
  \ zero-parameter case) or a parameter word. Mirrors (parse-args-loop) in
  \ expr/parser, collecting identifier strings instead of expression nodes.
  (parse-fn-params): stack-recursive ( tokens idx acc -- params ) [
    2 pick-n 2 pick-n #nth
    \ tokens idx acc tok
    dup value>> ")" = [
      drop
      \ ')' closes the list here. Valid only as an empty list; reaching it with a
      \ non-empty accumulator means the list ended on a dangling ','.
      dup #len 0 = [
        >array nip nip
      ] [
        2 pick-n 2 pick-n 1 - #nth
        "fn header: unexpected ',' before ')' in parameter list" (fn-error)
      ] if
    ] [
      dup kind>> word: = not [ "fn header: expected parameter name" (fn-error) ] when
      value>>
      \ tokens idx acc pname
      over swap #push! drop
      \ tokens idx acc
      2 pick-n 2 pick-n 1 + #nth
      \ tokens idx acc tok2
      dup value>> ")" = [
        drop >array nip nip
      ] [
        dup value>> "," = [
          drop
          swap 2 + swap
          (parse-fn-params)
        ] [
          "fn header: expected ',' or ')' in parameter list" (fn-error)
        ] if
      ] if
    ] if
  ] ;

  \ Parse the `name(params)` header tokens into the name and an array of parameter names. `eq` is
  \ the `=` token that ended the header, where a header too short to be one is reported.
  (parse-fn-header): ( tokens eq -- name params ) [
    over #len 3 < [ "fn header: expected name '(' ')'" (fn-error) ] when
    drop
    dup dup #len 1 - #nth
    dup value>> ")" = not [ "fn header: expected ')' at end of header" (fn-error) ] when
    drop
    dup 0 #nth
    dup kind>> word: = not [ "fn header: expected function name" (fn-error) ] when
    value>> swap
    \ name tokens
    dup 1 #nth
    dup value>> "(" = not [ "fn header: expected '(' after function name" (fn-error) ] when
    drop
    2 V{ } (parse-fn-params)
    \ name params
  ] ;

  \ Pull header tokens into acc up to the first `=` token, which is left on top. The iterator is
  \ left positioned at the first RHS token. Running out first is a missing `=`, reported at the
  \ end of source.
  (read-fn-header): stack-recursive ( source iterator acc -- source iterator acc eq ) [
    over #next?
    dup option:some? [
      option:some>
      dup value>> "=" = [ ] [ over swap #push! drop (read-fn-header) ] if
    ] [
      drop
      2 pick-n #len [ H{ } offset: ] dip @set "fn: expected '='" throw-parse-error
    ] if
  ] ;
}

\\ Parse a hosted function declaration source string, of the form
\\ `name(params) = rhs`, into an fn-decl. The header and the RHS are lexed together with the
\\ shared punctuation-splitting sub-lexer, and the RHS is parsed by expr/parser's Pratt parser.
\\
\\ A missing '=', a malformed header, or a malformed RHS raises `parse-error:`, with the codepoint
\\ offset into source under `offset:`.
parse-fn: ( source: string -- fn-decl ) [
  dup tokenize-expr V{ } (read-fn-header)
  \ source iterator acc eq
  [ >array ] dip (parse-fn-header)
  \ source iterator name params
  2 pick-n <expr-pratt> parse-complete
  \ source iterator name params rhs
  make-fn-decl nip nip
] ;
