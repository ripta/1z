\ lib/expr/lower.1z: lower an expr-node AST to a quotation that computes its value.

use "strings" ;
use "sequences" ;
use "expr/ast" ;

private{
  \ Map each binary operator string to the quotation that performs it. The keys
  \ match pratt/arith's operator table; a node carrying an unknown operator makes
  \ @get throw, which is the correct failure.
  (BINOP-QUOTS): const [
    H{
      "+" [ + ]
      "-" [ - ]
      "*" [ * ]
      "/" [ / ]
    }
  ] ;
}

\\ Lower an expr-node AST into a quotation that computes the expression's value.
lower: ( node: expr-node -- quotation ) [
  match{
    expr-node:lit: [  \ ( value )
      [ ] curry       \ [ value ]
    ]
    expr-node:unop: [  \ ( op operand )
      \ Only unary minus exists, so the operator is discarded; negate by `-1 *`,
      \ matching arith-prefix in pratt/arith.
      nip  \ ( operand )
      lower [ -1 * ] compose
    ]
    expr-node:binop: [         \ ( op left right )
      lower swap               \ ( op [R] left )
      lower swap               \ ( op [L] [R] )
      compose                  \ ( op [ L R ] )
      swap                     \ ( [ L R ] op )
      (BINOP-QUOTS) swap @get  \ ( [ L R ] [op] )
      compose                  \ ( [ L R op ] )
    ]
    expr-node:invoke: [  \ ( callee args )
      \ Lower each argument to a quotation, concatenate them in source order, then
      \ append a call to the callee. `>quotation` builds a bare `call_word` even
      \ for a not-yet-defined word, so forward references resolve like ordinary 1z.
      [ lower ] #map #collect  \ ( callee [q1 q2 ...] )
      [ ] [ compose ] #reduce  \ ( callee [ q1 q2 ... ] )
      swap >quotation compose  \ ( [ q1 q2 ... callee ] )
    ]
    expr-node:ref: [  \ ( name )
      \ A parameter reference lowers to a call of the bound local word. The fn
      \ surface binds each parameter to a local word that pushes its value.
      >quotation
    ]
  }
] ;

\\ Emit an expr-node AST as inline 1z instructions in postfix, left-to-right
\\ order. Operands and arguments are emitted before their operator or callee, so
\\ evaluation is left-to-right, matching source reading order and equivalent
\\ hand-written 1z. `expr{ f(1) + 2 }` emits `1 f 2 +`.
\\
\\ Emission uses the parse-time emit-body / emit-call splicing, so emit-expr must
\\ run inside a parse-time word (expr{). A call lowers to an ordinary call_word
\\ by name via emit-call, so it resolves through normal 1z lookup, including
\\ forward references, exactly like hand-written code.
emit-expr: ( node: expr-node -- ) [
  match{
    expr-node:lit: [       \ ( value )
      [ ] curry emit-body  \ splice `push value`
    ]
    expr-node:unop: [  \ ( op operand )
      \ Only unary minus exists; discard the operator and negate by `-1 *`.
      nip emit-expr
      [ -1 * ] emit-body
    ]
    expr-node:binop: [   \ ( op left right )
      swap emit-expr     \ emit left, then ( op right )
      emit-expr          \ emit right, then ( op )
      >symbol emit-call  \ emit the operator word
    ]
    expr-node:invoke: [    \ ( callee args )
      [ emit-expr ] #each  \ emit each argument in source order, then ( callee )
      >symbol emit-call    \ emit the call
    ]
    expr-node:ref: [  \ ( name )
      \ A bare identifier is only meaningful inside an fn body, where parameters
      \ are bound; in a plain expression it is an error.
      drop f "a bare identifier reference is only valid in an fn body" throw
    ]
  }
] ;
