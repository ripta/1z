\ Unit tests for lib/expr/parser.1z.

use "testing" ;
use "sequences" ;
use "lexer" ;
use "expr/parser" ;
use "expr/ast" ;

\ Extract a literal node's value, throwing on any other node kind.
lit-value: ( expr-node -- value ) [
  match{
    expr-node:lit:    [ ]
    expr-node:unop:   [ drop drop f "expected lit, got unop" throw ]
    expr-node:binop:  [ drop drop drop f "expected lit, got binop" throw ]
    expr-node:invoke: [ drop drop f "expected lit, got invoke" throw ]
    expr-node:ref:    [ drop f "expected lit, got ref" throw ]
  }
] ;

\ Extract a unary node's operator and operand, throwing on any other node kind.
unop-parts: ( expr-node -- op operand ) [
  match{
    expr-node:lit:    [ drop f "expected unop, got lit" throw ]
    expr-node:unop:   [ ]
    expr-node:binop:  [ drop drop drop f "expected unop, got binop" throw ]
    expr-node:invoke: [ drop drop f "expected unop, got invoke" throw ]
    expr-node:ref:    [ drop f "expected unop, got ref" throw ]
  }
] ;

\ Extract a binary node's operator and operands, throwing on any other node kind.
binop-parts: ( expr-node -- op left right ) [
  match{
    expr-node:lit:    [ drop f "expected binop, got lit" throw ]
    expr-node:unop:   [ drop drop f "expected binop, got unop" throw ]
    expr-node:binop:  [ ]
    expr-node:invoke: [ drop drop f "expected binop, got invoke" throw ]
    expr-node:ref:    [ drop f "expected binop, got ref" throw ]
  }
] ;

\ Extract an invoke node's callee name and argument array, throwing on any other
\ node kind.
invoke-parts: ( expr-node -- callee args ) [
  match{
    expr-node:lit:    [ drop f "expected invoke, got lit" throw ]
    expr-node:unop:   [ drop drop f "expected invoke, got unop" throw ]
    expr-node:binop:  [ drop drop drop f "expected invoke, got binop" throw ]
    expr-node:invoke: [ ]
    expr-node:ref:    [ drop f "expected invoke, got ref" throw ]
  }
] ;

\ Extract a reference node's identifier name, throwing on any other node kind.
ref-name: ( expr-node -- name ) [
  match{
    expr-node:lit:    [ drop f "expected ref, got lit" throw ]
    expr-node:unop:   [ drop drop f "expected ref, got unop" throw ]
    expr-node:binop:  [ drop drop drop f "expected ref, got binop" throw ]
    expr-node:invoke: [ drop drop f "expected ref, got invoke" throw ]
    expr-node:ref:    [ ]
  }
] ;

"parse shape" test-section

test-single-number: ( -- ) [
  "42" parse-expr lit-value 42 "single number is lit 42" assert=
] ;

test-addition: ( -- ) [
  "1 + 2" parse-expr binop-parts  \ op left right
  lit-value 2 "addition right operand" assert=
  lit-value 1 "addition left operand" assert=
  "+" "addition operator" assert=
] ;

"operator precedence" test-section

test-mul-binds-under-add: ( -- ) [
  "1 + 2 * 3" parse-expr binop-parts  \ op left right
  binop-parts                         \ op left iop il ir
  lit-value 3 "1 + 2 * 3: nested right is 3" assert=
  lit-value 2 "1 + 2 * 3: nested left is 2" assert=
  "*" "1 + 2 * 3: nested op is *" assert=
  lit-value 1 "1 + 2 * 3: outer left is 1" assert=
  "+" "1 + 2 * 3: outer op is +" assert=
] ;

test-mul-before-add: ( -- ) [
  "2 * 3 + 1" parse-expr binop-parts  \ op left right
  lit-value 1 "2 * 3 + 1: outer right is 1" assert=
  binop-parts  \ op iop il ir
  lit-value 3 "2 * 3 + 1: nested right is 3" assert=
  lit-value 2 "2 * 3 + 1: nested left is 2" assert=
  "*" "2 * 3 + 1: nested op is *" assert=
  "+" "2 * 3 + 1: outer op is +" assert=
] ;

"left associativity" test-section

test-subtraction-left-assoc: ( -- ) [
  "10 - 3 - 2" parse-expr binop-parts  \ op left right
  lit-value 2 "10 - 3 - 2: outer right is 2" assert=
  binop-parts  \ op iop il ir
  lit-value 3 "10 - 3 - 2: inner right is 3" assert=
  lit-value 10 "10 - 3 - 2: inner left is 10" assert=
  "-" "10 - 3 - 2: inner op is -" assert=
  "-" "10 - 3 - 2: outer op is -" assert=
] ;

"comparison operators" test-section

test-less-than: ( -- ) [
  "1 < 2" parse-expr binop-parts  \ op left right
  lit-value 2 "1 < 2: right is 2" assert=
  lit-value 1 "1 < 2: left is 1" assert=
  "<" "1 < 2: operator is <" assert=
] ;

test-two-character-comparison: ( -- ) [
  \ The lexer tries `<=` before `<`, so this is one operator, not two tokens.
  "1 <= 2" parse-expr binop-parts  \ op left right
  lit-value 2 "1 <= 2: right is 2" assert=
  lit-value 1 "1 <= 2: left is 1" assert=
  "<=" "1 <= 2: operator is <=" assert=
] ;

test-comparison-binds-under-addition: ( -- ) [
  "1 + 2 < 4" parse-expr binop-parts  \ op left right
  lit-value 4 "1 + 2 < 4: right is 4" assert=
  binop-parts  \ op iop il ir
  lit-value 2 "1 + 2 < 4: nested right is 2" assert=
  lit-value 1 "1 + 2 < 4: nested left is 1" assert=
  "+" "1 + 2 < 4: nested op is +" assert=
  "<" "1 + 2 < 4: outer op is <" assert=
] ;

test-comparison-right-side-groups-first: ( -- ) [
  "1 < 2 + 3" parse-expr binop-parts  \ op left right
  binop-parts                         \ op left iop il ir
  lit-value 3 "1 < 2 + 3: nested right is 3" assert=
  lit-value 2 "1 < 2 + 3: nested left is 2" assert=
  "+" "1 < 2 + 3: nested op is +" assert=
  lit-value 1 "1 < 2 + 3: outer left is 1" assert=
  "<" "1 < 2 + 3: outer op is <" assert=
] ;

test-equality-over-calls: ( -- ) [
  "f(1) = 2" parse-expr binop-parts  \ op left right
  lit-value 2 "f(1) = 2: right is 2" assert=
  invoke-parts  \ op callee args
  #len 1 "f(1) = 2: left call has one argument" assert=
  "f" "f(1) = 2: left callee is f" assert=
  "=" "f(1) = 2: operator is =" assert=
] ;

"parentheses" test-section

test-parens-override-precedence: ( -- ) [
  "(1 + 2) * 3" parse-expr binop-parts  \ op left right
  lit-value 3 "(1 + 2) * 3: right is 3" assert=
  binop-parts  \ op iop il ir
  lit-value 2 "(1 + 2) * 3: grouped right is 2" assert=
  lit-value 1 "(1 + 2) * 3: grouped left is 1" assert=
  "+" "(1 + 2) * 3: grouped op is +" assert=
  "*" "(1 + 2) * 3: outer op is *" assert=
] ;

test-nested-parens: ( -- ) [
  "((1 + 2))" parse-expr binop-parts  \ op left right; parens add no wrapper node
  lit-value 2 "((1 + 2)): right is 2" assert=
  lit-value 1 "((1 + 2)): left is 1" assert=
  "+" "((1 + 2)): op is +" assert=
] ;

"unary minus" test-section

test-unary-minus: ( -- ) [
  "-5" parse-expr unop-parts  \ op operand
  lit-value 5 "-5: operand is 5" assert=
  "-" "-5: operator is -" assert=
] ;

test-unary-minus-in-expr: ( -- ) [
  "-5 + 3" parse-expr binop-parts  \ op left right
  lit-value 3 "-5 + 3: right is 3" assert=
  unop-parts  \ op uop uoperand
  lit-value 5 "-5 + 3: unary operand is 5" assert=
  "-" "-5 + 3: unary op is -" assert=
  "+" "-5 + 3: binary op is +" assert=
] ;

"calls" test-section

test-call-single-arg: ( -- ) [
  "add1(41)" parse-expr invoke-parts  \ callee args
  dup #len 1 "add1(41): one argument" assert=
  0 #nth lit-value 41 "add1(41): argument value is 41" assert=
  "add1" "add1(41): callee name" assert=
] ;

test-call-multi-arg: ( -- ) [
  "max(1 + 2, 3 + 4)" parse-expr invoke-parts  \ callee args
  dup #len 2 "max(...): two arguments" assert=
  dup 0 #nth binop-parts  \ callee args op left right
  lit-value 2 "max arg0 right is 2" assert=
  lit-value 1 "max arg0 left is 1" assert=
  "+" "max arg0 op is +" assert=
  \ callee args
  1 #nth binop-parts  \ callee op left right
  lit-value 4 "max arg1 right is 4" assert=
  lit-value 3 "max arg1 left is 3" assert=
  "+" "max arg1 op is +" assert=
  \ callee
  "max" "max(...): callee name" assert=
] ;

test-call-zero-arg: ( -- ) [
  "now()" parse-expr invoke-parts  \ callee args
  #len 0 "now(): zero arguments" assert=
  "now" "now(): callee name" assert=
] ;

test-call-nested: ( -- ) [
  "f(g(3))" parse-expr invoke-parts  \ callee args
  dup #len 1 "f(g(3)): one argument" assert=
  0 #nth invoke-parts  \ callee inner-callee inner-args
  #len 1 "f(g(3)): inner call has one argument" assert=
  "g" "f(g(3)): inner callee is g" assert=
  "f" "f(g(3)): outer callee is f" assert=
] ;

test-call-precedence: ( -- ) [
  "f(1 + 2) * g(3)" parse-expr binop-parts  \ op left right
  invoke-parts                              \ op left inner-callee inner-args
  #len 1 "f(1 + 2) * g(3): right call has one argument" assert=
  "g" "f(1 + 2) * g(3): right callee is g" assert=
  \ op left
  invoke-parts  \ op left-callee left-args
  #len 1 "f(1 + 2) * g(3): left call has one argument" assert=
  "f" "f(1 + 2) * g(3): left callee is f" assert=
  "*" "f(1 + 2) * g(3): outer op is *" assert=
] ;

"sub-lexer" test-section

test-tokenize-expr: ( -- ) [
  "1 + 2" tokenize-expr #collect  \ array of tokens
  dup #len 3 "1 + 2 yields three tokens" assert=
  dup 0 #nth value>> "1" "first token value is 1" assert=
  dup 1 #nth value>> "+" "second token value is +" assert=
  2 #nth value>> "2" "third token value is 2" assert=
] ;

"error handling" test-section

test-trailing-token-throws: ( -- ) [
  [ "1 2" parse-expr ] "trailing token throws" assert-error
] ;

test-empty-input-throws: ( -- ) [
  [ "" parse-expr ] "empty input throws" assert-error
] ;

test-leading-operator-throws: ( -- ) [
  [ "+" parse-expr ] "leading operator throws" assert-error
] ;

test-unclosed-paren-throws: ( -- ) [
  [ "(1" parse-expr ] "unclosed paren throws" assert-error
] ;

test-bare-identifier-parses-ref: ( -- ) [
  "foo" parse-expr ref-name "foo" "bare identifier parses to a ref node" assert=
] ;

test-ref-in-expression: ( -- ) [
  "a + 1" parse-expr binop-parts  \ op left right
  lit-value 1 "a + 1: right operand is 1" assert=
  ref-name "a" "a + 1: left operand is a ref to a" assert=
  "+" "a + 1: operator is +" assert=
] ;

test-unclosed-call-throws: ( -- ) [
  [ "foo(" parse-expr ] "unclosed call throws" assert-error
] ;

test-missing-comma-throws: ( -- ) [
  [ "foo(1 2)" parse-expr ] "missing argument comma throws" assert-error
] ;
