\ lib/scanner.1z - Cursor abstraction for character-by-character string scanning
\
\ Scanner is a thin abstraction over native string primitives, sitting at the same level as sequences.
\
\ It has no library imports. Higher-level string utilities in lib/strings.1z compose scanner operations
\ into convenience words like split-once?.
\
\ The cursor is addressed by byte offset internally, so peek / advance / rest / at-end? do not rewalk
\ the input from the start. Token positions stay codepoint indices: `position>>` reads the running
\ codepoint counter, while mark reads the byte cursor and is an opaque byte-offset token paired only
\ with slice-from and the scanner words.

\\ Scanner struct.
\\
\\ `str` is the input.
\\ `byte-cursor` is the current byte offset.
\\ `codepoint-pos` is the running count of codepoints consumed.
scanner: struct{ str byte-cursor codepoint-pos } ;

\\ Construct a scanner at position 0 over a string.
<scanner>: ( str -- scanner ) [ 0 0 make-scanner ] ;

\\ Current codepoint position, for use as a token position.
position>>: ( scanner -- n ) [ codepoint-pos>> ] ;

\\ True if the scanner has consumed all input.
at-end?: ( scanner -- ? ) [
  dup byte-cursor>> swap str>> #byte-len >=
] ;

\\ Current character as a single-character string, or f at end.
peek: ( scanner -- char/f ) [
  dup at-end?
  [ drop f ]
  [ dup str>> swap byte-cursor>> #byte-decode drop ]
  if
] ;

\\ Return a new scanner advanced by one character. No-op at end.
advance: ( scanner -- scanner ) [
  dup at-end?
  [ ]
  [
    unmake-scanner
    \ str byte-cursor codepoint-pos
    1 +
    \ str byte-cursor codepoint-pos'
    -rot>
    \ codepoint-pos' str byte-cursor
    2dup #byte-decode
    \ codepoint-pos' str byte-cursor char next
    nip nip
    \ codepoint-pos' str next
    <rot-
    \ str next codepoint-pos'
    make-scanner
  ]
  if
] ;

\\ Return the remaining unconsumed portion of the input string.
rest: ( scanner -- str ) [
  dup str>> swap byte-cursor>>
  over #byte-len
  #byte-slice
] ;

\\ Consume characters while the predicate quotation returns true.
\\ Returns the advanced scanner and the consumed substring.
take-while: ( scanner quot -- scanner str ) [
  over mark
  [
    [ over peek dup f = [ drop f ] [ over call ] if ]
    [ swap advance swap ] while
    drop
  ] dip
  over mark
  2 pick-n str>>
  -rot> #byte-slice
] ;

\\ Advance past characters matching the predicate, discarding the consumed text.
skip-while: ( scanner quot -- scanner ) [
  take-while drop
] ;

\ Advance the cursor past a known prefix string: byte-cursor by its byte length
\ and codepoint-pos by its codepoint length.
(advance-past): ( scanner str -- scanner ) [
  dup #byte-len swap #len
  \ scanner bytelen cplen
  [ unmake-scanner ] 2dip
  \ str byte-cursor codepoint-pos bytelen cplen
  [ swap ] dip
  \ str byte-cursor bytelen codepoint-pos cplen
  +
  \ str byte-cursor bytelen codepoint-pos'
  [ + ] dip
  \ str byte-cursor' codepoint-pos'
  make-scanner
] ;

\\ Consume an expected string prefix or throw an error.
\\ Compares the prefix of remaining input against the expected string.
expect: ( scanner str -- scanner ) [
  over rest over #len
  2dup swap #len swap <
  [
    2drop "expected \"" swap #append "\" but reached end of input" #append
    f swap EInvalidArgument make-error throw
  ] [
    0 swap #slice
    over over = not [
      "expected \"" <rot- #append "\" but found \"" #append swap #append "\"" #append
      f swap EInvalidArgument make-error throw
    ] [
      drop (advance-past)
    ] if
  ] if
] ;

\\ Capture the current scanner position for later slicing. Opaque byte offset:
\\ use only with slice-from and scanner words; do not interpret as a codepoint
\\ index, and do not assume mark equals position>>.
mark: ( scanner -- mark ) [ byte-cursor>> ] ;

\\ Search for the next occurrence of needle at or after the current position.
\\ Returns a scanner positioned at the match, or f if not found.
find: ( scanner needle -- scanner/f ) [
  over str>> over
  \ scanner needle str needle
  3 pick-n mark
  \ scanner needle str needle from-byte
  #byte-index-of-from
  \ scanner needle byte-idx/f
  dup f = [
    drop 2drop f
  ] [
    \ scanner needle byte-idx
    nip
    \ scanner byte-idx
    over mark 2 pick-n str>> swap 2 pick-n #byte-slice #len
    \ scanner byte-idx skipped-cp
    2 pick-n position>> +
    \ scanner byte-idx new-cp
    2 pick-n str>> -rot> make-scanner nip
  ] if
] ;

\\ If the remaining input starts with needle, advance past it; otherwise f.
skip-exact: ( scanner needle -- scanner/f ) [
  over rest over #starts-with?
  [
    (advance-past)
  ]
  [ 2drop f ]
  if
] ;

\\ Extract the substring from mark to the current scanner position.
slice-from: ( scanner mark -- str ) [
  over str>>
  -rot>
  swap byte-cursor>>
  #byte-slice
] ;

\\ Consume text up to needle. Returns advanced scanner and consumed text,
\\ or original scanner and f if needle is not found.
take-until: ( scanner needle -- scanner str/f ) [
  over mark -rot>
  \ mark scanner needle
  over swap find
  \ mark scanner found/f
  dup f = [
    drop nip f
  ] [
    nip dup <rot-
    slice-from
  ] if
] ;

\\ Debug representation of a scanner value.
inspect: method{ scanner } [
  dup position>> inspect
  swap rest inspect
  "<scanner pos=" <rot- #append " rest=" #append swap #append ">" #append
] ;
