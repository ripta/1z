\ lib/heap.1z - Persistent pairing heap.
\
\ A pairing heap is a tree of nodes, each holding an element and a cons-list of child
\ trees. Melding two trees compares their root elements and makes the loser the winner's
\ first child, so insert and merge are worst-case O(1). Removing the minimum leaves the
\ root's children, and the pairing pass rebuilds a tree from them: it melds adjacent pairs
\ left-to-right, then folds the results back right-to-left. That pass is O(log n)
\ amortized, and the bound holds along one chain of versions. A caller that branches many
\ versions off one heap pays the pass once per branch.

use "cons-list" ;

\ The node struct sits in its own block: a private{ } body is parsed whole before it runs,
\ so a parse-time type reference like the enum's payload only resolves names a previous
\ statement has already installed.
private{
  \\ A pairing-heap node: the element plus a cons-list of child nodes. Child lists hold
  \\ only real nodes; emptiness exists only at the heap's root slot.
  heap-node: struct{ element children } ;
}

private{
  \\ The root slot: empty, or the tree's root node.
  heap-root: enum{ empty: unit node: heap-node } ;

  \ Wrap a bare node as a root. The variant constructor takes the payload's fields.
  node>root: ( node -- root ) [ unmake-heap-node make-heap-root:node ] ;

  \ Meld two trees in O(1): the tree whose root element sorts later becomes the other's
  \ first child. On lt or eq the left operand keeps the root, so ties stay with the heap
  \ the element came in on.
  meld: ( a b comparator -- node ) [
    2 pick-n element>> 2 pick-n element>> 2 pick-n call nip
    ordering:gt? [ swap ] unless
    unmake-heap-node <rot- swap cons make-heap-node
  ] ;

  \ Pass 1 of the pairing pass: meld adjacent pairs left-to-right, prepending each result
  \ to acc, with an odd leftover prepended as-is. The output lands in reverse order, which
  \ is the order pass 2 wants to fold in.
  \
  \ Both passes are explicit loops rather than self-calls from match arms. Such a call
  \ keeps the arm's frames live, and one pass runs over a root's whole child list, which
  \ an ascending fill grows to O(n): deep enough to exhaust the task stack.
  meld-pairs: ( comparator acc children -- comparator acc ) [
    [ dup cons? ] [
      cons-list:cons>
      dup cons?
      [
        cons-list:cons>
        [ 3 pick-n meld ] dip
        [ swap cons ] dip
      ]
      [ drop swap cons nil ]
      if
    ] while
    drop
  ] ;

  \ Pass 2 of the pairing pass: fold the reversed pair list into one node, which combines
  \ the original pairs right-to-left.
  meld-fold: ( comparator node pairs -- node ) [
    [ dup cons? ] [
      cons-list:cons>
      [ 2 pick-n meld ] dip
    ] while
    drop nip
  ] ;

  \ The pairing pass delete-min runs: rebuild a root from a former root's children.
  \ O(log n) amortized in the melds both passes perform.
  merge-pairs: ( children comparator -- root ) [
    over nil? [ 2drop heap-root:empty ] [
      swap nil swap
      meld-pairs
      dup head swap tail
      meld-fold
      node>root
    ] if
  ] ;

  \ Meld a bare node into a root, absorbing the empty case. O(1).
  root-meld: ( node root comparator -- root ) [
    swap {
      heap-root:empty: [ drop node>root ]
      heap-root:node: [ make-heap-node -rot> meld node>root ]
    } unchecked-match
  ] ;

  \ Meld two roots, absorbing the empty cases. The left root keeps ties. O(1).
  root-merge: ( a b comparator -- root ) [
    swap {
      heap-root:empty: [ drop ]
      heap-root:node: [ make-heap-node -rot> root-meld ]
    } unchecked-match
  ] ;
}

\\ Error type thrown by the bare peeks and pops on an empty heap.
EEmptyHeap: ( -- sym ) [ empty-heap: ] ;

\\ A persistent min-heap. The comparator has effect `( a b -- ordering )`, as `cmp` does,
\\ and the element the comparator sorts first is the minimum. A max-heap is the same type
\\ built with an inverted comparator such as `[ swap cmp ]`. `size` counts the elements
\\ and is maintained in O(1) by every operation.
heap: struct{ root: heap-root comparator: quotation size: fixnum } ;

\\ An empty heap ordered by the comparator.
\\
\\   [ cmp ] <heap> #len
\\   => 0
<heap>: ( comparator: quotation -- heap ) [ heap-root:empty swap 0 make-heap ] ;

\\ Add a value in worst-case O(1).
\\
\\   [ cmp ] <heap> 3 heap-insert 1 heap-insert #len
\\   => 2
heap-insert: ( heap: heap value -- heap ) [
  nil make-heap-node
  swap unmake-heap
  1 +
  [ dup [ root-meld ] dip ] dip
  make-heap
] ;

\\ Merge two heaps in worst-case O(1). Both operands must have been built with the same
\\ comparator; that precondition is not checked, and the result carries the left
\\ operand's comparator.
\\
\\   [ cmp ] <heap> 1 heap-insert
\\   [ cmp ] <heap> 2 heap-insert
\\   heap-merge #len
\\   => 2
heap-merge: ( heap: heap other: heap -- heap ) [
  unmake-heap nip
  [ unmake-heap ] 2dip
  swap [ + ] dip
  swap [ swap dup [ root-merge ] dip ] dip
  make-heap
] ;

private{
  throw-empty: never-returns ( -- * ) [
    f "operation on an empty heap" EEmptyHeap make-error throw
  ] ;

  throw-key-not-found: never-returns ( -- * ) [
    f "no element comparator-equal to the key" EKeyNotFound make-error throw
  ] ;

  \ The scan's seed: the root's node as a one-node list, or nil for an empty root.
  root-nodes: ( root -- cons-list ) [
    {
      heap-root:empty: [ nil ]
      heap-root:node: [ make-heap-node nil cons ]
    } unchecked-match
  ] ;

  \ Collect every element reachable from the worklist, in structural order. `current` is
  \ the child list being walked and `pending` holds the child lists still to visit. A loop
  \ for the meld-pairs reason: a root can carry O(n) children and a tree can run O(n)
  \ deep, and neither shape may cost native stack.
  collect-elements: ( acc pending current -- acc ) [
    [ dup cons? 2 pick-n cons? or ] [
      dup cons?
      [
        cons-list:cons>
        swap [ swap cons ] dip
        unmake-heap-node
        [ swap [ swap cons ] dip ] dip
      ]
      [ drop cons-list:cons> swap ]
      if
    ] while
    2drop
  ] ;

  \ Split off the first element comparator-equal to target. The skipped prefix and the
  \ untouched rest come back as two lists, since the rebuild that consumes them is
  \ order-blind. Throws when the walk runs out without a match.
  remove-first: ( comparator target acc list -- acc rest ) [
    [
      dup nil? [ throw-key-not-found ] when
      cons-list:cons>
      over 4 pick-n 6 pick-n call ordering:eq?
      [ [ drop ] dip [ 2drop ] 2dip f ]
      [ [ swap cons ] dip t ]
      if
    ] loop
  ] ;

  \ Insert every element of the list. A loop stand-in for list-foldl, which self-calls
  \ from a match arm once per element and overflows on the scans' O(n) lists.
  fold-insert: ( heap list -- heap ) [
    [ dup cons? ] [ cons-list:cons> [ heap-insert ] dip ] while
    drop
  ] ;
}

\\ The minimum element in O(1). Throws `empty-heap` on an empty heap.
\\
\\   [ cmp ] <heap> 3 heap-insert 1 heap-insert heap-min
\\   => 1
heap-min: ( heap: heap -- value ) [
  root>> {
    heap-root:empty: [ throw-empty ]
    heap-root:node: [ drop ]
  } unchecked-match
] ;

\\ The minimum element as an option, `option:none` on an empty heap.
\\
\\   [ cmp ] <heap> heap-min? option:none?
\\   => t
heap-min?: ( heap: heap -- option ) [
  dup size>> 0 = [ drop option:none ] [ heap-min >option:some ] if
] ;

\\ Remove and return the minimum in O(log n) amortized. Throws `empty-heap` on an empty
\\ heap.
\\
\\   [ cmp ] <heap> 3 heap-insert 1 heap-insert heap-pop-min nip
\\   => 1
heap-pop-min: ( heap: heap -- heap value ) [
  dup size>> 0 = [ throw-empty ] when
  unmake-heap 1 -
  [ [ heap-root:node> ] dip dup [ merge-pairs ] dip ] dip
  make-heap swap
] ;

\\ Remove and return the minimum as an option. On an empty heap the heap comes back
\\ unchanged with `option:none`.
\\
\\   [ cmp ] <heap> 1 heap-insert heap-pop-min? nip option:some>
\\   => 1
heap-pop-min?: ( heap: heap -- heap option ) [
  dup size>> 0 = [ option:none ] [ heap-pop-min >option:some ] if
] ;

\\ Replace one element comparator-equal to `old` with `new`. The persistent heap has no
\\ node handles, so the element is found by an O(n) scan and the heap is rebuilt by
\\ reinserting everything else. Throws `key-not-found` when no element matches.
\\
\\ A consumer that would decrease keys in a loop, such as Dijkstra, should use lazy
\\ deletion instead: insert the decreased value as a duplicate and skip stale entries on
\\ pop.
\\
\\   [ cmp ] <heap> 5 heap-insert 9 heap-insert 9 1 heap-decrease-key heap-min
\\   => 1
heap-decrease-key: ( heap: heap old new -- heap ) [
  [ dup comparator>> swap root>> root-nodes ] 2dip
  [ [ nil nil ] dip collect-elements ] 2dip
  3 pick-n 2 pick-n nil 5 pick-n remove-first
  [ [ nip drop ] dip ] 2dip
  [ [ <heap> ] dip swap ] 2dip
  [ fold-insert ] dip
  fold-insert
  swap heap-insert
] ;

private{
  \ Iterator step: state is a one-element vector holding the heap still to drain.
  sorted-iter-step: ( state -- option ) [
    dup 0 #nth heap-pop-min?
    swap 2 pick-n 0 <rot- #nth! drop
    nip
  ] ;

  \ Push each node of a child list onto the stack vector.
  push-nodes: ( vec list -- vec ) [
    [ dup cons? ] [ cons-list:cons> [ #push! ] dip ] while
    drop
  ] ;

  \ Iterator step for the structural walk: state is a vector of pending nodes. Each node is
  \ pushed exactly once, so a step is O(1) amortized.
  unsorted-iter-step: ( state -- option ) [
    dup #empty? [ drop option:none ] [
      #pop! unmake-heap-node
      swap [ push-nodes drop ] dip
      >option:some
    ] if
  ] ;
}

\\ A lazy iterator over the elements in priority order, by repeated pop-min over the
\\ persistent heap. Nothing is materialized: taking k elements costs O(k log n) amortized,
\\ and the source heap is unchanged.
\\
\\   [ cmp ] <heap> 3 heap-insert 1 heap-insert heap-sorted #collect
\\   => { 1 3 }
heap-sorted: ( heap: heap -- iterator ) [
  [ ] make-vector swap #push!
  [ sorted-iter-step ] curry
  >iterator
] ;

\\ A lazy iterator over the elements in structural order, O(1) amortized per step. The
\\ order is representation-dependent: it follows the tree the melds happened to build, so
\\ content-equal heaps may yield differently. Order-blind callers get O(n) here where the
\\ sorted drain costs O(n log n).
\\
\\   [ cmp ] <heap> 1 heap-insert heap-unsorted #collect
\\   => { 1 }
heap-unsorted: ( heap: heap -- iterator ) [
  [ ] make-vector swap root>> root-nodes push-nodes
  [ unsorted-iter-step ] curry
  >iterator
] ;

\ Cost-rule protocol conformance: >iterator dispatches to the sorted drain, #len and
\ #empty? read the size field in O(1), #first is heap-min at O(1), and >array is the
\ sorted dump through the iterator.
\
\ #first needs no drop-before-throw guard: heap-min consumes the heap on every path
\ before the empty arm throws, so the prelude's recover-based #first? sees a clean stack.
\
\ #last and #nth are left unimplemented, each an O(n) walk or worse under an O(1)
\ expectation. #push and #pop are not registered either: a heap has no end of sequence
\ for them to name, and heap-insert / heap-pop-min are the honest spellings.
>iterator: method{ heap } [ heap-sorted ] ;
#len:      method{ heap } [ size>> ] ;
#empty?:   method{ heap } [ size>> 0 = ] ;
#first:    method{ heap } [ heap-min ] ;
>array:    method{ heap } [ #collect ] ;

\\ A priority/value entry: what the priority queue stores in its base heap and what its
\\ peeks, pops, and iterators yield.
pq-entry: struct{ priority value } ;

\\ A priority queue: a pairing heap of `pq-entry` values ordered by priority. The wrapper's
\\ words build the entries, so a scheduling consumer never writes the projection by hand.
priority-queue: virtual{ heap } ;

\\ An empty priority queue. The comparator has effect `( p1 p2 -- ordering )` over
\\ priorities, as `cmp` does, and is curried to read each entry's priority.
\\
\\   [ cmp ] <priority-queue> #len
\\   => 0
<priority-queue>: ( comparator: quotation -- priority-queue ) [
  [ [ [ priority>> ] dip priority>> ] dip call ] curry
  <heap> make-priority-queue
] ;

\\ Add a value at a priority in worst-case O(1). Entries with equal priorities are all
\\ kept and pop in no guaranteed order among themselves.
\\
\\   [ cmp ] <priority-queue> 2 20 priority-queue-insert 1 10 priority-queue-insert #len
\\   => 2
priority-queue-insert: ( pq: priority-queue priority value -- priority-queue ) [
  make-pq-entry swap unmake-priority-queue swap heap-insert make-priority-queue
] ;

\\ Merge two priority queues in worst-case O(1). Both operands must have been built with
\\ the same comparator; that precondition is not checked, and the result carries the left
\\ operand's comparator.
\\
\\   [ cmp ] <priority-queue> 1 10 priority-queue-insert
\\   [ cmp ] <priority-queue> 2 20 priority-queue-insert
\\   priority-queue-merge #len
\\   => 2
priority-queue-merge: ( pq: priority-queue other: priority-queue -- priority-queue ) [
  unmake-priority-queue [ unmake-priority-queue ] dip heap-merge make-priority-queue
] ;

\\ The minimum-priority entry in O(1). Throws `empty-heap` on an empty queue.
\\
\\   [ cmp ] <priority-queue> 2 20 priority-queue-insert 1 10 priority-queue-insert
\\   priority-queue-min value>>
\\   => 10
priority-queue-min: ( pq: priority-queue -- entry ) [
  unmake-priority-queue heap-min
] ;

\\ The minimum-priority entry as an option, `option:none` on an empty queue.
\\
\\   [ cmp ] <priority-queue> priority-queue-min? option:none?
\\   => t
priority-queue-min?: ( pq: priority-queue -- option ) [
  unmake-priority-queue heap-min?
] ;

\\ Remove and return the minimum-priority entry in O(log n) amortized. Throws `empty-heap`
\\ on an empty queue.
\\
\\   [ cmp ] <priority-queue> 2 20 priority-queue-insert 1 10 priority-queue-insert
\\   priority-queue-pop-min nip value>>
\\   => 10
priority-queue-pop-min: ( pq: priority-queue -- priority-queue entry ) [
  unmake-priority-queue heap-pop-min [ make-priority-queue ] dip
] ;

\\ Remove and return the minimum-priority entry as an option. On an empty queue the queue
\\ comes back unchanged with `option:none`.
\\
\\   [ cmp ] <priority-queue> 1 10 priority-queue-insert
\\   priority-queue-pop-min? nip option:some> value>>
\\   => 10
priority-queue-pop-min?: ( pq: priority-queue -- priority-queue option ) [
  unmake-priority-queue heap-pop-min? [ make-priority-queue ] dip
] ;

\\ A lazy iterator over the entries in priority order, by repeated pop-min over the
\\ persistent base heap. Taking k entries costs O(k log n) amortized, and the source
\\ queue is unchanged.
\\
\\   [ cmp ] <priority-queue> 2 20 priority-queue-insert 1 10 priority-queue-insert
\\   priority-queue-sorted [ value>> ] #map #collect
\\   => { 10 20 }
priority-queue-sorted: ( pq: priority-queue -- iterator ) [
  unmake-priority-queue heap-sorted
] ;

\\ A lazy iterator over the entries in structural order, O(1) amortized per step, with no
\\ order guarantee.
\\
\\   [ cmp ] <priority-queue> 1 10 priority-queue-insert
\\   priority-queue-unsorted [ value>> ] #map #collect
\\   => { 10 }
priority-queue-unsorted: ( pq: priority-queue -- iterator ) [
  unmake-priority-queue heap-unsorted
] ;

\\ Alias of `priority-queue-insert`.
pq-insert: ( pq: priority-queue priority value -- priority-queue ) [ priority-queue-insert ] ;

\\ Alias of `priority-queue-min`. Throws `empty-heap` on an empty queue.
pq-min: ( pq: priority-queue -- entry ) [ priority-queue-min ] ;

\\ Alias of `priority-queue-min?`. On an empty queue answers `option:none`.
pq-min?: ( pq: priority-queue -- option ) [ priority-queue-min? ] ;

\\ Alias of `priority-queue-pop-min`. Throws `empty-heap` on an empty queue.
pq-pop-min: ( pq: priority-queue -- priority-queue entry ) [ priority-queue-pop-min ] ;

\\ Alias of `priority-queue-pop-min?`. On an empty queue the queue comes back unchanged
\\ with `option:none`.
pq-pop-min?: ( pq: priority-queue -- priority-queue option ) [ priority-queue-pop-min? ] ;

\ The pair layer's conformance surface, yielding entries. A virtual type inherits no
\ methods, so the wrapper registers its own set over the same O(1) reads. #first needs no
\ drop-before-throw guard for the heap's reason: priority-queue-min consumes the queue on
\ every path before the empty arm throws. #last, #nth, #push, and #pop stay unregistered,
\ as on the heap.
>iterator: method{ priority-queue } [ priority-queue-sorted ] ;
#len:      method{ priority-queue } [ unmake-priority-queue size>> ] ;
#empty?:   method{ priority-queue } [ unmake-priority-queue size>> 0 = ] ;
#first:    method{ priority-queue } [ priority-queue-min ] ;
>array:    method{ priority-queue } [ #collect ] ;
