\ Standard library prelude
\ This file is embedded and loaded automatically during initialization.

\\ Push an empty quotation. A shortcut for `[ ]`.
[]: ( -- quotation ) [ [ ] ] ;

\\ Read the next quotation from the tokenizer.
parse-quotation: ( -- quotation ) [
  parse-literal dup type-of quotation =
  [ ] [ "quotation" throw-type-error ] if
] ;

\\ Hash literal syntax.
H{: parse-time [ "}" parse-until make-hash ] ;

\\ Vector literal syntax.
V{: parse-time [ "}" parse-until make-vector: emit-call ] ;

\\ Byte array literal syntax.
B{: parse-time [ "}" parse-until make-byte-array: emit-call ] ;

\\ Set literal syntax.
S{: parse-time [ "}" parse-until make-set ] ;

\\ Mutable map literal syntax.
M{: parse-time [ "}" parse-until make-mutable-map: emit-call ] ;

\ Built-in type values
fixnum:    M{ type: builtin-type: numeric: t exact: t integer: t mutable: f define: [ define-builtin-type ] } ;
bignum:    M{ type: builtin-type: numeric: t exact: t integer: t mutable: f define: [ define-builtin-type ] } ;
float:     M{ type: builtin-type: numeric: t exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
boolean:   M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
string:    M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
symbol:    M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
array:     M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
quotation: M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
hash:      M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
vector:    M{ type: builtin-type: numeric: f exact: f integer: f mutable: t define: [ define-builtin-type ] } ;
byte-array: M{ type: builtin-type: numeric: f exact: f integer: f mutable: t define: [ define-builtin-type ] } ;
set: M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
mutable-map: M{ type: builtin-type: numeric: f exact: f integer: f mutable: t define: [ define-builtin-type ] } ;
stream:      M{ type: builtin-type: numeric: f exact: f integer: f mutable: t define: [ define-builtin-type ] } ;
resource:    M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
parameter:   M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
module:      M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
marker:      M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
struct-type: M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
struct-instance: M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
tagged:       M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
template:     M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
stack-effect: M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
error:    M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
task:     M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
channel:  M{ type: builtin-type: numeric: f exact: f integer: f mutable: t define: [ define-builtin-type ] } ;
iterator: M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
doc-string: M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
type: M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
type-descriptor: M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
constraint: M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
unit: M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;
sandbox-spec: M{ type: builtin-type: numeric: f exact: f integer: f mutable: f define: [ define-builtin-type ] } ;

\\ Word array literal syntax. Tokenizes words as strings without requiring quotes.
W{: parse-time [ "}" parse-tokens-until ] ;

\\ Struct definition syntax.
\   name: struct{ field1 field2 ... } ;
struct{: parse-time [
  M{ type: struct-descriptor: }
  fields:  "}" parse-values-until @set!
  src-loc: native.parse-source-loc 3 array-n @set!
  define:  [ define-struct ] @set!
] ;

\\ Virtual type definition syntax.
\   name: virtual{ inner-type } ;
virtual{: parse-time [
  dup type-of hash =
  [
    M{ type: virtual: }
    over @keys [ dup [ [ over ] dip @get ] dip swap @set! ] #each
    swap drop
  ]
  [ M{ type: virtual: } ]
  if
  inner-type: "}" parse-types-until @set!
  define: [ define-virtual ] @set!
] ;

\\ Enum type definition syntax.
\   name: enum{ variant1: type1 variant2: type2 ... } ;
enum{: parse-time [
  M{ type: enum-descriptor: }
  variants: "}" parse-values-until @set!
  define: [ define-enum ] @set!
] ;

\\ Parse-time validated exhaustive match on enum variants.
match{: parse-time [
  "}" parse-values-until native.validate-match-block
  unchecked-match: emit-call
] ;

\ Parse-time conditional inclusion. These helpers run during `choose{`'s
\ parse-time execution, so they are plain runtime words, not parse-time words.

\ Raw-skip a balanced bracket group, tracking nesting depth across [ ] { } ( ).
\ Reads tokens without evaluating them, so a skipped branch's parse-time words
\ never fire.
(choose-skip-bal): ( depth: fixnum -- ) [
  dup 0 = [ drop ] [
    parse-token
    dup "[" = over "(" = or over #last "{" = or
    [ drop 1 + ]
    [ dup "]" = over "}" = or over ")" = or [ drop 1 - ] [ drop ] if ]
    if
    (choose-skip-bal)
  ] if
] ;

\ A branch has already been selected: raw-skip every remaining branch up to the
\ closing brace, then consume the brace.
(choose-skip-rest): ( -- ) [
  peek-token "}" =
  [ parse-token drop ]
  [ parse-token drop
    parse-token drop
    1 (choose-skip-bal)
    (choose-skip-rest)
  ] if
] ;

\ Does a branch key token match the selector? `_` is the catch-all; any other
\ key must be a symbol literal compared against the selector's `name:` form.
(choose-key-match?): ( selkey: string keytok: string -- selkey ? ) [
  dup "_" =
  [ drop t ]
  [ dup #last ":" = not
    [ f "choose{ branch key must be a symbol literal or _" EInvalidArgument make-error throw ]
    when
    over =
  ] if
] ;

\ Scan branches forward looking for the first match. On a match, splice that
\ branch's region inline and skip the rest; on a miss, skip the region and
\ continue. At the closing brace with nothing matched, raise a parse-time error.
(choose-scan): ( selkey: string -- ) [
  peek-token "}" =
  [ parse-token drop
    drop
    f "choose{ has no matching branch and no _ default arm" EInvalidArgument make-error throw
  ]
  [ parse-token
    (choose-key-match?)
    parse-token "[" = not
    [ f "choose{ branch key must be followed by [" EInvalidArgument make-error throw ]
    when
    [ drop "]" parse-until emit-body (choose-skip-rest) ]
    [ 1 (choose-skip-bal) (choose-scan) ]
    if
  ] if
] ;

\\ Parse-time dispatch on a symbol selector: include only the branch whose key
\\ matches, raw-skipping the rest so their parse-time words never fire and their
\\ instructions never reach the binary. Keys are symbol literals; a bare `_` arm
\\ is the catch-all. The selected region is spliced inline, so a `;` in it
\\ defines at the surrounding scope.
choose{: parse-time ( selector: symbol -- ) [
  dup symbol? not
  [ f "choose{ selector must be a symbol" EInvalidArgument make-error throw ]
  when
  >string ":" #append
  (choose-scan)
] ;

\ Standard sum types
\\ Backing struct for option:some.
option-payload: struct{ value } ;
\\ Optional value: either `some` wrapping a value, or `none`.
option: enum{ some: option-payload none: unit } ;
\\ A single enum variant as exposed by `descriptor-variants?`: name carries
\\ the variant's symbol, type carries the variant's inner type.
descriptor-variant: struct{ name: symbol type: type } ;
\\ Backing struct for result:ok.
result-value: struct{ value } ;
\\ Backing struct for result:err.
result-error: struct{ error } ;
\\ Fallible result: either `ok` wrapping a value, or `err` wrapping an error.
result: enum{ ok: result-value err: result-error } ;

\\ Three-way comparison result: less-than, equal, or greater-than.
ordering: enum{ lt: unit eq: unit gt: unit } ;

\\ Three-way comparison. Returns an ordering enum variant.
cmp: generic ( a b -- ordering ) [
  native.cmp dup 0 <
  [ drop ordering:lt ] [
    0 > [ ordering:gt ] [ ordering:eq ] if
  ]
  if
] ;

\\ Less than or equal. Derived from cmp: true unless the result is gt.
<=: ( a b -- bool ) [ cmp ordering:gt = not ] ;
\\ Greater than or equal. Derived from cmp: true unless the result is lt.
>=: ( a b -- bool ) [ cmp ordering:lt = not ] ;

\\ Lifecycle hook event types.
on: enum{
  exit: unit
  unhandled-error: unit
  word-defined:    unit
  module-loaded:   unit
} ;

\\ Register a hook quotation for a lifecycle event.
\\ Global events (exit, unhandled-error) use the shared registry.
\\ Scoped events (word-defined, module-loaded) use dynamic parameters.
\\ Defined early with forward references resolved by deferred quotation bodies.
add-hook: ( on-variant quot -- ) [
  [ type-name ] dip
  over "on:word-defined" =
  [ swap drop word-defined-hooks native.register-scoped-hook ]
  [ over "on:module-loaded" =
    [ swap drop module-loaded-hooks native.register-scoped-hook ]
    [ native.register-global-hook ]
    if
  ] if
] ;

\\ Method dispatch registration syntax.
\   word: method{ type1 type2 } [ body ] ;
method{: parse-time [
  M{ }
  types:  "}" parse-values-until @set!
  body:   parse-quotation @set!
  define: [ define-method ] @set!
] ;

\\ Protocol definition syntax. Defines a parse-time const that pushes the protocol's descriptor.
\\ Runtime validation is performed by `assert-satisfies` (throws on mismatch) and `satisfies?`
\\ (predicate).
\   protocol-name: protocol{ method1: method2: } ;
\   my-type: protocol-name assert-satisfies
protocol{: parse-time [
  M{ }
  methods: "}" parse-values-until @set!
  define: [ define-protocol ] @set!
] ;

\\ Protocol for types that support three-way comparison via cmp.
comparable: protocol{ cmp: } ;

\\ Register `cmp` for the built-in comparable types so they satisfy
\\ `comparable`. The raw comparison lives in `native.cmp`; these wrappers turn
\\ its result into an `ordering`, because a native primitive cannot construct
\\ the 1z-defined `ordering` enum itself.
cmp: method{ fixnum fixnum } [ native.cmp dup 0 < [ drop ordering:lt ] [ 0 > [ ordering:gt ] [ ordering:eq ] if ] if ] ;
cmp: method{ float float } [ native.cmp dup 0 < [ drop ordering:lt ] [ 0 > [ ordering:gt ] [ ordering:eq ] if ] if ] ;
cmp: method{ bignum bignum } [ native.cmp dup 0 < [ drop ordering:lt ] [ 0 > [ ordering:gt ] [ ordering:eq ] if ] if ] ;
cmp: method{ string string } [ native.cmp dup 0 < [ drop ordering:lt ] [ 0 > [ ordering:gt ] [ ordering:eq ] if ] if ] ;
cmp: method{ byte-array byte-array } [ native.cmp dup 0 < [ drop ordering:lt ] [ 0 > [ ordering:gt ] [ ordering:eq ] if ] if ] ;

\\ Protocol for types that support roundtrippable inspection via inspect.
inspectable: protocol{ inspect: } ;

\\ Protocol for types that support human-friendly display via >string.
stringable: protocol{ >string: } ;

\\ Dynamic variable definition syntax. Reads a default quotation between `{` and
\\ `}` and produces a definition descriptor that `;` hands to `define-parameter`.
parameter{: parse-time [
  "}" parse-values-until 0 #nth
  [ ] make-mutable-map
  swap default: swap @set!
  [ define-parameter ] define: swap @set!
] ;

\\ The current output stream, defaulting to `stdout`.
output-stream: parameter{ [ stdout ] } ;
\\ The current input stream, defaulting to `stdin`.
input-stream: parameter{ [ stdin ] } ;
\\ The current error stream, defaulting to `stderr`.
error-stream: parameter{ [ stderr ] } ;
\\ The module cache M{}, used by `load` and `use` for caching loaded modules.
module-cache: parameter{ [ native.module-cache-value ] } ;
\\ Scoped hooks for word-defined events (array of quotations).
word-defined-hooks: parameter{ [ { } ] } ;
\\ Scoped hooks for module-loaded events (array of quotations).
module-loaded-hooks: parameter{ [ { } ] } ;

\\ Load a module by name or file path, returning a cached copy if available.
\\ Cache misses delegate to `load-file`, which is restricted to the primary
\\ worker and throws `non-primary-worker` when called from any other worker
\\ task. Cache hits perform no dictionary writes and are not gated.
load: dynamic-load ( filename -- module ) [
  dup native.resolve-load-path
  module-cache get over @has?
  [ swap drop module-cache get swap @get ]
  [ drop module-cache get swap load-file ]
  if
] ;

\\ Load a module by name or file path, bypassing the cache. Pinned to the
\\ original source kind: if the module was first loaded from the embedded
\\ stdlib bundle, `reload` re-reads from the bundle even after a filesystem
\\ stdlib becomes available mid-session. Delegates to `reload-file` and
\\ therefore throws `non-primary-worker` when called from any task whose
\\ home worker is not the primary.
reload: dynamic-load ( filename -- module ) [
  module-cache get swap reload-file
] ;

\ Control flow
\\ Execute the quotation when the condition is true.
when: branch-combinator ( ? quot -- ) [ [ ] if ] ;
\\ Execute the quotation when the condition is false.
unless: branch-combinator ( ? quot -- ) [ [ ] swap if ] ;

\ Error-handling
\\ Execute a quotation, silently discarding any error.
ignore-errors: ( quot -- ) [ [ drop ] recover ] ;
\\ Test whether a value is an error object.
error?: ( val -- ? ) [ type-of error = ] ;
\\ Test whether an error matches a given error type symbol.
\\ Leaves the error on the stack for further inspection.
error-type?: ( error type -- error ? ) [ over error-type: @get = ] ;

\ Error type constants
EStackUnderflow:      ( -- sym ) [ stack-underflow: ] ;
ETypeMismatch:        ( -- sym ) [ type-mismatch: ] ;
EDivisionByZero:      ( -- sym ) [ division-by-zero: ] ;
EFixnumOverflow:      ( -- sym ) [ fixnum-overflow: ] ;
EStackEffectMismatch: ( -- sym ) [ stack-effect-mismatch: ] ;
EUnknownWord:         ( -- sym ) [ unknown-word: ] ;
EFileNotFound:        ( -- sym ) [ file-not-found: ] ;
EFileReadFailed:      ( -- sym ) [ file-read-failed: ] ;
EUserRethrown:        ( -- sym ) [ user-rethrown: ] ;
EUserThrown:          ( -- sym ) [ user-thrown: ] ;
EKeyNotFound:         ( -- sym ) [ key-not-found: ] ;
ENotComparable:       ( -- sym ) [ not-comparable: ] ;
EIOFailed: ( -- sym ) [ io-failed: ] ;
ENoMatchingBranch: ( -- sym ) [ no-matching-branch: ] ;
ECannotRedefineConst: ( -- sym ) [ cannot-redefine-const: ] ;
EArityMismatch:       ( -- sym ) [ arity-mismatch: ] ;
EUnexpectedEOF:       ( -- sym ) [ unexpected-eof: ] ;
EIndexOutOfBounds:    ( -- sym ) [ index-out-of-bounds: ] ;
EInvalidArgument:     ( -- sym ) [ invalid-argument: ] ;
EUseAfterClose:       ( -- sym ) [ use-after-close: ] ;
EMissingDocComment:   ( -- sym ) [ missing-doc-comment: ] ;
ENonTailRecursion:    ( -- sym ) [ non-tail-recursion: ] ;
EStackOverflow:       ( -- sym ) [ stack-overflow: ] ;

\ TODO(ripta): the pattern is a bit repetitive and odd; maybe a parse-time?
\\ Construct and throw a no-matching-branch error with the given data.
no-matching-branch: ( data -- error ) [ "no matching branch" ENoMatchingBranch make-error ] ;

\\ Extract the type name of a value as a string.
type-name: ( val -- string ) [ type-of native.type-name ] ;

\\ Check whether a value's type descriptor contains a given property key.
type-has-property?: ( val property -- ? ) [ swap type-of swap native.type-has-property? ] ;
\\ Return member types for a union type, or f for non-union types.
type-members: ( type -- array/f ) [ native.type-members ] ;
\\ Check whether a type value represents a declared union.
type-union?: ( type -- ? ) [ type-members f = not ] ;

\\ Throw a type-mismatch error with expected/got/value context.
throw-type-error: never-returns ( value expected-str -- * ) [
  over type-name
  H{ } swap got: swap @set swap expected: swap @set swap value: swap @set
  dup expected: @get over got: @get
  swap "expected " swap #append ", got " #append swap #append
  ETypeMismatch make-error throw
] ;

\ Type predicates
fixnum?:     ( val -- ? ) [ type-of fixnum = ] ;
boolean?:    ( val -- ? ) [ type-of boolean = ] ;
string?:     ( val -- ? ) [ type-of string = ] ;
symbol?:     ( val -- ? ) [ type-of symbol = ] ;
array?:      ( val -- ? ) [ type-of array = ] ;
quotation?:  ( val -- ? ) [ type-of quotation = ] ;
hash?:       ( val -- ? ) [ type-of hash = ] ;
vector?:     ( val -- ? ) [ type-of vector = ] ;
byte-array?: ( val -- ? ) [ type-of byte-array = ] ;
set?: ( val -- ? ) [ type-of set = ] ;
mutable-map?: ( val -- ? ) [ type-of mutable-map = ] ;
stream?:      ( val -- ? ) [ type-of stream = ] ;
parameter?:   ( val -- ? ) [ type-of parameter = ] ;
module?:      ( val -- ? ) [ type-of module = ] ;
marker?:      ( val -- ? ) [ type-of marker = ] ;
benchmark-report?: ( val -- ? ) [ type-of benchmark-report = ] ;
iterator?: ( val -- ? ) [ type-of iterator = ] ;
float?: ( val -- ? ) [ type-of float = ] ;
bignum?: ( val -- ? ) [ type-of bignum = ] ;

\\ True for any numeric type.
number?: ( val -- ? ) [ "numeric" type-has-property? ] ;
\\ True for exact numeric types.
exact?: ( val -- ? ) [ "exact" type-has-property? ] ;
\\ True for inexact numeric types.
inexact?: ( val -- ? ) [ dup number? [ exact? not ] [ drop f ] if ] ;
\\ True for any integer type.
integer?: ( val -- ? ) [ "integer" type-has-property? ] ;
\\ True for mutable types.
mutable?: ( val -- ? ) [ "mutable" type-has-property? ] ;
\\ True for borrowed byte-arrays and packed values backed by borrowed byte-arrays.
borrowed?: ( val -- ? ) [ native.borrowed? ] ;

\\ Push IEEE 754 NaN (not a number).
nan: ( -- f ) [ 0.0 0.0 / ] ;
\\ Push IEEE 754 positive infinity.
inf: ( -- f ) [ 1.0 0.0 / ] ;
\\ Push IEEE 754 negative infinity.
-inf: ( -- f ) [ -1.0 0.0 / ] ;

\\ True if x is NaN. Uses the IEEE 754 property that NaN is not equal to itself.
nan?: ( x -- ? ) [ dup float? [ dup = not ] [ drop f ] if ] ;
\\ True if x is positive or negative infinity.
infinite?: ( x -- ? ) [ dup inf = swap -inf = or ] ;
\\ True if x is a finite float: not NaN and not infinite.
finite?: ( x -- ? ) [ dup float? [ dup nan? not swap infinite? not and ] [ drop f ] if ] ;
\\ Get the markers attached to a word definition.
word-markers: ( name -- markers ) [ native.current-scope swap native.word-markers ] ;
\\ Check if a word is visible in any scope.
defined?: ( name -- bool ) [ native.current-scope swap native.defined? ] ;
\\ Check if a word is implemented as a native primitive.
native?: ( name -- ? ) [ native.current-scope swap native.native? ] ;
\\ Test whether a named word has the `generic` marker.
generic?: ( name -- ? ) [ word-markers [ generic = ] #any ] ;

\ Mutable sequence resize
\\ Create an n-byte zeroed buffer.
bytes-alloc: ( n -- byte-array ) [ native.bytes-alloc ] ;
\\ Resize byte array in place, truncating or zero-filling as needed.
bytes-resize!: ( byte-array n -- byte-array ) [ over #len over < [ 0x00 native.#grow! ] [ native.#shrink! ] if ] ;
\\ Resize a mutable sequence in place with an explicit fill value for growth.
#resize!: ( seq n fill -- seq ) [ -rot> over #len over < [ [ swap ] dip swap native.#grow! ] [ [ swap drop ] dip native.#shrink! ] if ] ;

\\ Short-circuiting sequence predicates
\\
\\ Helpers lifted out of #any / #all so AOT compilation can discover them; defined at module scope
\\ rather than in a `private{` block, since the prelude parses too deep for the parser coroutine
\\ to reënter for a block here (cf. `(raw>constraint-info)`).
(any-loop): ( iter quot -- ? ) [
  over #next?
  dup option:some? [
    option:some> over call
    [ 2drop t ] [ (any-loop) ] if
  ] [ drop 2drop f ] if
] ;
(all-loop): ( iter quot -- ? ) [
  over #next?
  dup option:some? [
    option:some> over call
    [ (all-loop) ] [ 2drop f ] if
  ] [ drop 2drop t ] if
] ;
\\ Test whether any element satisfies the predicate. Short-circuits.
#any: ( seq quot -- ? ) [ swap >iterator swap (any-loop) ] ;
\\ Test whether no element satisfies the predicate.
#none: ( seq quot -- ? ) [ #any not ] ;
\\ Test whether all elements satisfy the predicate. Short-circuits.
#all: ( seq quot -- ? ) [ swap >iterator swap (all-loop) ] ;

\ Stack-shuffling
\\ Drop the item at stack depth `n`, counting from the top (0 is the top item).
drop-at: ( ... n -- ... ) [ <rot-n drop ] ;
\\ Drop the second element, keeping the top.
nip: ( a b -- b ) [ swap drop ] ;
\\ Drop the second and third elements, keeping the top.
2nip: ( a b c -- c ) [ swap drop swap drop ] ;
\\ Drop the top three elements beneath the result.
3nip: ( a b c d -- d ) [ 3 nip-n ] ;
\\ Drop the top four elements beneath the result.
4nip: ( a b c d e -- e ) [ 4 nip-n ] ;
\\ Drop the top five elements beneath the result.
5nip: ( a b c d e f -- f ) [ 5 nip-n ] ;
\\ Drop the top six elements beneath the result.
6nip: ( a b c d e f g -- g ) [ 6 nip-n ] ;
\\ Call a quotation with `x`, then restore `x` to the stack.
keep: ( ..a x quot: ( ..a x -- ..b ) -- ..b x ) [ over [ call ] dip ] ;
\\ Call a quotation with `x y`, then restore both to the stack.
2keep: ( ..a x y quot: ( ..a x y -- ..b ) -- ..b x y ) [ [ 2dup ] dip 2dip ] ;
\\ Call a quotation with `x y z`, then restore all three to the stack.
3keep: ( ..a x y z quot: ( ..a x y z -- ..b ) -- ..b x y z ) [ [ 3dup ] dip 3dip ] ;
\\ Call a quotation with `w x y z`, then restore all four to the stack.
4keep: ( ..a w x y z quot: ( ..a w x y z -- ..b ) -- ..b w x y z ) [ [ 4dup ] dip 4dip ] ;
\\ Apply two quotations to the same value in sequence.
bi: ( ..a x p: ( ..a x -- ..b ) q: ( ..a x -- ..c ) -- ..b ..c ) [ [ keep ] dip call ] ;
\\ Apply three quotations to the same value in sequence.
tri: ( ..a x p: ( ..a x -- ..b ) q: ( ..a x -- ..c ) r: ( ..a x -- ..d ) -- ..b ..c ..d ) [ [ [ keep ] dip keep ] dip call ] ;
\\ Apply each quotation in an array to the same value.
cleave: ( x quots -- ) [ [ keep ] #each drop ] ;
\\ Duplicate the top two stack elements.
2dup: ( a b -- a b a b ) [ over over ] ;
\\ Duplicate the top three stack elements.
3dup: ( a b c -- a b c a b c ) [ 2 pick-n 2 pick-n 2 pick-n ] ;
\\ Duplicate the top four stack elements.
4dup: ( a b c d -- a b c d a b c d ) [ 2over 3 pick-n 3 pick-n ] ;
\\ Duplicate the element below the top.
dupd: ( a b -- a a b ) [ over swap ] ;
\\ Drop the top two stack elements.
2drop: ( a b -- ) [ drop drop ] ;
\\ Drop the top three stack elements.
3drop: ( a b c -- ) [ 2drop drop ] ;
\\ Temporarily hide the top two elements, execute a quotation, then restore them.
2dip: ( ..a x y quot: ( ..a -- ..b ) -- ..b x y ) [ swap [ dip ] dip ] ;
\\ Temporarily hide the top three elements, execute a quotation, then restore them.
3dip: ( ..a x y z quot: ( ..a -- ..b ) -- ..b x y z ) [ swap [ 2dip ] dip ] ;
\\ Temporarily hide the top four elements, execute a quotation, then restore them.
4dip: ( ..a w x y z quot: ( ..a -- ..b ) -- ..b w x y z ) [ swap [ 3dip ] dip ] ;
\\ Rotate the top three elements left: `a b c` becomes `b c a`.
<rot-: ( a b c -- b c a ) [ [ swap ] dip swap ] ;
\\ Rotate the top three elements right: `a b c` becomes `c a b`.
-rot>: ( a b c -- c a b ) [ swap [ swap ] dip ] ;
\\ Copy the top element below the second: `a b` becomes `b a b`.
tuck: ( a b -- b a b ) [ swap over ] ;
\\ Select one of two values using a predicate applied to both.
\\ Keeps the first value if the predicate returns true, the second otherwise.
choose: ( a1 a2 quot -- a ) [ [ over over ] dip call [ drop ] [ nip ] if ] ;
\\ Copy the third element to the top of the stack.
pick: ( a b c -- a b c a ) [ [ over ] dip swap ] ;
\\ Call a predicate on the top element, preserving the element below the result.
1check: ( a quot -- a ) [ keep swap ] ;
\\ Swap the top two pairs.
2swap: ( a b c d -- c d a b ) [ 3 <rot-n 3 <rot-n ] ;
\\ Copy the second pair to the top.
2over: ( a b c d -- a b c d a b ) [ 3 pick-n 3 pick-n ] ;
\\ Apply a quotation to one value. Alias for `call`.
1apply: ( ..a x quot: ( ..a x -- ..b ) -- ..b ) [ call ] ;
\\ Apply a quotation to each of two values separately.
2apply: ( ..a x y quot: ( ..a x -- ..b ) -- ..b ) [ 2 apply-n ] ;
\\ Apply a quotation to each of three values separately.
3apply: ( ..a x y z quot: ( ..a x -- ..b ) -- ..b ) [ 3 apply-n ] ;

\\ Keep a byte-array on the stack while extracting its raw FFI pointer.
bytes>ffi-ptr: ( byte-array -- byte-array ptr ) [ dup bytes>ffi-ptr+len drop ] ;
\\ Allocate a byte-array and leave both the byte-array and raw FFI pointer.
bytes-alloc-ptr: ( n -- byte-array ptr ) [ bytes-alloc dup bytes>ffi-ptr+len drop ] ;

\ Arithmetic operators
\\ Negate a number.
-@: ( a -- -a ) [ 0 swap - ] ;
\\ Return the smaller of two values.
min: ( a1 a2 -- a ) [ [ < ] choose ] ;
\\ Return the larger of two values.
max: ( a1 a2 -- a ) [ [ > ] choose ] ;
\\ Decrement by one.
--: ( a1 -- a2 ) [ 1 - ] ;
\\ Increment by one.
++: ( a1 -- a2 ) [ 1 + ] ;
\\ Test whether a value equals zero.
0?: ( a -- ? ) [ 0 = ] ;
\\ Test whether a numeric value is zero.
zero?: ( x -- ? ) [ 0 = ] ;
\\ Test whether a numeric value is strictly positive.
positive?: ( x -- ? ) [ 0 > ] ;
\\ Test whether a numeric value is strictly negative.
negative?: ( x -- ? ) [ 0 < ] ;
\\ Test whether an integer is even.
even?: ( n -- ? ) [ dup integer? [ 2 % 0 = ] [ "integer" throw-type-error ] if ] ;
\\ Test whether an integer is odd.
odd?: ( n -- ? ) [ dup integer? [ 2 % 0 = not ] [ "integer" throw-type-error ] if ] ;
\ Comparison operators
\\ Less than or equal.
<=: ( a b -- ? ) [ 2dup < [ 2drop t ] [ = ] if ] ;
\\ Greater than or equal.
>=: ( a b -- ? ) [ 2dup > [ 2drop t ] [ = ] if ] ;
\\ Not equal.
/=: ( a b -- ? ) [ = not ] ;

\ Boolean operators
\\ Logical negation. Only `f` is falsy.
not: ( ? -- ? ) [ [ f ] [ t ] if ] ;
\\ Short-circuiting logical AND.
and: ( ? ? -- ? ) [ [ ] [ drop f ] if ] ;
\\ Short-circuiting logical OR.
or: ( ? ? -- ? ) [ [ drop t ] [ ] if ] ;
\\ Logical exclusive OR.
xor: ( ? ? -- ? ) [ 2dup and not -rot> or and ] ;

\\ Write a string to a stream as bytes, returning bytes written.
stream-write-string: ( stream str -- n ) [ stream-write ] ;

\\ Drain a value into a string, consuming it. On an in-memory string-builder
\\ stream this moves out the accumulated bytes and closes the stream, so a
\\ later write throws.
>string!: generic ( drainable -- str ) [ "string-builder stream" throw-type-error ] ;
>string!: method{ stream } [ native.string-stream>string! ] ;

\\ Drain a value into a byte-array, consuming it. On an in-memory
\\ string-builder stream this moves out the accumulated bytes zero-copy and
\\ closes the stream, so a later write throws.
>bytes!: generic ( drainable -- bytes ) [ "string-builder stream" throw-type-error ] ;
>bytes!: method{ stream } [ native.string-stream>bytes! ] ;

\ Internal helper: tail-recursive read loop used by stream-read(exact).
\ State carries (stream acc n): stream to read from, accumulator so far,
\ bytes still required.
(stream-read-exact-step): ( stream acc n -- bytes ) [
  dup 0 = [
    drop nip
  ] [
    pick over stream-read
    dup #len 0 = [
      drop drop nip
    ] [
      dup #len
      -rot>
      [ swap - ] dip
      swap
      [ #append ] dip
      (stream-read-exact-step)
    ] if
  ] if
] ;

\\ Read exactly `n` bytes from a stream into a single byte-array, looping
\\ on `stream-read` until the requested count is satisfied or the stream
\\ reaches EOF. Returns a short byte-array (`#len < n`) on EOF; non-EOF
\\ I/O errors propagate as thrown errors.
stream-read(exact): ( stream n -- bytes ) [ B{ } swap (stream-read-exact-step) ] ;

\ Internal helper: tail-recursive write loop used by stream-write(exact).
\ State carries (stream total remaining): stream to write to, bytes written
\ so far, remaining bytes still to write.
(stream-write-exact-step): ( stream total remaining -- n ) [
  dup #len 0 = [
    drop nip
  ] [
    pick over [ stream-write ] [ drop -1 ] recover
    dup 0 <= [
      drop drop nip
    ] [
      [ over #len #slice ] keep
      swap
      [ + ] dip
      (stream-write-exact-step)
    ] if
  ] if
] ;

\\ Write `bytes` to a stream, looping on `stream-write` until the full
\\ count is written or the stream terminates (e.g., the reader closes the
\\ pipe and `stream-write` would yield `EPIPE`). Returns the total count
\\ of bytes successfully written; a return less than the input length
\\ signals that the stream closed before completion.
stream-write(exact): ( stream bytes -- n ) [
  dup string? [ >bytes ] when
  0 swap (stream-write-exact-step)
] ;

\ Stream redirection combinators
\\ Execute a quotation with a different output stream.
with-output-stream: ( stream quot -- ) [ output-stream swap with-parameter ] ;
\\ Execute a quotation with a different input stream.
with-input-stream: ( stream quot -- ) [ input-stream swap with-parameter ] ;

\\ Write a string to the current output stream.
print: ( str -- ) [ output-stream get swap stream-write-string drop ] ;
\\ Write a string followed by a newline.
print-line: ( str -- ) [ print "\n" print flush ] ;

\\ Write a string to the current error stream.
eprint: ( str -- ) [ error-stream get swap stream-write-string drop ] ;
\\ Write a string followed by a newline to the current error stream.
eprint-line: ( str -- ) [ eprint "\n" eprint ] ;
\\ Print a labeled debug snapshot of the current stack to stderr, preserving the label.
trace-stack: ( label -- label ) [
  dup [ native.stack-snapshot ] dip
  [ swap [ ": " #append ] dip #append ] 2keep
  swap <rot- eprint-line drop
] ;
\\ Print a labeled inspected value to stderr, preserving both inputs.
trace-value: ( x label -- x label ) [
  [ swap inspect swap ": " #append swap #append ] 2keep
  <rot- eprint-line
] ;

\\ Write a Unicode code point as a character.
emit: ( codepoint -- ) [ >char print ] ;
\\ Write a newline.
nl: ( -- ) [ "\n" print ] ;
\\ Write a space.
bl: ( -- ) [ " " print ] ;
\\ Flush the current output stream.
flush: ( -- ) [ output-stream get stream-flush ] ;

\\ Read a line from the current input stream, or `f` on EOF.
read-line: ( -- str/f ) [ input-stream get stream-read-line ] ;

\\ Convert a value to a string and print it followed by a newline.
.: ( a -- ) [ inspect print-line ] ;

\ Module loading
\   from search path:  use "testing" ;
\   by file path:      use "file.1z" ;
\                      use "./file.1z" ;
\                      use "path/to/file.1z" ;
\   selective words:   use { word1: word2: } "file.1z" ;
\   allow shadowing:   use "file.1z" shadow-ok ;

EImportConflict: ( -- sym ) [ import-conflict: ] ;

\\ Check that none of the given names shadow words in the current import frame.
\\ Throws an `import-conflict` error if any name is already locally defined.
\\ Generic words are exempt when both sides are generic: multiple modules may
\\ contribute dispatch methods for the same word.
assert-no-shadow: ( module names -- ) [
  { } swap
  [
    dup native.locally-defined?
    [
      dup generic?
      [ 2 pick-n over native.word-markers [ generic = ] #any [ drop ] [ 1array #append ] if ]
      [ 1array #append ]
      if
    ]
    [ drop ]
    if
  ] #each
  dup #empty?
  [ drop drop ]
  [
    "" swap
    [
      >string
      dup native.current-scope swap native.word-source dup
      [ inspect swap " (from " #append swap #append ")" #append ]
      [ drop ]
      if
      swap dup #empty? [ swap #append ] [ ", " #append swap #append ] if
    ] #each
    "use would shadow existing words: " swap #append
    f swap EImportConflict make-error throw
  ]
  if
] ;

\\ Load and import a module by name or file path.
\\ Optionally restrict imported words with a set of symbols.
\\ Insert `shadow-ok` before `;` to suppress the shadow check.
\\ Insert `reload` before `;` to bypass the module cache.
use: parse-time [
  (validate-use-tail): ( values -- ) [
    [
      dup shadow-ok = swap "reload" = or not
      [ inspect "unrecognized token in use: " swap #append
        f swap EInvalidArgument make-error throw
      ]
      when
    ] #each
  ] ;

  (use-load): ( filename modifiers -- module ) [
    "reload" #in? [ reload ] [ load ] if
  ] ;

  (record-use): ( filename words-or-f -- ) [
    over native.resolve-load-path  \ filename words-or-f resolved
    native.record-import
  ] ;

  parse-literal
  dup string?
  [
    \ use "filename" [modifiers] ;
    dup  \ filename filename
    [
      ";" parse-values-until dup (validate-use-tail)
      dup [ (use-load) ] dip
      shadow-ok #in? not
      [ dup dup @keys assert-no-shadow ] when
      import
    ] dip  \ filename
    f (record-use)
  ]
  [
    \ use { selection } "filename" [modifiers] ;
    parse-literal  \ selection filename
    over over      \ selection filename selection filename
    [
      ";" parse-values-until dup (validate-use-tail)
      dup [ (use-load) ] dip  \ { sel } module { mods }
      shadow-ok #in? not      \ { sel } module no-shadow?
      [ over over swap assert-no-shadow ] when
      swap import
    ] 2dip  \ selection filename
    swap (record-use)
  ]
  if
] ;

\\ Reexport all words from a module as public definitions.
reexport: ( module -- ) [
  dup native.module-name swap  \ module-name module
  dup @keys swap import        \ module-name
  [ export ] #each             \ module-name
  dup f swap                   \ module-name f module-name
  native.record-import
] ;

\ Loops
\\ Execute a quotation `n` times.
times: loop-combinator ( n quot -- ) [
  over 0 >
  [
    dup 2dip
    swap -- swap
    times
  ]
  [ 2drop ]
  if
] ;
\\ Loop while the predicate returns true, executing the body each iteration.
while: loop-combinator ( ..a pred: ( ..a -- ..b ? ) body: ( ..b -- ..a ) -- ..b ) [
  swap do compose [ loop ] curry when
] ;
\\ Loop until the predicate returns true, executing the body each iteration.
until: loop-combinator ( ..a pred: ( ..a -- ..b ? ) body: ( ..b -- ..a ) -- ..b ) [
  [ [ not ] compose ] dip while
] ;
\\ Execute the body once before checking the predicate in a `while` loop.
do: ( pred body -- pred body ) [ dup 2dip ] ;
\\ Repeatedly call a quotation while it returns true.
loop: loop-combinator ( ... pred: ( ... -- ... ? ) -- ... ) [
  [ call ] keep [ loop ] curry when
] ;

\ Multi-way dispatch
\\ Dispatch on a value by matching it against an array of `{ key quot }` pairs.
\\ A trailing bare quotation acts as the default branch.
\\ Throws `no-matching-branch` if no branch matches.
case: branch-combinator partial-dispatch ( val branches -- ... ) [
  dup #len 0 = [
    drop no-matching-branch throw
  ] [
    dup #first dup quotation? [
      nip call
    ] [
      dup #first 3 pick-n = [
        #last nip nip call
      ] [
        drop
        dup #len 1 swap #slice case
      ] if
    ] if
  ] if
] ;
\\ Dispatch on the first branch whose predicate returns true.
\\ Each branch is a `{ pred-quot body-quot }` pair.
\\ A trailing bare quotation acts as the default branch.
\\ Throws `no-matching-branch` if no branch matches.
cond: branch-combinator partial-dispatch ( branches -- ... ) [
  dup #len 0 = [
    drop { cond: } no-matching-branch throw
  ] [
    dup #first dup quotation? [
      nip nip call
    ] [
      #first swap [ call ] dip swap [
        dup #first #last nip call
      ] [
        dup #len 1 swap #slice cond
      ] if
    ] if
  ] if
] ;

\ String formatting

\\ Format a string by interpolating values from a source using a template string.
fmt: ( source string -- string ) [ >template interpolate ] ;

\\ Format and print a string followed by a newline.
fmt-line: ( source string -- ) [ fmt print-line ] ;

\ Benchmarking

\\ Run a quotation as a benchmark suite and print the report.
run-benchmarks: ( quot -- ) [ make-benchmark-report swap call print-benchmark-report ] ;

\ Option/Result combinators

\\ Extract the inner value from an option or result, or return the default.
unwrap-or: generic ( opt/res default -- value ) [ drop "option or result" throw-type-error ] ;
unwrap-or: method{ option any } [ swap dup option:some? [ option:some> nip ] [ drop ] if ] ;
unwrap-or: method{ result any } [ swap dup result:ok? [ unmake-result:ok nip ] [ drop ] if ] ;

\\ Extract the inner value, or throw on none/err.
unwrap-or-throw: generic ( opt/res -- value ) [ "option or result" throw-type-error ] ;
unwrap-or-throw: method{ option } [ dup option:some? [ option:some> ] [ drop f "unwrap called on none" ETypeMismatch make-error throw ] if ] ;
unwrap-or-throw: method{ result } [ dup result:ok? [ unmake-result:ok ] [ unmake-result:err throw ] if ] ;

\\ Apply quot to the inner value if some/ok, wrapping the result in some/ok. Pass through none/err unchanged.
?map: generic ( opt/res quot -- opt/res ) [ drop "option or result" throw-type-error ] ;
?map: method{ option quotation } [ swap dup option:some? [ option:some> swap call >option:some ] [ nip ] if ] ;
?map: method{ result quotation } [ swap dup result:ok? [ unmake-result:ok swap call >result:ok ] [ nip ] if ] ;

\\ Apply quot to the inner value if some/ok; quot must itself return an option/result. Pass through none/err unchanged.
?and-then: generic ( opt/res quot -- opt/res ) [ drop "option or result" throw-type-error ] ;
?and-then: method{ option quotation } [ swap dup option:some? [ option:some> swap call ] [ nip ] if ] ;
?and-then: method{ result quotation } [ swap dup result:ok? [ unmake-result:ok swap call ] [ nip ] if ] ;

\\ If none/err, call quot to produce a replacement option/result. If some/ok, pass through unchanged.
?or-else: generic ( opt/res quot -- opt/res ) [ drop "option or result" throw-type-error ] ;
?or-else: method{ option quotation } [ swap dup option:some? [ nip ] [ drop call ] if ] ;
?or-else: method{ result quotation } [ swap dup result:ok? [ nip ] [ drop call ] if ] ;

\\ Unwrap one layer of nesting: some(some(x)) becomes some(x), some(none) becomes none. Same for result.
?flatten: generic ( nested -- opt/res ) [ "option or result" throw-type-error ] ;
?flatten: method{ option } [ dup option:some? [ option:some> ] when ] ;
?flatten: method{ result } [ dup result:ok? [ unmake-result:ok ] when ] ;

\\ Call a quotation, wrapping success in result:ok and thrown errors in result:err.
try: ( quot -- result ) [ [ call >result:ok ] [ >result:err ] recover ] ;

\\ Look up a key in an associative, returning some(value) or none.
@get?: ( assoc key -- option ) [ 2dup @has? [ @get >option:some ] [ 2drop option:none ] if ] ;

\\ Get the nth element of a sequence, returning some(value) or none if out of bounds.
#nth?: ( seq n -- option ) [ [ #nth >option:some ] [ drop option:none ] recover ] ;

\\ Get the first element of a sequence, returning some(value) or none if empty.
#first?: ( seq -- option ) [ [ #first >option:some ] [ drop option:none ] recover ] ;

\\ Get the last element of a sequence, returning some(value) or none if empty.
#last?: ( seq -- option ) [ [ #last >option:some ] [ drop option:none ] recover ] ;

\\ Try to receive from a channel. Returns some(value) on success, none if closed and empty.
receive?: ( ch -- option ) [ [ receive >option:some ] [ drop option:none ] recover ] ;

\\ Create an iterator. Accepts a sequence (delegates to the native) or a quotation
\\ returning option values (wraps to the raw flag convention and creates a callback iterator).
>iterator: generic ( seq-or-quot -- iterator ) [
  dup quotation? [
    [ call dup option:some? [ option:some> t ] [ drop f ] if ] curry
    native.make-callback-iter
  ] [
    native.>iterator
  ] if
] ;

\\ Create an iterator with a cleanup quotation. The step quotation returns option values;
\\ the cleanup quotation runs automatically when the callback iterator is naturally exhausted.
>iterator(with-cleanup): ( step-quot cleanup-quot -- iterator ) [
  swap
  [ call dup option:some? [ option:some> t ] [ drop f ] if ] curry
  swap
  native.make-callback-iter-with-cleanup
] ;

\\ Advance an iterator, returning some(value) or none if exhausted.
#next?: ( iter -- option ) [ [ #next >option:some ] [ drop option:none ] recover ] ;

\\ Close an iterator, running its cleanup quotation if present.
\\ Propagates through adapter chains (#map, #filter, #take, #drop).
\\ No-op on iterators without cleanup. Idempotent.
close-iterator: ( iterator -- ) [ native.close-iterator ] ;

\\ Execute a quotation with an iterator, guaranteeing close-iterator on exit.
using-iterator: ( ..a it: iterator quot: ( ..a it: iterator -- ..b ) -- ..b ) [ over [ close-iterator ] curry cleanup ] ;

\\ Deprecated alias of `using-iterator`.
with-iterator: deprecated ( ..a it: iterator quot: ( ..a it: iterator -- ..b ) -- ..b ) [ using-iterator ] ;

\\ Push each element of a sequence onto the stack individually.
...: ( seq -- ...elems ) [ [ ] #each ] ;

\\ Copy n bytes from an FFI pointer resource into a new byte-array.
\\ The resource is not consumed or closed.
ffi-ptr+len>bytes: ( resource n -- byte-array ) [ native.ffi-ptr+len>bytes ] ;

\\ Blocking acquire: consumes a token or permit from the resource.
\\ Yields to the scheduler until a token is available.
\\ Must be called inside task-scope.
acquire: generic ( resource -- ) [ "acquirable resource" throw-type-error ] ;

\\ Non-blocking acquire: attempts to consume a token without blocking.
\\ Returns option:some on success, option:none if unavailable.
try-acquire: generic ( resource -- option ) [ "acquirable resource" throw-type-error ] ;

\ Introspection struct types

\\ A single parameter in a stack effect declaration.
stack-effect-param: struct{ name: string row-variable?: boolean nested-effect: any type-annotation: any } ;

\\ Format a stack-effect-param as a string for display.
>string: method{ stack-effect-param } [
  dup nested-effect>> dup f = [
    drop
    dup type-annotation>> dup f = [
      drop name>>
    ] [
      native.type-name swap name>> ": " #append swap #append
    ] if
  ] [
    >string swap name>> ": " #append swap #append
  ] if
] ;

\\ Parsed stack effect with input and output parameter lists.
stack-effect-info: struct{ inputs: array outputs: array } ;
\\ Format a stack-effect-info struct as "( inputs -- outputs )".
>string: method{ stack-effect-info } [
  dup inputs>> ""
  [ >string #append " " #append ]
  #reduce swap outputs>> ""
  [ >string #append " " #append ]
  #reduce swap
  "( " swap #append "-- " #append swap #append ")"
  #append
] ;

\\ Source location: file path, line number, and column number.
source-loc: struct{ file: string line: fixnum column: fixnum } ;

\\ Provenance metadata for generated words: generator, parent type, and role.
provenance: struct{ generator: string parent: string role: string } ;

\\ Provenance metadata for a dispatch entry: generator, parent type, role, and field name.
dispatch-provenance: struct{ generator: string parent: string role: string field: string } ;

\\ A single method entry: the dispatch type signature and optional provenance.
method-info: struct{ types: array provenance: any } ;

\\ Structured view of a constraint node, which descibes a base protocol, an intersection, or a union.
\\
\\ - `kind` is one of `protocol:`, `intersection:`, or `union:`. Protocol and combinator nodes carry
\\   `methods` and `f` elements.
\\ - `id` is the monotonic protocol_id or combinator_id.
\\ - `name` is the descriptor name for a protocol, the defining word's name for a top-level combinator,
\\    or `f` for an anonymous (i.e., nested or bare-value) combinator.
\\ - `elements` depends on the type:
\\    - on a concrete type, it's the raw type value; while
\\    - on a protocol and nested-combinator, they're themselves constraint-info records.
constraint-info: struct{
  name:     any
  kind:     symbol
  methods:  any
  elements: any
  id: any
} ;

\\ Convert a raw 5-field record `{name kind methods elements id}` from
\\ native.>constraint-info (or `>word-info`'s protocol field) into a
\\ constraint-info struct, recursing into combinator elements. A raw type-value
\\ element is left first-class; a raw record element is wrapped recursively.
\\ `f` passes through unchanged.
(raw>constraint-info): ( raw -- constraint-info ) stack-recursive [
  dup f = [ ] [
    dup 0 #nth
    over 1 #nth
    2 pick-n 2 #nth
    3 pick-n 3 #nth dup f = [ ] [
      [ dup type-of type = [ ] [ (raw>constraint-info) ] if ] #map #collect
    ] if
    4 pick-n 4 #nth
    make-constraint-info nip
  ] if
] ;

\\ Display name of one combinator element, whether it is a raw type value or a
\\ constraint-info record. Lets consumers walk heterogeneous `elements` without
\\ special-casing the source at each call site.
constraint-element-name: ( element -- string ) [
  dup type-of type = [ native.type-name ] [ name>> ] if
] ;

\\ True when the parameter carries a protocol or combinator bound.
protocol-bound?: ( stack-effect-param -- ? ) [ type-annotation>> type-of constraint = ] ;

\\ True when the parameter carries a concrete-type annotation.
type-bound?: ( stack-effect-param -- ? ) [ type-annotation>> type-of type = ] ;

\\ The bound constraint as a constraint-info struct, or f if the parameter has
\\ no constraint bound. Mirrors the shape of `>word-info protocol>>` so
\\ consumers do not need to special-case the source.
constraint-info>>: ( stack-effect-param -- constraint-info ) [
  dup protocol-bound? [
    type-annotation>> native.>constraint-info (raw>constraint-info)
  ] [ drop f ] if
] ;

\\ Structured word information for runtime introspection.
word-info: struct{ name: string stack-effect: any doc: any markers: array native?: boolean body: any methods: array source-loc: any module: any provenance: any compiled?: boolean protocol: any } ;

\ Helpers lifted out of `(raw>word-info)` so AOT compilation can discover them.
\
\ Defined at module scope alongside `(raw>constraint-info)` rather than in a `private{` block,
\ which the prelude parses too deep to reënter here.

(>param): ( raw -- param ) [
  dup 0 #nth
  over 1 #nth
  2 pick-n 2 #nth (>stack-effect-info)
  3 pick-n 3 #nth
  make-stack-effect-param nip
] ;
(>stack-effect-info): ( raw -- info ) [
  dup f = [ ] [
    dup #first [ (>param) ] #map #collect
    swap #last [ (>param) ] #map #collect
    make-stack-effect-info
  ] if
] ;
(>source-loc):    ( raw -- source-loc )          [ dup f = [ ] [ dup 0 #nth over 1 #nth 2 pick-n 2 #nth make-source-loc nip ] if ] ;
(>provenance):    ( raw -- provenance )          [ dup f = [ ] [ dup 0 #nth over 1 #nth 2 pick-n 2 #nth make-provenance nip ] if ] ;
(>dispatch-prov): ( raw -- dispatch-provenance ) [ dup f = [ ] [ dup 0 #nth over 1 #nth 2 pick-n 2 #nth 3 pick-n 3 #nth make-dispatch-provenance nip ] if ] ;
(>method-info):   ( raw -- method-info )         [ dup 0 #nth swap 1 #nth (>dispatch-prov) make-method-info ] ;

\\ Convert a raw 12-element array from native.>word into a word-info struct.
(raw>word-info): ( raw -- word-info ) [
  dup 0 #nth
  over 1 #nth (>stack-effect-info)
  2 pick-n 2 #nth
  3 pick-n 3 #nth
  4 pick-n 4 #nth
  5 pick-n 5 #nth
  6 pick-n 6 #nth [ (>method-info) ] #map #collect
  7 pick-n 7 #nth (>source-loc)
  8 pick-n 8 #nth
  9 pick-n 9 #nth (>provenance)
  10 pick-n 10 #nth
  11 pick-n 11 #nth (raw>constraint-info)
  make-word-info nip
] ;

\\ Look up a word by symbol and return a word-info struct.
>word-info: ( symbol -- word-info ) [ native.current-scope swap native.>word (raw>word-info) ] ;

\\ Return an array of word-info structs for every word in the dictionary.
all-words: ( -- array ) [ native.all-words [ (raw>word-info) ] #map #collect ] ;

\\ Snapshot the topmost local frame into an importable module.
\\
\\ Intended for capturing private helpers defined inside a quotation: define the helpers as ordinary
\\
\\     name: [ ... ] ;
\\
\\ definitions, which then
\\
\\     [ ... local-scope ] call import
\\
\\ routes into the consuming module's private deps.
local-scope: ( -- module ) [ native.local-scope ] ;

\\ Run a quotation in a fresh local frame, snapshot that frame, and import the snapshot into the
\\ consuming module's deps.
\\
\\ The body's
\\
\\     name: [ ... ] ;
\\
\\ definitions become private helpers visible to the module's own public words but not to importers.
import-locals: ( quotation -- ) [ [ local-scope ] compose call import ] ;

\\ Block-syntax sugar over `import-locals`.
\\
\\ Inside `private{ ... }`, ordinary `name: [ ... ] ;` definitions become private helpers of the
\\ enclosing module:
\\
\\   private{
\\     (helper): [ ... ] ;
\\   }
\\
\\   foo: ( -- string ) [ (helper) ] ;
private{: parse-time [ "}" parse-until import-locals: emit-call ] ;

\\ Safe variant of >word-info that returns an option instead of throwing.
>word-info?: ( symbol -- option ) [ [ >word-info >option:some ] [ drop option:none ] recover ] ;

\\ Return the value of a pragma as an option, or none if unset.
pragma-get?: ( name -- option ) [ native.pragma-get-raw [ >option:some ] [ option:none ] if ] ;

\\ Return the value of a pragma, or throw if unset.
pragma-get: ( name -- value ) [
  pragma-get?
  dup option:some?
  [ option:some> ]
  [ drop f "pragma not set" EKeyNotFound make-error throw ]
  if
] ;

\\ Universal-bool descriptor predicates and kind accessor exposed at the
\\ global namespace. Pass through to the native implementations.
descriptor-numeric?: ( descriptor -- ? )      [ native.descriptor-numeric? ] ;
descriptor-exact?:   ( descriptor -- ? )      [ native.descriptor-exact? ] ;
descriptor-integer?: ( descriptor -- ? )      [ native.descriptor-integer? ] ;
descriptor-mutable?: ( descriptor -- ? )      [ native.descriptor-mutable? ] ;
descriptor-kind:     ( descriptor -- symbol ) [ native.descriptor-kind ] ;

\\ Field names of a descriptor as an array of strings, or option:none if the
\\ kind has no fields concept.
descriptor-fields?: ( descriptor -- option ) [
  [ native.descriptor-fields-raw >option:some ] [ drop option:none ] recover
] ;

\\ Field type annotations of a descriptor, or option:none if the descriptor
\\ carries no annotations (e.g., an untyped struct).
descriptor-field-types?: ( descriptor -- option ) [
  [ native.descriptor-field-types-raw >option:some ] [ drop option:none ] recover
] ;

\\ Inner-type for a virtual or enum-variant descriptor, or option:none.
descriptor-inner-type?: ( descriptor -- option ) [
  [ native.descriptor-inner-type-raw >option:some ] [ drop option:none ] recover
] ;

\\ Parent type for an enum-variant descriptor, or option:none.
descriptor-parent?: ( descriptor -- option ) [
  [ native.descriptor-parent-raw >option:some ] [ drop option:none ] recover
] ;

\\ Variants of an enum descriptor as an array of descriptor-variant structs,
\\ or option:none for non-enum descriptors.
descriptor-variants?: ( descriptor -- option ) [
  [
    native.descriptor-variants-raw
    [ dup 0 #nth swap 1 #nth make-descriptor-variant ] #map #collect
    >option:some
  ] [ drop option:none ] recover
] ;

\\ Resource-kind string for a resource descriptor, or option:none.
descriptor-resource-kind?: ( descriptor -- option ) [
  [ native.descriptor-resource-kind-raw >option:some ] [ drop option:none ] recover
] ;

\\ FFI layout pointer (as fixnum) for an ffi-struct descriptor, or option:none.
descriptor-ffi-layout?: ( descriptor -- option ) [
  [ native.descriptor-ffi-layout-raw >option:some ] [ drop option:none ] recover
] ;
