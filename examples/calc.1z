\ Infix calculator example
\ Usage: 1z examples/calc.1z "2 + 3 * (4 - 1)"

use "conversions" ;
use "lexer" ;
use "pratt/arith" ;
use "strings" ;

CALC-LEXER: const [
  V{ }
  skip-whitespace-rule #push!
  number-rule #push!
  { "+" "-" "*" "/" "(" ")" } symbols-rule #push!
  >array <lexer>
] ;

calc-expr: parameter{ [ "" ] } ;

\ Only a parse error with data carries a position. Any other failure, including running out of
\ input, is placed just past the end.
(error-pos): ( expr error -- pos ) [
  dup error-type: @get parse-error: = [ data: @get ] [ drop f ] if
  dup [ nip offset: @get ] [ drop #len ] if
] ;

(caret-line): ( pos -- str ) [
  " " swap repeat "^" #append
] ;

(parse-complete): ( expr -- value ) [
  CALC-LEXER tokenize <arithmetic-pratt> parse-complete
] ;

(report-error): ( expr error -- ) [
  over eprint-line
  dup message: @get [ (error-pos) (caret-line) eprint-line ] dip
  eprint-line
] ;

(command-expr): ( -- expr ) [
  command-line-args
  dup #len 0 = [
    drop
    "Usage: 1z examples/calc.1z \"EXPR\"" eprint-line
    "missing expression argument" eprint-line
    1 sys-exit
  ] when
  #first
] ;

(command-expr)
dup calc-expr [
  [ (parse-complete) ]
  [ calc-expr get swap (report-error) 1 sys-exit ]
  recover
] with-parameter
>string print-line
