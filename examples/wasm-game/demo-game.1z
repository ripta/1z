\ examples/wasm-game/demo-game.1z - Frame-loop and input smoke test: a square bouncing
\ left/right, its position derived purely from the platform's own tick counter, plus a second
\ square the player nudges with the arrow keys or moves outright with a click, plus a
\ synthesized beep the space key triggers.

use "game" ;
use "math" ;
use "math/packed" ;
use "ranges" ;
use "sequences" ;

private{
  demo-state: mutable struct{ tick player-x player-y beep } ;
  state: 0 100 100 f make-demo-state ;

  square-size:     ( -- n ) const [ 16 ] ;
  travel-distance: ( -- n ) const [ framebuffer-width square-size - ] ;
  wave-period:     ( -- n ) const [ travel-distance 2 * ] ;
  move-step:       ( -- n ) const [ 3 ] ;
  max-player-x:    ( -- n ) const [ framebuffer-width square-size - ] ;
  max-player-y:    ( -- n ) const [ framebuffer-height square-size - ] ;

  \\ A triangle wave over [0, travel-distance], so the square bounces smoothly between the
  \\ left and right edges of the canvas as tick advances.
  square-x: ( tick -- x ) [
    wave-period %
    dup travel-distance >
    [ wave-period swap - ]
    when
  ] ;

  bg-color:     ( -- color ) const [ 10 10 30 255 <color> ] ;
  square-color: ( -- color ) const [ 80 220 120 255 <color> ] ;
  player-color: ( -- color ) const [ 220 90 90 255 <color> ] ;

  beep-rate:      ( -- n ) const [ 8000 ] ;
  beep-frames:    ( -- n ) const [ 1200 ] ;
  beep-frequency: ( -- f ) const [ 440.0 ] ;
  beep-amplitude: ( -- f ) const [ 0.25 ] ;

  \\ A 0.15-second 440 Hz sine at 8000 Hz mono, its amplitude fading linearly to zero so the
  \\ tail does not click.
  \\
  \\ Synthesized once at init; the sample source stays 1z-owned bytes.
  (make-beep): ( -- sample ) [
    beep-frames iota >iterator
    [ dup tau * beep-frequency * beep-rate / sin swap beep-frames swap - * beep-frames / beep-amplitude * ]
    #map #collect
    >packed:f32 unmake-packed-f32
    1 beep-rate <sample>
  ] ;

  \\ Moves the player square to a left press's position, clamped so the square stays on the
  \\ canvas. Every other event is ignored.
  (follow-click): ( event: mouse-event -- ) [
    dup pressed? over button>> left: = and over inside>> and
    [
      dup x>> max-player-x min state swap >>player-x drop
      y>> max-player-y min state swap >>player-y drop
    ]
    [ drop ]
    if
  ] ;
}

demo-init: ( -- ) [ (make-beep) state swap >>beep drop ] ;

\\ Advances the bouncing square's tick and, independently, nudges the player square with
\\ whichever arrow keys are currently held -- proves both the tick-driven update path and
\\ key-down? work together in the same frame.
\\
\\ A left click moves the player square to the click point, proving the mouse event ring
\\ reaches update with each event's own position.
\\
\\ A space press plays the beep once per press, proving key-pressed? edge detection and
\\ play-sample from a game callback.
demo-update: ( tick -- ) [
  state swap >>tick drop

  arrow-left:  key-down? [ state dup player-x>> move-step - 0 max >>player-x drop ] when
  arrow-right: key-down? [ state dup player-x>> move-step + max-player-x min >>player-x drop ] when
  arrow-up:    key-down? [ state dup player-y>> move-step - 0 max >>player-y drop ] when
  arrow-down:  key-down? [ state dup player-y>> move-step + max-player-y min >>player-y drop ] when

  mouse-events [ (follow-click) ] #each

  space: key-pressed? [ state beep>> play-sample ] when
] ;

demo-draw: ( -- ) [
  bg-color clear-background
  state tick>> square-x
  framebuffer-height square-size - 2 div
  square-size square-size
  square-color
  draw-rectangle

  state player-x>> state player-y>> square-size square-size player-color draw-rectangle
] ;

[ demo-init ] [ demo-update ] [ demo-draw ] start-game
