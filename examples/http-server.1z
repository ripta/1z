\ HTTP server with routing.
\
\ Inside a route handler the request value carries three field categories:
\   wire-derived:    method>> path>> query-string>> version>> headers>>
\   socket-derived:  remote-addr>> remote-port>> server-name>> server-port>>
\   TLS-derived:     is-tls?>> tls-version>> tls-cipher>>
\ The TLS fields ride sentinel defaults under plaintext HTTP.
\ See docs/guides/http.md for the full surface.

use "net/http" ;
use "net/http/router" ;
use "net/server" ;
use "time" ;

"Serving on localhost:18081" print-line

<router>
"/time" [ drop now iso8601-fmt format "text/plain" ok ] route
"/healthz" [ drop "ok" "text/plain" ok ] route
"/" [
  path>> "/" =
  [ "/\n/time\n/healthz" "text/plain" ok ]
  [ not-found ]
  if
] route
build

[ nip swap dup -rot> dup read-request <rot- call stream-close ] curry

<server-config>
"127.0.0.1" >>host
18081 >>port
swap >>handler

[ serve-forever ] curry task-scope
