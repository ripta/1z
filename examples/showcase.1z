\ 1Z Language Showcase
\
\ This file demonstrates the core features of 1Z.

\ ------------------------------------------------------------
\ 1. Basic Stack Operations and Arithmetic
\ ------------------------------------------------------------

"=== Basic Operations ===" print-line

\ Push numbers onto the stack and perform arithmetic
10 20 + .                                        \ prints 30

\ Subtraction
100 42 - .                                       \ prints 58

\ The stack is LIFO (last in, first out)
5 3 - .                                          \ 5 - 3 = 2

\ dup duplicates the top of the stack
7 dup + .                                        \ 7 + 7 = 14

\ drop removes the top of the stack
99 42 drop .                                     \ prints 99

\ ------------------------------------------------------------
\ 2. Defining Words (Functions)
\ ------------------------------------------------------------

"" print-line
"=== Word Definitions ===" print-line

\ Words are defined using symbol: [ body ] ;
\ The symbol ends with : and becomes the word's name

double: [ dup + ] ;
7 double .                                       \ prints 14

\ Triple a number
triple: [ dup dup + + ] ;
4 triple .                                       \ prints 12

\ ------------------------------------------------------------
\ 3. Stack Effects (Documentation)
\ ------------------------------------------------------------

"" print-line
"=== Stack Effects ===" print-line

\ Stack effects document how a word transforms the stack
\ Format: ( inputs -- outputs )

inc: ( n -- n ) [ 1 + ] ;
dec: ( n -- n ) [ 1 - ] ;

5 inc .                                          \ prints 6
5 dec .                                          \ prints 4

\ Stack effects are stored and can be queried with help
"Showing help for inc:" print-line
inc: help                           \ shows: inc: ( n -- n )

"Showing help for +:" print-line
+: help                             \ shows: +: ( a b -- a+b )

\ ------------------------------------------------------------
\ 4. Booleans and Comparisons
\ ------------------------------------------------------------

"" print-line
"=== Booleans ===" print-line

\ t and f are boolean literals
t .                          \ prints t
f .                          \ prints f

\ Comparison operators return booleans
5 3 > .                      \ prints t (5 > 3)
5 10 > .                     \ prints f (5 is not > 10)
5 5 = .                      \ prints t (equality)
3 7 < .                      \ prints t (3 < 7)

\ ------------------------------------------------------------
\ 5. Control Flow with Quotations
\ ------------------------------------------------------------

"" print-line
"=== Control Flow ===" print-line

\ Quotations are code blocks: [ ... ]
\ They are pushed onto the stack as values, not executed

\ 'call' executes a quotation
[ 1 2 + ] call .             \ prints 3

\ 'if' takes a condition and two quotations
\ ( condition true-branch false-branch -- )
5 3 >
  [ "five is greater than three" print-line ]
  [ "five is not greater" print-line ]
  if

10 20 <
  [ "ten is less than twenty" print-line ]
  [ "ten is not less" print-line ]
  if

\ 'when' executes only if condition is true
t [ "this runs because condition is true" print-line ] when

\ 'unless' executes only if condition is false
f [ "this runs because condition is false" print-line ] unless

\ More complex conditionals
check-sign: ( n -- )
  [
    dup 0 >
      [ drop "positive" print-line ]
      [ dup 0 <
          [ drop "negative" print-line ]
          [ drop "zero" print-line ]
          if
      ]
      if
  ] ;

5 check-sign
0 5 - check-sign
0 check-sign

\ ------------------------------------------------------------
\ 6. Strings
\ ------------------------------------------------------------

"" print-line
"=== Strings ===" print-line

\ String literals use double quotes
"Hello, 1Z!" print-line

\ Strings are values and can be stored in word definitions
greeting: [ "Welcome to the showcase!" ] ;
greeting print-line

\ Strings can contain multiple words
"Strings can have spaces and punctuation!" print-line

\ ------------------------------------------------------------
\ 7. Arrays (Immutable Sequences)
\ ------------------------------------------------------------

"" print-line
"=== Arrays ===" print-line

\ Arrays use curly braces: { ... }
"A simple array:" print-line
{ 1 2 3 } .

"Another array:" print-line
{ 10 20 30 40 50 } .

\ Nested arrays of numbers
"Nested arrays (matrix):" print-line
{ { 1 2 } { 3 4 } } .

\ Multi-line arrays work too
"Multi-line array:" print-line
{
  100
  200
  300
} .

\ Array with strings
"String array:" print-line
{ "apple" "banana" "cherry" } .

\ ------------------------------------------------------------
\ 8. Error Handling with Combinators
\ ------------------------------------------------------------

"" print-line
"=== Error Handling ===" print-line

\ 'recover' catches errors: ( try-quot recover-quot -- )
\ If try-quot fails, recover-quot runs with error on stack
\ recover-quot has effect ( error -- ), consuming the error

\ This succeeds normally
"Successful operation:" print-line
[ 5 3 + . ] [ drop "error" print-line ] recover

\ This would fail (stack underflow), so recovery runs
"Recovered from error:" print-line
[ drop ] [ drop "recovered!" print-line ] recover

\ 'ignore-errors' suppresses any errors
[ drop ] ignore-errors              \ silently continues
"Program continued after suppressed error" print-line

\ Nested error handling
"Nested recovery (inner recovers):" print-line
[ [ drop ] [ drop "inner" print-line ] recover ] [ drop "outer" print-line ] recover

\ ------------------------------------------------------------
\ 9. Higher-Order Programming
\ ------------------------------------------------------------

"" print-line
"=== Higher-Order Programming ===" print-line

\ Quotations enable functional programming patterns

\ Execute a quotation twice
do-twice: ( quot -- ) [ dup call call ] ;

"Calling print-line twice:" print-line
[ "hello" print-line ] do-twice

\ Quotations capture operations
"Executing a math quotation:" print-line
[ 3 4 + ] call .

"Another quotation example:" print-line
[ 10 20 + 5 - ] call .

\ ------------------------------------------------------------
\ 10. Abstractions
\ ------------------------------------------------------------

"" print-line
"=== Abstractions ===" print-line

\ Check if zero
zero?: ( n -- ? ) [ 0 = ] ;
"Is 0 zero?" print-line  0 zero? .       \ t
"Is 5 zero?" print-line  5 zero? .       \ f

\ Check if positive
positive?: ( n -- ? ) [ 0 > ] ;
"Is 5 positive?" print-line  5 positive? .

\ Check if negative
negative?: ( n -- ? ) [ 0 < ] ;
"Is -3 negative?" print-line  0 3 - negative? .

\ Quadruple by composing double
quadruple: ( n -- n ) [ double double ] ;
"3 quadrupled:" print-line  3 quadruple .

\ Sum of three numbers
sum3: ( a b c -- sum ) [ + + ] ;
"1 + 2 + 3 =" print-line  1 2 3 sum3 .

\ ------------------------------------------------------------
\ 11. Data <=> Code
\ ------------------------------------------------------------

"" print-line
"=== Data <=> Code ===" print-line

\ Define data templates
point: [ { 10 20 } ] ;
"A point:" print-line
point .

\ Arrays of numbers as data
coords: [ { 100 200 300 } ] ;
"Coordinates:" print-line
coords .

\ Arrays of strings as data
colors: [ { "red" "green" "blue" } ] ;
"Colors:" print-line
colors .

\ ------------------------------------------------------------
\ 12. Mini Calculator Demo
\ ------------------------------------------------------------

"" print-line
"=== Calculator Demo ===" print-line

calc-add: ( a b -- ) [ + "Result:" print-line . ] ;
calc-sub: ( a b -- ) [ - "Result:" print-line . ] ;

"5 + 3:" print-line
5 3 calc-add

"10 - 4:" print-line
10 4 calc-sub

"7 doubled:" print-line
7 double "Result:" print-line .

"3 quadrupled:" print-line
3 quadruple "Result:" print-line .

