\ Integration tests for lib/data/json.1z

use "testing" ;
use "data/json" ;
use "char" ;

\ -- hex-digit? and hex>fixnum tests (added to lib/char.1z) --

"hex-digit?" test-section
t "0" hex-digit? "0 is hex digit" assert-true
t "9" hex-digit? "9 is hex digit" assert-true
t "a" hex-digit? "a is hex digit" assert-true
t "f" hex-digit? "f is hex digit" assert-true
t "A" hex-digit? "A is hex digit" assert-true
t "F" hex-digit? "F is hex digit" assert-true
f "g" hex-digit? "g is not hex digit" assert-false
f "G" hex-digit? "G is not hex digit" assert-false
f " " hex-digit? "space is not hex digit" assert-false

"hex>fixnum" test-section
0 "0" hex>fixnum "0 hex value" assert=
9 "9" hex>fixnum "9 hex value" assert=
10 "a" hex>fixnum "a hex value" assert=
15 "f" hex>fixnum "f hex value" assert=
10 "A" hex>fixnum "A hex value" assert=
15 "F" hex>fixnum "F hex value" assert=
[ "g" hex>fixnum ] "hex>fixnum on non-hex throws" assert-error

\ -- parse-json: primitives --

"parse-json: strings" test-section
"hello" "\"hello\"" parse-json "simple string" assert=
"" "\"\"" parse-json "empty string" assert=
"hello world" "\"hello world\"" parse-json "string with space" assert=
"café" "\"café\"" parse-json "multi-byte string value" assert=
"héllo wörld" "\"héllo wörld\"" parse-json "multi-byte string with space" assert=

"parse-json: string escapes" test-section
"hello\nworld" "\"hello\\nworld\"" parse-json "newline escape" assert=
"tab\there" "\"tab\\there\"" parse-json "tab escape" assert=
"a\"b" "\"a\\\"b\"" parse-json "quote escape" assert=
"a\\b" "\"a\\\\b\"" parse-json "backslash escape" assert=
"a/b" "\"a\\/b\"" parse-json "slash escape" assert=

"parse-json: unicode escapes" test-section
"A" "\"\\u0041\"" parse-json "unicode escape A" assert=

"parse-json: integers" test-section
42 "42" parse-json "positive integer" assert=
0 "0" parse-json "zero" assert=
-1 "-1" parse-json "negative integer" assert=
123456789 "123456789" parse-json "large integer" assert=

"parse-json: floats" test-section
3.14 "3.14" parse-json "decimal" assert=
1.0e10 "1e10" parse-json "exponent" assert=
-0.5 "-0.5" parse-json "negative decimal" assert=
1.23e4 "1.23e4" parse-json "decimal with exponent" assert=

"parse-json: booleans" test-section
t "true" parse-json "true" assert=
f "false" parse-json "false" assert=

"parse-json: null" test-section
option:none "null" parse-json "null becomes option:none" assert=

\ -- parse-json: arrays --

"parse-json: arrays" test-section
{ } "[]" parse-json "empty array" assert=
{ 1 2 3 } "[1, 2, 3]" parse-json "integer array" assert=
{ "a" "b" } "[\"a\", \"b\"]" parse-json "string array" assert=
"[1, \"two\", true]" parse-json
dup 0 #nth 1 "mixed array first" assert=
dup 1 #nth "two" "mixed array second" assert=
2 #nth t "mixed array third" assert=
{ { 1 2 } { 3 4 } } "[[1, 2], [3, 4]]" parse-json "nested arrays" assert=

\ -- parse-json: objects --

"parse-json: objects" test-section
H{ } "{}" parse-json "empty object" assert=

"{\"a\": 1}" parse-json
dup "a" @get 1 "object value" assert=
@keys #len 1 "single key" assert=

"{\"name\": \"alice\", \"age\": 30}" parse-json
dup "name" @get "alice" "object string value" assert=
"age" @get 30 "object integer value" assert=

"parse-json: nested objects" test-section
"{\"outer\": {\"inner\": 42}}" parse-json
"outer" @get "inner" @get 42 "nested object access" assert=

"parse-json: complex structure" test-section
"{\"users\": [{\"name\": \"alice\"}, {\"name\": \"bob\"}]}" parse-json
"users" @get
dup 1 #nth "name" @get "bob" "array of objects access" assert=
0 #nth "name" @get "alice" "first user name" assert=

\ -- parse-json: whitespace handling --

"parse-json: whitespace" test-section
42 "  42  " parse-json "leading/trailing whitespace" assert=
{ 1 2 } "[ 1 , 2 ]" parse-json "array with whitespace" assert=
"{\n  \"a\" : 1\n}" parse-json
"a" @get 1 "object with newlines" assert=

\ -- parse-json: error cases --

"parse-json: errors" test-section
[ "" parse-json ] "empty input throws" assert-error
[ "{" parse-json ] "unclosed object throws" assert-error
[ "[" parse-json ] "unclosed array throws" assert-error
[ "\"hello" parse-json ] "unterminated string throws" assert-error
[ "tru" parse-json ] "truncated true throws" assert-error
[ "42 extra" parse-json ] "trailing content throws" assert-error
[ "{\"a\": 1,}" parse-json ] "trailing comma in object throws" assert-error

\ -- parse-json: error positions --

\ Parse input that must fail and assert the failure is a parse error. The error itself stays off
\ the stack, since the stack dump would print its call chain, which differs in the eager run.
json-failure: ( input: string -- data message ) [
  [ parse-json drop f ] [ nip ] recover
  dup data: @get swap dup message: @get swap error-type: @get
  parse-error: "parse-json raises parse-error:" assert=
] ;

"parse-json: string error positions" test-section
"\"hello" json-failure
"unterminated JSON string at position 0" "unterminated string message" assert=
dup offset: @get 0 "unterminated string points at its opening quote" assert=
text: @has? "unterminated string carries no text" assert-false

"[1, \"ab" json-failure drop offset: @get 4 "unterminated string after a prefix" assert=

"\"\\q\"" json-failure
"invalid JSON escape: \\q at position 1" "bad escape message" assert=
dup offset: @get 1 "bad escape points at the backslash" assert=
text: @get "\\q" "bad escape text is the escape" assert=

"\"ab\\" json-failure
"unterminated JSON escape at position 4" "trailing backslash message" assert=
offset: @get 4 "trailing backslash points at the end" assert=

"\"\\uZZZZ\"" json-failure
"expected 4 hex digits after \\u at position 3" "bad hex digit message" assert=
offset: @get 3 "bad hex digit points at the digit" assert=

"\"\\u12" json-failure drop offset: @get 5 "truncated \\u escape points at the end" assert=

"\"\\ud83dx\"" json-failure
"expected \\uXXXX for surrogate pair at position 7" "missing low half message" assert=
offset: @get 7 "missing low half points after the high half" assert=

"\"\\ud83d\\x\"" json-failure
"expected low surrogate after \\uXXXX at position 7" "non-u escape message" assert=
offset: @get 7 "non-u escape points at its backslash" assert=

"\"\\ud83d\\u0041\"" json-failure
"expected low surrogate after \\uXXXX at position 7" "non-low half message" assert=
offset: @get 7 "non-low half points at its escape" assert=

"parse-json: structure error positions" test-section
"{\"a\": 1,}" json-failure
"trailing comma in JSON object at position 7" "object trailing comma message" assert=
offset: @get 7 "object trailing comma points at the comma" assert=

"[1,]" json-failure
"trailing comma in JSON array at position 2" "array trailing comma message" assert=
offset: @get 2 "array trailing comma points at the comma" assert=

"{\"a\":1 \"b\":2}" json-failure
"expected ',' or '}' at position 7" "object missing comma message" assert=
offset: @get 7 "object missing comma points at the next member" assert=

"[1 2]" json-failure
"expected ',' or ']' at position 3" "array missing comma message" assert=
offset: @get 3 "array missing comma points at the next element" assert=

"{\"a\":1" json-failure
"expected ',' or '}' at position 6" "missing brace message" assert=
offset: @get 6 "missing brace points at the end" assert=

"[1, 2" json-failure
"expected ',' or ']' at position 5" "missing bracket message" assert=
offset: @get 5 "missing bracket points at the end" assert=

"{\"a\" 1}" json-failure
"expected ':' after object key at position 5" "missing colon message" assert=
offset: @get 5 "missing colon points at the value" assert=

"{1:2}" json-failure
"expected string key in JSON object at position 1" "non-string key message" assert=
offset: @get 1 "non-string key points at the key" assert=

"" json-failure
"unexpected end of JSON input at position 0" "empty input message" assert=
offset: @get 0 "empty input points at the end" assert=

"42 extra" json-failure
"unexpected trailing content after JSON value at position 3" "trailing content message"
assert=
offset: @get 3 "trailing content points at the first trailing character" assert=

"{\"a\": tru}" json-failure
"expected \"true\" but found \"tru}\" at position 6" "truncated literal message" assert=
dup offset: @get 6 "truncated literal offset" assert=
text: @get "tru}" "truncated literal text" assert=

"parse-json: value error positions" test-section
"x" json-failure
"unexpected character in JSON at position 0" "unexpected character message" assert=
offset: @get 0 "unexpected character offset" assert=

"[\"é\", x]" json-failure drop offset: @get 6 "the offset counts codepoints, not bytes" assert=

"[1-2]" json-failure
"invalid JSON number '1-2' at position 1" "bad number message" assert=
dup offset: @get 1 "bad number points at its start" assert=
text: @get "1-2" "bad number text is the token" assert=

"01" json-failure drop text: @get "01" "a leading zero is rejected" assert=
"1." json-failure drop text: @get "1." "a bare decimal point is rejected" assert=
"+1" json-failure drop text: @get "+1" "a leading plus is rejected" assert=
"1e" json-failure drop text: @get "1e" "an empty exponent is rejected" assert=
"1.2.3" json-failure drop text: @get "1.2.3" "a second decimal point is rejected" assert=
"-" json-failure drop text: @get "-" "a lone minus is rejected" assert=

"parse-json: numbers the grammar accepts" test-section
0 "-0" parse-json "negative zero" assert=
100000.0 "1E+5" parse-json "uppercase exponent with sign" assert=
-0.0005 "-0.5e-3" parse-json "negative exponent" assert=
0.5 "0.5" parse-json "zero before the decimal point" assert=
123456789012345678901234567890 "123456789012345678901234567890" parse-json "bignum" assert=

"parse-json: surrogate pairs" test-section
"😀" "\"\\ud83d\\ude00\"" parse-json "surrogate pair decodes" assert=
"a😀b" "a\\ud83d\\ude00b" json-unescape "json-unescape decodes a surrogate pair" assert=

"json-unescape: error positions" test-section
[ "ab\\q" json-unescape ] [ ] recover dup data: @get swap message: @get
"invalid JSON escape: \\q at position 2" "json-unescape bad escape message" assert=
offset: @get 2 "json-unescape offset is into its argument" assert=

\ -- json-unescape --

"json-unescape" test-section
"hello" "hello" json-unescape "plain string unchanged" assert=
"a\"b" "a\\\"b" json-unescape "unescape quote" assert=
"a\\b" "a\\\\b" json-unescape "unescape backslash" assert=
"line1\nline2" "line1\\nline2" json-unescape "unescape newline" assert=
"tab\there" "tab\\there" json-unescape "unescape tab" assert=
"A" "\\u0041" json-unescape "unescape unicode" assert=

\ -- json-escape --

"json-escape" test-section
"hello" "hello" json-escape "plain string unchanged" assert=
"a\\\"b" "a\"b" json-escape "escape quote" assert=
"a\\\\b" "a\\b" json-escape "escape backslash" assert=
"line1\\nline2" "line1\nline2" json-escape "escape newline" assert=
"tab\\there" "tab\there" json-escape "escape tab" assert=
"\\u0001" 1 >char json-escape "escape control char as unicode" assert=

\ -- emit-json --

"emit-json" test-section
"42" 42 emit-json "emit integer" assert=
"3.5" 3.5 emit-json "emit float" assert=
"true" t emit-json "emit true" assert=
"false" f emit-json "emit false" assert=
"null" option:none emit-json "emit null" assert=
"\"hello\\nworld\"" "hello\nworld" emit-json "emit escaped string" assert=
"[1,\"two\",false,null]" parse-json emit-json parse-json 0 #nth 1 "emit mixed array first" assert=
"[1,\"two\",false,null]" parse-json emit-json parse-json 1 #nth "two" "emit mixed array second" assert=
"[1,\"two\",false,null]" parse-json emit-json parse-json 2 #nth f "emit mixed array third" assert=
"[1,\"two\",false,null]" parse-json emit-json parse-json 3 #nth option:none? "emit mixed array fourth null" assert-true
"{\"b\":2,\"a\":1}" parse-json emit-json 0 #nth "{" "emit object sorted char 0" assert=
"{\"b\":2,\"a\":1}" parse-json emit-json 1 #nth 34 >char "emit object sorted char 1" assert=
"{\"b\":2,\"a\":1}" parse-json emit-json 2 #nth "a" "emit object sorted char 2" assert=
"{\"b\":2,\"a\":1}" parse-json emit-json 7 #nth 34 >char "emit object sorted char 7" assert=
"{\"b\":2,\"a\":1}" parse-json emit-json 8 #nth "b" "emit object sorted char 8" assert=
"{\"b\":2,\"a\":1}" parse-json emit-json parse-json "a" @get 1 "emit object sorted value a" assert=
"{\"b\":2,\"a\":1}" parse-json emit-json parse-json "b" @get 2 "emit object sorted value b" assert=
"{\"z\":[2,3],\"outer\":{\"a\":1}}" parse-json emit-json parse-json "outer" @get "a" @get 1 "emit nested outer.a" assert=
"{\"z\":[2,3],\"outer\":{\"a\":1}}" parse-json emit-json parse-json "z" @get 1 #nth 3 "emit nested z[1]" assert=

\ -- emit-json-pretty --

"emit-json-pretty" test-section
"[\n  1,\n  \"two\",\n  null\n]" "[1,\"two\",null]" parse-json emit-json-pretty "pretty array" assert=
"{\"b\":{\"c\":true},\"a\":1}" parse-json emit-json-pretty 0 #nth "{" "pretty nested char 0" assert=
"{\"b\":{\"c\":true},\"a\":1}" parse-json emit-json-pretty 1 #nth "\n" "pretty nested char 1" assert=
"{\"b\":{\"c\":true},\"a\":1}" parse-json emit-json-pretty 5 #nth "a" "pretty nested first key starts with a" assert=
"{\"b\":{\"c\":true},\"a\":1}" parse-json emit-json-pretty 15 #nth "b" "pretty nested second key starts with b" assert=
"{\"b\":{\"c\":true},\"a\":1}" parse-json emit-json-pretty parse-json "a" @get 1 "pretty nested roundtrip a" assert=

\ -- emit-json: errors --

"emit-json: errors" test-section
[ { 1 2 } >option:some emit-json ] "unsupported option:some throws" assert-error
