use "testing" ;
use "ratio" ;

"cross-type equality: fixnum/float" test-section
1 1.0 = "1 = 1.0" assert-true
1.0 1 = "1.0 = 1" assert-true
1 1.5 = "1 /= 1.5" assert-false

"cross-type equality: bignum/float" test-section
99999999999999999999 1.0e20 = "bignum = float (approx)" assert-true
1.0e20 99999999999999999999 = "float = bignum (approx)" assert-true

"cross-type equality: ratio/float" test-section
1 2 normalize-ratio 0.5 = "1/2 = 0.5" assert-true
0.5 1 2 normalize-ratio = "0.5 = 1/2" assert-true
1 3 normalize-ratio 0.5 = "1/3 /= 0.5" assert-false

"cross-type less-than: fixnum/float" test-section
1 1.5 < "1 < 1.5" assert-true
1.5 1 < "1.5 < 1 is false" assert-false

"cross-type less-than: bignum/float" test-section
99999999999999999999 2.0e20 < "bignum < larger float" assert-true
2.0e20 99999999999999999999 < "larger float < bignum is false" assert-false

"cross-type less-than: ratio/float" test-section
1 3 normalize-ratio 0.5 < "1/3 < 0.5" assert-true
0.5 1 3 normalize-ratio < "0.5 < 1/3 is false" assert-false

"cross-type greater-than: fixnum/float" test-section
2 1.5 > "2 > 1.5" assert-true
1.5 2 > "1.5 > 2 is false" assert-false

"cross-type greater-than: bignum/float" test-section
99999999999999999999 5.0e19 > "bignum > smaller float" assert-true
5.0e19 99999999999999999999 > "smaller float > bignum is false" assert-false

"cross-type greater-than: ratio/float" test-section
3 4 normalize-ratio 0.5 > "3/4 > 0.5" assert-true
0.5 3 4 normalize-ratio > "0.5 > 3/4 is false" assert-false
