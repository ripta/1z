\ Integration tests for lib/data/url.1z

use "testing" ;
use "data/url" ;

"encode-bytes: unreserved passthrough" test-section

B{ } B{ } encode-bytes "empty byte-array round-trips" assert=

B{ 0x41 0x42 0x43 0x58 0x59 0x5A } B{ 0x41 0x42 0x43 0x58 0x59 0x5A }
encode-bytes "uppercase letters pass through" assert=

B{ 0x61 0x62 0x63 0x78 0x79 0x7A } B{ 0x61 0x62 0x63 0x78 0x79 0x7A }
encode-bytes "lowercase letters pass through" assert=

B{ 0x30 0x35 0x39 } B{ 0x30 0x35 0x39 }
encode-bytes "digits pass through" assert=

B{ 0x2D 0x2E 0x5F 0x7E } B{ 0x2D 0x2E 0x5F 0x7E }
encode-bytes "dash dot underscore tilde pass through" assert=

"encode-bytes: reserved bytes encode to %HH" test-section

B{ 0x25 0x32 0x30 } B{ 0x20 } encode-bytes "space encodes to %20" assert=

B{ 0x25 0x32 0x46 } B{ 0x2F } encode-bytes "slash encodes to %2F" assert=

B{ 0x25 0x33 0x46 } B{ 0x3F } encode-bytes "question mark encodes to %3F" assert=

B{ 0x25 0x33 0x44 } B{ 0x3D } encode-bytes "equals encodes to %3D" assert=

B{ 0x25 0x32 0x36 } B{ 0x26 } encode-bytes "ampersand encodes to %26" assert=

B{ 0x25 0x32 0x42 } B{ 0x2B } encode-bytes "plus encodes to %2B" assert=

B{ 0x25 0x32 0x35 } B{ 0x25 } encode-bytes "percent encodes to %25 (no passthrough)" assert=

B{ 0x25 0x32 0x35 0x47 } B{ 0x25 0x47 } encode-bytes
"literal %G encodes to %25G (encoder treats % as ordinary)" assert=

"encode-bytes: non-ASCII bytes" test-section

B{ 0x25 0x38 0x30 } B{ 0x80 } encode-bytes "0x80 encodes to %80" assert=

B{ 0x25 0x46 0x46 } B{ 0xFF } encode-bytes "0xFF encodes to %FF (uppercase hex)" assert=

B{ 0x25 0x41 0x42 } B{ 0xAB } encode-bytes "0xAB encodes to %AB (both nibbles letters)" assert=

B{ 0x25 0x43 0x33 0x25 0x41 0x39 } B{ 0xC3 0xA9 } encode-bytes
"multi-byte UTF-8 bytes encode pairwise" assert=

"decode-bytes: round-trip with encode-bytes" test-section

B{ } B{ } encode-bytes decode-bytes "empty round-trip" assert=

B{ 0x41 0x42 0x43 } B{ 0x41 0x42 0x43 } encode-bytes decode-bytes
"unreserved letters round-trip" assert=

B{ 0x20 0x2F 0x3F 0x3D 0x26 0x2B 0x25 }
B{ 0x20 0x2F 0x3F 0x3D 0x26 0x2B 0x25 } encode-bytes decode-bytes
"reserved bytes round-trip" assert=

B{ 0x00 0x7F 0x80 0xFF } B{ 0x00 0x7F 0x80 0xFF } encode-bytes decode-bytes
"binary bytes round-trip" assert=

"decode-bytes: lowercase and uppercase hex both decode" test-section

B{ 0x2F } B{ 0x25 0x32 0x46 } decode-bytes "uppercase %2F decodes to /" assert=

B{ 0x2F } B{ 0x25 0x32 0x66 } decode-bytes "lowercase %2f decodes to /" assert=

B{ 0xFF } B{ 0x25 0x46 0x46 } decode-bytes "uppercase %FF decodes to 0xFF" assert=

B{ 0xFF } B{ 0x25 0x66 0x66 } decode-bytes "lowercase %ff decodes to 0xFF" assert=

B{ 0xAB } B{ 0x25 0x61 0x42 } decode-bytes "mixed-case %aB decodes to 0xAB" assert=

"decode-bytes: literal non-percent bytes pass through" test-section

B{ 0x2B } B{ 0x2B } decode-bytes "plus is literal in non-form mode" assert=

B{ 0x2F 0x3F 0x3D } B{ 0x2F 0x3F 0x3D } decode-bytes
"sub-delims pass through when not percent-prefixed" assert=

"decode-bytes: malformed input throws" test-section

[ B{ 0x25 } decode-bytes ] "trailing % alone throws" assert-error
[ B{ 0x25 } decode-bytes ] EInvalidArgument
"trailing % alone is EInvalidArgument" assert-error-type

[ B{ 0x25 0x41 } decode-bytes ] "%A with one trailing digit throws" assert-error
[ B{ 0x25 0x41 } decode-bytes ] EInvalidArgument
"%A is EInvalidArgument" assert-error-type

[ B{ 0x25 0x47 0x41 } decode-bytes ] "%GA (first non-hex) throws" assert-error
[ B{ 0x25 0x41 0x47 } decode-bytes ] "%AG (second non-hex) throws" assert-error
[ B{ 0x25 0x21 0x22 } decode-bytes ] "%!\" (both non-hex) throws" assert-error
[ B{ 0x41 0x25 } decode-bytes ] "trailing % after content throws" assert-error

"encode: string-layer wrapper" test-section

"" "" encode "empty string round-trips" assert=

"hello" "hello" encode "unreserved ASCII passes through" assert=

"abcXYZ-._~0123" "abcXYZ-._~0123" encode "full unreserved set passes through" assert=

"a%20b" "a b" encode "space in string encodes to %20" assert=

"a%2Fb%3Fc%3Dd%26e%2Bf%25g" "a/b?c=d&e+f%g" encode
"ASCII reserved characters encode to %HH" assert=

"caf%C3%A9" "café" encode "multibyte UTF-8 (é) encodes pairwise" assert=

"%E4%B8%AD" "中" encode "multibyte UTF-8 (CJK 中) encodes pairwise" assert=

"a%20caf%C3%A9%2F%E4%B8%AD" "a café/中" encode
"mixed ASCII and multibyte string encodes pairwise" assert=

"decode: string-layer wrapper" test-section

"" "" decode "empty string round-trips" assert=

"hello" "hello" decode "unreserved ASCII passes through" assert=

"a b" "a%20b" decode "space %20 decodes back" assert=

"café" "caf%C3%A9" decode "multibyte UTF-8 (é) decodes back" assert=

"中" "%E4%B8%AD" decode "multibyte UTF-8 (CJK 中) decodes back" assert=

"a/b?c=d&e+f%g" "a%2Fb%3Fc%3Dd%26e%2Bf%25g" decode
"reserved characters decode back" assert=

"encode/decode: string round-trip" test-section

"hello" dup encode decode "ASCII unreserved round-trips" assert=

"a b/c?d=e&f+g%h" dup encode decode "ASCII reserved round-trips" assert=

"café" dup encode decode "café round-trips" assert=

"中文" dup encode decode "CJK 中文 round-trips" assert=

"a café/中" dup encode decode "mixed ASCII and multibyte round-trips" assert=

"decode: malformed string input throws" test-section

[ "%" decode ] "trailing % alone (string) throws" assert-error
[ "%" decode ] EInvalidArgument
"trailing % alone (string) is EInvalidArgument" assert-error-type

[ "%G1" decode ] "%G1 (first non-hex, string) throws" assert-error
[ "%1G" decode ] "%1G (second non-hex, string) throws" assert-error

"encode(form): space-as-+" test-section

"" "" encode(form) "empty string round-trips" assert=

"hello" "hello" encode(form) "unreserved ASCII passes through" assert=

"abcXYZ-._~0123" "abcXYZ-._~0123" encode(form)
"full unreserved set passes through" assert=

"a+b" "a b" encode(form) "single space encodes to +" assert=

"a+b+c" "a b c" encode(form) "multiple spaces each encode to +" assert=

"+" " " encode(form) "lone space encodes to lone +" assert=

"+++" "   " encode(form) "run of spaces encodes to run of +" assert=

"encode(form): literal + and other reserved encode to %HH" test-section

"a%2Bb" "a+b" encode(form) "literal + encodes to %2B" assert=

"%2B%2B" "++" encode(form) "literal ++ encodes to %2B%2B" assert=

"a+%2Bb" "a +b" encode(form)
"space then literal + encodes as + then %2B" assert=

"a%2F%3D%26" "a/=&" encode(form)
"non-space reserved bytes still percent-encode" assert=

"%25" "%" encode(form) "literal % still encodes to %25" assert=

"caf%C3%A9" "café" encode(form) "multibyte UTF-8 encodes pairwise" assert=

"decode(form): + decodes to space" test-section

"" "" decode(form) "empty string round-trips" assert=

"hello" "hello" decode(form) "unreserved ASCII passes through" assert=

"a b" "a+b" decode(form) "+ decodes to space" assert=

"a b c" "a+b+c" decode(form) "multiple + each decode to space" assert=

" " "+" decode(form) "lone + decodes to lone space" assert=

"decode(form): %2B decodes to literal +" test-section

"a+b" "a%2Bb" decode(form) "%2B decodes to literal +" assert=

"a b+c" "a+b%2Bc" decode(form)
"+ becomes space, %2B becomes literal + in same input" assert=

"++" "%2B%2B" decode(form) "%2B%2B decodes to ++" assert=

"encode(form)/decode(form): round-trip" test-section

"a b+c" dup encode(form) decode(form)
"space and literal + round-trip" assert=

"a b/c?d=e&f+g%h" dup encode(form) decode(form)
"mixed reserved characters round-trip" assert=

"café" dup encode(form) decode(form) "café round-trips" assert=

"a b+café/中" dup encode(form) decode(form)
"mixed ASCII, +, multibyte UTF-8 round-trip" assert=

"decode-bytes(form): byte-level form decode" test-section

B{ 0x20 } B{ 0x2B } decode-bytes(form) "+ byte decodes to space byte" assert=

B{ 0x2B } B{ 0x25 0x32 0x42 } decode-bytes(form)
"%2B triple decodes to literal + byte" assert=

B{ 0x20 0x2B 0x20 } B{ 0x2B 0x25 0x32 0x42 0x2B } decode-bytes(form)
"mixed + and %2B in bytes decode independently" assert=

B{ } B{ } decode-bytes(form) "empty byte-array round-trips" assert=

B{ 0xFF } B{ 0x25 0x46 0x46 } decode-bytes(form)
"%FF still decodes as in non-form mode" assert=

"decode-bytes(form): malformed input still throws" test-section

[ B{ 0x25 } decode-bytes(form) ] "trailing % alone throws" assert-error
[ B{ 0x25 } decode-bytes(form) ] EInvalidArgument
"trailing % alone is EInvalidArgument" assert-error-type

[ B{ 0x25 0x47 0x41 } decode-bytes(form) ] "%GA (non-hex) throws" assert-error
[ B{ 0x2B 0x25 } decode-bytes(form) ]
"+ then trailing % still throws" assert-error

"decode-query: typical key-value pairs" test-section

H{ } "" decode-query "empty input yields empty hash" assert=

H{ a: { "1" } b: { "2" } } "a=1&b=2" decode-query
"typical two-pair query" assert=

H{ k: { "value" } } "k=value" decode-query "single pair" assert=

"decode-query: repeated keys accumulate" test-section

H{ tag: { "a" "b" } } "tag=a&tag=b" decode-query
"two values under same key, in order" assert=

H{ tag: { "a" "b" "c" } } "tag=a&tag=b&tag=c" decode-query
"three values under same key, in order" assert=

H{ a: { "1" "3" } b: { "2" } } "a=1&b=2&a=3" decode-query
"interleaved repeated key keeps insertion order" assert=

"decode-query: empty values" test-section

H{ a: { "" } b: { "" } } "a=&b=" decode-query
"both values empty (with =)" assert=

H{ a: { "" } } "a=" decode-query
"single empty value" assert=

"decode-query: bare keys (no =)" test-section

H{ flag: { "" } } "flag" decode-query
"bare key produces empty-value entry" assert=

H{ flag: { "" } a: { "1" } } "flag&a=1" decode-query
"bare key mixed with key=value" assert=

H{ tag: { "" "" } } "tag&tag" decode-query
"repeated bare key accumulates empties" assert=

"decode-query: stray ampersands" test-section

H{ a: { "1" } b: { "2" } } "&a=1&&b=2&" decode-query
"empty segments around and between pairs are skipped" assert=

H{ } "&&&" decode-query "only empty segments" assert=

"decode-query: percent escapes" test-section

H{ k: { "a/b?c" } } "k=a%2Fb%3Fc" decode-query
"ASCII reserved characters in value decode" assert=

H{ "a/b" { "v" } } "a%2Fb=v" decode-query
"ASCII reserved characters in key decode" assert=

H{ k: { "a b" } } "k=a+b" decode-query
"+ in value decodes to space" assert=

H{ k: { "a+b" } } "k=a%2Bb" decode-query
"%2B in value decodes to literal +" assert=

H{ "a b" { "c d" } } "a+b=c+d" decode-query
"+ decodes to space in both key and value" assert=

"decode-query: multibyte UTF-8" test-section

H{ k: { "café" } } "k=caf%C3%A9" decode-query
"multibyte UTF-8 in value (é)" assert=

H{ k: { "中" } } "k=%E4%B8%AD" decode-query
"multibyte UTF-8 in value (CJK 中)" assert=

H{ "中文" { "value" } } "%E4%B8%AD%E6%96%87=value" decode-query
"multibyte UTF-8 in key" assert=

"decode-query: malformed input throws" test-section

[ "k=%" decode-query ] "trailing % in value throws" assert-error
[ "k=%" decode-query ] EInvalidArgument
"trailing % is EInvalidArgument" assert-error-type

[ "%G1=v" decode-query ] "non-hex in key throws" assert-error
[ "k=%G1" decode-query ] "non-hex in value throws" assert-error

"encode-query: single-key cases" test-section

"" H{ } encode-query "empty hash yields empty string" assert=

"k=value" H{ k: { "value" } } encode-query "single pair" assert=

"k=" H{ k: { "" } } encode-query "empty value emits k=" assert=

"" H{ k: { } } encode-query "empty value array emits nothing" assert=

"encode-query: multi-value per key" test-section

"tag=a&tag=b" H{ tag: { "a" "b" } } encode-query
"two values for one key, in array order" assert=

"tag=a&tag=b&tag=c" H{ tag: { "a" "b" "c" } } encode-query
"three values for one key, in array order" assert=

"encode-query: percent-encoding the form codec" test-section

"k=a+b" H{ k: { "a b" } } encode-query
"space in value encodes to +" assert=

"k=a%2Bb" H{ k: { "a+b" } } encode-query
"literal + in value encodes to %2B" assert=

"k=a%2Fb%3Fc%3Dd%26e" H{ k: { "a/b?c=d&e" } } encode-query
"reserved characters in value percent-encode" assert=

"a+b=c+d" H{ "a b" { "c d" } } encode-query
"space encodes to + in both key and value" assert=

"k=caf%C3%A9" H{ k: { "café" } } encode-query
"multibyte UTF-8 (é) encodes pairwise" assert=

"k=%E4%B8%AD" H{ k: { "中" } } encode-query
"multibyte UTF-8 (CJK) encodes pairwise" assert=

"decode-query / encode-query: round-trips" test-section

H{ k: { "value" } } dup encode-query decode-query
"single ASCII pair round-trips through hash equality" assert=

H{ tag: { "a" "b" } } dup encode-query decode-query
"repeated key round-trips through hash equality" assert=

H{ k: { "a b/c?d=e&f" } } dup encode-query decode-query
"reserved characters round-trip through hash equality" assert=

H{ k: { "café" } } dup encode-query decode-query
"multibyte UTF-8 round-trips through hash equality" assert=

H{ k: { "中 café" } } dup encode-query decode-query
"mixed ASCII space and multibyte round-trips" assert=

"k=hello" "k=hello" decode-query encode-query
"single-pair string round-trips byte-equal" assert=

"tag=a&tag=b" "tag=a&tag=b" decode-query encode-query
"single-key repeated-value string round-trips byte-equal" assert=
