use "math/ratio" ;
use "testing" ;

"ratio + ratio" test-section
1 2 normalize-ratio 1 3 normalize-ratio + >string "5/6" "1/2 + 1/3" assert=
1 2 normalize-ratio 1 2 normalize-ratio + 1 "1/2 + 1/2 demotes" assert=
-1 3 normalize-ratio 1 3 normalize-ratio + 0 "-1/3 + 1/3 demotes to 0" assert=

"ratio - ratio" test-section
5 6 normalize-ratio 1 3 normalize-ratio - >string "1/2" "5/6 - 1/3" assert=
1 2 normalize-ratio 1 2 normalize-ratio - 0 "1/2 - 1/2 demotes to 0" assert=

"ratio * ratio" test-section
2 3 normalize-ratio 4 5 normalize-ratio * >string "8/15" "2/3 * 4/5" assert=
2 3 normalize-ratio 3 4 normalize-ratio * >string "1/2" "2/3 * 3/4 normalizes" assert=

"ratio / ratio" test-section
1 2 normalize-ratio 1 3 normalize-ratio / >string "3/2" "1/2 / 1/3" assert=
1 3 normalize-ratio 1 3 normalize-ratio / 1 "1/3 / 1/3 demotes to 1" assert=

"ratio % ratio" test-section
5 3 normalize-ratio 1 2 normalize-ratio % >string "1/6" "5/3 % 1/2" assert=
1 2 normalize-ratio 1 3 normalize-ratio % >string "1/6" "1/2 % 1/3" assert=

"ratio = ratio" test-section
1 2 normalize-ratio 1 2 normalize-ratio = "1/2 = 1/2" assert-true
1 2 normalize-ratio 1 3 normalize-ratio = "1/2 = 1/3" assert-false
2 4 normalize-ratio 1 2 normalize-ratio = "2/4 = 1/2 (normalized)" assert-true

"ratio < ratio" test-section
1 3 normalize-ratio 1 2 normalize-ratio < "1/3 < 1/2" assert-true
1 2 normalize-ratio 1 3 normalize-ratio < "1/2 < 1/3" assert-false
1 2 normalize-ratio 1 2 normalize-ratio < "1/2 < 1/2" assert-false

"ratio > ratio" test-section
1 2 normalize-ratio 1 3 normalize-ratio > "1/2 > 1/3" assert-true
1 3 normalize-ratio 1 2 normalize-ratio > "1/3 > 1/2" assert-false
1 2 normalize-ratio 1 2 normalize-ratio > "1/2 > 1/2" assert-false

"ratio negative arithmetic" test-section
-1 2 normalize-ratio 1 3 normalize-ratio + >string "-1/6" "-1/2 + 1/3" assert=
-1 2 normalize-ratio 1 2 normalize-ratio < "-1/2 < 1/2" assert-true
-1 2 normalize-ratio 1 2 normalize-ratio > "-1/2 > 1/2" assert-false
