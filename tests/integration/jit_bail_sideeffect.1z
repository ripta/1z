use "testing" ;

"interpreter fallback: side effects run exactly once" test-section

counter: V{ 0 } ;
inc-counter: ( -- ) [ counter 0 #nth 1 + counter swap 0 swap #nth! drop ] ;

cause-bail: ( -- ) [ ] ;
inner: ( -- ) [ inc-counter cause-bail ] ;
inner: compile!
inner
counter 0 #nth 1 "side effect should run exactly once" assert=

"interpreter fallback: error propagation from uncompiled callee" test-section

thrower: ( -- ) [ "boom" throw ] ;
safe-caller: ( -- ) [ thrower ] ;
safe-caller: compile!
[ safe-caller ] [ "error-type" @get ] recover
type-mismatch: "error propagation from uncompiled callee" assert=

"interpreter fallback: return value from uncompiled callee" test-section

uncompiled-add5: ( n -- n ) [ 5 + ] ;
compiled-wrapper: ( n -- n ) [ 1 + uncompiled-add5 ] ;
compiled-wrapper: compile!
10 compiled-wrapper 16 "compiled caller + uncompiled callee" assert=

"interpreter fallback: multiple uncompiled calls" test-section

counter2: V{ 0 } ;
inc-counter2: ( -- ) [ counter2 0 #nth 1 + counter2 swap 0 swap #nth! drop ] ;
uc-nop:       ( -- ) [ ] ;
multi-call:   ( -- ) [ inc-counter2 uc-nop inc-counter2 uc-nop ] ;
multi-call: compile!
multi-call
counter2 0 #nth 2 "inc-counter2 should run exactly twice" assert=
