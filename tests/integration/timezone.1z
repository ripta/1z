\ Integration tests for timezone type, tz-localtime, >time-parts-in

use "testing" ;
use "time" ;

\ === Timezone type basics ===

"timezone type basics" test-section

utc type-name "timezone" "utc type-of" assert=
local type-name "timezone" "local type-of" assert=
utc timezone-offset 0 "utc offset is 0" assert=
utc timezone-name "UTC" "utc name" assert=
local timezone-name "" "local name is empty" assert=
utc timezone? "utc is timezone?" assert-true
local timezone? "local is timezone?" assert-true
42 timezone? "integer is not timezone?" assert-false

\ === tz-localtime with UTC ===

"tz-localtime UTC" test-section

0 "UTC" tz-localtime
dup year>> 1970 "tz-localtime UTC epoch year" assert=
dup month-num>> 1 "tz-localtime UTC epoch month-num" assert=
dup day>> 1 "tz-localtime UTC epoch day" assert=
dup posix-weekday>> 4 "tz-localtime UTC epoch posix-weekday (Thu=4)" assert=
dup hour>> 0 "tz-localtime UTC epoch hour" assert=
dup min>> 0 "tz-localtime UTC epoch min" assert=
dup sec>> 0 "tz-localtime UTC epoch sec" assert=
dup gmtoff>> 0 "tz-localtime UTC epoch gmtoff" assert=
drop

\ tz-abbrev for a modern timestamp should be "UTC"
1749997845 "UTC" tz-localtime tz-abbrev>> "UTC" "tz-localtime UTC modern tz-abbrev" assert=

\ === tz-localtime with fixed-offset timezone (Etc/GMT-5 = UTC+5) ===

"tz-localtime fixed offset" test-section

0 "Etc/GMT-5" tz-localtime
dup hour>> 5 "tz-localtime Etc/GMT-5 hour" assert=
dup day>> 1 "tz-localtime Etc/GMT-5 day" assert=
dup gmtoff>> 18000 "tz-localtime Etc/GMT-5 gmtoff (18000s)" assert=
drop

\ Negative offset: Etc/GMT+8 = UTC-8
0 "Etc/GMT+8" tz-localtime
dup hour>> 16 "tz-localtime Etc/GMT+8 hour (wraps to prev day)" assert=
dup day>> 31 "tz-localtime Etc/GMT+8 day (prev day)" assert=
dup month-num>> 12 "tz-localtime Etc/GMT+8 month (Dec)" assert=
dup year>> 1969 "tz-localtime Etc/GMT+8 year (1969)" assert=
dup gmtoff>> -28800 "tz-localtime Etc/GMT+8 gmtoff (-28800s)" assert=
drop

\ === >time-parts-in with UTC matches >time-parts ===

"UTC >time-parts-in matches >time-parts" test-section

0 0 make-timestamp utc >time-parts-in
dup year: @get 1970 ">time-parts-in UTC epoch year" assert=
dup month-num: @get 1 ">time-parts-in UTC epoch month-num" assert=
dup day: @get 1 ">time-parts-in UTC epoch day" assert=
dup weekday: @get "Thursday" ">time-parts-in UTC epoch weekday" assert=
dup hour: @get 0 ">time-parts-in UTC epoch hour" assert=
dup tz: @get "+0000" ">time-parts-in UTC tz" assert=
drop

\ === Sub-second preservation through >time-parts-in ===

"sub-second preservation" test-section

0 123456789 make-timestamp utc >time-parts-in
dup nsec: @get 123456789 ">time-parts-in nsec preserved" assert=
dup usec: @get 123456 ">time-parts-in usec derived" assert=
dup msec: @get 123 ">time-parts-in msec derived" assert=
drop

\ === Derived fields ===

"derived fields" test-section

1749997845 0 make-timestamp utc >time-parts-in
dup year: @get 2025 "2025 year via >time-parts-in" assert=
dup month-num: @get 6 "2025 month-num via >time-parts-in" assert=
dup day: @get 15 "2025 day via >time-parts-in" assert=
dup hour: @get 14 "2025 hour via >time-parts-in" assert=
dup min: @get 30 "2025 min via >time-parts-in" assert=
dup sec: @get 45 "2025 sec via >time-parts-in" assert=
dup ampm: @get "PM" "2025 ampm via >time-parts-in" assert=
dup hour12: @get 2 "2025 hour12 via >time-parts-in" assert=
drop

\ === Fixed-offset derived fields via >time-parts-in ===

"fixed-offset >time-parts-in" test-section

0 0 make-timestamp 0 "Etc/GMT-5" make-timezone >time-parts-in
dup tz: @get "+0500" ">time-parts-in Etc/GMT-5 tz" assert=
dup tz-offset: @get "+0500" ">time-parts-in Etc/GMT-5 tz-offset" assert=
drop

0 0 make-timestamp 0 "Etc/GMT+8" make-timezone >time-parts-in
dup tz: @get "-0800" ">time-parts-in Etc/GMT+8 tz" assert=
dup tz-offset: @get "-0800" ">time-parts-in Etc/GMT+8 tz-offset" assert=
drop

\ === Local timezone smoke test ===

"local timezone smoke test" test-section

now local >time-parts-in year: @get 2025 >= "local year >= 2025" assert-true
