\ Stack effect validation error tests
\ These tests verify that incorrect stack effects are caught

\ Test 1: Wrong delta in quotation parameter with balanced row variables
\ The effect says ( n -- n n ) but [ 2 * ] only produces one value (delta 0)
double-wrong: ( n quot: ( n -- n n ) -- n n ) [
  call
] ;

test-double-wrong: ( -- ) [
  [ 5 [ 2 * ] double-wrong ] ignore-errors
  \ Clean up the leftover args (2 items: n, quot)
  drop drop
  "caught-double-wrong" .
] ;
test-double-wrong

\ Test 2: Wrong delta with concrete effect (no row variables)
\ The effect says ( a b -- c ) requiring delta -1, but [ drop drop ] has delta -2
add-wrong: ( a b quot: ( a b -- c ) -- c ) [
  call
] ;

test-add-wrong: ( -- ) [
  [ 1 2 [ drop drop ] add-wrong ] ignore-errors
  \ Clean up the leftover args (3 items: a, b, quot)
  drop drop drop
  "caught-add-wrong" .
] ;
test-add-wrong

\ Test 3: Quotation that consumes too few values
\ Effect says ( a b -- ) requiring delta -2, but [ drop ] only has delta -1
consume-wrong: ( a b quot: ( a b -- ) -- ) [
  call
] ;

test-consume-wrong: ( -- ) [
  [ 1 2 [ drop ] consume-wrong ] ignore-errors
  \ Clean up the leftover args (3 items: a, b, quot)
  drop drop drop
  "caught-consume-wrong" .
] ;
test-consume-wrong
