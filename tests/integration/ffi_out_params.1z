use "testing" ;
use "ffi" ;

\\ Helper to get the shared library path for the toy library.
toy-lib-path: ( -- path ) [
  environ "PWD" @get "/zig-out/ext/libtoy.dylib" #append
] ;

toy-lib-path lib-open

\\ toy_divmod: void return + two i32 out-params
\\ After ffi-call stack is: ( lib ffi-fn quotient remainder )
dup "toy_divmod" lib-symbol ffi{ i32 i32 out-i32 out-i32 -> void } bind-sig
17 5 2 pick-n ffi-call
2 "toy_divmod remainder" assert=
3 "toy_divmod quotient" assert=
drop

\\ toy_add_with_carry: non-void return + out-param
\\ After ffi-call stack is: ( lib ffi-fn result carry )
dup "toy_add_with_carry" lib-symbol ffi{ i32 i32 out-i32 -> i32 } bind-sig
3 4 2 pick-n ffi-call
0 "toy_add_with_carry carry" assert=
7 "toy_add_with_carry result" assert=
drop

\\ toy_sincos_approx: f64 out-params
\\ After ffi-call stack is: ( lib ffi-fn sin_out cos_out )
dup "toy_sincos_approx" lib-symbol ffi{ f64 out-f64 out-f64 -> void } bind-sig
0.0 1 pick-n ffi-call
1.0 "toy_sincos_approx cos(0)" assert=
0.0 "toy_sincos_approx sin(0)" assert=
drop

\\ toy_classify: bool out-params, positive input
\\ After ffi-call stack is: ( lib ffi-fn is_positive is_zero )
dup "toy_classify" lib-symbol ffi{ i32 out-bool out-bool -> void } bind-sig
5 1 pick-n ffi-call
f "toy_classify(5) is_zero" assert=
t "toy_classify(5) is_positive" assert=
drop

\\ toy_classify: zero input
dup "toy_classify" lib-symbol ffi{ i32 out-bool out-bool -> void } bind-sig
0 1 pick-n ffi-call
t "toy_classify(0) is_zero" assert=
f "toy_classify(0) is_positive" assert=
drop

\\ toy_classify: negative input
dup "toy_classify" lib-symbol ffi{ i32 out-bool out-bool -> void } bind-sig
-3 1 pick-n ffi-call
f "toy_classify(-3) is_zero" assert=
f "toy_classify(-3) is_positive" assert=
drop

\\ toy_widen_add: mixed types (i32 input, i64 out-param)
\\ After ffi-call stack is: ( lib ffi-fn wide_sum )
dup "toy_widen_add" lib-symbol ffi{ i32 i32 out-i64 -> void } bind-sig
1000000 2000000 2 pick-n ffi-call
3000000 "toy_widen_add result" assert=
drop

\\ toy_double_u8: u8 out-param
\\ After ffi-call stack is: ( lib ffi-fn doubled )
dup "toy_double_u8" lib-symbol ffi{ u8 out-u8 -> void } bind-sig
21 1 pick-n ffi-call
42 "toy_double_u8(21)" assert=
drop

\\ toy_f32_out: f32 out-param
\\ After ffi-call stack is: ( lib ffi-fn sum )
dup "toy_f32_out" lib-symbol ffi{ f32 f32 out-f32 -> void } bind-sig
1.5 2.25 2 pick-n ffi-call
3.75 "toy_f32_out(1.5, 2.25)" assert=
drop

\\ Error case: out-param as return type is rejected at bind-sig
[
  toy-lib-path lib-open
  dup "toy_add" lib-symbol
  ffi{ i32 -> out-i32 } bind-sig
  drop swap resource-close
]
ffi-type-mismatch: "out-param as return type rejected" assert-error-type

resource-close
