\ Compiled arithmetic honors a method arm that replaces a builtin fixnum or float pair when the
\ arm is registered before the word compiled, so the compiler emits the native call outright.

use "testing" ;

+:   method{ fixnum fixnum } [ 2drop 42 ] ;
-:   method{ fixnum fixnum } [ 2drop 42 ] ;
*:   method{ fixnum fixnum } [ 2drop 42 ] ;
/:   method{ fixnum fixnum } [ 2drop 42 ] ;
%:   method{ fixnum fixnum } [ 2drop 42 ] ;
=:   method{ fixnum fixnum } [ 2drop 42 ] ;
<:   method{ fixnum fixnum } [ 2drop 42 ] ;
>:   method{ fixnum fixnum } [ 2drop 42 ] ;
+:   method{ float float } [ 2drop 43 ] ;
-:   method{ float float } [ 2drop 43 ] ;
*:   method{ float float } [ 2drop 43 ] ;
/:   method{ float float } [ 2drop 43 ] ;
%:   method{ float float } [ 2drop 43 ] ;
=:   method{ float float } [ 2drop 43 ] ;
<:   method{ float float } [ 2drop 43 ] ;
>:   method{ float float } [ 2drop 43 ] ;
+:   method{ fixnum float } [ 2drop 44 ] ;
-:   method{ fixnum float } [ 2drop 44 ] ;
*:   method{ fixnum float } [ 2drop 44 ] ;
/:   method{ fixnum float } [ 2drop 44 ] ;
%:   method{ fixnum float } [ 2drop 44 ] ;
=:   method{ fixnum float } [ 2drop 44 ] ;
<:   method{ fixnum float } [ 2drop 44 ] ;
>:   method{ fixnum float } [ 2drop 44 ] ;
+:   method{ float fixnum } [ 2drop 45 ] ;
-:   method{ float fixnum } [ 2drop 45 ] ;
*:   method{ float fixnum } [ 2drop 45 ] ;
/:   method{ float fixnum } [ 2drop 45 ] ;
%:   method{ float fixnum } [ 2drop 45 ] ;
=:   method{ float fixnum } [ 2drop 45 ] ;
<:   method{ float fixnum } [ 2drop 45 ] ;
>:   method{ float fixnum } [ 2drop 45 ] ;
abs: method{ fixnum } [ drop 42 ] ;
abs: method{ float } [ drop 43 ] ;

add-u:    ( a b -- c )                 [ + ] ;
add-lit:  ( -- c )                     [ 7 2 + ] ;
add-flit: ( -- c )                     [ 7.5 2.5 + ] ;
add-mlit: ( -- c )                     [ 7 2.5 + ] ;
add-tf:   ( a: fixnum b: fixnum -- c ) [ + ] ;
add-tF:   ( a: float b: float -- c )   [ + ] ;
add-one:  ( a -- c )                   [ 2 + ] ;
sub-u:    ( a b -- c )                 [ - ] ;
sub-lit:  ( -- c )                     [ 7 2 - ] ;
sub-flit: ( -- c )                     [ 7.5 2.5 - ] ;
sub-mlit: ( -- c )                     [ 7 2.5 - ] ;
sub-tf:   ( a: fixnum b: fixnum -- c ) [ - ] ;
sub-tF:   ( a: float b: float -- c )   [ - ] ;
sub-one:  ( a -- c )                   [ 2 - ] ;
mul-u:    ( a b -- c )                 [ * ] ;
mul-lit:  ( -- c )                     [ 7 2 * ] ;
mul-flit: ( -- c )                     [ 7.5 2.5 * ] ;
mul-mlit: ( -- c )                     [ 7 2.5 * ] ;
mul-tf:   ( a: fixnum b: fixnum -- c ) [ * ] ;
mul-tF:   ( a: float b: float -- c )   [ * ] ;
mul-one:  ( a -- c )                   [ 2 * ] ;
div-u:    ( a b -- c )                 [ / ] ;
div-lit:  ( -- c )                     [ 7 2 / ] ;
div-flit: ( -- c )                     [ 7.5 2.5 / ] ;
div-mlit: ( -- c )                     [ 7 2.5 / ] ;
div-tf:   ( a: fixnum b: fixnum -- c ) [ / ] ;
div-tF:   ( a: float b: float -- c )   [ / ] ;
div-one:  ( a -- c )                   [ 2 / ] ;
mod-u:    ( a b -- c )                 [ % ] ;
mod-lit:  ( -- c )                     [ 7 2 % ] ;
mod-flit: ( -- c )                     [ 7.5 2.5 % ] ;
mod-mlit: ( -- c )                     [ 7 2.5 % ] ;
mod-tf:   ( a: fixnum b: fixnum -- c ) [ % ] ;
mod-tF:   ( a: float b: float -- c )   [ % ] ;
mod-one:  ( a -- c )                   [ 2 % ] ;
eq-u:     ( a b -- c )                 [ = ] ;
eq-lit:   ( -- c )                     [ 7 2 = ] ;
eq-flit:  ( -- c )                     [ 7.5 2.5 = ] ;
eq-mlit:  ( -- c )                     [ 7 2.5 = ] ;
eq-tf:    ( a: fixnum b: fixnum -- c ) [ = ] ;
eq-tF:    ( a: float b: float -- c )   [ = ] ;
eq-one:   ( a -- c )                   [ 2 = ] ;
lt-u:     ( a b -- c )                 [ < ] ;
lt-lit:   ( -- c )                     [ 7 2 < ] ;
lt-flit:  ( -- c )                     [ 7.5 2.5 < ] ;
lt-mlit:  ( -- c )                     [ 7 2.5 < ] ;
lt-tf:    ( a: fixnum b: fixnum -- c ) [ < ] ;
lt-tF:    ( a: float b: float -- c )   [ < ] ;
lt-one:   ( a -- c )                   [ 2 < ] ;
gt-u:     ( a b -- c )                 [ > ] ;
gt-lit:   ( -- c )                     [ 7 2 > ] ;
gt-flit:  ( -- c )                     [ 7.5 2.5 > ] ;
gt-mlit:  ( -- c )                     [ 7 2.5 > ] ;
gt-tf:    ( a: fixnum b: fixnum -- c ) [ > ] ;
gt-tF:    ( a: float b: float -- c )   [ > ] ;
gt-one:   ( a -- c )                   [ 2 > ] ;
abs-u:    ( a -- c )                   [ abs ] ;
abs-lit:  ( -- c )                     [ -7 abs ] ;
abs-flit: ( -- c )                     [ -7.5 abs ] ;
abs-tf:   ( a: fixnum -- c )           [ abs ] ;
abs-tF:   ( a: float -- c )            [ abs ] ;

add-u: compile!
add-lit: compile!
add-flit: compile!
add-mlit: compile!
add-tf: compile!
add-tF: compile!
add-one: compile!
sub-u: compile!
sub-lit: compile!
sub-flit: compile!
sub-mlit: compile!
sub-tf: compile!
sub-tF: compile!
sub-one: compile!
mul-u: compile!
mul-lit: compile!
mul-flit: compile!
mul-mlit: compile!
mul-tf: compile!
mul-tF: compile!
mul-one: compile!
div-u: compile!
div-lit: compile!
div-flit: compile!
div-mlit: compile!
div-tf: compile!
div-tF: compile!
div-one: compile!
mod-u: compile!
mod-lit: compile!
mod-flit: compile!
mod-mlit: compile!
mod-tf: compile!
mod-tF: compile!
mod-one: compile!
eq-u: compile!
eq-lit: compile!
eq-flit: compile!
eq-mlit: compile!
eq-tf: compile!
eq-tF: compile!
eq-one: compile!
lt-u: compile!
lt-lit: compile!
lt-flit: compile!
lt-mlit: compile!
lt-tf: compile!
lt-tF: compile!
lt-one: compile!
gt-u: compile!
gt-lit: compile!
gt-flit: compile!
gt-mlit: compile!
gt-tf: compile!
gt-tF: compile!
gt-one: compile!
abs-u: compile!
abs-lit: compile!
abs-flit: compile!
abs-tf: compile!
abs-tF: compile!

t add-u: >word-info compiled?>> "add-u is compiled" assert=
t add-lit: >word-info compiled?>> "add-lit is compiled" assert=
t add-flit: >word-info compiled?>> "add-flit is compiled" assert=
