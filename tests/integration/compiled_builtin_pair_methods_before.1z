"every pair replaced" test-section
7 2 add-u 42 "replaced: + untyped fixnum pair" assert=
7.5 2.5 add-u 43 "replaced: + untyped float pair" assert=
7 2.5 add-u 44 "replaced: + untyped fixnum-float pair" assert=
7.5 2 add-u 45 "replaced: + untyped float-fixnum pair" assert=
add-lit 42 "replaced: + literal fixnum pair" assert=
add-flit 43 "replaced: + literal float pair" assert=
add-mlit 44 "replaced: + literal fixnum-float pair" assert=
7 2 add-tf 42 "replaced: + typed fixnum pair" assert=
7.5 2.5 add-tF 43 "replaced: + typed float pair" assert=
7 add-one 42 "replaced: + literal fixnum on an untyped fixnum" assert=
7.5 add-one 45 "replaced: + literal fixnum on an untyped float" assert=
7 2 sub-u 42 "replaced: - untyped fixnum pair" assert=
7.5 2.5 sub-u 43 "replaced: - untyped float pair" assert=
7 2.5 sub-u 44 "replaced: - untyped fixnum-float pair" assert=
7.5 2 sub-u 45 "replaced: - untyped float-fixnum pair" assert=
sub-lit 42 "replaced: - literal fixnum pair" assert=
sub-flit 43 "replaced: - literal float pair" assert=
sub-mlit 44 "replaced: - literal fixnum-float pair" assert=
7 2 sub-tf 42 "replaced: - typed fixnum pair" assert=
7.5 2.5 sub-tF 43 "replaced: - typed float pair" assert=
7 sub-one 42 "replaced: - literal fixnum on an untyped fixnum" assert=
7.5 sub-one 45 "replaced: - literal fixnum on an untyped float" assert=
7 2 mul-u 42 "replaced: * untyped fixnum pair" assert=
7.5 2.5 mul-u 43 "replaced: * untyped float pair" assert=
7 2.5 mul-u 44 "replaced: * untyped fixnum-float pair" assert=
7.5 2 mul-u 45 "replaced: * untyped float-fixnum pair" assert=
mul-lit 42 "replaced: * literal fixnum pair" assert=
mul-flit 43 "replaced: * literal float pair" assert=
mul-mlit 44 "replaced: * literal fixnum-float pair" assert=
7 2 mul-tf 42 "replaced: * typed fixnum pair" assert=
7.5 2.5 mul-tF 43 "replaced: * typed float pair" assert=
7 mul-one 42 "replaced: * literal fixnum on an untyped fixnum" assert=
7.5 mul-one 45 "replaced: * literal fixnum on an untyped float" assert=
7 2 div-u 42 "replaced: / untyped fixnum pair" assert=
7.5 2.5 div-u 43 "replaced: / untyped float pair" assert=
7 2.5 div-u 44 "replaced: / untyped fixnum-float pair" assert=
7.5 2 div-u 45 "replaced: / untyped float-fixnum pair" assert=
div-lit 42 "replaced: / literal fixnum pair" assert=
div-flit 43 "replaced: / literal float pair" assert=
div-mlit 44 "replaced: / literal fixnum-float pair" assert=
7 2 div-tf 42 "replaced: / typed fixnum pair" assert=
7.5 2.5 div-tF 43 "replaced: / typed float pair" assert=
7 div-one 42 "replaced: / literal fixnum on an untyped fixnum" assert=
7.5 div-one 45 "replaced: / literal fixnum on an untyped float" assert=
7 2 mod-u 42 "replaced: % untyped fixnum pair" assert=
7.5 2.5 mod-u 43 "replaced: % untyped float pair" assert=
7 2.5 mod-u 44 "replaced: % untyped fixnum-float pair" assert=
7.5 2 mod-u 45 "replaced: % untyped float-fixnum pair" assert=
mod-lit 42 "replaced: % literal fixnum pair" assert=
mod-flit 43 "replaced: % literal float pair" assert=
mod-mlit 44 "replaced: % literal fixnum-float pair" assert=
7 2 mod-tf 42 "replaced: % typed fixnum pair" assert=
7.5 2.5 mod-tF 43 "replaced: % typed float pair" assert=
7 mod-one 42 "replaced: % literal fixnum on an untyped fixnum" assert=
7.5 mod-one 45 "replaced: % literal fixnum on an untyped float" assert=
7 2 eq-u 42 "replaced: = untyped fixnum pair" assert=
7.5 2.5 eq-u 43 "replaced: = untyped float pair" assert=
7 2.5 eq-u 44 "replaced: = untyped fixnum-float pair" assert=
7.5 2 eq-u 45 "replaced: = untyped float-fixnum pair" assert=
eq-lit 42 "replaced: = literal fixnum pair" assert=
eq-flit 43 "replaced: = literal float pair" assert=
eq-mlit 44 "replaced: = literal fixnum-float pair" assert=
7 2 eq-tf 42 "replaced: = typed fixnum pair" assert=
7.5 2.5 eq-tF 43 "replaced: = typed float pair" assert=
7 eq-one 42 "replaced: = literal fixnum on an untyped fixnum" assert=
7.5 eq-one 45 "replaced: = literal fixnum on an untyped float" assert=
7 2 lt-u 42 "replaced: < untyped fixnum pair" assert=
7.5 2.5 lt-u 43 "replaced: < untyped float pair" assert=
7 2.5 lt-u 44 "replaced: < untyped fixnum-float pair" assert=
7.5 2 lt-u 45 "replaced: < untyped float-fixnum pair" assert=
lt-lit 42 "replaced: < literal fixnum pair" assert=
lt-flit 43 "replaced: < literal float pair" assert=
lt-mlit 44 "replaced: < literal fixnum-float pair" assert=
7 2 lt-tf 42 "replaced: < typed fixnum pair" assert=
7.5 2.5 lt-tF 43 "replaced: < typed float pair" assert=
7 lt-one 42 "replaced: < literal fixnum on an untyped fixnum" assert=
7.5 lt-one 45 "replaced: < literal fixnum on an untyped float" assert=
7 2 gt-u 42 "replaced: > untyped fixnum pair" assert=
7.5 2.5 gt-u 43 "replaced: > untyped float pair" assert=
7 2.5 gt-u 44 "replaced: > untyped fixnum-float pair" assert=
7.5 2 gt-u 45 "replaced: > untyped float-fixnum pair" assert=
gt-lit 42 "replaced: > literal fixnum pair" assert=
gt-flit 43 "replaced: > literal float pair" assert=
gt-mlit 44 "replaced: > literal fixnum-float pair" assert=
7 2 gt-tf 42 "replaced: > typed fixnum pair" assert=
7.5 2.5 gt-tF 43 "replaced: > typed float pair" assert=
7 gt-one 42 "replaced: > literal fixnum on an untyped fixnum" assert=
7.5 gt-one 45 "replaced: > literal fixnum on an untyped float" assert=
-7 abs-u 42 "replaced: abs untyped fixnum" assert=
-7.5 abs-u 43 "replaced: abs untyped float" assert=
abs-lit 42 "replaced: abs literal fixnum" assert=
abs-flit 43 "replaced: abs literal float" assert=
-7 abs-tf 42 "replaced: abs typed fixnum" assert=
-7.5 abs-tF 43 "replaced: abs typed float" assert=
