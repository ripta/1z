\ Test: no transitive re-export and load-once caching

use "testing" ;

\ === No transitive re-export ===
"No transitive re-export" test-section

\ b.1z uses a.1z internally. Importing b should give us from-b but NOT from-a.
use "mod_b.1z" ;

from-b "from-b" "from-b is accessible" assert=

\ from-a should NOT be visible (not transitively re-exported)
[ from-a ] [ drop "from-a not visible - correct" print-line ] recover
wipe

\ === Direct import works ===
"Direct import" test-section

\ Explicitly importing a.1z makes from-a available
use "mod_a.1z" ;
from-a "from-a" "from-a available after direct import" assert=

\ === Module deps for internal use ===
"Module deps for internal use" test-section

\ b.1z internally calls from-a. Even though from-a is not re-exported,
\ b.1z's own words that call from-a should still work because deps are
\ imported at runtime.
use "mod_b_calls_a.1z" ;
call-from-a "from-a" "b's internal use of a works" assert=

\ === Load-once caching ===
"Load-once caching" test-section

\ mod_a_counted.1z prints a message on load. Loading it twice should
\ only print the message once.
use "mod_a_counted.1z" ;
use "mod_b_counted.1z" ;
counted-a "counted-a" "first load works" assert=
counted-b "counted-b" "second module works" assert=

\ === Module @keys excludes deps ===
"Module @keys excludes deps" test-section

bmod: "mod_b.1z" load ;
bmod @keys #len 1 "module only exports own words" assert=
