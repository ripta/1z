use "testing" ;
use "lint" ;
use "lexer" ;
use "1z-tokens" ;

"rule registration" test-section

lint-rules #len 0 "no rules initially" assert=

"test-rule" warning: [ drop drop drop drop drop { } ] f make-lint-rule
register-lint-rule

lint-rules #len 1 "one rule registered" assert=

"second-rule" info: [ drop drop drop drop drop { } ] f make-lint-rule
register-lint-rule

lint-rules #len 2 "two rules registered" assert=

"line index" test-section

"abc\ndef\nghi" (build-line-index)
dup #len 2 "two newlines" assert=
dup 0 (pos>line-col) 1 "pos 0 col" assert= 1 "pos 0 line" assert=
dup 2 (pos>line-col) 3 "pos 2 col" assert= 1 "pos 2 line" assert=
dup 4 (pos>line-col) 1 "pos 4 col" assert= 2 "pos 4 line" assert=
8 (pos>line-col) 1 "pos 8 col" assert= 3 "pos 8 line" assert=

"" (build-line-index) #len 0 "empty source" assert=
"hello" (build-line-index) #len 0 "single line" assert=

"format-diagnostic" test-section

"my-rule" warning: "test.1z" 5 12 "bad style" make-lint-diagnostic
format-diagnostic
"test.1z:5:12: warning: [my-rule] bad style" "warning format" assert=

"my-rule" info: "lib/foo.1z" 1 1 "info msg" make-lint-diagnostic
format-diagnostic
"lib/foo.1z:1:1: info: [my-rule] info msg" "info format" assert=

"make-diag helper" test-section

"abc\ndef\nghi" (build-line-index)
"test-rule" warning: "file.1z" 3 pick-n 4 "found issue" (make-diag)
dup line>> 2 "diag line" assert=
dup column>> 1 "diag col" assert=
dup file>> "file.1z" "diag file" assert=
dup rule-id>> "test-rule" "diag rule-id" assert=
message>> "found issue" "diag message" assert=
drop

"public lint helpers" test-section

"abc\ndef\nghi" (build-line-index)
"test-rule" warning: "file.1z" 3 pick-n 4 "diag at pos" diag-at-pos
dup line>> 2 "diag-at-pos line" assert=
dup column>> 1 "diag-at-pos col" assert=
message>> "diag at pos" "diag-at-pos message" assert=
drop

"abc\ndef\nghi" (build-line-index)
number: "42" 8 make-token
"test-rule" warning: "file.1z" 4 pick-n 4 pick-n "diag at token" diag-at-token
dup line>> 3 "diag-at-token line" assert=
dup column>> 1 "diag-at-token col" assert=
message>> "diag at token" "diag-at-token message" assert=
2drop

number: "42" 8 make-token number: token-kind? t "token-kind? true" assert=
number: "42" 8 make-token word: token-kind? f "token-kind? false" assert=

whitespace: " " 0 make-token significant-token? f "whitespace not significant" assert=
newline: "\n" 0 make-token significant-token? f "newline not significant" assert=
word: "dup" 0 make-token significant-token? t "word is significant" assert=

symbol: "name:" 0 make-token definition-symbol? t "symbol is definition symbol" assert=
word: "dup" 0 make-token definition-symbol? f "word is not definition symbol" assert=

"dependency graph" test-section

{
  "tests/fixtures/lint/circular-dep-three-a.1z"
  "tests/fixtures/lint/circular-dep-three-b.1z"
  "tests/fixtures/lint/circular-dep-three-c.1z"
} (build-dep-graph)
dup "tests/fixtures/lint/circular-dep-three-a.1z" @get 0 #nth 0 #nth
"tests/fixtures/lint/circular-dep-three-b.1z" "use names an edge" assert=
dup "tests/fixtures/lint/circular-dep-three-c.1z" @get 0 #nth 0 #nth
"tests/fixtures/lint/circular-dep-three-a.1z" "load reexport names an edge" assert=
drop

{ "tests/fixtures/lint/circular-dep-search-a.1z" } (build-dep-graph)
"tests/fixtures/lint/circular-dep-search-a.1z" @has? f
"an import outside the checked set is no edge" assert=

"cycle detection" test-section

M{ } "a" { { "b" 1 1 } } @set!
dup "a" (find-cycle-from) f "an acyclic graph reports no cycle" assert=
"b" (find-cycle-from) f "a node with no imports reports no cycle" assert=

M{ } "a" { { "a" 1 1 } } @set!
"a" (find-cycle-from) { "a" "a" } "a self-import closes on itself" assert=

M{ } "a" { { "b" 1 1 } } @set! "b" { { "a" 1 1 } } @set!
dup "a" (find-cycle-from) { "a" "b" "a" } "a two-file cycle names both" assert=
"b" (find-cycle-from) { "b" "a" "b" } "the same cycle reads from either end" assert=

M{ } "a" { { "b" 1 1 } } @set! "b" { { "c" 1 1 } } @set! "c" { { "a" 1 1 } } @set!
"a" (find-cycle-from) { "a" "b" "c" "a" } "a three-file cycle names all three" assert=

M{ } "x" { { "a" 1 1 } } @set! "a" { { "b" 1 1 } } @set! "b" { { "a" 1 1 } } @set!
"x" (find-cycle-from) f "reaching a cycle is not sitting on one" assert=

"run-lint on clean file" test-section

{ "tests/fixtures/lint/clean.1z" } run-lint
t "clean file has no findings" assert=

"run-lint with findings" test-section

\ Register a rule that always produces one diagnostic
"always-fires" warning: [
  \ ( path source tokens line-index semantic-context -- diagnostics )
  drop drop drop drop
  \ stack: path
  [ "always-fires" warning: ] dip 1 1 "always fires" make-lint-diagnostic
  1array
] f make-lint-rule
register-lint-rule

{ "tests/fixtures/lint/clean.1z" } run-lint
f "findings present" assert=
