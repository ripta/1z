\ Words that call a nested helper they defined with `name: [ body ] ;`. Under a compile flag a
\ read of a plain helper defined in the word's own body compiles to the helper's body inline. A
\ typed helper compiles with the interpreter's entry check in front of it, and every other read
\ keeps the word interpreted. Each result is asserted, so the test passes only where the tiers
\ agree.

use "testing" ;

inc: ( n -- n ) [ 1000 + ] ;

called-once: ( n: fixnum -- n ) [
  inc: [ 1 + ] ;
  inc
] ;

called-twice: ( n: fixnum -- n ) [
  inc: [ 1 + ] ;
  inc inc
] ;

with-effect: ( n: fixnum -- n ) [
  double: ( n -- n ) [ 2 * ] ;
  double
] ;

reads-local: ( n: fixnum k: fixnum -- n ) [
  k: swap ;
  add-k: [ k + ] ;
  add-k
] ;

calls-sibling: ( n: fixnum -- n ) [
  inc: [ 1 + ] ;
  inc-twice: [ inc inc ] ;
  inc-twice
] ;

snapshot: ( n: fixnum -- n ) [
  k: 10 ;
  add-k: [ k + ] ;
  k: 100 ;
  add-k k +
] ;

rebound-helper: ( n: fixnum -- n ) [
  step: [ 1 + ] ;
  step: [ 10 * step ] ;
  step
] ;

in-arm: ( n: fixnum -- n ) [
  inc: [ 1 + ] ;
  dup 0 > [ inc ] [ ] if
] ;

in-times: ( n: fixnum -- n ) [
  inc: [ 1 + ] ;
  3 [ inc ] times
] ;

own-local: ( n: fixnum -- n ) [
  sq: [ m: swap ; m m * ] ;
  sq
] ;

typed-helper: ( x -- n ) [
  inc: ( n: fixnum -- n ) [ 1 + ] ;
  inc
] ;

self-recursive: ( n: fixnum -- n ) [
  down: [ dup 0 > [ 1 - down ] when ] ;
  down
] ;

arm-rebinds-helper: ( n: fixnum -- n ) [
  h: [ 1 + ] ;
  dup 0 > [ h: [ 100 + ] ; h ] [ ] if
] ;

loop-rebinds-helper: ( n: fixnum -- n ) [
  h: [ 1 + ] ;
  2 [ h: [ 100 + ] ; h ] times
] ;

arm-rebinds-local: ( n: fixnum -- n ) [
  x: 5 ;
  dup 0 > [ x: [ 100 + ] ; x + ] [ ] if
] ;

marked-helper: ( n: fixnum -- n ) [
  inc: no-compile [ 1 + ] ;
  inc
] ;

"helper reads" test-section
1 called-once 2 "a helper called once" assert=
1 called-twice 3 "a helper called twice" assert=
4 with-effect 8 "a helper with a declared effect" assert=
1 inc 1001 "the global word is untouched" assert=

"helpers and bindings" test-section
1 5 reads-local 6 "a helper reads an enclosing binding" assert=
1 calls-sibling 3 "a helper calls a sibling helper" assert=
1 snapshot 111 "a helper reads the binding as of its definition" assert=
1 rebound-helper 11 "a rebound helper calls the helper it replaced" assert=

"inlined reads" test-section
1 in-arm 2 "an if arm calls the helper" assert=
0 in-arm 0 "the other arm runs" assert=
1 in-times 4 "a times body calls the helper" assert=

"typed helpers" test-section
4 typed-helper 5 "a typed helper with a matching argument" assert=
[ "s" typed-helper ] "a typed helper rejects a mismatched argument" assert-error

"reads that stay interpreted" test-section
3 own-local 9 "a helper binding its own local" assert=
3 self-recursive 0 "a self-recursive helper" assert=
1 marked-helper 2 "a helper carrying a marker" assert=
1 arm-rebinds-helper 2 "an arm's own helper does not shadow the one its capture holds" assert=
1 loop-rebinds-helper 3 "a loop body's own helper does not shadow the one its capture holds" assert=
1 arm-rebinds-local 6 "an arm's own helper does not shadow a captured value" assert=
