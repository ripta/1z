use "testing" ;
use "net/http" ;
use "net" ;
use "net/tcp" ;
use "time" ;

"serve: root endpoint returns endpoint list" test-section
[
  [
    "127.0.0.1" 39400 [
      path>>
      dup "/" = [
        drop
        "Available endpoints:\n  /\n  /healthz\n  /time\n"
        "text/plain; charset=utf-8" ok send-response
      ] [
        dup "/healthz" = [
          drop "ok" "text/plain; charset=utf-8" ok send-response
        ] [
          "/time" = [
            now iso8601-fmt format
            "text/plain; charset=utf-8" ok send-response
          ] [
            not-found send-response
          ] if
        ] if
      ] if
    ] serve
  ] spawn
  10 milliseconds sleep

  "127.0.0.1" 39400 make-addr:tcp connect
  dup "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "root status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "root blank" assert=
  dup stream-read-line "Available endpoints:" "root body line 1" assert=
  dup stream-read-line "  /" "root body line 2" assert=
  dup stream-read-line "  /healthz" "root body line 3" assert=
  stream-read-line "  /time" "root body line 4" assert=

  cancel-task
] task-scope

"serve: healthz returns ok" test-section
[
  [
    "127.0.0.1" 39401 [
      path>>
      dup "/" = [
        drop "index" "text/plain; charset=utf-8" ok send-response
      ] [
        dup "/healthz" = [
          drop "ok" "text/plain; charset=utf-8" ok send-response
        ] [
          drop not-found send-response
        ] if
      ] if
    ] serve
  ] spawn
  10 milliseconds sleep

  "127.0.0.1" 39401 make-addr:tcp connect
  dup "GET /healthz HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "healthz status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "healthz blank" assert=
  stream-read-line "ok" "healthz body" assert=

  cancel-task
] task-scope

"serve: unknown path returns 404" test-section
[
  [
    "127.0.0.1" 39402 [
      path>>
      dup "/" = [
        drop "index" "text/plain; charset=utf-8" ok send-response
      ] [
        drop not-found send-response
      ] if
    ] serve
  ] spawn
  10 milliseconds sleep

  "127.0.0.1" 39402 make-addr:tcp connect
  dup "GET /nope HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  stream-read-line "HTTP/1.1 404 Not Found" "404 status" assert=

  cancel-task
] task-scope

"serve: time endpoint returns 200" test-section
[
  [
    "127.0.0.1" 39403 [
      path>>
      "/time" = [
        now iso8601-fmt format
        "text/plain; charset=utf-8" ok send-response
      ] [
        not-found send-response
      ] if
    ] serve
  ] spawn
  10 milliseconds sleep

  "127.0.0.1" 39403 make-addr:tcp connect
  dup "GET /time HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  stream-read-line "HTTP/1.1 200 OK" "time status" assert=

  cancel-task
] task-scope
