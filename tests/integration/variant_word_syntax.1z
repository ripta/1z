use "testing" ;
use "ratio" ;

"variant word syntax: define and call" test-section

greet: ( -- s ) [ "hello" ] ;
greet(loud): ( -- s ) [ "HELLO!" ] ;

greet "hello" "greet returns hello" assert=
greet(loud) "HELLO!" "greet(loud) returns HELLO!" assert=

"variant word syntax: symbol literals" test-section

greet(loud): type-of symbol: "greet(loud): is a symbol" assert=
greet(loud): >string "greet(loud)" "greet(loud): symbol string" assert=

"variant word syntax: >word introspection" test-section

greet(loud): >word-info name>> "greet(loud)" ">word-info name of variant word" assert=

">float(exact): lossless fixnum" test-section

42 >float(exact) 42.0 "42 >float(exact) = 42.0" assert=

">float(exact): lossless ratio" test-section

1 2 normalize-ratio >float(exact) 0.5 "1/2 >float(exact) = 0.5" assert=

">float(exact): float passthrough" test-section

3.14 >float(exact) 3.14 "3.14 >float(exact) = 3.14" assert=

">float(exact): inexact fixnum" test-section

[ 9007199254740993 >float(exact) ] "EInexactConversion" assert-error

">float(exact): inexact ratio" test-section

[ 1 3 normalize-ratio >float(exact) ] "EInexactConversion" assert-error
