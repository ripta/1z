use "math/ratio" ;
use "testing" ;

"ratio + fixnum" test-section
1 2 normalize-ratio 1 + >string "3/2" "1/2 + 1" assert=
1 3 normalize-ratio 2 + >string "7/3" "1/3 + 2" assert=
1 2 normalize-ratio 0 + >string "1/2" "1/2 + 0" assert=
-1 2 normalize-ratio 1 + >string "1/2" "-1/2 + 1" assert=

"fixnum + ratio" test-section
1 1 2 normalize-ratio + >string "3/2" "1 + 1/2" assert=
2 1 3 normalize-ratio + >string "7/3" "2 + 1/3" assert=
0 1 2 normalize-ratio + >string "1/2" "0 + 1/2" assert=

"ratio - fixnum" test-section
3 2 normalize-ratio 1 - >string "1/2" "3/2 - 1" assert=
1 2 normalize-ratio 1 - >string "-1/2" "1/2 - 1" assert=

"fixnum - ratio" test-section
1 1 2 normalize-ratio - >string "1/2" "1 - 1/2" assert=
0 1 3 normalize-ratio - >string "-1/3" "0 - 1/3" assert=

"ratio * fixnum" test-section
1 3 normalize-ratio 3 * 1 "1/3 * 3 demotes" assert=
2 3 normalize-ratio 5 * >string "10/3" "2/3 * 5" assert=
1 2 normalize-ratio 0 * 0 "1/2 * 0 demotes" assert=

"fixnum * ratio" test-section
3 1 3 normalize-ratio * 1 "3 * 1/3 demotes" assert=
5 2 3 normalize-ratio * >string "10/3" "5 * 2/3" assert=

"ratio / fixnum" test-section
1 2 normalize-ratio 3 / >string "1/6" "1/2 / 3" assert=
3 4 normalize-ratio 3 / >string "1/4" "3/4 / 3" assert=

"fixnum / ratio" test-section
1 1 3 normalize-ratio / 3 "1 / 1/3 demotes" assert=
2 1 3 normalize-ratio / 6 "2 / 1/3 demotes" assert=

"ratio % fixnum" test-section
5 3 normalize-ratio 1 % >string "2/3" "5/3 % 1" assert=
7 2 normalize-ratio 2 % >string "3/2" "7/2 % 2" assert=

"fixnum % ratio" test-section
1 1 3 normalize-ratio % 0 "1 % 1/3" assert=
1 2 5 normalize-ratio % >string "1/5" "1 % 2/5" assert=

"ratio = fixnum" test-section
1 2 normalize-ratio 1 = "1/2 = 1" assert-false
2 1 normalize-ratio 2 = "2/1 never reaches dispatch (demoted)" assert-true

"fixnum = ratio" test-section
1 1 2 normalize-ratio = "1 = 1/2" assert-false

"ratio < fixnum" test-section
1 2 normalize-ratio 1 < "1/2 < 1" assert-true
3 2 normalize-ratio 1 < "3/2 < 1" assert-false

"fixnum < ratio" test-section
0 1 2 normalize-ratio < "0 < 1/2" assert-true
1 1 2 normalize-ratio < "1 < 1/2" assert-false

"ratio > fixnum" test-section
3 2 normalize-ratio 1 > "3/2 > 1" assert-true
1 2 normalize-ratio 1 > "1/2 > 1" assert-false

"fixnum > ratio" test-section
1 1 2 normalize-ratio > "1 > 1/2" assert-true
0 1 2 normalize-ratio > "0 > 1/2" assert-false

"ratio + bignum" test-section
1 2 normalize-ratio 99999999999999999999 + >string "199999999999999999999/2" "1/2 + bignum" assert=

"bignum + ratio" test-section
99999999999999999999 1 2 normalize-ratio + >string "199999999999999999999/2" "bignum + 1/2" assert=

"ratio * bignum" test-section
1 3 normalize-ratio 99999999999999999999 * 33333333333333333333 "1/3 * bignum demotes" assert=

"bignum * ratio" test-section
99999999999999999999 1 3 normalize-ratio * 33333333333333333333 "bignum * 1/3 demotes" assert=

"ratio = bignum" test-section
1 2 normalize-ratio 99999999999999999999 = "1/2 = bignum" assert-false

"bignum = ratio" test-section
99999999999999999999 1 2 normalize-ratio = "bignum = 1/2" assert-false

"ratio < bignum" test-section
1 2 normalize-ratio 99999999999999999999 < "1/2 < bignum" assert-true

"bignum > ratio" test-section
99999999999999999999 1 2 normalize-ratio > "bignum > 1/2" assert-true

"negative mixed" test-section
1 -1 2 normalize-ratio + >string "1/2" "1 + -1/2" assert=
-1 2 normalize-ratio 1 < "-1/2 < 1" assert-true
