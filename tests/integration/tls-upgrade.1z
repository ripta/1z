\ Integration tests for TLS stream upgrade

use "testing" ;
use "net" ;
use "net/tls" ;
use "net/tcp" shadow-ok ;

"basic HTTPS request over TLS" test-section
"example.com" 443 make-addr:tcp connect
<tls-config> "example.com" tls-upgrade
dup "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n" stream-write drop
dup stream-read-line "HTTP/" #starts-with? t "response starts with HTTP" assert= stream-close

"TLS stream display includes tls" test-section
"example.com" 443 make-addr:tcp connect
<tls-config> "example.com" tls-upgrade
dup inspect "<stream tls" #starts-with? t "inspect shows tls" assert=
stream-close

"double upgrade is rejected" test-section
"example.com" 443 make-addr:tcp connect
<tls-config> "example.com" tls-upgrade
dup
[ dup <tls-config> "example.com" tls-upgrade ] "io-failed" assert-error
stream-close

"closing a TLS stream works" test-section
"example.com" 443 make-addr:tcp connect
<tls-config> "example.com" tls-upgrade
stream-close
t "close succeeded" assert-true
