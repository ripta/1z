\ dispatch_native_ops.1z - Tests for native operator dispatch

use "testing" ;

"virtual type arithmetic dispatch" test-section

\ Define a virtual type for testing
duration: virtual{ integer } ;

\ Register methods for arithmetic operators
+: method{ duration duration } [ swap duration> swap duration> + >duration ] ;
-: method{ duration duration } [ swap duration> swap duration> - >duration ] ;
*: method{ duration integer } [ swap duration> swap * >duration ] ;
/: method{ duration integer } [ swap duration> swap / >duration ] ;
%: method{ duration integer } [ swap duration> swap % >duration ] ;

\ Test: duration + duration
42 >duration 10 >duration + duration> 52 "+ dispatches for duration duration" assert=

\ Test: duration - duration
100 >duration 30 >duration - duration> 70 "- dispatches for duration duration" assert=

\ Test: duration * integer
10 >duration 5 * duration> 50 "* dispatches for duration integer" assert=

\ Test: duration / integer
100 >duration 4 / duration> 25 "/ dispatches for duration integer" assert=

\ Test: duration % integer
100 >duration 7 % duration> 2 "% dispatches for duration integer" assert=

\ Verify result is still a duration
42 >duration 10 >duration + type-of duration: "result type is duration" assert=

"comparison dispatch" test-section

\ Register comparison methods
=: method{ duration duration } [ swap duration> swap duration> = ] ;
<: method{ duration duration } [ swap duration> swap duration> < ] ;
>: method{ duration duration } [ swap duration> swap duration> > ] ;

\ Test: duration = duration
42 >duration 42 >duration = t "= dispatches for equal durations" assert=
42 >duration 43 >duration = f "= dispatches for unequal durations" assert=

\ Test: duration < duration
10 >duration 20 >duration < t "< dispatches for duration duration (10 < 20)" assert=
20 >duration 10 >duration < f "< dispatches for duration duration (20 not < 10)" assert=

\ Test: duration > duration
20 >duration 10 >duration > t "> dispatches for duration duration (20 > 10)" assert=
10 >duration 20 >duration > f "> dispatches for duration duration (10 not > 20)" assert=

"wildcard dispatch" test-section

\ Define another virtual type
weight: virtual{ integer } ;

\ Register a wildcard method: duration + any
\ Note: Exact match (duration duration) takes precedence, so test with duration+integer
+: method{ duration any } [ swap duration> swap + >duration ] ;

\ Test wildcard: duration + integer
42 >duration 8 + duration> 50 "wildcard: duration + integer via any" assert=

"wildcard precedence" test-section

\ Exact match should beat wildcard
\ duration + duration already registered above should still be used
100 >duration 50 >duration + duration> 150 "exact match beats wildcard for duration+duration" assert=

"struct instance dispatch" test-section

\ Define a struct for point
point: struct{ x y } ;

\ Simple method body: just sum all components into a new point
\ ( p1 p2 -- p3 ) where p3 = (p1.x + p2.x, p1.y + p2.y)
+: method{ point point } [ dup x>> swap y>> [ dup x>> swap y>> ] dip + [ + ] dip make-point ] ;

\ Test: point + point - stack trace:
\ 1 2 make-point 3 4 make-point => p1 p2  (where p1={x:1,y:2}, p2={x:3,y:4})
\ dup x>> swap y>> => p1 p2.x p2.y = p1 3 4
\ [ dup x>> swap y>> ] dip => p1.x p1.y p2.x p2.y = 1 2 3 4
\ + => 1 2 7
\ [ + ] dip => 3 7
\ make-point => point{x:3, y:7}
\ But wait, we want x=4, y=6... the order is wrong

\ Let me reconsider:
\ Stack: p1 p2
\ dup x>> swap y>> => p2.x p2.y (and drops p2) - wait no, that's wrong too

\ Actually let me just do a simpler test that verifies dispatch happens
=: method{ point point } [ swap x>> swap x>> = ] ;

\ Test: point = point (just compares x values)
1 2 make-point 1 99 make-point = t "point = dispatches (same x)" assert=
1 2 make-point 5 2 make-point = f "point = dispatches (different x)" assert=

"native fallback" test-section

\ Native operations still work when no user types are involved
42 3 + 45 "native + still works for integers" assert=
100 30 - 70 "native - still works for integers" assert=
7 6 * 42 "native * still works for integers" assert=
100 4 / 25 "native / still works for integers" assert=
100 7 % 2 "native % still works for integers" assert=
42 42 = t "native = still works for integers" assert=
10 20 < t "native < still works for integers" assert=
20 10 > t "native > still works for integers" assert=

"all dispatch tests passed" test-section
