\ The mode at the call decides, not the mode a word compiled under. Words defined and run under
\ `type-check: "off"` still raise for a mistyped argument once the program sets "error", and still
\ compute as they do interpreted once it relaxes again.

use "testing" ;

pragma{ type-check: "off" }

twice: ( n: fixnum -- m ) [ 2 * ] ;
below: ( n: fixnum -- m ) [ dup 0 > [ 1 - below ] [ ] if ] ;
greet: ( s: string -- t ) [
  held: swap ;
  held held #append
] ;

2000 [ 1 twice drop "x" greet drop ] times

pragma{ type-check: "error" }

"under error a mistyped argument raises at entry" test-section
4 twice 8 "a fixnum" assert=
[ 3.5 twice ] type-error: "a float into a word compiled under off" assert-error-type
[ 2.5 below ] type-error: "a float into a loop compiled under off" assert-error-type
[ [ "q" ] greet ] type-error: "a quotation into a binding compiled under off" assert-error-type

pragma{ type-check: "off" }

"under off again a mistyped argument computes as it does interpreted" test-section
3.5 twice 7.0 "a float reaches *" assert=
[ "q" ] greet "qq" "a quotation defines a word the read calls" assert=
