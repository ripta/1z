\ Tests for string splitting (lib/strings.1z)

use "testing" ;
use "strings" ;

"#index-of" test-section
"hello,world" "," #index-of 5 "comma in middle" assert=
"abcabc" "abc" #index-of 0 "match at start" assert=
"hello" "xyz" #index-of f "no match" assert=
"aaa" "a" #index-of 0 "first occurrence" assert=
"hello" "lo" #index-of 3 "multi-char substring" assert=
"abc" "abc" #index-of 0 "exact match" assert=
"ab" "abc" #index-of f "sub longer than str" assert=
"a::b::c" "::" #index-of 1 "multi-char delimiter" assert=

"split basics" test-section
"a,b,c" "," split { "a" "b" "c" } "split by comma" assert=
"hello" "," split { "hello" } "no delimiter found" assert=
"a::b::c" "::" split { "a" "b" "c" } "multi-char delimiter" assert=

"split edge cases" test-section
"" "," split { "" } "empty string" assert=
"a" "" split { "a" } "empty delimiter" assert=
"a,,b" "," split { "a" "" "b" } "empty middle segment" assert=
",a,b" "," split { "" "a" "b" } "leading delimiter" assert=
"a,b," "," split { "a" "b" "" } "trailing delimiter" assert=
"," "," split { "" "" } "only delimiter" assert=
",," "," split { "" "" "" } "two delimiters" assert=

"split multi-byte UTF-8" test-section
"a→b→c" "→" split { "a" "b" "c" } "multi-byte delimiter" assert=
"café,thé" "," split { "café" "thé" } "multi-byte content, ascii delimiter" assert=
"αβγ" "," split { "αβγ" } "multi-byte content, no delimiter" assert=
"→a→" "→" split { "" "a" "" } "leading and trailing multi-byte delimiter" assert=
"café" "é" split { "caf" "" } "multi-byte delimiter at end" assert=
