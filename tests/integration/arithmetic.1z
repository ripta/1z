\ Test arithmetic words from prelude

"lib/testing.1z" use

"Negation (-@)" test-section
42 -@ -42 "-@ positive" assert=
-7 -@ 7 "-@ negative" assert=
0 -@ 0 "-@ zero" assert=

"Absolute value (abs)" test-section
42 abs 42 "abs positive" assert=
-42 abs 42 "abs negative" assert=
0 abs 0 "abs zero" assert=

"Minimum (min)" test-section
3 5 min 3 "min first smaller" assert=
5 3 min 3 "min second smaller" assert=
7 7 min 7 "min equal" assert=

"Maximum (max)" test-section
3 5 max 5 "max second larger" assert=
5 3 max 5 "max first larger" assert=
7 7 max 7 "max equal" assert=

"Decrement (--)" test-section
5 -- 4 "-- positive" assert=
-3 -- -4 "-- negative" assert=

"Increment (++)" test-section
5 ++ 6 "++ positive" assert=
-3 ++ -2 "++ negative" assert=

"Zero test (0?)" test-section
0 0? "0? zero" assert-true
5 0? "0? positive" assert-false
-3 0? "0? negative" assert-false
