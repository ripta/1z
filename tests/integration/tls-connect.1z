\ Integration tests for TLS connect convenience words

use "testing" ;
use "tls" ;

"connect with system CAs" test-section
"example.com" 443 connect
dup "GET / HTTP/1.0\r\nHost: example.com\r\n\r\n" stream-write drop
stream-read-line "HTTP/" #starts-with? t "response starts with HTTP" assert=

"connect-with explicit config" test-section
"example.com" 443 <tls-config> connect-with
dup "GET / HTTP/1.0\r\nHost: example.com\r\n\r\n" stream-write drop
stream-read-line "HTTP/" #starts-with? t "response starts with HTTP" assert=

"connect stream inspect shows tls" test-section
"example.com" 443 connect
dup inspect "<stream tls" #starts-with? t "inspect shows tls" assert=
stream-close

"qualified access via load" test-section
tlsmod: "tls" load ;
"example.com" 443 tlsmod.connect
dup "GET / HTTP/1.0\r\nHost: example.com\r\n\r\n" stream-write drop
stream-read-line "HTTP/" #starts-with? t "qualified access works" assert=
