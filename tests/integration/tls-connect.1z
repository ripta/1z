\ Integration tests for TLS connect convenience words

use "testing" ;
use "net/tls" ;

http-request: ( -- str ) [ "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n" ] ;

read-http-status?: ( stream -- ? ) [
  dup http-request stream-write drop
  dup stream-read-line swap stream-close
  dup string?
  [ "HTTP/" #starts-with? ]
  [ drop f ]
  if
] ;

connect-status?: ( -- ? ) [ "example.com" 443 connect read-http-status? ] ;
connect-status-retry?: ( -- ? ) [ connect-status? dup [ ] [ drop connect-status? ] if ] ;

connect-with-status?: ( -- ? ) [ "example.com" 443 <tls-config> connect-with read-http-status? ] ;
connect-with-status-retry?: ( -- ? ) [ connect-with-status? dup [ ] [ drop connect-with-status? ] if ] ;

"connect with system CAs" test-section
connect-status-retry? t "response starts with HTTP" assert=

"connect-with explicit config" test-section
connect-with-status-retry? t "response starts with HTTP" assert=

"connect stream inspect shows tls" test-section
"example.com" 443 connect
dup inspect "<stream tls" #starts-with? t "inspect shows tls" assert=
stream-close

"qualified access via load" test-section
tlsmod: "net/tls" load ;
"example.com" 443 tlsmod.connect
read-http-status? t "qualified access works" assert=
