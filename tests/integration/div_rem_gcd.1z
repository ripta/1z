use "testing" ;

"div: basic positive fixnums" test-section
7 2 div 3 "7 div 2" assert=
10 5 div 2 "10 div 5" assert=
1 3 div 0 "1 div 3" assert=
0 5 div 0 "0 div 5" assert=

"div: negative operands truncate toward zero" test-section
-7 2 div -3 "-7 div 2" assert=
7 -2 div -3 "7 div -2" assert=
-7 -2 div 3 "-7 div -2" assert=

"div: min_i64 / -1 overflow promotes to bignum" test-section
-9223372036854775808 -1 div type-of bignum: "min_i64 div -1 type" assert=
-9223372036854775808 -1 div to-string "9223372036854775808" "min_i64 div -1 value" assert=

"div: division by zero" test-section
[ 7 0 div ] "DivisionByZero" assert-error

"div: bignum operands" test-section
99999999999999999999 3 div to-string "33333333333333333333" "big div 3" assert=
-99999999999999999999 3 div to-string "-33333333333333333333" "neg big div 3" assert=
99999999999999999999 99999999999999999999 div 1 "big div big" assert=

"div: mixed fixnum/bignum" test-section
99999999999999999999 7 div to-string "14285714285714285714" "big div fixnum" assert=
100 99999999999999999999 div 0 "fixnum div big" assert=

"div: bignum division by zero" test-section
[ 99999999999999999999 0 div ] "DivisionByZero" assert-error

"div: type errors" test-section
[ 7 2.0 div ] "TypeMismatch" assert-error
[ 7.0 2 div ] "TypeMismatch" assert-error
[ "a" 2 div ] "TypeMismatch" assert-error

"rem: basic positive fixnums" test-section
7 2 rem 1 "7 rem 2" assert=
10 5 rem 0 "10 rem 5" assert=
1 3 rem 1 "1 rem 3" assert=
0 5 rem 0 "0 rem 5" assert=

"rem: negative operands" test-section
-7 2 rem -1 "-7 rem 2" assert=
7 -2 rem 1 "7 rem -2" assert=
-7 -2 rem -1 "-7 rem -2" assert=

"rem: identity" test-section
7 2 div 2 * 7 2 rem + 7 "identity 7 2" assert=
-7 2 div 2 * -7 2 rem + -7 "identity -7 2" assert=
7 -2 div -2 * 7 -2 rem + 7 "identity 7 -2" assert=
-7 -2 div -2 * -7 -2 rem + -7 "identity -7 -2" assert=
100 7 div 7 * 100 7 rem + 100 "identity 100 7" assert=
-100 7 div 7 * -100 7 rem + -100 "identity -100 7" assert=

"rem: division by zero" test-section
[ 7 0 rem ] "DivisionByZero" assert-error

"rem: bignum operands" test-section
99999999999999999999 7 rem to-string "1" "big rem 7" assert=
100000000000000000000 99999999999999999999 rem to-string "1" "big rem big" assert=
-99999999999999999999 7 rem to-string "-1" "neg big rem 7" assert=

"rem: mixed fixnum/bignum" test-section
5 99999999999999999999 rem 5 "fixnum rem big" assert=

"rem: bignum division by zero" test-section
[ 99999999999999999999 0 rem ] "DivisionByZero" assert-error

"rem: type errors" test-section
[ 7 2.0 rem ] "TypeMismatch" assert-error
[ 7.0 2 rem ] "TypeMismatch" assert-error
[ "a" 2 rem ] "TypeMismatch" assert-error

"gcd: basic cases" test-section
12 8 gcd 4 "gcd 12 8" assert=
8 12 gcd 4 "gcd 8 12" assert=
100 75 gcd 25 "gcd 100 75" assert=
17 13 gcd 1 "gcd primes" assert=

"gcd: negatives" test-section
-12 8 gcd 4 "gcd -12 8" assert=
12 -8 gcd 4 "gcd 12 -8" assert=
-12 -8 gcd 4 "gcd -12 -8" assert=

"gcd: zero cases" test-section
0 5 gcd 5 "gcd 0 5" assert=
5 0 gcd 5 "gcd 5 0" assert=
0 0 gcd 0 "gcd 0 0" assert=
0 -5 gcd 5 "gcd 0 -5" assert=

"gcd: bignum operands" test-section
99999999999999999998 2 gcd 2 "gcd big fixnum" assert=
99999999999999999999 33333333333333333333 gcd to-string "33333333333333333333" "gcd big big" assert=
12 99999999999999999996 gcd 12 "gcd fixnum big" assert=

"gcd: type errors" test-section
[ 7 2.0 gcd ] "TypeMismatch" assert-error
[ 7.0 2 gcd ] "TypeMismatch" assert-error
[ "a" 2 gcd ] "TypeMismatch" assert-error
