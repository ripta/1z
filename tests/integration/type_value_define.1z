use "testing" ;

test-type: [ type: builtin-type: ] make-mutable-map native.define-builtin-type ;

test-type inspect "<type:test-type>" "inspect shows type name" assert=

"test-type" native.type-descriptor
"type" @get builtin-type: "descriptor registered" assert=

\ Redefining a builtin type that already has a descriptor should error.
[ fixnum: M{ type: builtin-type: } native.define-builtin-type ;
]
"duplicate descriptor on builtin type errors" assert-error
