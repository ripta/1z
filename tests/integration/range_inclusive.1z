\ Tests for range= (inclusive range constructor)

use "testing" ;
use "ranges" ;

"range=" test-section
3 7 range= >iterator #collect { 3 4 5 6 7 } "simple range" assert=
5 5 range= >iterator #collect { 5 } "single element" assert=
0 3 range= >iterator #collect { 0 1 2 3 } "from zero" assert=
-2 2 range= >iterator #collect { -2 -1 0 1 2 } "negative to positive" assert=
5 3 range= >iterator #collect { 5 4 3 } "descending" assert=
