\ Integration tests for #join

use "testing" ;
use "strings" ;
use "ranges" ;

"#join basic" test-section
{ "a" "b" "c" } ", " #join "a, b, c" "#join with comma" assert=
{ "one" "two" } "" #join "onetwo" "#join empty sep" assert=
{ } ", " #join "" "#join empty array" assert=
{ "only" } "-" #join "only" "#join single element" assert=
{ "a" "b" "c" } "::" #join "a::b::c" "#join multi-char sep" assert=

"#join with non-strings" test-section
{ 1 2 3 } ", " #join "1, 2, 3" "#join integers" assert=
\ NOTE: Boolean arrays { t f } cause OOM - pre-existing interpreter bug, not #join issue
\ { t f } " and " #join "t and f" "#join booleans" assert=

"#join mixed types" test-section
{ "count" 42 } ": " #join "count: 42" "#join string and int" assert=

"#join large input" test-section
\ 1000 fragments joined with a separator: linear-time, formerly quadratic.
1000 iota >iterator [ drop "ab" ] #map #collect "-" #join
dup #len 2999 "#join large input length" assert=
0 5 #slice "ab-ab" "#join large input prefix" assert=

"#concat basic" test-section
{ } #concat "" "#concat empty" assert=
{ "only" } #concat "only" "#concat single" assert=
{ "a" "b" "c" } #concat "abc" "#concat many" assert=
{ "a" "" "b" } #concat "ab" "#concat empty fragments" assert=

"#concat large input" test-section
\ 1000 string fragments concatenated: linear-time, formerly quadratic.
1000 iota >iterator [ drop "ab" ] #map #collect #concat
dup #len 2000 "#concat large input length" assert=
0 4 #slice "abab" "#concat large input prefix" assert=

"repeat" test-section
"ab" 3 repeat "ababab" "repeat 3 times" assert=
"x" 1 repeat "x" "repeat 1 time" assert=
"hello" 0 repeat "" "repeat 0 times" assert=
"test" -1 repeat "" "repeat negative" assert=
"" 5 repeat "" "repeat empty string" assert=

"All string tests complete!" print-line
