\ Test basic module operations

\ Test 1: module declaration and exported words
module: testmod

private-helper: [ 1 ] ;
public-fn: exported [ 42 ] ;

\ Test that private helper works within module
private-helper .

\ Test that exported function works
public-fn .

\ Test 2: Import a module using use:
use: [ "testmath" ]

\ Test double (exported)
5 double .

\ Test triple (exported)
3 triple .

\ Test add-one (exported, uses private helper)
10 add-one .

\ Output summary
"modules_basic: all tests passed" print-line
