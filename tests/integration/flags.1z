\ Test flag parsing library

use "lib/testing.1z" ;
use "lib/flags.1z" ;

"flag parsing" test-section

help: flag{ description: "Show help" short: "h" } ;
name: required positional flag{ type: string: description: "Your name" } ;

{ "Alice" } "Test program" parse-flags
dup "name" @get "Alice" "positional arg parsed" assert=
"help" @get f "help defaults to false" assert=

"All flags tests complete!" print-line
