\ Tests for parse-integer with negative numbers (lib/conversions.1z)

use "testing" ;
use "conversions" ;

"parse-integer positive" test-section
"123" parse-integer 123 "three digits" assert=
"0" parse-integer 0 "zero" assert=
"9" parse-integer 9 "single digit" assert=
"1000000" parse-integer 1000000 "large number" assert=

"parse-integer negative" test-section
"-42" parse-integer -42 "negative" assert=
"-1" parse-integer -1 "negative one" assert=
"-0" parse-integer 0 "negative zero" assert=
"-999999" parse-integer -999999 "large negative" assert=

"conversion failures" test-section
[ "abc" parse-integer ] parse-error: "a non-numeric string is a parse error" assert-error-type
[ "1.5" parse-integer ] parse-error: "a float literal is a parse error" assert-error-type
[ "maybe" parse-boolean ] parse-error: "an unknown boolean spelling is a parse error" assert-error-type

"invalid integer" [ "abc" parse-integer ] [ message: @get ] recover "invalid integer message" assert=
"not an integer" [ "1.5" parse-integer ] [ message: @get ] recover "not an integer message" assert=
"invalid boolean" [ "maybe" parse-boolean ] [ message: @get ] recover "invalid boolean message" assert=
