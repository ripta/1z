\ Test new constructor/destructor naming convention

use "testing" ;

"plain struct: unmake and >hash" test-section

pt: struct{ x y } ;

\ unmake-NAME destructures to fields in order
1 2 make-pt unmake-pt 2 "unmake-pt second field" assert=
drop

1 2 make-pt unmake-pt drop 1 "unmake-pt first field" assert=

\ NAME>hash converts to hash with field-name keys
3 4 make-pt pt>hash @keys #len 2 "pt>hash has 2 keys" assert=
3 4 make-pt pt>hash x: @get 3 "pt>hash x key" assert=
3 4 make-pt pt>hash y: @get 4 "pt>hash y key" assert=

\ >hash generic dispatch works on plain structs
3 4 make-pt >hash x: @get 3 ">hash dispatch x key" assert=
3 4 make-pt >hash y: @get 4 ">hash dispatch y key" assert=

"simple virtual: make and unmake" test-section

speed: virtual{ fixnum } ;

\ make-NAME wraps
42 make-speed speed? t "make-speed creates speed" assert=
42 make-speed type-name "speed" "make-speed type-of" assert=

\ unmake-NAME unwraps
42 make-speed unmake-speed 42 "unmake-speed unwraps" assert=

\ >NAME still works for simple virtuals
42 >speed speed? t ">speed still works" assert=

"struct-backed virtual: make, unmake, >hash" test-section

vec2: virtual{ struct{ vx vy } } ;

\ make-NAME wraps positionally
10 20 make-vec2 vec2? t "make-vec2 creates vec2" assert=
10 20 make-vec2 type-name "vec2" "make-vec2 type-of" assert=

\ unmake-NAME destructures
10 20 make-vec2 unmake-vec2 20 "unmake-vec2 second field" assert=
drop

10 20 make-vec2 unmake-vec2 drop 10 "unmake-vec2 first field" assert=

\ NAME>hash converts to hash
10 20 make-vec2 vec2>hash vx: @get 10 "vec2>hash vx key" assert=
10 20 make-vec2 vec2>hash vy: @get 20 "vec2>hash vy key" assert=

\ >hash generic dispatch works
10 20 make-vec2 >hash vx: @get 10 ">hash dispatch on vec2 vx" assert=
10 20 make-vec2 >hash vy: @get 20 ">hash dispatch on vec2 vy" assert=

\ >vec2 now accepts a hash
H{ vx: 10 vy: 20 } >vec2 vec2? t ">vec2 accepts hash" assert=
H{ vx: 10 vy: 20 } >vec2 unmake-vec2 20 ">vec2 hash wrap second field" assert=
drop

"enum data-carrying variants: make, unmake, >hash" test-section

shape: enum{ circle struct{ radius } rect struct{ w h } dot } ;

\ Single-field variant: make/unmake
5 make-shape:circle shape:circle? t "make-shape:circle creates circle" assert=
5 make-shape:circle unmake-shape:circle 5 "unmake-shape:circle unwraps radius" assert=

\ Multi-field variant: make/unmake
3 4 make-shape:rect shape:rect? t "make-shape:rect creates rect" assert=
3 4 make-shape:rect unmake-shape:rect 4 "unmake-shape:rect second field" assert=
drop

3 4 make-shape:rect unmake-shape:rect drop 3 "unmake-shape:rect first field" assert=

\ Variant >hash
5 make-shape:circle shape:circle>hash radius: @get 5 "shape:circle>hash radius key" assert=
3 4 make-shape:rect shape:rect>hash w: @get 3 "shape:rect>hash w key" assert=
3 4 make-shape:rect shape:rect>hash h: @get 4 "shape:rect>hash h key" assert=

\ >hash dispatch on enum variants
5 make-shape:circle >hash radius: @get 5 ">hash dispatch on circle" assert=
3 4 make-shape:rect >hash w: @get 3 ">hash dispatch on rect w" assert=

\ >NAME still works for single-field variants (positional)
5 >shape:circle shape:circle? t ">shape:circle still works" assert=

\ >NAME is hash-based for multi-field variants
H{ w: 3 h: 4 } >shape:rect shape:rect? t ">shape:rect accepts hash" assert=
H{ w: 3 h: 4 } >shape:rect unmake-shape:rect 4 ">shape:rect hash wrap h field" assert=
drop

">hash works across different types" test-section

\ >hash dispatches correctly for both plain structs and virtual types
1 2 make-pt >hash x: @get 1 ">hash on plain struct" assert=
10 20 make-vec2 >hash vx: @get 10 ">hash on struct-backed virtual" assert=
5 make-shape:circle >hash radius: @get 5 ">hash on enum variant" assert=
