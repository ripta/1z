use "testing" ;

\ Exercises the per-Context satisfies-check memo through a REPL-style late
\ binding: a type initially missing a required method fails validation,
\ then a method{ registration coarsely invalidates the memo and the next
\ check succeeds.

late-box:      virtual{ fixnum } ;
late-method:   generic ( v -- v ) [ ] ;
late-protocol: protocol{ late-method: } ;

test-initial-failure: ( -- ) [
  [ late-box: late-protocol assert-satisfies ] "late-box initially fails late-protocol" assert-error
] ;
test-initial-failure

late-method: method{ late-box } [ unmake-late-box ] ;

test-after-binding: ( -- ) [
  late-box: late-protocol assert-satisfies
  t "late-box passes late-protocol after late-method binding" assert-true
] ;
test-after-binding
