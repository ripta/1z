\ Integration tests for Unicode string operations
\ Tests that string operations work on codepoints, not bytes

use "testing" ;

"#len with Unicode" test-section
"hello" #len 5 "ASCII #len" assert=
"cafe" #len 4 "cafe #len (4 codepoints)" assert=
"nihongo" #len 7 "Japanese romaji #len" assert=
"" #len 0 "empty string #len" assert=

"#nth with Unicode" test-section
"cafe" 0 #nth "c" "#nth cafe[0]" assert=
"cafe" 1 #nth "a" "#nth cafe[1]" assert=
"cafe" 2 #nth "f" "#nth cafe[2]" assert=
"cafe" 3 #nth "e" "#nth cafe[3]" assert=
"abc" 0 #nth "a" "#nth abc[0]" assert=
"abc" 1 #nth "b" "#nth abc[1]" assert=
"abc" 2 #nth "c" "#nth abc[2]" assert=

"#first with Unicode" test-section
"cafe" #first "c" "#first cafe" assert=
"abc" #first "a" "#first abc" assert=
"x" #first "x" "#first single char" assert=

"#last with Unicode" test-section
"cafe" #last "e" "#last cafe" assert=
"abc" #last "c" "#last abc" assert=
"x" #last "x" "#last single char" assert=

"#slice with Unicode" test-section
"cafe" 0 2 #slice "ca" "#slice cafe[0:2]" assert=
"cafe" 2 4 #slice "fe" "#slice cafe[2:4]" assert=
"hello" 0 5 #slice "hello" "#slice full string" assert=
"hello" 1 4 #slice "ell" "#slice middle" assert=

"#each with Unicode" test-section
0 "cafe" [ drop 1 + ] #each 4 "#each cafe count" assert=
0 "abc" [ drop 1 + ] #each 3 "#each abc count" assert=

"#map with Unicode" test-section
"ab" [ drop "x" ] #map #count 2 "#map ASCII" assert=
"abc" [ drop "y" ] #map #count 3 "#map length preserved" assert=

"#filter with Unicode" test-section
"aeb" [ "a" = not ] #filter #collect { "e" "b" } "#filter remove a" assert=

"#reduce with Unicode" test-section
"ab" "" [ #append ] #reduce "ab" "#reduce concat" assert=

"String concatenation" test-section
"hello" " world" #append "hello world" "#append strings" assert=

"Error cases" test-section
[ "cafe" 10 #nth ] "#nth out of bounds" assert-error

"All Unicode string tests complete!" print-line
