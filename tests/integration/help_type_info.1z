use "testing" ;
use "runtime/introspect" ;

"struct type info" test-section

ht-point: struct{ x y } ;
ht-point: >word-info? unwrap-or-throw format-word-info
dup "type info:" #in? "struct has type info header" assert-true
dup "kind: struct" #in? "struct shows kind" assert-true
dup "fields: x y" #in? "struct shows fields" assert-true
dup "generated-words:" #in? "struct shows generated-words" assert-true
dup "make-ht-point" #in? "struct generated-words includes constructor" assert-true
drop

"virtual type info (simple wrap)" test-section

ht-meter: virtual{ fixnum } ;
ht-meter: >word-info? unwrap-or-throw format-word-info
dup "type info:" #in? "simple virtual has type info header" assert-true
dup "kind: virtual" #in? "simple virtual shows kind" assert-true
dup "wraps: fixnum" #in? "simple virtual shows wraps" assert-true
dup "generated-words:" #in? "simple virtual shows generated-words" assert-true
drop

"virtual type info (struct-backed)" test-section

ht-vec: virtual{ struct{ vx vy } } ;
ht-vec: >word-info? unwrap-or-throw format-word-info
dup "type info:" #in? "struct-backed virtual has type info header" assert-true
dup "kind: virtual" #in? "struct-backed virtual shows kind" assert-true
dup "fields: vx vy" #in? "struct-backed virtual shows fields" assert-true
dup "generated-words:" #in? "struct-backed virtual shows generated-words" assert-true
drop

"enum type info (flat)" test-section

ht-color: enum{ red: unit green: unit blue: unit } ;
ht-color: >word-info? unwrap-or-throw format-word-info
dup "type info:" #in? "enum has type info header" assert-true
dup "kind: enum" #in? "enum shows kind" assert-true
dup "variants:" #in? "enum shows variants header" assert-true
dup "red:" #in? "enum shows red variant" assert-true
dup "green:" #in? "enum shows green variant" assert-true
dup "blue:" #in? "enum shows blue variant" assert-true
dup "unit" #in? "enum shows unit type" assert-true
dup "generated-words:" #in? "enum shows generated-words" assert-true
drop

"enum type info (data-carrying)" test-section

ht-circle-data: struct{ radius } ;
ht-shape: enum{ circle: ht-circle-data dot: unit } ;
ht-shape: >word-info? unwrap-or-throw format-word-info
dup "kind: enum" #in? "data enum shows kind" assert-true
dup "circle:" #in? "data enum shows circle variant" assert-true
dup "ht-circle-data" #in? "data enum shows struct type" assert-true
dup "dot:" #in? "data enum shows dot variant" assert-true
drop

"builtin type info (with metadata)" test-section

fixnum: >word-info? unwrap-or-throw format-word-info
dup "type info:" #in? "fixnum has type info header" assert-true
dup "kind: builtin-type" #in? "fixnum shows kind" assert-true
dup "numeric: t" #in? "fixnum shows numeric" assert-true
dup "exact: t" #in? "fixnum shows exact" assert-true
dup "integer: t" #in? "fixnum shows integer" assert-true
drop

"builtin type info (without metadata)" test-section

boolean: >word-info? unwrap-or-throw format-word-info
dup "type info:" #in? "boolean has type info header" assert-true
dup "kind: builtin-type" #in? "boolean shows kind" assert-true
drop

"non-typed word has no type info" test-section

dup: >word-info? unwrap-or-throw format-word-info
"type info:" #in? not "dup has no type info" assert-true
