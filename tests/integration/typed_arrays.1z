\ Test parameterized virtual types

use "testing" ;

"define-parameterized-type" test-section

\ Define a parameterized type: array(fixnum)
array(fixnum): M{ inner-type: array element-type: fixnum define: [ define-parameterized-type ] } ;

\ Basic construction
{ 1 2 3 } >array(fixnum)
type-name "array(fixnum)" "type-of returns parameterized type name" assert=

\ Predicate
{ 1 2 3 } >array(fixnum) array(fixnum)? t "array(fixnum)? on typed array is true" assert=
{ 1 2 3 } array(fixnum)? f "array(fixnum)? on plain array is false" assert=
42 array(fixnum)? f "array(fixnum)? on fixnum is false" assert=

\ Unwrap
{ 1 2 3 } >array(fixnum) unmake-array(fixnum) { 1 2 3 } "unmake-array(fixnum) unwraps to raw array" assert=

\ Element validation rejects mixed types
[ { 1 "hello" 3 } >array(fixnum) ] "error" assert-error

\ Empty array succeeds (vacuous truth)
{ } >array(fixnum)
type-name "array(fixnum)" "empty array wraps as typed array" assert=

\ make-array(fixnum) bypasses element validation
{ 1 "hello" 3 } make-array(fixnum)
type-name "array(fixnum)" "make- bypasses element validation" assert=

"custom naming" test-section

\ Custom naming works
fixnum-array: M{ inner-type: array element-type: fixnum define: [ define-parameterized-type ] } ;
{ 10 20 } >fixnum-array
type-name "fixnum-array" "custom parameterized type name works" assert=

"sequence ops on typed arrays" test-section

\ #len on typed array
{ 1 2 3 } >array(fixnum) #len 3 "#len on typed array" assert=

\ #nth on typed array
{ 10 20 30 } >array(fixnum) 1 #nth 20 "#nth on typed array" assert=

\ #first / #last on typed array
{ 10 20 30 } >array(fixnum) #first 10 "#first on typed array" assert=
{ 10 20 30 } >array(fixnum) #last 30 "#last on typed array" assert=

\ #each on typed array
0 { 1 2 3 } >array(fixnum) [ + ] #each 6 "#each on typed array" assert=

\ #map on typed array returns plain array
{ 1 2 3 } >array(fixnum) [ 10 * ] #map #collect { 10 20 30 } "#map on typed array" assert=

\ #filter on typed array returns plain array
{ 1 2 3 4 5 } >array(fixnum) [ 3 > ] #filter #collect { 4 5 } "#filter on typed array" assert=

\ >iterator on typed array
{ 10 20 } >array(fixnum) >iterator #collect { 10 20 } ">iterator on typed array" assert=

"instance-of? with base type" test-section

\ array(fixnum) is instance-of array
{ 1 2 3 } >array(fixnum) array instance-of? t "typed array is instance-of base type" assert=

\ array(fixnum) is NOT instance-of fixnum
{ 1 2 3 } >array(fixnum) fixnum instance-of? f "typed array is not instance-of element type" assert=

"numeric tower promotion" test-section

\ Define array(float) and array(bignum) for promotion tests
array(float): M{ inner-type: array element-type: float define: [ define-parameterized-type ] } ;
array(bignum): M{ inner-type: array element-type: bignum define: [ define-parameterized-type ] } ;

\ fixnum -> float promotion
{ 1 2 3 } >array(float)
type-name "array(float)" "fixnum elements promote to array(float)" assert=

\ mixed fixnum/float -> float promotion
{ 1 2.0 3 } >array(float)
type-name "array(float)" "mixed fixnum/float promote to array(float)" assert=

\ promoted elements have correct type
{ 1 2 3 } >array(float) unmake-array(float) 0 #nth type-name
"float" "promoted fixnum element becomes float" assert=

\ fixnum -> bignum promotion
{ 1 2 3 } >array(bignum)
type-name "array(bignum)" "fixnum elements promote to array(bignum)" assert=

\ promoted bignum element has correct type
{ 1 2 3 } >array(bignum) unmake-array(bignum) 0 #nth type-name
"bignum" "promoted fixnum element becomes bignum" assert=

\ float -> bignum is NOT upward promotion (should fail)
[ { 1 2.0 3 } >array(bignum) ] "error" assert-error

\ string -> float is not in the numeric tower (should fail)
[ { "a" "b" } >array(float) ] "error" assert-error

"nested parameterized types" test-section

\ Nested parameterized types
array(array(fixnum)): M{ inner-type: array element-type: array(fixnum) define: [ define-parameterized-type ] } ;
{ { 1 2 } { 3 4 } } [ >array(fixnum) ] #map #collect >array(array(fixnum))
type-name "array(array(fixnum))" "nested parameterized types work" assert=

"alias interning and nominal wrappers" test-section

foo-array: M{ inner-type: array element-type: fixnum define: [ define-parameterized-type ] } ;
bar-array: M{ inner-type: array element-type: fixnum define: [ define-parameterized-type ] } ;
baz-array: M{ inner-type: array element-type: string define: [ define-parameterized-type ] } ;

foo-array bar-array = "same parameterized aliases compare equal as types" assert-true
foo-array baz-array = "different parameterized aliases compare unequal as types" assert-false

{ 1 2 } >foo-array type-name "foo-array" ">foo alias keeps own type-of name" assert=
{ 1 2 } >bar-array type-name "bar-array" ">bar alias keeps own type-of name" assert=

{ 1 2 } >foo-array foo-array? "foo-array? matches foo wrapper" assert-true
{ 1 2 } >bar-array foo-array? "foo-array? rejects bar wrapper" assert-false
{ 1 2 } >foo-array bar-array? "bar-array? rejects foo wrapper" assert-false

[ { 1 2 } >bar-array unmake-foo-array drop ] "error" assert-error

foo-array native.type-generated-words "make-foo-array" #in? "foo alias generated words stay alias-specific" assert-true
foo-array native.type-generated-words "make-bar-array" #in? "foo alias generated words exclude bar names" assert-false
bar-array native.type-generated-words "make-bar-array" #in? "bar alias generated words stay alias-specific" assert-true

describe-array: generic [ ] ;
describe-array: method{ foo-array } [ drop "shared-dispatch" ] ;

{ 1 2 } >foo-array describe-array "shared-dispatch" "dispatch works on defining alias" assert=
{ 1 2 } >bar-array describe-array "shared-dispatch" "dispatch shares across equal aliases" assert=
[ { "a" "b" } >baz-array describe-array ] "error" assert-error

"virtual wrappers over parameterized aliases stay nominal" test-section

foo-array-box-a: virtual{ foo-array } ;
foo-array-box-b: virtual{ foo-array } ;

foo-array-box-a foo-array-box-b = "distinct virtual wrappers over same parameterized alias are different types" assert-false

{ 1 2 } >foo-array >foo-array-box-a type-name "foo-array-box-a" "first virtual wrapper keeps its own type name" assert=
{ 1 2 } >foo-array >foo-array-box-b type-name "foo-array-box-b" "second virtual wrapper keeps its own type name" assert=

{ 1 2 } >foo-array >foo-array-box-a { 1 2 } >foo-array >foo-array-box-b =
f "values wrapped by distinct virtual aliases are not equal" assert=

{ 1 2 } >foo-array >foo-array-box-a foo-array-box-a? "first virtual wrapper predicate matches" assert-true
{ 1 2 } >foo-array >foo-array-box-b foo-array-box-a? "first virtual wrapper predicate rejects second wrapper" assert-false
{ 1 2 } >foo-array >foo-array-box-a foo-array-box-b? "second virtual wrapper predicate rejects first wrapper" assert-false

[ { 1 2 } >foo-array >foo-array-box-b unmake-foo-array-box-a drop ] "error" assert-error
