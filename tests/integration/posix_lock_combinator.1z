use "testing" ;
use "posix" ;

\ Demonstrates downstream consumption of posix.flock: a file-locking combinator
\ built entirely over posix.flock + posix-const, proving the syscall binding
\ works end-to-end when bracketed by a quotation. The combinator is defined here
\ to demonstrate the pattern; it is not part of the library surface.

\ Map the 1z-flavored mode symbol to its LOCK_* operation.
(demo-lock-op): ( mode -- op ) [
  exclusive: = [ "LOCK_EX" ] [ "LOCK_SH" ] if posix-const
] ;

\ Acquire an advisory whole-file lock on a stream, run the quotation with the
\ stream still on the stack, and release the lock on every exit path. Release
\ runs on normal return and on throw, because it rides on cleanup.
using-file-lock: ( ..a stream mode quot: ( ..a stream -- ..b ) -- ..b ) [
  [ over stream>fd swap (demo-lock-op) flock drop ] dip
  over [ stream>fd "LOCK_UN" posix-const flock drop ] curry
  cleanup
] ;

\ Open a fresh independent descriptor on `path`, try a non-blocking exclusive
\ flock, then release and close. Returns t if the lock was acquired, f if it
\ would have blocked. A second open is a distinct open file description, so its
\ flock contends with any lock held through another descriptor.
(probe-lockable?): ( path -- bool ) [
  read: stream-open
  dup [ stream>fd "LOCK_EX" posix-const "LOCK_NB" posix-const bitor flock drop t ] [ drop f ] recover
  over stream>fd "LOCK_UN" posix-const flock drop
  swap stream-close
] ;

"posix.flock combinator setup" test-section

"tests/integration/_tmp_lockc.txt" write: stream-open stream-close

\ === lock held during the quotation ===
"lock held during quotation" test-section

"tests/integration/_tmp_lockc.txt" read-write: stream-open
"tests/integration/_tmp_lockc.txt"
[ (probe-lockable?) f "prober blocks while lock is held" assert= ] curry
exclusive: swap
using-file-lock
stream-close

\ === lock released on normal exit ===
"lock released on normal exit" test-section

"tests/integration/_tmp_lockc.txt" (probe-lockable?)
t "prober acquires after the combinator returns normally" assert=

\ === lock released on a throwing body ===
"lock released on throw" test-section

"tests/integration/_tmp_lockc.txt" read-write: stream-open
dup
[ exclusive: [ drop f "boom" EUserThrown make-error throw ] using-file-lock ] curry
"combinator re-throws the body error" assert-error
stream-close
"tests/integration/_tmp_lockc.txt" (probe-lockable?)
t "prober acquires after the combinator throws" assert=

\ === shared mode binds and releases ===
"shared mode binds" test-section

"tests/integration/_tmp_lockc.txt" read-write: stream-open
shared: [ ] using-file-lock
stream-close
"tests/integration/_tmp_lockc.txt" (probe-lockable?)
t "shared-mode combinator runs and releases" assert=

"tests/integration/_tmp_lockc.txt" delete-file
