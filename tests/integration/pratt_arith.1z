use "testing" ;
use "lexer" ;
use "pratt/arith" ;

TEST-LEXER: const [
  V{ }
  skip-whitespace-rule #push!
  number-rule #push!
  { "+" "-" "*" "/" "(" ")" } symbols-rule #push!
  >array <lexer>
] ;

(eval): ( str -- value ) [
  TEST-LEXER tokenize <arithmetic-pratt> parse-expr
] ;

"hierarchical use" test-section
"1 + 2" (eval) 3 "use \"pratt/arith\" resolves through lib hierarchy" assert=

"single literal" test-section
"42" (eval) 42 "integer literal parses" assert=
"3.5" (eval) 3.5 "float literal parses" assert=

"binary arithmetic" test-section
"1 + 2" (eval) 3 "1 + 2 = 3" assert=
"5 - 3" (eval) 2 "5 - 3 = 2" assert=
"3 * 4" (eval) 12 "3 * 4 = 12" assert=
"10 / 2" (eval) 5 "10 / 2 = 5" assert=

"precedence and associativity" test-section
"1 + 2 * 3" (eval) 7 "multiplication binds tighter than addition" assert=
"(1 + 2) * 3" (eval) 9 "parentheses override precedence" assert=
"10 - 3 - 2" (eval) 5 "subtraction is left associative" assert=
"20 / 4 / 5" (eval) 1 "division is left associative" assert=

"unary minus" test-section
"-2" (eval) -2 "unary minus on literal" assert=
"-2 * 3" (eval) -6 "unary minus binds tighter than multiplication" assert=
"-(1 + 2)" (eval) -3 "unary minus applies to grouped expression" assert=
"1 + -2" (eval) -1 "unary minus can appear after binary operator" assert=

"decimal arithmetic" test-section
"3.5 + 0.5" (eval) 4.0 "decimal literals are parsed via resolve-literal" assert=

"error: empty input" test-section
[ "" (eval) ] "empty input throws" assert-error

"error: unexpected operator" test-section
[ "+" (eval) ] [ ] recover
dup message: @get "expected expression, got '+' at position 0" "unexpected operator message" assert=
dup error-type: @get parse-error: "unexpected operator is a parse error" assert=
data: @get
dup offset: @get 0 "unexpected operator offset" assert=
text: @get "+" "unexpected operator text" assert=

"error: unexpected token after operator" test-section
[ "1 + )" (eval) ] [ ] recover
data: @get offset: @get 4 "offending ')' offset" assert=

"error: wrong token in place of close paren" test-section
[ "(1 + 2 3" (eval) ] [ ] recover
dup message: @get "expected ')', got '3' at position 7" "close paren message names the token" assert=
data: @get offset: @get 7 "close paren offset" assert=

"error: missing close paren" test-section
[ "(1 + 2" (eval) ] [ ] recover
dup message: @get "expected ')' at end of input" "missing close paren message" assert=
dup error-type: @get parse-error: "end of input is a parse error" assert=
data: @get f "end of input carries no data" assert=

"error: trailing token" test-section
[ "1 + 2)" TEST-LEXER tokenize <arithmetic-pratt> parse-complete ] [ ] recover
dup message: @get "unexpected trailing token ')' at position 5" "trailing token message" assert=
data: @get offset: @get 5 "trailing token offset" assert=

"error: unrecognized input after the first token" test-section
\ Each line consumes the error, because its frame chain differs between interpreted and eager runs.
[ "1 + $" (eval) ] [ ] recover message: @get "unrecognized input '$' at position 4" "mid-stream lexer failure surfaces" assert=
[ "1 + $" (eval) ] [ ] recover data: @get offset: @get 4 "mid-stream lexer failure offset" assert=
