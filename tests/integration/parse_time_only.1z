\ Test parse-time-only marker and implication semantics

use "testing" ;

"parse-time-only marker" test-section

\ The parse-time-only marker is pushable
parse-time-only marker? "parse-time-only is a marker" assert-true

\ A word with parse-time-only gets the marker attached
my-pto-word: parse-time-only [ 42 ] ;
my-pto-word: >word-info markers>> #len 1 "parse-time-only word has 1 marker" assert=

\ parse-time-only implies parse-time: the word executes at parse time
\ (if it weren't parse-time, we couldn't use it in a word definition context)
pto-result: my-pto-word ;
pto-result 42 "parse-time-only word executed at parse time" assert=

\ A word with both parse-time and parse-time-only works (redundant but valid)
my-both-word: parse-time parse-time-only [ 99 ] ;
my-both-word: >word-info markers>> #len 2 "both-markers word has 2 markers" assert=

\ Both-markers word also executes at parse time
both-result: my-both-word ;
both-result 99 "both-markers word executed at parse time" assert=

"parse-time-only transitive use" test-section

\ match{ is a parse-time word that internally uses parse-time-only primitives
\ (parse-values-until, emit-call). It should still work in non-parse-time definitions.
pto-color: enum{ red: unit green: unit blue: unit } ;
match-test: [
  match{
    pto-color:red:   [ "R" ]
    pto-color:green: [ "G" ]
    pto-color:blue:  [ "B" ]
  }
] ;
pto-color:red match-test "R" "match{ works in non-parse-time definition" assert=
pto-color:green match-test "G" "match{ second branch" assert=
pto-color:blue match-test "B" "match{ third branch" assert=

"parse-time-only in parse-time definition" test-section

\ A parse-time-only word used inside another parse-time definition is valid
pto-inner:        parse-time-only [ 77 ] ;
pto-outer:        parse-time [ pto-inner ] ;
pto-outer-result: pto-outer ;
pto-outer-result 77 "parse-time-only word in parse-time def works" assert=

"native parse-time-only primitives in parse-time definitions" test-section

\ parse-token works inside a parse-time definition
grab-next: parse-time [ parse-token ] ;
grab-next-result: grab-next hello ;
grab-next-result "hello" "parse-token in parse-time def" assert=

\ peek-token works inside a parse-time definition
peek-next: parse-time [ peek-token ] ;
peek-next-result: peek-next peeked ;
peek-next-result "peeked" "peek-token in parse-time def" assert=

\ parse-literal works inside a parse-time definition
grab-lit: parse-time [ parse-literal ] ;
grab-lit-result: grab-lit 42 ;
grab-lit-result 42 "parse-literal in parse-time def" assert=

\ parse-tokens-until works inside a parse-time definition
grab-toks: parse-time [ "}" parse-tokens-until ] ;
grab-toks-result: grab-toks a b c } ;
grab-toks-result #len 3 "parse-tokens-until in parse-time def" assert=

\ emit-call works inside a parse-time definition (used by match{, etc.)
\ Already tested transitively via match{ above
