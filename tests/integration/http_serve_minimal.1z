use "testing" ;
use "net" ;
use "net/tcp" ;
use "time" ;

"tcp wrappers: accept with raw connect" test-section
[
  "127.0.0.1" 39420 make-addr:tcp 128 listen

  \ Spawn accept+echo task using accept
  dup [
    accept drop
    dup stream-read-line
    over swap stream-write drop
    stream-close
  ] curry spawn

  \ Client: raw connect
  "127.0.0.1" 39420 make-addr:tcp resolve #first
  dup socket
  dup <rot- native.connect
  fd>stream

  dup "hello\n" stream-write drop
  dup 5 stream-read
  #len 5 "echoed 5 bytes" assert=

  stream-close
  await drop
  close
] task-scope
