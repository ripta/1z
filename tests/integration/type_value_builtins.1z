\ Tests for built-in type value registration

use "testing" ;

"Type values exist and inspect correctly" test-section

fixnum inspect "<type:fixnum>" "fixnum type value" assert=
bignum inspect "<type:bignum>" "bignum type value" assert=
float inspect "<type:float>" "float type value" assert=
boolean inspect "<type:boolean>" "boolean type value" assert=
string inspect "<type:string>" "string type value" assert=
symbol inspect "<type:symbol>" "symbol type value" assert=
array inspect "<type:array>" "array type value" assert=
quotation inspect "<type:quotation>" "quotation type value" assert=
hash inspect "<type:hash>" "hash type value" assert=
vector inspect "<type:vector>" "vector type value" assert=
byte-array inspect "<type:byte-array>" "byte-array type value" assert=
set inspect "<type:set>" "set type value" assert=
mutable-map inspect "<type:mutable-map>" "mutable-map type value" assert=
stream inspect "<type:stream>" "stream type value" assert=
resource inspect "<type:resource>" "resource type value" assert=
parameter inspect "<type:parameter>" "parameter type value" assert=
module inspect "<type:module>" "module type value" assert=
marker inspect "<type:marker>" "marker type value" assert=
struct-type inspect "<type:struct-type>" "struct-type type value" assert=
struct-instance inspect "<type:struct-instance>" "struct-instance type value" assert=
tagged inspect "<type:tagged>" "tagged type value" assert=
template inspect "<type:template>" "template type value" assert=
stack-effect inspect "<type:stack-effect>" "stack-effect type value" assert=
error inspect "<type:error>" "error type value" assert=
task inspect "<type:task>" "task type value" assert=
channel inspect "<type:channel>" "channel type value" assert=
iterator inspect "<type:iterator>" "iterator type value" assert=
doc-string inspect "<type:doc-string>" "doc-string type value" assert=

"Type values are const" test-section

[ fixnum: [ 1 ] ;
] ECannotRedefineConst "fixnum is const" assert-error-type
[ boolean: [ 1 ] ;
] ECannotRedefineConst "boolean is const" assert-error-type
[ string: [ 1 ] ;
] ECannotRedefineConst "string is const" assert-error-type

"Renamed words still work" test-section

42 "{}" >template interpolate "42" ">template still works" assert=
test-dp: define-parameter [ 42 ] ;
test-dp get 42 "define-parameter still works" assert=
{ "a" } { "b" } make-stack-effect-info stack-effect-info? t "stack-effect-info struct exists" assert=

"Type predicates still work" test-section

42 fixnum? t "fixnum? still works" assert=
"hello" string? t "string? still works" assert=
t boolean? t "boolean? still works" assert=
{ 1 2 } array? t "array? still works" assert=
H{ x: 1 } hash? t "hash? still works" assert=
