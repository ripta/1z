\ Test marker value type and marker definitions

use "testing" ;

"Marker identity semantics" test-section

define-marker define-marker = f "different markers are not equal" assert=
define-marker dup = t "same marker is equal to itself" assert=

"Defining named markers" test-section

test-marker: define-marker ;
test-marker marker? t "marker? predicate" assert=
test-marker type-of marker "type-of returns marker:" assert=
test-marker inspect "<marker:test-marker>" "named marker inspect" assert=

"Marker identity after naming" test-section

test-marker test-marker = t "same named marker equals itself" assert=
test-marker define-marker = f "named marker doesn't equal anonymous" assert=

"Two different named markers" test-section

marker-a: define-marker ;
marker-b: define-marker ;
marker-a marker-b = f "different named markers not equal" assert=

"Parse-time marker" test-section

parse-time marker? t "parse-time is a marker" assert=
parse-time inspect "<marker:parse-time>" "parse-time marker string" assert=
parse-time parse-time = t "parse-time marker identity" assert=

"Attaching markers to definitions" test-section

custom-marker: define-marker ;
my-word: custom-marker [ 42 ] ;
my-word 42 "word with custom marker" assert=

"Multiple markers on a definition" test-section

marker1: define-marker ;
marker2: define-marker ;
multi-marker-word: marker1 marker2 [ 99 ] ;
multi-marker-word 99 "word with multiple markers" assert=

"Marker with stack effect" test-section

my-marker2: define-marker ;
word-with-effect: my-marker2 ( -- n ) [ 77 ] ;
word-with-effect 77 "word with marker and stack effect" assert=

"Parse-time word execution bug fixes" test-section

\ Define a parse-time word that reads next literal and doubles it
double-next: parse-time [ parse-literal 2 * ] ;
double-next 21 42 "parse-time word has tokenizer access" assert=

\ Define a parse-time word that reads a quotation
wrap-quot: parse-time [ parse-quotation ] ;
wrap-quot [ 5 ] call 5 "parse-time can read quotations" assert=

"User-defined markers with struct{}" test-section

\ User-defined markers are automatically parse-time, so they work with struct{}
my-struct-marker: define-marker ;
test-struct: my-struct-marker struct{ val } ;
100 make-test-struct test-struct? t "user marker with struct works" assert=
100 make-test-struct val>> 100 "struct created correctly" assert=
