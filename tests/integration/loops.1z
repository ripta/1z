\ Test loop words from prelude

\ times ( n quot -- ) - Repeats the following word n times
3 [ "Hello, World!" print ] times
wipe

\ while ( pred body -- ) - Repeats body while pred is true
10 [ dup 0 > ] [ dup . 1 - ] while
wipe

\ loop ( pred -- ) - Loops execution of the quotation until it results in false
3 [ dup . 7 + 11 % dup 3 = not ] loop
wipe
