\ Test loop words from prelude

use "testing" ;

"times" test-section
\ times executes quotation N times (quotation should have effect --)
3 [ "tick" print-line ] times
t "times executes" assert-true

"while" test-section
\ while: pred body -- continues while pred returns true
10 [ dup 0 > ] [ 1 - ] while 0 "while counts to zero" assert=

"loop" test-section
\ loop: pred -- continues while pred returns true (pred body combined)
3 [ 1 - dup 0 > ] loop 0 "loop until zero" assert=

"do while" test-section
\ do: execute body once first, then continue with while
3 [ dup 0 > ] [ 1 - ] do while 0 "do while with 3" assert=
