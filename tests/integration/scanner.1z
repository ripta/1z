\ Integration tests for lib/scanner.1z

use "testing" ;
use "scanner" ;
use "char" ;
use "conversions" ;

"scanner type" test-section
"hello" <scanner> type-name "scanner" "type-name returns scanner" assert=
"hello" <scanner> scanner? "scanner? on scanner" assert-true
42 scanner? "scanner? on fixnum" assert-false

"<scanner> constructor" test-section
"hello" <scanner> position>> 0 "initial position is 0" assert=
"hello" <scanner> str>> "hello" "str>> returns input" assert=

"at-end?" test-section
"hello" <scanner> at-end? "not at end on non-empty" assert-false
"" <scanner> at-end? "at end on empty string" assert-true

"peek" test-section
"hello" <scanner> peek "h" "peek returns first char" assert=
"abc" <scanner> peek "a" "peek returns a" assert=
"" <scanner> peek f "peek returns f at end" assert=

"peek does not advance" test-section
"hello" <scanner> dup peek drop position>> 0 "peek leaves position unchanged" assert=

"advance" test-section
"hello" <scanner> advance position>> 1 "advance increments position" assert=
"hello" <scanner> advance peek "e" "advance then peek gives second char" assert=
"hello" <scanner> advance advance advance advance advance at-end? "advance to end" assert-true

"advance at end is no-op" test-section
"" <scanner> advance at-end? "advance on empty stays at end" assert-true
"a" <scanner> advance advance position>> 1 "advance past end stays at end" assert=

"position>>" test-section
"hello" <scanner> position>> 0 "position starts at 0" assert=
"hello" <scanner> advance advance position>> 2 "position after two advances" assert=

"rest" test-section
"hello" <scanner> rest "hello" "rest at start is full string" assert=
"hello" <scanner> advance rest "ello" "rest after one advance" assert=
"hello" <scanner> advance advance advance rest "lo" "rest after three advances" assert=
"hello" <scanner> advance advance advance advance advance rest "" "rest at end is empty" assert=
"" <scanner> rest "" "rest on empty string" assert=

"full scan" test-section
"abc" <scanner>
dup peek "a" "scan a" assert=
advance
dup peek "b" "scan b" assert=
advance
dup peek "c" "scan c" assert=
advance
at-end? "at end after scanning all" assert-true

"backtracking via dup" test-section
"hello" <scanner> advance advance dup
advance advance advance at-end? "advanced copy at end" assert-true
position>> 2 "original unchanged at position 2" assert=

"take-while" test-section
"123abc" <scanner> [ digit? ] take-while "123" "take-while digits" assert=
position>> 3 "take-while advances position" assert=
"abc123" <scanner> [ alpha? ] take-while "abc" "take-while alpha" assert=
drop
"abc" <scanner> [ digit? ] take-while "" "take-while no match returns empty" assert=
position>> 0 "take-while no match stays at 0" assert=
"" <scanner> [ digit? ] take-while "" "take-while on empty returns empty" assert=
drop
"12345" <scanner> [ digit? ] take-while "12345" "take-while full match" assert=
at-end? "take-while full match at end" assert-true

"skip-while" test-section
"   hello" <scanner> [ " " = ] skip-while
dup position>> 3 "skip-while skips spaces" assert=
rest "hello" "skip-while leaves rest" assert=
"" <scanner> [ digit? ] skip-while at-end? "skip-while on empty at end" assert-true
"abc" <scanner> [ digit? ] skip-while position>> 0 "skip-while no match stays at 0" assert=

"expect" test-section
"hello world" <scanner> "hello" expect
dup position>> 5 "expect advances past expected" assert=
rest " world" "expect leaves rest" assert=
"abc" <scanner> "" expect position>> 0 "expect empty string is no-op" assert=
[ "hello" <scanner> "xyz" expect ] "expect wrong char throws" assert-error
[ "hi" <scanner> "hello" expect ] "expect past end throws" assert-error

"composition" test-section
"  123abc" <scanner>
[ " " = ] skip-while
[ digit? ] take-while "123" "composed: take digits" assert=
rest "abc" "composed: rest after take" assert=

"start>> and end>>" test-section
"hello" <scanner> start>> 0 "start>> is 0" assert=
"hello" <scanner> end>> 5 "end>> is string length" assert=
"hello" <scanner> advance start>> 1 "start>> after advance" assert=
"hello" <scanner> advance end>> 5 "end>> unchanged after advance" assert=
"" <scanner> end>> 0 "end>> on empty string" assert=

"mark" test-section
"hello" <scanner> mark 0 "mark at start is 0" assert=
"hello" <scanner> advance advance mark 2 "mark after advances" assert=

"slice-from" test-section
"hello" <scanner> advance advance advance
dup 0 slice-from "hel" "slice-from 0 to 3" assert=
drop
"hello" <scanner> dup mark swap
advance advance advance
swap slice-from "hel" "slice-from mark to current" assert=
"hello" <scanner> advance dup mark swap advance advance
swap slice-from "el" "slice-from mid-range" assert=
"hello" <scanner> dup mark swap
swap slice-from "" "slice-from same position is empty" assert=

"find" test-section
"hello world" <scanner> "world" find
dup f = "find existing needle is not f" assert-false
start>> 6 "find positions at match" assert=

"hello world" <scanner> "xyz" find
f "find missing needle returns f" assert=

"hello world" <scanner> "" find
start>> 0 "find empty needle returns current" assert=

"hello world" <scanner> advance advance advance "lo" find
start>> 3 "find respects current position" assert=

"aXbXc" <scanner> "X" find
start>> 1 "find first occurrence" assert=

"skip-exact" test-section
"hello world" <scanner> "hello" skip-exact
dup f = "skip-exact match is not f" assert-false
rest " world" "skip-exact advances past match" assert=

"hello world" <scanner> "xyz" skip-exact
f "skip-exact mismatch returns f" assert=

"hello" <scanner> "" skip-exact
start>> 0 "skip-exact empty is no-op" assert=

"hello" <scanner> "hello" skip-exact
at-end? "skip-exact full string reaches end" assert-true

"take-until" test-section
"hello world" <scanner> " " take-until
"hello" "take-until returns text before needle" assert=
start>> 5 "take-until scanner at delimiter" assert=

"hello world" <scanner> " " take-until
swap " " skip-exact
dup f = "skip-exact after take-until is not f" assert-false
rest "world" "skip then rest gives remainder" assert=
drop

"hello" <scanner> "xyz" take-until
f "take-until not-found returns f" assert=
rest "hello" "take-until not-found preserves scanner" assert=

"hello" <scanner> "" take-until
"" "take-until empty needle returns empty string" assert=
start>> 0 "take-until empty needle stays at start" assert=

"a::b::c" <scanner> "::" take-until
"a" "take-until multi-char delimiter" assert=
"::" skip-exact
dup f = not "skip-exact after multi-char take-until" assert-true
"::" take-until
"b" "second take-until segment" assert=
"::" skip-exact rest "c" "rest after second take-until" assert=

"inspect" test-section
"hello" <scanner> inspect "<scanner pos=0 rest=\"hello\">" "inspect at start" assert=
"hello" <scanner> advance advance inspect "<scanner pos=2 rest=\"llo\">" "inspect after advances" assert=
"" <scanner> inspect "<scanner pos=0 rest=\"\">" "inspect on empty" assert=
