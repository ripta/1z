use "testing" ;
use "time" ;

\ Every shape below sends an arena-owned value across a task boundary. The
\ cross-task copy funnel rejects it with task-arena-escape: instead of handing
\ the receiver a pointer into the sender's reaped arena.

\ -- 1. await rejects each arena-owned variant --

test-await-iterator: ( -- ) [
  [
    [ [ { 1 2 3 } >iterator ] spawn await ] task-scope
  ] task-arena-escape: "iterator rejected at await" assert-error-type
] ;

test-await-parameter: ( -- ) [
  [
    [ [ p: [ 42 ] make-parameter ] spawn await ] task-scope
  ] task-arena-escape: "parameter rejected at await" assert-error-type
] ;

test-await-resource: ( -- ) [
  [
    [ [ "dummy" <test-resource> ] spawn await ] task-scope
  ] task-arena-escape: "resource rejected at await" assert-error-type
] ;

\ The stream is closed before it escapes so its GPA-backed buffer is freed; a
\ closed stream still carries the stream tag and is still rejected.
test-await-stream: ( -- ) [
  [
    [ [ 64 <string-stream> dup stream-close ] spawn await ] task-scope
  ] task-arena-escape: "stream rejected at await" assert-error-type
] ;

\ -- 2. with-timeout rejects each arena-owned variant in its result --

test-timeout-iterator: ( -- ) [
  [
    [ [ { 1 2 3 } >iterator ] 100 milliseconds with-timeout ] task-scope
  ] task-arena-escape: "iterator rejected at with-timeout" assert-error-type
] ;

test-timeout-parameter: ( -- ) [
  [
    [ [ p: [ 42 ] make-parameter ] 100 milliseconds with-timeout ] task-scope
  ] task-arena-escape: "parameter rejected at with-timeout" assert-error-type
] ;

test-timeout-resource: ( -- ) [
  [
    [ [ "dummy" <test-resource> ] 100 milliseconds with-timeout ] task-scope
  ] task-arena-escape: "resource rejected at with-timeout" assert-error-type
] ;

test-timeout-stream: ( -- ) [
  [
    [ [ 64 <string-stream> dup stream-close ] 100 milliseconds with-timeout ] task-scope
  ] task-arena-escape: "stream rejected at with-timeout" assert-error-type
] ;

\ -- 3. await-all rejects an arena-owned result --

test-await-all-iterator: ( -- ) [
  [
    [ [ { 1 2 3 } >iterator ] spawn 1 array-n await-all ] task-scope
  ] task-arena-escape: "iterator rejected at await-all" assert-error-type
] ;

\ -- 4. Nested arena-owned values are found by the recursive walk --

test-await-nested-array: ( -- ) [
  [
    [ [ { 1 2 3 } >iterator 1 array-n ] spawn await ] task-scope
  ] task-arena-escape: "iterator inside array rejected" assert-error-type
] ;

test-await-nested-hash: ( -- ) [
  [
    [ [ H{ } it: { 1 2 3 } >iterator @set ] spawn await ] task-scope
  ] task-arena-escape: "iterator inside hash rejected" assert-error-type
] ;

test-await-nested-capture: ( -- ) [
  [
    [ [ { 1 2 3 } >iterator [ drop 7 ] curry ] spawn await ] task-scope
  ] task-arena-escape: "iterator captured in quotation rejected" assert-error-type
] ;

\ -- 5. A composite mixing a shareable and an arena-owned element is rejected before the
\ copy starts, so the already-shareable sibling is never retained and cannot leak --

test-await-mixed-share: ( -- ) [
  [
    [ [ H{ a: 1 } freeze "dummy" <test-resource> 2 array-n ] spawn await ] task-scope
  ] task-arena-escape: "shareable plus arena-owned mix rejected" assert-error-type
] ;

\ -- 6. Channel send rejects each arena-owned variant synchronously. On an
\ unbuffered channel with no receiver the value would otherwise park on the
\ waiting-senders list and the rejection would surface in the receiver --

test-send-unbuffered-iterator: ( -- ) [
  [
    [ <channel> { 1 2 3 } >iterator swap send ] task-scope
  ] task-arena-escape: "iterator rejected at unbuffered send" assert-error-type
] ;

test-send-unbuffered-parameter: ( -- ) [
  [
    [ <channel> p: [ 42 ] make-parameter swap send ] task-scope
  ] task-arena-escape: "parameter rejected at unbuffered send" assert-error-type
] ;

test-send-unbuffered-resource: ( -- ) [
  [
    [ <channel> "dummy" <test-resource> swap send ] task-scope
  ] task-arena-escape: "resource rejected at unbuffered send" assert-error-type
] ;

test-send-unbuffered-stream: ( -- ) [
  [
    [ <channel> 64 <string-stream> dup stream-close swap send ] task-scope
  ] task-arena-escape: "stream rejected at unbuffered send" assert-error-type
] ;

test-send-buffered-iterator: ( -- ) [
  [
    [ 1 <buffered-channel> { 1 2 3 } >iterator swap send ] task-scope
  ] task-arena-escape: "iterator rejected at buffered send" assert-error-type
] ;

test-send-buffered-parameter: ( -- ) [
  [
    [ 1 <buffered-channel> p: [ 42 ] make-parameter swap send ] task-scope
  ] task-arena-escape: "parameter rejected at buffered send" assert-error-type
] ;

test-send-buffered-resource: ( -- ) [
  [
    [ 1 <buffered-channel> "dummy" <test-resource> swap send ] task-scope
  ] task-arena-escape: "resource rejected at buffered send" assert-error-type
] ;

test-send-buffered-stream: ( -- ) [
  [
    [ 1 <buffered-channel> 64 <string-stream> dup stream-close swap send ] task-scope
  ] task-arena-escape: "stream rejected at buffered send" assert-error-type
] ;

test-send-nested-array: ( -- ) [
  [
    [ <channel> { 1 2 3 } >iterator 1 array-n swap send ] task-scope
  ] task-arena-escape: "iterator inside array rejected at send" assert-error-type
] ;

\ -- 7. The bug report's repro shape: a detached sender. Detached failures are
\ isolated, so the sender catches the rejection and forwards its type through
\ the channel. Before the fix the receiver got a dangling iterator that
\ collected to { } under a release build --

test-send-detached-repro: ( -- ) [
  [
    1 <buffered-channel>
    dup [
      [
        dup [ { 1 2 3 } >iterator swap send ] curry
        swap [ swap error-type: @get swap send ] curry
        recover
      ] curry spawn-detached
    ] curry task-scope
    receive
    task-arena-escape: "detached sender rejected at send" assert=
  ] task-scope
] ;

\ -- 8. The documented workaround crosses fine --

test-await-collected-iterator: ( -- ) [
  [
    [ { 1 2 3 } >iterator #collect ] spawn
    await { 1 2 3 } "collected iterator crosses as an array" assert=
  ] task-scope
] ;

test-await-iterator
test-await-parameter
test-await-resource
test-await-stream
test-timeout-iterator
test-timeout-parameter
test-timeout-resource
test-timeout-stream
test-await-all-iterator
test-await-nested-array
test-await-nested-hash
test-await-nested-capture
test-await-mixed-share
test-send-unbuffered-iterator
test-send-unbuffered-parameter
test-send-unbuffered-resource
test-send-unbuffered-stream
test-send-buffered-iterator
test-send-buffered-parameter
test-send-buffered-resource
test-send-buffered-stream
test-send-nested-array
test-send-detached-repro
test-await-collected-iterator
