\ Words that read a named local they bound. Under a compile flag a read the compiler can prove
\ pushes the bound value compiles to a copy of the parked value, and every other read keeps the
\ word interpreted. Each result is asserted, so the test passes only where the tiers agree.
\
\ The empty stderr golden is the debug allocator's leak check on the parked copies.

use "testing" ;

held: ( -- s ) [ "global" ] ;

scalar: ( a: fixnum b: fixnum -- n ) [
  zb: swap ;
  za: swap ;
  za zb + za *
] ;

literal-string: ( -- s ) [
  label: "parked" ;
  label " string" #append
] ;

typed-string: ( s: string -- s ) [
  held: swap ;
  held held #append
] ;

rebind: ( n: fixnum -- n ) [
  x: swap ;
  x: 10 ;
  x x *
] ;

chained: ( n: fixnum -- n ) [
  x: swap ;
  y: x ;
  y y +
] ;

before-bind: ( s: string -- a b ) [
  held swap
  held: swap ;
  held
] ;

arm-read: ( n: fixnum s: string -- s ) [
  s: swap ;
  n: swap ;
  n 0 > [ s ] [ "none" ] if
] ;

loop-read: ( n: fixnum s: string -- s ) [
  s: swap ;
  n: swap ;
  "" n [ s #append ] times
] ;

arm-rebind: ( n: fixnum -- n ) [
  x: swap ;
  t [ x: 5 ; 1 ] [ 0 ] if x +
] ;

untyped: ( a -- x ) [
  q: swap ;
  q
] ;

push-before: ( a: fixnum -- n ) [
  [ pb 1 + ] swap
  pb: swap ;
  call
] ;

computed-name: ( n: fixnum -- n ) [
  x: swap ;
  "x" >symbol 99 ;
  x
] ;

native-named: ( n: fixnum -- a b ) [
  dup: swap ;
  7 dup
] ;

raise-after-read: ( s: string -- ) [
  held: swap ;
  held f swap EUserThrown make-error throw
] ;

"value reads" test-section
3 4 scalar 21 "two fixnum inputs read back" assert=
literal-string "parked string" "a string literal binding reads back" assert=
"ab" typed-string "abab" "a string input read twice" assert=
3 rebind 100 "a rebind reads the latest value" assert=
5 chained 10 "a binding of a binding reads the value" assert=

"shadowing" test-section
"x" before-bind "x" "the read after the bind is the local" assert= "global" "the read before the bind is the global word" assert=

"inlined reads" test-section
1 "yes" arm-read "yes" "an if arm reads the binding" assert=
0 "yes" arm-read "none" "the other arm runs" assert=
3 "ab" loop-read "ababab" "a times body reads the binding" assert=
2 arm-rebind 3 "a binding made in an arm ends with the arm" assert=

"reads that stay interpreted" test-section
[ 42 ] untyped 42 "a quotation-valued binding is called" assert=
7 untyped 7 "a value-valued binding is pushed" assert=
9 push-before 10 "a quotation pushed before the bind reads it" assert=
3 computed-name 99 "a name computed at runtime rebinds the local" assert=
3 native-named 7 "a local named like a native leaves the native call alone" assert= 7 "the value under it" assert=

"exits after a read" test-section
[ "boom" raise-after-read ] "a raise after a read propagates" assert-error
