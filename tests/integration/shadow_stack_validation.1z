\ Test shadow stack inference through effect-transparent words

use "testing" ;

"shadow stack inference through call" test-section

apply: ( x quot: ( a -- b ) -- b ) [ call ] ;

\ Direct quotation validates correctly
10 [ 1 + ] apply 11 "direct call" assert=

\ Nested call: [ [ 1 + ] call ] has same delta as [ 1 + ]
10 [ [ 1 + ] call ] apply 11 "nested call" assert=

"shadow stack inference through dip" test-section

apply2: ( x y quot: ( a -- b ) -- b y ) [ dip ] ;

10 20 [ 1 + ] apply2 20 "dip result y" assert= 11 "dip result x" assert=

"mismatch detection through transparent words" test-section

run-effect: ( quot: ( -- ) -- ) [ call ] ;
[ [ 42 ] run-effect ] "mismatch through call" assert-error

[ 10 [ drop 1 2 ] apply ] "extra value through call" assert-error

"depth limit graceful fallback" test-section

deep-apply: ( x quot: ( a -- b ) -- b ) [ call ] ;
10 [ [ [ [ [ [ [ [ [ 1 + ] call ] call ] call ] call ] call ] call ] call ] call ] deep-apply 11 "deep nesting" assert=

"shadow stack through swap" test-section

\ Quotation pushed, swapped past a value, then called
\ Inner body: [ 1 + ] 5 swap call -- pushes quot, pushes 5, swaps so quot is on top, calls
swap-call: ( -- x ) [ [ 1 + ] 5 swap call ] ;
swap-call 6 "swap then call" assert=

\ Multiple swaps to verify correct slot tracking
swap2-call: ( -- x ) [ [ 2 + ] 10 swap swap swap call ] ;
swap2-call 12 "multiple swaps then call" assert=

"shadow stack through drop" test-section

\ Extra unknown dropped, quotation still tracked
drop-call: ( -- x ) [ [ 1 + ] 42 drop 5 swap call ] ;
drop-call 6 "drop then call" assert=

"shadow stack through over" test-section

\ over copies a known quotation slot to top, call resolves it
over-call: ( -- x x ) [ [ 1 + ] 5 over call ] ;
over-call 6 "over call result" assert= drop

"shadow stack through dip with dup" test-section

\ dup a value before dip
10 dup [ 1 + ] dip + 21 "dup dip pattern" assert=

"dip save/restore shadow slots" test-section

\ Quotation preserved through dip then called
dip-then-call: ( -- x x ) [ 5 [ 1 + ] [ dup ] dip call ] ;
dip-then-call 6 "dip then call result" assert= 5 "dip then call dup'd value" assert=

\ Quotation preserved with zero quot_delta
dip-zero-delta: ( -- x ) [ 5 [ 2 * ] [ 3 + ] dip call ] ;
dip-zero-delta 16 "dip zero delta then call" assert=

\ dip with negative quot_delta
dip-drop: ( -- x ) [ 10 20 [ drop ] dip ] ;
dip-drop 20 "dip with drop" assert=
