\ TAI (International Atomic Time) tests

use "testing" ;
use "time" ;
use "tai" ;

"tai-timestamp type" test-section

0 0 make-tai-timestamp type-name "tai-timestamp" "type-name is tai-timestamp" assert=
0 0 make-tai-timestamp tai-timestamp? t "tai-timestamp? returns true" assert=
0 0 make-tai-timestamp timestamp? f "timestamp? on tai-timestamp is false" assert=
0 0 make-timestamp tai-timestamp? f "tai-timestamp? on timestamp is false" assert=

"tai-timestamp accessors" test-section

1234567890 123456789 make-tai-timestamp tai-timestamp-sec 1234567890 "tai-timestamp-sec" assert=
1234567890 123456789 make-tai-timestamp tai-timestamp-nsec 123456789 "tai-timestamp-nsec" assert=

">tai-timestamp known offsets" test-section

\ Epoch (1970-01-01): before 1972, offset = 10
0 0 make-timestamp >tai-timestamp tai-timestamp-sec 10 "epoch: TAI sec = 10" assert=
0 0 make-timestamp >tai-timestamp tai-timestamp-nsec 0 "epoch: nsec preserved" assert=

\ 1972-07-01 (78796800): offset = 11
78796800 0 make-timestamp >tai-timestamp tai-timestamp-sec 78796811 "1972-07-01: offset 11" assert=

\ 1999-01-01 (915148800): offset = 32
915148800 0 make-timestamp >tai-timestamp tai-timestamp-sec 915148832 "1999-01-01: offset 32" assert=

\ 2000-01-01 (946684800): between 1999-01-01 and 2006-01-01, offset = 32
946684800 0 make-timestamp >tai-timestamp tai-timestamp-sec 946684832 "2000-01-01: offset 32" assert=

\ 2017-01-01 (1483228800): offset = 37
1483228800 0 make-timestamp >tai-timestamp tai-timestamp-sec 1483228837 "2017-01-01: offset 37" assert=

\ nsec preserved through conversion
100 500000000 make-timestamp >tai-timestamp tai-timestamp-nsec 500000000 "nsec preserved in >tai-timestamp" assert=

">timestamp round-trip" test-section

\ Round-trip: >tai-timestamp then >timestamp recovers original
0 0 make-timestamp >tai-timestamp >timestamp timestamp-sec 0 "round-trip epoch sec" assert=
0 0 make-timestamp >tai-timestamp >timestamp timestamp-nsec 0 "round-trip epoch nsec" assert=

78796800 0 make-timestamp >tai-timestamp >timestamp timestamp-sec 78796800 "round-trip 1972-07-01 sec" assert=

946684800 123000000 make-timestamp >tai-timestamp >timestamp timestamp-sec 946684800 "round-trip 2000-01-01 sec" assert=
946684800 123000000 make-timestamp >tai-timestamp >timestamp timestamp-nsec 123000000 "round-trip 2000-01-01 nsec" assert=

1483228800 0 make-timestamp >tai-timestamp >timestamp timestamp-sec 1483228800 "round-trip 2017-01-01 sec" assert=

"boundary cases" test-section

\ Before 1972: offset = 10
1000 0 make-timestamp >tai-timestamp tai-timestamp-sec 1010 "pre-1972: offset 10" assert=

\ Exactly at first leap second boundary (1972-01-01 = 63072000): offset = 10
63072000 0 make-timestamp >tai-timestamp tai-timestamp-sec 63072010 "at 1972-01-01: offset 10" assert=

\ Just before second boundary (1972-07-01 = 78796800): offset still 10
78796799 0 make-timestamp >tai-timestamp tai-timestamp-sec 78796809 "just before 1972-07-01: offset 10" assert=

\ Future timestamp: uses latest offset (37)
2000000000 0 make-timestamp >tai-timestamp tai-timestamp-sec 2000000037 "future: offset 37" assert=
2000000000 0 make-timestamp >tai-timestamp >timestamp timestamp-sec 2000000000 "future round-trip" assert=

"inspect" test-section

10 0 make-tai-timestamp inspect "<tai-timestamp 10 0>" "inspect format" assert=

"tai-timestamp + duration" test-section

\ Add 5 seconds to a TAI timestamp
1000 0 make-tai-timestamp 5 seconds +
dup tai-timestamp-sec 1005 "tai + 5s: sec" assert=
tai-timestamp-nsec 0 "tai + 5s: nsec" assert=

\ Add sub-second duration
1000 0 make-tai-timestamp 500000000 nanoseconds +
dup tai-timestamp-sec 1000 "tai + 500ms: sec" assert=
tai-timestamp-nsec 500000000 "tai + 500ms: nsec" assert=

\ Nsec overflow: 900ms + 200ms = +1sec, 100ms
1000 900000000 make-tai-timestamp 200000000 nanoseconds +
dup tai-timestamp-sec 1001 "tai nsec overflow: sec" assert=
tai-timestamp-nsec 100000000 "tai nsec overflow: nsec" assert=

\ Commutative: duration + tai-timestamp
5 seconds 1000 0 make-tai-timestamp +
tai-timestamp-sec 1005 "duration + tai: sec" assert=

"tai-timestamp - duration" test-section

1000 500000000 make-tai-timestamp 3 seconds -
dup tai-timestamp-sec 997 "tai - 3s: sec" assert=
tai-timestamp-nsec 500000000 "tai - 3s: nsec" assert=

\ Nsec underflow: 100ms - 200ms = -1sec, 900ms
1000 100000000 make-tai-timestamp 200000000 nanoseconds -
dup tai-timestamp-sec 999 "tai nsec underflow: sec" assert=
tai-timestamp-nsec 900000000 "tai nsec underflow: nsec" assert=

"tai-timestamp - tai-timestamp" test-section

1010 0 make-tai-timestamp 1000 0 make-tai-timestamp -
dup duration? t "tai - tai is duration" assert=
unmake-duration 10000000000 "tai - tai = 10s in nanos" assert=

1000 500000000 make-tai-timestamp 1000 200000000 make-tai-timestamp -
unmake-duration 300000000 "tai sub-second diff" assert=

"tai-timestamp comparison" test-section

1000 0 make-tai-timestamp 1000 0 make-tai-timestamp = t "equal tai-timestamps" assert=
1000 0 make-tai-timestamp 2000 0 make-tai-timestamp = f "unequal tai-timestamps" assert=
1000 500 make-tai-timestamp 1000 600 make-tai-timestamp = f "unequal nsec" assert=

1000 0 make-tai-timestamp 2000 0 make-tai-timestamp < t "tai < by sec" assert=
2000 0 make-tai-timestamp 1000 0 make-tai-timestamp < f "tai not < by sec" assert=
1000 100 make-tai-timestamp 1000 200 make-tai-timestamp < t "tai < by nsec" assert=

2000 0 make-tai-timestamp 1000 0 make-tai-timestamp > t "tai > by sec" assert=
1000 0 make-tai-timestamp 2000 0 make-tai-timestamp > f "tai not > by sec" assert=
1000 200 make-tai-timestamp 1000 100 make-tai-timestamp > t "tai > by nsec" assert=

"tai-now" test-section

tai-now tai-timestamp? t "tai-now returns tai-timestamp" assert=
tai-now tai-timestamp-sec 0 > t "tai-now sec is positive" assert=
tai-now tai-now swap >= t "consecutive tai-now is monotonic" assert=
