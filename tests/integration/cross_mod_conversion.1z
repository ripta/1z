\ Test cross-module behavior of generic >NAME conversion words.
\
\ With dispatch_id-based dispatch keys, each module's conversion words
\ dispatch independently. Qualified access (module.>name) invokes the
\ correct converter for that module's type.

use "testing" ;

\ ============================================================
\ SECTION 1: Same-named structs, same shape (structural identity)
\ ============================================================

"struct-same: qualified >point from each module" test-section

sa: "cross_mod_conv_struct_lib_a.1z" load ;
sb: "cross_mod_conv_struct_lib_b.1z" load ;

H{ x: 1 y: 2 } sa.>point sa.x>> 1 "a.>point produces correct x" assert=
H{ x: 1 y: 2 } sa.>point sa.y>> 2 "a.>point produces correct y" assert=
H{ x: 3 y: 4 } sb.>point sb.x>> 3 "b.>point produces correct x" assert=
H{ x: 3 y: 4 } sb.>point sb.y>> 4 "b.>point produces correct y" assert=

"struct-same: structural identity across modules" test-section

sa.point sb.point = t "same-shape bare struct types are equal" assert=

"struct-same: cross-module predicate acceptance" test-section

H{ x: 1 y: 2 } sa.>point sb.point? t "b.point? accepts a.>point instance" assert=
H{ x: 3 y: 4 } sb.>point sa.point? t "a.point? accepts b.>point instance" assert=

"struct-same: cross-module instance equality" test-section

H{ x: 1 y: 2 } sa.>point H{ x: 1 y: 2 } sb.>point = t "same values cross-module are equal" assert=
H{ x: 1 y: 2 } sa.>point H{ x: 1 y: 3 } sb.>point = f "different values cross-module are unequal" assert=

"struct-same: cross-module field access" test-section

H{ x: 5 y: 6 } sa.>point sb.x>> 5 "b.x>> reads a.>point instance" assert=
H{ x: 7 y: 8 } sb.>point sa.y>> 8 "a.y>> reads b.>point instance" assert=

\ ============================================================
\ SECTION 2: Same-named structs, different shape
\
\ With dispatch_id, each module's >thing has its own dispatch entries.
\ Qualified access correctly invokes the right converter.
\ ============================================================

"struct-diff: qualified access dispatches correctly" test-section

da: "cross_mod_conv_struct_diff_lib_a.1z" load ;
db: "cross_mod_conv_struct_diff_lib_b.1z" load ;

\ da.>thing uses A's converter (expects x, y fields).
H{ x: 1 y: 2 } da.>thing da.x>> 1 "a.>thing produces correct x" assert=
H{ x: 1 y: 2 } da.>thing da.y>> 2 "a.>thing produces correct y" assert=

\ db.>thing uses B's converter (expects a, b fields).
H{ a: 3 b: 4 } db.>thing db.a>> 3 "b.>thing produces correct a" assert=
H{ a: 3 b: 4 } db.>thing db.b>> 4 "b.>thing produces correct b" assert=

\ Wrong fields for the wrong module's converter throw errors.
[ H{ a: 1 b: 2 } da.>thing ] "a.>thing with b-fields throws" assert-error
[ H{ x: 1 y: 2 } db.>thing ] "b.>thing with a-fields throws" assert-error

"struct-diff: types are distinct" test-section

da.thing db.thing = f "different-shape structs are distinct types" assert=

"struct-diff: cross-module predicate rejection" test-section

H{ a: 1 b: 2 } db.>thing da.thing? f "a.thing? rejects b.>thing instance" assert=
H{ x: 1 y: 2 } da.>thing db.thing? f "b.thing? rejects a.>thing instance" assert=

"struct-diff: cross-module field access errors" test-section

[ H{ a: 1 b: 2 } db.>thing da.x>> ] "a.x>> on b.>thing instance throws" assert-error

"struct-diff: import conflict without shadow-ok" test-section

[ "use \"cross_mod_conv_struct_diff_lib_a.1z\" ; use \"cross_mod_conv_struct_diff_lib_b.1z\" ;" eval-string ]
"different-shape struct import without shadow-ok throws" assert-error

\ ============================================================
\ SECTION 3: Same-named virtual types (nominal identity)
\
\ With dispatch_id, each module's >meters dispatches independently.
\ va.>meters creates va's type; vb.>meters creates vb's type.
\ ============================================================

"virtual: qualified access dispatches correctly" test-section

va: "cross_mod_conv_virtual_lib_a.1z" load ;
vb: "cross_mod_conv_virtual_lib_b.1z" load ;

\ va.>meters creates va's type.
42 va.>meters va.meters? t "a.>meters produces a's type" assert=
42 va.>meters vb.meters? f "a.>meters does not produce b's type" assert=

\ vb.>meters creates vb's type.
99 vb.>meters vb.meters? t "b.>meters produces b's type" assert=
99 vb.>meters va.meters? f "b.>meters does not produce a's type" assert=

"virtual: nominal identity, types are distinct" test-section

va.meters vb.meters = f "same-name virtual types from different modules are distinct" assert=

"virtual: cross-module unwrap rejection" test-section

\ va.>meters creates va's type, so va.unmake-meters accepts it.
42 va.>meters va.unmake-meters 42 "a.unmake-meters accepts a.>meters" assert=
\ vb.unmake-meters rejects va's type.
[ 42 va.>meters vb.unmake-meters ] "b.unmake-meters rejects a.>meters" assert-error

"virtual: cross-module type-of" test-section

42 va.>meters type-of va.meters = t "a.>meters type-of matches a.meters" assert=
42 va.>meters type-of vb.meters = f "a.>meters type-of does not match b.meters" assert=

\ ============================================================
\ SECTION 4: Same-named enums (nominal identity)
\
\ With dispatch_id, each module's >color dispatches independently.
\ ea.>color converts using ea's enum; eb.>color uses eb's enum.
\ ============================================================

"enum: qualified access dispatches correctly" test-section

ea: "cross_mod_conv_enum_lib_a.1z" load ;
eb: "cross_mod_conv_enum_lib_b.1z" load ;

\ ea.>color creates ea's type.
red: ea.>color ea.color? t "a.>color red produces a's type" assert=
red: ea.>color eb.color? f "a.>color red does not produce b's type" assert=

\ eb.>color creates eb's type.
red: eb.>color eb.color? t "b.>color red produces b's type" assert=
red: eb.>color ea.color? f "b.>color red does not produce a's type" assert=

"enum: nominal identity, types are distinct" test-section

ea.color eb.color = f "same-name enums from different modules are distinct" assert=

"enum: module-specific variants dispatch correctly" test-section

\ green is a variant of ea only. ea.>color succeeds, eb.>color throws.
green: ea.>color ea.color? t "a.>color green works" assert=
[ green: eb.>color ] "b.>color green throws (b lacks green)" assert-error

\ blue is a variant of eb only. eb.>color succeeds, ea.>color throws.
blue: eb.>color eb.color? t "b.>color blue works" assert=
[ blue: ea.>color ] "a.>color blue throws (a lacks blue)" assert-error

"enum: variant predicates remain module-scoped" test-section

red: eb.>color eb.color:red? t "b.color:red? on b.>color red is true" assert=
red: eb.>color ea.color:red? f "a.color:red? rejects b.>color red" assert=

\ ============================================================
\ SECTION 5: Single import works correctly
\
\ Importing a single module's words gives correct dispatch.
\ Loading a second module later does not retroactively affect
\ the imported words' dispatch entries.
\ ============================================================

"single-import: struct >point works" test-section

use "cross_mod_conv_struct_lib_a.1z" ;

H{ x: 10 y: 20 } >point x>> 10 "imported >point produces correct x" assert=
H{ x: 10 y: 20 } >point point? t "imported point? works" assert=

"single-import: virtual >meters dispatches correctly" test-section

use "cross_mod_conv_virtual_lib_a.1z" ;

\ >meters was imported from va. Despite vb being loaded in section 3,
\ the imported >meters retains va's dispatch_id.
55 >meters va.meters? t "imported >meters creates va type" assert=
55 >meters vb.meters? f "imported >meters does not create vb type" assert=

"single-import: enum >color dispatches correctly" test-section

use "cross_mod_conv_enum_lib_a.1z" ;

\ >color was imported from ea. Despite eb being loaded in section 4,
\ the imported >color retains ea's dispatch_id.
red: >color ea.color? t "imported >color creates ea type" assert=
red: >color eb.color? f "imported >color does not create eb type" assert=

\ ============================================================
\ SECTION 6: method{ extension on imported >NAME
\ ============================================================

"method-ext: extend >point with fixnum input" test-section

\ Extend >point to accept a fixnum, creating a point where x=y=n
>point: method{ fixnum } [
  dup make-point
] ;

5 >point x>> 5 "method{ fixnum } >point sets x" assert=
5 >point y>> 5 "method{ fixnum } >point sets y" assert=
H{ x: 1 y: 2 } >point x>> 1 "hash >point still works after extension" assert=
5 >point point? t "fixnum-created >point passes predicate" assert=

\ ============================================================
\ SECTION 7: method{ with qualified names (syntax probes)
\ ============================================================

"method-qual: qualified type name in method{ fails" test-section

\ method{ does not support dot-qualified type names.
\ Type resolution uses lookupTypeValueByName which only searches bare names.
[ "ea: \"cross_mod_conv_enum_lib_a.1z\" load ; inspect: method{ ea.color } [ \"from-a\" ] ;" eval-string ]
"method{ ea.color } fails — qualified types not supported" assert-error

"method-qual: qualified word name in method{ fails" test-section

\ Registering a dispatch entry with a qualified word name also fails.
[ "ea: \"cross_mod_conv_enum_lib_a.1z\" load ; ea.>color: method{ string } [ drop red: ea.>color ] ;" eval-string ]
"ea.>color: method{ ... } fails — qualified word names not supported" assert-error

\ ============================================================
\ SECTION 8: make-NAME dispatches correctly per module
\
\ make-NAME for simple virtuals is also defined via defineWrap,
\ which registers dispatch. With dispatch_id, each module's
\ make-NAME dispatches independently.
\ ============================================================

"make-name: qualified make-meters dispatches correctly" test-section

\ va and vb are already loaded from section 3.
42 va.make-meters va.meters? t "va.make-meters creates va type" assert=
42 va.make-meters vb.meters? f "va.make-meters does not create vb type" assert=
42 vb.make-meters vb.meters? t "vb.make-meters creates vb type" assert=
42 vb.make-meters va.meters? f "vb.make-meters does not create va type" assert=

\ ============================================================
\ SECTION 9: Double-import const conflicts
\ ============================================================

"double-import: struct same-shape hits const redefine" test-section

[ "use \"cross_mod_conv_struct_lib_b.1z\" shadow-ok ;" eval-string ]
"second same-name struct import hits const redefine" assert-error

"double-import: virtual hits const redefine" test-section

[ "use \"cross_mod_conv_virtual_lib_b.1z\" shadow-ok ;" eval-string ]
"second same-name virtual import hits const redefine" assert-error

"double-import: enum hits const redefine" test-section

[ "use \"cross_mod_conv_enum_lib_b.1z\" shadow-ok ;" eval-string ]
"second same-name enum import hits const redefine" assert-error
