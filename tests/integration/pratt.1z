use "testing" ;
use "lexer" ;
use "scanner" ;
use "pratt" ;
use "conversions" ;
use "char" ;

\ --- Test infrastructure ---

TEST-LEXER: const [
  V{ }
  skip-whitespace-rule #push!
  number-rule #push!
  { "+" "-" "*" "/" "^" "(" ")" } symbols-rule #push!
  >array <lexer>
] ;

TEST-OPS: const [
  H{
    "+" H{ left-bp: 10 right-bp: 11 }
    "-" H{ left-bp: 10 right-bp: 11 }
    "*" H{ left-bp: 20 right-bp: 21 }
    "/" H{ left-bp: 20 right-bp: 21 }
    "^" H{ left-bp: 30 right-bp: 30 }
  }
] ;

\ Integer exponentiation helper
(ipow): stack-recursive ( base exp -- result ) [
  dup 0 = [ 2drop 1 ] [
    dup 1 = [ drop ] [
      1 - over swap (ipow) *
    ] if
  ] if
] ;

\ --- Eval handlers ---

(eval-prefix): ( token parser tokens -- value ) [
  <rot-
  \ parser tokens token
  dup kind>> number: = [
    value>> parse-integer nip nip
  ] [
    dup value>> "(" = [
      drop
      \ parser tokens
      2dup swap 0 parse-pratt
      \ parser tokens value
      [ next-token drop ] dip nip
    ] [
      nip nip
      dup value>> swap pos>>
      "expected expression, got '" <rot-
      #append "' at byte " #append
      swap >string #append
      f swap EInvalidArgument make-error throw
    ] if
  ] if
] ;

(eval-infix): ( left token parser tokens -- value ) [
  parse-right
  \ left token right
  swap value>>
  dup "+" = [ drop + ] [
    dup "-" = [ drop - ] [
      dup "*" = [ drop * ] [
        dup "/" = [ drop / ] [
          dup "^" = [ drop (ipow) ] [
            "unknown operator: " swap #append
            f swap EInvalidArgument make-error throw
          ] if
        ] if
      ] if
    ] if
  ] if
] ;

EVAL-PARSER: const [
  H{
    operators: TEST-OPS
    prefix:    [ (eval-prefix) ]
    infix:     [ (eval-infix) ]
  } <pratt>
] ;

(eval): ( str -- value ) [
  TEST-LEXER tokenize EVAL-PARSER parse-expr
] ;

\ --- AST handlers ---

(ast-prefix): ( token parser tokens -- value ) [
  <rot-
  \ parser tokens token
  dup kind>> number: = [
    value>> parse-integer nip nip
  ] [
    dup value>> "(" = [
      drop
      \ parser tokens
      2dup swap 0 parse-pratt
      \ parser tokens value
      [ next-token drop ] dip nip
    ] [
      nip nip
      dup value>> swap pos>>
      "expected expression, got '" <rot-
      #append "' at byte " #append
      swap >string #append
      f swap EInvalidArgument make-error throw
    ] if
  ] if
] ;

(ast-infix): ( left token parser tokens -- value ) [
  parse-right
  \ left token right
  swap value>> swap
  \ left op-str right
  3 array-n
] ;

AST-PARSER: const [
  H{
    operators: TEST-OPS
    prefix:    [ (ast-prefix) ]
    infix:     [ (ast-infix) ]
  } <pratt>
] ;

(ast): ( str -- value ) [
  TEST-LEXER tokenize AST-PARSER parse-expr
] ;

\ ===== Eval tests =====

"eval: single number" test-section
"42" (eval) 42 "42 parses to 42" assert=
"0" (eval) 0 "0 parses to 0" assert=

"eval: addition" test-section
"1 + 2" (eval) 3 "1 + 2 = 3" assert=

"eval: subtraction" test-section
"5 - 3" (eval) 2 "5 - 3 = 2" assert=

"eval: multiplication" test-section
"3 * 4" (eval) 12 "3 * 4 = 12" assert=

"eval: division" test-section
"10 / 2" (eval) 5 "10 / 2 = 5" assert=

"eval: precedence" test-section
"1 + 2 * 3" (eval) 7 "1 + 2 * 3 = 7" assert=
"2 * 3 + 1" (eval) 7 "2 * 3 + 1 = 7" assert=

"eval: left associativity" test-section
"10 - 3 - 2" (eval) 5 "10 - 3 - 2 = 5 (left-assoc)" assert=
"20 / 4 / 5" (eval) 1 "20 / 4 / 5 = 1 (left-assoc)" assert=

"eval: right associativity" test-section
"2 ^ 3 ^ 2" (eval) 512 "2 ^ 3 ^ 2 = 512 (right-assoc: 2^(3^2))" assert=
"2 ^ 3" (eval) 8 "2 ^ 3 = 8" assert=

"eval: parentheses" test-section
"(1 + 2) * 3" (eval) 9 "(1 + 2) * 3 = 9" assert=
"2 * (3 + 4)" (eval) 14 "2 * (3 + 4) = 14" assert=

"eval: nested parentheses" test-section
"((1 + 2))" (eval) 3 "((1 + 2)) = 3" assert=
"((2))" (eval) 2 "((2)) = 2" assert=

"eval: complex expression" test-section
"(1 + 2) * (3 + 4)" (eval) 21 "(1 + 2) * (3 + 4) = 21" assert=

\ ===== AST tests =====

"ast: single number" test-section
"42" (ast) 42 "atom is just a number" assert=

"ast: binary op" test-section
"1 + 2" (ast)
dup 0 #nth 1 "ast left is 1" assert=
dup 1 #nth "+" "ast op is +" assert=
2 #nth 2 "ast right is 2" assert=

"ast: precedence tree" test-section
"1 + 2 * 3" (ast)
dup 0 #nth 1 "top left is 1" assert=
dup 1 #nth "+" "top op is +" assert=
2 #nth
dup 0 #nth 2 "nested left is 2" assert=
dup 1 #nth "*" "nested op is *" assert=
2 #nth 3 "nested right is 3" assert=

"ast: left associativity" test-section
"1 - 2 - 3" (ast)
dup 0 #nth
dup 0 #nth 1 "inner left is 1" assert=
dup 1 #nth "-" "inner op is -" assert=
2 #nth 2 "inner right is 2" assert=
dup 1 #nth "-" "outer op is -" assert=
2 #nth 3 "outer right is 3" assert=

\ ===== Error tests =====

"error: empty input" test-section
[ "" (eval) ] "empty input throws" assert-error

"error: message content" test-section
[ "+" (eval) ] [ ] recover
message: @get
dup "expected expression" #in? "error mentions expected expression" assert-true
"byte" #in? "error mentions byte position" assert-true
