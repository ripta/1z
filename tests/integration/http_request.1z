use "testing" ;
use "net/http" ;
use "net" ;
use "net/tcp" ;
use "net/server" ;
use "time" ;

\ Build a request carrying only the fields negotiation reads (version, headers);
\ the remaining fields ride sentinel defaults.
mk-req: ( version headers -- request ) [
  [ "GET" "/" "" ] 2dip
  B{ } "" 0 "" 0 f "" ""
  make-request
] ;

make-http-server-once-task: ( host port handler -- task ) [
  [ swap dup -rot> dup read-request <rot- call stream-close ] curry
  <server-config> swap >>handler swap >>port swap >>host
  [
    dup start-server
    swap handler>>
    over accept drop
    swap call
    close
  ] curry spawn
] ;

"read-request: simple GET" test-section
<pipe> dup "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
stream-close
read-request
dup method>> "GET" "method" assert=
dup path>> "/" "path" assert=
dup version>> "HTTP/1.1" "version" assert=
headers>> "host" @get "localhost" "host header" assert=

"read-request: multiple headers" test-section
<pipe> dup "GET /index.html HTTP/1.1\r\nHost: example.com\r\nContent-Type: text/html\r\nX-Custom: hello world\r\n\r\n" stream-write drop
stream-close
read-request
dup method>> "GET" "method" assert=
dup path>> "/index.html" "path" assert=
dup headers>> "host" @get "example.com" "host header" assert=
dup headers>> "content-type" @get "text/html" "content-type lowercase" assert=
headers>> "x-custom" @get "hello world" "custom header" assert=

"read-request: POST method" test-section
<pipe> dup "POST /submit HTTP/1.0\r\nHost: localhost\r\nContent-Length: 0\r\n\r\n" stream-write drop
stream-close
read-request
dup method>> "POST" "POST method" assert=
dup path>> "/submit" "POST path" assert=
dup version>> "HTTP/1.0" "POST version" assert=
headers>> "content-length" @get "0" "content-length header" assert=

"read-request: no headers" test-section
<pipe> dup "GET / HTTP/1.1\r\n\r\n" stream-write drop
stream-close
read-request
dup method>> "GET" "no-headers method" assert=
headers>> @keys #len 0 "no headers count" assert=

"read-request: no query string" test-section
<pipe> dup "GET /path HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
stream-close
read-request
dup path>> "/path" "no-query path" assert=
query-string>> "" "no-query empty string" assert=

"read-request: non-empty query string" test-section
<pipe> dup "GET /path?a=1&b=2 HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
stream-close
read-request
dup path>> "/path" "non-empty-query path" assert=
query-string>> "a=1&b=2" "non-empty query string" assert=

"read-request: empty query string" test-section
<pipe> dup "GET /path? HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
stream-close
read-request
dup path>> "/path" "empty-query path" assert=
query-string>> "" "empty query string" assert=

"read-request: EOF throws EUnexpectedEOF" test-section
[ <pipe> stream-close read-request ] unexpected-eof: "EOF on empty stream" assert-error-type

"read-request: malformed request line throws EMalformedRequest" test-section
[ <pipe> dup "GET /\r\n\r\n" stream-write drop stream-close read-request ] malformed-request: "too few parts" assert-error-type

"read-request-line?: clean close yields option:none" test-section
<pipe> stream-close (read-request-line?) option:none? "closed stream is a clean close" assert-true

"read-request-line?: request line yields option:some" test-section
<pipe> dup "GET / HTTP/1.1\r\n" stream-write drop stream-close (read-request-line?)
dup option:some? "a present request line is some" assert-true
option:some> "GET / HTTP/1.1" "some wraps the request line" assert=

"read-request-line?: mid-request truncation is some, not a clean close" test-section
<pipe> dup "GET /foo\r\n" stream-write drop stream-close (read-request-line?)
option:some? "a truncated request line is a request to parse, not a clean close" assert-true

"read-request-line?: mid-request truncation keeps the throwing parse" test-section
[ <pipe> dup "GET /foo\r\n" stream-write drop stream-close (read-request-wire) ] malformed-request: "truncated request line still throws when parsed" assert-error-type

"make-request: socket-derived fields round-trip" test-section
"GET" "/" "" "HTTP/1.1" H{ } B{ }
"192.0.2.1" 54321 "example.com" 8443 t "TLSv1.3" "TLS_AES_128_GCM_SHA256"
make-request
dup remote-addr>> "192.0.2.1" "remote-addr round-trip" assert=
dup remote-port>> 54321 "remote-port round-trip" assert=
dup server-name>> "example.com" "server-name round-trip" assert=
dup server-port>> 8443 "server-port round-trip" assert=
dup is-tls?>> t "is-tls? round-trip" assert=
dup tls-version>> "TLSv1.3" "tls-version round-trip" assert=
tls-cipher>> "TLS_AES_128_GCM_SHA256" "tls-cipher round-trip" assert=

"read-request: socket-derived fields use sentinel defaults" test-section
<pipe> dup "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
stream-close
read-request
dup remote-addr>> "" "sentinel remote-addr" assert=
dup remote-port>> 0 "sentinel remote-port" assert=
dup server-name>> "" "sentinel server-name" assert=
dup server-port>> 0 "sentinel server-port" assert=
dup is-tls?>> f "sentinel is-tls?" assert=
dup tls-version>> "" "sentinel tls-version" assert=
tls-cipher>> "" "sentinel tls-cipher" assert=

"read-form: empty body" test-section
"" >bytes read-form
@keys #len 0 "empty body has no entries" assert=

"read-form: single pair" test-section
"name=alice" >bytes read-form
"name" @get { "alice" } "single pair value" assert=

"read-form: multiple pairs" test-section
"a=1&b=2&c=3" >bytes read-form
dup "a" @get { "1" } "first pair" assert=
dup "b" @get { "2" } "second pair" assert=
"c" @get { "3" } "third pair" assert=

"read-form: percent-decoded key" test-section
"na%6De=alice" >bytes read-form
"name" @get { "alice" } "percent-decoded key" assert=

"read-form: percent-decoded value" test-section
"name=al%69ce" >bytes read-form
"name" @get { "alice" } "percent-decoded value" assert=

"read-form: + decodes to space" test-section
"q=hello+world" >bytes read-form
"q" @get { "hello world" } "+ decodes to space" assert=

"read-form: %2B decodes to literal +" test-section
"q=a%2Bb" >bytes read-form
"q" @get { "a+b" } "%2B decodes to literal +" assert=

"read-form: repeated keys accumulate" test-section
"tag=a&tag=b" >bytes read-form
"tag" @get { "a" "b" } "repeated key collects values in order" assert=

"read-form: bare key has empty value" test-section
"flag" >bytes read-form
dup "flag" @get { "" } "bare key value" assert=
@keys #len 1 "bare key creates one entry" assert=

"read-form: stray ampersand skipped" test-section
"a=1&&b=2" >bytes read-form
dup @keys #len 2 "stray & does not create empty entry" assert=
dup "a" @get { "1" } "stray & a entry" assert=
"b" @get { "2" } "stray & b entry" assert=

"read-form: malformed percent throws EInvalidArgument" test-section
[ "a=%" >bytes read-form ] invalid-argument: "malformed % throws" assert-error-type

"read-request: eagerly attaches the body" test-section
<pipe> dup "POST /submit HTTP/1.1\r\nContent-Length: 10\r\n\r\nname=alice" stream-write drop
stream-close
read-request
dup method>> "POST" "attached-body method" assert=
body>> read-form "name" @get { "alice" } "attached body decodes" assert=

"read-request: missing content-length yields empty body" test-section
<pipe> dup "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
stream-close
read-request
body>> #len 0 "missing content-length has empty body" assert=

"read-request: eager body read leaves stream at next request" test-section
<pipe> dup "POST /a HTTP/1.1\r\nContent-Length: 10\r\n\r\nname=aliceGET /b HTTP/1.1\r\nHost: x\r\n\r\n" stream-write drop
stream-close
dup read-request
dup path>> "/a" "first request path" assert=
body>> read-form "name" @get { "alice" } "first body decodes" assert=
read-request
path>> "/b" "second request parses after first body consumed" assert=

"read-request: truncated body throws EUnexpectedEOF" test-section
[ <pipe> dup "POST / HTTP/1.1\r\nContent-Length: 10\r\n\r\nabc" stream-write drop stream-close read-request ] unexpected-eof: "truncated body throws" assert-error-type

"max-request-body: within default cap is not too large" test-section
H{ "content-length" "50" } (body-too-large?) f "50 bytes under default cap" assert=

"max-request-body: missing content-length is not too large" test-section
H{ } (body-too-large?) f "missing content-length not too large" assert=

"max-request-body: over a bound cap is too large" test-section
5 [ H{ "content-length" "50" } (body-too-large?) ] with-max-request-body
t "50 bytes over a 5-byte bound cap" assert=

"max-request-body: equal to the cap is not too large" test-section
50 [ H{ "content-length" "50" } (body-too-large?) ] with-max-request-body
f "50 bytes equal to a 50-byte cap is allowed" assert=

"chunked-request?: plain chunked is chunked" test-section
H{ "transfer-encoding" "chunked" } (chunked-request?) t "chunked value is chunked" assert=

"chunked-request?: multi-token list with chunked" test-section
H{ "transfer-encoding" "gzip, chunked" } (chunked-request?) t "gzip, chunked is chunked" assert=

"chunked-request?: case-insensitive" test-section
H{ "transfer-encoding" "Chunked" } (chunked-request?) t "uppercase Chunked is chunked" assert=

"chunked-request?: absent header is not chunked" test-section
H{ } (chunked-request?) f "missing transfer-encoding not chunked" assert=

"chunked-request?: non-chunked encoding is not chunked" test-section
H{ "transfer-encoding" "gzip" } (chunked-request?) f "gzip alone not chunked" assert=

"negotiate-keep-alive?: HTTP/1.1 defaults to keep-alive" test-section
"HTTP/1.1" H{ } mk-req (negotiate-keep-alive?) t "1.1 with no Connection header keeps alive" assert=

"negotiate-keep-alive?: HTTP/1.1 Connection: close closes" test-section
"HTTP/1.1" H{ "connection" "close" } mk-req (negotiate-keep-alive?) f "1.1 close closes" assert=

"negotiate-keep-alive?: HTTP/1.0 defaults to close" test-section
"HTTP/1.0" H{ } mk-req (negotiate-keep-alive?) f "1.0 with no Connection header closes" assert=

"negotiate-keep-alive?: HTTP/1.0 Connection: keep-alive persists" test-section
"HTTP/1.0" H{ "connection" "keep-alive" } mk-req (negotiate-keep-alive?) t "1.0 keep-alive persists" assert=

"negotiate-keep-alive?: HTTP/1.0 Connection: close closes" test-section
"HTTP/1.0" H{ "connection" "close" } mk-req (negotiate-keep-alive?) f "close wins on 1.0" assert=

"negotiate-keep-alive?: unknown version closes" test-section
"HTTP/0.9" H{ } mk-req (negotiate-keep-alive?) f "unknown version closes" assert=

"negotiate-keep-alive?: case-insensitive close on 1.1" test-section
"HTTP/1.1" H{ "connection" "Close" } mk-req (negotiate-keep-alive?) f "uppercase Close closes" assert=

"negotiate-keep-alive?: case-insensitive keep-alive on 1.0" test-section
"HTTP/1.0" H{ "connection" "Keep-Alive" } mk-req (negotiate-keep-alive?) t "mixed-case Keep-Alive persists" assert=

"negotiate-keep-alive?: multi-token keep-alive on 1.0" test-section
"HTTP/1.0" H{ "connection" "keep-alive, foo" } mk-req (negotiate-keep-alive?) t "multi-token keep-alive persists" assert=

"length-required: builds a 411 response" test-section
length-required dup status>> 411 "411 status" assert=
reason>> "Length Required" "411 reason" assert=

"reason-for: known status code" test-section
200 reason-for "OK" "200 reason" assert=
404 reason-for "Not Found" "404 reason" assert=
500 reason-for "Internal Server Error" "500 reason" assert=

"reason-for: unknown status code" test-section
999 reason-for "Unknown" "unknown reason" assert=

"send-response: simple 200" test-section
<pipe> dup
200 "OK" "text/plain; charset=utf-8" "hello" <response>
send-response
stream-close
dup stream-read-line "HTTP/1.1 200 OK" "status line" assert=
dup stream-read-line "Connection: close" "connection header" assert=
dup stream-read-line "Content-Length: 5" "content-length" assert=
dup stream-read-line "content-type: text/plain; charset=utf-8" "content-type header" assert=
dup stream-read-line "" "blank line" assert=
stream-read-line "hello" "body" assert=

"ok: convenience constructor" test-section
<pipe> dup
"world" "text/html; charset=utf-8" ok send-response
stream-close
dup stream-read-line "HTTP/1.1 200 OK" "ok status line" assert=
dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
dup stream-read-line "" "ok blank line" assert=
stream-read-line "world" "ok body" assert=

"not-found: convenience constructor" test-section
<pipe> dup
not-found send-response
stream-close
dup stream-read-line "HTTP/1.1 404 Not Found" "404 status line" assert=
dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
dup stream-read-line "" "404 blank line" assert=
stream-read-line "404 Not Found" "404 body" assert=

"method-not-allowed: convenience constructor" test-section
<pipe> dup
method-not-allowed send-response
stream-close
stream-read-line "HTTP/1.1 405 Method Not Allowed" "405 status line" assert=

"content-too-large: builds a 413 response" test-section
content-too-large dup status>> 413 "413 status" assert=
reason>> "Content Too Large" "413 reason" assert=

"error-response: convenience constructor" test-section
<pipe> dup
500 "Internal Server Error" "something broke" error-response send-response
stream-close
dup stream-read-line "HTTP/1.1 500 Internal Server Error" "500 status line" assert=
dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
dup stream-read-line "" "500 blank line" assert=
stream-read-line "something broke" "500 body" assert=

"send-response: empty body" test-section
<pipe> dup
200 "OK" "text/plain" "" <response> send-response
stream-close
dup stream-read-line "HTTP/1.1 200 OK" "empty body status" assert=
dup stream-read-line "Connection: close" "empty body connection" assert=
stream-read-line "Content-Length: 0" "empty body content-length" assert=

"serve: handler wrapping via TCP" test-section
[
  39485
  dup "127.0.0.1" swap make-addr:tcp 128 listen

  dup [
    accept drop
    dup read-request
    path>> "text/plain; charset=utf-8" ok
    over -rot> send-response
    stream-close
  ] curry spawn

  "127.0.0.1" 3 pick-n make-addr:tcp connect
  dup "GET /hello HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "serve handler status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "serve handler blank" assert=
  stream-read-line "/hello" "serve handler body" assert=

  await drop
  swap drop
  close
] task-scope

"serve: handler receives parsed POST request" test-section
[
  39486
  dup "127.0.0.1" swap make-addr:tcp 128 listen

  dup [
    accept drop
    dup read-request
    method>> "text/plain; charset=utf-8" ok
    over -rot> send-response
    stream-close
  ] curry spawn

  "127.0.0.1" 3 pick-n make-addr:tcp connect
  dup "POST /submit HTTP/1.0\r\nHost: test\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "POST handler status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "POST handler blank" assert=
  stream-read-line "POST" "POST handler body is method" assert=

  await drop
  swap drop
  close
] task-scope

"serve: config construction" test-section
"127.0.0.1" 9999 [ drop drop ]
[ swap dup -rot> dup read-request <rot- call stream-close ] curry
<server-config> swap >>handler swap >>port swap >>host
dup host>> "127.0.0.1" "serve config host" assert=
port>> 9999 "serve config port" assert=

"serve: end-to-end GET" test-section
[
  "127.0.0.1" 39490 [
    path>> "text/plain; charset=utf-8" ok send-response
  ] make-http-server-once-task
  100 milliseconds sleep
  "127.0.0.1" 39490 make-addr:tcp connect
  dup "GET /test-path HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "serve e2e status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "serve e2e blank" assert=
  stream-read-line "/test-path" "serve e2e body" assert=
  await drop
] task-scope

"serve: server continues after malformed request" test-section
[
  "127.0.0.1" 39491 make-addr:tcp 128 listen
  dup [
    accept drop
    stream-close
  ] curry spawn
  100 milliseconds sleep
  "127.0.0.1" 39491 make-addr:tcp connect
  dup "GARBAGE\r\n\r\n" stream-write drop
  stream-close
  await drop
  close

  "127.0.0.1" 39491 [
    path>> "text/plain; charset=utf-8" ok send-response
  ] make-http-server-once-task
  100 milliseconds sleep
  "127.0.0.1" 39491 make-addr:tcp connect
  dup "GET /recovered HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "serve recovery status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "serve recovery blank" assert=
  stream-read-line "/recovered" "serve recovery body" assert=
  await drop
] task-scope

"serve: concurrent connections" test-section
"flaky under build runner" skip

"serve: handler exception recovery" test-section
[
  "127.0.0.1" 39493 make-addr:tcp 128 listen
  dup [
    accept drop
    [ dup read-request
      dup path>> "/crash" =
      [ drop "deliberate error" throw ]
      [ path>> "text/plain; charset=utf-8" ok over -rot> send-response stream-close ]
      if
    ] [ drop ] recover
  ] curry spawn
  100 milliseconds sleep
  "127.0.0.1" 39493 make-addr:tcp connect
  dup "GET /crash HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  stream-close
  await drop
  close

  "127.0.0.1" 39493 [
    dup path>> "/crash" =
    [ drop "deliberate error" throw ]
    [ path>> "text/plain; charset=utf-8" ok send-response ]
    if
  ] make-http-server-once-task
  100 milliseconds sleep
  "127.0.0.1" 39493 make-addr:tcp connect
  dup "GET /ok HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "after-crash status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "after-crash blank" assert=
  stream-read-line "/ok" "after-crash body" assert=
  await drop
] task-scope

\ TODO: extend with a TLS-wrapped variant once server TLS lands so
\ is-tls? / tls-version / tls-cipher are exercised against a real handshake
\ instead of sentinels.
"serve: socket-derived fields populated under plaintext" test-section
[
  39495
  dup "127.0.0.1" swap make-addr:tcp 128 listen

  dup [
    accept
    "127.0.0.1" 39495 [
      dup remote-addr>> "127.0.0.1" "remote-addr populated from peer" assert=
      dup remote-port>> 0 > "remote-port positive" assert-true
      dup server-name>> "127.0.0.1" "server-name from config" assert=
      dup server-port>> 39495 "server-port from config" assert=
      dup is-tls?>> f "is-tls? sentinel under plaintext" assert=
      dup tls-version>> "" "tls-version sentinel under plaintext" assert=
      dup tls-cipher>> "" "tls-cipher sentinel under plaintext" assert=
      drop
      "populated" "text/plain; charset=utf-8" ok send-response
    ] (serve-dispatch)
  ] curry spawn

  "127.0.0.1" 3 pick-n make-addr:tcp connect
  dup "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "populated-fields status" assert=
  \ Drain the full response before closing so the server's persistent-connection
  \ loop reads a clean EOF at the next request boundary rather than a reset.
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line drop
  dup 9 stream-read(exact) drop
  stream-close

  await drop
  swap drop
  close
] task-scope

"serve: oversized request body gets 413" test-section
[
  39496
  dup "127.0.0.1" swap make-addr:tcp 128 listen

  \ Bind a tiny cap around spawn so the connection task snapshots it.
  5 [
    dup [
      accept
      "127.0.0.1" 39496 [
        drop "should-not-run" "text/plain; charset=utf-8" ok send-response
      ] (serve-dispatch)
    ] curry spawn
  ] with-max-request-body

  "127.0.0.1" 3 pick-n make-addr:tcp connect
  dup "POST / HTTP/1.1\r\nContent-Length: 20\r\n\r\naaaaaaaaaaaaaaaaaaaa" stream-write drop
  dup stream-read-line "HTTP/1.1 413 Content Too Large" "oversized body gets 413" assert=
  stream-close

  await drop
  swap drop
  close
] task-scope

"serve: request body within cap dispatches to handler" test-section
[
  39497
  dup "127.0.0.1" swap make-addr:tcp 128 listen

  dup [
    accept
    "127.0.0.1" 39497 [
      body>> read-form "name" @get #first "text/plain; charset=utf-8" ok send-response
    ] (serve-dispatch)
  ] curry spawn

  "127.0.0.1" 3 pick-n make-addr:tcp connect
  dup "POST / HTTP/1.1\r\nContent-Length: 10\r\n\r\nname=alice" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "within cap status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "within cap blank" assert=
  dup 5 stream-read(exact) bytes> "alice" "within cap body echoes name" assert=
  stream-close

  await drop
  swap drop
  close
] task-scope

"serve: chunked request gets 411" test-section
[
  39498
  dup "127.0.0.1" swap make-addr:tcp 128 listen

  dup [
    accept
    "127.0.0.1" 39498 [
      drop "should-not-run" "text/plain; charset=utf-8" ok send-response
    ] (serve-dispatch)
  ] curry spawn

  "127.0.0.1" 3 pick-n make-addr:tcp connect
  dup "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 411 Length Required" "chunked request gets 411" assert=
  stream-close

  await drop
  swap drop
  close
] task-scope

"serve-connection: two requests on one connection" test-section
[
  39499
  dup "127.0.0.1" swap make-addr:tcp 128 listen

  dup [
    accept
    "127.0.0.1" 39499 [
      path>> "text/plain; charset=utf-8" ok send-response
    ] (serve-dispatch)
  ] curry spawn

  "127.0.0.1" 3 pick-n make-addr:tcp connect
  dup "GET /one HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "first status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "first blank" assert=
  dup 4 stream-read(exact) bytes> "/one" "first body" assert=

  dup "GET /two HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "second status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "second blank" assert=
  dup 4 stream-read(exact) bytes> "/two" "second body" assert=

  stream-close

  await drop
  swap drop
  close
] task-scope

"send-response: default disposition outside the server is close" test-section
<pipe> dup 200 "OK" "text/plain; charset=utf-8" "hi" <response> send-response stream-close
dup stream-read-line drop
stream-read-line "Connection: close" "unbound default closes" assert=

"send-response: keep-alive cell emits keep-alive" test-section
t (make-disposition-cell) connection-disposition [
  <pipe> dup 200 "OK" "text/plain; charset=utf-8" "hi" <response> send-response stream-close
  dup stream-read-line drop
  stream-read-line "Connection: keep-alive" "keep-alive cell" assert=
] with-parameter

"send-response: close cell emits close" test-section
f (make-disposition-cell) connection-disposition [
  <pipe> dup 200 "OK" "text/plain; charset=utf-8" "hi" <response> send-response stream-close
  dup stream-read-line drop
  stream-read-line "Connection: close" "close cell" assert=
] with-parameter

"disable-keep-alive: flips the cell and emits close" test-section
t (make-disposition-cell) connection-disposition [
  disable-keep-alive
  (read-disposition) f "cell flipped to close" assert=
  <pipe> dup 200 "OK" "text/plain; charset=utf-8" "hi" <response> send-response stream-close
  dup stream-read-line drop
  stream-read-line "Connection: close" "close emitted after disable" assert=
] with-parameter

"send-response: response Connection: close header forces close" test-section
t (make-disposition-cell) connection-disposition [
  <pipe> dup
  200 dup reason-for
  H{ "content-type" "text/plain; charset=utf-8" "connection" "close" } "body" make-response
  send-response stream-close
  dup stream-read-line drop
  dup stream-read-line "Connection: close" "header forces close" assert=
  dup stream-read-line drop
  dup stream-read-line "content-type: text/plain; charset=utf-8" "content-type present" assert=
  stream-read-line "" "no duplicate connection header" assert=
  (read-disposition) f "header flipped the cell" assert=
] with-parameter

"serve-connection: handler disable-keep-alive closes the connection" test-section
[
  39501
  dup "127.0.0.1" swap make-addr:tcp 128 listen

  dup [
    accept
    "127.0.0.1" 39501 [
      disable-keep-alive
      path>> "text/plain; charset=utf-8" ok send-response
    ] (serve-dispatch)
  ] curry spawn

  "127.0.0.1" 3 pick-n make-addr:tcp connect
  dup "GET /one HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "forced-close status" assert=
  dup stream-read-line "Connection: close" "forced-close header" assert=
  dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "forced-close blank" assert=
  dup 4 stream-read(exact) bytes> "/one" "forced-close body" assert=
  dup stream-read-line f "connection closed after forced close" assert=

  stream-close
  await drop
  swap drop
  close
] task-scope
