use "testing" ;
use "net/http" ;
use "net" ;
use "net/tcp" ;
use "net/server" ;
use "time" ;

make-http-server-once-task: ( host port handler -- task ) [
  [ swap dup -rot> dup read-request <rot- call stream-close ] curry
  <server-config> swap >>handler swap >>port swap >>host
  [
    dup start-server
    swap handler>>
    over accept drop
    swap call
    close
  ] curry spawn
] ;

"read-request: simple GET" test-section
<pipe> dup "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
stream-close
read-request
dup method>> "GET" "method" assert=
dup path>> "/" "path" assert=
dup version>> "HTTP/1.1" "version" assert=
headers>> "host" @get "localhost" "host header" assert=

"read-request: multiple headers" test-section
<pipe> dup "GET /index.html HTTP/1.1\r\nHost: example.com\r\nContent-Type: text/html\r\nX-Custom: hello world\r\n\r\n" stream-write drop
stream-close
read-request
dup method>> "GET" "method" assert=
dup path>> "/index.html" "path" assert=
dup headers>> "host" @get "example.com" "host header" assert=
dup headers>> "content-type" @get "text/html" "content-type lowercase" assert=
headers>> "x-custom" @get "hello world" "custom header" assert=

"read-request: POST method" test-section
<pipe> dup "POST /submit HTTP/1.0\r\nHost: localhost\r\nContent-Length: 0\r\n\r\n" stream-write drop
stream-close
read-request
dup method>> "POST" "POST method" assert=
dup path>> "/submit" "POST path" assert=
dup version>> "HTTP/1.0" "POST version" assert=
headers>> "content-length" @get "0" "content-length header" assert=

"read-request: no headers" test-section
<pipe> dup "GET / HTTP/1.1\r\n\r\n" stream-write drop
stream-close
read-request
dup method>> "GET" "no-headers method" assert=
headers>> @keys #len 0 "no headers count" assert=

"read-request: no query string" test-section
<pipe> dup "GET /path HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
stream-close
read-request
dup path>> "/path" "no-query path" assert=
query-string>> "" "no-query empty string" assert=

"read-request: non-empty query string" test-section
<pipe> dup "GET /path?a=1&b=2 HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
stream-close
read-request
dup path>> "/path" "non-empty-query path" assert=
query-string>> "a=1&b=2" "non-empty query string" assert=

"read-request: empty query string" test-section
<pipe> dup "GET /path? HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
stream-close
read-request
dup path>> "/path" "empty-query path" assert=
query-string>> "" "empty query string" assert=

"read-request: EOF throws EUnexpectedEOF" test-section
[ <pipe> stream-close read-request ] unexpected-eof: "EOF on empty stream" assert-error-type

"read-request: malformed request line throws EMalformedRequest" test-section
[ <pipe> dup "GET /\r\n\r\n" stream-write drop stream-close read-request ] malformed-request: "too few parts" assert-error-type

"make-request: socket-derived fields round-trip" test-section
"GET" "/" "" "HTTP/1.1" H{ }
"192.0.2.1" 54321 "example.com" 8443 t "TLSv1.3" "TLS_AES_128_GCM_SHA256"
make-request
dup remote-addr>> "192.0.2.1" "remote-addr round-trip" assert=
dup remote-port>> 54321 "remote-port round-trip" assert=
dup server-name>> "example.com" "server-name round-trip" assert=
dup server-port>> 8443 "server-port round-trip" assert=
dup is-tls?>> t "is-tls? round-trip" assert=
dup tls-version>> "TLSv1.3" "tls-version round-trip" assert=
tls-cipher>> "TLS_AES_128_GCM_SHA256" "tls-cipher round-trip" assert=

"read-request: socket-derived fields use sentinel defaults" test-section
<pipe> dup "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
stream-close
read-request
dup remote-addr>> "" "sentinel remote-addr" assert=
dup remote-port>> 0 "sentinel remote-port" assert=
dup server-name>> "" "sentinel server-name" assert=
dup server-port>> 0 "sentinel server-port" assert=
dup is-tls?>> f "sentinel is-tls?" assert=
dup tls-version>> "" "sentinel tls-version" assert=
tls-cipher>> "" "sentinel tls-cipher" assert=

"read-form: empty body" test-section
<pipe> dup "" stream-write drop
stream-close
0 read-form
@keys #len 0 "empty body has no entries" assert=

"read-form: single pair" test-section
<pipe> dup "name=alice" stream-write drop
stream-close
10 read-form
"name" @get "alice" "single pair value" assert=

"read-form: multiple pairs" test-section
<pipe> dup "a=1&b=2&c=3" stream-write drop
stream-close
11 read-form
dup "a" @get "1" "first pair" assert=
dup "b" @get "2" "second pair" assert=
"c" @get "3" "third pair" assert=

"read-form: percent-decoded key" test-section
<pipe> dup "na%6De=alice" stream-write drop
stream-close
12 read-form
"name" @get "alice" "percent-decoded key" assert=

"read-form: percent-decoded value" test-section
<pipe> dup "name=al%69ce" stream-write drop
stream-close
12 read-form
"name" @get "alice" "percent-decoded value" assert=

"read-form: + decodes to space" test-section
<pipe> dup "q=hello+world" stream-write drop
stream-close
13 read-form
"q" @get "hello world" "+ decodes to space" assert=

"read-form: %2B decodes to literal +" test-section
<pipe> dup "q=a%2Bb" stream-write drop
stream-close
7 read-form
"q" @get "a+b" "%2B decodes to literal +" assert=

"read-form: bare key has empty value" test-section
<pipe> dup "flag" stream-write drop
stream-close
4 read-form
dup "flag" @get "" "bare key value" assert=
@keys #len 1 "bare key creates one entry" assert=

"read-form: stray ampersand skipped" test-section
<pipe> dup "a=1&&b=2" stream-write drop
stream-close
8 read-form
dup @keys #len 2 "stray & does not create empty entry" assert=
dup "a" @get "1" "stray & a entry" assert=
"b" @get "2" "stray & b entry" assert=

"read-form: short body throws EUnexpectedEOF" test-section
[ <pipe> dup "abc" stream-write drop stream-close 10 read-form ] unexpected-eof: "short body throws" assert-error-type

"read-form: malformed percent throws EInvalidArgument" test-section
[ <pipe> dup "a=%" stream-write drop stream-close 3 read-form ] invalid-argument: "malformed % throws" assert-error-type

"reason-for: known status code" test-section
200 reason-for "OK" "200 reason" assert=
404 reason-for "Not Found" "404 reason" assert=
500 reason-for "Internal Server Error" "500 reason" assert=

"reason-for: unknown status code" test-section
999 reason-for "Unknown" "unknown reason" assert=

"send-response: simple 200" test-section
<pipe> dup
200 "OK" "text/plain; charset=utf-8" "hello" <response>
send-response
stream-close
dup stream-read-line "HTTP/1.1 200 OK" "status line" assert=
dup stream-read-line "Connection: close" "connection header" assert=
dup stream-read-line "Content-Length: 5" "content-length" assert=
dup stream-read-line "content-type: text/plain; charset=utf-8" "content-type header" assert=
dup stream-read-line "" "blank line" assert=
stream-read-line "hello" "body" assert=

"ok: convenience constructor" test-section
<pipe> dup
"world" "text/html; charset=utf-8" ok send-response
stream-close
dup stream-read-line "HTTP/1.1 200 OK" "ok status line" assert=
dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
dup stream-read-line "" "ok blank line" assert=
stream-read-line "world" "ok body" assert=

"not-found: convenience constructor" test-section
<pipe> dup
not-found send-response
stream-close
dup stream-read-line "HTTP/1.1 404 Not Found" "404 status line" assert=
dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
dup stream-read-line "" "404 blank line" assert=
stream-read-line "404 Not Found" "404 body" assert=

"method-not-allowed: convenience constructor" test-section
<pipe> dup
method-not-allowed send-response
stream-close
stream-read-line "HTTP/1.1 405 Method Not Allowed" "405 status line" assert=

"error-response: convenience constructor" test-section
<pipe> dup
500 "Internal Server Error" "something broke" error-response send-response
stream-close
dup stream-read-line "HTTP/1.1 500 Internal Server Error" "500 status line" assert=
dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
dup stream-read-line "" "500 blank line" assert=
stream-read-line "something broke" "500 body" assert=

"send-response: empty body" test-section
<pipe> dup
200 "OK" "text/plain" "" <response> send-response
stream-close
dup stream-read-line "HTTP/1.1 200 OK" "empty body status" assert=
dup stream-read-line "Connection: close" "empty body connection" assert=
stream-read-line "Content-Length: 0" "empty body content-length" assert=

"serve: handler wrapping via TCP" test-section
[
  39485
  dup "127.0.0.1" swap make-addr:tcp 128 listen

  dup [
    accept drop
    dup read-request
    path>> "text/plain; charset=utf-8" ok
    over -rot> send-response
    stream-close
  ] curry spawn

  "127.0.0.1" 3 pick-n make-addr:tcp connect
  dup "GET /hello HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "serve handler status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "serve handler blank" assert=
  stream-read-line "/hello" "serve handler body" assert=

  await drop
  swap drop
  close
] task-scope

"serve: handler receives parsed POST request" test-section
[
  39486
  dup "127.0.0.1" swap make-addr:tcp 128 listen

  dup [
    accept drop
    dup read-request
    method>> "text/plain; charset=utf-8" ok
    over -rot> send-response
    stream-close
  ] curry spawn

  "127.0.0.1" 3 pick-n make-addr:tcp connect
  dup "POST /submit HTTP/1.0\r\nHost: test\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "POST handler status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "POST handler blank" assert=
  stream-read-line "POST" "POST handler body is method" assert=

  await drop
  swap drop
  close
] task-scope

"serve: config construction" test-section
"127.0.0.1" 9999 [ drop drop ]
[ swap dup -rot> dup read-request <rot- call stream-close ] curry
<server-config> swap >>handler swap >>port swap >>host
dup host>> "127.0.0.1" "serve config host" assert=
port>> 9999 "serve config port" assert=

"serve: end-to-end GET" test-section
[
  "127.0.0.1" 39490 [
    path>> "text/plain; charset=utf-8" ok send-response
  ] make-http-server-once-task
  100 milliseconds sleep
  "127.0.0.1" 39490 make-addr:tcp connect
  dup "GET /test-path HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "serve e2e status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "serve e2e blank" assert=
  stream-read-line "/test-path" "serve e2e body" assert=
  await drop
] task-scope

"serve: server continues after malformed request" test-section
[
  "127.0.0.1" 39491 make-addr:tcp 128 listen
  dup [
    accept drop
    stream-close
  ] curry spawn
  100 milliseconds sleep
  "127.0.0.1" 39491 make-addr:tcp connect
  dup "GARBAGE\r\n\r\n" stream-write drop
  stream-close
  await drop
  close

  "127.0.0.1" 39491 [
    path>> "text/plain; charset=utf-8" ok send-response
  ] make-http-server-once-task
  100 milliseconds sleep
  "127.0.0.1" 39491 make-addr:tcp connect
  dup "GET /recovered HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "serve recovery status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "serve recovery blank" assert=
  stream-read-line "/recovered" "serve recovery body" assert=
  await drop
] task-scope

"serve: concurrent connections" test-section
"flaky under build runner" skip

"serve: handler exception recovery" test-section
[
  "127.0.0.1" 39493 make-addr:tcp 128 listen
  dup [
    accept drop
    [ dup read-request
      dup path>> "/crash" =
      [ drop "deliberate error" throw ]
      [ path>> "text/plain; charset=utf-8" ok over -rot> send-response stream-close ]
      if
    ] [ drop ] recover
  ] curry spawn
  100 milliseconds sleep
  "127.0.0.1" 39493 make-addr:tcp connect
  dup "GET /crash HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  stream-close
  await drop
  close

  "127.0.0.1" 39493 [
    dup path>> "/crash" =
    [ drop "deliberate error" throw ]
    [ path>> "text/plain; charset=utf-8" ok send-response ]
    if
  ] make-http-server-once-task
  100 milliseconds sleep
  "127.0.0.1" 39493 make-addr:tcp connect
  dup "GET /ok HTTP/1.1\r\nHost: localhost\r\n\r\n" stream-write drop
  dup stream-read-line "HTTP/1.1 200 OK" "after-crash status" assert=
  dup stream-read-line drop dup stream-read-line drop dup stream-read-line drop
  dup stream-read-line "" "after-crash blank" assert=
  stream-read-line "/ok" "after-crash body" assert=
  await drop
] task-scope
