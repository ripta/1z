\ Test that M{} and V{} allocate fresh containers on each execution,
\ and that mutations to one instance do not affect the next.

use "testing" ;

\ --- Section A: Fresh allocation demonstration ---

"fresh allocation" test-section

\ Parse-time word using M{}, which should allocate fresh each call.
pt-mmap: parse-time [ M{ } ] ;

\ Call pt-mmap twice, mutate after first call.
pt-mmap
x: 42 @set! drop
pt-mmap
x: @has?
f "M{} in parse-time allocates fresh" assert=

\ Parse-time word using V{}, which should allocate fresh each call.
pt-vec: parse-time [ V{ } ] ;

\ Call pt-vec twice, mutate after first call.
pt-vec
42 #push! drop
pt-vec
#len
0 "V{} in parse-time allocates fresh" assert=

\ --- Section B: Consecutive definitions work correctly ---

"consecutive definitions" test-section

\ Two enum definitions; each should have correct variant counts.
color: enum{ red: unit green: unit blue: unit } ;
shape: enum{ circle: unit square: unit } ;

t color:red color:red? "color:red predicate" assert=
t shape:circle shape:circle? "shape:circle predicate" assert=

\ Two virtual type definitions; each should wrap/unwrap correctly.
meters: virtual{ fixnum } ;
seconds: virtual{ fixnum } ;

42 make-meters unmake-meters 42 "meters wrap/unwrap" assert=
10 make-seconds unmake-seconds 10 "seconds wrap/unwrap" assert=

\ Two method registrations; each should dispatch correctly.
greet: generic [ "hello" ] ;
greet: method{ fixnum } [ drop "number" ] ;
greet: method{ string } [ drop "word" ] ;

42 greet "number" "method on fixnum" assert=
"x" greet "word" "method on string" assert=

\ Two protocol definitions; both exist independently.
proto-a: protocol{ greet: } ;
proto-b: protocol{ inspect: } ;

\ Both protocols are words that can be referenced.
t proto-a: >word-info type-of word-info = "proto-a exists" assert=
t proto-b: >word-info type-of word-info = "proto-b exists" assert=
