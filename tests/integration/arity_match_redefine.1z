\ Tests for arity checking on word redefinition

use "testing" ;

"both match - same concrete arity" test-section

foo: ( a b -- c ) [ + ] ;
foo: ( x y -- z ) [ + ] ;
3 4 foo 7 "redefine with matching arity succeeds" assert=

"input count mismatch" test-section

[
  bar: ( a -- b ) [ 1 + ] ;
  bar: ( a b -- c ) [ + ] ;
] EArityMismatch "input arity mismatch is error" assert-error-type

"output count mismatch" test-section

[
  baz: ( a -- b ) [ 1 + ] ;
  baz: ( a -- b c ) [ dup ] ;
] EArityMismatch "output arity mismatch is error" assert-error-type

"neither has effect" test-section

qux: [ 42 ] ;
qux: [ 99 ] ;
qux 99 "redefine bare words succeeds" assert=

"old has effect, new does not - asymmetry warning" test-section

witha: ( a -- b ) [ 1 + ] ;
witha: [ 1 + ] ;
5 witha 6 "asymmetry old-has new-lacks still works" assert=

"new has effect, old does not - asymmetry warning" test-section

withb: [ 1 + ] ;
withb: ( a -- b ) [ 1 + ] ;
5 withb 6 "asymmetry old-lacks new-has still works" assert=

"row variables ignored in concrete arity" test-section

rowfn: ( ..a x -- ..a y ) [ 1 + ] ;
rowfn: ( x -- y ) [ 1 + ] ;
5 rowfn 6 "row variable redefinition with same concrete arity succeeds" assert=

"pragma warning downgrades arity mismatch" test-section

pragma{ redefinition-arity-mismatch: "warning" }
warn1: ( a -- b ) [ 1 + ] ;
warn1: ( a b -- c ) [ + ] ;
3 4 warn1 7 "warning pragma allows mismatched redefinition" assert=
pragma{ redefinition-arity-mismatch: "error" }

"pragma error preserves hard error" test-section

pragma{ redefinition-arity-mismatch: "error" }
[
  err1: ( a -- b ) [ 1 + ] ;
  err1: ( a b -- c ) [ + ] ;
] EArityMismatch "error pragma preserves arity mismatch error" assert-error-type

"default (no pragma) preserves hard error" test-section

[
  err2: ( a -- b ) [ 1 + ] ;
  err2: ( a b -- c ) [ + ] ;
] EArityMismatch "default preserves arity mismatch error" assert-error-type

"invalid pragma value rejected" test-section

[ "pragma{ redefinition-arity-mismatch: \"ignore\" }" eval-string
] "invalid pragma value is rejected" assert-error

[ "pragma{ redefinition-arity-mismatch: 42 }" eval-string
] "non-string pragma value is rejected" assert-error

"warning mode uses new definition" test-section

pragma{ redefinition-arity-mismatch: "warning" }
wfn: ( a -- b ) [ 1 + ] ;
wfn: ( a b -- c ) [ * ] ;
3 4 wfn 12 "warning mode uses the new definition body" assert=
pragma{ redefinition-arity-mismatch: "error" }

"warning then back to error" test-section

pragma{ redefinition-arity-mismatch: "warning" }
toggle1: ( a -- b ) [ 1 + ] ;
toggle1: ( a b -- c ) [ + ] ;
pragma{ redefinition-arity-mismatch: "error" }
[
  toggle2: ( a -- b ) [ 1 + ] ;
  toggle2: ( a b -- c ) [ + ] ;
] EArityMismatch "error after warning restores hard error" assert-error-type
