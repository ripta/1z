\ Test cleanup combinator

use "testing" ;

"Cleanup runs on success" test-section
\ The cleanup quotation must leave the stack as it found it, so it records into a vector
V{ } dup [ 10 ] swap [ 20 #push! drop ] curry cleanup
10 "body result" assert=
0 #nth 20 "cleanup executed after the body" assert=

"Cleanup runs on error" test-section
\ cleanup executes, then error propagates
\ recover restores the entry stack, so the cleanup records into a vector instead of pushing
V{ } dup [ [ 1 0 / ] swap [ 99 #push! drop ] curry cleanup ] curry [ drop ] recover
#len 1 "cleanup executed before error" assert=
