use "testing" ;
use "lexer" ;
use "scanner" ;
use "conversions" ;
use "char" ;

\ --- Test helper rules ---

\ Rule that matches a run of digits, producing a number: token
(digit-match): ( scanner -- new-scanner token | f ) [
  dup peek dup f = [ 2drop f ] [
    digit? [
      dup position>> swap
      [ digit? ] take-while
      \ start-pos scanner' value
      <rot- [ number: swap ] dip make-token
    ] [ drop f ] if
  ] if
] ;

\ Rule that matches a run of letters, producing a word: token
(alpha-match): ( scanner -- new-scanner token | f ) [
  dup peek dup f = [ 2drop f ] [
    alpha? [
      dup position>> swap
      [ alpha? ] take-while
      \ start-pos scanner' value
      <rot- [ word: swap ] dip make-token
    ] [ drop f ] if
  ] if
] ;

\ Rule that matches a single "+" character
(plus-match): ( scanner -- new-scanner token | f ) [
  dup peek "+" = [
    dup position>> swap advance swap
    \ scanner' start-pos
    [ plus: "+" ] dip make-token
  ] [ drop f ] if
] ;

\ Rule that matches any single character
(any-match): ( scanner -- new-scanner token | f ) [
  dup peek dup f = [ 2drop f ] [
    \ scanner char
    over position>>
    \ scanner char start-pos
    -rot> advance swap
    \ scanner' char start-pos
    [ any: swap ] dip make-token
  ] if
] ;

\ Build rule hashes
DIGIT-RULE: const [ H{ kind: number: match: [ (digit-match) ] } ] ;
ALPHA-RULE: const [ H{ kind: word: match: [ (alpha-match) ] } ] ;
PLUS-RULE:  const [ H{ kind: plus: match: [ (plus-match) ] } ] ;
ANY-RULE:   const [ H{ kind: any: match: [ (any-match) ] } ] ;

\ ===== Tests =====

"token struct" test-section
number: "42" 5 make-token token? "token? on token" assert-true
number: "42" 5 make-token kind>> number: "kind>> returns kind" assert=
number: "42" 5 make-token value>> "42" "value>> returns value" assert=
number: "42" 5 make-token pos>> 5 "pos>> returns pos" assert=
42 token? not "token? on non-token" assert-true

"lexer struct" test-section
{ } <lexer> lexer? "lexer? on lexer" assert-true
V{ } DIGIT-RULE #push! >array <lexer> rules>> #len 1 "rules>> returns rules array" assert=
42 lexer? not "lexer? on non-lexer" assert-true

"tokenize empty string" test-section
"" V{ } DIGIT-RULE #push! >array <lexer> tokenize #collect
#len 0 "empty string yields no tokens" assert=

"single-character rule" test-section
"+" V{ } PLUS-RULE #push! >array <lexer> tokenize #collect
dup #len 1 "single + yields one token" assert=
#first dup kind>> plus: "kind is plus:" assert=
dup value>> "+" "value is +" assert=
pos>> 0 "pos is 0" assert=

"multi-character rule" test-section
"12345" V{ } DIGIT-RULE #push! >array <lexer> tokenize #collect
dup #len 1 "digit run yields one token" assert=
#first dup kind>> number: "kind is number:" assert=
dup value>> "12345" "value is full digit run" assert=
pos>> 0 "pos is 0" assert=

"multiple tokens" test-section
"aaa" V{ } ALPHA-RULE #push! >array <lexer> tokenize #collect
#len 1 "aaa with alpha rule yields one token" assert=

"abc" V{ } PLUS-RULE #push! ALPHA-RULE #push! >array <lexer> tokenize #collect
dup #len 1 "abc yields one word token" assert=
#first value>> "abc" "value is abc" assert=

"+++" V{ } PLUS-RULE #push! >array <lexer> tokenize #collect
dup #len 3 "+++ yields three tokens" assert=
dup 0 #nth pos>> 0 "first + at pos 0" assert=
dup 1 #nth pos>> 1 "second + at pos 1" assert=
2 #nth pos>> 2 "third + at pos 2" assert=

"first-match priority" test-section
"abc" V{ } ALPHA-RULE #push! ANY-RULE #push! >array <lexer> tokenize #collect
dup #len 1 "alpha-rule matches first, one token" assert=
#first kind>> word: "first-match produces word: not any:" assert=

"mixed rules" test-section
"ab12cd" V{ } ALPHA-RULE #push! DIGIT-RULE #push! >array <lexer> tokenize #collect
dup #len 3 "ab12cd yields three tokens" assert=
dup 0 #nth dup kind>> word: "first is word:" assert=
dup value>> "ab" "first value is ab" assert=
pos>> 0 "first pos is 0" assert=
dup 1 #nth dup kind>> number: "second is number:" assert=
dup value>> "12" "second value is 12" assert=
pos>> 2 "second pos is 2" assert=
2 #nth dup kind>> word: "third is word:" assert=
dup value>> "cd" "third value is cd" assert=
pos>> 4 "third pos is 4" assert=

"error on unrecognized input" test-section
[ "!" V{ } ALPHA-RULE #push! >array <lexer> tokenize #collect ] "unrecognized char throws" assert-error

"error includes position" test-section
[ "ab!cd" V{ } ALPHA-RULE #push! >array <lexer> tokenize #collect ]
[ ] recover
message: @get "position 2" #in? "error mentions position" assert-true

"inspect" test-section
number: "42" 0 make-token inspect
"<token number: \"42\">" "token inspect format" assert=

\ ===== Built-in rule tests =====

"number-rule integers" test-section
"42" V{ } number-rule #push! >array <lexer> tokenize #collect
dup #len 1 "single integer yields one token" assert=
#first dup kind>> number: "kind is number:" assert=
value>> "42" "value is 42" assert=

"0" V{ } number-rule #push! >array <lexer> tokenize #collect
#first value>> "0" "zero" assert=

"number-rule floats" test-section
"3.14" V{ } number-rule #push! >array <lexer> tokenize #collect
dup #len 1 "float yields one token" assert=
#first dup kind>> number: "float kind is number:" assert=
value>> "3.14" "float value is 3.14" assert=

"0.5" V{ } number-rule #push! >array <lexer> tokenize #collect
#first value>> "0.5" "float value is 0.5" assert=

"number-rule trailing dot" test-section
"3." V{ } number-rule #push! >array <lexer> tokenize #collect
#first value>> "3." "trailing dot kept as 3." assert=

"word-rule" test-section
"hello" V{ } word-rule #push! >array <lexer> tokenize #collect
dup #len 1 "word yields one token" assert=
#first dup kind>> word: "kind is word:" assert=
value>> "hello" "value is hello" assert=

"abc123" V{ } word-rule #push! >array <lexer> tokenize #collect
#first value>> "abc123" "word with trailing digits" assert=

"x" V{ } word-rule #push! >array <lexer> tokenize #collect
#first value>> "x" "single letter" assert=

"symbols-rule longest match" test-section
{ "+" "++" } symbols-rule
V{ } swap #push! >array <lexer>
"++" swap tokenize #collect
dup #len 1 "++ yields one token (longest match)" assert=
#first dup kind>> symbol: "kind is symbol:" assert=
value>> "++" "value is ++ not +" assert=

"symbols-rule multiple" test-section
{ "(" ")" } symbols-rule
V{ } swap #push! >array <lexer>
"()" swap tokenize #collect
dup #len 2 "() yields two tokens" assert=
dup 0 #nth value>> "(" "first is (" assert=
1 #nth value>> ")" "second is )" assert=

"skip-whitespace-rule" test-section
" hello "
V{ } skip-whitespace-rule #push! word-rule #push! >array <lexer>
tokenize #collect
dup #len 1 "whitespace skipped, one word token" assert=
#first value>> "hello" "value is hello after skip" assert=

"ab  cd"
V{ } skip-whitespace-rule #push! word-rule #push! >array <lexer>
tokenize #collect
dup #len 2 "two words with whitespace yields two tokens" assert=
dup 0 #nth value>> "ab" "first word is ab" assert=
1 #nth value>> "cd" "second word is cd" assert=

"combined rules" test-section
"x + 42"
V{ } skip-whitespace-rule #push! word-rule #push!
number-rule #push! { "+" } symbols-rule #push! >array <lexer>
tokenize #collect
dup #len 3 "x + 42 yields three tokens" assert=
dup 0 #nth dup kind>> word: "first is word:" assert=
value>> "x" "first is x" assert=
dup 1 #nth dup kind>> symbol: "second is symbol:" assert=
value>> "+" "second is +" assert=
2 #nth dup kind>> number: "third is number:" assert=
value>> "42" "third is 42" assert=
