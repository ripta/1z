\ tests/integration/truthiness.1z - Verify truthiness semantics
\ Only f is falsy; everything else (including 0) is truthy

use "testing" ;

"boolean truthiness" test-section
t [ t ] [ f ] if "t is truthy" assert-true
f [ t ] [ f ] if "f is falsy" assert-false

"integer truthiness (all truthy, including 0)" test-section
0 [ t ] [ f ] if "0 is truthy" assert-true
1 [ t ] [ f ] if "1 is truthy" assert-true
-1 [ t ] [ f ] if "-1 is truthy" assert-true
42 [ t ] [ f ] if "42 is truthy" assert-true

"string truthiness (all truthy, including empty)" test-section
"" [ t ] [ f ] if "empty string is truthy" assert-true
"hello" [ t ] [ f ] if "non-empty string is truthy" assert-true

"array truthiness (all truthy, including empty)" test-section
{ } [ t ] [ f ] if "empty array is truthy" assert-true
{ 1 2 3 } [ t ] [ f ] if "non-empty array is truthy" assert-true

"other types (all truthy)" test-section
[ ] [ t ] [ f ] if "empty quotation is truthy" assert-true
H{ } [ t ] [ f ] if "empty hash is truthy" assert-true
foo: [ t ] [ f ] if "symbol is truthy" assert-true

"practical use: index-of returning 0 vs f" test-section
\ This pattern works cleanly because 0 is truthy
0 [ t ] [ f ] if "index 0 is truthy (found)" assert-true
f [ t ] [ f ] if "f is falsy (not found)" assert-false
