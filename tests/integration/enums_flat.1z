\ Test flat enum type definitions

use "testing" ;

"flat enum constructors" test-section

color: enum{ red green blue } ;

\ Constructors push tagged values
color:red type-of color:red: "color:red type-of is color:red" assert=
color:green type-of color:green: "color:green type-of is color:green" assert=
color:blue type-of color:blue: "color:blue type-of is color:blue" assert=

"per-variant predicates" test-section

\ True for matching variant
color:red color:red? t "color:red? on color:red is true" assert=
color:green color:green? t "color:green? on color:green is true" assert=
color:blue color:blue? t "color:blue? on color:blue is true" assert=

\ False for different variant
color:red color:green? f "color:green? on color:red is false" assert=
color:red color:blue? f "color:blue? on color:red is false" assert=
color:green color:red? f "color:red? on color:green is false" assert=

\ False for non-enum values
42 color:red? f "color:red? on integer is false" assert=
"hello" color:red? f "color:red? on string is false" assert=

"aggregate predicate" test-section

\ True for any variant
color:red color? t "color? on color:red is true" assert=
color:green color? t "color? on color:green is true" assert=
color:blue color? t "color? on color:blue is true" assert=

\ False for non-enum values
42 color? f "color? on integer is false" assert=
"hello" color? f "color? on string is false" assert=
red: color? f "color? on bare symbol is false" assert=

"equality" test-section

\ Same variant is equal
color:red color:red = t "same variant is equal" assert=
color:green color:green = t "same variant green is equal" assert=

\ Different variants are not equal
color:red color:green = f "different variants are not equal" assert=
color:red color:blue = f "red vs blue not equal" assert=

\ Not equal to plain values
color:red 42 = f "enum vs integer not equal" assert=
color:red red: = f "enum vs bare symbol not equal" assert=

"display format" test-section

color:red to-string "<color:red red:>" "color:red display format" assert=
color:green to-string "<color:green green:>" "color:green display format" assert=
color:blue to-string "<color:blue blue:>" "color:blue display format" assert=

"independent enums" test-section

\ Define a second enum
suit: enum{ hearts diamonds clubs spades } ;

\ Each enum is independent
suit:hearts suit:hearts? t "suit:hearts? on hearts is true" assert=
suit:hearts color:red? f "color:red? on suit:hearts is false" assert=
color:red suit:hearts? f "suit:hearts? on color:red is false" assert=

\ Aggregate predicates are independent
suit:hearts suit? t "suit? on hearts is true" assert=
suit:hearts color? f "color? on hearts is false" assert=
color:red suit? f "suit? on red is false" assert=

"data-carrying variants" test-section

shape: enum{
  circle struct{ radius }
  point
} ;

\ Wrap and unwrap
42 >shape:circle shape:circle> 42 "wrap and unwrap circle" assert=

\ type-of
42 >shape:circle type-of shape:circle: "type-of data variant is shape:circle" assert=

\ Per-variant predicate
42 >shape:circle shape:circle? t "shape:circle? on circle is true" assert=
shape:point shape:circle? f "shape:circle? on point is false" assert=
42 shape:circle? f "shape:circle? on integer is false" assert=

\ Aggregate predicate
42 >shape:circle shape? t "shape? on circle is true" assert=
shape:point shape? t "shape? on point is true" assert=
42 shape? f "shape? on integer is false" assert=

\ Cross-predicate: flat predicate on data variant and vice versa
42 >shape:circle shape:point? f "shape:point? on circle is false" assert=
shape:point shape:circle? f "shape:circle? on point is false" assert=

\ Equality
42 >shape:circle 42 >shape:circle = t "same circle values are equal" assert=
42 >shape:circle 99 >shape:circle = f "different circle values are not equal" assert=

\ Display format
42 >shape:circle to-string "<shape:circle shape:circle{ radius: 42 }>" "circle display format" assert=

\ Flat variant still works alongside data variant
shape:point type-of shape:point: "flat variant type-of in mixed enum" assert=
shape:point to-string "<shape:point point:>" "flat variant display in mixed enum" assert=

"multi-field data variants" test-section

geom: enum{
  rect struct{ width height }
  tri struct{ a b c }
  dot
} ;

\ Wrap and unwrap multi-field variant
10 20 >geom:rect geom:rect> 20 "rect unwrap height" assert= 10 "rect unwrap width" assert=

\ type-of
10 20 >geom:rect type-of geom:rect: "type-of multi-field variant is geom:rect" assert=

\ Per-variant predicate
10 20 >geom:rect geom:rect? t "geom:rect? on rect is true" assert=
geom:dot geom:rect? f "geom:rect? on dot is false" assert=
42 geom:rect? f "geom:rect? on integer is false" assert=

\ Aggregate predicate
10 20 >geom:rect geom? t "geom? on rect is true" assert=
geom:dot geom? t "geom? on dot is true" assert=
42 geom? f "geom? on integer is false" assert=

\ Three-field variant
3 4 5 >geom:tri geom:tri> 5 "tri unwrap c" assert= 4 "tri unwrap b" assert= 3 "tri unwrap a" assert=
3 4 5 >geom:tri geom:tri? t "geom:tri? on tri is true" assert=
3 4 5 >geom:tri geom? t "geom? on tri is true" assert=

\ Cross-predicate between multi-field variants
10 20 >geom:rect geom:tri? f "geom:tri? on rect is false" assert=
3 4 5 >geom:tri geom:rect? f "geom:rect? on tri is false" assert=

\ Equality
10 20 >geom:rect 10 20 >geom:rect = t "same rect values are equal" assert=
10 20 >geom:rect 10 99 >geom:rect = f "different rect values are not equal" assert=

\ Display format
10 20 >geom:rect to-string "<geom:rect geom:rect{ width: 10 height: 20 }>" "rect display format" assert=
geom:dot to-string "<geom:dot dot:>" "flat variant display in multi-field enum" assert=

"enum-of" test-section

\ Flat variant returns enum name
color:red enum-of "color" "enum-of on flat variant returns enum name" assert=
color:green enum-of "color" "enum-of on another flat variant" assert=

\ Data-carrying variant returns enum name
42 >shape:circle enum-of "shape" "enum-of on data variant returns enum name" assert=
shape:point enum-of "shape" "enum-of on flat variant in mixed enum" assert=

\ Non-enum values return f
42 enum-of f "enum-of on integer returns f" assert=
"hello" enum-of f "enum-of on string returns f" assert=
red: enum-of f "enum-of on bare symbol returns f" assert=

"enum-variants" test-section

\ Flat enum returns variant name symbols
color: enum-variants { color:red: color:green: color:blue: } "enum-variants for flat enum" assert=

\ Mixed enum returns all variant name symbols
shape: enum-variants { shape:circle: shape:point: } "enum-variants for mixed enum" assert=

\ Multi-field enum returns all variant name symbols
geom: enum-variants { geom:rect: geom:tri: geom:dot: } "enum-variants for multi-field enum" assert=

\ Unknown enum throws error
[ unknown-enum: enum-variants ] [ "unknown enum" assert-error ] recover

"match flat enum" test-section

\ Basic match on flat variants
color:red {
  color:red: [ "R" ]
  color:green: [ "G" ]
  color:blue: [ "B" ]
} match "R" "match selects correct flat variant" assert=

color:green {
  color:red: [ "R" ]
  color:green: [ "G" ]
  color:blue: [ "B" ]
} match "G" "match selects green" assert=

color:blue {
  color:red: [ "R" ]
  color:green: [ "G" ]
  color:blue: [ "B" ]
} match "B" "match selects blue" assert=

"match data-carrying enum" test-section

\ Data-carrying variant auto-unwraps
42 >shape:circle {
  shape:circle: [ 2 * ]
  shape:point: [ 0 ]
} match 84 "match unwraps data variant" assert=

\ Flat variant in mixed enum
shape:point {
  shape:circle: [ 2 * ]
  shape:point: [ 99 ]
} match 99 "match flat variant in mixed enum" assert=

"match multi-field data variant" test-section

\ Multi-field unwrap pushes all fields
10 20 >geom:rect {
  geom:rect: [ + ]
  geom:tri: [ + + ]
  geom:dot: [ 0 ]
} match 30 "match unwraps multi-field variant" assert=

3 4 5 >geom:tri {
  geom:rect: [ + ]
  geom:tri: [ + + ]
  geom:dot: [ 0 ]
} match 12 "match unwraps three-field variant" assert=

geom:dot {
  geom:rect: [ + ]
  geom:tri: [ + + ]
  geom:dot: [ 0 ]
} match 0 "match flat variant in multi-field enum" assert=

"match exhaustiveness errors" test-section

\ Missing branch throws error
[ color:red {
    color:red: [ "R" ]
    color:green: [ "G" ]
  } match
] [ "missing match branch" assert-error ] recover

\ Duplicate branch throws error
[ color:red {
    color:red: [ "R" ]
    color:green: [ "G" ]
    color:red: [ "R2" ]
    color:blue: [ "B" ]
  } match
] [ "duplicate match branch" assert-error ] recover

\ Non-enum value throws error
[ 42 {
    color:red: [ "R" ]
  } match
] [ "match requires an enum" assert-error ] recover

\ Wrong variant name throws error
[ color:red {
    color:red: [ "R" ]
    color:green: [ "G" ]
    suit:hearts: [ "H" ]
  } match
] [ "not a variant" assert-error ] recover

"enum-level dispatch fallback" test-section

\ Define a generic word with an enum-level method
describe: generic ( val -- str ) [ drop "unknown" ] ;
describe: method{ color } [ drop "a color" ] ;

\ All color variants dispatch to the enum-level method
color:red describe "a color" "enum fallback for color:red" assert=
color:green describe "a color" "enum fallback for color:green" assert=
color:blue describe "a color" "enum fallback for color:blue" assert=

\ Per-variant override takes priority
describe: mutable method{ color:red } [ drop "red!" ] ;
color:red describe "red!" "per-variant override wins" assert=
color:green describe "a color" "other variants still use enum fallback" assert=

\ Enum method on data-carrying enum
label: generic ( val -- str ) [ "none" ] ;
label: method{ shape } [ drop "a shape" ] ;

42 >shape:circle label "a shape" "enum fallback for data variant" assert=
shape:point label "a shape" "enum fallback for flat variant in mixed enum" assert=

\ Non-enum values use default body
42 describe "unknown" "non-enum uses default body" assert=

\ Native operator dispatch with enum fallback
neg: generic ( val -- val ) [ 0 swap - ] ;
neg: method{ color } [ drop color:blue ] ;
color:red neg color:blue "native op enum fallback" assert=
