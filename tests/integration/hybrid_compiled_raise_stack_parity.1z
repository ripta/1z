\ The hybrid twin of compiled_raise_stack_parity: each word is compiled after warming on inputs that
\ do not raise, then raises from its inline guard. `recover` releases every slot the raise leaves
\ when it restores the entry stack, so the handler sees the restored operands. The golden matches
\ the interpreted twin's, and the empty stderr golden is the leak and double-release check.

use "testing" ;

vector(fixnum): M{ inner-type: vector element-type: fixnum define: [ define-parameterized-type ] } ;
money: virtual{ fixnum } ;
point: mutable struct{ x y } ;

heap: ( -- s ) [ "hel" "lo" #append ] ;

drop-then-abs:    ( n s -- m )                       [ drop abs ] ;
swap-then-div:    ( d n -- q )                       [ swap div ] ;
sum-then-mod:     ( a: fixnum b: fixnum n d -- s r ) [ [ + ] 2dip % ] ;
drop-then-pick:   ( a b q s -- x )                   [ drop choose ] ;
over-then-unwrap: ( s m -- s s n )                   [ over swap unmake-money ] ;
over-then-push:   ( v e -- v v )                     [ over swap #push! ] ;
drop-then-x:      ( p s -- x )                       [ drop x>> ] ;
swap-then-set:    ( v p -- p )                       [ swap >>x ] ;

warm: ( n: fixnum -- ) [
  [
    -5 heap drop-then-abs drop
    2 8 swap-then-div drop
    1 2 7 3 sum-then-mod 2drop
    1 2 [ 2drop t ] heap drop-then-pick drop
    heap 5 make-money over-then-unwrap 3drop
    V{ 1 } >vector(fixnum) 2 over-then-push 2drop
    1 2 make-point heap drop-then-x drop
    5 1 2 make-point swap-then-set drop
  ] times
] ;

200 warm

"a tag guard after dropping an owned heap slot" test-section
heap heap heap [ drop-then-abs ] [ drop "caught" ] recover "caught" "handler ran" assert=
"hello" "handler sees the restored dropped slot" assert=
"hello" "handler sees the restored operand" assert=
"hello" "handler sees the string below" assert=

"division by zero after a relabeling swap" test-section
heap 0 7 [ swap-then-div ] [ drop "caught" ] recover "caught" "handler ran" assert=
7 "handler sees the restored dividend" assert=
0 "handler sees the restored divisor" assert=
"hello" "handler sees the string below" assert=

"division by zero over an unboxed sum" test-section
heap 1 2 7 0 [ sum-then-mod ] [ drop "caught" ] recover "caught" "handler ran" assert=
0 "handler sees the restored divisor" assert=
7 "handler sees the restored dividend" assert=
2 "handler sees the restored second addend" assert=
1 "handler sees the restored first addend" assert=
"hello" "handler sees the string below" assert=

"choose with a non-quotation selector after dropping an owned heap slot" test-section
heap heap heap "not a quotation" heap [ drop-then-pick ] [ drop "caught" ] recover "caught" "handler ran" assert=
"hello" "handler sees the restored dropped slot" assert=
"not a quotation" "handler sees the restored selector" assert=
"hello" "handler sees the restored second arm" assert=
"hello" "handler sees the restored first arm" assert=
"hello" "handler sees the string below the arms" assert=

"an inline unwrap over a copied operand" test-section
heap heap heap [ over-then-unwrap ] [ drop "caught" ] recover "caught" "handler ran" assert=
"hello" "handler sees the restored unwrap operand" assert=
"hello" "handler sees the restored operand below it" assert=
"hello" "handler sees the string below" assert=

"a typed element check over a copied vector" test-section
heap V{ 1 } >vector(fixnum) heap [ over-then-push ] [ drop "caught" ] recover "caught" "handler ran" assert=
"hello" "handler sees the restored element" assert=
unmake-vector(fixnum) #len 1 "vector is unchanged" assert=
"hello" "handler sees the string below" assert=

"a struct field read after dropping an owned heap slot" test-section
heap heap heap [ drop-then-x ] [ drop "caught" ] recover "caught" "handler ran" assert=
"hello" "handler sees the restored dropped slot" assert=
"hello" "handler sees the restored operand" assert=
"hello" "handler sees the string below" assert=

"a struct field write after a relabeling swap" test-section
heap 5 heap [ swap-then-set ] [ drop "caught" ] recover "caught" "handler ran" assert=
"hello" "handler sees the restored operand" assert=
5 "handler sees the restored value" assert=
"hello" "handler sees the string below" assert=
