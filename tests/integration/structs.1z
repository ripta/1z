\ Test struct type definitions

use "lib/testing.1z" ;

"struct{ } syntax" test-section

\ Test struct{ } syntax
point: struct{ x y } ;

\ Test constructor
1 2 make-point dup point? t "make-point creates point instance" assert=

\ Test getters
1 2 make-point x>> 1 "x>> gets x field" assert=
1 2 make-point y>> 2 "y>> gets y field" assert=

\ Test hash conversion
H{ x: 10 y: 20 } >point dup point? t ">point converts hash" assert=
H{ x: 10 y: 20 } >point x>> 10 ">point x value" assert=

\ Test type-of
1 2 make-point type-of point: "type-of returns struct name" assert=

\ Test struct instance equality
1 2 make-point 1 2 make-point = t "same fields are equal" assert=
1 2 make-point 1 3 make-point = f "different fields not equal" assert=

\ Test struct instance printing
1 2 make-point to-string "point{ x: 1 y: 2 }" "struct to-string" assert=
