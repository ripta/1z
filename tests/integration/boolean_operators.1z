\ Test boolean operators from prelude

use "testing" ;

"Logical NOT" test-section
t not "not t" assert-false
f not "not f" assert-true

"Logical AND" test-section
t t and "t and t" assert-true
t f and "t and f" assert-false
f t and "f and t" assert-false
f f and "f and f" assert-false

"Logical OR" test-section
t t or "t or t" assert-true
t f or "t or f" assert-true
f t or "f or t" assert-true
f f or "f or f" assert-false

"Logical XOR" test-section
t t xor "t xor t" assert-false
t f xor "t xor f" assert-true
f t xor "f xor t" assert-true
f f xor "f xor f" assert-false

"Combined boolean expressions" test-section
t t and t or "t and t or t" assert-true
f f or not "not (f or f)" assert-true
t f and not "not (t and f)" assert-true
