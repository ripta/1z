\ Integration tests for Associative Accessors
\ Tests: @get, @has?, @set, @keys, @values

use "testing" ;

"@get on hashes" test-section
H{ name: "Alice" age: 30 } name: @get "Alice" "hash @get with symbol" assert=
H{ name: "Alice" age: 30 } "name" @get "Alice" "hash @get with string" assert=
H{ name: "Alice" age: 30 } age: @get 30 "hash @get integer value" assert=
[ H{ a: 1 } b: @get ] "hash @get key not found error" assert-error

"@has? on hashes" test-section
H{ name: "Alice" } name: @has? "hash @has? true" assert-true
H{ name: "Alice" } "name" @has? "hash @has? string key true" assert-true
H{ name: "Alice" } missing: @has? "hash @has? false" assert-false

"@set on hashes" test-section
H{ a: 1 } b: 2 @set b: @get 2 "hash @set add new key" assert=
H{ a: 1 } a: 99 @set a: @get 99 "hash @set update existing key" assert=

"@set immutability" test-section
original: [ H{ x: 1 } ] ;
original y: 2 @set drop
original y: @has? "hash @set immutability" assert-false

"@keys on hashes" test-section
H{ a: 1 b: 2 } @keys #len 2 "hash @keys count" assert=

"@values on hashes" test-section
H{ a: 1 b: 2 } @values #len 2 "hash @values count" assert=

"Error object field access" test-section
[ 1 0 / ] [ dup error-type: @get EDivisionByZero = [ "PASS: error @get error-type" print-line ] [ "FAIL: error @get error-type" print-line ] if drop ] recover
[ 1 0 / ] [ dup message: @get "division-by-zero" = [ "PASS: error @get message" print-line ] [ "FAIL: error @get message" print-line ] if drop ] recover

"Error @has?" test-section
[ 1 0 / ] [ dup error-type: @has? [ "PASS: error @has? error-type" print-line ] [ "FAIL: error @has? error-type" print-line ] if drop ] recover
[ 1 0 / ] [ dup message: @has? [ "PASS: error @has? message" print-line ] [ "FAIL: error @has? message" print-line ] if drop ] recover
[ 1 0 / ] [ dup stack-trace: @has? [ "PASS: error @has? stack-trace" print-line ] [ "FAIL: error @has? stack-trace" print-line ] if drop ] recover
[ 1 0 / ] [ dup invalid-field: @has? not [ "PASS: error @has? invalid field" print-line ] [ "FAIL: error @has? invalid field" print-line ] if drop ] recover

"Error @keys and @values" test-section
[ 1 0 / ] [ dup @keys #len 4 = [ "PASS: error @keys count" print-line ] [ "FAIL: error @keys count" print-line ] if drop ] recover
[ 1 0 / ] [ dup @values #len 4 = [ "PASS: error @values count" print-line ] [ "FAIL: error @values count" print-line ] if drop ] recover

"@get-or on hashes" test-section
H{ name: "Alice" age: 30 } name: "default" @get-or "Alice" "hash @get-or existing key" assert=
H{ name: "Alice" age: 30 } missing: "default" @get-or "default" "hash @get-or missing key" assert=
H{ a: 1 } a: 0 @get-or 1 "hash @get-or existing returns value" assert=
H{ } x: 42 @get-or 42 "hash @get-or empty hash" assert=

"@get-or on error objects" test-section
[ 1 0 / ] [ dup error-type: "none" @get-or EDivisionByZero "error @get-or existing field" assert= drop ] recover
[ 1 0 / ] [ dup invalid-field: "fallback" @get-or "fallback" "error @get-or missing field" assert= drop ] recover

"Nested hash access" test-section
inner: [ H{ host: "localhost" port: 8080 } ] ;
outer: [ H{ } server: inner @set ] ;
outer server: @get host: @get "localhost" "nested hash access" assert=
outer server: @get port: @get 8080 "nested hash access 2" assert=

"#len on hashes" test-section
H{ a: 1 b: 2 c: 3 } #len 3 "hash #len" assert=
H{ } #len 0 "empty hash #len" assert=
H{ x: 1 } #len 1 "singleton hash #len" assert=

"Empty hash operations" test-section
H{ } @keys #len 0 "empty hash @keys" assert=
H{ } @values #len 0 "empty hash @values" assert=

"Chained @set" test-section
H{ } a: 1 @set b: 2 @set c: 3 @set @keys #len 3 "chained @set" assert=

"All associative accessor tests complete!" print-line
