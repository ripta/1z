\ Test quotation-level stack effect validation

use "testing" ;

"Correct stack effects" test-section
1 [ ( n -- n ) dup drop ] call 1 "effect (n -- n)" assert=
5 [ ( n -- n ) dup drop ] call 5 "effect (n -- n) with 5" assert=

"Effect violation recovery" test-section
\ The effect check fails after dup leaves an extra value. recover restores the entry 5.
5 [ ( n -- n ) dup ] [ drop "PASS: wrong effect caught" print-line ] recover
5 "recover restores the entry value" assert=

"Empty effect" test-section
[ ( -- ) ] call
t "effect (--) succeeds" assert-true

"Produce value effect" test-section
[ ( -- n ) 42 ] call 42 "effect (-- n)" assert=

"Duplicate effect" test-section
10 [ ( n -- n n ) dup ] call 10 "effect (n -- n n) first" assert= 10 "effect (n -- n n) second" assert=

"Effect across a tail call" test-section
\ `when` is a compound word in tail position, so it runs as the trampoline's next iteration. The
\ declared effect still covers the whole quotation, including the work done before the tail call.
5 [ ( n -- n n ) dup t [ ] when ] call
5 "tail-calling body, first" assert= 5 "tail-calling body, second" assert=
[ 5 [ ( n -- n ) dup t [ ] when ] call ] stack-effect-mismatch: "tail-calling body still checked" assert-error-type
