\ Test pragma? and pragma-get parse-time queries

use "testing" ;

"pragma-def for query tests" test-section

pragma-def{ qflag qlevel: [ dup fixnum? [ t ] [ drop "must be fixnum" f ] if ] }

"pragma? before set" test-section

"qflag" pragma? f "pragma? returns f before pragma is set" assert=

"pragma? after set true" test-section

pragma{ qflag }
"qflag" pragma? t "pragma? returns t after pragma{ flag }" assert=

"pragma? after negation" test-section

pragma{ !qflag }
"qflag" pragma? f "pragma? returns f after pragma{ !flag }" assert=

"pragma-get before set" test-section

"qlevel" pragma-get option:none? t "pragma-get returns none before set" assert=

"pragma-get after set" test-section

pragma{ qlevel: 42 }
"qlevel" pragma-get option:some? t "pragma-get returns some after set" assert=
"qlevel" pragma-get option:some> 42 "pragma-get value is correct" assert=
