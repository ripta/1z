use "testing" ;
use "ffi" ;

\\ Helper to get the shared library path for the toy library.
toy-lib-path: ( -- path ) [
  environ "PWD" @get "/zig-out/ext/libtoy.dylib" #append
] ;

toy-lib-path lib-open

\\ toy_double_inout: doubles value in-place, returns original
\\ After ffi-call stack is: ( lib ffi-fn modified-val original )
dup "toy_double_inout" lib-symbol ffi{ inout-i32 -> i32 } bind-sig
7 1 pick-n ffi-call
7 "toy_double_inout return (original)" assert=
14 "toy_double_inout inout (doubled)" assert=
drop

\\ Error case: inout-param as return type is rejected at bind-sig
[
  toy-lib-path lib-open
  dup "toy_add" lib-symbol
  ffi{ i32 -> inout-i32 } bind-sig
  drop swap resource-close
]
ffi-type-mismatch: "inout-param as return type rejected" assert-error-type

\\ Error case: inout-param in callback signature is rejected
[
  toy-lib-path lib-open
  dup "toy_apply2" lib-symbol
  [ + ] ffi{ inout-i32 -> i32 } ffi-callback
  drop swap resource-close
]
ffi-type-mismatch: "inout-param in callback rejected" assert-error-type

resource-close
