use "testing" ;
use "math/ratio" ;
use "math" ;

"float-parts: normal" test-section
1.0 float-parts 1 "sign of 1.0" assert= -52 "exponent of 1.0" assert= 4503599627370496 "mantissa of 1.0" assert=
-1.0 float-parts -1 "sign of -1.0" assert= -52 "exponent of -1.0" assert= 4503599627370496 "mantissa of -1.0" assert=
2.0 float-parts 1 "sign of 2.0" assert= -51 "exponent of 2.0" assert= 4503599627370496 "mantissa of 2.0" assert=

"float-parts: zero" test-section
0.0 float-parts 1 "sign of 0.0" assert= 0 "exponent of 0.0" assert= 0 "mantissa of 0.0" assert=

"float-parts: errors" test-section
[ nan float-parts ] "float-parts NaN throws" assert-error
[ inf float-parts ] "float-parts inf throws" assert-error

">integer for ratio" test-section
7 2 normalize-ratio >integer 3 "7/2 >integer = 3" assert=
-7 2 normalize-ratio >integer -3 "-7/2 >integer = -3" assert=
4 2 normalize-ratio >integer 2 "4/2 >integer (demoted) = 2" assert=

">float for ratio" test-section
1 2 normalize-ratio >float 0.5 "1/2 >float = 0.5" assert=
1 4 normalize-ratio >float 0.25 "1/4 >float = 0.25" assert=

"float-approx-ratio" test-section
0.5 float-approx-ratio 1 2 normalize-ratio "0.5 -> 1/2" assert=
0.25 float-approx-ratio 1 4 normalize-ratio "0.25 -> 1/4" assert=
0.1 float-approx-ratio 1 10 normalize-ratio "0.1 -> 1/10" assert=
0.0 float-approx-ratio 0 "0.0 -> 0" assert=
-0.5 float-approx-ratio -1 2 normalize-ratio "-0.5 -> -1/2" assert=
1.0 float-approx-ratio 1 "1.0 -> 1" assert=
0.333333333333333 float-approx-ratio 1 3 normalize-ratio "0.333... -> 1/3" assert=

"float>ratio: exact" test-section
0.5 float>ratio 1 2 normalize-ratio "0.5 float>ratio = 1/2" assert=
0.25 float>ratio 1 4 normalize-ratio "0.25 float>ratio = 1/4" assert=
1.0 float>ratio 1 "1.0 float>ratio = 1" assert=
-1.0 float>ratio -1 "-1.0 float>ratio = -1" assert=
2.0 float>ratio 2 "2.0 float>ratio = 2" assert=

"float>ratio: 0.1 is not 1/10" test-section
0.1 float>ratio 1 10 normalize-ratio /= "0.1 float>ratio /= 1/10" assert-true
0.1 float>ratio ratio? "0.1 float>ratio is a ratio" assert-true
