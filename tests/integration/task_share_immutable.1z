use "testing" ;

\ Cross-worker sharing of self-contained immutable containers.
\
\ A hash or set built at runtime holds only fixnums, so cross-task transfer
\ shares the backing by refcount bump instead of deep-copying. Sharing must be
\ unobservable: the receiver reads the same values, and the shared backing
\ stays valid for as long as any holder references it.

test-await-shares-hash: ( -- ) [
  [
    [ H{ } a: 1 @set b: 2 @set ] spawn await
    dup a: @get 1 "awaited hash first value" assert=
    b: @get 2 "awaited hash second value" assert=
  ] task-scope
] ;

test-await-shares-set: ( -- ) [
  [
    [ S{ } 7 @adjoin ] spawn await
    7 @in? "awaited set contains its member" assert-true
  ] task-scope
] ;

test-await-all-shares-hashes: ( -- ) [
  [
    [ H{ } n: 1 @set ] spawn
    [ H{ } n: 2 @set ] spawn
    2 array-n await-all
    dup 0 #nth n: @get 1 "await-all first shared hash" assert=
    1 #nth n: @get 2 "await-all second shared hash" assert=
  ] task-scope
] ;

\ A runtime-built array of scalars lives on the process-lifetime allocator,
\ so the await shares its backing by refcount bump.
test-await-shares-array: ( -- ) [
  [
    [ { 1 2 } 3 #push ] spawn await
    dup #len 3 "awaited array length" assert=
    dup 0 #nth 1 "awaited array first element" assert=
    2 #nth 3 "awaited array pushed element" assert=
  ] task-scope
] ;

\ A literal array's backing lives on instruction memory, so it crosses the
\ boundary by deep copy; the received values are identical either way.
test-await-copies-literal-array: ( -- ) [
  [
    [ { 4 5 6 } ] spawn await
    { 4 5 6 } "awaited literal array" assert=
  ] task-scope
] ;

\ A literal array's backing lives on instruction memory, but freeze rebuilds
\ it onto the process-lifetime allocator, so the frozen literal qualifies for
\ sharing and stays valid after the sending task is reaped.
test-await-shares-frozen-literal: ( -- ) [
  [
    [ { 1 2 3 } freeze ] spawn await
    { 1 2 3 } "awaited frozen literal array" assert=
  ] task-scope
] ;

\ A frozen value holding strings stays on the deep-copy path; the received
\ values read identically either way.
test-await-copies-frozen-strings: ( -- ) [
  [
    [ V{ } "a" #push! freeze ] spawn await
    dup #len 1 "awaited frozen string array length" assert=
    0 #nth "a" "awaited frozen string element" assert=
  ] task-scope
] ;

test-await-shares-hash
test-await-shares-set
test-await-all-shares-hashes
test-await-shares-array
test-await-copies-literal-array
test-await-shares-frozen-literal
test-await-copies-frozen-strings
