\ Integration tests for to-string primitive and . (dot) word

"lib/testing.1z" load

"to-string on integers" test-section
42 to-string "42" "integer" assert=
-7 to-string "-7" "negative integer" assert=
0 to-string "0" "zero" assert=

"to-string on booleans" test-section
t to-string "t" "true" assert=
f to-string "f" "false" assert=

"to-string on strings" test-section
\ Strings get quoted, so "hello" becomes "\"hello\"" (7 chars)
"hello" to-string #len 7 "string length includes quotes" assert=
"" to-string #len 2 "empty string length" assert=

"to-string on symbols" test-section
foo: to-string "foo:" "symbol" assert=

"to-string on arrays" test-section
{ } to-string "{ }" "empty array" assert=
{ 1 2 3 } to-string "{ 1 2 3 }" "array of integers" assert=
{ "a" "b" } to-string #len 11 "array of strings length" assert=

"to-string on quotations" test-section
[ 1 2 + ] to-string "[ 1 2 + ]" "quotation" assert=
[ ] to-string "[ ]" "empty quotation" assert=

"to-string on nested structures" test-section
{ { 1 } { 2 } } to-string "{ { 1 } { 2 } }" "nested arrays" assert=

"dot word" test-section
\ Test . (dot) outputs to-string result and consumes value
42 .
\ Stack should be empty after . - verify by pushing and checking
99 99 "dot consumes value" assert=

"to-string with #append" test-section
"Value: " 42 to-string #append "Value: 42" "simple append" assert=
"Result: " 100 to-string #append " items" #append "Result: 100 items" "chained append" assert=

"to-string on hash" test-section
H{ a: 1 } to-string
dup 0 2 #slice "H{" "hash prefix" assert=
#last "}" "hash suffix" assert=

"to-string preserves types" test-section
{ 1 2 } to-string "{ 1 2 }" "mixed array" assert=

"All to-string tests complete!" print
