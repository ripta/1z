use "testing" ;

"native spawn-process inherited stdio" test-section

[
  { "/bin/sh" "-c" "exit 0" } inherit: inherit: inherit: native.spawn-process
  f "stderr inherit returns false" assert=
  f "stdout inherit returns false" assert=
  f "stdin inherit returns false" assert=
  native.wait-pid 0 "wait-pid returns zero for successful child" assert=
] call

"native spawn-process piped stdout" test-section

[
  { "/bin/sh" "-c" "printf 'hello\\n'" } inherit: pipe: inherit: native.spawn-process
  f "stderr inherit returns false when stdout is piped" assert=
  dup stream-read-line "hello" "piped stdout is readable" assert=
  stream-close
  f "stdin inherit still returns false" assert=
  native.wait-pid 0 "wait-pid still returns zero after reading stdout" assert=
] call

"native kill-pid" test-section

[
  { "/bin/sh" "-c" "sleep 30" } inherit: inherit: inherit: native.spawn-process
  f "stderr inherit returns false for kill test" assert=
  f "stdout inherit returns false for kill test" assert=
  f "stdin inherit returns false for kill test" assert=
  dup 15 native.kill-pid
  native.wait-pid 143 "signal termination maps to 128 + signal" assert=
] call

"native spawn-process errors" test-section

[ { "/bin/sh" "-c" "exit 0" } bogus: inherit: inherit: native.spawn-process ]
type-mismatch: "invalid stdio symbol throws type-mismatch" assert-error-type

[ { "/bin/sh" 42 } inherit: inherit: inherit: native.spawn-process ]
type-mismatch: "non-string argv element throws type-mismatch" assert-error-type

[ { } inherit: inherit: inherit: native.spawn-process ]
type-mismatch: "empty argv throws type-mismatch" assert-error-type

"sandbox process capability" test-section

sandbox{ process } inspect "sandbox{ process }" "process sandbox display" assert=

[ sandbox{ } [ { "/bin/sh" "-c" "exit 0" } inherit: inherit: inherit: native.spawn-process ] with-sandbox ]
permission-denied: "empty sandbox denies spawn-process" assert-error-type

sandbox{ process } [
  { "/bin/sh" "-c" "exit 0" } inherit: inherit: inherit: native.spawn-process
  drop drop drop
  native.wait-pid
] with-sandbox
0 "process sandbox grants spawn-process" assert=

sandbox{ io } [
  { "/bin/sh" "-c" "exit 0" } inherit: inherit: inherit: native.spawn-process
  drop drop drop
  native.wait-pid
] with-sandbox
0 "io sandbox also grants process" assert=
