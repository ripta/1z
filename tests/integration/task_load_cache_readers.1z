\ Cross-cutting concurrency smoke test for runtime loads: task-context readers
\ hammer the cache-hit path of `load` and generic-dispatch resolution while the
\ main task inserts six fresh modules into the cache. Cache-miss loads overlap
\ task-side bare-word resolution across workers, pinning that a load's live
\ import frame stays above the durable floor and out of every other task's
\ ancestor walk. The reader is a scope-local word on purpose: a task executing
\ one used to poison the next load's dispatch ids, and this keeps that fix
\ covered under concurrency.

use "testing" ;

"cache readers during main-task loads" test-section

\ Prime the readers' module so every load in the tasks below is a hit.
"./task_load_cache_readers_hit_mod.1z" load drop

[
  done: 3 <buffered-channel> ;
  reader: ( -- ) [
    200 [
      "./task_load_cache_readers_hit_mod.1z" load
      hit-mod-word: @get call drop
      20 [ H{ } x: @has? drop ] times
    ] times
    t done send
  ] ;
  [ reader ] spawn drop
  [ reader ] spawn drop
  [ reader ] spawn drop
  { "math" "strings" "char" "bytes" "sets" "ranges" } [ load drop ] #each
  done receive drop
  done receive drop
  done receive drop
] task-scope

"./task_load_cache_readers_hit_mod.1z" load
hit-mod-word: @get call "hit" "the hit module still works after the reader storm" assert=

use "math" ;
2.7 floor 2.0 "a module loaded during the reader storm answers" assert=
