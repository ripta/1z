\ A definition mints a fresh dispatch id, so the entries registered under the id the name used
\ to carry stop answering for it. A call site already warm on those entries has to notice.

use "testing" ;

"warm site after a redefinition" test-section

area: generic ( x -- n ) [ drop 0 ] ;
area: method{ fixnum } [ drop 42 ] ;
call-area: ( x -- n ) [ area ] ;

\ Warm the polymorphic inline cache at call-area's `area` site.
50 [ 1 call-area drop ] times
1 call-area 42 "warm site dispatches the registered method" assert=

\ The redefinition registers no method, so the definition is the only thing that can invalidate.
area: generic ( x -- n ) [ drop 7 ] ;
1 call-area 7 "warm site runs the redefinition's fallthrough" assert=

\ The site rewarms rather than staying dead.
area: method{ fixnum } [ drop 9 ] ;
1 call-area 9 "warm site dispatches a method registered after the redefinition" assert=
50 [ 1 call-area drop ] times
1 call-area 9 "rewarmed site keeps dispatching the new method" assert=

"native dispatch survives the flush" test-section

3 4 + 7 "native arithmetic after the flush" assert=
{ 1 2 3 } #len 3 "native sequence dispatch after the flush" assert=
