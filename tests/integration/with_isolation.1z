\ Test with-isolation combinator

use "testing" ;

"isolation discards types" test-section

\ Define a virtual type inside isolation; it should not be visible after
[ color: virtual{ string } ;
] with-isolation
[ "red" >color ] "type defined in isolation is not visible after" assert-error

"isolation discards dispatch" test-section

\ Register a method inside isolation; verify it works inside but is gone after
my-op: generic ( a -- b ) [ ] ;
[
  my-op: method{ fixnum } [ 1 + ] ;
  43 42 my-op "dispatch works inside isolation" assert=
] with-isolation
[ 42 my-op ] "dispatch registered in isolation is gone after" assert-error

"stack values survive" test-section

[ 1 2 3 ] with-isolation
3 "third value survives isolation" assert=
2 "second value survives isolation" assert=
1 "first value survives isolation" assert=

"error propagation cleans up frames" test-section

[
  [
    temp-type: virtual{ fixnum } ;
    f "oops" EUserThrown make-error throw
  ] with-isolation
] "error propagates out of isolation" assert-error
\ After error, isolation frames should be cleaned up; defining a new type should work
post-error-type: virtual{ string } ;
"hello" >post-error-type type-name "post-error-type" "types work after isolation error" assert=

"outer registries visible inside" test-section

outer-type: virtual{ fixnum } ;
[
  42 >outer-type type-name "outer-type" "outer type visible inside isolation" assert=
] with-isolation

"dangling reference detection" test-section

\ Tagged value of isolated type with declared effect -> error
[
  [ ( -- x ) iso-type: virtual{ fixnum } ;
    42 >iso-type
  ] with-isolation
] "isolated tagged value with effect triggers error" assert-error

\ No declared effect with isolated tagged value -> no error (passthrough)
[
  iso-pass: virtual{ fixnum } ;
  42 >iso-pass
] with-isolation
type-name "iso-pass" "no-effect passthrough allows isolated type" assert=

\ Plain value output with types defined in isolation -> no error
[
  [ ( -- x ) plain-inner: virtual{ fixnum } ;
    99
  ] with-isolation
] [ drop ] recover
99 swap "plain value survives even with isolated types" assert=

\ Outer-scope type in output -> no error
outer-val-type: virtual{ string } ;
"hi" >outer-val-type
[ ( a -- a ) ] with-isolation
"outer-val-type" swap type-name "outer type in output is allowed" assert=

\ Enum variant of isolated enum with declared effect -> error
[
  [ ( -- x ) iso-color: enum{ red: green: blue: } ;
    iso-color:red
  ] with-isolation
] "isolated enum variant with effect triggers error" assert-error

\ Nested tagged value inside array with declared effect -> error
[
  [ ( -- x ) nested-type: virtual{ fixnum } ;
    1 >nested-type V{ } swap #push!
  ] with-isolation
] "nested isolated type in vector triggers error" assert-error
