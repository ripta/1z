\ Test that parse-time word pushes a marker
\ and that ; can define words with both marker and stack effect

use "testing" ;

"parse-time marker" test-section

\ Define a regular word (not parse-time)
regular-word: [ 42 ] ;
regular-word 42 "regular word" assert=

\ Define a parse-time word
my-macro: parse-time [ 100 ] ;
my-macro 100 "parse-time word" assert=

\ Define a parse-time word with stack effect
another-macro: parse-time ( -- n ) [ 200 ] ;
another-macro 200 "parse-time with stack effect" assert=
