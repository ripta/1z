use "testing" ;
use "doc/extract" ;
use "os/fs" ;
use "os/path" ;

\ Note: a doc-comment is two literal backslashes (`\\`). In a 1z string literal
\ each backslash is escaped, so a doc-comment line is written as `\\\\` here.

(write-file): ( content path -- ) [
  write: stream-open
  dup -rot> [ print ] with-output-stream
  stream-close
] ;

\ --- Single definition ---

"single definition line" test-section

"add: [ + ] ;\n" extract-definition-lines
"add" @get 1 "definition on line 1" assert=

\ --- Multiple definitions at distinct lines ---

"multiple definitions" test-section

"foo: [ ] ;\nbar: [ ] ;\nbaz: [ ] ;\n" extract-definition-lines
dup "foo" @get 1 "foo on line 1" assert=
dup "bar" @get 2 "bar on line 2" assert=
"baz" @get 3 "baz on line 3" assert=

\ --- Undocumented definition still gets a line ---

"undocumented definition" test-section

"\nq: [ ] ;\n" extract-definition-lines
"q" @get 2 "undocumented definition gets a line" assert=

\ --- Documented definition: line is the definition, not the doc-comment ---

"documented definition line" test-section

"\\\\ doc.\nwidget: [ ] ;\n" extract-definition-lines
"widget" @get 2 "line points at the definition, not its doc-comment" assert=

\ --- Symbol literal in a body does not shadow the real definition ---

"symbol literal does not shadow" test-section

"bar: [ foo: @get ] ;\nfoo: [ 1 ] ;\n" extract-definition-lines
dup "bar" @get 1 "bar on line 1" assert=
"foo" @get 2 "foo recorded at its real definition, not the body literal" assert=

\ --- A private block does not swallow what follows it ---

"definitions after a private block" test-section

"a: [ 1 ] ;\nprivate{\n  helper: [ 2 ] ;\n}\nb: [ 3 ] ;\n" extract-definition-lines
dup "a" @get 1 "definition before the block" assert=
dup "b" @get 5 "definition after the block" assert=
"helper" @has? f "a private-block definition is not top-level" assert=

\ --- Nested and repeated blocks stay balanced ---

"repeated blocks stay balanced" test-section

"private{\n  h: [ ] ;\n}\nc: [ ] ;\nprivate{\n  i: [ ] ;\n}\nd: [ ] ;\n"
extract-definition-lines
dup "c" @get 4 "definition between two blocks" assert=
"d" @get 8 "definition after the second block" assert=

\ --- Hash-literal keys are not definitions ---

"hash keys are not definitions" test-section

"cfg: [ H{ kind: 1 first: 2 } ] ;\nfirst: [ 9 ] ;\n" extract-definition-lines
dup "kind" @has? f "a hash key is not a definition" assert=
"first" @get 2 "a later real definition is not shadowed by a hash key" assert=

\ --- ffi-def entries are definitions ---

"ffi-def entries are definitions" test-section

"a: [ 1 ] ;\nffi-def{\n  plain: \"c_plain\" ffi{ ptr -> i32 }\n}\nb: [ 2 ] ;\n"
extract-definition-lines
dup "plain" @get 3 "an ffi-def entry is recorded" assert=
dup "a" @get 1 "definition before the ffi-def block" assert=
"b" @get 5 "definition after the ffi-def block" assert=

\ --- Parenthesized definition name ---

"parenthesized definition name" test-section

"(paren): [ 1 ] ;\nplain: [ 2 ] ;\n" extract-definition-lines
dup "(paren)" @get 1 "a parenthesized name is recorded" assert=
"plain" @get 2 "a plain name beside it is unaffected" assert=

\ A stack effect on the same definition is still a stack effect.

"(paren): ( a -- b ) [ ] ;\n" extract-definition-lines
dup "(paren)" @get 1 "a parenthesized name with a stack effect" assert=
#len 1 "the stack effect is not recorded as a definition" assert=

\ --- Reading from a file ---

"line extraction from a file" test-section

[
  "sample.1z" path-join
  dup
  "\nffoo: [ ] ;\n" swap (write-file)
  extract-definition-lines-from-file
  "ffoo" @get 2 "line extracted from a source file on disk" assert=
] using-temp-directory
