10 double .

\ === Module without import ===
"Module without import" test-section

[
    "tests/integration/load_lib.1z" load drop
    \ add3 should NOT be visible here since we only loaded, not imported
    5 add3
] [ drop "add3 not visible - correct" . ] recover

