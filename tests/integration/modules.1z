\ Module system tests

use "testing" ;

\ === Module as value ===
"Module as value" test-section

"module_lib.1z" load
\ Stack should have module on it
dup inspect .

\ === Import brings words into scope ===
"Import brings words into scope" test-section

import
5 double .
4 triple .
3 squared .

\ === Multiple imports ===
"Multiple imports" test-section

use "module_lib.1z" shadow-ok ;
10 double .

\ === Module without import ===
"Module without import" test-section

[
  "load_lib.1z" load drop
  \ add3 should NOT be visible here since we only loaded, not imported
  5 add3
] [ drop "add3 not visible - correct" . ] recover
wipe

\ === Module stored in variable ===
"Module stored in variable" test-section

"module_lib.1z" load
math: swap ;
math import
7 double .

\ === use shorthand ===
"use shorthand" test-section

use "module_lib.1z" shadow-ok ;
8 double .

\ === Qualified name access ===
"Qualified name access" test-section

mymath: "module_lib.1z" load ;
5 mymath.double .
3 mymath.triple .
4 mymath.squared .

\ === Qualified name with nested path ===
"Qualified name without import" test-section

\ Verify that qualified access works without importing
other: "module_lib.1z" load ;
10 other.double .

\ Verify double is NOT in scope (we didn't import 'other')
[
  \ This would fail if double was somehow imported
  100 quadruple
] [ drop "quadruple not visible - correct" . ] recover
wipe

\ === Module accessors ===
"Module accessors @has?" test-section

testmod: "module_lib.1z" load ;
testmod double: @has? t "module @has? existing word" assert=
testmod "double" @has? t "module @has? string key" assert=
testmod nonexistent: @has? f "module @has? missing word" assert=
testmod "nonexistent" @has? f "module @has? missing string key" assert=

"Module #len" test-section
testmod #len 3 "module #len" assert=

"Module accessors @keys" test-section

testmod @keys #len 3 "module @keys count" assert=

"Module accessors @get" test-section

\ Get word from module and execute it
testmod double: @get 5 swap call 10 "module @get and call" assert=
testmod "triple" @get 4 swap call 12 "module @get string key" assert=

\ Error on missing key
[ testmod missing: @get ] [ drop "PASS: @get on missing key errors" print-line ] recover

"Module @get-or" test-section
testmod double: "fallback" @get-or 5 swap call 10 "module @get-or existing word" assert=
testmod missing: "fallback" @get-or "fallback" "module @get-or missing word" assert=

\ === Selective import tests ===
"Selective import" test-section

selmod: "module_lib.1z" load ;
selmod { double: } import
5 double 10 "selective import double" assert=

"Selective import multiple" test-section

selmod2: "module_lib.1z" load ;
selmod2 { double: triple: } import
6 double 12 "selective import multiple - double" assert=
3 triple 9 "selective import multiple - triple" assert=

"Selective use" test-section

use { squared: } "module_lib.1z" shadow-ok ;
4 squared 16 "selective use squared" assert=

"Selective use multiple" test-section

use { double: triple: } "module_lib.1z" shadow-ok ;
7 double 14 "selective use multiple - double" assert=
2 triple 6 "selective use multiple - triple" assert=

"Selective import errors" test-section

\ Empty array
errmod: "module_lib.1z" load ;
[ errmod { } import ] [ error-type: @get empty-import: "empty array error" assert= ] recover

\ Non-existent word
[ errmod { nonexistent: } import ] [ error-type: @get EKeyNotFound "missing word error" assert= ] recover

\ Non-symbol in array
[ errmod { 123 } import ] [ error-type: @get ETypeMismatch "non-symbol error" assert= ] recover

\ Integer instead of module
[ 42 { double: } import ] [ error-type: @get ETypeMismatch "integer instead of module error" assert= ] recover
