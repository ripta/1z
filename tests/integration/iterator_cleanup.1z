use "testing" ;

\ Helper: counter generator yielding 1, 2, 3 then stopping.
counter3-gen: ( -- quot ) [
  [ n: 0 ] make-mutable-map
  [
    dup n: @get 1 +
    dup 3 > [
      2drop option:none
    ] [
      swap over n: swap @set! drop
      >option:some
    ] if
  ] curry
] ;

\ Helper: counter generator yielding 1, 2, 3, 4, 5 then stopping.
counter5-gen: ( -- quot ) [
  [ n: 0 ] make-mutable-map
  [
    dup n: @get 1 +
    dup 5 > [
      2drop option:none
    ] [
      swap over n: swap @set! drop
      >option:some
    ] if
  ] curry
] ;

"Auto-cleanup on full consumption" test-section

[ cleaned: f ] make-mutable-map
dup [ cleaned: t @set! drop ] curry
counter3-gen swap
>iterator(with-cleanup)
#collect
{ 1 2 3 } "collected all items" assert=
cleaned: @get "cleanup ran after full consumption" assert-true

"Cleanup does not run on adapter-level exhaustion" test-section

[ cleaned: f ] make-mutable-map
dup [ cleaned: t @set! drop ] curry
counter5-gen swap
>iterator(with-cleanup)
3 #take #collect
{ 1 2 3 } "took 3 items" assert=
cleaned: @get not "cleanup did not run via #take" assert-true

"Cleanup idempotency" test-section

[ count: 0 ] make-mutable-map
dup [ dup count: @get 1 + count: swap @set! drop ] curry
counter3-gen swap
>iterator(with-cleanup)
dup #collect drop
dup #next? option:none? "second #next? returns none" assert-true
#next? option:none? "third #next? returns none" assert-true
count: @get 1 "cleanup ran exactly once" assert=

"No cleanup quotation" test-section

counter3-gen >iterator
#collect
{ 1 2 3 } "single-quotation >iterator still works" assert=

"Cleanup on immediately-empty iterator" test-section

[ cleaned: f ] make-mutable-map
dup [ cleaned: t @set! drop ] curry
[ option:none ] swap
>iterator(with-cleanup)
#next? option:none? "first #next? returns none" assert-true
cleaned: @get "cleanup ran on empty iterator" assert-true
