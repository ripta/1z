\ An inline guard in compiled code leaves the stack the interpreter leaves, and the stack owns every
\ slot it leaves. Nothing here sets a compile flag, so the eager pass checks the compiled run against
\ the interpreted golden. The empty stderr golden catches a leak or a double release at teardown.

use "testing" ;

money:   virtual{ fixnum } ;
point:   struct{ x y } ;
segment: struct{ x len } ;

heap: ( -- s ) [ "hel" "lo" #append ] ;
absolute: ( n -- m ) [ abs ] ;
drop-then-abs: ( n s -- m ) [ drop abs ] ;
point-x:       ( p -- x )   [ x>> ] ;
warm-point-x:  ( n -- )     [ [ 1 2 make-point point-x drop ] times ] ;

"abs of minInt promotes" test-section
-5 absolute 5 "fixnum" assert=
-9223372036854775808 absolute inspect "9223372036854775808" "minInt" assert=
-9223372036854775808 heap drop-then-abs inspect "9223372036854775808" "after dropping a heap string" assert=

"a type mismatch raised by an inline unwrap" test-section
heap heap [ unmake-money ] [ drop "caught" ] recover "caught" "handler ran" assert=
"hello" "string below the raise" assert=

"a struct field read on the wrong operand" test-section
300 warm-point-x
heap 3 4 make-segment point-x 3 "another struct with the field" assert=
"hello" "string below the read" assert=
heap heap [ point-x ] [ drop "caught" ] recover "caught" "handler ran" assert=
"hello" "operand left by the failed dispatch" assert=
"hello" "string below the raise" assert=
