\ Integration tests for socket primitives and networking

use "testing" ;
use "net" ;
use "tcp" ;
use "server" ;

"split-host-port basic" test-section
"127.0.0.1:8080" split-host-port 8080 "port from host:port" assert=
"127.0.0.1" "host from host:port" assert=

"0.0.0.0:443" split-host-port 443 "port 443" assert=
"0.0.0.0" "host 0.0.0.0" assert=

"localhost:3000" split-host-port 3000 "port from localhost" assert=
"localhost" "host localhost" assert=

"split-host-port error cases" test-section
[ "no-port" split-host-port ] [ drop "PASS: missing port error" print-line ] recover

"addr construction" test-section
"127.0.0.1" 8080 >addr:tcp
dup addr:tcp? t "addr:tcp? predicate" assert=
dup addr:udp? f "not addr:udp?" assert=
drop

"/tmp/test.sock" >addr:unix
dup addr:unix? t "addr:unix? predicate" assert=
drop

"resolve on IP address" test-section
"127.0.0.1" 8080 >addr:tcp resolve
dup #len 1 "resolve returns 1 address for IP" assert=
#first addr:tcp? t "resolved addr is addr:tcp" assert=

"socket lifecycle" test-section
"127.0.0.1" 0 >addr:tcp
dup socket
dup 0 > t "socket returns positive fd" assert=
swap resolve #first
over swap bind
dup 128 listen
fd-close
"PASS: socket lifecycle (create, bind, listen, close)" print-line

"fd-close" test-section
"127.0.0.1" 0 >addr:tcp socket
dup 0 > t "socket fd is positive" assert=
fd-close
"PASS: fd-close" print-line

"tcp-listen and tcp-close" test-section
"127.0.0.1" 0 >addr:tcp 128 tcp-listen
dup tcp-server? t "tcp-listen returns tcp-server" assert=
tcp-close
"PASS: tcp-listen and tcp-close" print-line

"connect and accept" test-section
[
  "127.0.0.1" 39282 >addr:tcp resolve #first
  dup socket
  dup 2 pick-n bind
  dup 128 listen
  swap drop  \ server-fd

  \ Spawn accept task: accept, close client, return the peer addr
  dup [
    accept drop fd-close
  ] curry spawn  \ server-fd task

  \ Client: connect then close
  "127.0.0.1" 39282 >addr:tcp resolve #first
  dup socket
  dup <rot- connect  \ server-fd task client-fd
  fd-close           \ server-fd task

  \ Await the accept task to ensure it completes
  await drop  \ server-fd
  fd-close
] task-scope
"PASS: connect and accept" print-line

"echo server" test-section
[
  "127.0.0.1" 39283 >addr:tcp resolve #first
  dup socket
  dup 2 pick-n bind
  dup 128 listen
  swap drop  \ server-fd

  \ Spawn accept+echo task: accept, read line, write it back, close
  dup [
    accept drop                  \ client-fd
    fd>stream                    \ stream
    dup stream-read-line         \ stream line
    over swap stream-write drop  \ stream
    stream-close
  ] curry spawn  \ server-fd task

  \ Client: connect, write, read
  "127.0.0.1" 39283 >addr:tcp resolve #first
  dup socket
  dup <rot- connect  \ server-fd task client-fd
  fd>stream          \ server-fd task client-stream

  dup "hello\n" stream-write drop
  dup 5 stream-read  \ server-fd task client-stream data
  #len 5 "echoed 5 bytes" assert=

  stream-close  \ server-fd task
  await drop    \ server-fd
  fd-close
] task-scope
"PASS: echo server" print-line

"server-config defaults" test-section
<server-config>
dup host>> "0.0.0.0" "default host" assert=
dup port>> 0 "default port" assert=
dup backlog>> 128 "default backlog" assert=
drop
"PASS: server-config defaults" print-line

"start-server" test-section
<server-config> "127.0.0.1" >>host 39284 >>port
start-server
dup tcp-server? t "start-server returns tcp-server" assert=
tcp-close
"PASS: start-server" print-line
