\ def-over-import guard tests: a definition landing on a same-scope imported word throws
\ import-conflict unless it claims the `override` marker.

use "testing" ;

"definition over an imported word" test-section

\ The colliding definition has to share the import's frame, so the collision runs at a loaded
\ module's own top level. A definition inside a quotation lands in the quotation's transient
\ frame, which the same-scope rule exempts.
[ "def_over_import_conflict.1z" load ]
EImportConflict "definition over import throws import-conflict" assert-error-type

"a quotation-nested definition is a new binding" test-section

use { taken: } "def_over_import_mod.1z" ;
[ taken: ( -- fixnum ) [ 1 ] ; taken ] call
1 "nested definition does not conflict" assert=
taken 7 "imported word unchanged after the nested binding pops" assert=

"override escapes the guard" test-section

taken: override ( -- fixnum ) [ 1 ] ;
taken 1 "override definition wins" assert=

"override escapes the guard for private words" test-section

private{ (helper): ( -- string ) [ "private" ] ; }
(helper): override ( -- string ) [ "public" ] ;
(helper) "public" "override definition wins over a private word" assert=

"generic-on-generic is exempt" test-section

\ The exemption skips the guard, not the write: unlike the import path, which drops the
\ incoming binding, the definition still defines and wins.
use { gpick: } "def_over_import_generic_mod.1z" ;
gpick: generic ( a -- b ) [ drop 2 ] ;
0 gpick 2 "generic definition over a generic import defines and wins" assert=

"asymmetric generic collisions still throw" test-section

[ "def_over_import_generic_over_plain_conflict.1z" load ]
EImportConflict "generic definition over a plain import throws" assert-error-type

[ "def_over_import_plain_over_generic_conflict.1z" load ]
EImportConflict "plain definition over a generic import throws" assert-error-type
