use "testing" ;
use "posix" ;

\ A caught stack overflow carries the figures its message prints as a keyed payload.
\
\ A task failure crossing the scope boundary keeps its payload, whether the raise site set it or a
\ thrown error carried it.
\
\ A caught type mismatch names the expected type and the offending operand's type, and an arithmetic
\ mismatch names both operands' types.

deep: stack-recursive ( n -- n ) [ dup 0 > [ 1 - deep 1 + ] when ] ;

check-overflow-payload: ( data -- ) [
  dup used: @get fixnum? "used is a fixnum" assert-true
  dup used: @get 0 > "used counts the bytes in use" assert-true
  dup limit: @get fixnum? "limit is a fixnum" assert-true
  dup size: @get fixnum? "size is a fixnum" assert-true
  dup limit: @get swap size: @get <= "the guard limit sits within the stack size" assert-true
] ;

test-caught-overflow-payload: ( -- ) [
  [ 1000000 deep drop ] [
    data: @get
    dup check-overflow-payload
    dup grow-to: @has? "the main thread never grows, so it names no growth target" assert-false
    limit: @get stack-budget? "the guard limit is the figure stack-budget? reports" assert=
  ] recover
] ;

test-task-overflow-payload: ( -- ) [
  [
    [ [ 100000000 deep drop ] spawn drop ] task-scope
    f "scope should have thrown" assert-true
  ] [
    dup error-type: @get stack-overflow: "task overflow keeps its type" assert=
    data: @get check-overflow-payload
  ] recover
] ;

test-task-thrown-payload: ( -- ) [
  [
    [ [ -1 "LOCK_EX" posix-const flock drop ] spawn drop ] task-scope
    f "scope should have thrown" assert-true
  ] [
    dup error-type: @get posix-error: "task posix failure keeps its type" assert=
    data: @get name: @get ebadf: "a thrown payload crosses the scope boundary" assert=
  ] recover
] ;

test-type-mismatch-payload: ( -- ) [
  [ 3 "a" #take ] [
    dup message: @get "expected fixnum, got string \"a\"" "the message is unchanged" assert=
    data: @get
    dup expected: @get "fixnum" "expected names the wanted type" assert=
    actual: @get string "actual is the offending value's type" assert=
  ] recover
] ;

test-number-operand-payload: ( -- ) [
  [ "a" 1 + ] [
    data: @get
    dup expected: @get "number" "arithmetic expects a number" assert=
    dup actual: @get string "actual is the non-numeric operand's type" assert=
    dup left: @get string "left is the first operand's type" assert=
    right: @get fixnum "right is the second operand's type" assert=
  ] recover
] ;

test-ordering-payload: ( -- ) [
  [ "a" 1 < ] [
    data: @get
    dup expected: @get "fixnum or float" "ordering expects a real number" assert=
    actual: @get string "ordering names the first operand's type" assert=
  ] recover
] ;

test-sort-by-drops-mismatch-payload: ( -- ) [
  [ { 1 "a" } [ ] #sort-by ] [
    dup error-type: @get not-comparable: "incomparable keys raise not-comparable" assert=
    data: @get f "not-comparable carries no type-mismatch payload" assert=
  ] recover
] ;

test-task-type-mismatch-payload: ( -- ) [
  [
    [ [ "a" 1 + drop ] spawn drop ] task-scope
    f "scope should have thrown" assert-true
  ] [
    data: @get left: @get string "a task's type mismatch keeps its payload" assert=
  ] recover
] ;

\ A resource kind seen first inside a task gets a type value that outlives the task, so the scope
\ reads the same type the main task resolves afterwards.
test-task-resource-type-payload: ( -- ) [
  [
    [ [ 3 "task-only-kind" <test-resource> #take ] spawn drop ] task-scope
    f "scope should have thrown" assert-true
  ] [
    data: @get actual: @get
    dup >string "<type:task-only-kind>" "the payload names the task's resource kind" assert=
    "task-only-kind" <test-resource> type-of "the task's type is the one main resolves" assert=
  ] recover
] ;

awaited-types: V{ } ;

test-awaited-resource-type: ( -- ) [
  [
    [ "awaited-kind" <test-resource> type-of ] spawn await awaited-types swap #push! drop
  ] task-scope
  awaited-types 0 #nth
  dup >string "<type:awaited-kind>" "an awaited type-of names the task's resource kind" assert=
  "awaited-kind" <test-resource> type-of "an awaited type-of is the one main resolves" assert=
] ;

test-raise-without-payload: ( -- ) [
  [ 1 0 / drop ] [ data: @get f "a raise with no payload keeps data f" assert= ] recover
] ;

test-caught-overflow-payload
test-task-overflow-payload
test-task-thrown-payload
test-type-mismatch-payload
test-number-operand-payload
test-ordering-payload
test-sort-by-drops-mismatch-payload
test-task-type-mismatch-payload
test-task-resource-type-payload
test-awaited-resource-type
test-raise-without-payload
