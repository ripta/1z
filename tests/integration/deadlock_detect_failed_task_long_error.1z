\ A user-thrown message longer than the dump's preview cap is truncated rather
\ than overflowing the line buffer and dropping the failed task's line.
\
\ Same shape as deadlock_detect_failed_task: the child fails after the
\ handshake, the cancelled body's shielded cleanup handler parks on a channel
\ with no sender, and the failed child stays tracked until the dump.

use "strings" ;
use "testing" ;
[
  go: 1 <buffered-channel> ;
  out: <channel> ;
  [ go receive drop f "A" 300 repeat EUserThrown make-error throw ] spawn drop
  [ t go send out receive drop ] [ out receive drop ] cleanup
] task-scope
