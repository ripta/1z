\ A helper that every call into its word defines again shares one compiled body across calls. Each
\ result below is what the interpreter gives. The `run` word makes its helper cross the hybrid
\ compile threshold while the helper's callee is the global word. A later call defines a frame word
\ of the same name after the helper, so the interpreter reaches that word, and the shared code must
\ not keep calling the global one.
use "testing" ;

helper: ( n -- n ) [ 100 + ] ;

run: ( count -- n ) [
  caller: ( n -- n ) [ helper 0 + ] ;
  [ 1 caller drop ] times
  helper: ( n -- n ) [ 1000 + ] ;
  1 caller
] ;

sum-pure: ( count -- n ) [
  inc: ( n -- n ) [ 3 + ] ;
  0 swap [ inc ] times
] ;

sum-rebound: ( count -- n ) [
  step: ( n -- n ) [ 1 + ] ;
  step: ( n -- n ) [ 2 + ] ;
  0 swap [ step ] times
] ;

sum-captured: ( k -- n ) [
  x: swap ;
  add-x: ( n -- n ) [ x + ] ;
  0 120 [ add-x ] times
] ;

200 [ 1 helper drop ] times

"a callee that a later call binds in the frame" test-section
0 run 1001 "a call that runs the helper only after the frame word exists" assert=
120 run drop
0 run 1001 "the same call after another call compiled the helper" assert=

"a helper without locals" test-section
150 sum-pure 450 "first call" assert=
150 sum-pure 450 "second call, reusing the compiled body" assert=
5 sum-pure 15 "a call too short to compile it" assert=

"a helper defined twice in one call" test-section
150 sum-rebound 300 "the later definition wins" assert=
150 sum-rebound 300 "and again in the next call" assert=

"a helper over a local that differs per call" test-section
1 sum-captured 120 "first local" assert=
2 sum-captured 240 "second local" assert=
3 sum-captured 360 "third local" assert=
