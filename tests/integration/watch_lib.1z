use "testing" ;
use "os/fs" ;
use "os/path" ;
use "os/watch" ;
use "time" ;

(write-text): ( path text -- ) [
  swap write: stream-open
  dup 2 pick-n stream-write drop
  stream-close
  drop
] ;

(with-supported-watch-file): ( quot -- ... ) [
  [
    dup "watched.txt" path-join
    swap drop
    dup "seed" (write-text)
    dup supports-event-watch? [
      swap call
    ] [
      drop
      drop
      "native event watch unsupported on this platform/filesystem" skip
    ] if
  ] with-temp-directory
] ;

"watcher type and probe" test-section

[
  <event-watcher>
  dup watcher? "<event-watcher> returns watcher virtual type" assert-true
  close-watcher
] [
  "event watcher creation unsupported on this platform" skip
] recover

[
  dup supports-event-watch? "supports-event-watch? succeeds on watched file" assert-true
  drop
] (with-supported-watch-file)

"next-event translates native events" test-section

[
  <event-watcher> [
    dup 2 pick-n add-watch drop
    over "changed" (write-text)
    next-event
    dup watch-event:modified? "file write produces modified event" assert-true
    unmake-watch-event:modified path>> swap "next-event preserves watched path" assert=
  ] with-watcher
] (with-supported-watch-file)

"polling watcher translates file changes" test-section

[
  <polling-watcher> [
    dup 2 pick-n add-watch drop
    over "changed again for polling" (write-text)
    next-event
    dup watch-event:modified? "polling watcher reports modified event" assert-true
    unmake-watch-event:modified path>> swap "polling watcher preserves watched path" assert=
  ] with-watcher
] (with-supported-watch-file)

"with-watcher closes on exit" test-section

[
  <event-watcher>
  [ dup ] with-watcher
  next-event
] use-after-close: "with-watcher closes returned watcher value" assert-error-type

"each forwards events to callback" test-section

[
  [
    <event-watcher> [
      dup 2 pick-n add-watch drop
      over "again" (write-text)
      [
        dup watch-event:modified? "each forwards modified event" assert-true
        unmake-watch-event:modified path>>
        3 pick-n
        "each forwards watched path"
        assert=
        f "stop each loop" EUserThrown make-error throw
      ] each
    ] with-watcher
  ] [ drop ] recover
  3drop
] (with-supported-watch-file)

"polling with-watcher closes on exit" test-section

[
  <polling-watcher>
  [ dup ] with-watcher
  next-event
] use-after-close: "with-watcher closes returned polling watcher value" assert-error-type

"add-watch-recursive with subdirs" test-section

[
  [
    dup supports-event-watch? [
      dup "sub1" path-join create-directory
      dup "sub2" path-join create-directory
      dup "sub1" path-join "nested" path-join create-directory

      <event-watcher> [
        over add-watch-recursive
        #len 4 "add-watch-recursive returns one id per directory" assert=
      ] with-watcher
    ] [
      drop
      "native event watch unsupported on this platform/filesystem" skip
    ] if
  ] with-temp-directory
] [ drop ] recover

"add-watch-recursive on flat dir" test-section

[
  [
    dup supports-event-watch? [
      <event-watcher> [
        over add-watch-recursive
        #len 1 "add-watch-recursive on flat dir returns one id" assert=
      ] with-watcher
    ] [
      drop
      "native event watch unsupported on this platform/filesystem" skip
    ] if
  ] with-temp-directory
] [ drop ] recover

"debounced-each delivers events" test-section

[
  [
    <event-watcher> [
      dup 2 pick-n add-watch drop
      over "changed for debounce" (write-text)
      100 milliseconds
      [
        dup watch-event:modified? "debounced-each delivers modified event" assert-true
        unmake-watch-event:modified path>>
        3 pick-n
        "debounced-each preserves watched path"
        assert=
        f "stop debounce loop" EUserThrown make-error throw
      ] debounced-each
    ] with-watcher
  ] [ drop ] recover
  3drop
] (with-supported-watch-file)
