\ Tests for >symbol and symbol >string conversion

use "testing" ;

"string to symbol" test-section
"foo" >symbol foo: ">symbol creates matching symbol" assert=
"hello-world" >symbol hello-world: ">symbol with hyphens" assert=
"+" >symbol +: ">symbol with operator char" assert=
"123" >symbol 123: ">symbol with digits" assert=

"symbol to string" test-section
foo: >string "foo" "symbol >string strips colon" assert=
hello-world: >string "hello-world" "symbol >string with hyphens" assert=

"roundtrip" test-section
foo: >string >symbol foo: "symbol>string>symbol roundtrip" assert=
"bar" >symbol >string "bar" "string>symbol>string roundtrip" assert=

">symbol error cases" test-section
[ "" >symbol ] "empty string rejected" assert-error
[ "hello world" >symbol ] "string with space rejected" assert-error
[ 42 >symbol ] "integer rejected" assert-error

">symbol enum variants" test-section
color:       enum{ red: unit green: unit blue: unit } ;
circle-data: struct{ radius } ;
rect-dims:   struct{ width height } ;
shape: enum{
  circle: circle-data
  point: unit
} ;
geom: enum{
  rect: rect-dims
  dot: unit
} ;

color:red >symbol red: "flat enum variant converts to symbol" assert=
color:green >symbol green: "another flat enum variant converts to symbol" assert=
shape:point >symbol point: "flat variant in mixed enum converts to symbol" assert=
[ 42 >shape:circle >symbol ] "data enum variant rejected" assert-error

">enum-name generated conversions" test-section
red: >color color:red ">color converts flat symbol to enum variant" assert=
point: >shape shape:point ">shape converts mixed flat symbol to enum variant" assert=
color:red >symbol >color color:red "flat enum roundtrip through symbol" assert=
[ purple: >color ] "unknown flat variant symbol rejected" assert-error
[ circle: >shape ] "data-carrying variant symbol rejected" assert-error
[ rect: >geom ] "multi-field data variant symbol rejected" assert-error
[ "red" >color ] "string input rejected by >color" assert-error
[ 42 >color ] "non-symbol input rejected by >color" assert-error

">quotation from string" test-section
greet: [ "hello" ] ;
"greet" >quotation call "hello" ">quotation from string then call" assert=

">quotation from symbol" test-section
greet: >quotation call "hello" ">quotation from symbol then call" assert=

">quotation with native word" test-section
1 2 "+" >quotation call 3 ">quotation with native +" assert=

">quotation with nonexistent word" test-section
[ "no-such-word" >quotation call ] "nonexistent word fails on call" assert-error

">quotation sees quotation-local definitions" test-section
[
  my-local: 99 ;
  "my-local" >quotation call 99 ">quotation resolves local in same frame" assert=
] call

">quotation sees outer local from nested call" test-section
[
  my-outer: 77 ;
  [ "my-outer" >quotation call ] call 77 ">quotation resolves outer local from inner call" assert=
] call

">quotation cannot see locals after frame exits" test-section
[
  \ the inner call defines ephemeral, creates >quotation quotation, then its frame exits
  \ the second call tries to execute it but ephemeral is no longer in scope
  [ [ ephemeral: 42 ;
      "ephemeral" >quotation
    ] call call
  ]
  "local not visible after frame exit" assert-error
] call

">quotation resolves at call time not creation time" test-section
[
  "late-bind" >quotation
  late-bind: 123 ;
  call 123 ">quotation resolves word defined after >quotation" assert=
] call
