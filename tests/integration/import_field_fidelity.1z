\ Regression test: a word must keep its doc comment and its `parse-time-only` restriction across
\ every route that crosses a module boundary, not just its compiled body. Each conversion between
\ a module's word and a definition once carried a hand-listed subset of the fields, and each list
\ drifted on its own.

use "testing" ;
use "./import_field_fidelity_helper.1z" ;

"import field fidelity" test-section

documented-word: >word-info doc>>
"A word whose doc comment must survive a `use` import."
"imported word keeps its doc comment" assert=

[ [ pt-only-word ] call ]
parse-error: "imported parse-time-only word cannot be called at runtime" assert-error-type

[ call-private-pt-only ]
parse-error: "a module's private parse-time-only word cannot be called at runtime" assert-error-type

"qualified access" test-section

helper: "./import_field_fidelity_helper.1z" load ;

helper.documented-word: >word-info doc>>
"A word whose doc comment must survive a `use` import."
"qualified word keeps its doc comment" assert=

[ [ helper.pt-only-word ] call ]
parse-error: "qualified parse-time-only word cannot be called at runtime" assert-error-type
