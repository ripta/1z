use "testing" ;

"capture and runtime use" test-section

\ A helper defined inside a call'ed quotation is captured by local-scope and
\ imported; a public word defined afterward resolves it at runtime.
[
  (h): [ 42 ] ;
  local-scope
] call import
use-helper: ( -- fixnum ) [ (h) ] ;
use-helper 42 "captured helper resolves at runtime" assert=

\ The imported helper is locally-defined? in the import frame.
"(h)" native.locally-defined? t "captured helper is imported into scope" assert=

"empty frame yields empty module" test-section

[ local-scope ] call @keys #len 0 "empty transient frame captures nothing" assert=

"direct load view" test-section

m: "local_scope_lib.1z" load ;
m public: @has? t "loaded module exposes public word" assert=
m (helper): @has? f "helper is not in the module's public words" assert=
m @keys #len 1 "module exports only its public word" assert=

"load import view" test-section

"local_scope_lib.1z" load import
public "cleaned" "load import brings in the public word" assert=
[ (helper) ] "load import does not bring in the helper" assert-error

"use consumer view" test-section

use "local_scope_lib.1z" shadow-ok ;
public "cleaned" "use brings in the public word" assert=
[ (helper) ] "use does not bring in the helper" assert-error

"quotation isolation" test-section

\ A definition made in a separate call'ed quotation, not captured by
\ local-scope, is discarded when that frame pops.
[ (gone): [ 1 ] ;
] call
[ (gone) ] "uncaptured definition is discarded" assert-error

"use versus load inside the captured quotation" test-section

\ A `use` inside the quotation is a parse-time import. Its words are captured
\ into the module's private deps, keeping the module self-contained, but they do
\ not enter its public words. `@keys` and `@has?` read only words, so the
\ captured module's public surface is just the lone runtime definition.
captured: [ (only-me): [ 1 ] ;
  use "testing" shadow-ok ;
  local-scope
] call ;
captured @keys #len 1 "use'd words stay in private deps, off the public surface" assert=
captured (only-me): @has? t "captured module holds the lone helper" assert=

"top-level guard" test-section

\ At a definition scope the topmost frame is the import frame, so local-scope
\ throws rather than capturing the whole scope. local_scope_guard.1z calls it
\ at its top level; loading the file surfaces the guard error.
[ "local_scope_guard.1z" load ] "local-scope at a definition scope throws" assert-error
