\ Typed CLI flags: a real TypeValue under type: drives conversion, and a symbol
\ under type: (the dropped `type: integer:` form) is rejected at definition time.

use "testing" ;
use "flags" ;

"typed flags" test-section

\ A single positional keeps its index stable regardless of registry hash order.
count: required positional flag{ type: fixnum description: "A count" } ;

\ Named value flags: a string flag with a short alias and a fixnum flag.
output: flag{ type: string short: "o" description: "Output path" } ;
level: flag{ type: fixnum description: "Level" } ;

\ type: fixnum converts the raw string argument to a real fixnum.
{ "42" } "Typed program" parse-flags
dup "count" @get 42 "type: fixnum converts a positional to a number" assert=
"count" @get type-of fixnum "converted value is a fixnum, not a string" assert=

\ --name value: a string value flag consumes the following argument.
{ "42" "--output" "out.txt" } "Typed program" parse-flags
"output" @get "out.txt" "long value flag consumes next arg" assert=

\ --name=value: split on the first =.
{ "42" "--output=path.txt" } "Typed program" parse-flags
"output" @get "path.txt" "long value flag =form" assert=

\ --name=a=b: only the first = splits, so the value keeps its =.
{ "42" "--output=a=b" } "Typed program" parse-flags
"output" @get "a=b" "=form splits on first = only" assert=

\ -o value: a short value flag consumes the following argument.
{ "42" "-o" "short.txt" } "Typed program" parse-flags
"output" @get "short.txt" "short value flag consumes next arg" assert=

\ A fixnum value flag converts its consumed argument.
{ "42" "--level" "7" } "Typed program" parse-flags
dup "level" @get 7 "fixnum value flag converts next arg" assert=
"level" @get type-of fixnum "fixnum value flag yields a fixnum" assert=

\ A symbol under type: is a loud definition-time error. The direct define-flag
\ call reproduces the descriptor that `flag{ ... } ;` builds, whose fields hash
\ carries the declared type. The dropped `type: integer:` form lands here.
[ bad: H{ fields: H{ type: fixnum: } } { } define-flag ]
"a symbol under type: is rejected" assert-error

"All typed flags tests complete!" print-line
