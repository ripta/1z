\ Test typed vector mutation dispatch

use "testing" ;

"define vector(fixnum)" test-section

\ Define parameterized vector type
vector(fixnum): M{ inner-type: vector element-type: fixnum define: [ define-parameterized-type ] } ;

\ Basic construction
V{ 1 2 3 } >vector(fixnum)
type-name "vector(fixnum)" "type-of returns parameterized type name" assert=

\ Predicate
V{ 1 2 3 } >vector(fixnum) vector(fixnum)? t "vector(fixnum)? on typed vector is true" assert=
V{ 1 2 3 } vector(fixnum)? f "vector(fixnum)? on plain vector is false" assert=

"#push! on typed vector" test-section

\ #push! with valid element
V{ 1 2 } >vector(fixnum) 3 #push!
type-name "vector(fixnum)" "#push! preserves typed wrapper" assert=

V{ 1 2 } >vector(fixnum) 3 #push! unmake-vector(fixnum) #len
3 "#push! adds element" assert=

\ #push! with wrong type (error)
[ V{ 1 2 } >vector(fixnum) "hello" #push! ] "error" assert-error

"#pop! on typed vector" test-section

\ #pop! returns element and preserves typed wrapper
V{ 10 20 30 } >vector(fixnum) #pop!
30 "#pop! returns last element" assert=
type-name "vector(fixnum)" "#pop! preserves typed wrapper" assert=

V{ 10 20 30 } >vector(fixnum) #pop! drop unmake-vector(fixnum) #len
2 "#pop! removes element" assert=

"#unshift! on typed vector" test-section

\ #unshift! with valid element
V{ 2 3 } >vector(fixnum) 1 #unshift!
type-name "vector(fixnum)" "#unshift! preserves typed wrapper" assert=

V{ 2 3 } >vector(fixnum) 1 #unshift! unmake-vector(fixnum) 0 #nth
1 "#unshift! adds element at start" assert=

\ #unshift! with wrong type (error)
[ V{ 1 2 } >vector(fixnum) "hello" #unshift! ] "error" assert-error

"#shift! on typed vector" test-section

\ #shift! returns element and preserves typed wrapper
V{ 10 20 30 } >vector(fixnum) #shift!
10 "#shift! returns first element" assert=
type-name "vector(fixnum)" "#shift! preserves typed wrapper" assert=

"#nth! on typed vector" test-section

\ #nth! with valid element
V{ 10 20 30 } >vector(fixnum) 1 99 #nth!
type-name "vector(fixnum)" "#nth! preserves typed wrapper" assert=

V{ 10 20 30 } >vector(fixnum) 1 99 #nth! unmake-vector(fixnum) 1 #nth
99 "#nth! sets element at index" assert=

\ #nth! with wrong type (error)
[ V{ 10 20 30 } >vector(fixnum) 1 "hello" #nth! ] "error" assert-error

"#append! on typed vector" test-section

\ #append! with valid sequence
V{ 1 2 } >vector(fixnum) { 3 4 } #append!
type-name "vector(fixnum)" "#append! preserves typed wrapper" assert=

V{ 1 2 } >vector(fixnum) { 3 4 } #append! unmake-vector(fixnum) #len
4 "#append! adds all elements" assert=

\ #append! with wrong types (error)
[ V{ 1 2 } >vector(fixnum) { "a" "b" } #append! ] "error" assert-error

"numeric promotion in typed vectors" test-section

\ Define vector(float) for promotion tests
vector(float): M{ inner-type: vector element-type: float define: [ define-parameterized-type ] } ;

\ #push! promotes fixnum to float
V{ 1.0 2.0 } >vector(float) 3 #push!
type-name "vector(float)" "#push! with promotion preserves type" assert=

\ #append! promotes fixnums to float
V{ 1.0 } >vector(float) { 2 3 } #append!
type-name "vector(float)" "#append! with promotion preserves type" assert=

"read-only ops via base_type fallback" test-section

\ #len on typed vector
V{ 1 2 3 } >vector(fixnum) #len 3 "#len on typed vector" assert=

\ #nth on typed vector
V{ 10 20 30 } >vector(fixnum) 1 #nth 20 "#nth on typed vector" assert=

\ #each on typed vector
0 V{ 1 2 3 } >vector(fixnum) [ + ] #each 6 "#each on typed vector" assert=

"freeze plain vector" test-section

V{ 1 2 3 } freeze { 1 2 3 } "plain freeze produces array" assert=

"freeze typed vector" test-section

\ Define array(fixnum) for freeze target
array(fixnum): M{ inner-type: array element-type: fixnum define: [ define-parameterized-type ] } ;

V{ 1 2 3 } >vector(fixnum) freeze
type-name "array(fixnum)" "freeze produces typed array" assert=

V{ 1 2 3 } >vector(fixnum) freeze unmake-array(fixnum)
{ 1 2 3 } "freeze preserves elements" assert=

\ Empty typed vector freeze
V{ } >vector(fixnum) freeze
type-name "array(fixnum)" "freeze empty typed vector" assert=

V{ } >vector(fixnum) freeze unmake-array(fixnum)
{ } "freeze empty typed vector elements" assert=

\ Define array(float) for float freeze
array(float): M{ inner-type: array element-type: float define: [ define-parameterized-type ] } ;

V{ 1.0 2.0 3.0 } >vector(float) freeze
type-name "array(float)" "freeze vector(float) to array(float)" assert=

"freeze copy semantics" test-section

\ Original vector unchanged after freeze
V{ 10 20 30 } >vector(fixnum)
dup freeze drop
unmake-vector(fixnum) #len 3 "original vector unchanged after freeze" assert=

"freeze error: no target typed array" test-section

\ Define vector(string) but not array(string)
vector(string): M{ inner-type: vector element-type: string define: [ define-parameterized-type ] } ;

[ V{ "a" "b" } >vector(string) freeze ] "error" assert-error
