\ Test that --check rejects mismatches propagated from typed stdlib struct fields

use "ranges" ;

expect-fixnum: ( n: fixnum -- ) [ drop ] ;

bad-prelude-getter: ( -- ) [
  "main.1z" 12 34 make-source-loc
  file>>
  expect-fixnum
] ;

bad-range-getter: ( -- ) [
  1.5 10 <range>
  start>>
  expect-fixnum
] ;
