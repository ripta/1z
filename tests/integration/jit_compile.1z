use "testing" ;

"compile! basic arithmetic" test-section

double: ( n -- n ) [ 2 * ] ;
double: compile!
5 double 10 "double 5" assert=
-3 double -6 "double -3" assert=
0 double 0 "double 0" assert=

"compile! multi-op" test-section

calc: ( n -- n ) [ 3 + 4 * ] ;
calc: compile!
7 calc 40 "calc 7" assert=
0 calc 12 "calc 0" assert=

"compile! two inputs" test-section

add2: ( a b -- c ) [ + ] ;
add2: compile!
17 25 add2 42 "add2 17 25" assert=

"compile! overflow fallback" test-section

big-add: ( n -- n ) [ 9223372036854775807 + ] ;
big-add: compile!
0 big-add 9223372036854775807 "big-add 0 no overflow" assert=
1 big-add 9223372036854775808 "big-add 1 overflows to bignum" assert=

"compile! division by zero fallback" test-section

div2: ( a b -- c ) [ / ] ;
div2: compile!
[ 10 0 div2 ] "div by zero falls back to interpreter" assert-error

"compile! subtraction" test-section

sub-word: ( a b -- c ) [ - ] ;
sub-word: compile!
10 3 sub-word 7 "sub 10 3" assert=

"compile! division" test-section

half: ( n -- n ) [ 2 / ] ;
half: compile!
10 half 5 "half 10" assert=

"compile! remainder" test-section

remainder: ( a b -- c ) [ rem ] ;
remainder: compile!
7 3 remainder 1 "rem 7 3" assert=
-7 3 remainder -1 "rem -7 3" assert=

"compile! euclidean modulo" test-section

modulo: ( a b -- c ) [ % ] ;
modulo: compile!
7 3 modulo 1 "mod 7 3" assert=
-7 3 modulo 2 "mod -7 3" assert=

"compile! multiplication" test-section

triple: ( n -- n ) [ 3 * ] ;
triple: compile!
5 triple 15 "triple 5" assert=

"compile! dup with arithmetic" test-section

square: ( n -- n ) [ dup * ] ;
square: compile!
5 square 25 "square 5" assert=
-3 square 9 "square -3" assert=
0 square 0 "square 0" assert=

"compile! drop" test-section

drop-top: ( a b -- a ) [ drop ] ;
drop-top: compile!
10 20 drop-top 10 "drop-top 10 20" assert=

"compile! swap with arithmetic" test-section

rev-sub: ( a b -- c ) [ swap - ] ;
rev-sub: compile!
3 10 rev-sub 7 "rev-sub 3 10" assert=

"compile! over with arithmetic" test-section

over-add: ( a b -- c d ) [ over + ] ;
over-add: compile!
3 10 over-add
13 "over-add sum" assert=
3 "over-add a preserved" assert=

"compile! nip pattern" test-section

nip: ( a b -- b ) [ swap drop ] ;
nip: compile!
3 10 nip 10 "nip 3 10" assert=

"compile! non-fixnum literal round-trip: float" test-section

jit-float: ( -- n ) [ 3.14 ] ;
jit-float: compile!
jit-float 3.14 "float literal 3.14" assert=

"compile! non-fixnum literal round-trip: string" test-section

jit-str: ( -- s ) [ "hello" ] ;
jit-str: compile!
jit-str "hello" "string literal hello" assert=

"compile! non-fixnum literal round-trip: symbol" test-section

jit-sym: ( -- s ) [ foo: ] ;
jit-sym: compile!
jit-sym foo: "symbol literal foo" assert=

"compile! non-fixnum literal round-trip: array" test-section

jit-arr: ( -- a ) [ { 1 2 3 } ] ;
jit-arr: compile!
jit-arr { 1 2 3 } "array literal { 1 2 3 }" assert=

"compile! dup on non-fixnum" test-section

dup-str: ( -- s s ) [ "world" dup ] ;
dup-str: compile!
dup-str
"world" "dup string top" assert=
"world" "dup string second" assert=

"compile! drop on non-fixnum" test-section

drop-str: ( -- n ) [ 42 "discard" drop ] ;
drop-str: compile!
drop-str 42 "drop string leaves fixnum" assert=

"compile! swap on mixed types" test-section

swap-mixed: ( -- n s ) [ 99 "text" swap ] ;
swap-mixed: compile!
swap-mixed
99 "swap mixed: fixnum on top" assert=
"text" "swap mixed: string second" assert=

"compile! over on mixed types" test-section

over-mixed: ( -- s n s ) [ "base" 7 over ] ;
over-mixed: compile!
over-mixed
"base" "over mixed: string copied to top" assert=
7 "over mixed: fixnum in middle" assert=
"base" "over mixed: original string at bottom" assert=

"compile! bail to interpreter: float arithmetic" test-section

add-word: ( a b -- c ) [ + ] ;
add-word: compile!
1.5 2.5 add-word 4.0 "float add via interpreter fallback" assert=

"compile! bail to interpreter: string arithmetic error" test-section

[ "hello" 1 add-word ] "string + fixnum errors" assert-error

"compile! comparison: =" test-section

jit-eq: ( a b -- ? ) [ = ] ;
jit-eq: compile!
5 5 jit-eq t "5 = 5" assert=
3 5 jit-eq f "3 = 5" assert=

"compile! comparison: <" test-section

jit-lt: ( a b -- ? ) [ < ] ;
jit-lt: compile!
3 5 jit-lt t "3 < 5" assert=
5 3 jit-lt f "5 < 3" assert=
5 5 jit-lt f "5 < 5" assert=

"compile! comparison: >" test-section

jit-gt: ( a b -- ? ) [ > ] ;
jit-gt: compile!
5 3 jit-gt t "5 > 3" assert=
3 5 jit-gt f "3 > 5" assert=
5 5 jit-gt f "5 > 5" assert=

"compile! basic if: true branch" test-section

jit-if-t: ( -- n ) [ t [ 10 ] [ 20 ] if ] ;
jit-if-t: compile!
jit-if-t 10 "if true -> 10" assert=

"compile! basic if: false branch" test-section

jit-if-f: ( -- n ) [ f [ 10 ] [ 20 ] if ] ;
jit-if-f: compile!
jit-if-f 20 "if false -> 20" assert=

"compile! comparison + if" test-section

jit-cmp-if: ( a b -- n ) [ > [ 10 ] [ 20 ] if ] ;
jit-cmp-if: compile!
5 3 jit-cmp-if 10 "5 > 3 if -> 10" assert=
3 5 jit-cmp-if 20 "3 > 5 if -> 20" assert=

"compile! arithmetic in branches" test-section

jit-arith-if: ( a b -- n ) [ > [ 5 3 + ] [ 5 3 - ] if ] ;
jit-arith-if: compile!
5 3 jit-arith-if 8 "true branch: 5 + 3" assert=
3 5 jit-arith-if 2 "false branch: 5 - 3" assert=

"compile! nested if" test-section

jit-nested-if: ( a b -- n ) [ > [ 100 ] [ 3 2 = [ 200 ] [ 300 ] if ] if ] ;
jit-nested-if: compile!
5 3 jit-nested-if 100 "outer true" assert=
3 5 jit-nested-if 300 "outer false, inner false" assert=

"compile! bail to interpreter: non-fixnum comparison" test-section

1.5 2.5 jit-eq f "float comparison falls back" assert=

"compile! literal quotation call" test-section

jit-call-lit: ( -- n ) [ [ 42 ] call ] ;
jit-call-lit: compile!
jit-call-lit 42 "call literal quot" assert=

"compile! quotation with arithmetic" test-section

jit-call-arith: ( n -- n ) [ [ 2 * ] call ] ;
jit-call-arith: compile!
5 jit-call-arith 10 "call quot with arith" assert=

"compile! nested quotation calls" test-section

jit-nested-call: ( -- n ) [ [ [ 7 ] call ] call ] ;
jit-nested-call: compile!
jit-nested-call 7 "nested call" assert=

"compile! call + if interaction" test-section

jit-call-if: ( n -- n ) [ [ 0 > ] call [ 1 ] [ -1 ] if ] ;
jit-call-if: compile!
5 jit-call-if 1 "call then if true" assert=
-3 jit-call-if -1 "call then if false" assert=

"compile! dynamic quotation call from argument" test-section

jit-apply: ( n quot -- n ) [ call ] ;
jit-apply: compile!
5 [ 3 + ] jit-apply 8 "dynamic call" assert=

"compile! dynamic quotation bail for non-quotation" test-section

[ 42 jit-apply ] "non-quotation call errors" assert-error

"compile! times: zero iterations" test-section

jit-times-zero: ( -- n ) [ 0 0 [ 1 + ] times ] ;
jit-times-zero: compile!
jit-times-zero 0 "times 0 iterations" assert=

"compile! times: one iteration" test-section

jit-times-one: ( -- n ) [ 0 1 [ 1 + ] times ] ;
jit-times-one: compile!
jit-times-one 1 "times 1 iteration" assert=

"compile! times: five iterations" test-section

jit-times-five: ( -- n ) [ 0 5 [ 1 + ] times ] ;
jit-times-five: compile!
jit-times-five 5 "times 5 iterations" assert=

"compile! times: accumulator with arithmetic" test-section

jit-times-accum: ( -- n ) [ 0 4 [ 3 + ] times ] ;
jit-times-accum: compile!
jit-times-accum 12 "times 4 x add 3" assert=

"compile! loop: counter-based exit" test-section

jit-loop: ( -- n ) [ 0 [ 1 + dup 5 < ] loop ] ;
jit-loop: compile!
jit-loop 5 "loop until >= 5" assert=

"compile! while: pred and body" test-section

jit-while: ( -- n ) [ 0 [ dup 10 < ] [ 1 + ] while ] ;
jit-while: compile!
jit-while 10 "while < 10" assert=

"compile! until: pred and body" test-section

jit-until: ( -- n ) [ 0 [ dup 7 = ] [ 1 + ] until ] ;
jit-until: compile!
jit-until 7 "until = 7" assert=

"compile! nested times" test-section

jit-nested-times: ( -- n ) [ 0 3 [ 2 [ 1 + ] times ] times ] ;
jit-nested-times: compile!
jit-nested-times 6 "3 x 2 nested times" assert=

"compile! loop: immediate exit" test-section

jit-loop-imm: ( -- n ) [ 42 [ f ] loop ] ;
jit-loop-imm: compile!
jit-loop-imm 42 "loop immediate false" assert=

\\ --- Interpreter vs Compiled match tests ---
\\ Each test defines a word, runs it interpreted, compiles it, runs it
\\ compiled, and asserts both results are equal.

"match: if/else with truthy non-boolean values" test-section

if-truthy: ( x -- n ) [ [ 1 ] [ 0 ] if ] ;
42 if-truthy
if-truthy: compile!
42 if-truthy
"if-truthy fixnum 42" assert=

if-truthy2: ( x -- n ) [ [ 1 ] [ 0 ] if ] ;
"hello" if-truthy2
if-truthy2: compile!
"hello" if-truthy2
"if-truthy string" assert=

if-truthy3: ( x -- n ) [ [ 1 ] [ 0 ] if ] ;
0 if-truthy3
if-truthy3: compile!
0 if-truthy3
"if-truthy zero" assert=

"match: if/else stack preservation" test-section

if-stack: ( a b -- x y ) [ > [ 10 20 ] [ 30 40 ] if ] ;
5 3 if-stack { } swap #push swap #push
if-stack: compile!
5 3 if-stack { } swap #push swap #push
"if-stack true branch" assert=

if-stack2: ( a b -- x y ) [ > [ 10 20 ] [ 30 40 ] if ] ;
3 5 if-stack2 { } swap #push swap #push
if-stack2: compile!
3 5 if-stack2 { } swap #push swap #push
"if-stack false branch" assert=

"match: quotation call with stack effects" test-section

call-multi: ( -- a b c ) [ [ 1 2 3 ] call ] ;
call-multi { } swap #push swap #push swap #push
call-multi: compile!
call-multi { } swap #push swap #push swap #push
"call-multi ordering" assert=

"match: times loop with complex body" test-section

times-complex: ( -- n ) [ 1 5 [ dup swap * 1 + ] times ] ;
times-complex
times-complex: compile!
times-complex
"times-complex match" assert=

"match: while loop with multi-element stack" test-section

while-two: ( -- a b ) [ 0 0 [ over 3 < ] [ swap 1 + swap 2 + ] while ] ;
while-two { } swap #push swap #push
while-two: compile!
while-two { } swap #push swap #push
"while-two match" assert=

\\ Disabled: until + if + euclidean modulo triggers aarch64 IR backend
\\ miscompilation (infinite loop). The interpreted path works correctly.
\\ "match: until + if interaction" test-section
\\ until-if: ( -- n ) [ 0 [ dup 10 > ] [ dup 2 % 0 = [ 3 + ] [ 1 + ] if ] until ] ;
\\ until-if
\\ until-if: compile!
\\ until-if
\\ "until-if match" assert=

"match: nested while in times" test-section

while-in-times: ( -- n ) [ 0 3 [ 1 [ dup 4 < ] [ 1 + ] while + ] times ] ;
while-in-times
while-in-times: compile!
while-in-times
"while-in-times match" assert=

"match: times with quotation call in body" test-section

times-call: ( -- n ) [ 0 3 [ [ 2 * 1 + ] call ] times ] ;
times-call
times-call: compile!
times-call
"times-call match" assert=
