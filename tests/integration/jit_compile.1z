use "testing" ;

"compile! basic arithmetic" test-section

double: ( n -- n ) [ 2 * ] ;
double: compile!
5 double 10 "double 5" assert=
-3 double -6 "double -3" assert=
0 double 0 "double 0" assert=

"compile! multi-op" test-section

calc: ( n -- n ) [ 3 + 4 * ] ;
calc: compile!
7 calc 40 "calc 7" assert=
0 calc 12 "calc 0" assert=

"compile! two inputs" test-section

add2: ( a b -- c ) [ + ] ;
add2: compile!
17 25 add2 42 "add2 17 25" assert=

"compile! overflow fallback" test-section

big-add: ( n -- n ) [ 9223372036854775807 + ] ;
big-add: compile!
0 big-add 9223372036854775807 "big-add 0 no overflow" assert=
1 big-add 9223372036854775808 "big-add 1 overflows to bignum" assert=

"compile! division by zero fallback" test-section

div2: ( a b -- c ) [ / ] ;
div2: compile!
[ 10 0 div2 ] "div by zero falls back to interpreter" assert-error

"compile! subtraction" test-section

sub-word: ( a b -- c ) [ - ] ;
sub-word: compile!
10 3 sub-word 7 "sub 10 3" assert=

"compile! division" test-section

half: ( n -- n ) [ 2 / ] ;
half: compile!
10 half 5 "half 10" assert=

"compile! remainder" test-section

remainder: ( a b -- c ) [ rem ] ;
remainder: compile!
7 3 remainder 1 "rem 7 3" assert=
-7 3 remainder -1 "rem -7 3" assert=

"compile! euclidean modulo" test-section

modulo: ( a b -- c ) [ % ] ;
modulo: compile!
7 3 modulo 1 "mod 7 3" assert=
-7 3 modulo 2 "mod -7 3" assert=

"compile! multiplication" test-section

triple: ( n -- n ) [ 3 * ] ;
triple: compile!
5 triple 15 "triple 5" assert=

"compile! dup with arithmetic" test-section

square: ( n -- n ) [ dup * ] ;
square: compile!
5 square 25 "square 5" assert=
-3 square 9 "square -3" assert=
0 square 0 "square 0" assert=

"compile! drop" test-section

drop-top: ( a b -- a ) [ drop ] ;
drop-top: compile!
10 20 drop-top 10 "drop-top 10 20" assert=

"compile! swap with arithmetic" test-section

rev-sub: ( a b -- c ) [ swap - ] ;
rev-sub: compile!
3 10 rev-sub 7 "rev-sub 3 10" assert=

"compile! over with arithmetic" test-section

over-add: ( a b -- c d ) [ over + ] ;
over-add: compile!
3 10 over-add
13 "over-add sum" assert=
3 "over-add a preserved" assert=

"compile! nip pattern" test-section

nip: ( a b -- b ) [ swap drop ] ;
nip: compile!
3 10 nip 10 "nip 3 10" assert=

"compile! non-fixnum literal round-trip: float" test-section

jit-float: ( -- n ) [ 3.14 ] ;
jit-float: compile!
jit-float 3.14 "float literal 3.14" assert=

"compile! non-fixnum literal round-trip: string" test-section

jit-str: ( -- s ) [ "hello" ] ;
jit-str: compile!
jit-str "hello" "string literal hello" assert=

"compile! non-fixnum literal round-trip: symbol" test-section

jit-sym: ( -- s ) [ foo: ] ;
jit-sym: compile!
jit-sym foo: "symbol literal foo" assert=

"compile! non-fixnum literal round-trip: array" test-section

jit-arr: ( -- a ) [ { 1 2 3 } ] ;
jit-arr: compile!
jit-arr { 1 2 3 } "array literal { 1 2 3 }" assert=

"compile! dup on non-fixnum" test-section

dup-str: ( -- s s ) [ "world" dup ] ;
dup-str: compile!
dup-str
"world" "dup string top" assert=
"world" "dup string second" assert=

"compile! drop on non-fixnum" test-section

drop-str: ( -- n ) [ 42 "discard" drop ] ;
drop-str: compile!
drop-str 42 "drop string leaves fixnum" assert=

"compile! swap on mixed types" test-section

swap-mixed: ( -- n s ) [ 99 "text" swap ] ;
swap-mixed: compile!
swap-mixed
99 "swap mixed: fixnum on top" assert=
"text" "swap mixed: string second" assert=

"compile! over on mixed types" test-section

over-mixed: ( -- s n s ) [ "base" 7 over ] ;
over-mixed: compile!
over-mixed
"base" "over mixed: string copied to top" assert=
7 "over mixed: fixnum in middle" assert=
"base" "over mixed: original string at bottom" assert=

"compile! bail to interpreter: float arithmetic" test-section

add-word: ( a b -- c ) [ + ] ;
add-word: compile!
1.5 2.5 add-word 4.0 "float add via interpreter fallback" assert=

"compile! bail to interpreter: string arithmetic error" test-section

[ "hello" 1 add-word ] "string + fixnum errors" assert-error
