\ Integration tests for immutable sets S{ }

use "testing" ;
use "sequences" ;
use "sets" ;

"Set creation" test-section
S{ } #len 0 "empty set length" assert=
S{ 1 2 3 } #len 3 "set length" assert=
S{ 1 2 3 2 1 } #len 3 "set deduplicates on creation" assert=

"Set @in?" test-section
S{ 1 2 3 } 1 @in? t "@in? finds element" assert=
S{ 1 2 3 } 2 @in? t "@in? finds middle element" assert=
S{ 1 2 3 } 3 @in? t "@in? finds last element" assert=
S{ 1 2 3 } 4 @in? f "@in? returns false for missing element" assert=
S{ } 1 @in? f "@in? on empty set" assert=
S{ "a" "b" "c" } "b" @in? t "@in? with strings" assert=
S{ "a" "b" "c" } "d" @in? f "@in? with missing string" assert=

"Set @adjoin" test-section
S{ 1 2 } 3 @adjoin #len 3 "@adjoin increases length" assert=
S{ 1 2 } 3 @adjoin 3 @in? t "@adjoin adds element" assert=
S{ 1 2 } 2 @adjoin #len 2 "@adjoin with existing element keeps same length" assert=
S{ } 1 @adjoin #len 1 "@adjoin on empty set" assert=

"Set @remove" test-section
S{ 1 2 3 } 2 @remove #len 2 "@remove decreases length" assert=
S{ 1 2 3 } 2 @remove 2 @in? f "@remove removes element" assert=
S{ 1 2 3 } 2 @remove 1 @in? t "@remove keeps other elements" assert=
S{ 1 2 3 } 4 @remove #len 3 "@remove with missing element keeps same length" assert=
S{ 1 } 1 @remove #len 0 "@remove can empty set" assert=

"Set @union" test-section
S{ 1 2 } S{ 3 4 } @union #len 4 "@union combines sets" assert=
S{ 1 2 } S{ 3 4 } @union 1 @in? t "@union keeps first set elements" assert=
S{ 1 2 } S{ 3 4 } @union 4 @in? t "@union keeps second set elements" assert=
S{ 1 2 } S{ 2 3 } @union #len 3 "@union deduplicates" assert=
S{ 1 2 } S{ } @union #len 2 "@union with empty set" assert=
S{ } S{ 1 2 } @union #len 2 "@union empty with set" assert=

"Set @intersection" test-section
S{ 1 2 3 } S{ 2 3 4 } @intersection #len 2 "@intersection size" assert=
S{ 1 2 3 } S{ 2 3 4 } @intersection 2 @in? t "@intersection has common element" assert=
S{ 1 2 3 } S{ 2 3 4 } @intersection 1 @in? f "@intersection excludes non-common" assert=
S{ 1 2 } S{ 3 4 } @intersection #len 0 "@intersection of disjoint sets" assert=
S{ 1 2 } S{ } @intersection #len 0 "@intersection with empty set" assert=
S{ 1 2 } S{ 1 2 } @intersection #len 2 "@intersection of identical sets" assert=

"Set @difference" test-section
S{ 1 2 3 } S{ 2 3 4 } @difference #len 1 "@difference size" assert=
S{ 1 2 3 } S{ 2 3 4 } @difference 1 @in? t "@difference keeps unique" assert=
S{ 1 2 3 } S{ 2 3 4 } @difference 2 @in? f "@difference removes common" assert=
S{ 1 2 } S{ 3 4 } @difference #len 2 "@difference of disjoint sets" assert=
S{ 1 2 } S{ 1 2 } @difference #len 0 "@difference of identical sets" assert=
S{ } S{ 1 2 } @difference #len 0 "@difference from empty set" assert=

"Set #len" test-section
S{ } #len 0 "#len empty set" assert=
S{ 1 } #len 1 "#len single element" assert=
S{ 1 2 3 4 5 } #len 5 "#len multiple elements" assert=

"Set #each" test-section
0 S{ 1 2 3 } [ + ] #each 6 "#each sum" assert=
0 S{ } [ + ] #each 0 "#each empty set" assert=

"Set #map" test-section
S{ 1 2 3 } [ 2 * ] #map #count 3 "#map preserves size" assert=
S{ 1 2 3 } [ 2 * ] #map #collect 2 #in? t "#map transforms elements" assert=
S{ 1 2 3 } [ 2 * ] #map #collect 4 #in? t "#map has transformed element" assert=
S{ 1 2 3 } [ 2 * ] #map #collect 6 #in? t "#map has all transformed" assert=
S{ 1 2 3 } [ 0 * ] #map #count 3 "#map on set returns iterator (no dedup)" assert=

"Set #filter" test-section
S{ 1 2 3 4 5 } [ 2 > ] #filter #count 3 "#filter count" assert=
S{ 1 2 3 4 5 } [ 2 > ] #filter #collect 3 #in? t "#filter keeps matching" assert=
S{ 1 2 3 4 5 } [ 2 > ] #filter #collect 1 #in? f "#filter removes non-matching" assert=
S{ 1 2 3 4 5 } [ 2 % 0 = ] #filter #count 2 "#filter evens count" assert=

"Set #reduce" test-section
S{ 1 2 3 } 0 [ + ] #reduce 6 "#reduce sum" assert=
S{ 1 2 3 } 1 [ * ] #reduce 6 "#reduce product" assert=
S{ } 42 [ + ] #reduce 42 "#reduce empty set returns init" assert=

"Set equality" test-section
S{ 1 2 3 } S{ 1 2 3 } = t "set equality same order" assert=
S{ 1 2 3 } S{ 3 2 1 } = t "set equality different order" assert=
S{ 1 2 3 } S{ 1 2 } = f "set inequality different size" assert=
S{ 1 2 3 } S{ 1 2 4 } = f "set inequality different elements" assert=
S{ } S{ } = t "empty sets equal" assert=

"Set inspect" test-section
S{ } inspect "S{ }" "empty set inspect" assert=

"Set immutability" test-section
S{ 1 2 } 3 @adjoin drop
S{ 1 2 } 1 @remove drop
\ If we got here without errors, immutability is working

"Mixed type sets" test-section
S{ 1 "a" t } #len 3 "mixed type set" assert=
S{ 1 "a" t } 1 @in? t "mixed set has integer" assert=
S{ 1 "a" t } "a" @in? t "mixed set has string" assert=
S{ 1 "a" t } t @in? t "mixed set has boolean" assert=

"Set @subset?" test-section
S{ 1 2 } S{ 1 2 3 } @subset? t "subset of larger set" assert=
S{ 1 2 3 } S{ 1 2 3 } @subset? t "set is subset of itself" assert=
S{ 1 2 3 } S{ 1 2 } @subset? f "larger set not subset of smaller" assert=
S{ } S{ 1 2 } @subset? t "empty set is subset of any set" assert=
S{ } S{ } @subset? t "empty set is subset of empty set" assert=
S{ 1 4 } S{ 1 2 3 } @subset? f "not subset when element missing" assert=

"Set @superset?" test-section
S{ 1 2 3 } S{ 1 2 } @superset? t "superset of smaller set" assert=
S{ 1 2 3 } S{ 1 2 3 } @superset? t "set is superset of itself" assert=
S{ 1 2 } S{ 1 2 3 } @superset? f "smaller set not superset of larger" assert=
S{ 1 2 } S{ } @superset? t "any set is superset of empty set" assert=
S{ } S{ } @superset? t "empty set is superset of empty set" assert=

"Set @disjoint?" test-section
S{ 1 2 } S{ 3 4 } @disjoint? t "disjoint sets" assert=
S{ 1 2 } S{ 2 3 } @disjoint? f "overlapping sets not disjoint" assert=
S{ } S{ 1 2 } @disjoint? t "empty set is disjoint with any set" assert=
S{ } S{ } @disjoint? t "empty sets are disjoint" assert=
S{ 1 2 3 } S{ 1 2 3 } @disjoint? f "identical sets not disjoint" assert=

"Set @symmetric-difference" test-section
S{ 1 2 3 } S{ 2 3 4 } @symmetric-difference #len 2 "symmetric-difference size" assert=
S{ 1 2 3 } S{ 2 3 4 } @symmetric-difference 1 @in? t "symmetric-difference has left-only" assert=
S{ 1 2 3 } S{ 2 3 4 } @symmetric-difference 4 @in? t "symmetric-difference has right-only" assert=
S{ 1 2 3 } S{ 2 3 4 } @symmetric-difference 2 @in? f "symmetric-difference excludes common" assert=
S{ 1 2 } S{ 1 2 } @symmetric-difference #len 0 "symmetric-difference of identical sets" assert=
S{ 1 2 } S{ 3 4 } @symmetric-difference #len 4 "symmetric-difference of disjoint sets" assert=
S{ } S{ 1 2 } @symmetric-difference #len 2 "symmetric-difference with empty set" assert=

"All set tests complete!" print-line
