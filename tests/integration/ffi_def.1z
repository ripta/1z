use "testing" ;
use "ffi" ;
use "runtime/effect" ;

\\ Helper to get the shared library extension for the host OS.
toy-lib-ext: ( -- ext ) [
  sys-info "os" @get "macos" = [ ".dylib" ] [ ".so" ] if
] ;

\\ Helper to get the shared library path for the toy library.
toy-lib-path: ( -- path ) [
  environ "PWD" @get "/zig-out/ext/libtoy" #append toy-lib-ext #append
] ;

\ === Basic ffi-def{ with toy library ===
"ffi-def{ basic calls" test-section

toy-lib-path lib-open ffi-def{
  toy-add:      "toy_add" ffi{ i32 i32 -> i32 }
  toy-strlen:   "toy_strlen" ffi{ cstring -> i32 }
  toy-greeting: "toy_greeting" ffi{ cstring -> cstring-owned }
} call "toy" swap >module import

3 4 toy-add 7 "ffi-def toy_add(3, 4)" assert=
"hello" toy-strlen 5 "ffi-def toy_strlen(hello)" assert=
"world" toy-greeting "Hello, world!" "ffi-def toy_greeting(world)" assert=

\ === Derived stack effects on generated wrappers ===
"ffi-def{ derived stack effects" test-section

toy-lib-path lib-open ffi-def{
  eff-add:    "toy_add" ffi{ i32 i32 -> i32 }
  eff-greet:  "toy_greeting" ffi{ cstring -> cstring-owned }
  eff-divmod: "toy_divmod" ffi{ i32 i32 out-i32 out-i32 -> void }
  eff-open:   "toy_open" ffi{ -> ptr:toy-counter }
} call

dup "eff-add" @get quotation-effect-get >string
"( a1: fixnum a2: fixnum -- r: fixnum )" "derived effect for i32 i32 -> i32" assert=

dup "eff-greet" @get quotation-effect-get >string
"( a1: string -- r: string )" "derived effect for cstring -> cstring-owned" assert=

dup "eff-divmod" @get quotation-effect-get >string
"( a1: fixnum a2: fixnum -- o3: fixnum o4: fixnum )" "derived effect includes out-params as outputs" assert=

dup "eff-open" @get quotation-effect-get >string
"( -- r )" "derived effect keeps a ptr return untyped" assert=

"toy-eff" swap >module import

3 4 eff-add 7 "wrapper with attached effect still calls" assert=
17 5 eff-divmod
2 "wrapper out-param remainder" assert=
3 "wrapper out-param quotient" assert=
[ "x" 4 eff-add ] "typed wrapper annotation rejects a wrong-typed argument" assert-error

\ === Resource lifecycle via ffi-def{ ===
"ffi-def{ resource lifecycle" test-section

toy-lib-path lib-open
dup ffi-def{
  toy-open:      "toy_open" ffi{ -> ptr:toy-counter }
  toy-increment: "toy_increment" ffi{ ptr:toy-counter -> void }
  toy-read:      "toy_read" ffi{ ptr:toy-counter -> i32 }
} call "toy-counter" swap >module import

\\ Look up close function for counter resources
dup "toy_close" ffi{ ptr -> void } bound-symbol
close-fn: swap ;

toy-open
dup toy-increment
dup toy-increment
dup toy-increment
dup toy-read 3 "ffi-def toy_read after 3 increments" assert=
dup close-fn bind-close
resource-close

\\ Close the dylib
resource-close

\ === System libm via ffi-def{ ===
"ffi-def{ system libm" test-section

"m" lib-open ffi-def{
  ffi-sqrt: "sqrt" ffi{ f64 -> f64 }
  ffi-pow: "pow" ffi{ f64 f64 -> f64 }
} call "ffi-math" swap >module import

25.0 ffi-sqrt 5.0 "ffi-def sqrt(25)" assert=
2.0 10.0 ffi-pow 1024.0 "ffi-def pow(2, 10)" assert=
