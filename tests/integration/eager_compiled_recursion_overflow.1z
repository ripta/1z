use "testing" ;

\ The recursion from hybrid_compiled_recursion_overflow.1z, compiled at definition time. Eager
\ installs the code under the id its own self-call was compiled against, so every level is a direct
\ compiled call and the compiled entry check is the only guard that sees it. The raising quotation
\ leaves depth-dependent residue, so this runs with --no-show-stack.

deep: stack-recursive ( n -- n ) [ dup 0 > [ 1 - deep 1 + ] [ ] if ] ;

test-compiled-overflow: ( -- ) [
  [ 1000000 deep drop ] [ error-type: @get ] recover
  stack-overflow: "compiled deep recursion raises catchable stack-overflow" assert=
] ;

test-compiled-overflow
