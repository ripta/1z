\ Integration tests for SQLite high-level wrappers

use "testing" ;
use "sqlite" ;

"open succeeds on :memory:" test-section
":memory:" open
resource-close

"with-db cleanup on normal exit" test-section
":memory:" [ "CREATE TABLE t (x INTEGER)" { } execute ] with-db
t "with-db completed" assert-true

"with-stmt lifecycle" test-section
":memory:" [
  dup "CREATE TABLE t (x INTEGER)" { } execute
  dup "SELECT 1" [
    dup step-hash option:some? "step-hash returns some" assert-true
  ] with-stmt
] with-db

"execute with empty params" test-section
":memory:" [
  dup "CREATE TABLE t (x INTEGER)" { } execute
  dup "INSERT INTO t VALUES (42)" { } execute
  dup "SELECT x FROM t" [
    step-hash unwrap-or-throw
    "x" @get 42 "execute no-params insert" assert=
  ] with-stmt
] with-db

"execute with one fixnum param" test-section
":memory:" [
  dup "CREATE TABLE t (x INTEGER)" { } execute
  dup "INSERT INTO t VALUES (?1)" { 99 } execute
  dup "SELECT x FROM t" [
    step-hash unwrap-or-throw
    "x" @get 99 "fixnum param" assert=
  ] with-stmt
] with-db

"bind fixnum, float, string" test-section
":memory:" [
  dup "CREATE TABLE t (i INTEGER, f REAL, s TEXT)" { } execute
  dup "INSERT INTO t VALUES (?1, ?2, ?3)" { 42 3.14 "hello" } execute
  dup "SELECT i, f, s FROM t" [
    step-hash unwrap-or-throw
    dup "i" @get 42 "fixnum column" assert=
    dup "f" @get 3.14 "float column" assert=
    "s" @get "hello" "string column" assert=
  ] with-stmt
] with-db

"step-hash multiple rows and exhaustion" test-section
":memory:" [
  dup "CREATE TABLE t (id INTEGER, name TEXT)" { } execute
  dup "INSERT INTO t VALUES (?1, ?2)" { 1 "alice" } execute
  dup "INSERT INTO t VALUES (?1, ?2)" { 2 "bob" } execute
  dup "SELECT id, name FROM t ORDER BY id" [
    dup step-hash unwrap-or-throw "name" @get "alice" "first row" assert=
    dup step-hash unwrap-or-throw "name" @get "bob" "second row" assert=
    step-hash option:none? "exhausted after last row" assert-true
  ] with-stmt
] with-db

"bind option:none for NULL via low-level" test-section
":memory:" [
  dup "CREATE TABLE t (n INTEGER)" { } execute
  dup "INSERT INTO t VALUES (?1)" -1 0 (prepare-v2) over (check-ok-stmt)
  dup 1 option:none bind
  dup (step) SQLITE_DONE "step done" assert=
  resource-close
  dup "SELECT n FROM t" [
    step-hash unwrap-or-throw
    "n" @has? f "NULL column omitted from hash" assert=
  ] with-stmt
] with-db

"execute with params" test-section
":memory:" [
  dup "CREATE TABLE t (x INTEGER, y TEXT)" { } execute
  dup "INSERT INTO t VALUES (?1, ?2)" { 99 "world" } execute
  dup "SELECT x, y FROM t" [
    step-hash unwrap-or-throw
    dup "x" @get 99 "execute inserted fixnum" assert=
    "y" @get "world" "execute inserted string" assert=
  ] with-stmt
] with-db

"with-transaction commit" test-section
":memory:" [
  dup "CREATE TABLE t (x INTEGER)" { } execute
  [
    dup "INSERT INTO t VALUES (?1)" { 1 } execute
    dup "INSERT INTO t VALUES (?1)" { 2 } execute
  ] with-transaction
  dup "SELECT x FROM t ORDER BY x" [
    dup step-hash unwrap-or-throw "x" @get 1 "first row after commit" assert=
    dup step-hash unwrap-or-throw "x" @get 2 "second row after commit" assert=
    step-hash option:none? "no more rows" assert-true
  ] with-stmt
  drop
] with-db

"with-transaction rollback on error" test-section
":memory:" [
  dup "CREATE TABLE t (x INTEGER)" { } execute
  [
    dup [
      dup "INSERT INTO t VALUES (?1)" { 999 } execute
      f "deliberate error" "test-error" make-error throw
    ] with-transaction
  ] [ drop ] recover
  dup "SELECT COUNT(*) as c FROM t" [
    step-hash unwrap-or-throw "c" @get 0 "rolled back data not visible" assert=
  ] with-stmt
  drop
] with-db
