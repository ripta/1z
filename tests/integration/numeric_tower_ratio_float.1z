use "testing" ;
use "math/ratio" ;

"ratio + float" test-section
1 2 normalize-ratio 0.5 + 1.0 "1/2 + 0.5 = 1.0" assert=
0.5 1 2 normalize-ratio + 1.0 "0.5 + 1/2 = 1.0" assert=

"ratio - float" test-section
3 4 normalize-ratio 0.25 - 0.5 "3/4 - 0.25 = 0.5" assert=
1.0 1 4 normalize-ratio - 0.75 "1.0 - 1/4 = 0.75" assert=

"ratio * float" test-section
1 3 normalize-ratio 3.0 * 1.0 "1/3 * 3.0 = 1.0" assert=
2.0 1 3 normalize-ratio * 0.6666666666666666 "2.0 * 1/3" assert=

"ratio / float" test-section
1 2 normalize-ratio 2.0 / 0.25 "1/2 / 2.0 = 0.25" assert=
1.0 1 2 normalize-ratio / 2.0 "1.0 / 1/2 = 2.0" assert=

"ratio % float" test-section
3 2 normalize-ratio 1.0 % 0.5 "3/2 % 1.0 = 0.5" assert=

"result is float" test-section
1 2 normalize-ratio 0.5 + float? "ratio + float produces float" assert-true
0.5 1 2 normalize-ratio * float? "float * ratio produces float" assert-true
