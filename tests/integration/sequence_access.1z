\ Integration tests for Sequence Accessors
\ Tests: #len, #nth, #first, #last

use "testing" ;

"#len on arrays" test-section
{ 1 2 3 } #len 3 "array #len" assert=
{ } #len 0 "empty array #len" assert=

"#len on strings" test-section
"hello" #len 5 "string #len" assert=
"" #len 0 "empty string #len" assert=

"#nth on arrays" test-section
{ 10 20 30 } 0 #nth 10 "array #nth first" assert=
{ 10 20 30 } 1 #nth 20 "array #nth middle" assert=
{ 10 20 30 } 2 #nth 30 "array #nth last" assert=

"#nth on strings" test-section
"abc" 0 #nth "a" "string #nth first" assert=
"abc" 1 #nth "b" "string #nth middle" assert=
"abc" 2 #nth "c" "string #nth last" assert=

"#first on arrays" test-section
{ 1 2 3 } #first 1 "array #first" assert=
{ 42 } #first 42 "single element array #first" assert=

"#first on strings" test-section
"hello" #first "h" "string #first" assert=
"x" #first "x" "single char string #first" assert=

"#last on arrays" test-section
{ 1 2 3 } #last 3 "array #last" assert=
{ 42 } #last 42 "single element array #last" assert=

"#last on strings" test-section
"hello" #last "o" "string #last" assert=
"x" #last "x" "single char string #last" assert=

"Error cases" test-section
[ { } #first ] "empty array #first error" assert-error
[ { } #last ] "empty array #last error" assert-error
[ "" #first ] "empty string #first error" assert-error
[ "" #last ] "empty string #last error" assert-error
[ { 1 2 3 } 10 #nth ] "array #nth out of bounds error" assert-error
[ { 1 2 3 } -1 #nth ] "array #nth negative index error" assert-error

"Nested arrays" test-section
{ { 1 2 } { 3 4 } } 0 #nth #first 1 "nested array access" assert=
{ { 1 2 } { 3 4 } } 1 #nth #last 4 "nested array access 2" assert=

"All sequence accessor tests complete!" print-line
