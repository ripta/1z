\ Compiled arithmetic honors a method arm that replaces a builtin fixnum or float pair when the
\ arm is registered after the word compiled. Every word is compiled explicitly, so the
\ interpreted and eager suites both run compiled code against this one golden.

use "testing" ;

add-u:    ( a b -- c )                 [ + ] ;
add-lit:  ( -- c )                     [ 7 2 + ] ;
add-flit: ( -- c )                     [ 7.5 2.5 + ] ;
add-mlit: ( -- c )                     [ 7 2.5 + ] ;
add-tf:   ( a: fixnum b: fixnum -- c ) [ + ] ;
add-tF:   ( a: float b: float -- c )   [ + ] ;
add-one:  ( a -- c )                   [ 2 + ] ;
sub-u:    ( a b -- c )                 [ - ] ;
sub-lit:  ( -- c )                     [ 7 2 - ] ;
sub-flit: ( -- c )                     [ 7.5 2.5 - ] ;
sub-mlit: ( -- c )                     [ 7 2.5 - ] ;
sub-tf:   ( a: fixnum b: fixnum -- c ) [ - ] ;
sub-tF:   ( a: float b: float -- c )   [ - ] ;
sub-one:  ( a -- c )                   [ 2 - ] ;
mul-u:    ( a b -- c )                 [ * ] ;
mul-lit:  ( -- c )                     [ 7 2 * ] ;
mul-flit: ( -- c )                     [ 7.5 2.5 * ] ;
mul-mlit: ( -- c )                     [ 7 2.5 * ] ;
mul-tf:   ( a: fixnum b: fixnum -- c ) [ * ] ;
mul-tF:   ( a: float b: float -- c )   [ * ] ;
mul-one:  ( a -- c )                   [ 2 * ] ;
div-u:    ( a b -- c )                 [ / ] ;
div-lit:  ( -- c )                     [ 7 2 / ] ;
div-flit: ( -- c )                     [ 7.5 2.5 / ] ;
div-mlit: ( -- c )                     [ 7 2.5 / ] ;
div-tf:   ( a: fixnum b: fixnum -- c ) [ / ] ;
div-tF:   ( a: float b: float -- c )   [ / ] ;
div-one:  ( a -- c )                   [ 2 / ] ;
mod-u:    ( a b -- c )                 [ % ] ;
mod-lit:  ( -- c )                     [ 7 2 % ] ;
mod-flit: ( -- c )                     [ 7.5 2.5 % ] ;
mod-mlit: ( -- c )                     [ 7 2.5 % ] ;
mod-tf:   ( a: fixnum b: fixnum -- c ) [ % ] ;
mod-tF:   ( a: float b: float -- c )   [ % ] ;
mod-one:  ( a -- c )                   [ 2 % ] ;
eq-u:     ( a b -- c )                 [ = ] ;
eq-lit:   ( -- c )                     [ 7 2 = ] ;
eq-flit:  ( -- c )                     [ 7.5 2.5 = ] ;
eq-mlit:  ( -- c )                     [ 7 2.5 = ] ;
eq-tf:    ( a: fixnum b: fixnum -- c ) [ = ] ;
eq-tF:    ( a: float b: float -- c )   [ = ] ;
eq-one:   ( a -- c )                   [ 2 = ] ;
lt-u:     ( a b -- c )                 [ < ] ;
lt-lit:   ( -- c )                     [ 7 2 < ] ;
lt-flit:  ( -- c )                     [ 7.5 2.5 < ] ;
lt-mlit:  ( -- c )                     [ 7 2.5 < ] ;
lt-tf:    ( a: fixnum b: fixnum -- c ) [ < ] ;
lt-tF:    ( a: float b: float -- c )   [ < ] ;
lt-one:   ( a -- c )                   [ 2 < ] ;
gt-u:     ( a b -- c )                 [ > ] ;
gt-lit:   ( -- c )                     [ 7 2 > ] ;
gt-flit:  ( -- c )                     [ 7.5 2.5 > ] ;
gt-mlit:  ( -- c )                     [ 7 2.5 > ] ;
gt-tf:    ( a: fixnum b: fixnum -- c ) [ > ] ;
gt-tF:    ( a: float b: float -- c )   [ > ] ;
gt-one:   ( a -- c )                   [ 2 > ] ;
abs-u:    ( a -- c )                   [ abs ] ;
abs-lit:  ( -- c )                     [ -7 abs ] ;
abs-flit: ( -- c )                     [ -7.5 abs ] ;
abs-tf:   ( a: fixnum -- c )           [ abs ] ;
abs-tF:   ( a: float -- c )            [ abs ] ;

