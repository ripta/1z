\ Test sequence predicates and utilities

\ ============================================================================
\ #empty?
\ ============================================================================

\ Empty sequences
{ } #empty? .
"" #empty? .
V{ } #empty? .
B{ } #empty? .

\ Non-empty sequences
{ 1 } #empty? .
"a" #empty? .
V{ 1 } #empty? .
B{ 1 } #empty? .

\ ============================================================================
\ #starts-with?
\ ============================================================================

\ Strings
"hello" "he" #starts-with? .
"hello" "lo" #starts-with? .
"hello" "" #starts-with? .
"hello" "hello" #starts-with? .
"hello" "hello world" #starts-with? .

\ Arrays
{ 1 2 3 } { 1 2 } #starts-with? .
{ 1 2 3 } { 2 3 } #starts-with? .
{ 1 2 3 } { } #starts-with? .
{ 1 2 3 } { 1 2 3 } #starts-with? .
{ 1 2 3 } { 1 2 3 4 } #starts-with? .

\ ============================================================================
\ #ends-with?
\ ============================================================================

\ Strings
"hello" "lo" #ends-with? .
"hello" "he" #ends-with? .
"hello" "" #ends-with? .
"hello" "hello" #ends-with? .
"hello" "ahello" #ends-with? .

\ Arrays
{ 1 2 3 } { 2 3 } #ends-with? .
{ 1 2 3 } { 1 2 } #ends-with? .
{ 1 2 3 } { } #ends-with? .
{ 1 2 3 } { 1 2 3 } #ends-with? .
{ 1 2 3 } { 0 1 2 3 } #ends-with? .

\ ============================================================================
\ #in?
\ ============================================================================

\ Strings (substring)
"hello" "ll" #in? .
"hello" "x" #in? .
"hello" "" #in? .
"hello" "hello" #in? .

\ Arrays (element)
{ 1 2 3 } 2 #in? .
{ 1 2 3 } 5 #in? .
{ "a" "b" "c" } "b" #in? .
{ "a" "b" "c" } "d" #in? .

\ Sets
S{ 1 2 3 } 2 #in? .
S{ 1 2 3 } 5 #in? .

\ Byte arrays
B{ 65 66 67 } 66 #in? .
B{ 65 66 67 } 68 #in? .

\ ============================================================================
\ #index-of
\ ============================================================================

\ Strings (returns codepoint index)
"hello" "e" #index-of .
"hello" "ll" #index-of .
"hello" "x" #index-of .
"hello" "o" #index-of .
"hello" "" #index-of .

\ Arrays
{ 10 20 30 } 20 #index-of .
{ 10 20 30 } 50 #index-of .
{ "a" "b" "c" } "c" #index-of .
{ "a" "b" "c" } "d" #index-of .

\ Byte arrays
B{ 65 66 67 } 66 #index-of .
B{ 65 66 67 } 68 #index-of .

\ ============================================================================
\ #take
\ ============================================================================

\ Strings
"hello" 3 #take .
"hello" 0 #take .
"hello" 10 #take .

\ Arrays
{ 1 2 3 4 5 } 3 #take .
{ 1 2 3 } 0 #take .
{ 1 2 3 } 10 #take .

\ Vectors
V{ 1 2 3 4 5 } 2 #take .

\ ============================================================================
\ #drop
\ ============================================================================

\ Strings
"hello" 2 #drop .
"hello" 0 #drop .
"hello" 10 #drop .

\ Arrays
{ 1 2 3 4 5 } 2 #drop .
{ 1 2 3 } 0 #drop .
{ 1 2 3 } 10 #drop .

\ Vectors
V{ 1 2 3 4 5 } 3 #drop .

\ ============================================================================
\ #index-of with new truthiness (0 is truthy)
\ ============================================================================

\ This test demonstrates that index 0 is distinguishable from "not found"
\ Using dup since if consumes the condition
{ "a" "b" "c" } "a" #index-of dup [ "found at index " swap to-string #append ] [ drop "not found" ] if print
{ "a" "b" "c" } "d" #index-of dup [ "found at index " swap to-string #append ] [ drop "not found" ] if print

\ ============================================================================
\ UTF-8 handling
\ ============================================================================

\ #take and #drop with multi-byte characters
"café" 3 #take .
"café" 2 #drop .

\ #starts-with? and #ends-with? with UTF-8
"日本語" "日本" #starts-with? .
"日本語" "語" #ends-with? .

\ #index-of with UTF-8
"café" "é" #index-of .
