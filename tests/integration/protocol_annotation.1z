use "testing" ;

\ Establish a protocol so we have a constraint to bind on. The protocol's
\ underlying methods don't matter for these tests; what matters is that
\ `doubleable` is a parse-time const that pushes a protocol descriptor.
doubleable: protocol{ *: ( a: self b: self -- c: self ) } ;

"protocol bound parses and round-trips through stack-effect rendering" test-section
dbl: ( x: doubleable -- y: doubleable ) [ dup * ] ;
dbl: >word-info stack-effect>> >string
"( x: doubleable -- y: doubleable )" "rendering" assert=

"introspection field surfaces the protocol descriptor" test-section
dbl: >word-info stack-effect>> inputs>> #first
type-annotation>> doubleable "annotation is doubleable" assert=

"output position is treated symmetrically" test-section
dbl: >word-info stack-effect>> outputs>> #first
type-annotation>> doubleable "output annotation is doubleable" assert=

"non-protocol annotation still resolves as a type" test-section
typed-fn: ( n: fixnum -- m: fixnum ) [ 1 + ] ;
typed-fn: >word-info stack-effect>> inputs>> #first
type-annotation>> fixnum "concrete annotation still a type" assert=

"introspection accessors discriminate protocol-bound from type-bound" test-section
dbl: >word-info stack-effect>> inputs>> #first
dup protocol-bound? t "protocol-bound input is protocol-bound?" assert=
type-bound? f "protocol-bound input is not type-bound?" assert=

typed-fn: >word-info stack-effect>> inputs>> #first
dup type-bound? t "type-bound input is type-bound?" assert=
protocol-bound? f "type-bound input is not protocol-bound?" assert=

"protocol-info>> yields the same shape as `>word-info protocol>>`" test-section
dbl: >word-info stack-effect>> inputs>> #first protocol-info>>
dup f = f "protocol-info>> returns a struct on a protocol-bound input" assert=
dup name>> "doubleable" "protocol-info>> name is doubleable" assert=
protocol_id>> fixnum? t "protocol-info>> protocol_id is a fixnum" assert=

dbl: >word-info stack-effect>> outputs>> #first protocol-info>>
name>> "doubleable" "protocol-info>> works symmetrically on outputs" assert=

"protocol-info>> is f on a concrete-typed parameter" test-section
typed-fn: >word-info stack-effect>> inputs>> #first protocol-info>>
f "protocol-info>> is f on a type-bound input" assert=

"`|` mixing a protocol and a type parses as a constraint combination" test-section
mixed-fn: ( x: doubleable | fixnum -- ) [ ] ;
mixed-fn: >word-info f = f "mixed union annotation parses and defines a word" assert=

"`&` intersection of two protocols parses" test-section
showable: protocol{ show: } ;
both-fn: ( x: doubleable & showable -- ) [ ] ;
both-fn: >word-info f = f "intersection annotation parses and defines a word" assert=
