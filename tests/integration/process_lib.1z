use "testing" ;
use "time" ;
use "process" ;
use "os/signal" ;

"stdio opts defaults" test-section

<stdio-opts>
dup stdin>> stdio-mode:inherit = "stdin default is inherit" assert-true
dup stdout>> stdio-mode:inherit = "stdout default is inherit" assert-true
dup stderr>> stdio-mode:inherit = "stderr default is inherit" assert-true
dup cwd>> f = "cwd default is f" assert-true
env>> f = "env default is f" assert-true

"spawn-process wrapper" test-section

[
  { "/bin/sh" "-c" "printf hello" }
  <stdio-opts> stdio-mode:pipe >>stdout
  spawn-process
  dup process? "spawn-process returns process struct" assert-true
  dup stdin>> f "stdin inherit remains false" assert=
  dup stderr>> f "stderr inherit remains false" assert=
  dup stdout>> dup stream? "stdout pipe is a stream" assert-true
  dup 5 stream-read "hello" >bytes "stdout pipe carries bytes" assert=
  stream-close
  wait-process 0 "spawned process exits successfully" assert=
] call

"working directory override" test-section

environ "PWD" @get "\n" #append >bytes
{ "/bin/pwd" } <stdio-opts> environ "PWD" @get >>cwd capture-stdout
dup exit-code>> 0 "cwd override exits zero" assert=
stdout>> swap "cwd override affects child process" assert=

"environment replacement" test-section

{ "/bin/sh" "-c" "printf '%s|' \"$ONLY_ONE\"; if [ -z \"${HOME+x}\" ]; then printf unset; else printf set; fi" }
<stdio-opts>
H{ "ONLY_ONE" "set" } >>env
capture-stdout
dup exit-code>> 0 "env override exits zero" assert=
stdout>> "set|unset" >bytes "env override replaces instead of merging" assert=

"run returns compact process result" test-section

{ "/bin/sh" "-c" "exit 7" } <stdio-opts> run
dup exit-code>> 7 "run returns child exit code" assert=
dup stdout>> f "run leaves stdout as f" assert=
stderr>> f "run leaves stderr as f" assert=

"capture helpers" test-section

{ "/bin/sh" "-c" "printf hello" } <stdio-opts> capture-stdout
dup exit-code>> 0 "capture-stdout exits zero" assert=
dup stdout>> "hello" >bytes "capture-stdout returns bytes" assert=
stderr>> f "capture-stdout leaves stderr as f" assert=

{ "/bin/sh" "-c" "printf out; printf err >&2" } <stdio-opts> capture-all
dup exit-code>> 0 "capture-all exits zero" assert=
dup stdout>> "out" >bytes "capture-all captures stdout" assert=
stderr>> "err" >bytes "capture-all captures stderr" assert=

"kill-process accepts signal and fixnum" test-section

[
  { "/bin/sh" "-c" "sleep 30" } <stdio-opts> spawn-process
  dup SIGTERM kill-process
  wait-process 143 "kill-process accepts signal virtual type" assert=
] call

[
  { "/bin/sh" "-c" "sleep 30" } <stdio-opts> spawn-process
  dup 15 kill-process
  wait-process 143 "kill-process accepts raw fixnum" assert=
] call

"with-process cleanup terminates child" test-section

[
  [ { "/bin/sh" "-c" "sleep 30" } <stdio-opts> [ drop ] with-process ] elapsed
  1500 milliseconds <
] call
"with-process sends SIGTERM and waits on scope exit" assert-true

"capture helper async compatibility" test-section

[
  [
    [
      { "/bin/sh" "-c" "sleep 1; printf hello" }
      <stdio-opts>
      capture-stdout
      stdout>> "hello" >bytes "capture-stdout still works in task" assert=
    ] spawn drop
    [ 10 milliseconds sleep ] elapsed
    400 milliseconds < "capture-stdout keeps scheduler responsive" assert-true
  ] task-scope
] call

"shell-safe virtual type" test-section

"printf hi" >shell-safe dup shell-safe? "shell-safe constructor wraps trusted command" assert-true
unmake-shell-safe "printf hi" "shell-safe unwrap preserves trusted text" assert=

"escape-shell uses POSIX quoting" test-section

"hello" escape-shell unmake-shell-safe "'hello'" "escape-shell wraps plain string in single quotes" assert=
"" escape-shell unmake-shell-safe "''" "escape-shell handles empty string" assert=
"hello world" escape-shell unmake-shell-safe "'hello world'" "escape-shell preserves spaces inside quotes" assert=
"it's" escape-shell unmake-shell-safe "'it'\"'\"'s'" "escape-shell escapes embedded single quotes" assert=

"join-shell joins fragments with spaces" test-section

"printf %s" >shell-safe 1array
"hello world" 1array #append
join-shell
dup unmake-shell-safe "printf %s 'hello world'" "join-shell preserves shell-safe fragment and escapes raw string" assert=
{ "/bin/sh" "-c" } over unmake-shell-safe 1array #append <stdio-opts> capture-stdout
dup exit-code>> 0 "join-shell command exits zero" assert=
stdout>> "hello world" >bytes "join-shell command executes with escaped argument" assert=
drop

"fmt-shell mirrors fmt placeholder semantics" test-section

"printf %s" >shell-safe 1array
"hello world" 1array #append
"{0} {1}" fmt-shell
dup unmake-shell-safe "printf %s 'hello world'" "fmt-shell supports indexed placeholders" assert=
{ "/bin/sh" "-c" } over unmake-shell-safe 1array #append <stdio-opts> capture-stdout
dup exit-code>> 0 "fmt-shell indexed command exits zero" assert=
stdout>> "hello world" >bytes "fmt-shell indexed command executes correctly" assert=
drop

[ ] make-mutable-map
dup cmd: "printf %s" >shell-safe @set! drop
dup arg: "hello world" @set! drop
"{cmd} {arg}" fmt-shell
dup unmake-shell-safe "printf %s 'hello world'" "fmt-shell supports named placeholders" assert=
{ "/bin/sh" "-c" } over unmake-shell-safe 1array #append <stdio-opts> capture-stdout
dup exit-code>> 0 "fmt-shell named command exits zero" assert=
stdout>> "hello world" >bytes "fmt-shell named command executes correctly" assert=
drop

"fmt-shell preserves shell safety" test-section

[ ] make-mutable-map
dup cmd: "printf %s" >shell-safe @set! drop
dup arg: "hello; echo hacked" @set! drop
"{cmd} {arg}" fmt-shell
dup unmake-shell-safe "printf %s 'hello; echo hacked'" "fmt-shell escapes injected raw strings" assert=
{ "/bin/sh" "-c" } over unmake-shell-safe 1array #append <stdio-opts> capture-stdout
dup exit-code>> 0 "escaped injection command exits zero" assert=
stdout>> "hello; echo hacked" >bytes "escaped injection stays a single argument" assert=
drop

"run-shell executes only shell-safe commands" test-section

"exit 9" >shell-safe run-shell
dup exit-code>> 9 "run-shell returns child exit code" assert=
dup stdout>> f "run-shell leaves stdout as f" assert=
stderr>> f "run-shell leaves stderr as f" assert=

[ "exit 0" run-shell ] type-mismatch: "run-shell rejects raw strings" assert-error-type
