\ Companion module for task_load_delegate.1z, loaded from a spawned TASK that
\ holds the load lock. The scope child's inner load exercises the task-holder
\ wait-chain walk rather than the main sentinel.

"DELEGATE-OUTER2-START" print-line

[ [ "./task_load_delegate_inner2.1z" load drop ] spawn drop ] task-scope

"DELEGATE-OUTER2-END" print-line

outer2-word: ( -- s ) [ "outer2" ] ;
