\ Test basic pragma registration and setting

use "testing" ;

"explicit boolean true" test-section

\ Register a boolean pragma and set it
"test-flag" f register-pragma
pragma{ test-flag: t }

t "explicit boolean true accepted" assert-true

"explicit boolean false" test-section

pragma{ test-flag: f }

t "explicit boolean false accepted" assert-true

"validated pragma" test-section

\ Register a pragma with a validator that accepts positive integers
"warn-level" [ dup fixnum? [ t ] [ drop "must be a fixnum" f ] if ] register-pragma

pragma{ warn-level: 3 }

t "validated pragma accepted" assert-true

"multiple keys in one block" test-section

pragma{ test-flag: t warn-level: 5 }

t "multiple keys accepted" assert-true

"multiline pragma block" test-section

pragma{
  test-flag: t
  warn-level: 7
}

t "multiline block accepted" assert-true

"built-in require-doc" test-section

\ require-doc is pre-registered as a validated pragma
pragma{ require-doc: t }
pragma{ require-doc: f }

t "built-in require-doc accepted" assert-true

"expression values" test-section

\ With parse-until, values can be arbitrary expressions
pragma{ warn-level: 1 2 + }

t "expression value accepted" assert-true
