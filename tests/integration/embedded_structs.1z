\ Test embedded structs in virtual types

use "testing" ;

"basic embedded struct" test-section

\ Define a struct-backed virtual type
point: virtual{ struct{ x y } } ;

\ Positional wrap + type-of
10 20 >point type-of point: "type-of returns virtual type name" assert=

\ Predicate
10 20 >point point? t "point? on point is true" assert=
42 point? f "point? on integer is false" assert=
"hello" point? f "point? on string is false" assert=

\ Destructuring unwrap pushes all fields in order
10 20 >point point> 20 "unwrap second field" assert=
10 "unwrap first field" assert=

"display format" test-section

\ Display format: <point point{ x: 10 y: 20 }>
10 20 >point to-string "<point point{ x: 10 y: 20 }>" "display format" assert=

"equality" test-section

\ Same fields equal
10 20 >point 10 20 >point = t "same fields are equal" assert=

\ Different fields not equal
10 20 >point 10 30 >point = f "different fields not equal" assert=

\ Tagged vs plain value not equal
10 20 >point 42 = f "point vs integer not equal" assert=

"zero-field embedded struct" test-section

\ Unit type with no fields
unit: virtual{ struct{ } } ;

>unit type-of unit: "zero-field type-of" assert=
>unit unit? t "zero-field predicate true" assert=

\ Unwrap pushes nothing, re-wrap should produce an equal value
>unit unit> >unit >unit = t "zero-field round-trip equal" assert=

\ Two unit values are equal
>unit >unit = t "zero-field values are equal" assert=

"multiple struct-backed virtual types" test-section

\ Second distinct struct-backed virtual type
color: virtual{ struct{ r g b } } ;

255 128 0 >color type-of color: "color type-of" assert=
255 128 0 >color color? t "color predicate true" assert=
10 20 >point color? f "point is not a color" assert=
255 128 0 >color point? f "color is not a point" assert=

"error cases" test-section

\ Unwrap wrong virtual type
[ 255 128 0 >color point> ] "unwrap wrong type errors" assert-error

\ Unwrap plain value
[ 42 point> ] "unwrap plain value errors" assert-error

"no leaked struct words" test-section

\ make-point, x>>, y>> should not exist
[ make-point ] "make-point does not exist" assert-error
[ x>> ] "x>> does not exist" assert-error
[ y>> ] "y>> does not exist" assert-error
