\ Integration tests for #fill!

use "testing" ;

"#fill! at each width" test-section
B{ 0x00 0x00 0x00 } 0 0xAB 1 3 #fill! B{ 0xAB 0xAB 0xAB } "#fill! width 1" assert=
B{ 0x00 0x00 0x00 0x00 } 0 0x0102 2 2 #fill! B{ 0x02 0x01 0x02 0x01 } "#fill! width 2" assert=
8 bytes-alloc 0 0x01020304 4 2 #fill! 4 4 #peek 0x01020304 "#fill! width 4" assert=
16 bytes-alloc 0 0x0102030405060708 8 2 #fill! 8 8 #peek 0x0102030405060708 "#fill! width 8" assert=

"#fill! count is in width-sized elements" test-section
B{ 0x00 0x00 0x00 0x00 0x00 0x00 } 1 0xFFFF 2 2 #fill!
B{ 0x00 0xFF 0xFF 0xFF 0xFF 0x00 } "count 2 at width 2 covers four bytes from the offset" assert=

"#fill! with a count of one agrees with #poke!" test-section
B{ 0x00 0x00 0x00 0x00 } 0 0xDEADBEEF 4 1 #fill!
B{ 0x00 0x00 0x00 0x00 } 0 0xDEADBEEF 4 #poke! "a single-element fill matches #poke!" assert=

"#fill! returns byte-array" test-section
B{ 0x00 0x00 } 0 0xFF 1 2 #fill! #len 2 "#fill! returns the byte-array it wrote" assert=

"#fill! range rule: the run must fit" test-section
B{ 0x00 0x00 0x00 0x00 } 0 0xFF 1 4 #fill! B{ 0xFF 0xFF 0xFF 0xFF } "a run ending exactly at the end fits" assert=
[ B{ 0x00 0x00 0x00 0x00 } 0 0xFF 1 5 #fill! ] index-out-of-bounds: "one byte past the end throws" assert-error-type
[ B{ 0x00 0x00 0x00 0x00 } 1 0xFF 4 1 #fill! ] index-out-of-bounds: "a width-4 run at offset 1 in a 4-byte array throws" assert-error-type

"#fill! range rule: the empty run at the end" test-section
B{ 0x01 0x02 0x03 } 3 0xFF 1 0 #fill! B{ 0x01 0x02 0x03 } "offset == length with count 0 is a no-op" assert=
[ B{ 0x01 0x02 0x03 } 4 0xFF 1 0 #fill! ] index-out-of-bounds: "an offset past the end throws even at count 0" assert-error-type

"#fill! error: negative offset and count" test-section
[ B{ 0x00 0x00 } -1 0xFF 1 1 #fill! ] index-out-of-bounds: "negative offset throws" assert-error-type
[ B{ 0x00 0x00 } 0 0xFF 1 -1 #fill! ] index-out-of-bounds: "negative count throws" assert-error-type

"#fill! error: invalid width" test-section
[ B{ 0x00 0x00 0x00 } 0 0xFF 3 1 #fill! ] invalid-argument: "#fill! invalid width 3" assert-error-type
[ B{ 0x00 0x00 0x00 } 0 0xFF 0 1 #fill! ] invalid-argument: "#fill! invalid width 0" assert-error-type

"#fill! error: value out of range for the width" test-section
[ B{ 0x00 0x00 } 0 256 1 2 #fill! ] fixnum-overflow: "value 256 exceeds width 1" assert-error-type
[ B{ 0x00 0x00 } 0 -1 1 2 #fill! ] fixnum-overflow: "negative value throws" assert-error-type

"#fill! error: non-byte-array target" test-section
[ "hello" 0 0xFF 1 1 #fill! ] type-mismatch: "#fill! rejects a string target" assert-error-type
