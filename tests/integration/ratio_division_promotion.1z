use "ratio" ;
use "testing" ;

"inexact fixnum division produces ratio" test-section
7 2 / ratio? "7/2 is ratio" assert-true
7 2 / >string "7/2" "7/2 display" assert=
5 3 / >string "5/3" "5/3 display" assert=
-7 2 / >string "-7/2" "-7/2 display" assert=
7 -2 / >string "-7/2" "7/-2 normalizes sign" assert=

"exact fixnum division still produces integer" test-section
6 2 / 3 "6/2 = 3" assert=
6 2 / type-of fixnum: "6/2 is fixnum" assert=
-6 2 / -3 "-6/2 = -3" assert=
0 5 / 0 "0/5 = 0" assert=

"ratio round-trip preserves precision" test-section
1 3 / 3 * 1 "1/3 * 3 = 1" assert=
2 7 / 7 * 2 "2/7 * 7 = 2" assert=

"inexact bignum division produces ratio" test-section
100000000000000000000 99999999999999999999 / ratio? "big/big is ratio" assert-true
100000000000000000000 3 / ratio? "big/3 is ratio" assert-true

"exact bignum division still produces integer" test-section
99999999999999999999 3 / type-of bignum: "big/3 exact is bignum" assert=
99999999999999999999 3 / >string "33333333333333333333" "big/3 exact value" assert=

"division by zero unchanged" test-section
[ 1 0 / ] "DivisionByZero" assert-error
[ 0 0 / ] "DivisionByZero" assert-error

"minInt / -1 still promotes to bignum" test-section
-9223372036854775808 -1 / type-of bignum: "minInt/-1 is bignum" assert=
-9223372036854775808 -1 / >string "9223372036854775808" "minInt/-1 value" assert=

"float division unchanged" test-section
7.0 2.0 / 3.5 "float / float" assert=
7 2.0 / 3.5 "fixnum / float" assert=
7.0 2 / 3.5 "float / fixnum" assert=
