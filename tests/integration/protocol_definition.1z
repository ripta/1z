use "testing" ;

\ -- Iterable protocol --

iterable: protocol{ >iterator: } ;

\ Define a simple wrapper type and implement >iterator for it
my-list: virtual{ array } ;

>iterator: method{ my-list } [
  unmake-my-list >iterator
] ;

test-iterable-validates: ( -- ) [
  my-list: iterable assert-satisfies
  t "iterable protocol validates when >iterator is implemented" assert-true
] ;

\ -- Custom protocol with multiple methods --

shapeful: protocol{ perimeter: area: } ;

circle: virtual{ fixnum } ;

perimeter: generic ( shape -- n ) [ drop 0 ] ;
area: generic ( shape -- n ) [ drop 0 ] ;

perimeter: method{ circle } [
  unmake-circle 2 * 314 * 100 /
] ;

area: method{ circle } [
  unmake-circle dup * 314 * 100 /
] ;

test-shapeful-validates: ( -- ) [
  circle: shapeful assert-satisfies
  t "shapeful validates when both methods implemented" assert-true
] ;

test-shapeful-methods-work: ( -- ) [
  10 >circle perimeter
  62 "circle perimeter" assert=
  10 >circle area
  314 "circle area" assert=
] ;

\ -- Single-method protocol --

printable: protocol{ inspect: } ;

my-label: virtual{ string } ;

inspect: generic ( val -- str ) [ drop "" ] ;

inspect: method{ my-label } [
  unmake-my-label
] ;

test-single-method-validates: ( -- ) [
  my-label: printable assert-satisfies
  t "single-method protocol validates" assert-true
] ;

\ -- Validation failure --

showable: protocol{ show: } ;

my-thing: virtual{ fixnum } ;

test-protocol-failure-throws: ( -- ) [
  [ my-thing: showable assert-satisfies ] "missing method throws protocol-error" assert-error
] ;

test-protocol-failure-error-type: ( -- ) [
  [ my-thing: showable assert-satisfies ] protocol-error: "protocol-error has correct error type" assert-error-type
] ;

\ -- User-defined >iterator dispatch --

test-iterable-dispatch: ( -- ) [
  { 1 2 3 } >my-list >iterator #collect
  { 1 2 3 } "user-defined >iterator dispatches and produces working iterator" assert=
] ;

test-iterable-pipeline: ( -- ) [
  { 10 20 30 } >my-list >iterator [ 2 * ] #map #collect
  { 20 40 60 } "user-defined >iterator works in lazy pipeline" assert=
] ;

test-iterable-each: ( -- ) [
  { 1 2 3 } >my-list >iterator 0 [ + ] #reduce
  6 "user-defined >iterator works with #reduce" assert=
] ;

\ -- Typed protocol with self in both positions (same-type) --

self-addable: protocol{ add: ( a: self b: self -- result ) } ;

my-num: virtual{ fixnum } ;

add: generic ( a b -- c ) [ drop ] ;

add: method{ my-num my-num } [
  unmake-my-num swap unmake-my-num + >my-num
] ;

test-typed-self-both: ( -- ) [
  my-num: self-addable assert-satisfies
  t "typed protocol with self in both positions validates" assert-true
] ;

\ -- Typed protocol with self and any (cross-type) --

scalable: protocol{ scale: ( a: self b: any -- result ) } ;

scale: generic ( a b -- c ) [ drop ] ;

scale: method{ my-num fixnum } [
  swap unmake-my-num * >my-num
] ;

test-typed-self-any: ( -- ) [
  my-num: scalable assert-satisfies
  t "typed protocol with self and any validates" assert-true
] ;

\ -- Mixed bare + typed methods in one protocol --

inspect: method{ my-num } [
  unmake-my-num inspect
] ;

mixed-proto: protocol{ inspect: add: ( a: self b: self -- result ) } ;

test-mixed-protocol: ( -- ) [
  my-num: mixed-proto assert-satisfies
  t "mixed bare + typed methods in one protocol validates" assert-true
] ;

\ -- Validation failure for typed protocol (missing cross-type registration) --

cross-scalable: protocol{ scale: ( a: self b: fixnum -- result ) } ;

my-other: virtual{ fixnum } ;

test-typed-protocol-failure: ( -- ) [
  [ my-other: cross-scalable assert-satisfies ] "typed protocol fails for missing cross-type method" assert-error
] ;

\ -- Backward compat: bare symbol still checks unary/same-type-binary --

bare-proto: protocol{ inspect: } ;

test-bare-backward-compat: ( -- ) [
  my-label: bare-proto assert-satisfies
  t "bare symbol backward compat validates" assert-true
] ;

\ -- Cross-type arithmetic protocol (positive) --

cross-arith: protocol{
  add: ( a: self b: any -- result )
  mul: ( a: self b: any -- result )
} ;

ca-val: virtual{ fixnum } ;

mul: generic ( a b -- c ) [ drop ] ;

add: method{ ca-val fixnum } [
  swap unmake-ca-val + >ca-val
] ;

mul: method{ ca-val fixnum } [
  swap unmake-ca-val * >ca-val
] ;

test-cross-arith-validates: ( -- ) [
  ca-val: cross-arith assert-satisfies
  t "cross-type arithmetic protocol validates with any" assert-true
] ;

\ -- any in first position (positive) --

left-any-proto: protocol{ combine: ( a: any b: self -- result ) } ;

combine: generic ( a b -- c ) [ drop ] ;

la-val: virtual{ fixnum } ;

combine: method{ fixnum la-val } [
  unmake-la-val + >la-val
] ;

test-left-any-validates: ( -- ) [
  la-val: left-any-proto assert-satisfies
  t "protocol with any in first position validates" assert-true
] ;

\ -- any wildcard with no matching registration (negative) --

any-missing-proto: protocol{ transform: ( a: self b: any -- result ) } ;

transform: generic ( a b -- c ) [ drop ] ;

am-val: virtual{ fixnum } ;

test-any-no-registration: ( -- ) [
  [ am-val: any-missing-proto assert-satisfies ] "any wildcard with no registration throws" assert-error
] ;

\ -- Multiple any-typed methods, partial registration (negative) --

multi-any-proto: protocol{
  op-a: ( a: self b: any -- result )
  op-b: ( a: self b: any -- result )
} ;

op-a: generic ( a b -- c ) [ drop ] ;
op-b: generic ( a b -- c ) [ drop ] ;

ma-val: virtual{ fixnum } ;

op-a: method{ ma-val fixnum } [
  swap unmake-ma-val + >ma-val
] ;

test-partial-any-methods: ( -- ) [
  [ ma-val: multi-any-proto assert-satisfies ] "partial any-typed methods throws for missing method" assert-error
] ;

\ -- Error message content for cross-type failure --

err-proto: protocol{ missing-op: ( a: self b: any -- result ) } ;

missing-op: generic ( a b -- c ) [ drop ] ;

err-val: virtual{ fixnum } ;

test-error-message-content: ( -- ) [
  [ err-val: err-proto assert-satisfies ] [ ] recover
  dup "error-type" @get protocol-error: "error type is protocol-error" assert=
  "message" @get
  dup "err-val" #in? "error message contains type name" assert-true
  dup "missing-op" #in? "error message contains method name" assert-true
  "err-proto" #in? "error message contains protocol name" assert-true
] ;

\ -- Run all tests --

test-iterable-validates
test-iterable-dispatch
test-iterable-pipeline
test-iterable-each
test-shapeful-validates
test-shapeful-methods-work
test-single-method-validates
test-protocol-failure-throws
test-protocol-failure-error-type
test-typed-self-both
test-typed-self-any
test-mixed-protocol
test-typed-protocol-failure
test-bare-backward-compat
test-cross-arith-validates
test-left-any-validates
test-any-no-registration
test-partial-any-methods
test-error-message-content
