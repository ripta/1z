use "testing" ;

\ -- Prelude protocols still validate identical types under the
\    descriptor-backed body --

my-box: virtual{ fixnum } ;

cmp:     method{ my-box my-box } [ unmake-my-box swap unmake-my-box swap - ] ;
>string: method{ my-box } [ unmake-my-box >string ] ;
inspect: method{ my-box } [ unmake-my-box >string ] ;

test-prelude-comparable: ( -- ) [
  my-box: comparable assert-satisfies
  t "comparable validates my-box" assert-true
] ;

test-prelude-stringable: ( -- ) [
  my-box: stringable assert-satisfies
  t "stringable validates my-box" assert-true
] ;

test-prelude-inspectable: ( -- ) [
  my-box: inspectable assert-satisfies
  t "inspectable validates my-box" assert-true
] ;

\ -- A protocol word is a parse-time const; re-defining it throws
\    cannot-redefine-const, matching the struct/virtual type
\    precedent. --

doubleable: protocol{ doubled: } ;

twin: virtual{ fixnum } ;

doubled: generic ( v -- v ) [ ] ;
doubled: method{ twin } [ unmake-twin 2 * >twin ] ;

test-protocol-validates: ( -- ) [
  twin: doubleable assert-satisfies
  t "doubleable validates twin" assert-true
] ;

\ -- `>word-info` surfaces the descriptor for protocol words and `f`
\    for everything else. --

test-comparable-protocol-info: ( -- ) [
  comparable: >word-info protocol>>
  dup f = f "comparable has a protocol field" assert=
  dup name>> "comparable" "comparable protocol name" assert=
  dup kind>> protocol: "comparable kind is protocol" assert=
  dup methods>> #len 0 > t "comparable methods is non-empty" assert=
  dup methods>> #first cmp: "comparable first method symbol" assert=
  id>> fixnum? t "comparable id is a fixnum" assert=
] ;

test-inspectable-protocol-info: ( -- ) [
  inspectable: >word-info protocol>>
  dup name>> "inspectable" "inspectable protocol name" assert=
  dup kind>> protocol: "inspectable kind is protocol" assert=
  id>> fixnum? t "inspectable id is a fixnum" assert=
] ;

test-stringable-protocol-info: ( -- ) [
  stringable: >word-info protocol>>
  dup name>> "stringable" "stringable protocol name" assert=
  dup kind>> protocol: "stringable kind is protocol" assert=
  id>> fixnum? t "stringable id is a fixnum" assert=
] ;

test-protocol-redefinition-rejected: ( -- ) [
  [ doubleable: protocol{ doubled: } ;
  ] cannot-redefine-const: "re-defining a protocol word throws cannot-redefine-const" assert-error-type
] ;

test-non-protocol-word-has-f: ( -- ) [
  dup: >word-info protocol>>
  f "native word dup has no protocol field" assert=
  test-prelude-comparable: >word-info protocol>>
  f "compound non-protocol word has no protocol field" assert=
] ;

\ -- Const-pusher semantics: invoking a protocol word pushes its
\    descriptor as a value rather than running a runtime validator. --

test-protocol-pushes-descriptor-runtime: ( -- ) [
  comparable comparable = t "comparable pushed twice is pointer-identical" assert=
] ;

\ -- type-of reports the umbrella `constraint` for any constraint-pushing
\    word, regardless of which protocol it backs. --

test-protocol-type-of-name: ( -- ) [
  comparable type-name "constraint" "comparable type-of name is constraint" assert=
  inspectable type-name "constraint" "inspectable type-of name is constraint" assert=
  stringable type-name "constraint" "stringable type-of name is constraint" assert=
] ;

test-protocol-type-of-pointer-identity: ( -- ) [
  comparable type-of constraint = "comparable type-of pointer-identical to constraint" assert-true
  inspectable type-of constraint = "inspectable type-of pointer-identical to constraint" assert-true
  stringable type-of constraint = "stringable type-of pointer-identical to constraint" assert-true
] ;

\ A user-defined protocol behaves identically: invocation pushes the
\ descriptor, and the pushed value is usable with `assert-satisfies`
\ from inside a quotation.
pushable:      protocol{ pushed-method: } ;
pushed-method: generic ( v -- v ) [ ] ;
push-target:   virtual{ fixnum } ;
pushed-method: method{ push-target } [ unmake-push-target ] ;

test-user-protocol-pushes-descriptor: ( -- ) [
  pushable pushable = t "pushable pushed twice is pointer-identical" assert=
  [ push-target: pushable assert-satisfies ] call
  t "pushed descriptor flows through assert-satisfies inside a quotation" assert-true
] ;

\ -- Run --

test-prelude-comparable
test-prelude-stringable
test-prelude-inspectable
test-protocol-validates
test-comparable-protocol-info
test-inspectable-protocol-info
test-stringable-protocol-info
test-protocol-redefinition-rejected
test-non-protocol-word-has-f
test-protocol-pushes-descriptor-runtime
test-user-protocol-pushes-descriptor
test-protocol-type-of-name
test-protocol-type-of-pointer-identity
