\ Test that parse-time words using M{} create fresh maps on each invocation.
\
\ Bug: M{} inside a parse-time word body compiles to a shared mutable map
\ literal. Multiple invocations of the same word mutate the same map, so
\ earlier descriptors get corrupted by later ones.
\
\ This bug manifests when struct{ is called multiple times inside
\ parse-values-until (e.g., inside enum{), because the results are collected
\ into an array before being processed by define-enum. The second struct{
\ call overwrites the first descriptor's fields.

use "testing" ;

"struct{ mutable map reuse" test-section

\ Two pre-defined structs referenced by the enum.
rect-dims: struct{ width height } ;
tri-dims:  struct{ a b c } ;
geom:      enum{ rect: rect-dims tri: tri-dims dot: unit } ;

\ rect should have 2 fields (width, height), not 3 (a, b, c)
10 20 make-geom:rect unmake-geom:rect
20 "rect unwrap height" assert=
10 "rect unwrap width" assert=

\ tri should have 3 fields
3 4 5 make-geom:tri unmake-geom:tri
5 "tri unwrap c" assert=
4 "tri unwrap b" assert=
3 "tri unwrap a" assert=

\ Display format reflects correct fields
10 20 make-geom:rect inspect "<geom:rect rect-dims{ width: 10 height: 20 }>"
"rect display" assert=
3 4 5 make-geom:tri inspect "<geom:tri tri-dims{ a: 3 b: 4 c: 5 }>"
"tri display" assert=
