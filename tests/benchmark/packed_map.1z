\ Benchmark: packed-array iteration and #map, across n and quotation chain length.
\
\ The packed >iterator is lazy. It holds the backing and a cursor, and reads one element or one
\ SIMD chunk per step. So iter-new, first, and take-8 are O(1), and their elapsed_ns reads flat
\ across the 4x size steps. Before the lazy iterator they scaled with n: `packed>array >iterator`
\ boxed the whole array before the first element could be read.
\
\ #map recognizes a chain of binary operations against a literal over a packed float array. It
\ vectorizes that chain chunk-by-chunk, holding the chunk in registers across the whole chain. So
\ chain length nearly stops mattering. The map rows sweep one, two, and four operations, and map-4
\ costs about 1.15x map-1. The boxed scalar path charged per element per operation, where map-4
\ cost 3.6x map-1.
\
\ The map rows still read well above the broadcast control, which is the native SIMD path
\ (`packed 2.0 *`). What separates them now is the per-element iterator protocol, not the
\ arithmetic.
\
\ packed-i64 map-1 is the fallback control: integer arithmetic is never recognized. It reads
\ within noise of its pre-lazy number. Boxing the array up front is a small share of the cost of
\ running a quotation n times, so the lazy iterator pays off in early termination rather than in a
\ full drain.

use "math/packed" ;

\\ Emit one timed row: "<label> n=<n> iters=<iters>  elapsed_ns=<ns>", running quot iters times in
\\ one timing window.
\\
\\ quot sees the fixture on top of the stack and must leave it there.
scale-row: ( fixture label n iters quot: ( fixture -- fixture ) -- fixture ) [
  [
    [ swap " n=" #append swap >string #append ] dip
    dup >string " iters=" swap #append
    swap [ #append "  elapsed_ns=" #append print ] dip
  ] dip
  [ times ] curry curry
  benchmark "elapsed_ns" @get >string print-line
] ;

f64-sweep: ( n -- ) [
  dup 1.5 packed-fill:f64
  "packed-f64 iter-new" pick 5 [ dup >iterator drop ] scale-row
  "packed-f64 first" pick 5 [ dup [ drop t ] #any drop ] scale-row
  "packed-f64 drain" pick 5 [ dup >iterator #count drop ] scale-row
  "packed-f64 map-1" pick 5 [ dup [ 2.0 * ] #map #count drop ] scale-row
  "packed-f64 map-2" pick 5 [ dup [ 2.0 * 1.0 + ] #map #count drop ] scale-row
  "packed-f64 map-4" pick 5 [ dup [ 2.0 * 1.0 + 3.0 / 0.5 - ] #map #count drop ] scale-row
  "packed-f64 take-8" pick 5 [ dup [ 2.0 * ] #map 8 #take #count drop ] scale-row
  "packed-f64 broadcast" pick 5 [ dup 2.0 * drop ] scale-row
  2drop
] ;

f32-sweep: ( n -- ) [
  dup 1.5 packed-fill:f32
  "packed-f32 map-1" pick 5 [ dup [ 2.0 * ] #map #count drop ] scale-row
  "packed-f32 map-2" pick 5 [ dup [ 2.0 * 1.0 + ] #map #count drop ] scale-row
  "packed-f32 map-4" pick 5 [ dup [ 2.0 * 1.0 + 3.0 / 0.5 - ] #map #count drop ] scale-row
  2drop
] ;

i64-sweep: ( n -- ) [
  dup 3 packed-fill:i64
  "packed-i64 map-1" pick 5 [ dup [ 2 * ] #map #count drop ] scale-row
  2drop
] ;

\ warm
{ 1.0 2.0 3.0 } >packed:f64 [ 2.0 * ] #map #count drop
{ 1.0 2.0 3.0 } >packed:f64 2.0 * drop
{ 1.0 2.0 3.0 } >packed:f32 [ 2.0 * ] #map #count drop
{ 1 2 3 } >packed:i64 [ 2 * ] #map #count drop

nl "[-- Scaling: packed-f64 --]" print-line

1024 f64-sweep
4096 f64-sweep
16384 f64-sweep
65536 f64-sweep

nl "[-- Scaling: packed-f32 --]" print-line

1024 f32-sweep
4096 f32-sweep
16384 f32-sweep
65536 f32-sweep

nl "[-- Scaling: packed-i64 --]" print-line

1024 i64-sweep
4096 i64-sweep
16384 i64-sweep
65536 i64-sweep
