\ Benchmark: struct vs array construction and access
\
\ Demonstrates that struct construction/access is cheaper than
\ array construction/access for record-like data.

split-acc: struct{ lines current } ;
arr: { { } "hello" } ;
acc: { } "hello" make-split-acc ;

make-benchmark-report
  "Array construction"  5000 [ { } 1array "hello" 1array #append drop ] benchmark-n
  "Struct construction" 5000 [ { } "hello" make-split-acc drop ] benchmark-n
  "Array access"        5000 [ arr 0 #nth drop arr 1 #nth drop ] benchmark-n
  "Struct access"       5000 [ acc lines>> drop acc current>> drop ] benchmark-n
print-benchmark-report
