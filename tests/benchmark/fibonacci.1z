\ Fibonacci benchmark
\ Tests recursive function calls and stack operations

\ Naive recursive fibonacci (exponential time complexity)
\ This is intentionally slow to stress test the interpreter
fib: ( n -- fib(n) ) [
  dup 2 < [ ] [
    dup 1 - fib swap 2 - fib +
  ]
  if
] ;

\ Iterative fibonacci using explicit recursion (linear time complexity)
\ Helper: ( a b n -- fib(n) ) where a=fib(k), b=fib(k+1)
fib-iter-helper: ( a b n -- result ) [
  dup 0 =
  [ drop drop ]
  [ 1 - [ swap over + ] dip fib-iter-helper ]
  if
] ;

fib-iter: ( n -- fib(n) ) [
  dup 2 <
  [ ]
  [ 0 1 <rot- fib-iter-helper ]
  if
] ;

\ Print fibonacci sequence using naive recursive version
"Recursive fibonacci (fib):" print
0 fib . 1 fib . 2 fib . 3 fib . 4 fib . 5 fib .
6 fib . 7 fib . 8 fib . 9 fib . 10 fib .

\ Print larger values
"fib(15) =" print 15 fib .
"fib(20) =" print 20 fib .

\ Print fibonacci sequence using iterative version
"Iterative fibonacci (fib-iter):" print
0 fib-iter . 1 fib-iter . 2 fib-iter . 3 fib-iter . 4 fib-iter . 5 fib-iter .
6 fib-iter . 7 fib-iter . 8 fib-iter . 9 fib-iter . 10 fib-iter .

\ Larger values with iterative (much faster)
"fib-iter(30) =" print 30 fib-iter .
"fib-iter(40) =" print 40 fib-iter .
