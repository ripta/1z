\ Fibonacci benchmark
\ Tests recursive function calls and stack operations

use "memo" ;

\ Naive recursive fibonacci (exponential time complexity)
\ This is intentionally slow to stress test the interpreter
fib: ( n -- fib(n) ) [
  dup 2 < [ ] [
    dup 1 - fib swap 2 - fib +
  ]
  if
] ;

\ Iterative fibonacci using explicit recursion (linear time complexity)
\ Helper: ( a b n -- fib(n) ) where a=fib(k), b=fib(k+1)
fib-iter-helper: ( a b n -- result ) [
  dup 0 =
  [ drop drop ]
  [ 1 - [ swap over + ] dip fib-iter-helper ]
  if
] ;

fib-iter: ( n -- fib(n) ) [
  dup 2 <
  [ ]
  [ 0 1 <rot- fib-iter-helper ]
  if
] ;

\ Memoized recursive fibonacci (linear time via caching)
fib-memo: ( n -- fib(n) ) [
  dup inspect memo?
  [ swap drop ]
  [
    dup 2 < [ ] [
      dup [ dup 1 - fib-memo swap 2 - fib-memo + ] dip
      over over inspect swap memo!
      drop
    ] if
  ] if
] ;

[
  "fib(15)" [ 15 fib drop ] benchmark-run
  "fib(20)" [ 20 fib drop ] benchmark-run
  "fib-iter(30)" [ 30 fib-iter drop ] benchmark-run
  "fib-iter(40)" [ 40 fib-iter drop ] benchmark-run
  "fib-memo(30)" [ [ 30 fib-memo drop ] with-memo ] benchmark-run
  "fib-memo(40)" [ [ 40 fib-memo drop ] with-memo ] benchmark-run
] run-benchmarks
