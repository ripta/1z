\ Benchmark: data structure operations
\
\ Compares construction, access, and mutation performance
\ across all data structure types.
use "ranges" ;
use "cons-list" ;
use "bst" ;
use "deque" ;
use "heap" ;
use "union-find" ;
use "graph" ;

\ The dense projection is private, and its cost claim is what the projection row measures.
borrow { project: } "graph" ;

benchmark-section: ( msg -- ) [ "=== " swap #append " ===" #append print-line ] ;

bench-struct: struct{ a b c } ;
mut-struct: mutable struct{ x y z } ;

\ Pre-built instances for access benchmarks
pre-arr:  { 1 2 3 } ;
pre-s:    1 2 3 make-bench-struct ;
pre-ms:   1 2 3 make-mut-struct ;
pre-hash: H{ a: 1 b: 2 c: 3 } ;
pre-vec:  V{ 1 2 3 } ;
pre-mmap: M{ a: 1 b: 2 c: 3 } ;
pre-set:  S{ 1 2 3 } ;
pre-ba:   B{ 1 2 3 } ;

nl "[-- Construction --]" print-line

[
  "Array" 5000 [ { 1 2 3 } drop ] benchmark-n
  "Struct" 5000 [ 1 2 3 make-bench-struct drop ] benchmark-n
  "Mut Struct" 5000 [ 1 2 3 make-mut-struct drop ] benchmark-n
  "Hash" 5000 [ H{ a: 1 b: 2 c: 3 } drop ] benchmark-n
  "Vector" 5000 [ V{ 1 2 3 } drop ] benchmark-n
  "Mutable Map" 5000 [ M{ a: 1 b: 2 c: 3 } drop ] benchmark-n
  "Set" 5000 [ S{ 1 2 3 } drop ] benchmark-n
  "Byte Array" 5000 [ B{ 1 2 3 } drop ] benchmark-n
] run-benchmarks

nl "[-- Access --]" print-line

[
  "Array       #nth" 5000 [ pre-arr 0 #nth drop pre-arr 2 #nth drop ] benchmark-n
  "Struct      field>>" 5000 [ pre-s a>> drop pre-s c>> drop ] benchmark-n
  "Mut Struct  field>>" 5000 [ pre-ms x>> drop pre-ms z>> drop ] benchmark-n
  "Hash        @get" 5000 [ pre-hash a: @get drop pre-hash c: @get drop ] benchmark-n
  "Vector      #nth" 5000 [ pre-vec 0 #nth drop pre-vec 2 #nth drop ] benchmark-n
  "Mutable Map @get" 5000 [ pre-mmap a: @get drop pre-mmap c: @get drop ] benchmark-n
  "Set         @in?" 5000 [ pre-set 1 @in? drop pre-set 3 @in? drop ] benchmark-n
  "Byte Array  #nth" 5000 [ pre-ba 0 #nth drop pre-ba 2 #nth drop ] benchmark-n
] run-benchmarks

nl "[-- Mutation --]" print-line

[
  "Array #append" 5000 [ pre-arr { 4 } #append drop ] benchmark-n
  "Mut Struct >>field" 5000 [ pre-ms 99 >>x drop ] benchmark-n
  "Hash @set (update)" 5000 [ pre-hash a: 99 @set drop ] benchmark-n
  "Hash @set (insert)" 5000 [ pre-hash d: 4 @set drop ] benchmark-n
  "Vector #push!" 5000 [ V{ 1 } 2 #push! drop ] benchmark-n
  "Mutable Map @set!" 5000 [ pre-mmap a: 99 @set! drop ] benchmark-n
  "Set @adjoin" 5000 [ pre-set 4 @adjoin drop ] benchmark-n
  "Byte Array #append" 5000 [ pre-ba B{ 4 } #append drop ] benchmark-n
] run-benchmarks

\ Scaling sweep: cons-list and bst across n, following the bench_tokenize_scaling.1z shape. Both
\ structures' >iterator is lazy. cons-list's iter-new and first rows are O(1); bst's descend the
\ left spine at creation, so they are O(log n). Both should read near-flat across adjacent 2x size
\ steps. The construct and drain rows stay O(n) and guard constant factors. #len reads the subtree
\ size cached on every bst branch node, so it is O(1) and should read flat; the insert row is the
\ mutation cost that caching promises to keep flat.
\
\ The cons-list sweep stops at n=400: >cons-list and cons-list>array recurse once per element, and
\ near n=600 a release build overflows the main thread's native stack, which has no overflow guard
\ there. bst recursion depth is the tree height, so its sweep reaches n=800.

nl "[-- Scaling: cons-list / bst --]" print-line

\\ Emit one timed row: "<label> n=<n> iters=<iters>  elapsed_ns=<ns>", running quot iters times in
\\ one timing window.
\\
\\ quot sees the fixture on top of the stack and must leave it there.
scale-row: ( fixture label n iters quot: ( fixture -- fixture ) -- fixture ) [
  [
    [ swap " n=" #append swap >string #append ] dip
    dup >string " iters=" swap #append
    swap [ #append "  elapsed_ns=" #append print ] dip
  ] dip
  [ times ] curry curry
  benchmark "elapsed_ns" @get >string print-line
] ;

list-sweep: ( n -- ) [
  dup iota >iterator #collect
  "cons-list construct" pick 1 [ dup >cons-list drop ] scale-row
  >cons-list
  "cons-list iter-new" pick 5 [ dup >iterator drop ] scale-row
  "cons-list first" pick 5 [ dup [ drop t ] #any drop ] scale-row
  "cons-list drain" pick 5 [ dup >iterator #count drop ] scale-row
  2drop
] ;

bst-sweep: ( n -- ) [
  dup iota >iterator #collect
  "bst construct" pick 1 [ dup [ cmp ] >bst drop ] scale-row
  [ cmp ] >bst
  "bst iter-new" pick 5 [ dup >iterator drop ] scale-row
  "bst first" pick 5 [ dup [ drop t ] #any drop ] scale-row
  "bst drain" pick 5 [ dup >iterator #count drop ] scale-row
  "bst #len" pick 5 [ dup #len drop ] scale-row
  \ 1000000000 is absent from every fixture, so the insert always grows the tree instead of
  \ replacing an equal key.
  "bst insert" pick 5 [ dup 1000000000 tree-insert drop ] scale-row
  2drop
] ;

\ The deque sweep is what separates a real-time queue from a quadratic one. `fill+drain` is
\ the whole workload, so it stays O(n) and its per-element cost has to read flat across the
\ 2x steps. A vector-backed queue doubles there instead, since #shift! is O(n).
\
\ The four per-operation rows are the worst-case O(1) claim itself. They land on one of two
\ levels rather than one, because each row re-runs against the same fixture: a fixture left
\ mid-rotation pays the rotation's per-operation step budget on every iteration, and one left
\ idle pays none. Both levels are flat across n, which is what O(1) means here.
\
\ The conformance rows ride the same fixture: iter-new and #len are O(1) and read flat, and
\ drain is O(n) by repeated front-pop, so its per-element cost reads flat like fill+drain.

deque-fill: ( n -- deque ) [ <deque> swap 0 swap <range> [ deque-push-back ] #each ] ;

deque-drain: ( deque n -- deque ) [
  0 swap <range> [ drop deque-pop-front drop ] #each
] ;

deque-round-trip: ( n -- ) [ dup deque-fill swap deque-drain drop ] ;

deque-sweep: ( n -- ) [
  dup
  "deque fill+drain" pick 1 [ dup deque-round-trip ] scale-row
  drop
  dup deque-fill
  "deque push-back" pick 5 [ dup 0 deque-push-back drop ] scale-row
  "deque push-front" pick 5 [ dup 0 deque-push-front drop ] scale-row
  "deque pop-front" pick 5 [ dup deque-pop-front 2drop ] scale-row
  "deque pop-back" pick 5 [ dup deque-pop-back 2drop ] scale-row
  "deque iter-new" pick 5 [ dup >iterator drop ] scale-row
  "deque drain" pick 5 [ dup >iterator #count drop ] scale-row
  "deque #len" pick 5 [ dup #len drop ] scale-row
  2drop
] ;

\ The heap rows are the O(1) claims on insert, merge, and min, plus the amortized pop
\ chain. The per-operation rows land on a fixture of size n and have to read flat across
\ the 2x steps: an insert melds one singleton against the root, a merge melds two roots,
\ and a min reads the root element. The merge row merges the fixture with itself, which
\ persistence makes safe. The fill row is O(n) and guards the constant factor; #len reads
\ the size field.
\
\ There is no per-operation pop row. Re-popping one retained version every iteration is
\ the branching-versions shape the amortized bound excludes: a fill leaves O(n) children
\ on the root, and every rep would repay that first pairing pass. The pop cost rides
\ fill+drain instead, whose per-element cost may grow only logarithmically across the
\ steps.
\
\ The iteration rows split by what a step does. The unsorted walk never pops, so it rides
\ the retained fixture and reads flat per element, and iter-new only boxes the heap. The
\ sorted drain pops, so it fills fresh per rep like fill+drain for the branching-versions
\ reason above.

heap-fill: ( n -- heap ) [ [ cmp ] <heap> swap 0 swap <range> [ heap-insert ] #each ] ;

heap-drain: ( heap n -- heap ) [ 0 swap <range> [ drop heap-pop-min drop ] #each ] ;

heap-round-trip: ( n -- ) [ dup heap-fill swap heap-drain drop ] ;

heap-sweep: ( n -- ) [
  dup
  "heap fill" pick 1 [ dup heap-fill drop ] scale-row
  "heap fill+drain" pick 1 [ dup heap-round-trip ] scale-row
  "heap sorted-drain" pick 1 [ dup heap-fill >iterator #count drop ] scale-row
  drop
  dup heap-fill
  "heap insert" pick 5 [ dup 0 heap-insert drop ] scale-row
  "heap merge" pick 5 [ dup dup heap-merge drop ] scale-row
  "heap min" pick 5 [ dup heap-min drop ] scale-row
  "heap iter-new" pick 5 [ dup >iterator drop ] scale-row
  "heap unsorted-drain" pick 5 [ dup heap-unsorted #count drop ] scale-row
  "heap #len" pick 5 [ dup #len drop ] scale-row
  2drop
] ;

\ The union-find rows are the amortized O(α(n)) claims, effectively flat per operation.
\ fill is the O(n) constructor and guards its constant factor. fill+connect chains n-1
\ merges over fresh singletons, so its per-element cost may not grow across the 2x
\ steps. The chain attaches every element directly under the first, so the per-operation
\ rows land on a star: root and merge-joined read one or two parent slots and must stay
\ flat, and add appends singletons at amortized O(1) vector growth. merge-joined is the
\ Kruskal inner test on an already-connected pair, so it reports f and writes nothing.
\
\ connected? is two root reads and size is one root read plus a size slot, so both ride
\ the star and must stay flat. iter-new only boxes the source and #len reads the
\ component counter, so both are O(1). components-drain pays the grouping pass on its
\ first step, so it runs at one iteration like fill+connect and its per-element cost
\ must read flat.

union-find-connect: ( n -- uf ) [
  dup <union-find> swap
  1 - 0 swap <range> [ over swap dup 1 + union-find-merge drop ] #each
] ;

union-find-sweep: ( n -- ) [
  dup
  "union-find fill" pick 1 [ dup <union-find> drop ] scale-row
  "union-find fill+connect" pick 1 [ dup union-find-connect drop ] scale-row
  drop
  dup union-find-connect
  "union-find root" pick 5 [ dup 1 union-find-root drop ] scale-row
  "union-find merge-joined" pick 5 [ dup 0 1 union-find-merge drop ] scale-row
  "union-find connected?" pick 5 [ dup 0 1 union-find-connected? drop ] scale-row
  "union-find size" pick 5 [ dup 1 union-find-size drop ] scale-row
  "union-find add" pick 5 [ dup union-find-add drop ] scale-row
  "union-find iter-new" pick 5 [ dup >iterator drop ] scale-row
  "union-find components-drain" pick 1 [ dup >iterator #count drop ] scale-row
  "union-find #len" pick 5 [ dup #len drop ] scale-row
  2drop
] ;

\ The union-find-map rows carry the side table: every operation consults a bst-map of
\ interned elements, so unlike the core's flat rows the per-element cost may grow
\ logarithmically across the 2x steps. fill is n adds, the layer's add-cost row. root
\ rides the same star shape as the core's root row, plus one side-table lookup and one
\ back-translation read.

union-find-map-fill: ( n -- ufm ) [
  [ cmp ] <union-find-map> swap
  0 swap <range> [ over swap union-find-map-add ] #each
] ;

union-find-map-connect: ( n -- ufm ) [
  dup union-find-map-fill swap
  1 - 0 swap <range> [ over swap dup 1 + union-find-map-merge drop ] #each
] ;

union-find-map-sweep: ( n -- ) [
  dup
  "union-find-map fill" pick 1 [ dup union-find-map-fill drop ] scale-row
  drop
  dup union-find-map-connect
  "union-find-map root" pick 5 [ dup 1 union-find-map-root drop ] scale-row
  2drop
] ;

\ The graph rows are the O(log V) insert claim and the O(deg) reads over it. path fill and
\ star fill build the same edge count at opposite degree profiles: the path spreads its
\ edges over n vertices and the star piles them onto one. Both are O(E log V), so their
\ per-element costs must track each other across the 2x steps. An insert that scanned the
\ source's list to detect a duplicate would leave the star quadratic while the path stayed
\ linear, which is what makes the pair worth running.
\
\ The per-operation rows ride a path fixture, where every vertex has degree two, so
\ add-edge, has-edge?, edge-get, has-vertex?, neighbors and remove-edge are O(log V) and
\ must read flat. remove-vertex on an interior path vertex touches only its two
\ neighbors, so it is flat too. vertex-count and edge-count are field reads.
\
\ vertices and edges are O(V) and O(V+E), so they run at one iteration and their
\ per-element costs read flat. project is O((V + E) log V) and runs at one iteration too,
\ so its per-element cost may grow logarithmically and no faster. The digraph
\ remove-vertex row is the other half of the removal: a digraph's in-edges are not
\ locatable from the vertex, so every adjacency list is swept and the row is
\ O(V log V + E), the other row here expected to grow.
\
\ The algorithm rows are all O(V + E) behind that same projection, so each one may grow
\ logarithmically and no faster; a frontier that shifted or a walk that re-enqueued would
\ show up as a row growing faster than project does beside it. breadth-first and
\ depth-first additionally build two result maps, which is another O(V log V) of bst
\ inserts, so they sit well above connected-components even though all three walk the same
\ edges. topological-sort rides the digraph fixture, whose star shape is a DAG.
\
\ dijkstra and prim are the two algorithm rows that are not O(V + E): each is O(E log V),
\ because every edge is a heap push and every push is popped. Both run on the path fixture
\ the other rows use, under a constant weight, so they are read against breadth-first over
\ the same edges and the difference is the queue. Their per-element costs may therefore grow
\ by two log factors, the projection's and the heap's, and no more. prim sits below dijkstra
\ because it builds one array where dijkstra builds two bst-maps.
\
\ kruskal spans what prim spans, over the same fixture and the same constant weight, so the
\ pair is where the two cost profiles are read against each other. It is O(E log E) for the
\ sort rather than O(E log V) for the heap, so it too may grow by two log factors and no
\ more, and on this fixture E tracks V so the two factors are within a constant of each
\ other. What is left is the union-find pass, effectively linear.

graph-path-fill: ( n -- graph ) [
  [ cmp ] <graph> swap 1 swap 1 + <range> [ dup 1 - swap graph-add-edge ] #each
] ;

graph-star-fill: ( n -- graph ) [
  [ cmp ] <graph> swap 1 swap 1 + <range> [ 0 swap graph-add-edge ] #each
] ;

graph-digraph-fill: ( n -- graph ) [
  [ cmp ] <digraph> swap 1 swap 1 + <range> [ 0 swap graph-add-edge ] #each
] ;

graph-sweep: ( n -- ) [
  dup
  "graph path fill" pick 1 [ dup graph-path-fill drop ] scale-row
  "graph star fill" pick 1 [ dup graph-star-fill drop ] scale-row
  drop
  dup graph-path-fill
  "graph add-edge" pick 5 [ dup 0 1 graph-add-edge drop ] scale-row
  "graph has-edge?" pick 5 [ dup 0 1 graph-has-edge? drop ] scale-row
  "graph edge-get" pick 5 [ dup 0 1 graph-edge-get drop ] scale-row
  "graph has-vertex?" pick 5 [ dup 1 graph-has-vertex? drop ] scale-row
  "graph neighbors" pick 5 [ dup 1 graph-neighbors drop ] scale-row
  "graph remove-edge" pick 5 [ dup 0 1 graph-remove-edge drop ] scale-row
  "graph remove-vertex" pick 5 [ dup 1 graph-remove-vertex drop ] scale-row
  "graph vertex-count" pick 5 [ dup graph-vertex-count drop ] scale-row
  "graph edge-count" pick 5 [ dup graph-edge-count drop ] scale-row
  "graph vertices" pick 1 [ dup graph-vertices drop ] scale-row
  "graph edges" pick 1 [ dup graph-edges drop ] scale-row
  "graph project" pick 1 [ dup project drop ] scale-row
  "graph breadth-first" pick 1 [ dup 0 graph-breadth-first drop ] scale-row
  "graph depth-first" pick 1 [ dup 0 graph-depth-first drop ] scale-row
  "graph connected-components" pick 1 [ dup graph-connected-components drop ] scale-row
  "graph dijkstra" pick 1 [ dup 0 [ drop 1 ] graph-dijkstra drop ] scale-row
  "graph prim" pick 1 [ dup [ drop 1 ] graph-prim drop ] scale-row
  "graph kruskal" pick 1 [ dup [ drop 1 ] graph-kruskal drop ] scale-row
  drop
  dup graph-digraph-fill
  "graph digraph remove-vertex" pick 1 [ dup 1 graph-remove-vertex drop ] scale-row
  "graph topological-sort" pick 1 [ dup graph-topological-sort drop ] scale-row
  2drop
] ;

\ warm
{ 1 2 3 } >cons-list >iterator #count drop
{ 1 2 3 } [ cmp ] >bst >iterator #count drop
3 deque-round-trip
3 heap-fill #len drop
3 heap-round-trip
3 heap-fill >iterator #count drop
3 heap-fill heap-unsorted #count drop
3 union-find-connect 1 union-find-root drop
3 union-find-connect >iterator #count drop
3 union-find-connect dup 0 1 union-find-connected? drop 1 union-find-size drop
3 union-find-map-connect 1 union-find-map-root drop
3 graph-path-fill dup graph-edges drop dup 1 graph-neighbors drop dup project drop
dup 0 graph-breadth-first drop dup 0 graph-depth-first drop dup graph-connected-components drop
dup 0 [ drop 1 ] graph-dijkstra drop
dup [ drop 1 ] graph-prim drop
dup [ drop 1 ] graph-kruskal drop
1 graph-remove-vertex drop
3 graph-star-fill graph-vertices drop
3 graph-digraph-fill dup graph-topological-sort drop 1 graph-remove-vertex drop

50 list-sweep
100 list-sweep
200 list-sweep
400 list-sweep

100 bst-sweep
200 bst-sweep
400 bst-sweep
800 bst-sweep

nl "[-- Scaling: deque --]" print-line

250 deque-sweep
500 deque-sweep
1000 deque-sweep
2000 deque-sweep

nl "[-- Scaling: heap --]" print-line

250 heap-sweep
500 heap-sweep
1000 heap-sweep
2000 heap-sweep

nl "[-- Scaling: union-find --]" print-line

250 union-find-sweep
500 union-find-sweep
1000 union-find-sweep
2000 union-find-sweep

nl "[-- Scaling: union-find-map --]" print-line

250 union-find-map-sweep
500 union-find-map-sweep
1000 union-find-map-sweep
2000 union-find-map-sweep

nl "[-- Scaling: graph --]" print-line

250 graph-sweep
500 graph-sweep
1000 graph-sweep
2000 graph-sweep
