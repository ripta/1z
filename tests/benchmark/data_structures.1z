\ Benchmark: data structure operations
\
\ Compares construction, access, and mutation performance
\ across all data structure types.
use "ranges" ;
use "cons-list" ;
use "bst" ;

benchmark-section: ( msg -- ) [ "=== " swap #append " ===" #append print-line ] ;

bench-struct: struct{ a b c } ;
mut-struct: mutable struct{ x y z } ;

\ Pre-built instances for access benchmarks
pre-arr:  { 1 2 3 } ;
pre-s:    1 2 3 make-bench-struct ;
pre-ms:   1 2 3 make-mut-struct ;
pre-hash: H{ a: 1 b: 2 c: 3 } ;
pre-vec:  V{ 1 2 3 } ;
pre-mmap: M{ a: 1 b: 2 c: 3 } ;
pre-set:  S{ 1 2 3 } ;
pre-ba:   B{ 1 2 3 } ;

nl "[-- Construction --]" print-line

[
  "Array" 5000 [ { 1 2 3 } drop ] benchmark-n
  "Struct" 5000 [ 1 2 3 make-bench-struct drop ] benchmark-n
  "Mut Struct" 5000 [ 1 2 3 make-mut-struct drop ] benchmark-n
  "Hash" 5000 [ H{ a: 1 b: 2 c: 3 } drop ] benchmark-n
  "Vector" 5000 [ V{ 1 2 3 } drop ] benchmark-n
  "Mutable Map" 5000 [ M{ a: 1 b: 2 c: 3 } drop ] benchmark-n
  "Set" 5000 [ S{ 1 2 3 } drop ] benchmark-n
  "Byte Array" 5000 [ B{ 1 2 3 } drop ] benchmark-n
] run-benchmarks

nl "[-- Access --]" print-line

[
  "Array       #nth" 5000 [ pre-arr 0 #nth drop pre-arr 2 #nth drop ] benchmark-n
  "Struct      field>>" 5000 [ pre-s a>> drop pre-s c>> drop ] benchmark-n
  "Mut Struct  field>>" 5000 [ pre-ms x>> drop pre-ms z>> drop ] benchmark-n
  "Hash        @get" 5000 [ pre-hash a: @get drop pre-hash c: @get drop ] benchmark-n
  "Vector      #nth" 5000 [ pre-vec 0 #nth drop pre-vec 2 #nth drop ] benchmark-n
  "Mutable Map @get" 5000 [ pre-mmap a: @get drop pre-mmap c: @get drop ] benchmark-n
  "Set         @in?" 5000 [ pre-set 1 @in? drop pre-set 3 @in? drop ] benchmark-n
  "Byte Array  #nth" 5000 [ pre-ba 0 #nth drop pre-ba 2 #nth drop ] benchmark-n
] run-benchmarks

nl "[-- Mutation --]" print-line

[
  "Array #append" 5000 [ pre-arr { 4 } #append drop ] benchmark-n
  "Mut Struct >>field" 5000 [ pre-ms 99 >>x drop ] benchmark-n
  "Hash @set (update)" 5000 [ pre-hash a: 99 @set drop ] benchmark-n
  "Hash @set (insert)" 5000 [ pre-hash d: 4 @set drop ] benchmark-n
  "Vector #push!" 5000 [ V{ 1 } 2 #push! drop ] benchmark-n
  "Mutable Map @set!" 5000 [ pre-mmap a: 99 @set! drop ] benchmark-n
  "Set @adjoin" 5000 [ pre-set 4 @adjoin drop ] benchmark-n
  "Byte Array #append" 5000 [ pre-ba B{ 4 } #append drop ] benchmark-n
] run-benchmarks

\ Scaling sweep: cons-list and bst across n, following the bench_tokenize_scaling.1z shape. Both
\ structures' >iterator materializes the whole structure into an array today, so the iter-new and
\ first rows cost O(n): their elapsed_ns should read ~2x across adjacent 2x size steps, and flat
\ once the iterators are lazy. The construct and drain rows stay O(n) and guard constant factors.
\ tree-size is an O(n) walk today and reads O(1) once branch nodes carry subtree sizes; the insert
\ row is the mutation cost that change promises to keep flat.
\
\ The cons-list sweep stops at n=400: >cons-list and cons-list>array recurse once per element, and
\ near n=600 a release build overflows the main thread's native stack, which has no overflow guard
\ there. bst recursion depth is the tree height, so its sweep reaches n=800.

nl "[-- Scaling: cons-list / bst --]" print-line

\\ Emit one timed row: "<label> n=<n> iters=<iters>  elapsed_ns=<ns>", running quot iters times in
\\ one timing window.
\\
\\ quot sees the fixture on top of the stack and must leave it there.
scale-row: ( fixture label n iters quot: ( fixture -- fixture ) -- fixture ) [
  [
    [ swap " n=" #append swap >string #append ] dip
    dup >string " iters=" swap #append
    swap [ #append "  elapsed_ns=" #append print ] dip
  ] dip
  [ times ] curry curry
  benchmark "elapsed_ns" @get >string print-line
] ;

list-sweep: ( n -- ) [
  dup iota >iterator #collect
  "cons-list construct" pick 1 [ dup >cons-list drop ] scale-row
  >cons-list
  "cons-list iter-new" pick 5 [ dup >iterator drop ] scale-row
  "cons-list first" pick 5 [ dup [ drop t ] #any drop ] scale-row
  "cons-list drain" pick 5 [ dup >iterator #count drop ] scale-row
  2drop
] ;

bst-sweep: ( n -- ) [
  dup iota >iterator #collect
  "bst construct" pick 1 [ dup [ cmp ] >bst drop ] scale-row
  [ cmp ] >bst
  "bst iter-new" pick 5 [ dup >iterator drop ] scale-row
  "bst first" pick 5 [ dup [ drop t ] #any drop ] scale-row
  "bst drain" pick 5 [ dup >iterator #count drop ] scale-row
  "bst tree-size" pick 5 [ dup tree-size drop ] scale-row
  \ 1000000000 is absent from every fixture, so the insert always grows the tree instead of
  \ replacing an equal key.
  "bst insert" pick 5 [ dup 1000000000 tree-insert drop ] scale-row
  2drop
] ;

\ warm
{ 1 2 3 } >cons-list >iterator #count drop
{ 1 2 3 } [ cmp ] >bst >iterator #count drop

50 list-sweep
100 list-sweep
200 list-sweep
400 list-sweep

100 bst-sweep
200 bst-sweep
400 bst-sweep
800 bst-sweep
