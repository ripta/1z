\ Focused harness for the while-driven ffi-gen line filter.
\
\ Mirrors ffi_gen_filter_baseline.1z but runs decls-native-while exactly
\ once on toy.h, so the AOT build of this file provides an
\ apples-to-apples timing anchor against the split-based baseline.
\ Keep these word definitions in sync with ffi_gen_filter.1z.

use "ffi-gen" ;
use "strings" ;

filter-state: mutable struct{ acc b } ;

native-line-contains?: ( line str -- ? ) [ #index-of f = not ] ;

native-block-start?: ( line -- ? ) [
  dup "pub const " #starts-with?
  [
    dup " = extern struct {" native-line-contains?
    [ drop t ]
    [
      dup " = opaque {};" native-line-contains?
      [ drop t ]
      [ " = enum(c_int) {" native-line-contains? ]
      if
    ]
    if
  ]
  [ drop f ]
  if
] ;

native-filter-step: ( state line -- state ) [
  dup "pub extern fn " #starts-with?
  [
    over acc>> swap #push! drop
  ]
  [
    over b>>
    [
      [ over acc>> swap #push! drop ] keep
      "};" #starts-with?
      [ f >>b ]
      [ ]
      if
    ]
    [
      dup native-block-start?
      [
        over acc>> swap #push! drop
        t >>b
      ]
      [ drop ]
      if
    ]
    if
  ]
  if
] ;

translate-c-filtered-while: ( header-path flags -- filtered-source ) [
  translate-c
  "\n" split
  V{ } f make-filter-state
  0
  [ dup 3 pick-n #len < ]
  [
    2 pick-n 1 pick-n #nth
    [ swap ] dip
    native-filter-step
    swap 1 +
  ] while
  drop nip
  acc>> >array "\n" #join
] ;

decls-native-while: ( header-path flags -- decls ) [
  translate-c-filtered-while parse-zig-decls
] ;

toy-header: ( -- str ) [ "/Users/ripta/projects/1z/ext/toy/toy.h" ] ;

"--- timing: while variant on toy.h (translate-c output ~6000 lines) ---" print-line

[
  "native-while (toy.h)" [ toy-header { } decls-native-while drop ] benchmark-auto
] run-benchmarks
