\ Benchmark: route-table lookup, across route count and key length.
\
\ `prefix-match?` (lib/prefix-match.1z:16) filters a length-sorted array and takes the first
\ hit, so a lookup runs one `#starts-with?` per registered route until it matches. That is
\ O(m) in the route count. `#starts-with?` is itself a prelude word (src/prelude.1z:1312):
\ two O(1) `#len` guards, then a `#slice` and a compare only when the prefix fits. So an
\ entry that clears the guard costs O(k) in the key length. This records both axes before
\ the table moves onto a radix tree.
\
\ The fixture is shaped like a real route table. m bulk routes sit under a stem of `depth`
\ segments. One short route covers the stem's first segment, so it is the shortest entry and
\ sorts last. One deep route sits below bulk route 0, so it is the longest and sorts first.
\
\ What each row reads:
\
\   build        <prefix-table> sorts m+2 entries under an interpreted key quotation, so it
\                is O(m log m) and flat in k.
\   hit-deep     matches the entry that sorts first, so it is one comparison. Flat in m, and
\                flat in k too: one string compare is lost in the interpreted cost of the
\                single filter step around it.
\   hit-shallow  diverges from every bulk route in its last segment and lands on the short
\                route, which sorts last. It is the headline row. The key outruns every bulk
\                prefix, so all m entries clear the length guard and compare the shared
\                stem. It doubles with m and rises with k.
\   miss         matches nothing. It is shorter than every entry but the short route, so the
\                length guard short-circuits and no bytes are compared. It doubles with m and
\                stays flat in k, which leaves it measuring the per-entry filter step alone.
\                Read against hit-shallow at the same m, the gap is what comparing costs over
\                short-circuiting. A miss also pays a throw and a recover, because `#next?`
\                (src/prelude.1z:1369) recovers from an exhausted iterator.
\
\ So the m factor dominates today and k is a weak second, because the per-entry filter step
\ costs more than the bytes it compares. A radix tree inverts that: m leaves the cost model
\ entirely and k is all that is left.
\
\ `k` is the lookup key's byte length. The stem is k-10 bytes of it, and doubles across the
\ depth steps.

use "ranges" ;
use "prefix-match" ;
use { repeat: } "strings" ;

\ Eight bytes, so the stem's length doubles with its depth.
segment: ( -- str ) const [ "/aaaaaaa" ] ;

lookup-iters: ( -- fixnum ) const [ 20 ] ;

\\ The leading path every generated route carries.
route-stem: ( depth: fixnum -- str ) [ segment swap repeat ] ;

\\ Bulk route i: the shared stem, then the segment that distinguishes it.
bulk-route: ( stem: string i: fixnum -- str ) [ >string "/r" swap #append #append "/" #append ] ;

\\ The shortest entry. Every stem-carrying key starts with it.
stem-route: ( -- str ) [ segment "/" #append ] ;

\\ The longest entry, one segment below bulk route 0.
deep-route: ( stem: string -- str ) [ 0 bulk-route "deep/" #append ] ;

\\ A key the deep route covers.
deep-key: ( stem: string -- str ) [ deep-route "x" #append ] ;

\\ A key no bulk route covers, since m never reaches six digits. It falls through all of them
\\ and lands on the short route.
shallow-key: ( stem: string -- str ) [ "/r999999/x" #append ] ;

\\ A key that shares nothing with any entry. Nine bytes, so it is shorter than every entry
\\ but the short route, which is nine as well.
miss-key: ( -- str ) const [ "/zzz/nope" ] ;

\\ The m bulk routes, each a { path value } pair.
bulk-pairs: ( stem: string m: fixnum -- pairs ) [
  iota swap [ swap bulk-route dup 2 array-n ] curry #map #collect
] ;

\\ Every entry: the bulk routes, the short route that sorts last, and the deep route that
\\ sorts first.
route-pairs: ( stem: string m: fixnum -- pairs ) [
  over swap bulk-pairs
  stem-route dup 2 array-n #push
  swap deep-route dup 2 array-n #push
] ;

\\ Emit one timed row: "<label> iters=<iters>  elapsed_ns=<ns>", running quot iters times in
\\ one timing window. The label already carries the cell's m and k.
\\
\\ quot sees the fixture on top of the stack and must leave it there.
sweep-row: ( fixture label: string iters: fixnum quot: ( fixture -- fixture ) -- fixture ) [
  [
    dup >string " iters=" swap #append
    swap [ #append "  elapsed_ns=" #append print ] dip
  ] dip
  [ times ] curry curry
  benchmark "elapsed_ns" @get >string print-line
] ;

\\ A timed lookup body for `key`, leaving the table for the next iteration.
lookup-quot: ( key: string -- quot ) [ [ over swap prefix-match? drop ] curry ] ;

\\ One timed lookup row, with the key built from the stem outside the timing window.
lookup-row: ( stem: string suffix: string table: prefix-table name: string key-quot: ( stem -- key ) -- stem suffix table ) [
  [ 3 pick-n ] dip call lookup-quot
  [ 2 pick-n #append ] dip
  [ lookup-iters ] dip
  sweep-row
] ;

\\ The " m=<m> k=<k>" every row in one cell carries.
cell-suffix: ( m: fixnum k: fixnum -- str ) [
  >string " k=" swap #append
  swap >string " m=" swap #append
  swap #append
] ;

route-sweep: ( m: fixnum depth: fixnum -- ) [
  route-stem                     \ ( m stem )
  dup shallow-key #byte-len      \ ( m stem k )
  [ over ] dip cell-suffix       \ ( m stem suffix )
  [ 2dup swap route-pairs ] dip  \ ( m stem pairs suffix )
  [ nip ] 2dip                   \ ( stem pairs suffix )
  swap over                      \ ( stem suffix pairs suffix )
  "build" swap #append
  1 [ dup <prefix-table> drop ] sweep-row
  <prefix-table>  \ ( stem suffix table )
  "hit-deep" [ deep-key ] lookup-row
  "hit-shallow" [ shallow-key ] lookup-row
  "miss" [ drop miss-key ] lookup-row
  3drop
] ;

\ warm
1 route-stem
dup 5 route-pairs <prefix-table>
2dup swap deep-key prefix-match? drop
2dup swap shallow-key prefix-match? drop
miss-key prefix-match? drop
drop

nl "[-- Scaling: route lookup --]" print-line

50 1 route-sweep
100 1 route-sweep
200 1 route-sweep
400 1 route-sweep

50 2 route-sweep
100 2 route-sweep
200 2 route-sweep
400 2 route-sweep

50 4 route-sweep
100 4 route-sweep
200 4 route-sweep
400 4 route-sweep

50 8 route-sweep
100 8 route-sweep
200 8 route-sweep
400 8 route-sweep
