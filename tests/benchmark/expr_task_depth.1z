\ How deep the expression parser can nest inside a task, and what 20 levels cost, for parentheses
\ `((1))` and a right-nested sum `1+(1+(...))`.
\
\ Usage: zig-out/release/bin/1z run --compile=off --max-memory=2G tests/benchmark/expr_task_depth.1z
\
\ Each probe runs in a task of its own, since `task-stack-peak` is a running maximum. The deepest
\ depth is found by bisection between a depth that parses and one that overflows.
\
\ The parser's heap use grows faster than its depth, and the default 256M limit stops the infix
\ shape before its task stack does. Running out of memory is not recoverable, so the bisection
\ needs the higher limit to find the stack's ceiling.

use "expr/parser" ;

\\ `str` concatenated `n` times.
repeat-string: ( str: string n: fixnum -- result: string ) [ "" swap [ over #append ] times nip ] ;

\\ Parentheses nested `n` deep around a single number.
nested-parens: ( n: fixnum -- src: string ) [
  [ "(" swap repeat-string "1" #append ] [ ")" swap repeat-string ] bi #append
] ;

\\ A sum nested `n` deep to the right, each right operand a group.
nested-infix: ( n: fixnum -- src: string ) [
  [ "1+(" swap repeat-string "1" #append ] [ ")" swap repeat-string ] bi #append
] ;

\\ Whether a task parses the source `builder` makes for depth `n` without running out of stack.
parses?: ( n: fixnum builder -- ? ) [
  [ [ call parse-expr drop t ] curry curry [ drop f ] recover ] curry curry spawn await
] ;

\\ The deepest nesting in `lo..hi` that `builder` parses, given that `lo` parses and `hi` does not.
deepest: ( lo: fixnum hi: fixnum builder -- n: fixnum ) [
  [ over 1 + over = ] dip swap [ drop drop ] [
    [ 2dup + 2 div dup ] dip dup [ parses? ] dip swap
    [ [ [ swap ] dip nip swap ] dip ] [ [ nip ] dip ] if
    deepest
  ] if
] ;

\\ The peak task stack while `builder` parses 20 levels.
peak-at-20: ( builder -- peak: fixnum ) [
  [ 20 swap call parse-expr drop task-stack-peak ] curry spawn await
] ;

[
  [ nested-parens ] peak-at-20 "parens, peak at 20 levels: " print inspect print-line
  1 8192 [ nested-parens ] deepest "parens, deepest nesting that parses: " print inspect print-line

  [ nested-infix ] peak-at-20 "infix, peak at 20 levels: " print inspect print-line
  1 8192 [ nested-infix ] deepest "infix, deepest nesting that parses: " print inspect print-line
] task-scope
