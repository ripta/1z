\ Startup probe for the parameter-narrowing A/B, run by
\ `make benchmark-param-inference` alongside `param_inference_fib.1z`.
\
\ Identical to that file except the loop runs zero times, so the difference
\ between the two timings is the loop and nothing else. The script header
\ explains why the subtraction is needed.
\
\ Keep this file's words identical to `param_inference_fib.1z`. Only the repeat
\ count differs.

fib-step: ( a b n -- result ) [
  dup 0 = [ drop drop ] [
    1 - [ swap over + ] dip fib-step
  ] if
] ;

fib: ( n -- n ) [
  dup 2 < [ ] [
    0 1 <rot- fib-step
  ] if
] ;

repeat-fib: ( n -- ) [
  dup 0 = [ drop ] [
    1 - 30 fib drop repeat-fib
  ] if
] ;

0 repeat-fib

30 fib 832040 = [ ] [ 1 0 / drop ] if
