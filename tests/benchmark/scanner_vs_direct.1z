\ Benchmark: scanner-based splitting vs direct #index-of-from splitting
\
\ Measures the overhead of the scanner library layer (struct construction,
\ field access, option wrapping) compared to raw #index-of-from usage.
\
\ Written without run-benchmarks/benchmark-auto for AOT compatibility.

use "strings" ;
use "scanner" ;

\ --- Test string generation ---

\ Build a string with n delimited segments: "abcd<delim>abcd<delim>...abcd"
make-delimited: ( n delim -- str ) [
  over 0 = [ 2drop "" ] [
    dup #len
    \ n delim delim-len
    -rot>
    \ delim-len n delim
    "abcd" swap #append swap repeat
    \ delim-len repeated-str
    swap over #len swap - #take
  ] if
] ;

\ --- Scanner-based full split ---

\ Recursive scanner-split loop.
\ delim stays at bottom of stack across iterations.
(scanner-split-loop): stack-recursive ( delim scanner vec -- array ) [
  \ Grab a copy of delim for take-until
  -rot> over
  \ vec delim scanner delim
  take-until
  \ vec delim scanner' text/f
  dup f = [
    \ Not found: push rest, done
    drop rest
    \ vec delim rest
    nip #push! >array
  ] [
    \ Found: push text, skip delim, recurse
    \ vec delim scanner-at-delim text
    3 pick-n swap #push! drop
    \ vec delim scanner-at-delim (vec mutated)
    over skip-exact
    \ vec delim scanner-past/f
    dup f = [
      drop drop >array
    ] [
      \ Restore stack order: delim scanner vec
      <rot- (scanner-split-loop)
    ] if
  ] if
] ;

\ Uses take-until + skip-exact recursively, the way a user would write
\ a split using scanner operations.
scanner-split: ( str delim -- array ) [
  dup #len 0 =
  [ drop 1array ]
  [
    over #len 0 =
    [ 2drop { "" } ]
    [
      swap <scanner> V{ }
      (scanner-split-loop)
    ] if
  ] if
] ;

\ --- Test strings ---

small-str:    ( -- str ) [ "hello,world" ] ;
medium-str:   ( -- str ) [ 100 "," make-delimited ] ;
large-str:    ( -- str ) [ 1000 "," make-delimited ] ;
multi-medium: ( -- str ) [ 100 "::" make-delimited ] ;
multi-large:  ( -- str ) [ 1000 "::" make-delimited ] ;

\ --- Benchmark loops ---

bench-split-once-small: ( n -- ) [
  dup 0 = [ drop ] [
    1 - small-str "," split-once? drop bench-split-once-small
  ] if
] ;

bench-split-once-medium: ( n -- ) [
  dup 0 = [ drop ] [
    1 - medium-str "," split-once? drop bench-split-once-medium
  ] if
] ;

bench-split-once-large: ( n -- ) [
  dup 0 = [ drop ] [
    1 - large-str "," split-once? drop bench-split-once-large
  ] if
] ;

bench-split-direct-small: ( n -- ) [
  dup 0 = [ drop ] [
    1 - small-str "," split drop bench-split-direct-small
  ] if
] ;

bench-scanner-split-small: ( n -- ) [
  dup 0 = [ drop ] [
    1 - small-str "," scanner-split drop bench-scanner-split-small
  ] if
] ;

bench-split-direct-medium: ( n -- ) [
  dup 0 = [ drop ] [
    1 - medium-str "," split drop bench-split-direct-medium
  ] if
] ;

bench-scanner-split-medium: ( n -- ) [
  dup 0 = [ drop ] [
    1 - medium-str "," scanner-split drop bench-scanner-split-medium
  ] if
] ;

bench-split-direct-large: ( n -- ) [
  dup 0 = [ drop ] [
    1 - large-str "," split drop bench-split-direct-large
  ] if
] ;

bench-scanner-split-large: ( n -- ) [
  dup 0 = [ drop ] [
    1 - large-str "," scanner-split drop bench-scanner-split-large
  ] if
] ;

bench-split-direct-multi-medium: ( n -- ) [
  dup 0 = [ drop ] [
    1 - multi-medium "::" split drop bench-split-direct-multi-medium
  ] if
] ;

bench-scanner-split-multi-medium: ( n -- ) [
  dup 0 = [ drop ] [
    1 - multi-medium "::" scanner-split drop bench-scanner-split-multi-medium
  ] if
] ;

bench-split-direct-multi-large: ( n -- ) [
  dup 0 = [ drop ] [
    1 - multi-large "::" split drop bench-split-direct-multi-large
  ] if
] ;

bench-scanner-split-multi-large: ( n -- ) [
  dup 0 = [ drop ] [
    1 - multi-large "::" scanner-split drop bench-scanner-split-multi-large
  ] if
] ;

\ --- Run benchmarks ---

\ Iteration counts are constrained by the 256 MB default memory limit.
\ split and scanner-split allocate arrays on every call and the
\ tail-recursive loop retains them until the recursion unwinds.

"split-once? (small)" print 5000 bench-split-once-small " done" print-line
"split-once? (100 fields)" print 500 bench-split-once-medium " done" print-line
"split-once? (1000 fields)" print 50 bench-split-once-large " done" print-line

"split (direct, small)" print 5000 bench-split-direct-small " done" print-line
"scanner-split (small)" print 5000 bench-scanner-split-small " done" print-line
"split (direct, 100)" print 50 bench-split-direct-medium " done" print-line
"scanner-split (100)" print 50 bench-scanner-split-medium " done" print-line
"split (direct, 1000)" print 5 bench-split-direct-large " done" print-line
"scanner-split (1000)" print 5 bench-scanner-split-large " done" print-line

"split (direct, :: 100)" print 50 bench-split-direct-multi-medium " done" print-line
"scanner-split (:: 100)" print 50 bench-scanner-split-multi-medium " done" print-line
"split (direct, :: 1000)" print 5 bench-split-direct-multi-large " done" print-line
"scanner-split (:: 1000)" print 5 bench-scanner-split-multi-large " done" print-line
