\ The raising inline guards in an interpreter-free binary run, and the restore releases what they
\ left, so the stack after the catch is the entry stack. The testing library does not build in this
\ class, so the checks compare and print by hand.

money: virtual{ fixnum } ;

heap: ( -- s ) [ "hel" "lo" #append ] ;

check: ( ok label -- ) [ swap [ "PASS: " ] [ "FAIL: " ] if swap #append print-line ] ;
error-is: ( error type -- ok ) [ [ error-type: @get ] dip = ] ;

over-then-unwrap: ( s m -- s s n ) [ over swap unmake-money ] ;
add-any: ( a b -- c ) [ + ] ;

heap heap heap [ over-then-unwrap ] [ type-mismatch: error-is "an unwrap of a string raises type-mismatch" check ] recover
"hello" = "the unwrapped operand is restored" check
"hello" = "the string operand is restored" check
"hello" = "the string below the unwrap is restored" check

heap "a" 1 [ add-any ] [ type-mismatch: error-is "+ of a string raises type-mismatch" check ] recover
1 = "the fixnum operand of + is restored" check
"a" = "the string operand of + is restored" check
"hello" = "the string below + is restored" check
