\ The interpreter-free twin of abs_min_int_promotes: the minInt input reaches the native through the
\ per-operation call rather than the interpreter.
\
\ minInt is read out of an array so that it reaches `abs` as a runtime value.
absolute: ( n -- m ) [ abs ] ;
negated-abs: ( n -- m ) [ 0 swap - abs ] ;

-5 absolute inspect print-line
7 absolute inspect print-line
{ -9223372036854775808 } 0 #nth absolute inspect print-line
{ 9223372036854775807 } 0 #nth negated-abs inspect print-line
