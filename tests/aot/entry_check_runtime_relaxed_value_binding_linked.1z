\ A build that links the interpreter but carries no runtime image runs new code too, so its program
\ can relax the mode. A value-binding input that misses with a value `;` defines a word from runs the
\ call in the word's interpreted body, which the build keeps beside the metadata image.

greet: ( s: string -- t ) [
  held: swap ;
  held held #append
] ;

greet-all: generic ( s: string -- t ) [
  held: swap ;
  held held #append
] ;

shout-n: ( s: string n: fixnum -- t ) [
  k: swap ;
  held: swap ;
  k 0 > [ held "!" #append k 1 - shout-n ] [ held ] if
] ;

"ab" greet .
"a" 2 shout-n .
"ab" greet-all .
"pragma{ type-check: \"off\" } [ \"q\" ] greet ." eval-string
"pragma{ type-check: \"off\" } [ \"q\" ] 2 shout-n ." eval-string
"pragma{ type-check: \"off\" } [ \"q\" ] greet-all ." eval-string
"pragma{ type-check: \"off\" } \"b\" 2.5 shout-n ." eval-string
"pragma{ type-check: \"off\" } [ 7 greet ] [ error-type: @get . ] recover" eval-string
