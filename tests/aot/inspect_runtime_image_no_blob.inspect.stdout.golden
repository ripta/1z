kind: aot-binary
artifact: runtime-image-aot
target: <target>
build-mode: <build-mode>
interpreter: linked=no, fallback=auto, locked=no
aot-callbacks: jit-interpreted-call=no
runtime-image: present=yes, format-version=15, blob-present=no, word-count=0
dispatch-entries: 96
dynamic-features: dynamic-eval
1z-version: <version>
prelude-hash: <prelude-hash>
