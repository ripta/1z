\ Interpreter-free (`--interpreter-fallback=false`) AOT compilation of same-type
\ `if` merges. Each `dup C < [ ARM ] [ ARM ] if` sits directly in a word body so
\ the AOT compiler emits it (a `while`-body quotation would instead fall back to
\ the interpreter). clamp-rec and bool-rec are self-tail-recursive, so their
\ merge is AOT-compiled inside the compiled loop -- the if-in-loop shape the
\ branchless IR_COND select must stay correct in. f64-pick and cross-pick
\ exercise the boxed fallback. Output must match the interpreter.
clamp-rec: ( n acc -- acc ) [
  over 0 = [ nip ] [
    over dup 500 < [ 3 * ] [ 2 * ] if +
    swap 1 - swap
    clamp-rec
  ] if
] ;

bool-rec: ( n acc -- acc ) [
  over 0 = [ nip ] [
    over dup 5 < [ 2 > ] [ 8 > ] if [ 1 + ] [ 0 + ] if
    swap 1 - swap
    bool-rec
  ] if
] ;

f64-pick: ( x -- y ) [ dup 0.5 < [ 2.0 * ] [ 1.5 * ] if ] ;

cross-pick: ( x -- v ) [ dup 3 < [ 2 * ] [ 1 > ] if ] ;

1000 0 clamp-rec inspect print-line
10 0 bool-rec inspect print-line
2.0 f64-pick inspect print-line
0.25 f64-pick inspect print-line
2 cross-pick inspect print-line
4 cross-pick inspect print-line
