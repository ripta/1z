\ The same program as aot_choose_linux with only the selector changed: choose{
\ picks the macos branch instead, so the AOT binary carries that branch's value.
\ Changing the selector changes which branch is compiled into the binary.
macos: choose{
  linux: [
    tag: ( -- n ) [ 1 ] ;
  ]
  macos: [
    tag: ( -- n ) [ 2 ] ;
  ]
  _ [
    tag: ( -- n ) [ 9 ] ;
  ]
}
tag .
