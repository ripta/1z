kind: aot-binary
artifact: interpreter
target: <target>
build-mode: <build-mode>
interpreter: linked=yes, fallback=auto, locked=no
aot-callbacks: jit-interpreted-call=no
runtime-image: present=yes, format-version=8, blob-present=yes, word-count=145
dynamic-features: none
1z-version: <version>
prelude-hash: <prelude-hash>
