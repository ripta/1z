\ Test polymorphic fixnum/float arithmetic in AOT compiled code.
\ User-defined words receive parameters as raw_at_slot, triggering
\ the polymorphic tag-check branching path.

add:  ( a b -- c ) [ + ] ;
sub:  ( a b -- c ) [ - ] ;
mul:  ( a b -- c ) [ * ] ;
fdiv: ( a b -- c ) [ / ] ;
mod:  ( a b -- c ) [ % ] ;

\ fixnum + float
3 2.5 add .
\ float + fixnum
10.0 3 sub .
\ fixnum * float
4 2.5 mul .
\ float / fixnum
7.0 2 fdiv .

\ fixnum + fixnum (still works through polymorphic path)
3 3 add .
\ float + float (still works through polymorphic path)
2.5 1.5 add .

\ fixnum mod fixnum (Euclidean)
7 3 mod .
-7 3 mod .

\ float mod float (truncating remainder)
7.5 2.0 mod .
