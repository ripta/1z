\ Protocol-bounded call site in AOT runtime-image mode. The call site
\ emits the satisfies-and-dispatch helper-call, and the loader
\ reconstructs the protocol descriptor from the image's description row
\ at startup, so the helper performs a genuine satisfies-check.
\
\ No bump-it method is registered for fixnum, so the check fails with a
\ protocol error and the binary exits with an error.

addable: protocol{ bump-it: } ;
bump-it: generic ( x: addable -- n ) [ drop 0 ] ;

\ Protocol-bounded call site: compiled output emits aotSatisfiesAndDispatch.
bounded-caller: ( x: addable -- n ) [ bump-it ] ;

1 bounded-caller .
