kind: aot-binary
artifact: runtime-image-aot
target: <target>
build-mode: <build-mode>
interpreter: linked=no, fallback=auto, locked=no
aot-callbacks: jit-interpreted-call=no
runtime-image: present=yes, format-version=3, blob-present=no, word-count=8
1z-version: <version>
prelude-hash: <prelude-hash>
