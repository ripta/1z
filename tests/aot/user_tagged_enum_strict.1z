\ Exercises a user-defined enum variant under interpreter-free AOT. The
\ compound body of `red-variant` pushes a `.tagged` literal whose tag is
\ the enum variant's VirtualType. With interpreter fallback disabled, the
\ tagged slot table is the only way to recover the freeze-time tag and
\ inner-value pointers at runtime.

color: enum{
  red: unit
  green: unit
} ;

red-variant: ( -- v ) [ color:red ] ;

red-variant red-variant = .
red-variant .
