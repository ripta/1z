\\ A try whose quotation is curried with a stack argument compiles under
\\ `--interpreter-fallback=false`.
\\
\\ This is the static-file-handler shape: the quot is curried with `path`, and an `if` arm reaches
\\ below the result via `swap` for a value kept from before the try.
demo: ( n path -- s ) [
  [ 100 swap / ] curry try
  dup result:ok?
  [ unwrap-or-throw swap + >string ]
  [ drop drop "error" ]
  if
] ;

5 4 demo print-line
5 0 demo print-line

\\ A try whose quotation is curried with two arguments.
add-safely: ( a b -- s ) [
  [ + ] curry curry try
  dup result:ok? [ unwrap-or-throw >string ] [ drop "err" ] if
] ;

10 20 add-safely print-line
