\ `quotation_lexical_owner.1z` in the runtime-image class, where a pushed quotation's decode is the
\ one the image's reified-quotation path caches. Each of the first six lines must print
\ MODULE-LABEL, and the last OWN-LABEL.
label: ( -- s ) [ "MODULE-LABEL" ] ;

reader: ( -- quot ) [ [ label ] ] ;

direct-call: ( -- s ) [
  label: "CALLER-LABEL" ;
  reader call
] ;

direct-call print-line

runner: ( quot -- s ) [
  label: "CALLER-LABEL" ;
  call
] ;

reader runner print-line

escaping: ( -- quot ) [
  label: "CALLER-LABEL" ;
  reader
] ;

escaping call print-line

spliced: ( -- s ) [ [ label: "CALLER-LABEL" ; reader call ] call ] ;

spliced print-line

defining-reader: ( -- quot ) [
  other: "OTHER" ;
  [ label ]
] ;

defining-caller: ( -- s ) [
  label: "CALLER-LABEL" ;
  defining-reader call
] ;

defining-caller print-line

inline-reader: ( -- quot ) const inline [ [ label ] ] ;

inline-caller: ( -- s ) [
  label: "CALLER-LABEL" ;
  inline-reader call
] ;

inline-caller print-line

own-reader: ( -- s ) [
  label: "OWN-LABEL" ;
  [ label ] runner
] ;

own-reader print-line
