\ tools/gen-docs.1z - Generate per-module API reference documentation
\
\ Introspects the running interpreter to produce markdown files in
\ docs/reference/, one per module plus a prelude page.

use "os/fs" ;
use "os/path" ;
use "strings" ;
use "sequences" ;
use "runtime/introspect" ;
use "doc-extract" ;
use "doc-render" ;

\ --- Step 1: Discover stdlib modules ---

stdlib-dir: "testing" native.resolve-load-path dirname ;

discover-modules: ( -- array ) [
  stdlib-dir walk
  [ name>> ".1z" #ends-with? ] #filter
  [ name>> dup #len 3 - #take ] #map
  #collect
] ;

\ --- Step 2: Load modules and collect their words ---

\ Enumerate a loaded module's own words as raw word-info arrays.
module-word-infos: ( module -- array ) [
  dup @keys swap
  [ swap native.>word (raw>word-info) ] curry
  #map #collect
] ;

\ Source-level doc-comment map for a module key, built by tokenizing the
\ module's source file. Empty when no source file exists; the "prelude" group
\ has no lib/ source file, so it falls back to an empty map and the
\ introspection `doc>>` text.
module-doc-map: ( key -- map ) [
  >string stdlib-dir swap path-join ".1z" #append
  dup file-exists?
  [ extract-doc-comments-from-file ]
  [ drop M{ } ]
  if
] ;

\ Load one module without importing it, then file its words under its name in
\ the grouped hash. Loading without importing avoids the const-redefinition and
\ parse-time collisions that arise from merging every module into one scope; a
\ module that still cannot load, such as one needing an absent FFI library, is
\ reported and skipped. The pre-load `dup` keeps the name available to the
\ handler no matter where `load` failed.
add-module: ( grouped name -- grouped ) [
  dup
  [ load module-word-infos @set ]
  [ drop dup "  skipped: " swap #append eprint-line drop ]
  recover
] ;

\ Capture the prelude and native words, which belong to no loadable module.
\ The current scope also holds words this tool imported with `use`, so keep
\ only words with no source module; those imports are documented on their own
\ module pages.
prelude-group: ( grouped -- grouped ) [
  "prelude"
  native.current-scope module-word-infos
  [ module>> f = ] #filter #collect
  @set
] ;

\ --- Step 4: Generate markdown ---

\ Internal markers to skip in output
internal-marker?: ( marker-str -- ? ) [
  dup "<marker:typed>" =
  over "<marker:stack-recursive>" = or
  over "<marker:parse-time-only>" = or
  swap "<marker:shadow-ok>" = or
] ;

\ Strip <marker:NAME> to just NAME
marker-name: ( str -- str ) [
  dup "<marker:" #starts-with?
  [ 8 #drop dup #len 1 - #take ]
  when
] ;

\ Render marker badges on a single line
render-markers: ( markers -- str ) [
  >iterator [ inspect ] #map #collect
  [ internal-marker? not ] #filter #collect
  dup #len 0 =
  [ drop "" ]
  [ [ marker-name "`" swap #append "`" #append ] #map #collect " " #join "\n\n" #append ]
  if
] ;

\ Render a single method entry as a bullet
render-method: ( method-info -- str ) [
  types>>
  "- `method{ " swap " " #join #append " }`\n" #append
] ;

\ Render methods section
render-methods: ( methods -- str ) [
  dup #len 0 =
  [ drop "" ]
  [
    "\n#### Methods\n\n"
    swap >iterator [ render-method ] #map #collect "" #join
    #append
  ]
  if
] ;

\ Render type info section for typed words
render-type-info: ( wi -- str ) [
  dup markers>> [ inspect "<marker:typed>" = ] #any
  [
    [
      format-type-info
      \ Wrap in markdown section
      dup #len 0 =
      [ ]
      [ "\n#### Type Info\n\n```\n" swap #append "```\n" #append ]
      if
    ]
    [ drop "" ]
    recover
  ]
  [ drop "" ]
  if
] ;

\ Render the documentation paragraph for a word. Prefer the source-level
\ doc-comment from the module's token map, which preserves paragraph breaks and
\ indented code examples; fall back to the introspection `doc>>` field, then to
\ an undocumented marker.
render-doc-section: ( doc-map wi -- str ) [
  over over name>> @has?
  [
    swap over name>> @get format-doc-comment "\n" #append
    swap drop
  ]
  [
    nip doc>> dup f =
    [ drop "*Undocumented.*\n" ]
    [ "\n" #append ]
    if
  ]
  if
] ;

\ Render a single word entry
render-word: ( doc-map wi -- str ) [
  "### " over name>> #append "\n\n" #append

  over markers>> render-markers #append

  over stack-effect>> dup f =
  [ drop ]
  [ >string "`" swap #append "`\n\n" #append #append ]
  if

  2 pick-n 2 pick-n render-doc-section #append

  over methods>> render-methods #append

  over render-type-info #append

  nip nip
] ;

\ Sort word-infos alphabetically by name
sort-words: ( words -- words ) [ [ name>> ] #sort-by ] ;

\ --- Index page ---

\ Format one index table row: | word | [module](module.md) | `effect` |
render-index-entry: ( module-name wi -- str ) [
  dup stack-effect>>
  dup f =
  [ drop "" ]
  [ >string "`" swap #append "`" #append ]
  if                                \ module-name wi effect-str
  swap name>>                       \ module-name effect-str word-name
  "| " swap #append " | [" #append  \ module-name effect-str "| word | ["
  <rot-                             \ effect-str "| word | [" module-name
  dup                               \ effect-str "| word | [" mod mod
  [ #append "](" #append ] dip      \ effect-str "| word | [mod](" mod
  #append ".md) | " #append         \ effect-str "| word | [mod](mod.md) | "
  swap #append " |\n" #append  \ "| word | [mod](mod.md) | effect |\n"
] ;

\ Collect index entries for one module
module-entries: ( grouped module-key -- entries ) [
  over over @get  \ grouped module-key words
  swap >string    \ grouped words name-str
  swap >iterator  \ grouped name-str words-iter
  swap [ swap render-index-entry ] curry
  #map #collect  \ grouped entries
  swap drop      \ entries
] ;

\ Collect all entries, sort, render index page
render-index-page: ( grouped -- str ) [
  dup @keys  \ grouped keys-array
  >iterator
  swap [ swap module-entries ] curry
  #map #collect  \ array-of-entry-arrays
  { } swap >iterator [ #append ] #each
  [ ] #sort-by
  "" #join
  "# Word Index\n\n| Word | Module | Stack Effect |\n|------|--------|--------------|\n"
  swap #append
] ;

\ Write index page to docs/reference/index.md
write-index-page: ( content -- ) [
  "docs/reference/index.md"
  write: stream-open
  dup -rot> [ print ] with-output-stream
  stream-close
] ;

\ Render a full module page. The doc-map supplies source-level doc-comments,
\ curried into each word's render so it can prefer them over introspection.
render-module-page: ( doc-map name words -- str ) [
  sort-words >iterator  \ doc-map name iter
  2 pick-n [ swap render-word "\n" #append ] curry
  #map #collect "" #join  \ doc-map name body
  swap                    \ doc-map body name
  "# " swap #append "\n\n" #append  \ doc-map body "# name\n\n"
  swap #append  \ doc-map page
  nip
] ;

\ --- Step 5: Write files ---

write-module-page: ( name content -- ) [
  swap "docs/reference/" swap #append ".md" #append
  dup dirname ensure-directory
  write: stream-open
  dup -rot> [ print ] with-output-stream
  stream-close
] ;

\ --- Main ---

"Discovering modules..." eprint-line
discover-modules
dup "Found " swap #len inspect #append " modules" #append eprint-line

"Loading modules..." eprint-line
H{ } prelude-group
[ add-module ] #reduce

"docs/reference" ensure-directory

\ Generate one module's docs. Called via curry: TOS=grouped, below=key.
generate-one: ( key grouped -- ) [
  swap  \ grouped key
  dup >string "  " swap #append "..." #append eprint-line
  dup module-doc-map      \ grouped key doc-map
  over >string            \ grouped key doc-map name
  3 pick-n 3 pick-n @get  \ grouped key doc-map name words
  render-module-page      \ grouped key content
  swap >string swap       \ grouped name content
  write-module-page
  drop
] ;

"Generating documentation..." eprint-line
dup
dup @keys [ >string ] #sort-by
swap [ generate-one ] curry #each

"Generating index..." eprint-line
render-index-page write-index-page

"Done." eprint-line
